                    case (true) { -> (Overload*)0; }
                    default
                    {
                        switch (list.len == 0)
                        {
                            case (true) { -> (Overload*)0; }
                            default
                            {
                                -> (Overload*)list.items[0];
                            };
                        };
                    };
                };
            };


            call_contracts(Node* n, PtrVec* list) -> void
            {
                Overload* o = this.first_overload(list);
                Node* an;
                TypeSpec* pt;
                TypeSpec* at;
                IDKC_SYMENTRY* e;
                int i, tgt, src;
                int argc = node_count(n, 0);
                bool tied_arg;
                switch (this.ck == (Checker*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        while (i < argc)
                        {
                            an = node_child(n, 0, i);

                            switch (an.kind == NodeKind.IDENTIFIER & an.text != (byte*)0)
                            {
                                case (true) {
                                e = st_lookup_any(this.st, an.text, (byte*)0);
                                switch (e != (IDKC_SYMENTRY*)0)
                                {
                                    case (true) {
                                    switch (e.kind_id == SymbolKind.VARIABLE & (TypeSpec*)e.ts != (TypeSpec*)0)
                                    {
                                        case (true) {
                                        switch ((((TypeSpec*)e.ts).flags `& 16) != 0)
                                        {
                                            case (true) {
                                            this.ck.clear_msg();
                                            this.ck.mb.put_str(f"local variable '{an.text}' cannot leave its scope via function call\0");
                                            this.report(Severity.ERROR, n);
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                            i++;
                        };
                        switch (o == (Overload*)0)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch (o.deprecated)
                                {
                                    case (true) {
                                    this.ck.clear_msg();
                                    this.ck.mb.put_str(f"call to deprecated function '{n.text}'\0");
                                    this.report(Severity.WARNING, n);
                                }
                                    default {};
                                };
                                i = 0;
                                while (i < argc & i < o.nparams)
                                {
                                    an = node_child(n, 0, i);
                                    pt = o.params[i];
                                    tied_arg = an.kind == NodeKind.TIE_EXPRESSION;
                                    switch (pt != (TypeSpec*)0)
                                    {
                                        case (true) {
                                        switch (((pt.flags `& 8) != 0) & !tied_arg)
                                        {
                                            case (true) {
                                            this.ck.clear_msg();
                                            this.ck.mb.put_str(f"parameter {i} of '{n.text}' requires a tied argument (~), but a non-tied expression was passed\0");
                                            this.report(Severity.ERROR, n);
                                        }
                                            default {};
                                        };
                                        switch (((pt.flags `& 8) == 0) & tied_arg)
                                        {
                                            case (true) {
                                            this.ck.clear_msg();
                                            this.ck.mb.put_str(f"parameter {i} of '{n.text}' is not a tied parameter, but a tie expression (~) was passed\0");
                                            this.report(Severity.ERROR, n);
                                        }
                                            default {};
                                        };

                                        tgt = pt.endianness;
                                        src = 1;
                                        switch (this.has_spec(an))
                                        {
                                            case (true) {
                                            at = this.arg_type(an);
                                            switch (at != (TypeSpec*)0)
                                            {
                                                case (true) { src = this.resolve_alias(at).endianness; }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        switch (src != tgt)
                                        {
                                            case (true) {
                                            this.ck.clear_msg();
                                            this.ck.mb.put_str(f"passing argument {i} of function {n.text}\0");
                                            switch (src)
                                            {
                                                case (0) { this.ck.mb.put_str(g" is little-endian, but parameter expects big-endian\0"); }
                                                default { this.ck.mb.put_str(g" is big-endian, but parameter expects little-endian\0"); };
                                            };
                                            this.report(Severity.ERROR, n);
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    i++;
                                };
                                ->;
                            };
                        };
                    };
                };
            };


            call_unresolved(Node* n) -> void
            {
                PtrVec* exact;
                Overload* o;
                int i, argc;
                switch (this.ck == (Checker*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        argc = node_count(n, 0);
                        this.ck.clear_msg();
                        exact = st_overloads_of(this.st, n.text);
                        switch (exact != (PtrVec*)0)
                        {
                            case (true) {
                            this.ck.mb.put_str(f"function {n.text} found but no overload accepts {argc} arguments. Available overloads accept: [\0");
                            while (i < exact.len)
                            {
                                o = (Overload*)exact.items[i];
                                switch (i > 0)
                                {
                                    case (true) { this.ck.mb.put_str(g", \0"); }
                                    default {};
                                };
                                this.ck.mb.put_int(o.nparams);
                                i++;
                            };
                            this.ck.mb.put_str(g"]\0");
                        }
                            default {
                            byte* owner = (byte*)0;
                            switch (this.unbuilt != (NameMap*)0)
                            {
                                case (true) { owner = (byte*)nm_get(this.unbuilt, n.text); }
                                default {};
                            };
                            switch (owner != (byte*)0)
                            {
                                case (true)
                                {
                                    this.ck.mb.put_str(g"function '\0");
                                    this.ck.mb.put_str(n.text);
                                    this.ck.mb.put_str(g"' belongs to module '\0");
                                    this.ck.mb.put_str(owner);
                                    this.ck.mb.put_str(g"', which is not part of this build. Add '#[requires] = {\0");
                                    this.ck.mb.put_str(owner);
                                    this.ck.mb.put_str(g"}' to the build settings of the module that calls it\0");
                                }
                                default
                                {
                                    this.ck.mb.put_str(f"function '{n.text}' not found in module or any imported namespaces\0");
                                };
                            };
                        };
                        };
                        -> this.report(Severity.ERROR, n);
                    };
                };
            };

            t_call(Node* n) -> TypeSpec*
            {
                int i;
                int cnt = node_count(n, 0);
                IDKC_SYMENTRY* e;
                PtrVec* list;
                Overload* o;
                TypeSpec* vt;
                while (i < cnt)
                {
                    this.type_of(node_child(n, 0, i));
                    i++;
                };
                switch (n.text == (byte*)0)
                {
                    case (true) { -> (TypeSpec*)0; }
                    default
                    {
                        e = st_lookup_any(this.st, n.text, (byte*)0);
                        switch (e != (IDKC_SYMENTRY*)0)
                        {
                            case (true) {
                            switch (e.kind_id == SymbolKind.VARIABLE)
                            {
                                case (true) {
                                vt = this.resolve_alias((TypeSpec*)e.ts);
                                switch (vt != (TypeSpec*)0)
                                {
                                    case (true) {
                                    switch (vt.base_type == DataType.FUNC_PTR)
                                    {
                                        case (true) { -> vt.fp_ret; }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };

                        switch (this.cur_obj != (byte*)0) { case (true) { this.ov_line = 0; } default {
                            switch (this.fs_line > 0) { case (true) { this.ov_line = this.fs_line; } default { this.ov_line = n.line; }; };
                        }; };
                        list = this.ov_resolve(n.text);
                        this.ov_line = 0;
                        this.call_contracts(n, list);
                        o = this.pick_overload(list, n.l0);
                        switch (o != (Overload*)0)
                        {
                            case (true) {
                            this.conv_args(o, n.l0);
                            n.text3 = o.mangled;
                            -> o.ret;
                        }
                            default
                            {
                                o = this.by_mangled(n.text);
                                switch (o != (Overload*)0)
                                {
                                    case (true) {
                                    n.text3 = o.mangled;
                                    -> o.ret;
                                }
                                    default
                                    {
                                        e = st_lookup_any(this.st, n.text, (byte*)0);
                                        switch (e != (IDKC_SYMENTRY*)0)
                                        {
                                            case (true) {
                                            switch (e.kind_id == SymbolKind.FUNCTION & list == (PtrVec*)0)
                                            {
                                                case (true) { -> (TypeSpec*)e.ts; }
                                                default
                                                {
                                                    switch (e.kind_id == SymbolKind.STRUCT)
                                                    {
                                                        case (true) { -> this.mk_named(DataType.STRUCT, n.text); }
                                                        default
                                                        {
                                                            switch (e.kind_id == SymbolKind.OBJECT)
                                                            {
                                                                case (true) { -> this.mk_named(DataType.OBJECT, n.text); }
                                                                default
                                                                {
                                                                    switch (e.kind_id == SymbolKind.VARIABLE)
                                                                    {
                                                                        case (true) {
                                                                        switch (this.kind_of((TypeSpec*)e.ts) == TyKind.AGG)
                                                                        {
                                                                            case (true) { -> (TypeSpec*)e.ts; }
                                                                            default {};
                                                                        };
                                                                    }
                                                                        default {};
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        }
                                            default {};
                                        };
                                        this.call_unresolved(n);
                                        -> (TypeSpec*)0;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            t_method(Node* n) -> TypeSpec*
            {
                TypeSpec* rt = this.type_raw(n.a);
                IDKC_SYMENTRY* e;
                PtrVec* list;
                Overload* o;
                byte* key;
                byte* objkey;
                byte* tn;
                byte* mk2;
                TypeSpec* r;
                this.type_list(n, 0);
                switch (n.text == (byte*)0)
                {
                    case (true) { -> (TypeSpec*)0; }
