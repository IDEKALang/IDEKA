            op_struct_store(byte* field) -> void
            {
                i64 vt, vd, vm;
                i64* b;
                i64* nb;
                int li, k, i, n;
                this.pop_val();
                vt = (i64)this.pt;
                vd = this.pd;
                vm = this.pm;
                this.pop_val();
                switch (this.failed) { case (true) { ->; } default {}; };
