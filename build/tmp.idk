            int_ty(int w) -> IRType* -> this.mod.t_int(w);

            ci32(int v) -> IRValue* -> this.mod.c_int(this.t_i32, (i64)v);




            array_widen(IRValue* mp, IRValue* val, IRType* mt) -> void
            {
                IRType** ps = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                IRType* i8p = this.mod.t_ptr(this.t_i8);
                IRFunc* f;
                IRValue* dp;
                IRValue* sp;
                i64 eb = (i64)8;
                i64 dst_bytes;
                i64 src_bytes;
                this.keep((void*)ps);
                switch (mt.elem.kind == LK.INT)
                {
                    case (true) {
                    eb = (i64)(mt.elem.width / 8);
                    switch (eb < (i64)1)
                    {
                        case (true) { eb = (i64)1; }
                        default {};
                    };
                }
                    default {};
                };
                dst_bytes = (i64)mt.count * eb;
                src_bytes = (i64)val.ty.elem.count * eb;
                ps[0] = i8p;
                ps[1] = this.t_i8;
                ps[2] = this.t_i64;
                ps[3] = this.t_i1;
                f = this.intrinsic(g"llvm.memset.p0i8.i64\0", this.mod.t_func(this.t_void, ps, 4, false));
                dp = this.mod.cast(g"bitcast\0", mp, i8p, (byte*)0);
                this.mod.ia[0] = dp;
                this.mod.ia[1] = this.mod.c_int(this.t_i8, (i64)0);
                this.mod.ia[2] = this.mod.c_int(this.t_i64, dst_bytes);
                this.mod.ia[3] = this.mod.c_null(this.t_i1);
                this.mod.call(f.self, this.mod.ia, 4, (byte*)0);
                ps = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)ps);
                ps[0] = i8p;
                ps[1] = i8p;
                ps[2] = this.t_i64;
                ps[3] = this.t_i1;
                f = this.intrinsic(g"llvm.memcpy.p0i8.p0i8.i64\0", this.mod.t_func(this.t_void, ps, 4, false));
                dp = this.mod.cast(g"bitcast\0", mp, i8p, (byte*)0);
                sp = this.mod.cast(g"bitcast\0", val, i8p, (byte*)0);
                this.mod.ia[0] = dp;
                this.mod.ia[1] = sp;
                this.mod.ia[2] = this.mod.c_int(this.t_i64, src_bytes);
                this.mod.ia[3] = this.mod.c_null(this.t_i1);
                this.mod.call(f.self, this.mod.ia, 4, (byte*)0);
                ->;
            };

            memset_object(IRValue* alloca, IRType* lt) -> void
            {
                IRType** ps = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                IRType* i8p = this.mod.t_ptr(this.t_i8);
                IRFunc* f;
                IRValue* szp;
                IRValue* sz;
                IRValue* cp;
                this.keep((void*)ps);
                ps[0] = i8p;
                ps[1] = this.t_i8;
                ps[2] = this.t_i64;
                ps[3] = this.t_i1;
                f = this.intrinsic(g"llvm.memset.p0i8.i64\0", this.mod.t_func(this.t_void, ps, 4, false));
                this.mod.ia[0] = this.ci32(1);
                szp = this.mod.gep(this.mod.c_null(this.mod.t_ptr(lt)), this.mod.ia, 1, false, g"obj_sizeof_gep\0");
                sz = this.mod.cast(g"ptrtoint\0", szp, this.t_i64, g"obj_sizeof\0");
                cp = this.mod.cast(g"bitcast\0", alloca, i8p, g"obj_memset_ptr\0");
                this.mod.ia[0] = cp;
                this.mod.ia[1] = this.mod.c_int(this.t_i8, (i64)0);
                this.mod.ia[2] = sz;
                this.mod.ia[3] = this.mod.c_null(this.t_i1);
                this.mod.call(f.self, this.mod.ia, 4, (byte*)0);
                ->;
            };


            init_ctor(IRValue* alloca, IRType* lt, Node* ini, Node* site) -> void
            {
                int argc = node_count(ini, 0);
                int i;
                IRValue* probe;
                IRValue* v;
                IRValue** args;
                IRFunc* f;
                IRType* ft;
                int j;
                bool large;
                bool isstr;
                switch (argc == 1 & lt.kind == LK.ISTRUCT)
                {
                    case (true) {
                    probe = this.visit(node_child(ini, 0, 0));
                    switch (this.bad)
                    {
                        case (true) { ->; }
                        default
                        {
                            switch (probe != (IRValue*)0)
                            {
                                case (true) {
                                switch (probe.ty.kind == LK.PTR)
                                {
                                    case (true) {
                                    switch (lt_eq(probe.ty.elem, lt))
                                    {
                                        case (true) { probe = this.mod.load(probe, g"obj_copy_load\0"); }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (lt_eq(probe.ty, lt))
                                {
                                    case (true) {
                                    -> this.mod.store(probe, alloca);
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        };
                    };
                }
                    default {};
                };
                switch (lt.kind == LK.ISTRUCT)
                {
                    case (true) {
                    large = false;
                    j = 0;
                    while (j < lt.nitems)
                    {
                        switch (lt.items[j].kind == LK.ARRAY)
                        {
                            case (true) {
                            switch (lt.items[j].count > 64)
                            {
                                case (true) { large = true; }
                                default {};
                            };
                        }
                            default {};
                        };
                        j++;
                    };
                    switch (large)
                    {
                        case (true) { this.memset_object(alloca, lt); }
                        default { this.mod.store(this.zero_of(lt), alloca); };
                    };
                }
                    default {};
                };
                f = this.mod.find_function(ini.text3);
                switch (f == (IRFunc*)0)
                {
                    case (true) {
                    -> this.unsup(site, g"constructor not declared\0");
                }
                    default
                    {
                        ft = f.ftype;
                        args = (IRValue**)fmalloc((u64)(8 * (argc + 1)));
                        this.keep((void*)args);
                        args[0] = alloca;
                        i = 0;
                        while (i < argc)
                        {
                            switch (node_child(ini, 0, i).kind == NodeKind.STRING_LITERAL & i + 1 < ft.nitems)
                            {
                                case (true) { isstr = this.is_i8_ptr(ft.items[i + 1]); }
                                default { isstr = false; };
                            };
                            switch (isstr)
                            {
                                case (true) {
                                this.sc.clear();
                                this.sc.put_str(f"ctor_arg{i}\0");
                                v = this.local_string_value(node_child(ini, 0, i), this.sc.mem);
                            }
                                default { v = this.visit(node_child(ini, 0, i)); };
                            };
                            switch (this.bad)
                            {
                                case (true) { ->; }
                                default
                                {
                                    switch (v == (IRValue*)0)
                                    {
                                        case (true) {
                                        -> this.unsup(site, g"void constructor argument\0");
                                    }
                                        default
                                        {
                                            switch (i + 1 < ft.nitems)
                                            {
                                                case (true) { v = this.convert_arg(v, ft.items[i + 1], i, site); }
                                                default {};
                                            };
                                            switch (this.bad)
                                            {
                                                case (true) { ->; }
                                                default
                                                {
                                                    args[i + 1] = v;
                                                    i++;
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        this.mod.call(f.self, args, argc + 1, (byte*)0);
                        ->;
                    };
                };
            };

            is_i8_ptr(IRType* t) -> bool
            {
                switch (t.kind != LK.PTR)
                {
                    case (true) { -> false; }
                    default
                    {
                        -> t.elem.kind == LK.INT & t.elem.width == 8;
                    };
                };
            };


            str_bytes(Node* n) -> byte*
            {
                int len = (int)n.ival;
                int i;
                byte* src = n.text;
                byte* buf;
                switch (src == (byte*)0)
                {
                    case (true) { src = g"\0"; }
                    default {};
                };
                switch (len <= 0)
                {
                    case (true) {
                    while (src[len] != 0) { len++; };
                }
                    default {};
                };
                buf = (byte*)fmalloc((u64)(len + 2));
                this.keep((void*)buf);
                while (i < len)
                {
                    buf[i] = src[i];
                    i++;
                };
                switch (this.null_term)
                {
                    case (true) {
                    switch (len == 0)
                    {
                        case (true) {
                        buf[0] = (byte)0;
                        len = 1;
                    }
                        default {
                            switch (buf[len - 1] != (byte)0)
                            {
                                case (true) {
                        buf[len] = (byte)0;
                        len++;
                    }
                                default {};
                            };
                        };
                    };
                }
                    default {};
                };
                this.q_len = len;
                -> buf;
            };


            store_bytes(IRValue* arr, byte* buf, int len) -> void
            {
                int i;
                IRValue* ep;
                while (i < len)
                {
                    this.mod.ia[0] = this.ci32(0);
                    this.mod.ia[1] = this.ci32(i);
                    ep = this.mod.gep(arr, this.mod.ia, 2, false, (byte*)0);
                    this.mod.store(this.mod.c_int(this.t_i8, (i64)(int)buf[i]), ep);
                    i++;
                };
                ->;
            };

            str_init_ok(IRType* lt, Node* ini) -> bool
            {
                switch (ini.op == StorageClass.HEAP)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (this.is_i8_ptr(lt))
                        {
                            case (true) { -> true; }
                            default
                            {
                                -> lt.kind == LK.ARRAY & lt.elem.kind == LK.INT & lt.elem.width == 8;
                            };
                        };
                    };
                };
            };


            init_local_string(IRValue* alloca, IRType* lt, Node* ini) -> void
            {
                byte* buf = this.str_bytes(ini);
                int len = this.q_len;
                int i;
                IRValue* sa;
                IRValue* sp;
                IRValue* ep;
                switch (this.is_i8_ptr(lt))
                {
                    case (true) {
                    sa = this.mod.alloca_here(this.mod.t_array(this.t_i8, len), g"str_data\0");
                    this.store_bytes(sa, buf, len);
                    this.mod.ia[0] = this.ci32(0);
                    this.mod.ia[1] = this.ci32(0);
                    sp = this.mod.gep(sa, this.mod.ia, 2, false, g"str_ptr\0");
                    -> this.mod.store(sp, alloca);
                }
                    default
                    {
                        switch (len > lt.count)
                        {
                            case (true) { len = lt.count; }
                            default {};
                        };
                        this.store_bytes(alloca, buf, len);
                        i = len;
                        while (i < lt.count)
                        {
                            this.mod.ia[0] = this.ci32(0);
                            this.mod.ia[1] = this.ci32(i);
                            ep = this.mod.gep(alloca, this.mod.ia, 2, false, (byte*)0);
                            this.mod.store(this.mod.c_int(this.t_i8, (i64)0), ep);
                            i++;
                        };
                        ->;
                    };
                };
            };


            local_string_value(Node* s, byte* hint) -> IRValue*
            {
                byte* buf = this.str_bytes(s);
                int len = this.q_len;
                IRValue* sa;
                byte* h = ts_dup(hint);
                this.keep((void*)h);
                this.sc.clear();
                this.sc.put_str(f"{h}_str_data\0");
                sa = this.mod.alloca_here(this.mod.t_array(this.t_i8, len), this.sc.mem);
                this.store_bytes(sa, buf, len);
                this.sc.clear();
                this.sc.put_str(f"{h}_str_ptr\0");
                this.mod.ia[0] = this.ci32(0);
                this.mod.ia[1] = this.ci32(0);
                -> this.mod.gep(sa, this.mod.ia, 2, false, this.sc.mem);
            };


            simple_array_init(IRType* lt, Node* ini) -> bool
            {
                int i;
                int c = node_count(ini, 0);
                int k;
                switch (lt.kind != LK.ARRAY)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (lt.elem.kind == LK.ARRAY)
                        {
                            case (true) {

                            while (i < c)
                            {
                                switch (node_child(ini, 0, i).kind != NodeKind.STRING_LITERAL)
                                {
                                    case (true) { -> false; }
                                    default {};
                                };
                                i++;
                            };
                            -> c > 0;
                        }
                            default
                            {
                                switch (lt.elem.kind == LK.ISTRUCT)
                                {
                                    case (true) {

                                    while (i < c)
                                    {
                                        switch (node_child(ini, 0, i).kind != NodeKind.STRUCT_LITERAL)
                                        {
                                            case (true) { -> false; }
                                            default {};
                                        };
                                        i++;
                                    };
                                    -> c > 0;
                                }
                                    default
                                    {
                                        switch (lt.elem.kind != LK.INT & lt.elem.kind != LK.PTR & lt.elem.kind != LK.FLOAT & lt.elem.kind != LK.DOUBLE)
                                        {
                                            case (true) { -> false; }
                                            default
                                            {
                                                while (i < c)
                                                {
                                                    k = node_child(ini, 0, i).kind;
                                                    switch (k == NodeKind.STRING_LITERAL | k == NodeKind.ARRAY_LITERAL | k == NodeKind.STRUCT_LITERAL)
                                                    {
                                                        case (true) { -> false; }
                                                        default
                                                        {
                                                            i++;
                                                        };
                                                    };
                                                };
                                                -> true;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            array_bits(IRType* at) -> int
            {
                IRType* e = at.elem;
                int w = 64;
                switch (e.kind)
                {
                    case (LK.INT) { w = e.width; }
                    case (LK.FLOAT) { w = 32; }
                    case (LK.DOUBLE) { w = 64; }
                    case (LK.STRUCT) { w = this.struct_bits(e); }
                    case (LK.ISTRUCT) { w = this.struct_bits(e); }
                    default {};
                };
                -> w * at.count;
            };


            struct_bits(IRType* st) -> int
            {
                int i;
                int total;
                IRType* e;
                while (i < st.nitems)
                {
                    e = st.items[i];
                    switch (e.kind)
                    {
                        case (LK.INT) { total += e.width; }
                        case (LK.FLOAT) { total += 32; }
                        case (LK.DOUBLE) { total += 64; }
                        case (LK.STRUCT) { total += this.struct_bits(e); }
                        case (LK.ISTRUCT) { total += this.struct_bits(e); }
                        case (LK.ARRAY) { total += this.array_bits(e); }
                        default { total += 64; };
                    };
                    i++;
                };
                -> total;
            };


            init_local_array(IRValue* alloca, IRType* lt, Node* ini) -> void
            {
                int i;
                int c = node_count(ini, 0);
                IRValue* ev;
                IRValue* ep;
                IRValue* stmp;
                IRValue* sip;
                while (i < c & i < lt.count)
                {
                    switch (lt.elem.kind == LK.ARRAY & node_child(ini, 0, i).kind == NodeKind.ARRAY_LITERAL)
                    {
                        case (true) {
                        this.mod.ia[0] = this.ci32(0);
                        this.mod.ia[1] = this.ci32(i);
                        this.sc.clear();
                        this.sc.put_str(f"elem_{i}\0");
                        ep = this.mod.gep(alloca, this.mod.ia, 2, false, this.sc.mem);
                        this.init_local_array(ep, lt.elem, node_child(ini, 0, i));
                        switch (this.bad) { case (true) { ->; } default {}; };
                        i++;
                        continue;
                    }
                        default
                        {
                            switch (lt.elem.kind == LK.ISTRUCT & node_child(ini, 0, i).kind == NodeKind.STRUCT_LITERAL)
                            {
                                case (true) { ev = this.x_struct_lit(node_child(ini, 0, i), lt.elem); }
                                default { ev = this.visit(node_child(ini, 0, i)); };
                            };
                            switch (this.bad)
                            {
                                case (true) { ->; }
                                default
                                {
                                    switch (ev == (IRValue*)0)
                                    {
                                        case (true) {
                                        -> this.unsup(ini, g"void array element\0");
                                    }
                                        default
                                        {
                                            switch (lt.elem.kind)
                                            {
                                                case (LK.ISTRUCT)
                                                {
                                                    switch (!lt_eq(ev.ty, lt.elem))
                                                    {
                                                        case (true) {
                                                        -> this.unsup(ini, g"array element type\0");
                                                    }
                                                        default {};
                                                    };
                                                }
                                                case (LK.PTR)
                                                {

                                                    switch (ev.ty.kind == LK.PTR)
                                                    {
                                                        case (true) {
                                                        switch (ev.ty.elem.kind == LK.ARRAY)
                                                        {
                                                            case (true) {
                                                            this.mod.ia[0] = this.ci32(0);
                                                            this.mod.ia[1] = this.ci32(0);
                                                            ev = this.mod.gep(ev, this.mod.ia, 2, false, g"str_to_ptr\0");
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                    switch (!lt_eq(ev.ty, lt.elem))
                                                    {
                                                        case (true) {
                                                        -> this.unsup(ini, g"array element type\0");
                                                    }
                                                        default {};
                                                    };
                                                }
                                                default
                                                {
                                                    switch (ev.ty.kind == LK.PTR)
                                                    {
                                                        case (true) { ev = this.mod.load(ev, (byte*)0); }
                                                        default {};
                                                    };
                                                    switch (lt.elem.kind == LK.INT)
                                                    {
                                                        case (true) {

                                                        switch ((ev.ty.kind == LK.STRUCT | ev.ty.kind == LK.ISTRUCT) & this.struct_bits(ev.ty) == lt.elem.width)
                                                        {
                                                            case (true) {
                                                            stmp = this.mod.alloca(ev.ty, g"struct_tmp\0");
                                                            this.mod.store(ev, stmp);
                                                            sip = this.mod.cast(g"bitcast\0", stmp, this.mod.t_ptr(lt.elem), g"struct_as_int_ptr\0");
                                                            ev = this.mod.load(sip, g"struct_to_int\0");
                                                        }
                                                            default {};
                                                        };
                                                        switch (ev.ty.kind != LK.INT)
                                                        {
                                                            case (true) {
                                                            -> this.unsup(ini, g"array element type\0");
                                                        }
                                                            default
                                                            {
                                                                switch (ev.ty.width < lt.elem.width)
                                                                {
                                                                    case (true) { ev = this.mod.cast(g"zext\0", ev, lt.elem, (byte*)0); }
                                                                    default {
                                                                        switch (ev.ty.width > lt.elem.width)
                                                                        {
                                                                            case (true) { ev = this.mod.cast(g"trunc\0", ev, lt.elem, (byte*)0); }
                                                                            default {};
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    }
                                                        default {
                                                            switch (!lt_eq(ev.ty, lt.elem))
                                                            {
                                                                case (true) {
                                                        -> this.unsup(ini, g"array element type\0");
                                                    }
                                                                default {};
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                            this.mod.ia[0] = this.ci32(0);
                                            this.mod.ia[1] = this.ci32(i);
                                            this.sc.clear();
                                            this.sc.put_str(f"elem_{i}\0");
                                            ep = this.mod.gep(alloca, this.mod.ia, 2, false, this.sc.mem);
                                            this.mod.store(ev, ep);
                                            i++;
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                ->;
            };


            memset_zero(IRValue* alloca, IRType* lt) -> void
            {
                IRType** ps = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                IRType* i8p = this.mod.t_ptr(this.t_i8);
                IRFunc* f;
                IRValue* cp;
                int eb = 1;
                this.keep((void*)ps);
                ps[0] = i8p;
                ps[1] = this.t_i8;
                ps[2] = this.t_i64;
                ps[3] = this.t_i1;
                f = this.intrinsic(g"llvm.memset.p0i8.i64\0", this.mod.t_func(this.t_void, ps, 4, false));
                switch (lt.elem.kind == LK.INT)
                {
                    case (true) { eb = lt.elem.width / 8; }
                    default {};
                };
                cp = this.mod.cast(g"bitcast\0", alloca, i8p, g"memset_ptr\0");
                this.mod.ia[0] = cp;
                this.mod.ia[1] = this.mod.c_int(this.t_i8, (i64)0);
                this.mod.ia[2] = this.mod.c_int(this.t_i64, (i64)lt.count * (i64)eb);
                this.mod.ia[3] = this.mod.c_null(this.t_i1);
                this.mod.call(f.self, this.mod.ia, 4, (byte*)0);
                ->;
            };



            va_intrinsic(byte* name, int n) -> IRFunc*
            {
                IRType** ps = (IRType**)this.zbuf(2);
                ps[0] = this.t_i8p;
                ps[1] = this.t_i8p;
                -> this.intrinsic(name, this.mod.t_func(this.t_void, ps, n, false));
            };


            recast_invalidate(Node* src) -> void
            {
                int k;
                byte* nm = (byte*)0;
                switch (src.kind == NodeKind.ARRAY_SLICE)
                {
                    case (true) {
                    switch (src.a.kind == NodeKind.IDENTIFIER) { case (true) { nm = src.a.text; } default {}; };
                }
                    default {
                    switch (src.kind == NodeKind.IDENTIFIER) { case (true) { nm = src.text; } default {}; };
                };
                };
                switch (nm == (byte*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        k = this.scopes.len - 1;
                        while (k >= 0)
                        {
                            switch (nm_get((NameMap*)this.scopes.items[k], nm) != (void*)0)
                            {
                                case (true) {
                                nm_del((NameMap*)this.scopes.items[k], nm);
                                break;
                            }
                                default
                                {
                                    k--;
                                };
                            };
                        };
                        ->;
                    };
                };
            };


            x_recast(Node* n) -> IRValue*
            {
                IRType* st = this.resolve_custom(n.text);
                IRValue* src;
                IRValue* sv;
                IRValue* start;
                Node* sl;
                switch (st == (IRType*)0)
                {
                    case (true) {
                    this.unsup(n, g"struct recast target\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (n.a.kind == NodeKind.ARRAY_SLICE)
                        {
                            case (true) {
                            sl = n.a;
                            sv = this.visit(sl.a);
                            switch (this.bad | sv == (IRValue*)0)
                            {
                                case (true) { -> (IRValue*)0; }
                                default
                                {

                                    switch (sv.ty.kind == LK.PTR)
                                    {
                                        case (true) {
                                        switch (sv.ty.elem.kind == LK.PTR)
                                        {
                                            case (true) {
                                            switch (sv.ty.elem.elem.kind != LK.ARRAY)
                                            {
                                                case (true) { sv = this.mod.load(sv, g"recast_arr_load\0"); }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    start = this.visit(sl.b);
                                    switch (this.bad | start == (IRValue*)0)
                                    {
                                        case (true) { -> (IRValue*)0; }
                                        default
                                        {
                                            switch (start.ty.kind == LK.INT & start.ty.width != 32)
                                            {
                                                case (true) {
                                                switch (start.ty.width > 32)
                                                {
                                                    case (true) { start = this.mod.cast(g"trunc\0", start, this.t_i32, g"recast_start_trunc\0"); }
                                                    default { start = this.mod.cast(g"sext\0", start, this.t_i32, g"recast_start_ext\0"); };
                                                };
                                            }
                                                default {};
                                            };
                                            switch (sv.ty.kind == LK.PTR)
                                            {
                                                case (true) {
                                                switch (sv.ty.elem.kind == LK.ARRAY)
                                                {
                                                    case (true) {
                                                    this.mod.ia[0] = this.ci32(0);
                                                    this.mod.ia[1] = start;
                                                    src = this.mod.gep(sv, this.mod.ia, 2, true, g"recast_src_ptr\0");
                                                }
                                                    default {
                                                    this.mod.ia[0] = start;
                                                    src = this.mod.gep(sv, this.mod.ia, 1, true, g"recast_src_ptr\0");
                                                };
                                                };
                                            }
                                                default {
                                                this.unsup(n, g"struct recast slice source\0");
                                                -> (IRValue*)0;
                                            };
                                            };
                                        };
                                    };
                                };
                            };
                        }
                            default {
                            src = this.visit(n.a);
                            switch (this.bad | src == (IRValue*)0)
                            {
                                case (true) { -> (IRValue*)0; }
                                default {};
                            };
                        };
                        };
                        switch (src.ty.kind != LK.PTR)
                        {
                            case (true) {
                            this.unsup(n, g"struct recast by value\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (lt_eq(src.ty.elem, st))
                                {
                                    case (true) { -> src; }
                                    default
                                    {
                                        -> this.mod.cast(g"bitcast\0", src, this.mod.t_ptr(st), g"recast_ptr\0");
                                    };
                                };
                            };
                        };
                    };
                };
            };


            stringify_emit(byte* text, Node* n) -> IRValue*
            {
                int len = pp_cstrlen(text);
                IRType* aty = this.mod.t_array(this.t_i8, len + 1);
                IRValue* cv;
                IRGlobal* gl;
                byte[24] dig;
                int nd;
                u64 id = (u64)n;
                Buf gn;
                byte* buf = (byte*)this.zbuf((len + 8) / 8 + 1);
                int i;
                while (i < len)
                {
                    buf[i] = text[i];
                    i++;
                };
                buf[len] = (byte)0;
                cv = this.mod.c_bytes(aty, buf, len + 1);
                gn.__init();
                defer gn.__exit();
                gn.put_str(f".stringify.{text}\0");
                gn.put(46);
                if (id == (u64)0) { dig[0] = '0'; nd = 1; };
                while (id > (u64)0)
                {
                    dig[nd] = (byte)('0' + (int)(id % (u64)10));
                    nd++;
                    id = id / (u64)10;
                };
                while (nd > 0)
                {
                    nd--;
                    gn.put(dig[nd]);
                };
                gl = this.mod.add_global(aty, gn.mem, cv.text);
                gl.linkage = this.mod.own(g"internal\0");
                gl.constant = true;
                this.mark_arr_ptr(gl.self.ty);
                this.mod.ia[0] = this.ci32(0);
                this.mod.ia[1] = this.ci32(0);
                this.sc.clear();
                this.sc.put_str(f"str_{text}\0");
                -> this.mod.gep(gl.self, this.mod.ia, 2, true, this.sc.mem);
            };


            x_stringify(Node* n) -> IRValue*
            {
                byte* text;
                switch (n.text2 != (byte*)0)
                {
                    case (true) {
                    switch (n.text2[0] == '#')
                    {
                        case (true) {
                        this.unsup(n, g"stringify of a union tag\0");
                        -> (IRValue*)0;
                    }
                        default {};
                    };
                    text = join3(n.text, g".\0", n.text2);
                    this.keep((void*)text);
                    -> this.stringify_emit(text, n);
                }
                    default
                    {
                        switch (this.find_var(n.text) == (LVar*)0 & st_lookup_any(this.st, n.text, this.cur_ns) == (IDKC_SYMENTRY*)0)
                        {
                            case (true) {
                            this.unsup(n, g"stringify of an undefined identifier\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                -> this.stringify_emit(n.text, n);
                            };
                        };
                    };
                };
            };


            x_tie(Node* n) -> IRValue*
            {
                LVar* lv;
                IRValue* tied;
                IRType* pt;
                switch (n.a.kind != NodeKind.IDENTIFIER)
                {
                    case (true) {
                    this.unsup(n, g"tie of a non variable\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (nm_get(this.untied, n.a.text) != (void*)0)
                        {
                            case (true) {
                            this.unsup(n, g"use after untie\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                lv = this.find_var(n.a.text);
                                switch (lv == (LVar*)0)
                                {
                                    case (true) {
                                    this.unsup(n, g"tie of an unknown variable\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        this.sc.clear();
                                        this.sc.put_str(f"{n.a.text}_tied\0");
                                        tied = this.mod.load(lv.ptr, this.sc.mem);
                                        nm_put(this.untied, n.a.text, (void*)1);
                                        pt = lv.ptr.ty.elem;
                                        switch (pt.kind == LK.PTR | pt.kind == LK.INT | pt.kind == LK.FLOAT | pt.kind == LK.DOUBLE |
                                                pt.kind == LK.STRUCT | pt.kind == LK.ISTRUCT | pt.kind == LK.ARRAY)
                                        {
                                            case (true) { this.mod.store(this.zero_of(pt), lv.ptr); }
                                            default {};
                                        };
                                        -> tied;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            x_vaaccess(Node* n) -> IRValue*
            {
                IRValue* idx;
                IRValue* cl;
                IRValue* cp;
                IRValue* res;
                IRValue* ctr;
                IRValue* cv;
                IRValue* c;
                IRValue* t;
                IRFunc* f;
                IRBlock* binit;
                IRBlock* bcond;
                IRBlock* bbody;
                IRBlock* bend;
                IRBlock* bmerge;
                switch (this.va_list_v == (IRValue*)0)
                {
                    case (true) {
                    this.unsup(n, g"...[N] used outside of a variadic function\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        idx = this.visit(n.a);
                        switch (this.bad | idx == (IRValue*)0)
                        {
                            case (true) { -> (IRValue*)0; }
                            default
                            {
                                switch (idx.ty.kind == LK.INT & idx.ty.width != 32)
                                {
                                    case (true) {
                                    switch (idx.ty.width > 32)
                                    {
                                        case (true) { idx = this.mod.cast(g"trunc\0", idx, this.t_i32, g"va_idx_trunc\0"); }
                                        default { idx = this.mod.cast(g"sext\0", idx, this.t_i32, g"va_idx_ext\0"); };
                                    };
                                }
                                    default {};
                                };
                                cl = this.mod.alloca_here(this.mod.t_array(this.t_i8p, 1), g"va_copy\0");
                                cp = this.mod.cast(g"bitcast\0", cl, this.t_i8p, g"va_copy_ptr\0");
                                this.mod.ia[0] = cp;
                                this.mod.ia[1] = this.va_list_p;
                                this.mod.call(this.va_intrinsic(g"llvm.va_copy\0", 2).self, this.mod.ia, 2, (byte*)0);
                                f = this.va_intrinsic(g"llvm.va_end\0", 1);
                                res = this.mod.alloca_here(this.t_i64, g"va_result\0");
                                binit = this.mod.append_block(this.fn, g"va_loop_init\0");
                                bcond = this.mod.append_block(this.fn, g"va_loop_cond\0");
                                bbody = this.mod.append_block(this.fn, g"va_loop_body\0");
                                bend = this.mod.append_block(this.fn, g"va_loop_end\0");
                                bmerge = this.mod.append_block(this.fn, g"va_merge\0");
                                this.mod.br(binit);
                                this.mod.position(this.fn, binit);
                                ctr = this.mod.alloca_here(this.t_i32, g"va_counter\0");
                                this.mod.store(this.mod.c_int(this.t_i32, (i64)0), ctr);
                                this.mod.br(bcond);
                                this.mod.position(this.fn, bcond);
                                cv = this.mod.load(ctr, g"va_cnt_load\0");
                                c = this.mod.icmp(g"slt\0", cv, idx, g"va_cond\0");
                                this.mod.cbr(c, bbody, bend);
                                this.mod.position(this.fn, bbody);
                                this.mod.va_arg(cp, this.t_i64, g"va_discard\0");
                                cv = this.mod.load(ctr, g"va_cnt_inc_load\0");
                                t = this.mod.binop(g"add\0", cv, this.mod.c_int(this.t_i32, (i64)1), g"va_cnt_inc\0");
                                this.mod.store(t, ctr);
                                this.mod.br(bcond);
                                this.mod.position(this.fn, bend);
                                t = this.mod.va_arg(cp, this.t_i64, g"va_result_val\0");
                                this.mod.store(t, res);
                                this.mod.ia[0] = cp;
                                this.mod.call(f.self, this.mod.ia, 1, (byte*)0);
                                this.mod.br(bmerge);
                                this.mod.position(this.fn, bmerge);
                                -> this.mod.load(res, g"va_arg_result\0");
                            };
                        };
                    };
                };
            };

            intrinsic(byte* name, IRType* ft) -> IRFunc*
            {
                IRFunc* f = this.mod.find_function(name);
                switch (f == (IRFunc*)0)
                {
                    case (true) { f = this.mod.add_function(ft, name); }
                    default {};
                };
                -> f;
            };


            bswap(IRValue* v) -> IRValue*
            {
                IRFunc* f;
                IRType** ps;
                int w = v.ty.width;
                switch (v.ty.kind != LK.INT)
                {
                    case (true) { -> v; }
                    default
                    {
                        switch (w < 16)
                        {
                            case (true) { -> v; }
                            default
                            {
                                switch (w % 16 != 0)
                                {
                                    case (true) { -> v; }
                                    default
                                    {
                                        this.sc.clear();
                                        this.sc.put_str(f"llvm.bswap.i{w}\0");
                                        ps = (IRType**)fmalloc((u64)2 * (u64)((sizeof(IRType*) + 7) / 8));
                                        this.keep((void*)ps);
                                        ps[0] = v.ty;
                                        f = this.intrinsic(this.sc.mem, this.mod.t_func(v.ty, ps, 1, false));
                                        this.mod.ia[0] = v;
                                        -> this.mod.call(f.self, this.mod.ia, 1, g"bswapped\0");
                                    };
                                };
                            };
                        };
                    };
                };
            };


            maybe_swap(IRValue* v, IRValue* target) -> IRValue*
            {
                IRValue* sw;
                TypeSpec* ns;
                int se, te;
                switch (v.ty.kind != LK.INT)
                {
                    case (true) { -> v; }
                    default
                    {
                        switch (v.ty.width < 16)
                        {
                            case (true) { -> v; }
                            default
                            {
                                se = this.endian_of(v.spec);
                                te = this.endian_of(target.spec);
                                switch (se == te)
                                {
                                    case (true) { -> v; }
                                    default
                                    {
                                        sw = this.bswap(v);
                                        switch (v.spec != (TypeSpec*)0)
                                        {
                                            case (true) {
                                            ns = typespec_clone(v.spec);
                                            ns.endianness = te;
                                            this.keep((void*)ns);
                                            sw.spec = ns;
                                        }
                                            default {};
                                        };
                                        -> sw;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            int_resize(IRValue* v, IRType* ty, bool uns) -> IRValue*
            {
                IRValue* r;
                switch (v.ty.width == ty.width)
                {
                    case (true) { -> v; }
                    default
                    {
                        switch (v.ty.width < ty.width)
                        {
                            case (true) {
                            switch (uns)
                            {
                                case (true) { r = this.mod.cast(g"zext\0", v, ty, (byte*)0); }
                                default { r = this.mod.cast(g"sext\0", v, ty, (byte*)0); };
                            };
                        }
                            default { r = this.mod.cast(g"trunc\0", v, ty, (byte*)0); };
                        };
                        r.spec = v.spec;
                        -> r;
                    };
                };
            };


            normalize_ints(IRValue* a, IRValue* b, bool uns, bool promote) -> void
            {
                int w;
                IRType* ty;
                this.nra = a;
                this.nrb = b;
                switch (a.ty.width == b.ty.width)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (promote)
                        {
                            case (true) {
                            w = a.ty.width;
                            switch (b.ty.width > w)
                            {
                                case (true) { w = b.ty.width; }
                                default {};
                            };
                        }
                            default {
                            w = a.ty.width;
                            switch (b.ty.width < w)
                            {
                                case (true) { w = b.ty.width; }
                                default {};
                            };
                        };
                        };
                        ty = this.int_ty(w);
                        this.nra = this.int_resize(a, ty, uns);
                        this.nrb = this.int_resize(b, ty, uns);
                        ->;
                    };
                };
            };


            to_bool(IRValue* v) -> IRValue*
            {
                IRType* t = v.ty;
                switch (t.kind == LK.INT)
                {
                    case (true) {
                    switch (t.width == 1)
                    {
                        case (true) { -> v; }
                        default {};
                    };
                    -> this.mod.icmp(g"ne\0", v, this.mod.c_int(t, (i64)0), g"tobool\0");
                }
                    default
                    {
                        switch (t.kind == LK.PTR)
                        {
                            case (true) { -> this.mod.icmp(g"ne\0", v, this.mod.c_null(t), g"ptrbool\0"); }
                            default
                            {
                                switch (t.kind == LK.FLOAT | t.kind == LK.DOUBLE)
                                {
                                    case (true) {
                                    -> this.mod.fcmp(g"one\0", v, this.mod.c_fp(t, 0.0), g"fpbool\0");
                                }
                                    default
                                    {
                                        -> this.mod.icmp(g"ne\0", v, this.mod.c_null(t), g"tobool\0");
                                    };
                                };
                            };
                        };
                    };
                };
            };





            is_aggregate_ty(IRType* t) -> bool -> t.kind == LK.STRUCT | t.kind == LK.ISTRUCT;


            coerce_ret(IRValue* v, IRType* expected, Node* site) -> IRValue*
            {
                IRType* src = v.ty;
                IRValue* r;
                switch (lt_eq(src, expected))
                {
                    case (true) { -> v; }
                    default
                    {
                        switch (src.kind == LK.INT & expected.kind == LK.INT)
                        {
                            case (true) {
                            switch (src.width < expected.width)
                            {
                                case (true) {
                                switch (this.is_uns(v))
                                {
                                    case (true) { r = this.mod.cast(g"zext\0", v, expected, (byte*)0); }
                                    default { r = this.mod.cast(g"sext\0", v, expected, (byte*)0); };
                                };
                            }
                                default { r = this.mod.cast(g"trunc\0", v, expected, (byte*)0); };
                            };
                            r.spec = v.spec;
                            -> r;
                        }
                            default
                            {
                                switch ((src.kind == LK.FLOAT | src.kind == LK.DOUBLE) & expected.kind == LK.INT)
                                {
                                    case (true) {
                                    switch (v.spec != (TypeSpec*)0 & this.is_uns(v))
                                    {
                                        case (true) { r = this.mod.cast(g"fptoui\0", v, expected, (byte*)0); }
                                        default { r = this.mod.cast(g"fptosi\0", v, expected, (byte*)0); };
                                    };
                                    r.spec = v.spec;
                                    -> r;
                                }
                                    default
                                    {
                                        switch (src.kind == LK.INT & (expected.kind == LK.FLOAT | expected.kind == LK.DOUBLE))
                                        {
                                            case (true) {
                                            switch (this.is_uns(v))
                                            {
                                                case (true) { r = this.mod.cast(g"uitofp\0", v, expected, (byte*)0); }
                                                default { r = this.mod.cast(g"sitofp\0", v, expected, (byte*)0); };
                                            };
                                            r.spec = v.spec;
                                            -> r;
                                        }
                                            default
                                            {
                                                switch ((src.kind == LK.FLOAT | src.kind == LK.DOUBLE) & (expected.kind == LK.FLOAT | expected.kind == LK.DOUBLE))
                                                {
                                                    case (true) {
                                                    switch (src.kind)
                                                    {
                                                        case (LK.FLOAT) { r = this.mod.cast(g"fpext\0", v, expected, (byte*)0); }
                                                        default { r = this.mod.cast(g"fptrunc\0", v, expected, (byte*)0); };
                                                    };
                                                    r.spec = v.spec;
                                                    -> r;
                                                }
                                                    default
                                                    {
                                                        switch (src.kind == LK.PTR & expected.kind == LK.PTR)
                                                        {
                                                            case (true) {
                                                            -> this.mod.cast(g"bitcast\0", v, expected, (byte*)0);
                                                        }
                                                            default
                                                            {

                                                                if (src.kind == LK.INT & expected.kind == LK.PTR & v.is_const)
                                                                {
                                                                    if (cstr_eq(v.text, g"0\0")) { -> this.mod.c_null(expected); };
                                                                    -> this.mod.cast(g"inttoptr\0", v, expected, (byte*)0);
                                                                };
                                                                switch (src.kind == LK.STRUCT & expected.kind == LK.STRUCT)
                                                                {
                                                                    case (true) {
                                                                    this.unsup(site, g"return struct mismatch\0");
                                                                    -> v;
                                                                }
                                                                    default
                                                                    {
                                                                        switch (src.kind == LK.ARRAY & expected.kind == LK.ARRAY)
                                                                        {
                                                                            case (true) {
                                                                            this.unsup(site, g"return array conversion\0");
                                                                            -> v;
                                                                        }
                                                                            default
                                                                            {
                                                                                switch (src.kind == LK.PTR)
                                                                                {
                                                                                    case (true) {
                                                                                    switch (lt_eq(src.elem, expected))
                                                                                    {
                                                                                        case (true) { -> this.mod.load(v, g"array_decay\0"); }
                                                                                        default {};
                                                                                    };
                                                                                }
                                                                                    default {};
                                                                                };
                                                                                this.unsup(site, g"return type mismatch\0");
                                                                                -> v;
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            store_conv(IRValue* alloca, IRType* llvm_type, IRValue* iv, Node* ini, Node* site) -> void
            {
                IRValue* v = iv;
                IRType* vt = v.ty;
                int ik = ini.kind;
                switch (ik == NodeKind.CAST_EXPRESSION & vt.kind == LK.PTR & llvm_type.kind == LK.ARRAY)
                {
                    case (true) {
                    v = this.mod.cast(g"bitcast\0", v, this.ptr_of(llvm_type), g"cast_to_array_ptr\0");
                    v = this.mod.load(v, g"loaded_array\0");
                    -> this.mod.store(v, alloca);
                }
                    default
                    {
                        switch (!lt_eq(vt, llvm_type))
                        {
                            case (true) {
                            switch (vt.kind == LK.PTR & vt.elem.kind == LK.ARRAY & llvm_type.kind == LK.ARRAY)
                            {
                                case (true) {
                                switch (vt.elem.elem.kind == llvm_type.elem.kind & vt.elem.elem.width == llvm_type.elem.width & vt.elem.count <= llvm_type.count)
                                {
                                    case (true) {
                                    -> this.array_widen(alloca, v, llvm_type);
                                }
                                    default {};
                                };
                                switch (ik == NodeKind.BINARY_OP & (ini.op == Operator.ADD | ini.op == Operator.SUB))
                                {
                                    case (true) {
                                    -> this.mod.store(this.mod.load(v, g"concat_array_value\0"), alloca);
                                }
                                    default {};
                                };
                                -> this.unsup(site, g"array widening initializer\0");
                            }
                                default
                                {
                                    switch (ik == NodeKind.BINARY_OP & (ini.op == Operator.ADD | ini.op == Operator.SUB) & vt.kind == LK.PTR & vt.elem.kind == LK.ARRAY &
                                        llvm_type.kind == LK.PTR & llvm_type.elem.kind == LK.INT)
                                    {
                                        case (true) {
                                        this.mod.ia[0] = this.ci32(0);
                                        this.mod.ia[1] = this.ci32(0);
                                        -> this.mod.store(this.mod.gep(v, this.mod.ia, 2, false, g"concat_array_to_ptr\0"), alloca);
                                    }
                                        default
                                        {
                                            switch (vt.kind == LK.PTR & vt.elem.kind == LK.ARRAY & llvm_type.kind == LK.INT)
                                            {
                                                case (true) {
                                                -> this.unsup(site, g"array pack initializer\0");
                                            }
                                                default
                                                {
                                                    switch (vt.kind == LK.PTR & this.is_aggregate_ty(llvm_type) & lt_eq(vt.elem, llvm_type))
                                                    {
                                                        case (true) {
                                                        v = this.mod.load(v, g"struct_deref\0");
                                                    }
                                                        default {
                                                            switch (vt.kind == LK.PTR & llvm_type.kind == LK.INT)
                                                            {
                                                                case (true) {
                                                        v = this.mod.cast(g"ptrtoint\0", v, llvm_type, g"ptr_to_int\0");
                                                    }
                                                                default {
                                                                    switch (vt.kind == LK.INT & llvm_type.kind == LK.PTR)
                                                                    {
                                                                        case (true) {
                                                        v = this.mod.cast(g"inttoptr\0", v, llvm_type, g"int_to_ptr\0");
                                                    }
                                                                        default {
                                                                            switch (vt.kind == LK.PTR & llvm_type.kind == LK.PTR)
                                                                            {
                                                                                case (true) {
                                                        switch (!lt_eq(llvm_type.elem, vt.elem))
                                                        {
                                                            case (true) { v = this.mod.cast(g"bitcast\0", v, llvm_type, (byte*)0); }
                                                            default {
                                                                switch (vt.elem.kind == LK.ARRAY)
                                                                {
                                                                    case (true) {
                                                            -> this.unsup(site, g"array pointer pack initializer\0");
                                                        }
                                                                    default {};
                                                                };
                                                            };
                                                        };
                                                    }
                                                                                default {
                                                                                    switch (vt.kind == LK.INT & llvm_type.kind == LK.INT)
                                                                                    {
                                                                                        case (true) {
                                                        switch (vt.width > llvm_type.width)
                                                        {
                                                            case (true) { v = this.mod.cast(g"trunc\0", v, llvm_type, (byte*)0); }
                                                            default {
                                                                switch (vt.width < llvm_type.width)
                                                                {
                                                                    case (true) {
                                                            switch (this.is_uns(v))
                                                            {
                                                                case (true) { v = this.mod.cast(g"zext\0", v, llvm_type, (byte*)0); }
                                                                default { v = this.mod.cast(g"sext\0", v, llvm_type, (byte*)0); };
                                                            };
                                                        }
                                                                    default {};
                                                                };
                                                            };
                                                        };
                                                    }
                                                                                        default {
                                                                                            switch (vt.kind == LK.INT & (llvm_type.kind == LK.FLOAT | llvm_type.kind == LK.DOUBLE))
                                                                                            {
                                                                                                case (true) {
                                                        v = this.mod.cast(g"sitofp\0", v, llvm_type, (byte*)0);
                                                    }
                                                                                                default {
                                                                                                    switch ((vt.kind == LK.FLOAT | vt.kind == LK.DOUBLE) & llvm_type.kind == LK.INT)
                                                                                                    {
                                                                                                        case (true) {
                                                        v = this.mod.cast(g"fptosi\0", v, llvm_type, (byte*)0);
                                                    }
                                                                                                        default {
                                                                                                            switch (vt.kind == LK.FLOAT & llvm_type.kind == LK.DOUBLE)
                                                                                                            {
                                                                                                                case (true) {
                                                        v = this.mod.cast(g"fpext\0", v, llvm_type, g"float_to_double\0");
                                                    }
                                                                                                                default {
                                                                                                                    switch (vt.kind == LK.DOUBLE & llvm_type.kind == LK.FLOAT)
                                                                                                                    {
                                                                                                                        case (true) {
                                                        v = this.mod.cast(g"fptrunc\0", v, llvm_type, g"double_to_float\0");
                                                    }
                                                                                                                        default {};
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        switch (v.spec != (TypeSpec*)0)
                        {
                            case (true) {
                            switch (alloca.spec == (TypeSpec*)0)
                            {
                                case (true) { alloca.spec = v.spec; }
                                default {};
                            };
                        }
                            default {};
                        };
                        v = this.maybe_swap(v, alloca);
                        -> this.mod.store(v, alloca);
                    };
                };
            };


            convert_assign(IRValue* v, IRType* target) -> IRValue*
            {
                IRType* vt = v.ty;
                switch (lt_eq(vt, target))
                {
                    case (true) { -> v; }
                    default
                    {
                        switch (vt.kind == LK.PTR & target.kind == LK.PTR)
                        {
                            case (true) {
                            switch (vt.elem.kind == LK.PTR & lt_eq(vt.elem, target))
                            {
                                case (true) {
                                -> this.mod.load(v, g"ptr_val_loaded\0");
                            }
                                default
                                {
                                    switch (lt_eq(vt.elem, target.elem))
                                    {
                                        case (true) { -> this.mod.cast(g"bitcast\0", v, target, g"ptr_compat\0"); }
                                        default
                                        {
                                            switch (vt.elem.kind == LK.INT & vt.elem.width == 8 & target.elem.kind == LK.INT & target.elem.width == 8)
                                            {
                                                case (true) {
                                                -> this.mod.cast(g"bitcast\0", v, target, g"i8ptr_compat\0");
                                            }
                                                default {};
                                            };
                                        };
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        switch (vt.kind == LK.PTR & vt.elem.kind == LK.ARRAY)
                        {
                            case (true) {
                            switch (target.kind == LK.PTR)
                            {
                                case (true) {
                                switch (lt_eq(target.elem, vt.elem))
                                {
                                    case (true) { -> v; }
                                    default {};
                                };
                                switch (lt_eq(target.elem, vt.elem.elem))
                                {
                                    case (true) {
                                    this.mod.ia[0] = this.ci32(0);
                                    this.mod.ia[1] = this.ci32(0);
                                    -> this.mod.gep(v, this.mod.ia, 2, false, g"array_to_elem_ptr\0");
                                }
                                    default {};
                                };
                                switch (target.elem.kind == LK.ARRAY)
                                {
                                    case (true) {
                                    switch (target.elem.count == vt.elem.count)
                                    {
                                        case (true) {
                                        -> this.mod.cast(g"bitcast\0", v, target, g"array_ptr_bitcast\0");
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                this.mod.ia[0] = this.ci32(0);
                                this.mod.ia[1] = this.ci32(0);
                                -> this.mod.gep(v, this.mod.ia, 2, false, g"array_to_ptr\0");
                            }
                                default
                                {
                                    switch (lt_eq(target, vt.elem))
                                    {
                                        case (true) { -> this.mod.load(v, g"array_load\0"); }
                                        default {};
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        switch (vt.kind == LK.PTR & target.kind != LK.PTR)
                        {
                            case (true) {
                            switch (lt_eq(vt.elem, target))
                            {
                                case (true) { -> this.mod.load(v, g"struct_copy_load\0"); }
                                default {};
                            };
                        }
                            default {};
                        };
                        switch (vt.kind == LK.PTR & vt.elem.kind == LK.INT & vt.elem.width == 8 & target.kind == LK.PTR)
                        {
                            case (true) {
                            -> this.mod.cast(g"bitcast\0", v, target, g"void_ptr_to_typed\0");
                        }
                            default
                            {
                                switch (vt.kind == LK.INT & target.kind == LK.INT)
                                {
                                    case (true) {
                                    switch (vt.width != target.width)
                                    {
                                        case (true) {
                                        -> this.int_resize(v, target, this.is_uns(v));
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (vt.kind == LK.FLOAT & target.kind == LK.DOUBLE)
                                {
                                    case (true) {
                                    -> this.mod.cast(g"fpext\0", v, target, g"f32_to_f64\0");
                                }
                                    default
                                    {
                                        switch (vt.kind == LK.DOUBLE & target.kind == LK.FLOAT)
                                        {
                                            case (true) {
                                            -> this.mod.cast(g"fptrunc\0", v, target, g"f64_to_f32\0");
                                        }
                                            default
                                            {
                                                -> v;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            convert_arg(IRValue* v, IRType* expected, int idx, Node* site) -> IRValue*
            {
                IRType* vt = v.ty;
                IRValue* d;
                switch (lt_eq(vt, expected))
                {
                    case (true) { -> v; }
                    default
                    {
                        this.sc.clear();
                        switch (expected.kind == LK.PTR & expected.elem.kind == LK.INT & expected.elem.width == 8)
                        {
                            case (true) {
                            switch (vt.kind == LK.PTR)
                            {
                                case (true) {
                                switch (vt.elem.kind == LK.ARRAY)
                                {
                                    case (true) {
                                    this.sc.put_str(f"arg{idx}_decay\0");
                                    this.mod.ia[0] = this.ci32(0);
                                    this.mod.ia[1] = this.ci32(0);
                                    d = this.mod.gep(v, this.mod.ia, 2, false, this.sc.mem);
                                    this.sc.clear();
                                    this.sc.put_str(f"arg{idx}_to_void_ptr\0");
                                    -> this.mod.cast(g"bitcast\0", d, expected, this.sc.mem);
                                }
                                    default
                                    {
                                        this.sc.put_str(f"arg{idx}_to_void_ptr\0");
                                        -> this.mod.cast(g"bitcast\0", v, expected, this.sc.mem);
                                    };
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                        switch (vt.kind == LK.PTR & vt.elem.kind == LK.INT & vt.elem.width == 8 & expected.kind == LK.PTR)
                        {
                            case (true) {
                            this.sc.put_str(f"arg{idx}\0");
                            switch (expected.elem.kind)
                            {
                                case (LK.ARRAY) { this.sc.put_str(g"_to_array_ptr\0"); }
                                default { this.sc.put_str(g"_from_void_ptr\0"); };
                            };
                            -> this.mod.cast(g"bitcast\0", v, expected, this.sc.mem);
                        }
                            default
                            {
                                switch (vt.kind == LK.PTR & vt.elem.kind == LK.ARRAY & expected.kind == LK.PTR)
                                {
                                    case (true) {
                                    switch (lt_eq(vt.elem.elem, expected.elem))
                                    {
                                        case (true) {
                                        this.sc.put_str(f"arg{idx}_decay\0");
                                        this.mod.ia[0] = this.ci32(0);
                                        this.mod.ia[1] = this.ci32(0);
                                        -> this.mod.gep(v, this.mod.ia, 2, false, this.sc.mem);
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (vt.kind == LK.INT & expected.kind == LK.INT)
                                {
                                    case (true) {
                                    switch (vt.width != expected.width)
                                    {
                                        case (true) { -> this.int_resize(v, expected, this.is_uns(v)); }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (vt.kind == LK.FLOAT & expected.kind == LK.DOUBLE)
                                {
                                    case (true) {
                                    this.sc.put_str(f"arg{idx}_float_to_double\0");
                                    -> this.mod.cast(g"fpext\0", v, expected, this.sc.mem);
                                }
                                    default
                                    {
                                        switch (vt.kind == LK.DOUBLE & expected.kind == LK.FLOAT)
                                        {
                                            case (true) {
                                            this.sc.put_str(f"arg{idx}_double_to_float\0");
                                            -> this.mod.cast(g"fptrunc\0", v, expected, this.sc.mem);
                                        }
                                            default
                                            {
                                                switch (vt.kind == LK.PTR & this.is_aggregate_ty(expected))
                                                {
                                                    case (true) {
                                                    switch (lt_eq(vt.elem, expected))
                                                    {
                                                        case (true) {
                                                        this.sc.put_str(f"arg{idx}_load\0");
                                                        -> this.mod.load(v, this.sc.mem);
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                this.unsup(site, g"argument type mismatch\0");
                                                -> v;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };





            x_literal(Node* n) -> IRValue*
            {
                int dt = n.op;
                i64 v = n.ival;
                int w;
                IRValue* r;
                switch (dt == DataType.SINT | dt == DataType.UINT)
                {
                    case (true) {

                    switch (v < (i64)0 & n.text != (byte*)0)
                    {
                        case (true) {
                        switch (n.text[0] != '-')
                        {
                            case (true) {

                            switch (dt == DataType.UINT)
                            {
                                case (true) { r = this.mod.c_int(this.t_i64, v); }
                                default { r = this.mod.c_u64(this.t_i64, (u64)v); };
                            };
                            r.spec = this.lit_spec(dt);
                            -> r;
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    w = 32;
                    switch (dt)
                    {
                        case (DataType.SINT)
                        {
                            switch (v < (i64)(0 - 2147483647 - 1) | v > (i64)2147483647)
                            {
                                case (true) { w = 64; }
                                default {};
                            };
                        }
                        default
                        {
                            switch (v >= (i64)0)
                            {
                                case (true) {
                                switch (v > (i64)4294967295)
                                {
                                    case (true) { w = 64; }
                                    default {};
                                };
                            }
                                default {
                                switch (v < (i64)0 - (i64)4294967296)
                                {
                                    case (true) { w = 64; }
                                    default {};
                                };
                            };
                            };
                            switch (w == 32 & v > (i64)2147483647)
                            {
                                case (true) { v = v - (i64)4294967296; }
                                default {};
                            };
                        };
                    };
                    r = this.mod.c_int(this.int_ty(w), v);
                    r.spec = this.lit_spec(dt);
                    -> r;
                }
                    default
                    {
                        switch (dt == DataType.SLONG | dt == DataType.ULONG)
                        {
                            case (true) {

                            r = this.mod.c_int(this.t_i64, v);
                            r.spec = this.lit_spec(dt);
                            -> r;
                        }
                            default
                            {
                                switch (dt == DataType.FLOAT)
                                {
                                    case (true) { -> this.mod.c_fp(this.t_float, n.fval); }
                                    default
                                    {
                                        switch (dt == DataType.DOUBLE)
                                        {
                                            case (true) { -> this.mod.c_fp(this.t_double, n.fval); }
                                            default
                                            {
                                                switch (dt == DataType.BOOL)
                                                {
                                                    case (true) { -> this.mod.c_int(this.t_i1, v); }
                                                    default
                                                    {
                                                        switch (dt == DataType.CHAR)
                                                        {
                                                            case (true) { -> this.mod.c_int(this.t_i8, v); }
                                                            default
                                                            {
                                                                switch (dt == DataType.BYTE)
                                                                {
                                                                    case (true) { -> this.mod.c_int(this.int_ty(this.byte_width), v); }
                                                                    default
                                                                    {
                                                                        switch (dt == DataType.VOID)
                                                                        {
                                                                            case (true) { -> this.mod.c_null(this.t_i1); }
                                                                            default
                                                                            {
                                                                                this.unsup(n, g"literal type\0");
                                                                                -> (IRValue*)0;
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            try_expr_method(IRValue* ptr) -> IRValue*
            {
                IRType* pe;
                IRType* st_ty;
                IRValue* this_ptr;
                PtrVec* list;
                Overload* o;
                Overload* oc;
                int oi;
                IRFunc* f;
                byte* key;
                IRValue* r;
                switch (this.in_member)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        switch (ptr.ty.kind != LK.PTR)
                        {
                            case (true) { -> (IRValue*)0; }
                            default
                            {
                                pe = ptr.ty.elem;
                                switch (pe.kind == LK.PTR & pe.elem.kind == LK.ISTRUCT)
                                {
                                    case (true) {
                                    st_ty = pe.elem;
                                    this_ptr = this.mod.load(ptr, g"obj_this\0");
                                }
                                    default {
                                        switch (pe.kind == LK.ISTRUCT)
                                        {
                                            case (true) {
                                    st_ty = pe;
                                    this_ptr = ptr;
                                }
                                            default { -> (IRValue*)0; };
                                        };
                                    };
                                };
                                switch (st_ty.name == (byte*)0)
                                {
                                    case (true) { -> (IRValue*)0; }
                                    default
                                    {
                                        key = join3(st_ty.name, g".__expr\0", g"\0");
                                        list = st_overloads_of(this.st, key);
                                        ffree(key);
                                        switch (list == (PtrVec*)0)
                                        {
                                            case (true) { -> (IRValue*)0; }
                                            default
                                            {
                                                o = (Overload*)0;
                                                oi = 0;
                                                while (oi < list.len)
                                                {
                                                    oc = (Overload*)list.items[oi];
                                                    switch (oc.nparams == 0)
                                                    {
                                                        case (true) {
                                                        o = oc;
                                                        break;
                                                    }
                                                        default
                                                        {
                                                            oi++;
                                                        };
                                                    };
                                                };
                                                switch (o == (Overload*)0)
                                                {
                                                    case (true) { -> (IRValue*)0; }
                                                    default
                                                    {
                                                        f = this.mod.find_function(o.mangled);
                                                        switch (f == (IRFunc*)0)
                                                        {
                                                            case (true) { -> (IRValue*)0; }
                                                            default
                                                            {
                                                                this.sc.clear();
                                                                this.sc.put_str(f"{st_ty.name}_expr\0");
                                                                this.mod.ia[0] = this_ptr;
                                                                r = this.mod.call(f.self, this.mod.ia, 1, this.sc.mem);
                                                                r.flags = r.flags `| 1;
                                                                -> r;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            x_ident(Node* n) -> IRValue*
            {
                LVar* lv = this.find_var(n.text);
                IRValue* ptr;
                IRValue* r;
                IRValue* e;
                TypeSpec* ts;
                switch (lv == (LVar*)0)
                {
                    case (true) {
                    this.unsup(n, g"identifier not local\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        ptr = lv.ptr;
                        ts = lv.ts;

                        switch (nm_get(this.untied, n.text) != (void*)0 & this.find_local(n.text) != (LVar*)0)
                        {
                            case (true) {
                            this.unsup(n, g"use after untie\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (cstr_eq(n.text, g"this\0"))
                                {
                                    case (true) { -> ptr; }
                                    default
                                    {
                                        e = this.try_expr_method(ptr);
                                        switch (e != (IRValue*)0)
                                        {
                                            case (true) { -> e; }
                                            default
                                            {
                                                switch (ptr.ty.kind == LK.PTR)
                                                {
                                                    case (true) {
                                                    switch (ptr.ty.elem.kind == LK.ARRAY | ptr.ty.elem.kind == LK.STRUCT)
                                                    {
                                                        case (true) { -> ptr; }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (ts != (TypeSpec*)0)
                                                {
                                                    case (true) {
                                                    switch (ts.array_size != (Node*)0)
                                                    {
                                                        case (true) { -> ptr; }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (ptr.spec != (TypeSpec*)0)
                                                {
                                                    case (true) {
                                                    switch (ptr.spec.array_size != (Node*)0)
                                                    {
                                                        case (true) { -> ptr; }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (ptr.ty.kind != LK.PTR)
                                                {
                                                    case (true) { -> ptr; }
                                                    default
                                                    {
                                                        r = this.mod.load(ptr, n.text);
                                                        r.spec = ptr.spec;
                                                        switch (r.spec == (TypeSpec*)0)
                                                        {
                                                            case (true) { r.spec = ts; }
                                                            default {};
                                                        };
                                                        r.flags = ptr.flags `& 2;
                                                        -> r;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            int_pred(int op, bool uns) -> byte*
            {
                switch (op == Operator.EQUAL)
                {
                    case (true) { -> g"eq\0"; }
                    default
                    {
                                       switch (op == Operator.NOT_EQUAL)
                                       {
                                           case (true) { -> g"ne\0"; }
                                           default
                                           {
                                                              switch (op == Operator.LESS_THAN)
                                                              {
                                                                  case (true) { switch (uns)
                                               {
                                                   case (true) { -> g"ult\0"; }
                                                   default {};
                                               }; -> g"slt\0"; }
                                                                  default
                                                                  {
                                                                                     switch (op == Operator.LESS_EQUAL)
                                                                                     {
                                                                                         case (true) { switch (uns)
                                                                      {
                                                                          case (true) { -> g"ule\0"; }
                                                                          default {};
                                                                      }; -> g"sle\0"; }
                                                                                         default
                                                                                         {
                                                                                                            switch (op == Operator.GREATER_THAN)
                                                                                                            {
                                                                                                                case (true) { switch (uns)
                                                                                             {
                                                                                                 case (true) { -> g"ugt\0"; }
                                                                                                 default {};
                                                                                             }; -> g"sgt\0"; }
                                                                                                                default
                                                                                                                {
                                                                                                                    switch (uns)
                                                                                                                    {
                                                                                                                        case (true) { -> g"uge\0"; }
                                                                                                                        default
                                                                                                                        {
                                                                                                                            -> g"sge\0";
                                                                                                                        };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                         };
                                                                                     };
                                                                  };
                                                              };
                                           };
                                       };
                    };
                };
            };

            fp_pred(int op) -> byte*
            {
                switch (op == Operator.EQUAL)
                {
                    case (true) { -> g"oeq\0"; }
                    default
                    {
                        switch (op == Operator.NOT_EQUAL)
                        {
                            case (true) { -> g"one\0"; }
                            default
                            {
                                switch (op == Operator.LESS_THAN)
                                {
                                    case (true) { -> g"olt\0"; }
                                    default
                                    {
                                        switch (op == Operator.LESS_EQUAL)
                                        {
                                            case (true) { -> g"ole\0"; }
                                            default
                                            {
                                                switch (op == Operator.GREATER_THAN)
                                                {
                                                    case (true) { -> g"ogt\0"; }
                                                    default
                                                    {
                                                        -> g"oge\0";
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


has_op_overload(int op) -> bool -> this.op_overloads(op) != (PtrVec*)0;


            op_overloads(int op) -> PtrVec*
            {
                byte* sym = operator_text(op);
                this.sc.clear();
                this.sc.put_str(g"operator__\0");
                mangle_builtin_op(@this.sc, sym);
                -> st_overloads_of(this.st, this.sc.mem);
            };





            binop_ptr_overload(Node* n, int op) -> IRValue*
            {
                PtrVec* list = this.op_overloads(op);
                Overload* o;
                IRFunc* f;
                IRFunc* pf = (IRFunc*)0;
                LVar* ll;
                LVar* rl;
                IRValue** args;
                int i = 0;
                switch (list == (PtrVec*)0)
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                while (i < list.len & pf == (IRFunc*)0)
                {
                    o = (Overload*)list.items[i];
                    i++;
                    switch (o.nparams != 2)
                    {
                        case (true) { continue; }
                        default {};
                    };
                    f = this.mod.find_function(o.mangled);
                    switch (f == (IRFunc*)0)
                    {
                        case (true) { continue; }
                        default {};
                    };
                    switch (f.ftype.nitems != 2)
                    {
                        case (true) { continue; }
                        default {};
                    };
                    switch (!this.ov_visible(o))
                    {
                        case (true) { continue; }
                        default {};
                    };
                    switch (f.ftype.items[0].kind == LK.PTR & f.ftype.items[1].kind == LK.PTR)
                    {
                        case (true) { pf = f; }
                        default {};
                    };
                };
                switch (pf == (IRFunc*)0 | pf == this.fn)
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                switch (n.a.kind != NodeKind.IDENTIFIER | n.b.kind != NodeKind.IDENTIFIER)
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                ll = this.find_local(n.a.text);
                rl = this.find_local(n.b.text);
                switch (ll == (LVar*)0 | rl == (LVar*)0)
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                switch (!lt_eq(ll.ptr.ty, pf.ftype.items[0]) | !lt_eq(rl.ptr.ty, pf.ftype.items[1]))
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                args = (IRValue**)fmalloc((u64)2 * (u64)((sizeof(IRValue*) + 7) / 8));
                this.keep((void*)args);
                args[0] = ll.ptr;
                args[1] = rl.ptr;
                -> this.mod.call_ex(pf.self, args, 2, g"op_overload_result\0", pf.cconv, false);
            };



            ov_visible(Overload* o) -> bool
            {
                switch (this.cur_fd == (Node*)0 | o.func == (Node*)0)
                {
                    case (true) { -> true; }
                    default {};
                };
                switch (o.func.line == 0 | this.cur_fd.line == 0)
                {
                    case (true) { -> true; }
                    default {};
                };
                -> o.func.line < this.cur_fd.line;
            };



            ov_arg_ok(IRValue* v, IRType* pt) -> bool
            {
                IRType* rt = v.ty;
                switch (lt_eq(rt, pt))
                {
                    case (true) { -> true; }
                    default {};
                };
                switch (rt.kind == LK.PTR & pt.kind == LK.PTR)
                {
                    case (true) {
                        switch (lt_eq(rt.elem, pt.elem))
                        {
                            case (true) { -> true; }
                            default {};
                        };
                        switch (rt.elem.kind == LK.ARRAY)
                        {
                            case (true) { -> lt_eq(rt.elem.elem, pt.elem); }
                            default {};
                        };
                    }
                    default {};
                };
                -> false;
            };




            binop_overload(Node* n, int op, IRValue* lhs, IRValue* rhs) -> IRValue*
            {
                PtrVec* list = this.op_overloads(op);
                Overload* o;
                IRFunc* f;
                IRValue** args;
                IRValue* av;
                IRType* pt;
                int i = 0;
                int k;
                switch (list == (PtrVec*)0)
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                while (i < list.len)
                {
                    o = (Overload*)list.items[i];
                    i++;
                    switch (o.nparams != 2)
                    {
                        case (true) { continue; }
                        default {};
                    };
                    f = this.mod.find_function(o.mangled);
                    switch (f == (IRFunc*)0 | f == this.fn)
                    {
                        case (true) { continue; }
                        default {};
                    };
                    switch (f.ftype.nitems != 2)
                    {
                        case (true) { continue; }
                        default {};
                    };
                    switch (!this.ov_visible(o))
                    {
                        case (true) { continue; }
                        default {};
                    };
                    switch (!this.ov_arg_ok(lhs, f.ftype.items[0]) | !this.ov_arg_ok(rhs, f.ftype.items[1]))
                    {
                        case (true) { continue; }
                        default {};
                    };
                    args = (IRValue**)fmalloc((u64)2 * (u64)((sizeof(IRValue*) + 7) / 8));
                    this.keep((void*)args);
                    k = 0;
                    while (k < 2)
                    {
                        av = lhs;
                        switch (k == 1)
                        {
                            case (true) { av = rhs; }
                            default {};
                        };
                        pt = f.ftype.items[k];
                        switch (lt_eq(av.ty, pt))
                        {
                            case (true) {}
                            default
                            {
                                switch (av.ty.kind == LK.PTR & pt.kind == LK.PTR & lt_eq(av.ty.elem, pt.elem))
                                {
                                    case (true) {}
                                    default
                                    {
                                        switch (av.ty.kind == LK.PTR & av.ty.elem.kind != LK.ARRAY & av.ty.elem.kind != LK.STRUCT &
                                            av.ty.elem.kind != LK.ISTRUCT & lt_eq(av.ty.elem, pt))
                                        {
                                            case (true) { av = this.mod.load(av, g"op_deref\0"); }
                                            default
                                            {
                                                av = this.convert_arg(av, pt, k, n);
                                                switch (this.bad)
                                                {
                                                    case (true) { -> (IRValue*)0; }
                                                    default {};
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        args[k] = av;
                        k++;
                    };
                    -> this.mod.call_ex(f.self, args, 2, g"op_overload_result\0", f.cconv, false);
                };
                -> (IRValue*)0;
            };


            emit_memcpy_bytes(IRValue* dst, IRValue* src, i64 bytes) -> void
            {
                -> this.emit_memcpy_val(dst, src, this.mod.c_int(this.t_i64, bytes));
            };


            emit_memcpy_val(IRValue* dst, IRValue* src, IRValue* cnt) -> void
            {
                IRType** ps = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                IRType* i8p = this.mod.t_ptr(this.t_i8);
                IRFunc* f;
                this.keep((void*)ps);
                ps[0] = i8p;
                ps[1] = i8p;
                ps[2] = this.t_i64;
                ps[3] = this.t_i1;
                f = this.intrinsic(g"llvm.memcpy.p0i8.p0i8.i64\0", this.mod.t_func(this.t_void, ps, 4, false));
                switch (dst.ty != i8p)
                {
                    case (true) { dst = this.mod.cast(g"bitcast\0", dst, i8p, (byte*)0); }
                    default {};
                };
                switch (src.ty != i8p)
                {
                    case (true) { src = this.mod.cast(g"bitcast\0", src, i8p, (byte*)0); }
                    default {};
                };
                this.mod.ia[0] = dst;
                this.mod.ia[1] = src;
                this.mod.ia[2] = cnt;
                this.mod.ia[3] = this.mod.c_null(this.t_i1);
                this.mod.call(f.self, this.mod.ia, 4, (byte*)0);
                ->;
            };

            arr_start(IRValue* p, byte* hint) -> IRValue*
            {
                this.mod.ia[0] = this.ci32(0);
                this.mod.ia[1] = this.ci32(0);
                -> this.mod.gep(p, this.mod.ia, 2, false, hint);
            };


            array_concat(Node* n, IRValue* lhs, IRValue* rhs, int op) -> IRValue*
            {
                IRType* le = lhs.ty.elem.elem;
                IRType* re = rhs.ty.elem.elem;
                int ll = lhs.ty.elem.count;
                int rl = rhs.ty.elem.count;
                int nt = 0;
                int rlen;
                int lcopy;
                int eb;
                IRType* rt;
                IRValue* res;
                IRValue* dst;
                IRValue* src;
                switch (le.kind != re.kind | le.width != re.width)
                {
                    case (true) {
                    this.unsup(n, g"array concatenation element types\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (op == Operator.ADD & le.kind == LK.INT & le.width == 8 & ll >= 1 & this.null_term)
                        {
                            case (true) { nt = 1; }
                            default {};
                        };
                        switch (nt == 1)
                        {
                            case (true) { rlen = (ll - 1) + rl; }
                            default {
                                switch (op == Operator.ADD)
                                {
                                    case (true) { rlen = ll + rl; }
                                    default {
                                        rlen = ll - rl;
