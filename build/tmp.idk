                    case (4)
                    {

                        switch (this.need(3))
                        {
                            case (true) {
                                this.pop_val();
                                ct = this.pt;
                                cd = this.pd;
                                mc = this.pm;
                                this.pop_val();
                                bt = this.pt;
                                bd = this.pd;
                                mb = this.pm;
                                this.pop_val();
                                at = this.pt;
                                ad = this.pd;
                                ma = this.pm;
                                this.push(bt, bd, mb);
                                this.push(ct, cd, mc);
                                this.push(at, ad, ma);
                            }
                            default {};
                        };
                    }
                    case (5)
                    {
                        switch (this.need(2))
                        {
                            case (true) { this.push(this.st_tag[this.sp - 2], this.st_data[this.sp - 2], this.st_meta[this.sp - 2]); }
                            default {};
                        };
                    }


                    case (6) { this.binop(op); }
                    case (7) { this.binop(op); }
                    case (8) { this.binop(op); }
                    case (9) { this.binop(op); }
                    case (10) { this.binop(op); }
                    case (12) { this.binop(op); }
                    case (14) { this.binop(op); }
                    case (15) { this.binop(op); }
                    case (17) { this.binop(op); }
                    case (18) { this.binop(op); }
                    case (19) { this.binop(op); }
                    case (21) { this.binop(op); }
                    case (22) { this.binop(op); }
                    case (35) { this.binop(op); }
                    case (36) { this.binop(op); }
                    case (11) { this.unop(op); }
                    case (13) { this.unop(op); }
                    case (20) { this.unop(op); }
                    case (37) { this.unop(op); }
                    case (26) { this.unop(op); }
                    case (16) { this.clamp(); }
                    case (23) { this.bitop(op, (int)oa); }
                    case (24) { this.bitop(op, (int)oa); }
                    case (25) { this.bitop(op, (int)oa); }
                    case (27) { this.bitop(op, (int)oa); }
                    case (28) { this.bitop(op, (int)oa); }


                    case (29) { this.cmp(op); }
                    case (30) { this.cmp(op); }
                    case (31) { this.cmp(op); }
                    case (32) { this.cmp(op); }
                    case (33) { this.cmp(op); }
                    case (34) { this.cmp(op); }


                    case (38) { this.fr_ip[fi] = (int)oa; }
                    case (39)
                    {
                        this.pop_val();
                        switch (this.truthy(this.pt, this.pd, this.pm))
                        {
                            case (true) { this.fr_ip[fi] = (int)oa; }
                            default {};
                        };
                    }
                    case (40)
                    {
                        this.pop_val();
                        switch (!this.truthy(this.pt, this.pd, this.pm))
                        {
                            case (true) { this.fr_ip[fi] = (int)oa; }
                            default {};
