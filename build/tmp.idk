            ov_resolve(byte* name) -> PtrVec*
            {
                PtrVec* r;
                byte* m;
                byte* walk;
                byte* p;
                bool more;
                int i;
                byte* cur = this.st.current_ns;

                switch (has_scope_sep(name))
                {
                    case (true) {
                    m = colons_to_underscores(name);
                    r = this.vis_overloads(st_overloads_of(this.st, m));
                    ffree(m);
                    switch (r != (PtrVec*)0)
                    {
                        case (true) { -> r; }
                        default {};
                    };
                }
                    default {};
                };

                r = this.vis_overloads(st_overloads_of(this.st, name));
                switch (r != (PtrVec*)0)
                {
                    case (true) { -> r; }
                    default
                    {
                        switch (cur[0] != 0)
                        {
                            case (true) {
                            m = mangle_namespace_name(cur, name);
                            r = this.vis_overloads(st_overloads_of(this.st, m));
                            ffree(m);
                            switch (r != (PtrVec*)0)
                            {
                                case (true) { -> r; }
                                default
                                {
                                    walk = ts_dup(cur);
                                    more = true;
                                    while (more)
                                    {
                                        more = has_scope_sep(walk);
                                        p = namespace_parent(walk);
                                        m = mangle_namespace_name(p, name);
                                        r = this.vis_overloads(st_overloads_of(this.st, m));
                                        ffree(m);
                                        ffree(walk);
                                        walk = p;
                                        switch (r != (PtrVec*)0)
                                        {
                                            case (true) {
                                            ffree(walk);
                                            -> r;
                                        }
                                            default {};
                                        };
                                    };
                                    ffree(walk);
                                };
                            };
                        }
                            default {};
                        };

                        while (i < this.st.using_ns.len)
                        {
                            m = mangle_namespace_name((byte*)this.st.using_ns.items[i], name);
                            r = this.vis_overloads(st_overloads_of(this.st, m));
                            ffree(m);
                            switch (r != (PtrVec*)0)
                            {
                                case (true) { -> r; }
                                default
                                {
                                    i++;
                                };
                            };
                        };

                        i = 0;
                        while (i < this.st.registered_ns.len)
                        {
                            m = mangle_namespace_name((byte*)this.st.registered_ns.items[i], name);
                            r = this.vis_overloads(st_overloads_of(this.st, m));
                            ffree(m);
                            switch (r != (PtrVec*)0)
                            {
                                case (true) { -> r; }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                        -> (PtrVec*)0;
                    };
                };
            };






