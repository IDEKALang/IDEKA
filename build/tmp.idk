            RIGHT_BRACKET,
            LEFT_BRACE,
            RIGHT_BRACE,
            SEMICOLON,
            COMMA,
            DOT,
            BACKSLASH,
            TAG,
            EOF,
            NEWLINE
        };

        enum LexError
        {
            NONE,
            FSTRING_UNTERMINATED,
            ALLOC_FAILED,
            EXPONENT_RANGE,
            NON_ASCII
        };






        struct Token
        {
            int type, line, column, voff, vlen, numeric_char;
        };



        is_digit(int c) -> bool
        {
            -> c >= '0' & c <= '9';
        };

        is_alpha(int c) -> bool
        {
            -> (c >= 'a' & c <= 'z') | (c >= 'A' & c <= 'Z');
        };

        is_ident_char(int c) -> bool
        {
            -> is_alpha(c) | is_digit(c) | c == '_';
        };

        is_hex_upper(int c) -> bool
        {
            -> is_digit(c) | (c >= 'A' & c <= 'F');
        };

        is_hex_any(int c) -> bool
        {
            -> is_digit(c) | (c >= 'A' & c <= 'F') | (c >= 'a' & c <= 'f');
        };

        hex_value(int c) -> int
        {
            switch (c >= '0' & c <= '9')
            {
                case (true) { -> c - 48; }
                default
                {
                    switch (c >= 'A' & c <= 'F')
                    {
                        case (true) { -> c - 55; }
                        default
                        {
                            -> c - 87;
                        };
                    };
                };
            };
        };

        is_base32_digit(int c) -> bool
        {
            -> is_digit(c) | (c >= 'A' & c <= 'V');
        };

        is_space(int c) -> bool
        {
            -> c == 32 | (c >= 9 & c <= 13) | (c >= 28 & c <= 31);
        };

        is_continuation(int c) -> bool
        {
            -> c >= 0x80 & c < 0xC0;
        };

        bytes_eq(byte* a, byte* b, int n) -> bool
        {
            int i;
            while (i < n)
            {
                switch (a[i] != b[i])
                {
                    case (true) { -> false; }
                    default
                    {
                        i++;
                    };
                };
            };
            -> true;
        };




        kw_is(byte* s, int n, byte* lit) -> bool
        {
            int len;
            while (lit[len] != 0) { len++; };
            switch (len == n)
            {
                case (true) { -> bytes_eq(s, lit, n); }
                default {};
            };
            -> false;
        };

        keyword_type(byte* s, int n) -> int
        {
            switch (kw_is(s, n, g"idkvm\0")) { case (true) { -> TokenType.IDEKAVM; } default {}; };
            switch (kw_is(s, n, g"emitideka\0")) { case (true) { -> TokenType.EMITIDEKA; } default {}; };
            switch (n == 2)
            {
                case (true) {
                switch (bytes_eq(s, g"as", 2))
                {
                    case (true) { -> TokenType.AS; }
                    default
                    {
                        switch (bytes_eq(s, g"do", 2))
                        {
                            case (true) { -> TokenType.DO; }
                            default
                            {
                                switch (bytes_eq(s, g"if", 2))
                                {
                                    case (true) { -> TokenType.IF; }
                                    default
                                    {
                                        switch (bytes_eq(s, g"in", 2))
                                        {
                                            case (true) { -> TokenType.IN; }
                                            default
                                            {
                                                switch (bytes_eq(s, g"is", 2))
                                                {
                                                    case (true) { -> TokenType.IS; }
                                                    default
                                                    {
                                                        switch (bytes_eq(s, g"or", 2))
                                                        {
                                                            case (true) { -> TokenType.OR; }
                                                            default {};
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            }
                default {};
