            execute_main() -> bool
            {
                bool ok;
                switch (this.main_unit < 0)
                {
                    case (true) {
                        this.fail(g"no main block loaded\0");
                        -> false;
                    }
                    default {};
                };
                ok = this.execute(this.main_unit, this.main_locals);

                switch (ok & this.host_kind != 0)
                {
                    case (true) {
                        this.fail(g"compiler.import: no codegen class registered on VM\0");
                        -> false;
                    }
                    default {};
                };
                -> ok;
            };


            top(int* tag, i64* d, i64* m) -> bool
            {
                switch (this.sp <= 0)
                {
                    case (true) { -> false; }
                    default
                    {
                        *tag = this.st_tag[this.sp - 1];
                        *d = this.st_data[this.sp - 1];
                        *m = this.st_meta[this.sp - 1];
                        -> true;
                    };
                };
            };





            run() -> bool
            {
                int fi, unit, ip, pc, op;
                this.wd.arm();
                while (this.nframes > 0 & !this.failed & this.host_kind == 0)
                {
                    fi = this.nframes - 1;
                    unit = this.fr_unit[fi];
                    ip = this.fr_ip[fi];
                    switch (ip >= this.code.ulen[unit])
                    {
                        case (true) { this.pop_frame(); }
                        default
                        {
                            pc = this.code.ustart[unit] + ip;
                            op = this.code.ops[pc];
                            this.fr_ip[fi] = ip + 1;
                            switch (this.code.line[pc] != 0)
                            {
                                case (true) { this.last_line = this.code.line[pc]; }
                                default {};
                            };
                            switch (this.trace_on & this.trace_left > 0)
                            {
                                case (true) {
                                    this.trace_line(fi, pc, op);
                                    this.trace_left--;
                                    switch (this.trace_left == 0)
                                    {
                                        case (true) {
                                            this.trace_on = false;
                                            standard::io::console::println(g"[VMTRACE] trace limit reached, auto-disabling\0");
                                        }
                                        default {};
                                    };
                                }
                                default {};
                            };
                            switch (this.wd.tick())
                            {
                                case (true) {
                                    this.fail(g"comptime execution exceeded \0");
                                    this.errb.put_i64(this.wd.limit_sec());
                                    this.errb.put_str(g"s (\0");
                                    this.errb.put_i64(this.wd.count);
                                    this.errb.put_str(g" instructions executed) in function '\0");
                                    this.errb.put_str(this.fr_name[fi]);
                                    this.errb.put_str(g"' at ip=\0");
                                    this.errb.put_int(ip + 1);
                                    this.errb.put_str(g" - likely an infinite loop.\0");
                                    ->  false;
                                }
                                default {};
                            };
                            this.dispatch(op, pc, fi);
                            switch (this.throwing & !this.failed)
                            {
                                case (true) { this.unwind(); }
                                default {};
                            };
                        };
                    };
                };

                switch (!this.failed & this.host_kind == 0 & this.nframes == 0 & this.cur_unit >= 0)
                {
                    case (true) {
                        this.log_block(this.cur_unit);
                        this.cur_unit = -1;
                    }
                    default {};
                };
                -> !this.failed;
            };


            unwind() -> void
            {
                int fi;
                while (this.nframes > 0)
                {
                    fi = this.nframes - 1;
                    switch (this.nh > 0 & this.h_frame[this.nh - 1] == fi)
                    {
                        case (true) {
                            this.nh--;
                            this.sp = this.h_depth[this.nh];
                            this.push(this.tv_tag, this.tv_data, this.tv_meta);
                            this.fr_ip[fi] = this.h_catch[this.nh];
                            this.throwing = false;
                            ->;
                        }
                        default {};
                    };
                    this.pop_frame();
                };
                this.throwing = false;
                this.fail(g"Unhandled comptime throw\0");
                ->;
            };




            binop(int op) -> void
            {
                int at, bt;
                i64 ad, bd, am, bm, r, e, base;
                bool uns;
                this.pop_val();
                bt = this.pt;
                bd = this.pd;
                bm = this.pm;
                this.pop_val();
                at = this.pt;
                ad = this.pd;
                am = this.pm;
                r = (i64)0;
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (fvm_isf(at, am) | fvm_isf(bt, bm))
                {
                    case (true) {
                        this.fbinop(op, at, am, ad, bt, bm, bd);
                        ->;
                    }
                    default {};
                };
                switch (at == 15 & (bt == 0 | bt == 1 | bt == 2 | bt == 3))
                {
                    case (true) {
                        r = this.pin_bytes(ad, am, bd);
                        switch (!this.failed) { case (true) { this.push(10, r, (i64)0); } default {}; };
                        ->;
                    }
                    default {};
                };
                switch (at == 15)
                {
                    case (true) {
                        this.stub(g"BYTES arithmetic with a non integer operand\0");
                        ->;
                    }
                    default {};
                };
                switch (!fvm_is_intlike(at) | !fvm_is_intlike(bt))
                {
                    case (true) {
                        this.stub(g"arithmetic on struct, array or handle values\0");
                        ->;
                    }
                    default {};
                };
                uns = fvm_is_unsigned(at);
                switch (op)
                {
                    case (6) { r = ad + bd; }
                    case (7) { r = ad - bd; }
                    case (8) { r = ad * bd; }
                    case (9)
                    {
                        switch (bd == (i64)0)
                        {
                            case (true) {
                                this.fail(g"Division by zero in comptime\0");
                                ->;
                            }
                            default {};
                        };
                        switch (uns)
                        {
                            case (true) { r = (i64)((u64)ad / (u64)bd); }
                            default { r = ad / bd; };
                        };
                    }
                    case (10)
                    {
                        switch (bd == (i64)0)
                        {
                            case (true) {
                                this.fail(g"Modulo by zero in comptime\0");
                                ->;
                            }
                            default {};
                        };
                        switch (uns)
                        {
                            case (true) { r = (i64)((u64)ad % (u64)bd); }
                            default
                            {

                                r = ad % bd;
                                switch (r != (i64)0 & ((r < (i64)0) != (bd < (i64)0)))
                                {
                                    case (true) { r = r + bd; }
                                    default {};
                                };
                            };
                        };
                    }
                    case (12)
                    {
                        switch (bd < (i64)0)
                        {
                            case (true) {
                                switch (ad == (i64)0)
                                {
                                    case (true) {
                                        this.fail(g"Division by zero in comptime\0");
                                        ->;
                                    }
                                    default {};
                                };
                                this.push_pow(at, fvm_dv(at, ad, (i64)0), (double)bd);
                                ->;
                            }
                            default {};
                        };
                        r = (i64)1;
                        base = ad;
                        e = bd;
                        while (e > (i64)0)
                        {
                            switch ((e `& (i64)1) != (i64)0)
                            {
                                case (true) { r = r * base; }
                                default {};
                            };
                            base = base * base;
                            e = e >> 1;
                        };
                    }
                    case (14)
                    {
                        switch (uns)
                        {
                            case (true) {
                                switch ((u64)ad < (u64)bd) { case (true) { r = ad; } default { r = bd; }; };
                            }
                            default
                            {
                                switch (ad < bd) { case (true) { r = ad; } default { r = bd; }; };
                            };
                        };
                    }
                    case (15)
                    {
                        switch (uns)
                        {
                            case (true) {
                                switch ((u64)ad > (u64)bd) { case (true) { r = ad; } default { r = bd; }; };
                            }
                            default
                            {
                                switch (ad > bd) { case (true) { r = ad; } default { r = bd; }; };
                            };
                        };
                    }
                    case (17) { r = ad `& bd; }
                    case (18) { r = ad `| bd; }
                    case (19) { r = ad `^| bd; }
                    case (21)
                    {
                        switch (bd < (i64)0 | bd > (i64)63)
                        {
                            case (true) { r = (i64)0; }
                            default { r = ad << (int)bd; };
                        };
                    }
                    case (22)
                    {
                        switch (bd < (i64)0 | bd > (i64)63)
                        {
                            case (true) { r = (i64)0; }
                            default
                            {
                                switch (uns)
                                {
                                    case (true) { r = fvm_lsr(ad, (int)bd); }
                                    default { r = ad >> (int)bd; };
                                };
                            };
                        };
                    }
                    case (35)
                    {
                        switch (ad != (i64)0 & bd != (i64)0) { case (true) { r = (i64)1; } default {}; };
                    }
                    case (36)
                    {
                        switch (ad != (i64)0 | bd != (i64)0) { case (true) { r = (i64)1; } default {}; };
                    }
                    default {};
                };
                this.push(at, fvm_wrap(at, r), (i64)0);
                ->;
            };


            push_f(int at, double r) -> void
            {
                switch (at == 4)
                {
                    case (true) { this.push(at, fvm_dbl_bits(fvm_f32_dbl(fvm_dbl_f32(r))), (i64)0); ->; }
                    default {};
                };
                switch (fvm_isflt_tag(at))
                {
                    case (true) { this.push(at, fvm_dbl_bits(r), (i64)0); }
                    default { this.push(at, fvm_dbl_bits(r), (i64)1718184564); };
                };
                ->;
            };


            push_pick(int at, int ct, i64 cd, i64 cm) -> void
            {
                switch (fvm_isf(ct, cm))
                {
                    case (true) { this.push_f(at, fvm_bits_dbl(cd)); ->; }
                    default {};
                };
                switch (fvm_isflt_tag(at))
                {
                    case (true) { this.push_f(at, fvm_dv(ct, cd, cm)); }
                    default { this.push(at, fvm_wrap(at, cd), (i64)0); };
                };
                ->;
            };

            push_pow(int at, double a, double b) -> void
            {
                bool ok;
                double r = fvm_pow(a, b, @ok);
                switch (ok)
                {
                    case (true) { this.push_f(at, r); }
                    default { this.fail(g"POW: the C math library cannot be loaded\0"); };
                };
                ->;
            };


            fbinop(int op, int at, i64 am, i64 ad, int bt, i64 bm, i64 bd) -> void
            {
                double a = fvm_dv(at, ad, am);
                double b = fvm_dv(bt, bd, bm);
                double r;


                int rt = at;
                switch (at == 5 | bt == 5) { case (true) { rt = 5; } default { switch (at == 4 | bt == 4) { case (true) { rt = 4; } default {}; }; }; };
                switch (op)
                {
                    case (6) { this.push_f(rt, a + b); }
                    case (7) { this.push_f(rt, a - b); }
                    case (8) { this.push_f(rt, a * b); }
                    case (9)
                    {
                        switch (b == (double)0.0)
                        {
                            case (true) {
                                this.fail(g"Division by zero in comptime\0");
                                ->;
                            }
                            default {};
                        };
                        switch (fvm_isflt_tag(rt))
                        {
                            case (true) { this.push_f(rt, a / b); }
                            default { this.push(at, fvm_wrap(at, fvm_trunc(a / b)), (i64)0); };
                        };
                    }
                    case (10)
                    {
                        switch (b == (double)0.0)
                        {
                            case (true) {
                                this.fail(g"Modulo by zero in comptime\0");
                                ->;
                            }
                            default {};
                        };
                        r = fvm_fmod(a, b);
                        switch (r != (double)0.0 & ((r < (double)0.0) != (b < (double)0.0)))
                        {
                            case (true) { r = r + b; }
                            default {};
                        };
                        this.push_f(rt, r);
                    }
                    case (12)
                    {
                        switch (a == (double)0.0 & b < (double)0.0)
                        {
                            case (true) {
                                this.fail(g"Division by zero in comptime\0");
                                ->;
                            }
                            default {};
                        };
                        this.push_pow(rt, a, b);
                    }
                    case (14)
                    {
                        switch (a < b)
                        {
                            case (true) { this.push_pick(rt, at, ad, am); }
                            default { this.push_pick(rt, bt, bd, bm); };
                        };
                    }
                    case (15)
                    {
                        switch (a > b)
                        {
                            case (true) { this.push_pick(rt, at, ad, am); }
                            default { this.push_pick(rt, bt, bd, bm); };
                        };
                    }
                    case (35)
                    {
                        switch (a != (double)0.0 & b != (double)0.0) { case (true) { this.push_f(at, (double)1.0); } default { this.push_f(at, (double)0.0); }; };
                    }
                    case (36)
                    {
                        switch (a != (double)0.0 | b != (double)0.0) { case (true) { this.push_f(at, (double)1.0); } default { this.push_f(at, (double)0.0); }; };
                    }
                    default { this.fail(g"unsupported operand type(s) for a bitwise operation on a float\0"); };
                };
                ->;
            };

            unop(int op) -> void
            {
                int at, k;
                i64 ad, am, r;
                double a;
                this.pop_val();
                at = this.pt;
                ad = this.pd;
                am = this.pm;
                r = (i64)0;
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (fvm_isf(at, am))
                {
                    case (true) {
                        a = fvm_dv(at, ad, am);
                        switch (op)
                        {
                            case (11) { this.push_f(at, (double)0.0 - a); }
                            case (13)
                            {
                                switch (a < (double)0.0) { case (true) { this.push_f(at, (double)0.0 - a); } default { this.push_f(at, a); }; };
                            }
                            case (37)
                            {
                                switch (a == (double)0.0) { case (true) { this.push_f(at, (double)1.0); } default { this.push_f(at, (double)0.0); }; };
                            }
                            default { this.fail(g"bad operand type for a bitwise unary operation on a float\0"); };
                        };
                        ->;
                    }
                    default {};
                };
                switch (!fvm_is_intlike(at))
                {
                    case (true) {
                        this.stub(g"arithmetic on struct, array, bytes or handle values\0");
                        ->;
                    }
                    default {};
                };
                switch (op)
                {
                    case (11) { r = (i64)0 - ad; }
                    case (13)
                    {
                        switch (ad < (i64)0 & !fvm_is_unsigned(at)) { case (true) { r = (i64)0 - ad; } default { r = ad; }; };
                    }
                    case (20) { r = `!ad; }
                    case (37)
                    {
                        switch (ad == (i64)0) { case (true) { r = (i64)1; } default {}; };
                    }
                    case (26)
                    {
                        k = 0;
                        while (k < 64)
                        {
                            r = r + (fvm_lsr(ad, k) `& (i64)1);
                            k++;
                        };
                    }
                    default {};
                };
                this.push(at, fvm_wrap(at, r), (i64)0);
                ->;
            };


            cmp(int op) -> void
            {
                int at, bt, c;
                i64 ad, bd, am, bm;
                double fa, fb;
                bool r = false;
                this.pop_val();
                bt = this.pt;
                bd = this.pd;
                bm = this.pm;
                this.pop_val();
                at = this.pt;
                ad = this.pd;
                am = this.pm;
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (fvm_isf(at, am) | fvm_isf(bt, bm))
                {
                    case (true) {
                        fa = fvm_dv(at, ad, am);
                        fb = fvm_dv(bt, bd, bm);
                        switch (op)
                        {
                            case (29) { r = fa == fb; }
                            case (30) { r = fa != fb; }
                            case (31) { r = fa < fb; }
                            case (32) { r = fa <= fb; }
                            case (33) { r = fa > fb; }
                            default { r = fa >= fb; };
                        };
                        switch (r)
                        {
                            case (true) { this.push(6, (i64)1, (i64)0); }
                            default { this.push(6, (i64)0, (i64)0); };
                        };
                        ->;
                    }
                    default {};
                };
                switch (at == 15 & bt == 15)
                {
                    case (true) {
                        c = fvm_strcmp(fvm_i2p(ad), fvm_i2p(bd));
                        switch (op)
                        {
                            case (29) { r = c == 0; }
                            case (30) { r = c != 0; }
                            case (31) { r = c < 0; }
                            case (32) { r = c <= 0; }
                            case (33) { r = c > 0; }
                            default { r = c >= 0; };
                        };
                    }
                    default
                    {
                        switch (fvm_is_unsigned(at))
                        {
                            case (true) {
                                switch (op)
                                {
                                    case (29) { r = ad == bd; }
                                    case (30) { r = ad != bd; }
                                    case (31) { r = (u64)ad < (u64)bd; }
                                    case (32) { r = (u64)ad <= (u64)bd; }
                                    case (33) { r = (u64)ad > (u64)bd; }
                                    default { r = (u64)ad >= (u64)bd; };
                                };
                            }
                            default
                            {
                                switch (op)
                                {
                                    case (29) { r = ad == bd; }
                                    case (30) { r = ad != bd; }
                                    case (31) { r = ad < bd; }
                                    case (32) { r = ad <= bd; }
                                    case (33) { r = ad > bd; }
                                    default { r = ad >= bd; };
                                };
                            };
                        };
                    };
                };
                switch (r)
                {
                    case (true) { this.push(6, (i64)1, (i64)0); }
                    default { this.push(6, (i64)0, (i64)0); };
                };
                ->;
            };


            clamp() -> void
            {
                int vt, ht, lt;
                i64 hi, lo, v, hm, lm, vm;
                double fv, fl, fh;
                this.pop_val();
                ht = this.pt;
                hi = this.pd;
                hm = this.pm;
                this.pop_val();
                lt = this.pt;
                lo = this.pd;
                lm = this.pm;
                this.pop_val();
                vt = this.pt;
                v = this.pd;
                vm = this.pm;
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (fvm_isf(vt, vm) | fvm_isf(lt, lm) | fvm_isf(ht, hm))
                {
                    case (true) {
                        fv = fvm_dv(vt, v, vm);
                        fl = fvm_dv(lt, lo, lm);
                        fh = fvm_dv(ht, hi, hm);
                        switch (fv < fl)
                        {
                            case (true) { this.push_pick(vt, lt, lo, lm); }
                            default {
                                switch (fv > fh)
                                {
                                    case (true) { this.push_pick(vt, ht, hi, hm); }
                                    default { this.push_pick(vt, vt, v, vm); };
                                };
                            };
                        };
                        ->;
                    }
                    default {};
                };
                switch (v < lo)
                {
                    case (true) { v = lo; }
                    default {
                        switch (v > hi) { case (true) { v = hi; } default {}; };
                    };
                };
                this.push(vt, v, (i64)0);
                ->;
            };


            bitop(int op, int width) -> void
            {
                int vt, k, sh, cnt;
                i64 vd, mask, n, r, sd;
                switch (width <= 0 | width > 64)
                {
                    case (true) {
                        this.fail(g"bit width out of range\0");
                        ->;
                    }
                    default {};
                };
                switch (op == 23 | op == 24)
                {
                    case (true) {
                        this.pop_val();
                        sd = this.pd;
                    }
                    default {};
                };
                this.pop_val();
                vt = this.pt;
                vd = this.pd;
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (width >= 64)
                {
                    case (true) { mask = `!((i64)0); }
                    default { mask = ((i64)1 << width) - (i64)1; };
                };
                n = vd `& mask;
                switch (op)
                {
                    case (23)
                    {
                        sh = (int)(sd % (i64)width);
                        switch (sh < 0) { case (true) { sh = sh + width; } default {}; };
                        switch (sh == 0)
                        {
                            case (true) { r = n; }
                            default { r = ((n << sh) `| fvm_lsr(n, width - sh)) `& mask; };
                        };
                        this.push(vt, r, (i64)0);
                    }
                    case (24)
                    {
                        sh = (int)(sd % (i64)width);
                        switch (sh < 0) { case (true) { sh = sh + width; } default {}; };
                        switch (sh == 0)
                        {
                            case (true) { r = n; }
                            default { r = (fvm_lsr(n, sh) `| (n << (width - sh))) `& mask; };
                        };
                        this.push(vt, r, (i64)0);
                    }
                    case (25)
                    {
                        r = (i64)0;
                        k = 0;
                        while (k < width)
                        {
                            r = (r << 1) `| (fvm_lsr(n, k) `& (i64)1);
                            k++;
                        };
                        this.push(vt, r, (i64)0);
                    }
                    case (27)
                    {
                        cnt = 0;
                        k = width - 1;
                        while (k >= 0 & (fvm_lsr(n, k) `& (i64)1) == (i64)0)
                        {
                            cnt++;
                            k--;
                        };
                        this.push(1, (i64)cnt, (i64)0);
                    }
                    default
                    {
                        cnt = 0;
                        k = 0;
                        while (k < width & (fvm_lsr(n, k) `& (i64)1) == (i64)0)
                        {
                            cnt++;
                            k++;
                        };
                        this.push(1, (i64)cnt, (i64)0);
                    };
                };
                ->;
            };




            take_args(int fi, int argc) -> void
            {
                int k = argc - 1;
                int slot;
                switch (!this.need(argc))
                {
                    case (true) { ->; }
                    default {};
                };
                while (k >= 0)
                {
                    this.pop_val();
                    slot = this.fr_base[fi] + k;
                    this.lc_tag[slot] = this.pt;
                    this.lc_set[slot] = 1;
                    this.lc_data[slot] = this.pd;
                    this.lc_meta[slot] = this.pm;
                    k--;
                };
                ->;
            };




            sig_score(byte* sig, int argc) -> int
            {
                int score;
                int a;
                int i;
                int ts;
                int te;
                int tag;
                bool arr;
                switch (sig[0] == 0 | this.sp < argc)
                {
                    case (true) { -> 0; }
                    default {};
                };
                while (a < argc)
                {
                    ts = i;
                    while (sig[i] != 0 & sig[i] != '_') { i++; };
                    te = i;
                    arr = te - ts >= 3 & ((sig[te - 3] == 'a' & sig[te - 2] == 'r' & sig[te - 1] == 'r') | (sig[te - 3] == 'p' & sig[te - 2] == 't' & sig[te - 1] == 'r'));
