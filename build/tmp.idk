            IDEKA_COMPILER_RELEASE_DATE = g"20261028"; 

    print_version() -> void
    {
        ->println(f"IDEKA Compiler {IDEKA_VERSION_NAME} v{IDEKA_COMPILER_VERSION}\nRelease date: {IDEKA_COMPILER_RELEASE_DATE} // YYYYMMDD\n");
