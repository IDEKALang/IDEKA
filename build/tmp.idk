                int t;
                i64 d, m;
                switch (bi >= 0)
                {
                    case (true) {
                        this.ef_get(v, bi, @t, @d, @m);
                        this.ef_put_val(o, t, d, m);
                    }
                    default { o.put_n(nm, nl); };
                };
                ->;
            };


            ef_expr(FvmBuf* o, FvmVars* v, byte* e, int n) -> void
            {
                int br = -1;
                int k = 0;
                int t, ai, ii, ds;
                i64 d, m, idx;
                i64* blk;
                bool ok2, digits, plain;
                while (k < n)
                {
                    switch (e[k] == '[' & br < 0) { case (true) { br = k; } default {}; };
                    k++;
                };
                switch (br >= 0 & e[n - 1] == ']')
                {
                    case (true) {
                        ds = br + 1;

                        k = ds;
                        while (k < n - 1 & e[k] == '-') { k++; };
                        digits = k < n - 1;
                        while (k < n - 1) { digits = digits & e[k] >= '0' & e[k] <= '9'; k++; };
                        idx = (i64)0;
                        switch (digits)
                        {
                            case (true) {
                                idx = fvm_parse_int(e + ds, n - 1 - ds, @ok2);
                                switch (!ok2) { case (true) { idx = (i64)-1; } default {}; };
                            }
                            default {
                                ii = this.ef_find(v, e + ds, n - 1 - ds);
                                switch (ii >= 0)
                                {
                                    case (true) {
                                        this.ef_get(v, ii, @t, @d, @m);
                                        switch (t == 4 | t == 5)
                                        {
                                            case (true) { idx = (i64)fvm_dv(t, d, m); }
                                            default { idx = d; };
                                        };
                                    }
                                    default {};
                                };
                            };
                        };
                        ai = this.ef_find(v, e, br);
                        this.ef_get(v, ai, @t, @d, @m);
                        switch (ai >= 0 & t == 14)
                        {
                            case (true) {
                                blk = (i64*)fvm_i2p(d);
                                switch (idx >= (i64)0 & idx < blk[0])
                                {
                                    case (true) {
                                        k = 2 + (int)idx * 3;
                                        this.ef_put_val(o, (int)blk[k], blk[k + 1], blk[k + 2]);
                                    }
                                    default { o.put(48); };
                                };
                            }
                            default { o.put(48); };
                        };
                        ->;
                    }
                    default {};
                };

                plain = n > 0;
                k = 0;
                while (k < n)
                {
                    plain = plain & ((e[k] >= 'a' & e[k] <= 'z') | (e[k] >= 'A' & e[k] <= 'Z') | (e[k] >= '0' & e[k] <= '9') | e[k] == '_');
                    k++;
                };
                switch (plain)
                {
                    case (true) { this.ef_subst(o, v, e, n); }
                    default { o.put_n(e, n); };
                };
                ->;
            };


            ef_nth(byte* es, int el, int slot, int* os, int* ol) -> bool
            {
                int k = 0;
                int st, en, cnt;
                while (k <= el)
                {
                    st = k;
                    while (k < el & es[k] != ';') { k++; };
                    en = k;
                    while (st < en & (es[st] == ' ' | es[st] == 9 | es[st] == 10 | es[st] == 13 | es[st] == 11 | es[st] == 12)) { st++; };
                    while (en > st & (es[en - 1] == ' ' | es[en - 1] == 9 | es[en - 1] == 10 | es[en - 1] == 13 | es[en - 1] == 11 | es[en - 1] == 12)) { en--; };
                    switch (en > st)
                    {
                        case (true) {
                            switch (cnt == slot)
                            {
                                case (true) { *os = st; *ol = en - st; -> true; }
                                default {};
                            };
                            cnt++;
                        }
                        default {};
                    };
                    k++;
                };
                -> false;
            };



            op_emitideka(byte* src, FvmVars* v) -> void
            {
                FvmBuf ob;
                FvmBuf* o = @ob;
                int n = fvm_strlen(src);
                int i = 0;
                int j, bs, be, k, ns, nb, es, ee, slot, ps, pl, kind;
                byte c;
                bool tok, id, quoted;
                byte* body;
                ob.__init();
                defer ob.__exit();
                switch (!o.ok) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                while (i < n)
                {
                    tok = false;
                    switch (src[i] == '~' & i + 1 < n & src[i + 1] == '$' & i + 2 < n)
                    {
                        case (true) {
                            kind = (int)src[i + 2];
                            quoted = (kind == 'f' | kind == 'i') & i + 3 < n & src[i + 3] == '"';
                            id = (kind >= 'a' & kind <= 'z') | (kind >= 'A' & kind <= 'Z') | kind == '_';
                            switch (quoted)
                            {
                                case (true) {
                                    j = i + 4;
                                    bs = j;
                                    be = -1;
                                    while (j < n & be < 0)
                                    {
                                        c = src[j];
                                        switch (c == 92) { case (true) { j = j + 2; } default {
                                            switch (c == '"') { case (true) { be = j; j++; } default { j++; }; };
                                        }; };
                                    };
                                    switch (be < 0) { case (true) { be = n; } default {}; };
                                    switch (j > n) { case (true) { j = n; } default {}; };
                                    nb = be - bs;
                                    body = src + bs;
                                    switch (kind == 'f')
                                    {
                                        case (true) {
                                            tok = true;
                                            k = 0;
                                            while (k < nb)
                                            {
                                                switch (body[k] == '{' & k + 1 < nb & body[k + 1] != '{')
                                                {
                                                    case (true) {
                                                        k++;
                                                        ns = k;
                                                        while (k < nb & body[k] != '}') { k++; };
                                                        this.ef_subst(o, v, body + ns, k - ns);
                                                        switch (k < nb) { case (true) { k++; } default {}; };
                                                    }
                                                    default {
                                                        switch (body[k] == '{' & k + 1 < nb & body[k + 1] == '{')
                                                        {
                                                            case (true) { o.put(123); k = k + 2; }
                                                            default { o.put((int)body[k]); k++; };
                                                        };
                                                    };
                                                };
                                            };
                                            i = j;
                                        }
                                        default {

                                            k = j;
                                            while (k < n & (src[k] == ' ' | src[k] == 9 | src[k] == 10 | src[k] == 13)) { k++; };
                                            switch (k < n & src[k] == ':')
                                            {
                                                case (true) {
                                                    k++;
                                                    while (k < n & (src[k] == ' ' | src[k] == 9 | src[k] == 10 | src[k] == 13)) { k++; };
                                                    switch (k < n & src[k] == '{')
                                                    {
                                                        case (true) {
                                                            tok = true;
                                                            k++;
                                                            es = k;
                                                            while (k < n & src[k] != '}') { k++; };
                                                            ee = k;
                                                            switch (k < n) { case (true) { k++; } default {}; };
                                                            slot = 0;
                                                            ns = 0;
                                                            while (ns < nb)
                                                            {
                                                                switch (body[ns] == '{' & ns + 1 < nb & body[ns + 1] == '}')
                                                                {
                                                                    case (true) {
                                                                        switch (this.ef_nth(src + es, ee - es, slot, @ps, @pl))
                                                                        {
                                                                            case (true) {
                                                                                this.ef_expr(o, v, src + es + ps, pl);
                                                                                slot++;
                                                                            }
                                                                            default {};
                                                                        };
                                                                        ns = ns + 2;
                                                                    }
                                                                    default { o.put((int)body[ns]); ns++; };
                                                                };
                                                            };
                                                            i = k;
                                                        }
                                                        default {};
                                                    };
                                                }
                                                default {};
                                            };
                                        };
                                    };
                                }
                                default {
                                    switch (id)
                                    {
                                        case (true) {
                                            tok = true;
                                            j = i + 2;
                                            while (j < n & ((src[j] >= 'a' & src[j] <= 'z') | (src[j] >= 'A' & src[j] <= 'Z') | (src[j] >= '0' & src[j] <= '9') | src[j] == '_')) { j++; };
                                            this.ef_subst(o, v, src + i + 2, j - i - 2);
                                            i = j;
                                        }
                                        default {};
                                    };
                                };
                            };
                        }
                        default {};
                    };
                    switch (tok)
                    {
                        case (false) { o.put((int)src[i]); i++; }
                        default {};
                    };
                };
                switch (!o.ok) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                this.emit_add(3, 15, (i64)o.len, (i64)0, fvm_dup(o.mem, o.len));
                ->;
            };


            cast_f(int target, int at, i64 ad, i64 am) -> bool
            {
                switch (target == 4 | target == 5)
                {
                    case (true) {
                        switch (target == 4)
                        {
                            case (true) { this.push(target, fvm_dbl_bits(fvm_f32_dbl(fvm_dbl_f32(fvm_dv(at, ad, am)))), (i64)0); }
                            default { this.push(target, fvm_dbl_bits(fvm_dv(at, ad, am)), (i64)0); };
                        };
                        -> true;
                    }
                    default {};
                };
                switch (!fvm_isf(at, am))
                {
                    case (true) { -> false; }
                    default {};
                };
                switch (target == 6)
                {
                    case (true) {
                        switch (fvm_bits_dbl(ad) != (double)0.0) { case (true) { this.push(6, (i64)1, (i64)0); } default { this.push(6, (i64)0, (i64)0); }; };
                        -> true;
                    }
                    default {};
                };
                switch (fvm_is_intlike(target))
                {
                    case (true) {
                        this.push(target, fvm_trunc(fvm_bits_dbl(ad)), (i64)0);
                        -> true;
                    }
                    default {};
                };
                -> false;
            };

            truthy(int tag, i64 d, i64 m) -> bool
            {
                switch (fvm_isf(tag, m))
                {
                    case (true) { -> fvm_bits_dbl(d) != (double)0.0; }
                    default {};
                };
                switch (tag == 15)
                {
                    case (true) { -> m > (i64)0; }
                    default { -> d != (i64)0; };
                };
            };

            grow_handlers() -> void
            {
                int nc = this.hcap * 2;
                int* n1 = (int*)fvm_grow((byte*)this.h_frame, nc * 4);
                int* n2 = (int*)fvm_grow((byte*)this.h_catch, nc * 4);
                int* n3 = (int*)fvm_grow((byte*)this.h_depth, nc * 4);
                switch (n1 == (int*)0 | n2 == (int*)0 | n3 == (int*)0)
                {
                    case (true) {
                        this.fail(g"handler stack allocation failed\0");
                        ->;
                    }
                    default {};
                };
                this.h_frame = n1;
                this.h_catch = n2;
                this.h_depth = n3;
                this.hcap = nc;
                ->;
            };




            parse_fail(int lineno, byte* msg, byte* extra) -> void
            {
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(g"line \0");
                        this.errb.put_int(lineno);
                        this.errb.put_str(g": \0");
                        this.errb.put_str(msg);
                        switch (extra != (byte*)0) { case (true) { this.errb.put_str(extra); } default {}; };
                        this.failed = true;
                        this.parse_line = lineno;
                    }
                    default {};
                };
                ->;
            };


            parse_fail_tok(int lineno, byte* msg, byte* ln, int k) -> void
            {
                byte* t = fvm_dup(ln + this.tk_s[k], this.tk_e[k] - this.tk_s[k]);
                switch (t == (byte*)0)
                {
                    case (true) { this.parse_fail(lineno, msg, (byte*)0); }
                    default
                    {
                        this.tmp.clear();
                        this.tmp.put(39);
                        this.tmp.put_str(t);
                        this.tmp.put(39);
                        this.parse_fail(lineno, msg, this.tmp.mem);
                        ffree(t);
                    };
                };
                ->;
            };

            tk_add(int s, int e) -> void
            {
                int nc;
                int* n1;
                int* n2;
                switch (this.tk_n >= this.tk_cap)
                {
                    case (true) {
                        nc = this.tk_cap * 2;
                        switch (nc < 16) { case (true) { nc = 16; } default {}; };
                        n1 = (int*)fvm_grow((byte*)this.tk_s, nc * 4);
                        n2 = (int*)fvm_grow((byte*)this.tk_e, nc * 4);
                        switch (n1 == (int*)0 | n2 == (int*)0)
                        {
                            case (true) {
                                this.fail(g"token buffer allocation failed\0");
                                ->;
                            }
                            default {};
                        };
                        this.tk_s = n1;
                        this.tk_e = n2;
                        this.tk_cap = nc;
                    }
                    default {};
                };
                this.tk_s[this.tk_n] = s;
                this.tk_e[this.tk_n] = e;
                this.tk_n++;
                ->;
            };


            tokenize(byte* ln, int n) -> void
            {
                int i = 0;
                int j;
                bool inq;
                this.tk_n = 0;
                while (i < n)
                {
                    switch (fvm_is_space((int)ln[i]))
                    {
                        case (true) { i++; }
                        default
                        {
                            j = i;
                            while (j < n & !fvm_is_space((int)ln[j]) & ln[j] != '"') { j++; };
                            switch (j < n & ln[j] == '"')
                            {
                                case (true) {
                                    j++;
                                    inq = true;
                                    while (j < n & inq)
                                    {
                                        switch (ln[j] == '\\')
                                        {
                                            case (true) { j = j + 2; }
                                            default
                                            {
                                                switch (ln[j] == '"')
                                                {
                                                    case (true) {
                                                        j++;
                                                        inq = false;
                                                    }
                                                    default { j++; };
                                                };
                                            };
                                        };
                                    };
                                    switch (j > n) { case (true) { j = n; } default {}; };
                                    this.tk_add(i, j);
                                }
                                default
                                {
                                    switch (j > i) { case (true) { this.tk_add(i, j); } default {}; };
                                };
                            };
                            i = j;
                        };
                    };
                };
                ->;
            };


            ttag_index(byte* s, int n) -> int
            {
                int t = 0;
                while (t < 19)
                {
                    switch (fvm_eq_ci(s, n, fvm_ttag_name(t))) { case (true) { -> t; } default {}; };
                    t++;
                };
                -> -1;
            };


            unescape(byte* s, int n, int* outlen) -> byte*
            {
                byte* r = fvm_alloc(n + 1);
                int i = 0;
                int o = 0;
                byte c;
                switch (r == (byte*)0)
                {
                    case (true) { -> r; }
                    default {};
                };
                while (i < n)
                {
                    c = s[i];
                    switch (c == '\\' & i + 1 < n)
                    {
                        case (true) {
                            switch (s[i + 1])
                            {
                                case (110) { r[o] = (byte)10; i = i + 2; }
                                case (114) { r[o] = (byte)13; i = i + 2; }
                                case (116) { r[o] = (byte)9; i = i + 2; }
                                case (48) { r[o] = (byte)0; i = i + 2; }
                                case (92) { r[o] = (byte)92; i = i + 2; }
                                case (34) { r[o] = (byte)34; i = i + 2; }
                                default { r[o] = c; i++; };
                            };
                        }
                        default
                        {
                            r[o] = c;
                            i++;
                        };
                    };
                    o++;
                };
                *outlen = o;
                -> r;
            };


            unescape_text(byte* s, int n) -> byte*
            {
                byte* r = fvm_alloc(n + 1);
                int i = 0;
                int o = 0;
                switch (r == (byte*)0)
                {
                    case (true) { -> r; }
                    default {};
                };
                while (i < n)
                {
                    switch (s[i] == '\\' & i + 1 < n)
                    {
                        case (true) {
                            switch (s[i + 1])
                            {
                                case (110) { r[o] = (byte)10; i = i + 2; }
                                case (114) { r[o] = (byte)13; i = i + 2; }
                                case (116) { r[o] = (byte)9; i = i + 2; }
                                case (48) { r[o] = (byte)0; i = i + 2; }
                                case (92) { r[o] = (byte)92; i = i + 2; }
                                case (34) { r[o] = (byte)34; i = i + 2; }
                                case (39) { r[o] = (byte)39; i = i + 2; }
                                default
                                {
                                    r[o] = s[i];
                                    i++;
                                };
                            };
                        }
                        default
                        {
                            r[o] = s[i];
                            i++;
                        };
                    };
                    o++;
                };
                -> r;
            };



            parse_val(byte* s, int n) -> byte*
            {
                int i, c, qpos, bpos, rawn, rn, ulen, tg, ms, me, is_, ie, k;
                byte* rest;
                byte* ub;
                bool ok2;
                bool quoted;
                i64 v;
                this.pt = 0;
                this.pd = (i64)0;
                this.pm = (i64)0;
                switch (n >= 2 & s[0] == '"' & s[n - 1] == '"')
                {
                    case (true) {
                        ub = this.unescape(s + 1, n - 2, @ulen);
                        switch (ub == (byte*)0) { case (true) { -> g"allocation failed\0"; } default {}; };
                        this.pt = 15;
                        this.pd = fvm_p2i(ub);
                        this.pm = (i64)ulen;
                        -> (byte*)0;
                    }
                    default {};
                };
                c = -1;
                i = 0;
                while (i < n & c < 0)
                {
                    switch (s[i] == ':') { case (true) { c = i; } default {}; };
                    i++;
                };
                switch (c < 0)
                {
                    case (true) { -> g"cannot parse value token (expected type:value)\0"; }
                    default {};
                };
                rest = s + c + 1;
                rn = c;
                rn = n - c - 1;
                qpos = -1;
                bpos = -1;
                i = 0;
                while (i < rn)
                {
                    switch (rest[i] == '"' & qpos < 0) { case (true) { qpos = i; } default {}; };
                    switch (rest[i] == '[' & bpos < 0) { case (true) { bpos = i; } default {}; };
                    i++;
                };
                rawn = rn;
                switch (bpos >= 0 & (qpos < 0 | bpos < qpos))
                {
                    case (true) {
                        rawn = bpos;

                        ms = bpos + 1;
                        me = rn;
                        while (me > ms & rest[me - 1] == ']') { me--; };
                        is_ = ms;
                        while (is_ <= me)
                        {
                            ie = is_;
                            while (ie < me & rest[ie] != ',') { ie++; };
                            k = ie - is_;
                            switch (k > 0)
                            {
                                case (true) {
                                    switch (fvm_eq_ci(rest + is_, k, g"stack_slot\0"))
                                    {
                                        case (true) { this.pm = (i64)1; }
                                        default { this.stub_note(g".ivm PTR meta (struct_type, field offsets, elements)\0"); };
                                    };
                                }
                                default {};
                            };
                            is_ = ie + 1;
                        };
                    }
                    default {};
                };
                quoted = rawn >= 2 & rest[0] == '"' & rest[rawn - 1] == '"';
                switch (fvm_eq_ci(s, c, g"bytes\0"))
                {
                    case (true) {
                        switch (quoted)
                        {
                            case (true) { ub = this.unescape(rest + 1, rawn - 2, @ulen); }
                            default
                            {
                                ub = fvm_dup(rest, rawn);
                                ulen = rawn;
                            };
                        };
                        switch (ub == (byte*)0) { case (true) { -> g"allocation failed\0"; } default {}; };
                        this.pt = 15;
                        this.pd = fvm_p2i(ub);
                        this.pm = (i64)ulen;
                        -> (byte*)0;
                    }
                    default {};
                };
                tg = this.ttag_index(s, c);
                switch (tg < 0 | tg == 9 | tg == 12 | tg == 13 | tg == 14 | tg == 16 | tg == 17 | tg == 18 | tg == 15)
                {
                    case (true) { -> g"unknown type tag\0"; }
                    default {};
                };
                this.pt = tg;
                switch (tg == 4 | tg == 5)
                {
                    case (true) {
                        this.pd = fvm_dbl_bits(fvm_parse_double(rest, rawn, @ok2));
                        switch (!ok2) { case (true) { -> g"invalid float value\0"; } default {}; };
                        -> (byte*)0;
                    }
                    default {};
                };
                switch (tg == 11)
                {
                    case (true) {
                        this.pd = (i64)0;
                        this.pm = (i64)0;
                        -> (byte*)0;
                    }
                    default {};
                };
                switch (tg == 6)
                {
                    case (true) {
                        switch (fvm_eq_ci(rest, rawn, g"true\0") | fvm_eq_ci(rest, rawn, g"1\0"))
                        {
                            case (true) { this.pd = (i64)1; -> (byte*)0; }
                            default {};
                        };
                        switch (fvm_eq_ci(rest, rawn, g"false\0") | fvm_eq_ci(rest, rawn, g"0\0"))
                        {
                            case (true) { this.pd = (i64)0; -> (byte*)0; }
                            default {};
                        };
                        -> g"invalid bool value\0";
                    }
                    default {};
                };
                v = fvm_parse_int(rest, rawn, @ok2);
                switch (!ok2) { case (true) { -> g"invalid integer value\0"; } default {}; };
                this.pd = v;
                -> (byte*)0;
            };


            is_zero_op(int op) -> bool
            {
                switch (op >= 1 & op <= 20) { case (true) { -> true; } default {}; };
                switch (op >= 21 & op <= 22) { case (true) { -> true; } default {}; };
                switch (op >= 29 & op <= 37) { case (true) { -> true; } default {}; };
                switch (op == 26 | op == 44 | op == 46 | op == 47 | op == 49) { case (true) { -> true; } default {}; };
                switch (op == 52 | op == 53 | op == 56 | op == 57 | op == 60) { case (true) { -> true; } default {}; };
                switch (op == 65 | op == 66 | op == 72 | op == 82) { case (true) { -> true; } default {}; };
                switch (op >= 68 & op <= 70) { case (true) { -> true; } default {}; };
                switch (op >= 75 & op <= 78) { case (true) { -> true; } default {}; };
                switch (op >= 83 & op <= 95) { case (true) { -> true; } default {}; };
                switch (op >= 102 & op <= 108) { case (true) { -> true; } default {}; };
                switch (op >= 111 & op <= 114) { case (true) { -> true; } default {}; };
                switch (op == 116 | op == 119) { case (true) { -> true; } default {}; };
                -> false;
            };


            tok_int(byte* ln, int k, int lineno, i64* out) -> bool
            {
                bool ok2;
                i64 v = fvm_parse_int(ln + this.tk_s[k], this.tk_e[k] - this.tk_s[k], @ok2);
                switch (!ok2)
                {
                    case (true) {
                        this.parse_fail_tok(lineno, g"invalid integer operand \0", ln, k);
                        -> false;
                    }
                    default {};
                };
                *out = v;
                -> true;
            };


            tok_ttag(byte* ln, int k, int lineno, int* out) -> bool
            {
                int t = this.ttag_index(ln + this.tk_s[k], this.tk_e[k] - this.tk_s[k]);
                switch (t < 0)
                {
                    case (true) {
                        this.parse_fail_tok(lineno, g"unknown TTag \0", ln, k);
                        -> false;
                    }
                    default {};
                };
                *out = t;
                -> true;
            };


            tok_str(byte* ln, int k) -> byte*
            {
                -> fvm_dup(ln + this.tk_s[k], this.tk_e[k] - this.tk_s[k]);
            };



            parse_operands(int op, byte* ln, int lineno) -> bool
            {
                int rc = this.tk_n - 1;
                int t, k, cnt;
                i64 a, b;
                byte* em;
                byte* s1;
                FvmVars* evars;
                bool ok3;
                int np, pt1;
                i64* ptg;
                byte* ub;
                i64* tbl;
                bool pf;
                switch (this.is_zero_op(op))
                {
                    case (true) {
                        this.code.add(op, (i64)0, (i64)0, (i64)0, (byte*)0, 0);
                        -> true;
                    }
                    default {};
                };
                switch (op)
                {
                    case (0)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"PUSH requires a value operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };

                        pf = fvm_eq_n(ln + this.tk_s[1], 4, g"ptr:\0") & rc > 1;
                        switch (pf)
                        {
                            case (true) {
                                pf = true;
                                k = this.tk_s[1];
                                while (k < this.tk_e[1])
                                {
                                    switch (ln[k] == '[') { case (true) { pf = false; } default {}; };
                                    k++;
                                };
                            }
                            default {};
                        };
                        switch (pf)
                        {
                            case (true) {
                                this.tmp.clear();
                                this.tmp.put_n(ln + this.tk_s[1], this.tk_e[1] - this.tk_s[1]);
                                this.tmp.put(91);
                                t = 2;
                                while (t < this.tk_n)
                                {
                                    switch (t > 2) { case (true) { this.tmp.put(44); } default {}; };
                                    this.tmp.put_n(ln + this.tk_s[t], this.tk_e[t] - this.tk_s[t]);
                                    t++;
                                };
                                switch (this.tmp.mem[this.tmp.len - 1] != ']') { case (true) { this.tmp.put(93); } default {}; };
                                em = this.parse_val(this.tmp.mem, this.tmp.len);
                            }
                            default { em = this.parse_val(ln + this.tk_s[1], this.tk_e[1] - this.tk_s[1]); };
                        };
                        switch (em != (byte*)0)
                        {
                            case (true) {
                                this.parse_fail(lineno, em, (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        this.code.add(op, (i64)this.pt, this.pd, this.pm, (byte*)0, 0);
                        -> true;
                    }
                    case (43)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"CALL_PTR requires an argc operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 1, lineno, @a)) { case (true) { -> false; } default {}; };
                        this.code.add(op, a, (i64)0, (i64)0, (byte*)0, 0);
                        -> true;
                    }
                    default {};
                };

                switch (op == 38 | op == 39 | op == 40 | op == 50 | op == 51 | op == 45 | op == 115 | op == 48 | op == 23 | op == 24 | op == 25 | op == 27 | op == 28)
                {
                    case (true) {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"missing integer operand for \0", fvm_op_name(op));
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 1, lineno, @a)) { case (true) { -> false; } default {}; };
                        this.code.add(op, a, (i64)0, (i64)0, (byte*)0, 0);
                        -> true;
                    }
                    default {};
                };

                switch (op == 71 | op == 73 | op == 74 | op == 61 | op == 62 | op == 63 | op == 64 | op == 54 | op == 55 | op == 80 | op == 97 | op == 100)
                {
                    case (true) {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"missing name operand for \0", fvm_op_name(op));
                                -> false;
                            }
                            default {};
                        };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        this.code.add(op, (i64)0, (i64)0, (i64)0, s1, 0);
                        -> true;
                    }
                    default {};
                };
                switch (op)
                {
                    case (101)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"EXTERN_DECL requires name and ret_tag\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        t = this.ttag_index(ln + this.tk_s[2], this.tk_e[2] - this.tk_s[2]);
                        switch (t < 0) { case (true) { t = 11; } default {}; };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        np = rc - 2;
                        switch (np < 0) { case (true) { np = 0; } default {}; };
                        ptg = (i64*)fvm_alloc((np + 1) * 8);
                        switch (ptg == (i64*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        k = 0;
                        while (k < np)
                        {
                            pt1 = this.ttag_index(ln + this.tk_s[3 + k], this.tk_e[3 + k] - this.tk_s[3 + k]);
                            switch (pt1 < 0) { case (true) { pt1 = 11; } default {}; };
                            ptg[k] = (i64)pt1;
                            k++;
                        };
                        this.code.add(op, (i64)t, (i64)np, fvm_p2i((byte*)ptg), s1, 0);
                        -> true;
                    }
                    case (67)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"ARRAY_NEW requires type_name and count\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 2, lineno, @a)) { case (true) { -> false; } default {}; };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        this.code.add(op, a, (i64)0, (i64)0, s1, 0);
                        -> true;
                    }
                    case (58)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"LOAD requires ttag and byte_size\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_ttag(ln, 1, lineno, @t)) { case (true) { -> false; } default {}; };
                        switch (!this.tok_int(ln, 2, lineno, @b)) { case (true) { -> false; } default {}; };
                        this.code.add(op, (i64)t, b, (i64)0, (byte*)0, 0);
                        -> true;
                    }
                    case (59)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"STORE requires ttag and byte_size\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_ttag(ln, 1, lineno, @t)) { case (true) { -> false; } default {}; };
                        switch (!this.tok_int(ln, 2, lineno, @b)) { case (true) { -> false; } default {}; };
                        this.code.add(op, (i64)t, b, (i64)0, (byte*)0, 0);
                        -> true;
                    }
                    case (109)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"CAST requires a type tag operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_ttag(ln, 1, lineno, @t)) { case (true) { -> false; } default {}; };
                        s1 = (byte*)0;
                        switch (rc > 1) { case (true) { s1 = this.tok_str(ln, 2); } default {}; };
                        this.code.add(op, (i64)t, (i64)0, (i64)0, s1, 0);
                        -> true;
                    }
                    case (110)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"BITCAST requires a type tag operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_ttag(ln, 1, lineno, @t)) { case (true) { -> false; } default {}; };
                        s1 = (byte*)0;
                        switch (rc > 1) { case (true) { s1 = this.tok_str(ln, 2); } default {}; };
                        this.code.add(op, (i64)t, (i64)0, (i64)0, s1, 0);
                        -> true;
                    }
                    case (42)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"CALL requires name and argc\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 2, lineno, @a)) { case (true) { -> false; } default {}; };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        this.code.add(op, a, (i64)0, (i64)0, s1, 0);
                        -> true;
                    }
                    case (79)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"FFI_LOAD requires a library path\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        this.code.add(op, (i64)0, (i64)0, (i64)0, s1, 0);
                        -> true;
                    }
                    case (81)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"FFI_CALL requires argc and ret_type_tag\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 1, lineno, @a)) { case (true) { -> false; } default {}; };
                        switch (!this.tok_ttag(ln, 2, lineno, @t)) { case (true) { -> false; } default {}; };
                        this.code.add(op, a, (i64)t, (i64)0, (byte*)0, 0);
                        -> true;
                    }
                    case (41)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"JTABLE requires at least a default address\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 1, lineno, @a)) { case (true) { -> false; } default {}; };
                        cnt = rc - 1;
                        tbl = (i64*)fvm_alloc((cnt + 1) * 8);
                        switch (tbl == (i64*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        k = 0;
                        while (k < cnt)
                        {
                            switch (!this.tok_int(ln, k + 2, lineno, @b)) { case (true) { -> false; } default {}; };
                            tbl[k] = b;
                            k++;
                        };
                        this.code.add(op, a, (i64)cnt, (i64)0, (byte*)tbl, 0);
                        -> true;
                    }
                    case (117)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"EMITIDEKA requires a source text operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };

                        a = (i64)this.tk_s[1];
                        b = (i64)this.tk_e[1];
                        while (a < b & ln[(int)a] == '"') { a = a + (i64)1; };
                        while (b > a & ln[(int)b - 1] == '"') { b = b - (i64)1; };
                        ub = this.unescape_text(ln + (int)a, (int)(b - a));
                        switch (ub == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };

                        cnt = 0;
                        k = 2;
                        while (k < this.tk_n)
                        {
                            a = (i64)this.tk_s[k];
                            while (a < (i64)this.tk_e[k] & ln[(int)a] != ':') { a = a + (i64)1; };
                            switch (a < (i64)this.tk_e[k]) { case (true) { cnt++; } default {}; };
                            k++;
                        };
                        evars = fvm_vars_new(cnt);
                        switch (evars == (FvmVars*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        cnt = 0;
                        k = 2;
                        while (k < this.tk_n)
                        {
                            a = (i64)this.tk_s[k];
                            while (a < (i64)this.tk_e[k] & ln[(int)a] != ':') { a = a + (i64)1; };
                            switch (a < (i64)this.tk_e[k])
                            {
                                case (true) {
                                    evars.names[cnt] = fvm_dup(ln + this.tk_s[k], (int)a - this.tk_s[k]);
                                    b = fvm_parse_int(ln + (int)a + 1, this.tk_e[k] - (int)a - 1, @ok3);
                                    switch (!ok3)
                                    {
                                        case (true) {
                                            this.parse_fail_tok(lineno, g"invalid integer operand \0", ln, k);
                                            -> false;
                                        }
                                        default {};
                                    };
                                    evars.slots[cnt] = (int)b;
                                    cnt++;
                                }
                                default {};
                            };
                            k++;
                        };
                        this.code.add(op, (i64)cnt, (i64)0, fvm_p2i((byte*)evars), ub, 0);
                        -> true;
                    }
                    case (118)
                    {
                        switch (rc < 4)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"INLINE_ASM requires body, constraints, n_inputs, n_outputs\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        this.code.add(op, (i64)0, (i64)0, (i64)0, (byte*)0, 0);
                        -> true;
                    }
                    default {};
                };
                this.parse_fail(lineno, g"unhandled operand encoding for \0", fvm_op_name(op));
                -> false;
            };




            parse_one(byte* ln, int lineno) -> void
            {
                int n0 = this.tk_e[0] - this.tk_s[0];
                byte* t0 = ln + this.tk_s[0];
                int op = -1;
                int i, tg, sz, bits;
                i64 a, b, c, d;
                byte* nm;
                byte* en;
                bool emit_here;
                switch (fvm_eq_ci(t0, n0, g"locals\0"))
                {
                    case (true) {
                        switch (this.tk_n != 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'locals' requires exactly one argument\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (!this.p_in_func & this.p_pass == 1)
                        {
                            case (true) {
                                switch (this.tok_int(ln, 1, lineno, @a)) { case (true) { this.main_locals = (int)a; } default {}; };
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (fvm_eq_ci(t0, n0, g"struct\0"))
                {
                    case (true) {
                        switch (this.p_in_struct)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"nested 'struct' is not allowed\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (this.tk_n < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'struct' requires a name\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        this.p_in_struct = true;
                        switch (this.p_pass == 0)
                        {
                            case (true) {
                                nm = this.tok_str(ln, 1);
                                en = g"little\0";
                                sz = 0;
                                bits = 0;
                                switch (this.tk_n > 2) { case (true) { en = this.tok_str(ln, 2); } default {}; };
                                switch (this.tk_n > 3)
                                {
                                    case (true) {
                                        switch (!this.tok_int(ln, 3, lineno, @a)) { case (true) { ->; } default {}; };
                                        sz = (int)a;
                                    }
                                    default {};
                                };
                                switch (this.tk_n > 4)
                                {
                                    case (true) {
                                        switch (!this.tok_int(ln, 4, lineno, @b)) { case (true) { ->; } default {}; };
                                        bits = (int)b;
                                    }
                                    default {};
                                };
                                switch (nm == (byte*)0 | en == (byte*)0 | !this.layouts.add_struct(nm, en, sz, bits))
                                {
                                    case (true) { this.fail(g"struct layout allocation failed\0"); }
                                    default {};
                                };
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (fvm_eq_ci(t0, n0, g"field\0"))
                {
                    case (true) {
                        switch (!this.p_in_struct)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'field' outside 'struct' block\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (this.tk_n < 5)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'field' requires fname ttag byte_offset byte_size\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (this.p_pass == 0)
                        {
                            case (true) {
                                switch (!this.tok_ttag(ln, 2, lineno, @tg)) { case (true) { ->; } default {}; };
                                switch (!this.tok_int(ln, 3, lineno, @c)) { case (true) { ->; } default {}; };
                                switch (!this.tok_int(ln, 4, lineno, @d)) { case (true) { ->; } default {}; };
                                nm = this.tok_str(ln, 1);
                                switch (nm == (byte*)0 | !this.layouts.add_field(nm, tg, (int)c, (int)d))
                                {
                                    case (true) { this.fail(g"struct layout allocation failed\0"); }
                                    default {};
                                };
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (fvm_eq_ci(t0, n0, g"endstruct\0"))
                {
                    case (true) {
                        switch (!this.p_in_struct)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'endstruct' without matching 'struct'\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        this.p_in_struct = false;
                        ->;
                    }
                    default {};
                };
                switch (fvm_eq_ci(t0, n0, g"func\0"))
                {
                    case (true) {
                        switch (this.p_in_func)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"nested 'func' is not allowed\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (this.tk_n < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'func' requires a name\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        this.p_in_func = true;
                        switch (this.p_pass == 0)
                        {
                            case (true) {
                                this.p_fname = this.tok_str(ln, 1);
                                this.p_unit = this.code.unit_begin();
                                switch (this.p_fname == (byte*)0 | this.p_unit < 0) { case (true) { this.fail(g"code pool allocation failed\0"); } default {}; };
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (fvm_eq_ci(t0, n0, g"endfunc\0"))
                {
                    case (true) {
                        switch (!this.p_in_func)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'endfunc' without matching 'func'\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        this.p_in_func = false;
                        switch (this.p_pass == 0)
                        {
                            case (true) {
                                this.code.unit_end(this.p_unit);
                                this.register_function(this.p_fname, this.p_unit);
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };


                i = 0;
                while (i < 120 & op < 0)
                {
                    switch (fvm_eq_ci(t0, n0, fvm_op_name(i))) { case (true) { op = i; } default {}; };
                    i++;
                };
                emit_here = (this.p_pass == 0 & this.p_in_func) | (this.p_pass == 1 & !this.p_in_func);
                switch (!emit_here)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (op < 0)
                {
                    case (true) {
                        this.parse_fail_tok(lineno, g"unknown opcode \0", ln, 0);
                        ->;
                    }
                    default {};
                };
                this.parse_operands(op, ln, lineno);
                ->;
            };



            load_fvm(byte* text, int len) -> bool
            {
                int pass = 0;
                int pos, ls, le, cut, a, b, lineno;
                byte* ln;
                while (pass < 2 & !this.failed)
                {
                    this.p_pass = pass;
                    this.p_in_func = false;
                    this.p_in_struct = false;
                    pos = 0;
                    lineno = 0;
                    switch (pass == 1)
                    {
                        case (true) { this.p_main = this.code.unit_begin(); }
                        default {};
                    };
                    while (pos < len & !this.failed)
                    {
                        ls = pos;
                        le = pos;
                        while (le < len & text[le] != '\n') { le++; };
                        pos = le + 1;
                        lineno++;
                        cut = ls;
                        while (cut < le & text[cut] != '#') { cut++; };
                        a = ls;
                        b = cut;
                        while (a < b & fvm_is_space((int)text[a])) { a++; };
                        while (b > a & fvm_is_space((int)text[b - 1])) { b--; };
                        switch (b > a)
                        {
                            case (true) {
                                ln = fvm_dup(text + a, b - a);
                                switch (ln == (byte*)0)
                                {
                                    case (true) { this.fail(g"line buffer allocation failed\0"); }
                                    default
                                    {
                                        this.tokenize(ln, b - a);
                                        switch (this.tk_n > 0 & !this.failed) { case (true) { this.parse_one(ln, lineno); } default {}; };
                                        ffree(ln);
                                    };
                                };
                            }
                            default {};
                        };
                    };
                    switch (!this.failed & pass == 0 & this.p_in_func)
                    {
                        case (true) {
                            this.parse_fail(lineno, g"unterminated 'func' at end of file\0", (byte*)0);
                        }
                        default {};
                    };
                    switch (!this.failed & pass == 0 & this.p_in_struct)
                    {
                        case (true) {
                            this.parse_fail(lineno, g"unterminated 'struct' at end of file\0", (byte*)0);
                        }
                        default {};
                    };
                    switch (pass == 1)
                    {
                        case (true) {
                            this.code.unit_end(this.p_main);
                            this.main_unit = this.p_main;
                        }
                        default {};
                    };
                    pass++;
                };
                -> !this.failed;
            };
        };
    };
};



using IDEKA::ast;
using IDEKA::types;
using IDEKA::lexer;
using IDEKA::fvm;





namespace IDEKA
{
    namespace fvmcodegen
    {

        fvmcg_datatype_ttag(int dt) -> int
        {
            switch (dt)
            {
                case (DataType.SINT) { -> 0; }
                case (DataType.UINT) { -> 1; }
                case (DataType.SLONG) { -> 2; }
                case (DataType.ULONG) { -> 3; }
                case (DataType.FLOAT) { -> 4; }
                case (DataType.DOUBLE) { -> 5; }
                case (DataType.BOOL) { -> 6; }
                case (DataType.BYTE) { -> 7; }
                case (DataType.CHAR) { -> 8; }
                default { -> 0; };
            };
            -> 0;
        };


        fvmcg_target_prop(byte* dotted) -> byte*
        {
            byte* pre = g"compiler.target.\0";
            int i;
            while (pre[i] != 0)
            {
                switch (dotted[i] != pre[i]) { case (true) { -> (byte*)0; } default {}; };
                i++;
            };
            byte* p = dotted + i;
            switch (fvm_streq(p, g"arch\0") | fvm_streq(p, g"os\0") | fvm_streq(p, g"abi\0") | fvm_streq(p, g"ptr_width\0") | fvm_streq(p, g"endian\0") | fvm_streq(p, g"cache_line\0") | fvm_streq(p, g"page_size\0"))
            {
                case (true) { -> p; }
                default {};
            };
            switch (fvm_streq(p, g"has_sse\0") | fvm_streq(p, g"has_sse2\0") | fvm_streq(p, g"has_sse4\0") | fvm_streq(p, g"has_avx\0") | fvm_streq(p, g"has_avx2\0") | fvm_streq(p, g"has_avx512\0") | fvm_streq(p, g"has_aes\0") | fvm_streq(p, g"has_popcnt\0") | fvm_streq(p, g"has_bmi2\0"))
            {
                case (true) { -> p; }
                default {};
            };
            -> (byte*)0;
        };


        fvmcg_symtab_filter(byte* dotted) -> byte*
        {
            byte* pre = g"compiler.symbol_table.\0";
            int i;
            while (pre[i] != 0)
            {
                switch (dotted[i] != pre[i]) { case (true) { -> (byte*)0; } default {}; };
                i++;
            };
            byte* p = dotted + i;
            switch (fvm_streq(p, g"functions\0") | fvm_streq(p, g"structs\0") | fvm_streq(p, g"objects\0") | fvm_streq(p, g"traits\0") | fvm_streq(p, g"interfaces\0") | fvm_streq(p, g"namespaces\0"))
            {
                case (true) { -> p; }
                default {};
            };
            switch (fvm_streq(p, g"variables\0") | fvm_streq(p, g"enums\0") | fvm_streq(p, g"unions\0") | fvm_streq(p, g"effects\0") | fvm_streq(p, g"constraints\0") | fvm_streq(p, g"contracts\0"))
            {
                case (true) { -> p; }
                default {};
            };
            -> (byte*)0;
        };


        fvmcg_type_bits(int dt, int dflt) -> int
        {
            switch (dt)
            {
                case (DataType.SINT) { -> 32; }
                case (DataType.UINT) { -> 32; }
                case (DataType.SLONG) { -> 64; }
                case (DataType.ULONG) { -> 64; }
                case (DataType.BYTE) { -> 8; }
                case (DataType.CHAR) { -> 8; }
                case (DataType.BOOL) { -> 1; }
                default { -> dflt; };
            };
            -> dflt;
        };


        fvmcg_unpack_type(int dt) -> bool
        {
            -> dt == DataType.SINT | dt == DataType.UINT | dt == DataType.SLONG | dt == DataType.ULONG | dt == DataType.BYTE | dt == DataType.CHAR;
        };


        fvmcg_compound_op(int tok) -> int
        {
            switch (tok)
            {
                case (TokenType.PLUS_ASSIGN) { -> 6; }
                case (TokenType.MINUS_ASSIGN) { -> 7; }
                case (TokenType.MULTIPLY_ASSIGN) { -> 8; }
                case (TokenType.DIVIDE_ASSIGN) { -> 9; }
                case (TokenType.MODULO_ASSIGN) { -> 10; }
                case (TokenType.EXPONENT_ASSIGN) { -> 12; }
                case (TokenType.AND_ASSIGN) { -> 17; }
                case (TokenType.OR_ASSIGN) { -> 18; }
                case (TokenType.XOR_ASSIGN) { -> 19; }
                case (TokenType.BITAND_ASSIGN) { -> 17; }
                case (TokenType.BITOR_ASSIGN) { -> 18; }
                case (TokenType.BITXOR_ASSIGN) { -> 19; }
                case (TokenType.BITSHIFT_LEFT_ASSIGN) { -> 21; }
                case (TokenType.BITSHIFT_RIGHT_ASSIGN) { -> 22; }
                default { -> -1; };
            };
            -> -1;
        };


        fvmcg_binop_single(int op) -> int
        {
            switch (op)
            {
                case (Operator.ADD) { -> 6; }
                case (Operator.SUB) { -> 7; }
                case (Operator.MUL) { -> 8; }
                case (Operator.DIV) { -> 9; }
                case (Operator.MOD) { -> 10; }
                case (Operator.POWER) { -> 12; }
                case (Operator.XOR) { -> 19; }
                case (Operator.BITAND) { -> 17; }
                case (Operator.BITOR) { -> 18; }
                case (Operator.BITXOR) { -> 19; }
                case (Operator.BITSHIFT_LEFT) { -> 21; }
                case (Operator.BITSHIFT_RIGHT) { -> 22; }
                case (Operator.EQUAL) { -> 29; }
                case (Operator.NOT_EQUAL) { -> 30; }
                case (Operator.LESS_THAN) { -> 31; }
                case (Operator.LESS_EQUAL) { -> 32; }
                case (Operator.GREATER_THAN) { -> 33; }
                case (Operator.GREATER_EQUAL) { -> 34; }
                default {};
            };
            -> -1;
        };


        fvmcg_binop_composite(int op) -> int
        {
            switch (op)
            {
                case (Operator.NAND) { -> 17; }
                case (Operator.NOR) { -> 18; }
                case (Operator.BITNAND) { -> 17; }
                case (Operator.BITNOR) { -> 18; }
                case (Operator.BITXNOT) { -> 19; }
                case (Operator.BITXNAND) { -> 17; }
                case (Operator.BITXNOR) { -> 18; }
                default {};
            };
            -> -1;
        };


        fvmcg_compiler_io(byte* name) -> int
        {
            switch (fvm_streq(name, g"compiler__io__console__print\0") | fvm_streq(name, g"compiler.io.console.print\0")) { case (true) { -> 83; } default {}; };
            switch (fvm_streq(name, g"compiler__io__console__println\0") | fvm_streq(name, g"compiler.io.console.println\0")) { case (true) { -> 84; } default {}; };
            switch (fvm_streq(name, g"compiler__io__console__input\0") | fvm_streq(name, g"compiler.io.console.input\0")) { case (true) { -> 85; } default {}; };
            switch (fvm_streq(name, g"compiler__io__readfile\0") | fvm_streq(name, g"compiler.io.readfile\0")) { case (true) { -> 86; } default {}; };
            switch (fvm_streq(name, g"compiler__io__writefile\0") | fvm_streq(name, g"compiler.io.writefile\0")) { case (true) { -> 87; } default {}; };
            switch (fvm_streq(name, g"compiler.idkvm.dump\0") | fvm_streq(name, g"compiler__idkvm__dump\0")) { case (true) { -> 88; } default {}; };
            switch (fvm_streq(name, g"compiler.idkvm.bindump\0") | fvm_streq(name, g"compiler__idkvm__bindump\0")) { case (true) { -> 119; } default {}; };
            switch (fvm_streq(name, g"compiler.idkvm.loadlib\0") | fvm_streq(name, g"compiler__idkvm__loadlib\0")) { case (true) { -> 93; } default {}; };
            switch (fvm_streq(name, g"compiler.idkvm.trace.begin\0") | fvm_streq(name, g"compiler__idkvm__trace__begin\0")) { case (true) { -> 89; } default {}; };
            switch (fvm_streq(name, g"compiler.idkvm.trace.end\0") | fvm_streq(name, g"compiler__idkvm__trace__end\0")) { case (true) { -> 90; } default {}; };
            switch (fvm_streq(name, g"compiler.idkvm.setbp\0") | fvm_streq(name, g"compiler__idkvm__setbp\0")) { case (true) { -> 91; } default {}; };
            switch (fvm_streq(name, g"compiler.import.stdlib\0") | fvm_streq(name, g"compiler__import__stdlib\0")) { case (true) { -> 92; } default {}; };
            switch (fvm_streq(name, g"compiler.import.local\0") | fvm_streq(name, g"compiler__import__local\0")) { case (true) { -> 94; } default {}; };
            switch (fvm_streq(name, g"compiler.fpm.package\0") | fvm_streq(name, g"compiler__fpm__package\0")) { case (true) { -> 95; } default {}; };
            -> -1;
        };


        fvmcg_ends_with(byte* s, byte* suffix) -> bool
        {
            int ls = fvm_strlen(s);
            int lx = fvm_strlen(suffix);
            int i;
            switch (lx > ls)
            {
                case (true) { -> false; }
                default {};
            };
            while (i < lx)
            {
                switch (s[ls - lx + i] != suffix[i]) { case (true) { -> false; } default {}; };
                i++;
            };
            -> true;
        };


        fvmcg_ttag_type_name(int tag) -> byte*
        {
            switch (tag)
            {
                case (0) { -> g"int\0"; }
                case (1) { -> g"uint\0"; }
                case (2) { -> g"long\0"; }
                case (3) { -> g"ulong\0"; }
                case (4) { -> g"float\0"; }
                case (5) { -> g"double\0"; }
                case (6) { -> g"bool\0"; }
                case (7) { -> g"byte\0"; }
                case (8) { -> g"char\0"; }
                default { -> g"int\0"; };
            };
        };


        struct FvmHeapVar
        {
            int ttag, bytes, count;
        };


        struct FvmCap
        {
            byte* name;
            int tag;
            i64 d;
            i64 m;
        };



        fvmcg_parse_pyint(byte* s, i64* out) -> bool
        {
            int i;
            int n = fvm_strlen(s);
            int base = 10;
            int dv;
            int c;
            int ndig;
            bool neg;
            bool prev_us;
            bool lead_zero;
            i64 v;
            while (i < n & (s[i] == ' ' | s[i] == '\t' | s[i] == '\n' | s[i] == '\r')) { i++; };
            while (n > i & (s[n - 1] == ' ' | s[n - 1] == '\t' | s[n - 1] == '\n' | s[n - 1] == '\r')) { n--; };
            switch (i < n & (s[i] == '+' | s[i] == '-'))
            {
                case (true) { neg = s[i] == '-'; i++; }
                default {};
            };
            switch (i + 1 < n & s[i] == '0')
            {
                case (true)
                {
                    switch (s[i + 1] == 'x' | s[i + 1] == 'X') { case (true) { base = 16; i = i + 2; } default {}; };
                    switch (s[i + 1] == 'o' | s[i + 1] == 'O') { case (true) { base = 8; i = i + 2; } default {}; };
                    switch (s[i + 1] == 'b' | s[i + 1] == 'B') { case (true) { base = 2; i = i + 2; } default {}; };
                }
                default {};
            };
            switch (i >= n) { case (true) { -> false; } default {}; };

            lead_zero = base == 10 & s[i] == '0';
            prev_us = base == 10;
            while (i < n)
            {
                c = (int)s[i];
                switch (c == '_')
                {
                    case (true)
                    {
                        switch (prev_us) { case (true) { -> false; } default {}; };
                        prev_us = true;
                    }
                    default
                    {
                        dv = 99;
                        switch (c >= '0' & c <= '9') { case (true) { dv = c - '0'; } default {}; };
                        switch (c >= 'a' & c <= 'f') { case (true) { dv = c - 'a' + 10; } default {}; };
                        switch (c >= 'A' & c <= 'F') { case (true) { dv = c - 'A' + 10; } default {}; };
                        switch (dv >= base) { case (true) { -> false; } default {}; };
                        switch (lead_zero & ndig > 0 & dv != 0) { case (true) { -> false; } default {}; };
                        v = v * (i64)base + (i64)dv;
                        ndig++;
                        prev_us = false;
                    };
                };
                i++;
            };
            switch (prev_us & n > 0 & s[n - 1] == '_') { case (true) { -> false; } default {}; };
            switch (neg) { case (true) { v = (i64)0 - v; } default {}; };
            *out = v;
            -> ndig > 0;
        };

        object FVMCodegen
        {
            NameMap* ucounts;   
            PtrVec* owned;      
            int nstubs;         
            int cur_line;       
            FvmCode code;       
            int unit;           
            int ubase;          
            NameMap* locals;    
            PtrVec* lnames;     
            int nlocals;        
            NameMap* bglobals;  
            NameMap* oglobals;  
            NameMap* lvars;     
            NameMap* ltypes;    
            PtrVec* brks;       
            PtrVec* conts;      
            byte* tail_self;    
            int tail_argc;
            bool in_func;       
            bool failed;        
            int errline;
            FvmBuf errb;        
            PtrVec* caps;       
            NameMap* capidx;    
            FVMCodegen* par;    
            PtrVec* kids;       
            PtrVec* fnames;     
            PtrVec* fcgs;       
            NameMap* fidx;      
            NameMap* known;     
            PtrVec* defers;     
            PtrVec* usings;     
            NameMap* ltn;       
            NameMap* enums;     
            NameMap* alspec;    
            NameMap* hvars;     
            NameMap* labels;    
            PtrVec* gp_idx;     
            PtrVec* gp_name;    
            NameMap* excluded;  
            NodeVec* pstmts;    
            FvmLayouts lay;     
            NameMap* ldirty;    
            int lay_seed;       
            NameMap* macros;    
            NameMap* mcomp;     
            NameMap* trreg;     
            NameMap* ifreg;     
            NameMap* iwl;       
            NameMap* pwl;       
            NameMap* rwl;       
            NameMap* otr;       
            PtrVec* wsets;      
            PtrVec* tlists;     
            byte* cur_obj;      
            NodeVec* cbody;     
            bool shared_ifc;    
            bool in_method;     

            __init() -> this
            {
                this.ucounts = nm_new();
                this.owned = pv_new();
                this.nstubs = 0;
                this.cur_line = 0;
                this.code.__init();
                this.errb.__init();
                this.unit = this.code.unit_begin();
                this.ubase = this.code.len;
                this.locals = nm_new();
                this.lnames = pv_new();
                this.nlocals = 0;
                this.bglobals = nm_new();
                this.oglobals = nm_new();
                this.lvars = nm_new();
                this.ltypes = nm_new();
                this.brks = pv_new();
                this.conts = pv_new();
                this.tail_self = (byte*)0;
                this.tail_argc = 0;
                this.in_func = false;
                this.failed = false;
                this.errline = 0;
                this.caps = pv_new();
                this.capidx = nm_new();
                this.par = (FVMCodegen*)0;
                this.kids = pv_new();
                this.fnames = pv_new();
                this.fcgs = pv_new();
                this.fidx = nm_new();
                this.known = nm_new();
                this.defers = pv_new();
                this.usings = pv_new();
                this.ltn = nm_new();
                this.enums = nm_new();
                this.alspec = nm_new();
                this.hvars = nm_new();
                this.macros = nm_new();
                this.mcomp = nm_new();
                this.trreg = nm_new();
                this.ifreg = nm_new();
                this.iwl = nm_new();
                this.pwl = nm_new();
                this.rwl = nm_new();
                this.otr = nm_new();
                this.wsets = pv_new();
                this.tlists = pv_new();
                this.cur_obj = (byte*)0;
                this.cbody = (NodeVec*)0;
                this.shared_ifc = false;
                this.in_method = false;
                this.labels = nm_new();
                this.ldirty = nm_new();
                this.lay_seed = 0;
                this.gp_idx = pv_new();
                this.gp_name = pv_new();
                this.excluded = nm_new();
                this.pstmts = (NodeVec*)0;
                this.lay.__init();
                -> this;
            };

            __expr() -> FVMCodegen* -> this;

            __exit() -> void
            {
                int i;
                while (i < this.owned.len)
                {
                    ffree((byte*)this.owned.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.brks.len)
                {
                    pv_free((PtrVec*)this.brks.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.conts.len)
                {
                    pv_free((PtrVec*)this.conts.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.kids.len)
                {
                    ((FVMCodegen*)this.kids.items[i]).__exit();
                    ffree((byte*)this.kids.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.defers.len)
                {
                    pv_free((PtrVec*)this.defers.items[i]);
                    i++;
                };
                pv_free(this.kids);
                pv_free(this.fnames);
                pv_free(this.fcgs);
                nm_free(this.fidx);
                nm_free(this.known);
                pv_free(this.defers);
                pv_free(this.usings);
                nm_free(this.ltn);
                nm_free(this.enums);
                nm_free(this.alspec);
                nm_free(this.hvars);
                nm_free(this.macros);
                nm_free(this.mcomp);
                switch (!this.shared_ifc)
                {
                    case (true)
                    {
                        nm_free(this.trreg);
                        nm_free(this.ifreg);
                        nm_free(this.iwl);
                        nm_free(this.pwl);
                        nm_free(this.rwl);
                    }
                    default {};
                };
                nm_free(this.otr);
                i = 0;
                while (i < this.wsets.len)
                {
                    nm_free((NameMap*)this.wsets.items[i]);
                    i++;
                };
                pv_free(this.wsets);
                i = 0;
                while (i < this.tlists.len)
                {
                    pv_free((PtrVec*)this.tlists.items[i]);
                    i++;
                };
                pv_free(this.tlists);
                nm_free(this.labels);
                nm_free(this.ldirty);
                pv_free(this.gp_idx);
                pv_free(this.gp_name);
                nm_free(this.excluded);
                this.lay.__exit();
                pv_free(this.brks);
                pv_free(this.conts);
                pv_free(this.caps);
                pv_free(this.lnames);
                nm_free(this.capidx);
                pv_free(this.owned);
                nm_free(this.ucounts);
                nm_free(this.locals);
                nm_free(this.bglobals);
                nm_free(this.oglobals);
                nm_free(this.lvars);
                nm_free(this.ltypes);
                this.code.__exit();
                this.errb.__exit();
                ->;
            };


            fail(Node* n, byte* msg) -> void
            {
                switch (this.par != (FVMCodegen*)0)
                {
                    case (true) { -> this.par.fail(n, msg); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                this.failed = true;
                this.errb.put_str(msg);
                switch (n != (Node*)0)
                {
                    case (true) { this.errline = n.line; }
                    default {};
                };
                ->;
            };


            fail_name(Node* n, byte* pre, byte* name, byte* post) -> void
            {
                switch (this.par != (FVMCodegen*)0)
                {
                    case (true) { -> this.par.fail_name(n, pre, name, post); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                this.failed = true;
                this.errb.put_str(pre);
                this.errb.put(39);
                this.errb.put_str(name);
                this.errb.put(39);
                this.errb.put_str(post);
                switch (n != (Node*)0)
                {
                    case (true) { this.errline = n.line; }
                    default {};
                };
                ->;
            };


            keep(byte* s) -> byte*
            {
                byte* d = ts_dup(s);
                pv_push(this.owned, (void*)d);
                -> d;
            };



            capture(byte* name, int tag, i64 d, i64 m) -> void
            {
                FvmCap* c = (FvmCap*)nm_get(this.capidx, name);
                switch (c == (FvmCap*)0)
                {
                    case (true)
                    {
                        c = (FvmCap*)fmalloc((u64)((sizeof(FvmCap) + 7) / 8));
                        pv_push(this.owned, (void*)c);
                        c.name = this.keep(name);
                        nm_put(this.capidx, name, (void*)c);
                        pv_push(this.caps, (void*)c);
                    }
                    default {};
                };
                c.tag = tag;
                c.d = d;
                c.m = m;
                ->;
            };



            capture_macro(byte* name, byte* text) -> void
            {
                i64 iv;
                bool ok;
                double dv;
                switch (this.captured(name))
                {
                    case (true) { ->; }
                    default {};
                };
                switch (fvmcg_parse_pyint(text, @iv))
                {
                    case (true) { this.capture(name, 0, iv, (i64)0); ->; }
                    default {};
                };
                dv = fvm_parse_double(text, fvm_strlen(text), @ok);
                switch (ok)
                {
                    case (true) { this.capture(name, 5, fvm_dbl_bits(dv), (i64)0); ->; }
                    default {};
                };
                this.capture_bytes(name, text);
                ->;
            };


            captured(byte* name) -> bool -> nm_has(this.capidx, name);


            capture_bytes(byte* name, byte* text) -> void
            {
                byte* t = this.keep(text);
                this.capture(name, 15, fvm_p2i(t), (i64)fvm_strlen(t));
                ->;
            };


            emit(int op, i64 oa, i64 ob, i64 oc, byte* os) -> int
            {
                int r = this.code.add(op, oa, ob, oc, os, this.cur_line);
                switch (r < 0)
                {
                    case (true) { this.fail((Node*)0, g"instruction pool allocation failed\0"); }
                    default {};
                };
                -> r;
            };

            emit0(int op) -> int -> this.emit(op, (i64)0, (i64)0, (i64)0, (byte*)0);

            emit1(int op, i64 oa) -> int -> this.emit(op, oa, (i64)0, (i64)0, (byte*)0);


            emits(int op, byte* name) -> int -> this.emit(op, (i64)0, (i64)0, (i64)0, this.keep(name));


            emit_push(int tag, i64 dval) -> int -> this.emit(0, (i64)tag, dval, (i64)0, (byte*)0);


            ip() -> int -> this.code.len - this.ubase;


            patch_at(int idx, int op, int addr) -> void
            {
                this.code.ops[idx] = op;
                this.code.a[idx] = (i64)addr;
                this.code.b[idx] = (i64)0;
                this.code.c[idx] = (i64)0;
                this.code.s[idx] = (byte*)0;
                ->;
            };


            alloc_local(byte* name) -> int
            {
                i64* box = (i64*)nm_get(this.locals, name);
                switch (box == (i64*)0)
                {
                    case (true)
                    {
                        box = (i64*)fmalloc((u64)8);
                        pv_push(this.owned, (void*)box);
                        *box = (i64)this.nlocals;
                        nm_put(this.locals, name, (void*)box);
                        pv_push(this.lnames, (void*)this.keep(name));
                        this.nlocals++;
                    }
                    default {};
                };
                -> (int)*box;
            };


            set_add(NameMap* m, byte* name) -> void
            {
                nm_put(m, name, (void*)this);
                ->;
            };


            check_const_assign(byte* name, Node* n, byte* what) -> void
            {
                TypeSpec* ts = (TypeSpec*)nm_get(this.ltypes, name);
                switch (ts != (TypeSpec*)0)
                {
                    case (true)
                    {
                        switch ((ts.flags `& 2) != 0)
                        {
                            case (true) { this.fail_name(n, g"Cannot modify const variable \0", name, what); }
                            default {};
                        };
                    }
                    default {};
                };
                ->;
            };


            loop_push() -> void
            {
                pv_push(this.brks, (void*)pv_new());
                pv_push(this.conts, (void*)pv_new());
                ->;
            };


            loop_pop(int brk_to, int cont_to) -> void
            {
                PtrVec* bl = (PtrVec*)this.brks.items[this.brks.len - 1];
                PtrVec* cl = (PtrVec*)this.conts.items[this.conts.len - 1];
                int i;
                this.brks.len--;
                this.conts.len--;
                while (i < bl.len)
                {
                    this.patch_at((int)(u64)bl.items[i] - 1, 38, brk_to);
                    i++;
                };
                i = 0;
                while (i < cl.len)
                {
                    this.patch_at((int)(u64)cl.items[i] - 1, 38, cont_to);
                    i++;
                };
                pv_free(bl);
                pv_free(cl);
                ->;
            };


            cf_has(byte* name) -> bool -> nm_has(this.fidx, name);

            cf_put(byte* name, FVMCodegen* c) -> void
            {
                i64* box = (i64*)nm_get(this.fidx, name);
                byte* nm;
                switch (box != (i64*)0)
                {
                    case (true) { this.fcgs.items[(int)*box - 1] = (void*)c; }
                    default
                    {
                        nm = this.keep(name);
                        box = (i64*)fmalloc((u64)8);
                        pv_push(this.owned, (void*)box);
                        pv_push(this.fnames, (void*)nm);
                        pv_push(this.fcgs, (void*)c);
                        *box = (i64)this.fnames.len;
                        nm_put(this.fidx, nm, (void*)box);
                    };
                };
                ->;
            };


            cf_adopt(FVMCodegen* c) -> void
            {
                int i;
                while (i < c.fnames.len)
                {
                    switch (!this.cf_has((byte*)c.fnames.items[i]))
                    {
                        case (true) { this.cf_put((byte*)c.fnames.items[i], (FVMCodegen*)c.fcgs.items[i]); }
                        default {};
                    };
                    i++;
                };
                ->;
            };


            known_add(byte* name) -> void
            {
                nm_put(this.known, name, (void*)this);
                ->;
            };


            fn_known(byte* name) -> bool -> this.cf_has(name) | nm_has(this.known, name);



            make_child() -> FVMCodegen*
            {


                heap FVMCodegen c;
                int i;
                c.__init();
                c.par = this;
                c.pstmts = this.pstmts;
                pv_push(this.kids, (void*)c);
                while (i < this.bglobals.count)
                {
                    c.set_add(c.oglobals, (byte*)this.bglobals.keys[i]);
                    i++;
                };
                c.in_func = true;
                c.lay_copy_from(@this.lay);
                i = 0;
                while (i < this.known.count)
                {
                    c.known_add((byte*)this.known.keys[i]);
                    i++;
                };
                i = 0;
                while (i < this.usings.len)
                {
                    pv_push(c.usings, this.usings.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.enums.count)
                {
                    nm_put(c.enums, (byte*)this.enums.keys[i], this.enums.vals[i]);
                    i++;
                };
                i = 0;
                while (i < this.alspec.count)
                {
                    nm_put(c.alspec, (byte*)this.alspec.keys[i], this.alspec.vals[i]);
                    i++;
                };
                i = 0;
                while (i < this.ltn.count)
                {
                    nm_put(c.ltn, (byte*)this.ltn.keys[i], this.ltn.vals[i]);
                    i++;
                };
                i = 0;
                while (i < this.ltypes.count)
                {
                    nm_put(c.ltypes, (byte*)this.ltypes.keys[i], this.ltypes.vals[i]);
                    i++;
                };
                i = 0;
                while (i < this.macros.count)
                {
                    nm_put(c.macros, (byte*)this.macros.keys[i], this.macros.vals[i]);
                    i++;
                };
                i = 0;
                while (i < this.mcomp.count)
                {
                    nm_put(c.mcomp, (byte*)this.mcomp.keys[i], this.mcomp.vals[i]);
                    i++;
                };
                -> c;
            };


            bind_param(Node* p) -> void
            {

                byte* pn = p.text;
                switch (pn == (byte*)0) { case (true) { pn = g"\0"; } default {}; };
                this.alloc_local(pn);
                switch (p.ts != (TypeSpec*)0)
                {
                    case (true)
                    {
                        nm_put(this.ltypes, pn, (void*)p.ts);
                        switch (p.ts.custom_typename != (byte*)0)
                        {
                            case (true) { nm_put(this.ltn, pn, (void*)p.ts.custom_typename); }
                            default
                            {
                                switch (p.ts.base_type >= 0)
                                {
                                    case (true) { nm_put(this.ltn, pn, (void*)datatype_text(p.ts.base_type)); }
                                    default {};
                                };
                            };
                        };
                    }
                    default {};
                };
                ->;
            };



            register_functions(IDEKAVM* vm) -> bool
            {
                int i;
                int u;
                FVMCodegen* c;
                while (i < this.fnames.len)
                {
                    c = (FVMCodegen*)this.fcgs.items[i];
                    u = vm.import_unit(@c.code, c.unit);
                    switch (u < 0)
                    {
                        case (true) { -> false; }
                        default {};
                    };
                    vm.register_function((byte*)this.fnames.items[i], u);
                    i++;
                };
                -> true;
            };



            visit_stmts_direct(Node* b) -> void
            {
                int i;
                switch (b == (Node*)0)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (b.kind == NodeKind.BLOCK)
                {
                    case (true)
                    {
                        while (i < node_count(b, 0))
                        {
                            this.visit_stmt(node_child(b, 0, i));
                            i++;
                        };
                    }
                    default { this.visit_stmt(b); };
                };
                ->;
            };


            brk_push() -> void
            {
                pv_push(this.brks, (void*)pv_new());
                ->;
            };

            brk_pop(int to) -> void
            {
                PtrVec* bl = (PtrVec*)this.brks.items[this.brks.len - 1];
                int i;
                this.brks.len--;
                while (i < bl.len)
                {
                    this.patch_at((int)(u64)bl.items[i] - 1, 38, to);
                    i++;
                };
                pv_free(bl);
                ->;
            };


            numbered_slot(byte* pre, int i, byte* post) -> int
            {
                FvmBuf b;
                int s;
                b.__init();
                b.put_str(pre);
                b.put_i64((i64)i);
                b.put_str(post);
                b.put(0);
                s = this.alloc_local(b.mem);
                b.__exit();
                -> s;
            };


            const_int(Node* n, i64* v) -> bool
            {
                switch (n == (Node*)0) { case (true) { -> false; } default {}; };
                switch (n.kind == NodeKind.LITERAL)
                {
                    case (true) { *v = n.ival; -> true; }
                    default {};
                };
                -> false;
            };


            lay_copy_from(FvmLayouts* src) -> void
            {
                int i, k, f;
                while (i < src.n)
                {
                    this.lay.add_struct(src.sname[i], src.sendian[i], src.ssize[i], src.sbits[i]);
                    k = 0;
                    while (k < src.scount[i])
                    {
                        f = src.sfirst[i] + k;
                        this.lay.add_field(src.fname[f], src.ftag[f], src.foff[f], src.fsize[f]);
                        k++;
                    };
                    i++;
                };
                this.lay_seed = this.lay.n;
                ->;
            };


            lay_merge_into(FvmLayouts* dst) -> bool
            {
                int i, k, f;
                bool take;
                while (i < this.lay.n)
                {
                    take = i >= this.lay_seed | nm_has(this.ldirty, this.lay.sname[i]);
                    switch (take)
                    {
                        case (true)
                        {
                            switch (!dst.add_struct(fvm_dup(this.lay.sname[i], fvm_strlen(this.lay.sname[i])), this.lay.sendian[i], this.lay.ssize[i], this.lay.sbits[i]))
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            k = 0;
                            while (k < this.lay.scount[i])
                            {
                                f = this.lay.sfirst[i] + k;
                                switch (!dst.add_field(fvm_dup(this.lay.fname[f], fvm_strlen(this.lay.fname[f])), this.lay.ftag[f], this.lay.foff[f], this.lay.fsize[f]))
                                {
                                    case (true) { -> false; }
                                    default {};
                                };
                                k++;
                            };
                        }
                        default {};
                    };
                    i++;
                };
                -> true;
            };


            joined_name(byte* prefix, byte* name) -> byte*
            {
                FvmBuf b;
                byte* r;
                switch (prefix == (byte*)0)
                {
                    case (true) { -> name; }
                    default {};
                };
                b.__init();
                b.put_str(prefix);
                b.put_str(g"__\0");
                b.put_str(name);
                b.put(0);
                r = this.keep(b.mem);
                b.__exit();
                -> r;
            };



            define_layout(byte* name, Node* n, bool is_union) -> void
            {
                int i, bits, bsz, off, total_bits, maxsz;
                Node* m;
                int total = 0;
                int nm_n = node_count(n, 0);

                while (i < nm_n)
                {
                    m = node_child(n, 0, i);
                    bits = this.type_bit_width(m.ts);
                    bsz = (bits + 7) / 8;
                    switch (bsz < 1) { case (true) { bsz = 1; } default {}; };
                    switch (is_union)
                    {
                        case (true) { switch (bsz > maxsz) { case (true) { maxsz = bsz; } default {}; }; }
                        default
                        {
                            total = total + bsz;
                            total_bits = total_bits + bits;
                        };
                    };
                    i++;
                };
                switch (is_union) { case (true) { total = maxsz; } default {}; };
                this.lay.add_struct(name, this.keep(g"little\0"), total, total_bits);
                nm_put(this.ldirty, name, (void*)name);
                i = 0;
                while (i < nm_n)
                {
                    m = node_child(n, 0, i);
                    bits = this.type_bit_width(m.ts);
                    bsz = (bits + 7) / 8;
                    switch (bsz < 1) { case (true) { bsz = 1; } default {}; };
                    this.lay.add_field(this.keep(m.text), this.type_ttag_from_ts(m.ts), off, bsz);
                    switch (!is_union) { case (true) { off = off + bsz; } default {}; };
                    i++;
                };
                ->;
            };

            struct_def_prefixed(Node* n, byte* prefix) -> void
            {
                byte* full = this.joined_name(prefix, n.text);
                int i;
                int li;

                while (i < node_count(n, 3))
                {
                    this.struct_def_prefixed(node_child(n, 3, i), full);
                    i++;
                };
                this.define_layout(full, n, false);
                switch (prefix != (byte*)0)
                {
                    case (true)
                    {

                        li = this.lay.find(full);
                        this.lay.add_struct(this.keep(n.text), this.lay.sendian[li], this.lay.ssize[li], this.lay.sbits[li]);
                        nm_put(this.ldirty, this.lay.sname[this.lay.n - 1], (void*)n.text);
                        this.copy_fields_of(li, this.lay.n - 1);
                    }
                    default {};
                };
                ->;
            };


            copy_fields_of(int src, int dst) -> void
            {
                int k, f;
                while (k < this.lay.scount[src])
                {
                    f = this.lay.sfirst[src] + k;
                    this.lay.add_field(this.lay.fname[f], this.lay.ftag[f], this.lay.foff[f], this.lay.fsize[f]);
                    k++;
                };
                ->;
            };


            struct_tn_of(byte* name) -> byte*
            {
                byte* tn = (byte*)nm_get(this.ltn, name);
                TypeSpec* ts;
                switch (tn != (byte*)0) { case (true) { -> tn; } default {}; };
                ts = (TypeSpec*)nm_get(this.ltypes, name);
                switch (ts != (TypeSpec*)0) { case (true) { -> ts.custom_typename; } default {}; };
                -> (byte*)0;
            };




            write_back(byte* name) -> void
            {
                i64* box;
                switch (nm_has(this.oglobals, name))
                {
                    case (true) { this.emits(55, name); ->; }
                    default {};
                };
                box = (i64*)nm_get(this.locals, name);
                switch (box != (i64*)0)
                {
                    case (true)
                    {
                        switch (nm_has(this.bglobals, name))
                        {
                            case (true)
                            {
                                this.emit0(2);
                                this.emit1(51, *box);
                                this.emits(55, name);
                            }
                            default { this.emit1(51, *box); };
                        };
                        ->;
                    }
                    default {};
                };
                switch (nm_has(this.bglobals, name))
                {
                    case (true) { this.emits(55, name); }
                    default { this.emit1(51, (i64)this.alloc_local(name)); };
                };
                ->;
            };


            assign_tag(Node* n) -> void
            {
                Node* t = n.a;
                byte* tn;
                int slot;
                FvmBuf b;
                switch (t.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        tn = (byte*)nm_get(this.ltn, t.a.text);
                        switch (tn != (byte*)0)
                        {
                            case (true)
                            {
                                switch (nm_has(this.enums, tn))
                                {
                                    case (true)
                                    {
                                        this.visit_expr(t.a);
                                        this.visit_expr(n.b);
                                        this.emit0(66);
                                        slot = this.alloc_local(t.a.text);
                                        this.emit1(51, (i64)slot);
                                        ->;
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };

                b.__init();
                b.put_str(g"__\0");
                switch (t.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true) { b.put_str(t.a.text); }
                    default { b.put_str(g"__\0"); };
                };
                b.put_str(g"__tag__\0");
                b.put(0);
                slot = this.alloc_local(b.mem);
                b.__exit();
                this.visit_expr(n.b);
                this.emit1(51, (i64)slot);
                ->;
            };


            assign_elem_field(Node* n) -> void
            {
                Node* o = n.a.a;
                Node* t = n.a;
                byte* an = o.a.text;
                byte* tn = this.struct_tn_of(an);
                int li = this.lay.find(tn);
                int size = this.lay.ssize[li];
                int tmp, slot;
                bool is_global;
                switch (nm_has(this.hvars, an))
                {
                    case (true)
                    {
                        this.visit_expr(o.a);
                        this.visit_expr(o.b);
                        this.emit_push(1, (i64)size);
                        this.emit0(8);
                        this.emit0(6);
                        this.emit0(2);
                        this.emit(58, (i64)12, (i64)size, (i64)0, this.keep(tn));
                        this.visit_expr(n.b);
                        this.emits(63, t.text);
                        this.emit(59, (i64)12, (i64)size, (i64)0, this.keep(tn));
                        ->;
                    }
                    default {};
                };
                is_global = nm_has(this.bglobals, an) | nm_has(this.oglobals, an);
                this.visit_expr(o.a);
                this.visit_expr(o.b);
                this.emit0(69);
                this.visit_expr(n.b);
                this.emits(63, t.text);
                tmp = this.alloc_local(g"__mae_tmp__\0");
                this.emit1(51, (i64)tmp);
                this.visit_expr(o.a);
                this.visit_expr(o.b);
                this.emit1(50, (i64)tmp);
                this.emit0(70);
                switch (is_global)
                {
                    case (true)
                    {
                        this.emit0(2);
                        slot = this.alloc_local(an);
                        this.emit1(51, (i64)slot);
                        this.emits(55, an);
                    }
                    default
                    {
                        slot = this.alloc_local(an);
                        this.emit1(51, (i64)slot);
                    };
                };
                ->;
            };

            assign_member(Node* n) -> void
            {
                Node* t = n.a;
                Node* o = t.a;
                byte* tn;
                bool elem_field;
                FvmHeapVar* hv;
                i64* box;
                switch (fvm_streq(t.text, g"#\0"))
                {
                    case (true) { this.assign_tag(n); ->; }
                    default {};
                };
                switch (o.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        hv = (FvmHeapVar*)nm_get(this.hvars, o.text);
                        box = (i64*)nm_get(this.locals, o.text);
                        switch (hv != (FvmHeapVar*)0 & box != (i64*)0)
                        {
                            case (true)
                            {


                                switch (hv.count == 0 & hv.ttag == 12)
                                {
                                    case (true)
                                    {
                                        this.emit1(50, *box);
                                        this.visit_expr(o);
                                        this.visit_expr(n.b);
                                        this.emits(63, t.text);
                                        this.emit(59, (i64)hv.ttag, (i64)hv.bytes, (i64)0, (byte*)0);
                                        ->;
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                        this.visit_expr(o);
                        this.visit_expr(n.b);
                        this.emits(63, t.text);
                        this.write_back(o.text);
                        ->;
                    }
                    default {};
                };

                switch (o.kind == NodeKind.ARRAY_ACCESS)
                {
                    case (true)
                    {
                        switch (o.a.kind == NodeKind.IDENTIFIER)
                        {
                            case (true)
                            {
                                tn = this.struct_tn_of(o.a.text);
                                switch (tn != (byte*)0)
                                {
                                    case (true) { elem_field = this.lay.find(tn) >= 0; }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                switch (elem_field)
                {
                    case (true) { this.assign_elem_field(n); }
                    default
                    {
                        this.visit_expr(o);
                        this.visit_expr(n.b);
                        this.emits(63, t.text);
                    };
                };
                ->;
            };

            assign_array_elem(Node* n) -> void
            {
                Node* t = n.a;
                byte* an;
                FvmHeapVar* hv;
                i64* box;
                TypeSpec* ts;
                int arr_slot;
                bool pp;
                switch (t.a.kind != NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        this.fail(n, g"fvmcodegen: array assignment target must be a simple identifier in comptime\0");
                        ->;
                    }
                    default {};
                };
                an = t.a.text;
                hv = (FvmHeapVar*)nm_get(this.hvars, an);
                switch (hv != (FvmHeapVar*)0)
                {
                    case (true)
                    {
                        box = (i64*)nm_get(this.locals, an);
                        switch (hv.count > 0 & box != (i64*)0)
                        {
                            case (true)
                            {
                                this.emit1(50, *box);
                                this.visit_expr(t.b);
                                switch (hv.bytes > 1)
                                {
                                    case (true)
                                    {
                                        this.emit_push(1, (i64)hv.bytes);
                                        this.emit0(8);
                                    }
                                    default {};
                                };
                                this.emit0(6);
                                this.visit_expr(n.b);
                                this.emit(59, (i64)hv.ttag, (i64)hv.bytes, (i64)0, (byte*)0);
                                ->;
                            }
                            default {};
                        };
                    }
                    default {};
                };
                arr_slot = this.alloc_local(an);
                ts = (TypeSpec*)nm_get(this.ltypes, an);
                switch (ts != (TypeSpec*)0)
                {
                    case (true)
                    {
                        pp = ts.pointer_depth >= 2;
                        switch (!pp & ts.custom_typename != (byte*)0)
                        {
                            case (true)
                            {
                                switch ((ts.flags `& 64) != 0 & (ts.flags `& 32) == 0 & this.lay.find(ts.custom_typename) >= 0)
                                {
                                    case (true) { pp = true; }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                switch (pp)
                {
                    case (true)
                    {
                        this.visit_expr(t.a);
                        this.visit_expr(t.b);
                        this.emit_push(1, (i64)8);
                        this.emit0(8);
                        this.emit0(6);
                        this.visit_expr(n.b);
                        this.emit(59, (i64)10, (i64)8, (i64)0, (byte*)0);
                        ->;
                    }
                    default {};
                };
                this.visit_expr(t.a);
                this.visit_expr(t.b);
                this.visit_expr(n.b);
                this.emit0(70);
                this.emit1(51, (i64)arr_slot);
                ->;
            };


            dec_of(byte* s) -> int
            {
                bool ok;
                -> (int)fvm_parse_int(s, fvm_strlen(s), @ok);
            };


            name_bits(byte* tn) -> int
            {
                switch (fvm_streq(tn, g"int\0") | fvm_streq(tn, g"uint\0") | fvm_streq(tn, g"float\0")) { case (true) { -> 32; } default {}; };
                switch (fvm_streq(tn, g"long\0") | fvm_streq(tn, g"ulong\0") | fvm_streq(tn, g"double\0")) { case (true) { -> 64; } default {}; };
                switch (fvm_streq(tn, g"bool\0")) { case (true) { -> 1; } default {}; };
                switch (fvm_streq(tn, g"byte\0") | fvm_streq(tn, g"char\0")) { case (true) { -> 8; } default {}; };
                -> -1;
            };


            dt_kind(int dt) -> int
            {
                switch (dt)
                {
                    case (DataType.SINT) { -> 1; }
                    case (DataType.UINT) { -> 2; }
                    case (DataType.FLOAT) { -> 3; }
                    case (DataType.DOUBLE) { -> 4; }
                    case (DataType.BOOL) { -> 5; }
                    case (DataType.CHAR) { -> 6; }
                    case (DataType.BYTE) { -> 7; }
                    case (DataType.SLONG) { -> 8; }
                    case (DataType.ULONG) { -> 9; }
                    case (DataType.STRUCT) { -> 12; }
                    case (DataType.OBJECT) { -> 13; }
                    case (DataType.VOID) { -> 14; }
                    default { -> 0; };
                };
                -> 0;
            };


            name_kind(byte* tn) -> int
            {
                switch (fvm_streq(tn, g"int\0")) { case (true) { -> 1; } default {}; };
                switch (fvm_streq(tn, g"uint\0")) { case (true) { -> 2; } default {}; };
                switch (fvm_streq(tn, g"float\0")) { case (true) { -> 3; } default {}; };
                switch (fvm_streq(tn, g"double\0")) { case (true) { -> 4; } default {}; };
                switch (fvm_streq(tn, g"bool\0")) { case (true) { -> 5; } default {}; };
                switch (fvm_streq(tn, g"char\0")) { case (true) { -> 6; } default {}; };
                switch (fvm_streq(tn, g"byte\0")) { case (true) { -> 7; } default {}; };
                switch (fvm_streq(tn, g"long\0")) { case (true) { -> 8; } default {}; };
                switch (fvm_streq(tn, g"ulong\0")) { case (true) { -> 9; } default {}; };
                -> 0;
            };


            ts_kind(TypeSpec* ts) -> int
            {
                int depth;
                switch ((ts.flags `& 64) != 0)
                {
                    case (true)
                    {
                        depth = ts.pointer_depth;
                        switch (depth == 0) { case (true) { depth = 1; } default {}; };
                        -> depth * 100 + this.dt_kind(ts.base_type);
                    }
                    default {};
                };
                -> this.dt_kind(ts.base_type);
            };


            ts_is_ptr(TypeSpec* ts) -> bool
            {
                -> (ts.flags `& 64) != 0 | ts.pointer_depth != 0;
            };


            stub(Node* n, byte* what) -> void
            {
                i64* box;
                switch (this.par != (FVMCodegen*)0)
                {
                    case (true) { -> this.par.stub(n, what); }
                    default {};
                };
                box = (i64*)nm_get(this.ucounts, what);
                switch (n != (Node*)0)
                {
                    case (true) { this.cur_line = n.line; }
                    default {};
                };
                switch (box == (i64*)0)
                {
                    case (true)
                    {
                        box = (i64*)fmalloc((u64)8);
                        pv_push(this.owned, (void*)box);
                        *box = (i64)0;
                        nm_put(this.ucounts, what, (void*)box);
                    }
                    default {};
                };
                *box = *box + (i64)1;
                this.nstubs++;
                ->;
            };







            seed_program_structs() -> void
            {
                int i;
                Node* s;
                switch (this.pstmts == (NodeVec*)0) { case (true) { ->; } default {}; };
                while (i < this.pstmts.len)
                {
                    s = this.pstmts.items[i];
                    switch (s.kind == NodeKind.STRUCT_DEF_STATEMENT) { case (true) { s = s.a; } default {}; };
                    switch (s.kind == NodeKind.STRUCT_DEF)
                    {
                        case (true)
                        {
                            switch (this.lay.find(s.text) < 0) { case (true) { this.struct_def_prefixed(s, (byte*)0); } default {}; };
                        }
                        default {};
                    };
                    i++;
                };
                ->;
            };

            compile_comptime(Node* n) -> bool
            {
                int before = this.nstubs;
                int i;
                int slot;
                Node* st;
                FvmCap* cp;
                this.seed_program_structs();

                while (i < this.caps.len)
                {
                    cp = (FvmCap*)this.caps.items[i];
                    slot = this.alloc_local(cp.name);
                    this.emit(0, (i64)cp.tag, cp.d, cp.m, (byte*)0);
                    this.emit1(51, (i64)slot);
                    i++;
                };
                i = 0;


                switch (n.kind == NodeKind.COMPTIME_BLOCK)
                {
                    case (true)
                    {
                        this.cbody = n.l0;
                        while (i < node_count(n, 0))
                        {
                            st = node_child(n, 0, i);
                            switch (st != (Node*)0)
                            {
                                case (true)
                                {
                                    switch (st.kind == NodeKind.TRAIT_DEF)
                                    {
                                        case (true)
                                        {
                                            switch (!nm_has(this.trreg, st.text)) { case (true) { nm_put(this.trreg, st.text, (void*)st); } default {}; };
                                        }
                                        default {};
                                    };
                                    switch (st.kind == NodeKind.INTERFACE_DEF)
                                    {
                                        case (true)
                                        {
                                            switch (!nm_has(this.ifreg, st.text)) { case (true) { nm_put(this.ifreg, st.text, (void*)st); } default {}; };
                                        }
                                        default {};
                                    };
                                }
                                default {};
                            };
                            i++;
                        };
                        this.visit_body(n);
                    }
                    default { this.visit_stmt(n); };
                };
                this.resolve_goto_patches();
                this.emit0(46);
                this.code.unit_end(this.unit);
                -> this.nstubs == before & !this.failed;
            };





            import_const(Node* s, IDEKAVM* vm) -> void
            {
                int k = s.kind;
                Node* ns = s;
                Node* ini;
                Node* inner;
                TypeSpec* ts;
                byte* nm;
                i64* blk;
                int i;
                int cnt;
                switch (k == NodeKind.NAMESPACE_DEF_STATEMENT | k == NodeKind.NAMESPACE_DEF)
                {
                    case (true)
                    {
                        switch (k == NodeKind.NAMESPACE_DEF_STATEMENT) { case (true) { ns = s.a; } default {}; };
                        switch (ns.a != (Node*)0)
                        {
                            case (true)
                            {
                                i = 0;
                                while (i < node_count(ns.a, 0)) { this.import_const(node_child(ns.a, 0, i), vm); i++; };
                            }
                            default {};
                        };
                        switch (ns.b != (Node*)0)
                        {
                            case (true)
                            {
                                i = 0;
                                while (i < node_count(ns.b, 0)) { this.import_const(node_child(ns.b, 0, i), vm); i++; };
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (k != NodeKind.VARIABLE_DECLARATION) { case (true) { ->; } default {}; };
                switch (vm.global_find(s.text) >= 0) { case (true) { ->; } default {}; };
                nm = this.keep(s.text);
                ini = s.a;
                ts = s.ts;
                switch (ini == (Node*)0)
                {
                    case (true)
                    {
                        cnt = 0;
                        switch (ts != (TypeSpec*)0)
                        {
                            case (true)
                            {
                                switch ((ts.flags `& 32) != 0 & ts.array_size != (Node*)0 & ts.array_size.kind == NodeKind.LITERAL)
                                {
                                    case (true) { cnt = (int)ts.array_size.ival; }
                                    default {};
                                };
                            }
                            default {};
                        };
                        switch (cnt > 0)
                        {
                            case (true)
                            {
                                blk = vm.arr_make(cnt, 10);
                                switch (blk != (i64*)0) { case (true) { vm.global_set(nm, 14, (i64)blk, (i64)cnt); } default {}; };
                            }
                            default { vm.global_set(nm, 10, (i64)0, (i64)0); };
                        };
                        ->;
                    }
                    default {};
                };
                switch (ini.kind == NodeKind.LITERAL)
                {
                    case (true)
                    {
                        switch (ini.op)
                        {
                            case (DataType.BOOL) { vm.global_set(nm, 6, (i64)(ini.ival != (i64)0), (i64)0); }
                            case (DataType.FLOAT) { vm.global_set(nm, 5, fvm_dbl_bits(ini.fval), (i64)0); }
                            case (DataType.DOUBLE) { vm.global_set(nm, 5, fvm_dbl_bits(ini.fval), (i64)0); }
                            case (DataType.SINT) { vm.global_set(nm, 2, ini.ival, (i64)0); }
                            case (DataType.UINT) { vm.global_set(nm, 2, ini.ival, (i64)0); }
                            case (DataType.SLONG) { vm.global_set(nm, 2, ini.ival, (i64)0); }
                            case (DataType.ULONG) { vm.global_set(nm, 2, ini.ival, (i64)0); }
                            case (DataType.BYTE) { vm.global_set(nm, 2, ini.ival, (i64)0); }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (ini.kind == NodeKind.CAST_EXPRESSION & ini.a != (Node*)0 & ini.a.kind == NodeKind.ADDRESS_OF)
                {
                    case (true)
                    {
                        inner = ini.a.a;
                        switch (inner != (Node*)0 & inner.kind == NodeKind.LITERAL & (inner.op == DataType.VOID | (inner.ival == (i64)0 & inner.fval == (double)0.0)))
                        {
                            case (true) { vm.global_set(nm, 10, (i64)0, (i64)0); }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                vm.global_set(nm, 10, (i64)0, (i64)0);
                ->;
            };




            compile_import(PtrVec* stmts, IDEKAVM* vm) -> bool
            {
                int i;
                int k;
                Node* s;
                int before = this.nstubs;
                i = 0;
                while (i < stmts.len) { this.import_const((Node*)stmts.items[i], vm); i++; };
                this.lay_copy_from(@vm.layouts);
                i = 0;
                while (i < vm.funcs.n)
                {
                    this.known_add(vm.funcs.names[i]);
                    i++;
                };
                i = 0;
                while (i < vm.gn)
                {
                    this.set_add(this.bglobals, vm.g_name[i]);
                    i++;
                };
                i = 0;
                while (i < stmts.len & !this.failed)
                {
                    s = (Node*)stmts.items[i];
                    k = s.kind;
                    switch (k == NodeKind.FUNCTION_DEF | k == NodeKind.FUNCTION_DEF_STATEMENT | k == NodeKind.NAMESPACE_DEF | k == NodeKind.NAMESPACE_DEF_STATEMENT | k == NodeKind.STRUCT_DEF | k == NodeKind.STRUCT_DEF_STATEMENT | k == NodeKind.UNION_DEF | k == NodeKind.UNION_DEF_STATEMENT | k == NodeKind.ENUM_DEF | k == NodeKind.ENUM_DEF_STATEMENT | k == NodeKind.TYPE_FUNC_DEF | k == NodeKind.EXTERN_BLOCK)
                    {
                        case (true) { this.visit_stmt(s); }
                        default {};
                    };
                    i++;
                };
                this.resolve_goto_patches();
                this.emit0(46);
                this.code.unit_end(this.unit);
                -> this.nstubs == before & !this.failed;
            };



            register_new_functions(IDEKAVM* vm) -> bool
            {
                int i;
                int u;
                FVMCodegen* c;
                while (i < this.fnames.len)
                {
                    switch (vm.funcs.find((byte*)this.fnames.items[i]) < 0)
                    {
                        case (true)
                        {
                            c = (FVMCodegen*)this.fcgs.items[i];
                            u = vm.import_unit(@c.code, c.unit);
                            switch (u < 0) { case (true) { -> false; } default {}; };
                            vm.register_function((byte*)this.fnames.items[i], u);
                        }
                        default {};
                    };
                    i++;
                };
                -> true;
            };



            collect_externs(IDEKAVM* vm) -> void
            {
                int i;
                int k;
                FVMCodegen* c;
                k = this.ubase;
                while (k < this.code.len)
                {
                    switch (this.code.ops[k] == 101)
                    {
                        case (true) { vm.extern_add(this.code.s[k], (int)this.code.a[k], (int)this.code.b[k], (i64*)fvm_i2p(this.code.c[k])); }
                        default {};
                    };
                    k++;
                };
                while (i < this.fnames.len)
                {
                    c = (FVMCodegen*)this.fcgs.items[i];
                    k = c.ubase;
                    while (k < c.code.len)
                    {
                        switch (c.code.ops[k] == 101)
                        {
                            case (true) { vm.extern_add(c.code.s[k], (int)c.code.a[k], (int)c.code.b[k], (i64*)fvm_i2p(c.code.c[k])); }
                            default {};
                        };
                        k++;
                    };
                    i++;
                };
                ->;
            };







            visit_body_stmts(Node* b) -> void
            {
                int c = node_count(b, 0);
                int i;
                int j;
                int k;
                int gs;
                int* ends = (int*)fmalloc((u64)((c + 1) * 4));
                Node* s;
                j = 0;
                while (j < c)
                {
                    ends[j] = -1;
                    j++;
                };

                j = 0;
                while (j < c)
                {
                    s = node_child(b, 0, j);
                    switch (this.is_unpack_init(s))
                    {
                        case (true)
                        {
                            k = j - 1;
                            while (k >= 0 & ends[k] == -1 & this.is_bare_decl(node_child(b, 0, k), s.ts.base_type))
                            {
                                k--;
                            };
                            gs = k + 1;
                            switch (gs < j)
                            {
                                case (true)
                                {
                                    ends[gs] = j;
                                    k = gs + 1;
                                    while (k <= j)
                                    {
                                        ends[k] = -2;
                                        k++;
                                    };
                                }
                                default {};
                            };
                        }
                        default {};
                    };
                    j++;
                };
                while (i < c)
                {
                    switch (ends[i] >= 0)
                    {
                        case (true)
                        {
                            this.emit_unpack(b, i, ends[i]);
                            i = ends[i] + 1;
                        }
                        default
                        {
                            switch (ends[i] == -2)
                            {
                                case (true) { i++; }
                                default
                                {
                                    this.visit_stmt(node_child(b, 0, i));
                                    i++;
                                };
                            };
                        };
                    };
                };
                ffree((byte*)ends);
                ->;
            };


            is_unpack_init(Node* s) -> bool
            {
                int dt;
                switch (s.kind != NodeKind.VARIABLE_DECLARATION | s.a == (Node*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (s.a.kind != NodeKind.ARRAY_LITERAL | (s.a.flags `& 8) != 0 | node_count(s.a, 0) != 1 | s.ts == (TypeSpec*)0)
                        {
                            case (true) { -> false; }
                            default
                            {
                                dt = s.ts.base_type;
                                -> (s.ts.flags `& 32) == 0 & fvmcg_unpack_type(dt);
                            };
                        };
                    };
                };
            };


            is_bare_decl(Node* s, int dt) -> bool
            {
                switch (s.kind != NodeKind.VARIABLE_DECLARATION | s.ts == (TypeSpec*)0)
                {
                    case (true) { -> false; }
                    default { -> s.a == (Node*)0 & s.ts.base_type == dt; };
                };
            };




            visit_body(Node* b) -> void
            {
                PtrVec* scope;
                switch (b == (Node*)0)
                {
                    case (true) { ->; }
                    default {};
                };
                scope = pv_new();
                pv_push(this.defers, (void*)scope);
                switch (b.kind == NodeKind.BLOCK | b.kind == NodeKind.COMPTIME_BLOCK)
                {
                    case (true) { this.visit_body_stmts(b); }
                    default { this.visit_stmt(b); };
                };
                this.flush_defers(scope);
                this.defers.len--;
                pv_free(scope);
                ->;
            };


            visit_stmt(Node* n) -> void
            {
                int k;
                switch (n == (Node*)0)
                {
                    case (true) { ->; }
                    default {};
                };
                k = n.kind;
                this.cur_line = n.line;
                switch (k)
                {
                case (NodeKind.VARIABLE_DECLARATION) { this.visit_var_decl(n); }
                case (NodeKind.TYPE_DECLARATION) { this.visit_type_decl(n); }
                case (NodeKind.ASSIGNMENT) { this.visit_assignment(n); }
                case (NodeKind.COMPOUND_ASSIGNMENT) { this.visit_compound_assign(n); }
                case (NodeKind.RANGE_ASSIGNMENT) { this.visit_range_assignment(n); }
                case (NodeKind.TERNARY_ASSIGN) { this.visit_ternary_assign(n); }
                case (NodeKind.EXPRESSION_STATEMENT) { this.visit_expr_stmt(n); }
                case (NodeKind.IF_STATEMENT) { this.visit_if(n); }
                case (NodeKind.FOR_LOOP) { this.visit_for(n); }
                case (NodeKind.FOR_IN_LOOP) { this.visit_for_in(n); }
                case (NodeKind.WHILE_LOOP) { this.visit_while(n); }
                case (NodeKind.DO_LOOP) { this.visit_do(n); }
                case (NodeKind.DO_WHILE_LOOP) { this.visit_do_while(n); }
                case (NodeKind.DEFER_STATEMENT) { this.visit_defer(n); }
                case (NodeKind.NORETURN_STATEMENT) { this.visit_noreturn(n); }
                case (NodeKind.TRY_BLOCK) { this.visit_try(n); }
                case (NodeKind.THROW_STATEMENT) { this.visit_throw(n); }
                case (NodeKind.RETURN_STATEMENT) { this.visit_return(n); }
                case (NodeKind.BREAK_STATEMENT) { this.visit_break(n); }
                case (NodeKind.BREAK_SWITCH_STATEMENT) { this.visit_break_switch(n); }
                case (NodeKind.ESCAPE_STATEMENT) { this.visit_escape(n); }
                case (NodeKind.CONTINUE_STATEMENT) { this.visit_continue(n); }
                case (NodeKind.BLOCK) { this.visit_body(n); }
                case (NodeKind.SWITCH_STATEMENT) { this.visit_switch(n); }
                case (NodeKind.FUNCTION_DEF) { this.visit_function_def(n); }
                case (NodeKind.FUNCTION_DEF_STATEMENT) { this.visit_function_def(n.a); }
                case (NodeKind.FUNCTION_POINTER_DECLARATION) { this.visit_fp_decl(n); }
                case (NodeKind.FUNCTION_POINTER_ASSIGNMENT) { this.visit_fp_assignment(n); }
                case (NodeKind.TYPE_FUNC_DEF) { this.visit_type_func_def(n); }
                case (NodeKind.NAMESPACE_DEF) { this.visit_namespace_def(n); }
                case (NodeKind.NAMESPACE_DEF_STATEMENT) { this.visit_namespace_def(n.a); }
                case (NodeKind.STRUCT_DEF) { this.visit_struct_def(n); }
                case (NodeKind.STRUCT_DEF_STATEMENT) { this.visit_struct_def(n.a); }
                case (NodeKind.STRUCT_FIELD_ASSIGN) { this.visit_struct_field_assign(n); }
                case (NodeKind.UNION_DEF) { this.visit_union_def(n); }
                case (NodeKind.UNION_DEF_STATEMENT) { this.visit_union_def(n.a); }
                case (NodeKind.OBJECT_DEF) { this.visit_object_def(n); }
                case (NodeKind.OBJECT_DEF_STATEMENT) { this.visit_object_def(n.a); }
                case (NodeKind.TRAIT_DEF) { this.visit_trait_def(n); }
                case (NodeKind.INTERFACE_DEF) { this.visit_interface_def(n); }
                case (NodeKind.DEPRECATE_STATEMENT) { this.visit_deprecate(n); }
                case (NodeKind.ASSERT_STATEMENT) { this.visit_assert(n); }
                case (NodeKind.MACRO_DEF_STATEMENT) { this.visit_macro_def(n); }
                case (NodeKind.EXTERN_BLOCK) { this.visit_extern_block(n); }
                case (NodeKind.ENUM_DEF) { this.visit_enum_def(n); }
                case (NodeKind.ENUM_DEF_STATEMENT) { this.visit_enum_def(n.a); }
                case (NodeKind.LABEL_STATEMENT) { this.visit_label(n); }
                case (NodeKind.GOTO_STATEMENT) { this.visit_goto(n); }
                case (NodeKind.JUMP_STATEMENT) { this.visit_jump(n); }
                case (NodeKind.EMIT_IDEKA) { this.visit_emitideka(n); }
                case (NodeKind.IDEKAVM_BLOCK) { this.visit_idkvm_block(n); }
                case (NodeKind.COMPTIME_BLOCK) { this.visit_body(n); }
                case (NodeKind.USING_STATEMENT) { this.visit_using(n); }
                case (NodeKind.NOT_USING_STATEMENT) { this.visit_not_using(n); }
                case (NodeKind.CONTRACT_DEF) {}
                case (NodeKind.CONSTRA_DEF) {}
                case (NodeKind.MACRO_DEF) {}
                case (NodeKind.EXPORT_BLOCK) {}
                default { this.stub(n, node_kind_name(k)); };
                };
                ->;
            };


            visit_expr(Node* n) -> bool
            {
                int k;
                switch (n == (Node*)0)
                {
                    case (true) { -> false; }
                    default {};
                };
                k = n.kind;
                switch (k)
                {
                case (NodeKind.LITERAL) { -> this.visit_literal(n); }
                case (NodeKind.STRING_LITERAL) { -> this.visit_string_literal(n); }
                case (NodeKind.F_STRING_LITERAL) { -> this.visit_fstring_literal(n); }
                case (NodeKind.ARRAY_LITERAL) { -> this.visit_array_literal(n); }
                case (NodeKind.IDENTIFIER) { -> this.visit_identifier(n); }
                case (NodeKind.BINARY_OP) { -> this.visit_binary_op(n); }
                case (NodeKind.UNARY_OP) { -> this.visit_unary_op(n); }
                case (NodeKind.FUNCTION_CALL) { -> this.visit_function_call(n); }
                case (NodeKind.FUNCTION_POINTER_CALL) { -> this.visit_fp_call(n); }
                case (NodeKind.METHOD_CALL) { -> this.visit_method_call(n); }
                case (NodeKind.ARRAY_ACCESS) { -> this.visit_array_access(n); }
                case (NodeKind.BIT_SLICE) { -> this.visit_bit_slice(n); }
                case (NodeKind.BIT_INDEX_ACCESS) { -> this.visit_bit_index_access(n); }
                case (NodeKind.NULL_COALESCE) { -> this.visit_null_coalesce(n); }
                case (NodeKind.TERNARY_ASSIGN) { -> this.visit_ternary_assign(n); }
                case (NodeKind.NOT_NULL) { -> this.visit_not_null(n); }
                case (NodeKind.ARRAY_SLICE) { -> this.visit_array_slice(n); }
                case (NodeKind.ARRAY_COMPREHENSION) { -> this.visit_array_comprehension(n); }
                case (NodeKind.RANGE_EXPRESSION) { -> this.visit_range_expression(n); }
                case (NodeKind.TIE_EXPRESSION) { -> this.visit_tie_expression(n); }
                case (NodeKind.VARIADIC_ACCESS) { -> this.visit_variadic_access(n); }
                case (NodeKind.MACRO_CALL) { -> this.visit_macro_call(n); }
                case (NodeKind.TYPE_FUNC_CALL) { -> this.visit_type_func_call(n); }
                case (NodeKind.STRUCT_FIELD_ACCESS) { -> this.visit_struct_field_access(n); }
                case (NodeKind.STRUCT_INSTANCE) { -> this.visit_struct_instance(n); }
                case (NodeKind.STRUCT_LITERAL) { -> this.visit_struct_literal(n); }
                case (NodeKind.STRUCT_RECAST) { -> this.visit_struct_recast(n); }
                case (NodeKind.MEMBER_ACCESS) { -> this.visit_member_access(n); }
                case (NodeKind.ADDRESS_OF) { -> this.visit_address_of(n); }
                case (NodeKind.POINTER_DEREF) { -> this.visit_pointer_deref(n); }
                case (NodeKind.SIZE_OF) { -> this.visit_sizeof(n); }
                case (NodeKind.ALIGN_OF) { -> this.visit_alignof(n); }
                case (NodeKind.TYPE_OF) { -> this.visit_typeof(n); }
                case (NodeKind.ENDIAN_OF) { -> this.visit_endianof(n); }
                case (NodeKind.IN_EXPRESSION) { -> this.visit_in_expression(n); }
                case (NodeKind.HAS_EXPRESSION) { -> this.visit_has_expression(n); }
                case (NodeKind.CAST_EXPRESSION) { -> this.visit_cast(n); }
                case (NodeKind.TYPE_CONVERT_EXPRESSION) { -> this.visit_cast(n); }
                case (NodeKind.INLINE_ASM) { -> this.visit_inline_asm(n); }
                case (NodeKind.TERNARY_OP) { -> this.visit_ternary_op(n); }
                case (NodeKind.IF_EXPRESSION) { -> this.visit_if_expression(n); }
                case (NodeKind.STRINGIFY) { -> this.visit_stringify(n); }
                case (NodeKind.ASSIGNMENT) { this.visit_assignment(n); -> false; }
                case (NodeKind.COMPOUND_ASSIGNMENT) { this.visit_compound_assign(n); -> false; }
                case (NodeKind.RANGE_ASSIGNMENT) { this.visit_range_assignment(n); -> false; }
                case (NodeKind.BLOCK) { this.visit_body(n); -> false; }
                default { this.stub(n, node_kind_name(k)); };
                };
                -> false;
            };




            visit_literal(Node* n) -> bool
            {
                int dt = n.op;
                switch (dt)
                {
                    case (DataType.FLOAT) { this.emit_push(4, fvm_dbl_bits(n.fval)); -> true; }
                    case (DataType.DOUBLE) { this.emit_push(5, fvm_dbl_bits(n.fval)); -> true; }
                    case (DataType.BOOL)
                    {
                        switch (n.ival != (i64)0)
                        {
                            case (true) { this.emit_push(6, (i64)1); }
                            default { this.emit_push(6, (i64)0); };
                        };
                        -> true;
                    }
                    case (DataType.SINT) { this.emit_push(0, n.ival); -> true; }
                    case (DataType.UINT) { this.emit_push(1, n.ival); -> true; }
                    case (DataType.SLONG) { this.emit_push(2, n.ival); -> true; }
                    case (DataType.ULONG) { this.emit_push(3, n.ival); -> true; }
                    case (DataType.BYTE) { this.emit_push(7, n.ival); -> true; }
                    case (DataType.CHAR) { this.emit_push(8, n.ival); -> true; }
                    case (DataType.STRUCT)
                    {

                        this.fail_pieces(n, g"invalid literal for int() with base 10: '\0", datatype_text(dt), g"'\0", (byte*)0, (byte*)0, (byte*)0, (byte*)0);
                        -> false;
                    }
                    case (DataType.OBJECT)
                    {
                        this.fail_pieces(n, g"invalid literal for int() with base 10: '\0", datatype_text(dt), g"'\0", (byte*)0, (byte*)0, (byte*)0, (byte*)0);
                        -> false;
                    }
                    default {};
                };

                this.emit_push(0, n.ival);
                -> true;
            };



            visit_identifier(Node* n) -> bool
            {
                i64* box;
                int i;
                FvmBuf b;
                FvmHeapVar* hv;
                switch (nm_has(this.oglobals, n.text))
                {
                    case (true) { this.emits(54, n.text); -> true; }
                    default {};
                };
                box = (i64*)nm_get(this.locals, n.text);
                switch (box != (i64*)0)
                {
                    case (true)
                    {
                        this.emit1(50, *box);
                        hv = (FvmHeapVar*)nm_get(this.hvars, n.text);

                        switch (hv != (FvmHeapVar*)0)
                        {
                            case (true)
                            {
                                switch (hv.count == 0)
                                {
                                    case (true) { this.emit(58, (i64)hv.ttag, (i64)hv.bytes, (i64)0, (byte*)0); }
                                    default {};
                                };
                            }
                            default {};
                        };
                        -> true;
                    }
                    default {};
                };

                i = this.usings.len - 1;
                while (i >= 0)
                {
                    b.__init();
                    b.put_str((byte*)this.usings.items[i]);
                    b.put_str(g"__\0");
                    b.put_str(n.text);
                    b.put(0);
                    box = (i64*)nm_get(this.locals, b.mem);
                    b.__exit();
                    switch (box != (i64*)0)
                    {
                        case (true)
                        {
                            this.emit1(50, *box);
                            -> true;
                        }
                        default {};
                    };
                    i--;
                };

                switch (this.lay.find(n.text) >= 0)
                {
                    case (true)
                    {
                        this.emit(0, (i64)15, fvm_p2i(this.keep(n.text)), (i64)fvm_strlen(n.text), (byte*)0);
                        -> true;
                    }
                    default {};
                };
                switch (nm_has(this.bglobals, n.text))
                {
                    case (true) { this.emits(54, n.text); -> true; }
                    default {};
                };
                this.fail_name(n, g"fvmcodegen: undefined comptime variable \0", n.text, g"\0");
                -> false;
            };


            visit_binary_op(Node* n) -> bool
            {
                int op = n.op;
                int j;
                int vm;
                switch (op == Operator.AND)
                {
                    case (true)
                    {
                        this.visit_expr(n.a);
                        this.emit0(2);
                        j = this.emit1(40, (i64)0);
                        this.emit0(1);
                        this.visit_expr(n.b);
                        this.patch_at(j, 40, this.ip());
                        -> true;
                    }
                    default {};
                };
                switch (op == Operator.OR)
                {
                    case (true)
                    {
                        this.visit_expr(n.a);
                        this.emit0(2);
                        j = this.emit1(39, (i64)0);
                        this.emit0(1);
                        this.visit_expr(n.b);
                        this.patch_at(j, 39, this.ip());
                        -> true;
                    }
                    default {};
                };
                this.visit_expr(n.a);
                this.visit_expr(n.b);
                vm = fvmcg_binop_single(op);
                switch (vm >= 0)
                {
                    case (true) { this.emit0(vm); -> true; }
                    default {};
                };
                vm = fvmcg_binop_composite(op);
                switch (vm >= 0)
                {
                    case (true)
                    {
                        this.emit0(vm);
                        this.emit0(20);
                        -> true;
                    }
                    default {};
                };
                this.fail(n, g"fvmcodegen: binary operator not supported in comptime\0");
                -> false;
            };




            note_decl_type(byte* name, TypeSpec* ts) -> void
            {
                nm_put(this.ltypes, name, (void*)ts);
                switch (ts.custom_typename != (byte*)0)
                {
                    case (true) { nm_put(this.ltn, name, (void*)ts.custom_typename); }
                    default { nm_put(this.ltn, name, (void*)datatype_text(ts.base_type)); };
                };
                ->;
            };




            declared_float_ttag(TypeSpec* ts) -> int
            {
                switch (ts == (TypeSpec*)0) { case (true) { -> -1; } default {}; };
