                        -> ot;
                    };
                };
            };


            join_types(TypeSpec* a, TypeSpec* b) -> TypeSpec*
            {
                int ka = this.kind_of(a);
                int kb = this.kind_of(b);
                switch (a == (TypeSpec*)0)
                {
                    case (true) { -> b; }
                    default
                    {
                        switch (b == (TypeSpec*)0)
                        {
                            case (true) { -> a; }
                            default
                            {
                                switch (ka == TyKind.INT & kb == TyKind.INT)
                                {
                                    case (true) {
                                    switch (this.width_of(b) > this.width_of(a))
                                    {
                                        case (true) { -> b; }
                                        default {};
                                    };
                                    -> a;
