                while (c >= 0)
                {
                    this.tmp.put(c);
                    switch (c == 10) { case (true) { c = -1; } default { c = gc(); }; };
                };
                this.push_bytes(this.tmp.mem, this.tmp.len);
                ->;
            };


            op_readfile() -> void
            {
                byte* path = this.pop_text();
                void* fh;
                int n, k, got;
                switch (path == (byte*)0) { case (true) { ->; } default {}; };
                path = fvm_dup(path, fvm_strlen(path));
                fh = fopen(path, g"rb\0");
                switch (fh == (void*)0)
                {
                    case (true) {
                        this.errno_fail(g"compiler.io.readfile: \0", path);
                        ffree(path);
                        ->;
                    }
                    default {};
                };
                fseek(fh, 0, 2);
                n = ftell(fh);
                fseek(fh, 0, 0);
                switch (n < 0)
                {
                    case (true) {
                        this.errno_fail(g"compiler.io.readfile: \0", path);
                        fclose(fh);
                        ffree(path);
                        ->;
                    }
                    default {};
                };
                k = this.vheap.alloc(n + 1);
                switch (k == 0)
                {
                    case (true) {
                        this.fail(g"VMHeap: invalid size or out of memory\0");
                        fclose(fh);
                        ffree(path);
                        ->;
                    }
                    default {};
                };
                got = fread(this.vheap.mem + k, 1, n, fh);
                fclose(fh);
                ffree(path);
                this.push(10, (i64)k, (i64)0);
                ->;
            };


            write_mode(byte* flags) -> byte*
            {
                this.osb.clear();
                int k = 0;
                while (flags[k] != 0)
                {
                    switch (flags[k] != ' ') { case (true) { this.osb.put((int)flags[k]); } default {}; };
                    k++;
                };
                switch (fvm_streq(this.osb.mem, g"r\0")) { case (true) { -> g"rb\0"; } default {}; };
                switch (fvm_streq(this.osb.mem, g"rt\0")) { case (true) { -> g"r\0"; } default {}; };
                switch (fvm_streq(this.osb.mem, g"w\0")) { case (true) { -> g"wb\0"; } default {}; };
                switch (fvm_streq(this.osb.mem, g"wt\0")) { case (true) { -> g"w\0"; } default {}; };
                switch (fvm_streq(this.osb.mem, g"a\0")) { case (true) { -> g"ab\0"; } default {}; };
                switch (fvm_streq(this.osb.mem, g"at\0")) { case (true) { -> g"a\0"; } default {}; };
                switch (fvm_streq(this.osb.mem, g"rw\0")) { case (true) { -> g"r+b\0"; } default {}; };
                switch (fvm_streq(this.osb.mem, g"rwt\0")) { case (true) { -> g"r+\0"; } default {}; };
                -> g"wb\0";
            };


            op_writefile() -> void
            {
                byte* fl = this.pop_text();
                byte* mode;
                byte* raw;
                byte* path;
                void* fh;
                int ct, n, wrote;
                i64 cd, cm;
                switch (fl == (byte*)0) { case (true) { ->; } default {}; };
                mode = this.write_mode(fl);
                this.pop_val();
                switch (this.failed) { case (true) { ->; } default {}; };
                ct = this.pt;
                cd = this.pd;
                cm = this.pm;


                this.tmp.clear();
                switch (ct == 15 | ct == 10)
                {
                    case (true) {
                        raw = this.str_of(ct, cd);
                        switch (raw == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"compiler.io.writefile: invalid content pointer\0");
                                ->;
                            }
                            default {};
                        };
                        switch (ct == 15) { case (true) { n = (int)cm; } default { n = fvm_strlen(raw); }; };
                        this.tmp.put_n(raw, n);
                    }
                    default { this.tmp.put_i64(cd); };
                };
                raw = fvm_dup(this.tmp.mem, this.tmp.len);
                n = this.tmp.len;
                path = this.pop_text();
                switch (path == (byte*)0) { case (true) { ffree(raw); ->; } default {}; };
                fh = fopen(path, mode);
                switch (fh == (void*)0)
                {
                    case (true) {
                        this.errno_fail(g"compiler.io.writefile: \0", path);
                        ffree(raw);
                        ->;
                    }
                    default {};
                };
                wrote = fwrite(raw, 1, n, fh);
                fclose(fh);
                ffree(raw);
                switch (wrote != n)
                {
                    case (true) { this.errno_fail(g"compiler.io.writefile: \0", (byte*)0); }
                    default {};
                };
                ->;
            };



            op_loadlib() -> void
            {
                byte* ext = this.pop_text();
                byte* name;
                void* h;
                int k;
                switch (ext == (byte*)0) { case (true) { ->; } default {}; };
                ext = fvm_dup(ext, fvm_strlen(ext));
                name = this.pop_text();
                switch (name == (byte*)0) { case (true) { ffree(ext); ->; } default {}; };
                name = fvm_dup(name, fvm_strlen(name));
                while (ext[0] == '.') { ext = ext + 1; };
                h = (void*)0;


                this.tmp.clear();
                this.tmp.put_str(name);
                switch (ext[0] != 0) { case (true) { this.tmp.put(46); this.tmp.put_str(ext); } default {}; };
                h = LoadLibraryA(this.tmp.mem);
                switch (h == (void*)0)
                {
                    case (true) {
                        this.fail(g"compiler.idkvm.loadlib: cannot load '\0");
                        this.errb.put_str(this.tmp.mem);
                        this.errb.put(39);
                    }
                    default {};
                };































                ->;
            };


            op_setbp() -> void
            {
                int fi = this.nframes - 1;
                int i, lim, base, sc, top;
                byte* sym;
                byte* tio;
                byte* kb;
                byte* raw2;
                this.err_print(g"\n[COMPTIME BREAKPOINT]\n\0");
                switch (fi >= 0)
                {
                    case (true) {
                        this.tmp.clear();
                        this.tmp.put_str(g"  func : \0");
                        this.tmp.put_str(this.fr_name[fi]);
                        this.tmp.put_str(g"\n  ip   : \0");
                        this.tmp.put_int(this.fr_ip[fi]);
                        this.tmp.put_str(g"\n  locals:\n\0");
                        this.err_print(this.tmp.mem);
                        base = this.fr_base[fi];
                        i = 0;
                        while (i < this.fr_nloc[fi])
                        {
                            switch (this.lc_set[base + i] != 0)
                            {
                                case (true) {
                                    this.tmp.clear();
                                    this.tmp.put_str(g"    [\0");
                                    this.tmp.put_int(i);
                                    this.tmp.put_str(g"] = \0");
                                    this.repr_val(@this.tmp, this.lc_tag[base + i], this.lc_data[base + i], this.lc_meta[base + i]);
                                    this.tmp.put(10);
                                    this.err_print(this.tmp.mem);
                                }
                                default {};
                            };
                            i++;
                        };
                    }
                    default {};
                };
                this.err_print(g"  stack (top first):\n\0");
                i = 0;
                top = this.sp;
                while (i < top & i < 16)
                {
                    sc = top - 1 - i;
                    this.tmp.clear();
                    this.tmp.put_str(g"    [\0");
                    this.tmp.put_int(i);
                    this.tmp.put_str(g"] \0");
                    this.repr_val(@this.tmp, this.st_tag[sc], this.st_data[sc], this.st_meta[sc]);
                    this.tmp.put(10);
                    this.err_print(this.tmp.mem);
                    i++;
                };
                switch (top > 16)
                {
                    case (true) {
                        this.tmp.clear();
                        this.tmp.put_str(g"    ... (\0");
                        this.tmp.put_int(top - 16);
                        this.tmp.put_str(g" more)\n\0");
                        this.err_print(this.tmp.mem);
                    }
                    default {};
                };
                this.err_print(g"Press any key to continue execution ...\0");
                kb = fvm_alloc(8);


                sym = fvm_find_sym(g"_getch\0");
                switch (sym != (byte*)0)
                {
                    case (true) {
                        def{}* gk() -> int = sym;
                        gk();
                    }
                    default {};
                };












































                ffree(kb);
                this.err_print(g"\n\0");
                ->;
            };


            repr_val(FvmBuf* o, int tag, i64 d, i64 m) -> void
            {
                int k;
                o.put_str(g"Val(\0");
                o.put_str(fvm_ttag_name(tag));
                o.put_str(g", \0");
                switch (tag == 4 | tag == 5)
                {
                    case (true) {
                        switch (tag == 4) { case (true) { fvm_float2str(o, fvm_bits_dbl(d)); } default { fvm_dbl2str(o, fvm_bits_dbl(d)); }; };
                    }
                    default
                    {
                        switch (tag == 6)
                        {
                            case (true) {
                                switch (d != (i64)0) { case (true) { o.put_str(g"True\0"); } default { o.put_str(g"False\0"); }; };
                            }
                            default
                            {
                                switch (tag == 15)
                                {
                                    case (true) {
                                        o.put_str(g"b'\0");
                                        k = 0;
                                        while (k < (int)m)
                                        {
                                            o.put((int)fvm_i2p(d)[k]);
                                            k++;
                                        };
                                        o.put(39);
                                    }
                                    default { o.put_i64(d); };
                                };
                            };
                        };
                    };
                };
                o.put(41);
                ->;
            };


            trace_line(int fi, int pc, int op) -> void
            {
                int i, base, first, n;
                bool any;
                this.tmp.clear();
                this.tmp.put_str(g"[VMTRACE] func=\0");
                this.tmp.put_str(this.fr_name[fi]);
                this.tmp.put_str(g" line=\0");
                this.tmp.put_int(this.code.line[pc]);
                this.tmp.put_str(g" op=\0");
                this.tmp.put_str(fvm_op_name(op));
                this.tmp.put_str(g" operands=[\0");
                switch (this.is_zero_op(op))
                {
                    case (true) {}
                    default
                    {
                        switch (this.code.s[pc] != (byte*)0)
                        {
                            case (true) {
                                this.tmp.put(39);
                                this.tmp.put_str(this.code.s[pc]);
                                this.tmp.put(39);
                            }
                            default
                            {
                                switch (op == 0)
                                {
                                    case (true) { this.repr_val(@this.tmp, (int)this.code.a[pc], this.code.b[pc], this.code.c[pc]); }
                                    default
                                    {
                                        this.tmp.put_i64(this.code.a[pc]);
                                        switch (this.code.b[pc] != (i64)0 | this.code.c[pc] != (i64)0)
                                        {
                                            case (true) { this.tmp.put_str(g", \0"); this.tmp.put_i64(this.code.b[pc]); }
                                            default {};
                                        };
                                        switch (this.code.c[pc] != (i64)0)
                                        {
                                            case (true) { this.tmp.put_str(g", \0"); this.tmp.put_i64(this.code.c[pc]); }
                                            default {};
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                this.tmp.put_str(g"] locals=[\0");
                base = this.fr_base[fi];
                any = false;
                i = 0;
                while (i < this.fr_nloc[fi])
                {
                    switch (this.lc_set[base + i] != 0)
                    {
                        case (true) {
                            switch (any) { case (true) { this.tmp.put_str(g", \0"); } default {}; };
                            any = true;
                            this.tmp.put(91);
                            this.tmp.put_int(i);
                            this.tmp.put_str(g"]=\0");
                            this.repr_val(@this.tmp, this.lc_tag[base + i], this.lc_data[base + i], this.lc_meta[base + i]);
                        }
                        default {};
                    };
                    i++;
                };
                this.tmp.put_str(g"] stack=[\0");
                first = this.sp - 4;
                switch (first < 0) { case (true) { first = 0; } default {}; };
                i = first;
                while (i < this.sp)
                {
                    switch (i > first) { case (true) { this.tmp.put_str(g", \0"); } default {}; };
                    this.repr_val(@this.tmp, this.st_tag[i], this.st_data[i], this.st_meta[i]);
                    i++;
                };
                this.tmp.put_str(g"]\0");
                standard::io::console::println(this.tmp.mem);
                ->;
            };




            ser_val(FvmBuf* o, int tag, i64 d, i64 m) -> void
            {
                int k, ch;
                byte* p;
                bool ptr_meta;
                switch (tag == 15)
                {
                    case (true) {
                        o.put_str(g"bytes:\"\0");
                        p = fvm_i2p(d);
                        k = 0;
                        while ((i64)k < m)
                        {
                            ch = (int)p[k];
                            switch (ch)
                            {
                                case (92) { o.put_str(g"\\\\\0"); }
                                case (34) { o.put_str(g"\\\"\0"); }
                                case (10) { o.put_str(g"\\n\0"); }
                                case (13) { o.put_str(g"\\r\0"); }
                                case (9) { o.put_str(g"\\t\0"); }
                                case (0) { o.put_str(g"\\0\0"); }
                                default { o.put(ch); };
                            };
                            k++;
                        };
                        o.put(34);
                        ->;
                    }
                    default {};
                };
                switch (tag == 6)
                {
                    case (true) {
                        switch (d != (i64)0) { case (true) { o.put_str(g"bool:true\0"); } default { o.put_str(g"bool:false\0"); }; };
                        ->;
                    }
                    default {};
                };
                switch (tag == 4 | tag == 5)
                {
                    case (true) {
                        o.put_str(fvm_ttag_name(tag));
                        o.put(58);
                        fvm_put_double(o, fvm_bits_dbl(d));
                        ->;
                    }
                    default {};
                };
                switch (tag == 11) { case (true) { o.put_str(g"void:0\0"); ->; } default {}; };

                ptr_meta = tag == 10 & (m == (i64)1 | (m >= (i64)256 & m - (i64)256 < (i64)this.tn_n));
                switch (ptr_meta)
                {
                    case (true) {
                        o.put_str(g"ptr:\0");
                        o.put_i64(d);
                        o.put(91);
                        switch (m == (i64)1)
                        {
                            case (true) { o.put_str(g"stack_slot\0"); }
                            default {
                                o.put_str(g"struct_type=\0");
                                o.put_str(this.tn_name[(int)(m - (i64)256)]);
                            };
                        };
                        o.put(93);
                        ->;
                    }
                    default {};
                };

                switch (m == (i64)1869635953 & (tag == 9 | tag == 12 | tag == 13 | tag == 14 | tag == 16 | tag == 17 | tag == 18))
                {
                    case (true) {
                        o.put_str(fvm_ttag_name(tag));
                        o.put(58);
                        o.put_str(fvm_i2p(d));
                        ->;
                    }
                    default {};
                };
                o.put_str(fvm_ttag_name(tag));
                o.put(58);
                o.put_i64(d);
                ->;
            };



            ser_instr(FvmBuf* o, int pc, int boff) -> void
            {
                int op = this.code.ops[pc];
                i64 a = this.code.a[pc];
                i64 b = this.code.b[pc];
                i64 c = this.code.c[pc];
                byte* s = this.code.s[pc];
                int k;
                o.put_str(fvm_op_name(op));
                switch (op)
                {
                    case (54) { o.put(32); o.put_str(s); }
                    case (55) { o.put(32); o.put_str(s); }
                    case (101)
                    {
                        o.put(32);
                        o.put_str(s);
                        o.put(32);
                        this.ser_upper(o, fvm_ttag_name((int)a));
                        k = 0;
                        while ((i64)k < b)
                        {
                            o.put(32);
                            this.ser_upper(o, fvm_ttag_name((int)(((i64*)fvm_i2p(c))[k])));
                            k++;
                        };
                    }
                    case (0) { o.put(32); this.ser_val(o, (int)a, b, c); }
                    case (43) { o.put(32); o.put_i64(a); }
                    case (38) { o.put(32); o.put_i64(a + (i64)boff); }
                    case (39) { o.put(32); o.put_i64(a + (i64)boff); }
                    case (40) { o.put(32); o.put_i64(a + (i64)boff); }
                    case (41)
                    {
                        o.put(32);
                        o.put_i64(a + (i64)boff);
                        o.put(32);
                        k = 0;
                        while ((i64)k < b)
                        {
                            switch (k > 0) { case (true) { o.put(32); } default {}; };
                            o.put_i64(((i64*)s)[k] + (i64)boff);
                            k++;
                        };
                    }
                    case (42) { o.put(32); o.put_str(s); o.put(32); o.put_i64(a); }
                    case (45) { o.put(32); o.put_i64(a); }
                    case (50) { o.put(32); o.put_i64(a); }
                    case (51) { o.put(32); o.put_i64(a); }
                    case (23) { o.put(32); o.put_i64(a); }
                    case (24) { o.put(32); o.put_i64(a); }
                    case (25) { o.put(32); o.put_i64(a); }
                    case (27) { o.put(32); o.put_i64(a); }
                    case (28) { o.put(32); o.put_i64(a); }
                    case (71) { o.put(32); o.put_str(s); }
                    case (73) { o.put(32); o.put_str(s); }
                    case (74) { o.put(32); o.put_str(s); }
                    case (61) { o.put(32); o.put_str(s); }
                    case (62) { o.put(32); o.put_str(s); }
                    case (63) { o.put(32); o.put_str(s); }
                    case (64) { o.put(32); o.put_str(s); }
                    case (67) { o.put(32); o.put_str(s); o.put(32); o.put_i64(a); }
                    case (58) { o.put(32); o.put_str(fvm_ttag_name((int)a)); o.put(32); o.put_i64(b); }
                    case (59) { o.put(32); o.put_str(fvm_ttag_name((int)a)); o.put(32); o.put_i64(b); }
                    case (109)
                    {
                        o.put(32);
                        o.put_str(fvm_ttag_name((int)a));
                        switch (s != (byte*)0) { case (true) { o.put(32); o.put_str(s); } default {}; };
                    }
                    case (110)
                    {
                        o.put(32);
                        o.put_str(fvm_ttag_name((int)a));
                        switch (s != (byte*)0) { case (true) { o.put(32); o.put_str(s); } default {}; };
                    }
                    case (115) { o.put(32); o.put_i64(a); }
                    case (79) { o.put(32); o.put_str(s); }
                    case (80) { o.put(32); o.put_str(s); }
                    case (81) { o.put(32); o.put_i64(a); o.put(32); o.put_str(fvm_ttag_name((int)b)); }
                    case (117) { fvm_put_emitideka(o, s, (FvmVars*)fvm_i2p(c)); }
                    default {};
                };
                ->;
            };


            ser_upper(FvmBuf* o, byte* nm) -> void
            {
                int k = 0;
                int ch;
                while (nm[k] != 0)
                {
                    ch = (int)nm[k];
                    switch (ch >= 97 & ch <= 122) { case (true) { ch = ch - 32; } default {}; };
                    o.put(ch);
                    k++;
                };
                ->;
            };


            log_block(int unit) -> void
            {
                int* nl;
                switch (this.log_n >= this.log_cap)
                {
                    case (true) {
                        nl = (int*)fvm_grow((byte*)this.log_unit, this.log_cap * 2 * 4);
                        switch (nl == (int*)0) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                        this.log_unit = nl;
                        this.log_cap = this.log_cap * 2;
                    }
                    default {};
                };
                this.log_unit[this.log_n] = unit;
                this.log_n++;
                ->;
            };


            ser_ends_halt(FvmBuf* o) -> bool
            {
                int e = o.len;
                int st;
                while (e > 0 & (o.mem[e - 1] == 10 | o.mem[e - 1] == 32)) { e--; };
                st = e;
                while (st > 0 & o.mem[st - 1] != 10) { st--; };
                while (st < e & o.mem[st] == 32) { st++; };
                -> e - st == 4 & fvm_eq_n(o.mem + st, 4, g"HALT\0");
            };


            ser_item(FvmBuf* o, int pc, int boff) -> void
            {
                switch (this.ser_bin)
                {
                    case (true) { this.bin_instr(o, pc, boff); }
                    default
                    {
                        this.ser_instr(o, pc, boff);
                        o.put(10);
                    };
                };
                this.ser_n++;
                this.ser_last = this.code.ops[pc];
                ->;
            };


            ser_structs(FvmBuf* o) -> void
            {
                int i, k, f;
                i = 0;
                while (i < this.layouts.n)
                {
                    o.put_str(g"struct \0");
                    o.put_str(this.layouts.sname[i]);
                    o.put(32);
                    o.put_str(this.layouts.sendian[i]);
                    o.put(32);
                    o.put_int(this.layouts.ssize[i]);
                    o.put(32);
                    o.put_int(this.layouts.sbits[i]);
                    o.put(10);
                    k = 0;
                    while (k < this.layouts.scount[i])
                    {
                        f = this.layouts.sfirst[i] + k;
                        o.put_str(g"    field \0");
                        o.put_str(this.layouts.fname[f]);
                        o.put(32);
                        o.put_str(fvm_ttag_name(this.layouts.ftag[f]));
                        o.put(32);
                        o.put_int(this.layouts.foff[f]);
                        o.put(32);
                        o.put_int(this.layouts.fsize[f]);
                        o.put(10);
                        k++;
                    };
                    o.put_str(g"endstruct\n\n\0");
                    i++;
                };
                ->;
            };


            ser_funcs(FvmBuf* o) -> void
            {
                int i, k, fu, st, ln;
                i = 0;
                while (i < this.funcs.n)
                {
                    fu = this.funcs.units[i];
                    st = this.code.ustart[fu];
                    ln = this.code.ulen[fu];
                    switch (this.ser_bin)
                    {
                        case (true) {
                            this.bin_str(o, this.funcs.names[i], fvm_strlen(this.funcs.names[i]));
                            o.put_u32(ln);
                        }
                        default {
                            o.put_str(g"func \0");
                            o.put_str(this.funcs.names[i]);
                            o.put(10);
                        };
                    };
                    k = 0;
                    while (k < ln)
                    {
                        switch (this.ser_bin) { case (true) {} default { o.put_str(g"    \0"); }; };
                        this.ser_item(o, st + k, 0);
                        k++;
                    };
                    switch (this.ser_bin) { case (true) {} default { o.put_str(g"endfunc\n\n\0"); }; };
                    i++;
                };
                ->;
            };



            ser_main(FvmBuf* o) -> void
            {
                int i, k, pc, st, ln, off, woff, lim, u0;
                off = 0;
                woff = 0;
                i = 0;
                while (i < this.log_n)
                {
                    u0 = this.log_unit[i];
                    st = this.code.ustart[u0];
                    ln = this.code.ulen[u0];
                    k = 0;
                    while (k < ln)
                    {
                        pc = st + k;
                        switch (this.code.ops[pc] != 46)
                        {
                            case (true) {
                                this.ser_item(o, pc, off);
                                woff++;
                            }
                            default {};
                        };
                        k++;
                    };
                    off = woff;
                    i++;
                };

                switch (this.nframes > 0)
                {
                    case (true) {
                        u0 = this.fr_unit[0];
                        st = this.code.ustart[u0];
                        ln = this.code.ulen[u0];
                        lim = this.fr_ip[0] - 2;
                        switch (lim < 0) { case (true) { lim = ln + lim; } default {}; };
                        switch (lim < 0) { case (true) { lim = 0; } default {}; };
                        switch (lim > ln) { case (true) { lim = ln; } default {}; };
                        k = 0;
                        while (k < lim)
                        {
                            pc = st + k;
                            switch (this.code.ops[pc] != 46)
                            {
                                case (true) { this.ser_item(o, pc, off); }
                                default {};
                            };
                            k++;
                        };
                    }
                    default {};
                };
                ->;
            };



            ser_all(FvmBuf* o) -> void
            {
                o.put_str(g"# Generated by compiler.idkvm.dump\n\n\0");
                this.ser_bin = false;
                this.ser_structs(o);
                this.ser_funcs(o);
                switch (this.log_locals > 0)
                {
                    case (true) {
                        o.put_str(g"locals \0");
                        o.put_int(this.log_locals);
                        o.put(10);
                    }
                    default {};
                };
                this.ser_main(o);
                switch (!this.ser_ends_halt(o)) { case (true) { o.put_str(g"HALT\n\0"); } default {}; };
                ->;
            };




            bin_val(FvmBuf* o, int tag, i64 d, i64 m) -> void
            {
                int flags;
                o.put(tag);
                switch (tag == 15)
                {
                    case (true) { this.bin_str(o, fvm_i2p(d), (int)m); ->; }
                    default {};
                };
                switch (tag == 6)
                {
                    case (true) {
                        switch (d != (i64)0) { case (true) { o.put(1); } default { o.put(0); }; };
                        ->;
                    }
                    default {};
                };
                switch (tag == 11) { case (true) { ->; } default {}; };

                switch (tag == 9 | tag == 12 | tag == 13 | tag == 14 | tag == 16 | tag == 17 | tag == 18)
                {
                    case (true) {
                        this.tmp.clear();
                        this.tmp.put_i64(d);
                        this.bin_str(o, this.tmp.mem, this.tmp.len);
                        ->;
                    }
                    default {};
                };

                switch (tag == 4 | tag == 5)
                {
                    case (true) { o.put_le64(d); ->; }
                    default {};
                };
                switch (tag == 3)
                {
                    case (true) { o.put_uv((u64)d); ->; }
                    default {};
                };
                o.put_iv(d);
                switch (tag != 10) { case (true) { ->; } default {}; };
                flags = 0;
                switch (m == (i64)1) { case (true) { flags = 1; } default {}; };
                switch (m >= (i64)256 & m - (i64)256 < (i64)this.tn_n) { case (true) { flags = 2; } default {}; };
                o.put(flags);
                switch (flags == 2)
                {
                    case (true) {
                        this.bin_str(o, this.tn_name[(int)(m - (i64)256)], fvm_strlen(this.tn_name[(int)(m - (i64)256)]));
                    }
                    default {};
                };
                ->;
            };


            bin_instr(FvmBuf* o, int pc, int boff) -> void
            {
                int op = this.code.ops[pc];
                i64 a = this.code.a[pc];
                i64 b = this.code.b[pc];
                i64 c = this.code.c[pc];
                byte* s = this.code.s[pc];
                int k;
                o.put(op);
                switch (fvm_bin_shape(op))
                {
                    case (1)
                    {
                        switch (op == 38 | op == 39 | op == 40) { case (true) { a = a + (i64)boff; } default {}; };
                        o.put_iv(a);
                    }
                    case (2) { this.bin_str(o, s, fvm_strlen(s)); }
                    case (3) { this.bin_str(o, s, fvm_strlen(s)); o.put_iv(a); }
                    case (4) { o.put((int)a); o.put_iv(b); }
                    case (5)
                    {
                        o.put((int)a);
                        switch (s != (byte*)0)
                        {
                            case (true) { o.put(1); this.bin_str(o, s, fvm_strlen(s)); }
                            default { o.put(0); };
                        };
                    }
                    case (6) { o.put_iv(a); o.put((int)b); }
                    case (7)
                    {
                        this.bin_str(o, s, fvm_strlen(s));
                        o.put((int)a);
                        o.put_u32((int)b);
                        k = 0;
                        while ((i64)k < b)
                        {
                            o.put((int)(((i64*)fvm_i2p(c))[k]));
                            k++;
                        };
                    }
                    case (8)
                    {
                        o.put_iv(a + (i64)boff);
                        o.put_u32((int)b);
                        k = 0;
                        while ((i64)k < b)
                        {
                            o.put_iv(((i64*)s)[k] + (i64)boff);
                            k++;
                        };
                    }
                    case (9) { this.bin_val(o, (int)a, b, c); }
                    case (10)
                    {


                        o.put_u32(0);
                        o.put_u32(0);
                        o.put_iv((i64)0);
                        o.put_iv((i64)0);
                        o.put_u32(0);
                    }
                    case (11)
                    {

                        this.bin_str(o, s, fvm_strlen(s));
                        o.put_u32((int)a);
                        k = 0;
                        while ((i64)k < a)
                        {
                            this.bin_str(o, ((FvmVars*)fvm_i2p(c)).names[k], fvm_strlen(((FvmVars*)fvm_i2p(c)).names[k]));
                            o.put_iv((i64)((FvmVars*)fvm_i2p(c)).slots[k]);
                            k++;
                        };
                    }
                    default {};
                };
                ->;
            };


            bin_structs(FvmBuf* o) -> void
            {
                int i, k, f;
                o.put_u32(this.layouts.n);
                i = 0;
                while (i < this.layouts.n)
                {
                    this.bin_str(o, this.layouts.sname[i], fvm_strlen(this.layouts.sname[i]));
                    this.bin_str(o, this.layouts.sendian[i], fvm_strlen(this.layouts.sendian[i]));
                    o.put_u32(this.layouts.ssize[i]);
                    o.put_u32(this.layouts.sbits[i]);
                    o.put_u32(this.layouts.scount[i]);
                    k = 0;
                    while (k < this.layouts.scount[i])
                    {
                        f = this.layouts.sfirst[i] + k;
                        this.bin_str(o, this.layouts.fname[f], fvm_strlen(this.layouts.fname[f]));
                        o.put(this.layouts.ftag[f]);
                        o.put_u32(this.layouts.foff[f]);
                        o.put_u32(this.layouts.fsize[f]);
                        k++;
                    };
                    i++;
                };
                ->;
            };




            bin_str(FvmBuf* o, byte* s, int n) -> void
            {
                int i, k;
                bool same;
                byte** ns;
                int* nl;
                i = 0;
                while (i < this.bt_n)
                {
                    same = this.bt_l[i] == n;
                    k = 0;
                    while (same & k < n)
                    {
                        same = this.bt_s[i][k] == s[k];
                        k++;
                    };
                    switch (same) { case (true) { o.put_u32(i); ->; } default {}; };
                    i++;
                };
                switch (this.bt_n >= this.bt_cap)
                {
                    case (true) {
                        ns = (byte**)fvm_grow((byte*)this.bt_s, this.bt_cap * 2 * 8);
                        nl = (int*)fvm_grow((byte*)this.bt_l, this.bt_cap * 2 * 4);
                        switch (ns == (byte**)0 | nl == (int*)0) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                        this.bt_s = ns;
                        this.bt_l = nl;
                        this.bt_cap = this.bt_cap * 2;
                    }
                    default {};
                };
                this.bt_s[this.bt_n] = fvm_dup(s, n);
                this.bt_l[this.bt_n] = n;
                o.put_u32(this.bt_n);
                this.bt_n++;
                ->;
            };


            bin_begin() -> bool
            {
                this.bt_cap = 64;
                this.bt_n = 0;
                this.bt_s = (byte**)fvm_alloc(this.bt_cap * 8);
                this.bt_l = (int*)fvm_alloc(this.bt_cap * 4);
                switch (this.bt_s == (byte**)0 | this.bt_l == (int*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                this.ser_bin = true;
                -> true;
            };



            bin_pack(FvmBuf* o, FvmBuf* body) -> void
            {
                FvmBuf raw;
                FvmBuf comp;
                int i;
                bool packed;
                raw.__init();
                comp.__init();
                raw.put_u32(this.bt_n);
                i = 0;
                while (i < this.bt_n)
                {
                    switch (this.str_out != (FvmBuf*)0) { case (true) { fvm_put_esc_line(this.str_out, this.bt_s[i], this.bt_l[i]); } default {}; };
                    raw.put_u32(this.bt_l[i]);
                    raw.put_n(this.bt_s[i], this.bt_l[i]);
                    ffree(this.bt_s[i]);
                    i++;
                };
                raw.put_n(body.mem, body.len);
                packed = fvm_lz_compress(raw.mem, raw.len, @comp) & (comp.len < raw.len);
                o.put_n(g"IDKB\0", 4);
                o.put(2);
                switch (packed) { case (true) { o.put(1); } default { o.put(0); }; };
                o.put_u32(raw.len);
                switch (packed)
                {
                    case (true) { o.put_n(comp.mem, comp.len); }
                    default { o.put_n(raw.mem, raw.len); };
                };
                ffree((byte*)this.bt_s);
                ffree((byte*)this.bt_l);
                this.bt_s = (byte**)0;
                this.bt_l = (int*)0;
                this.bt_n = 0;
                raw.__exit();
                comp.__exit();
                this.ser_bin = false;
                ->;
            };

            bin_all(FvmBuf* o) -> void
            {
                FvmBuf body;
                FvmBuf mb;
                body.__init();
                mb.__init();
                switch (!this.bin_begin()) { case (true) { ->; } default {}; };
                this.bin_structs(@body);
                body.put_u32(this.funcs.n);
                this.ser_funcs(@body);
                this.ser_n = 0;
                this.ser_last = -1;
                this.ser_main(@mb);
                switch (this.ser_last != 46)
                {
                    case (true) {
                        mb.put(46);
                        this.ser_n++;
                    }
                    default {};
                };
                body.put_u32(this.log_locals);
                body.put_u32(this.ser_n);
                body.put_n(mb.mem, mb.len);
                this.bin_pack(o, @body);
                body.__exit();
                mb.__exit();
                ->;
            };


            dump_file(bool bin) -> void
            {
                byte* path = this.pop_text();
                FvmBuf o;
                void* fh;
                int k, n;
                byte* who;
                switch (path == (byte*)0) { case (true) { ->; } default {}; };
                path = fvm_dup(path, fvm_strlen(path));
                k = 0;
                while (path[k] != 0)
                {
                    switch (path[k] == 92) { case (true) { path[k] = (byte)47; } default {}; };
                    k++;
                };
                o.__init();
                who = g"compiler.idkvm.dump: \0";
                switch (bin)
                {
                    case (true) {
                        who = g"compiler.idkvm.bindump: \0";
                        this.bin_all(@o);
                        fh = fopen(path, g"wb\0");
                    }
                    default {
                        this.ser_all(@o);
                        fh = fopen(path, g"w\0");
                    };
                };
                switch (fh == (void*)0)
                {
                    case (true) { this.errno_fail(who, path); }
                    default
                    {
                        n = fwrite(o.mem, 1, o.len, fh);
                        fclose(fh);
                        switch (n != o.len) { case (true) { this.errno_fail(who, (byte*)0); } default {}; };
                    };
                };
                o.__exit();
                ffree(path);
                ->;
            };

            op_dump() -> void
            {
                this.dump_file(false);
                ->;
            };

            op_bindump() -> void
            {
                this.dump_file(true);
                ->;
            };



            bin_fail(byte* msg) -> void
            {
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(g".idkb: \0");
                        this.errb.put_str(msg);
                        this.failed = true;
                    }
                    default {};
                };
                ->;
            };

            bin_fail_n(byte* msg, int n) -> void
            {
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(g".idkb: \0");
                        this.errb.put_str(msg);
                        this.errb.put_int(n);
                        this.failed = true;
                    }
                    default {};
                };
                ->;
            };


            rd_need(int n) -> bool
            {
                switch (this.failed) { case (true) { -> false; } default {}; };
                switch (n < 0 | this.bp + n > this.bl)
                {
                    case (true) {
                        this.bin_fail(g"unexpected end of file\0");
                        -> false;
                    }
                    default {};
                };
                -> true;
            };

            rd_u8() -> int
            {
                int v;
                switch (!this.rd_need(1)) { case (true) { -> 0; } default {}; };
                v = (int)this.bd[this.bp];
                this.bp++;
                -> v;
            };


            rd_uv() -> u64
            {
                u64 v;
                int shift = 0;
                int b;
                while (true)
                {
                    b = this.rd_u8();
                    switch (this.failed) { case (true) { -> (u64)0; } default {}; };
                    v = v `| (((u64)(b `& 127)) << shift);
                    switch ((b `& 128) == 0) { case (true) { -> v; } default {}; };
                    shift = shift + 7;
                    switch (shift > 63) { case (true) { this.bin_fail(g"damaged data\0"); -> (u64)0; } default {}; };
                };
                -> v;
            };


            rd_u32() -> int
            {
                u64 v = this.rd_uv();
                switch (v > (u64)2147483647)
                {
                    case (true) {
                        this.bin_fail(g"damaged data\0");
                        -> 0;
                    }
                    default {};
                };
                -> (int)v;
            };


            rd_i64() -> i64
            {
                u64 u = this.rd_uv();
                i64 v = (i64)(u >> 1);
                switch ((u `& (u64)1) != (u64)0) { case (true) { v = (i64)0 - v - (i64)1; } default {}; };
                -> v;
            };


            rd_raw64() -> i64
            {
                i64 v;
                int k = 7;
                switch (!this.rd_need(8)) { case (true) { -> (i64)0; } default {}; };
                while (k >= 0)
                {
                    v = (v << (i64)8) `| (i64)this.bd[this.bp + k];
                    k--;
                };
                this.bp = this.bp + 8;
                -> v;
            };


            rd_count() -> int
            {
                int n = this.rd_u32();
                switch (n < 0 | n > this.bl - this.bp)
                {
                    case (true) {
                        this.bin_fail(g"unexpected end of file\0");
                        -> 0;
                    }
                    default {};
                };
                -> n;
            };



            rd_blob(int* n) -> byte*
            {
                int idx = this.rd_u32();
                byte* r;
                switch (this.failed) { case (true) { -> (byte*)0; } default {}; };
                switch (idx >= this.rt_n)
                {
                    case (true) {
                        this.bin_fail(g"damaged data\0");
                        -> (byte*)0;
                    }
                    default {};
                };
                r = fvm_dup(this.rt_s[idx], this.rt_l[idx]);
                switch (r == (byte*)0)
                {
                    case (true) {
                        this.fail(g"allocation failed\0");
                        this.failed = true;
                        -> (byte*)0;
                    }
                    default {};
                };
                switch (n != (int*)0) { case (true) { *n = this.rt_l[idx]; } default {}; };
                -> r;
            };

            rd_skip_blob() -> void
            {
                int idx = this.rd_u32();
                switch (!this.failed & idx >= this.rt_n) { case (true) { this.bin_fail(g"damaged data\0"); } default {}; };
                ->;
            };

            rd_ttag() -> int
            {
                int t = this.rd_u8();
                switch (!this.failed & t > 18)
                {
                    case (true) {
                        this.bin_fail_n(g"unknown type tag \0", t);
                        -> 0;
                    }
                    default {};
                };
                -> t;
            };


            is_opaque(int tg) -> bool
            {
                -> tg == 9 | tg == 12 | tg == 13 | tg == 14 | tg == 16 | tg == 17 | tg == 18;
            };


            bin_opaque(int tg) -> bool
            {
                switch (this.is_opaque(tg))
                {
                    case (true) {
                        switch (!this.failed)
                        {
                            case (true) {
                                this.errb.clear();
                                this.errb.put_str(g".idkb: unknown type tag '\0");
                                this.errb.put_str(fvm_ttag_name(tg));
                                this.errb.put(39);
                                this.failed = true;
                            }
                            default {};
                        };
                        -> true;
                    }
                    default {};
                };
                -> false;
            };


            rd_val() -> void
            {
                int tg, flags, n;
                byte* nm;
                tg = this.rd_ttag();
                this.pt = tg;
                this.pd = (i64)0;
                this.pm = (i64)0;
                switch (this.failed) { case (true) { ->; } default {}; };
                switch (this.bin_lenient & this.is_opaque(tg))
                {
                    case (true) {
                        nm = this.rd_blob((int*)0);
                        this.pd = fvm_p2i(nm);
                        this.pm = (i64)1869635953;
                        ->;
                    }
                    default {};
                };
                switch (this.bin_opaque(tg)) { case (true) { ->; } default {}; };
                switch (tg == 15)
                {
                    case (true) {
                        nm = this.rd_blob(@n);
                        this.pd = fvm_p2i(nm);
                        this.pm = (i64)n;
                        ->;
                    }
                    default {};
                };
                switch (tg == 6)
                {
                    case (true) {
                        switch (this.rd_u8() != 0) { case (true) { this.pd = (i64)1; } default {}; };
                        ->;
                    }
                    default {};
                };
                switch (tg == 11) { case (true) { ->; } default {}; };
                switch (tg == 4 | tg == 5)
                {
                    case (true) { this.pd = this.rd_raw64(); ->; }
                    default {};
                };
                switch (tg == 3)
                {
                    case (true) { this.pd = (i64)this.rd_uv(); ->; }
                    default {};
                };
                this.pd = this.rd_i64();
                switch (tg != 10) { case (true) { ->; } default {}; };
                flags = this.rd_u8();
                switch ((flags `& 1) != 0) { case (true) { this.pm = (i64)1; } default {}; };
                switch ((flags `& 2) != 0)
                {
                    case (true) {
                        nm = this.rd_blob((int*)0);
                        switch (nm != (byte*)0)
                        {
                            case (true) {
                                this.pm = this.tn_intern(nm);
                                ffree(nm);
                            }
                            default {};
                        };
                    }
                    default {};
                };

                switch ((flags `& 4) != 0)
                {
                    case (true) {
                        n = this.rd_count();
                        while (n > 0 & !this.failed) { this.rd_skip_blob(); this.rd_i64(); n--; };
                        this.stub_note(g".idkb PTR meta (field offsets, fields, elements)\0");
                    }
                    default {};
                };
                switch ((flags `& 8) != 0)
                {
                    case (true) {
                        n = this.rd_count();
                        while (n > 0 & !this.failed) { this.rd_skip_blob(); this.rd_skip_val(); n--; };
                        this.stub_note(g".idkb PTR meta (field offsets, fields, elements)\0");
                    }
                    default {};
                };
                switch ((flags `& 16) != 0)
                {
                    case (true) {
                        this.rd_skip_blob();
                        this.rd_i64();
                        n = this.rd_count();
                        while (n > 0 & !this.failed) { this.rd_skip_val(); n--; };
                        this.stub_note(g".idkb PTR meta (field offsets, fields, elements)\0");
                    }
                    default {};
                };
                ->;
            };


            rd_skip_val() -> void
            {
                int tg, flags, n;
                tg = this.rd_ttag();
                switch (this.failed) { case (true) { ->; } default {}; };
                switch (this.bin_lenient & this.is_opaque(tg)) { case (true) { this.rd_skip_blob(); ->; } default {}; };
                switch (this.bin_opaque(tg)) { case (true) { ->; } default {}; };
                switch (tg == 15) { case (true) { this.rd_skip_blob(); ->; } default {}; };
                switch (tg == 6) { case (true) { this.rd_u8(); ->; } default {}; };
                switch (tg == 11) { case (true) { ->; } default {}; };
                switch (tg == 4 | tg == 5) { case (true) { this.rd_raw64(); } default { this.rd_uv(); }; };
                switch (tg != 10) { case (true) { ->; } default {}; };
                flags = this.rd_u8();
                switch ((flags `& 2) != 0) { case (true) { this.rd_skip_blob(); } default {}; };
                switch ((flags `& 4) != 0)
                {
                    case (true) {
                        n = this.rd_count();
                        while (n > 0 & !this.failed) { this.rd_skip_blob(); this.rd_i64(); n--; };
                    }
                    default {};
                };
                switch ((flags `& 8) != 0)
                {
                    case (true) {
                        n = this.rd_count();
                        while (n > 0 & !this.failed) { this.rd_skip_blob(); this.rd_skip_val(); n--; };
                    }
                    default {};
                };
                switch ((flags `& 16) != 0)
                {
                    case (true) {
                        this.rd_skip_blob();
                        this.rd_i64();
                        n = this.rd_count();
                        while (n > 0 & !this.failed) { this.rd_skip_val(); n--; };
                    }
                    default {};
                };
                ->;
            };


            rd_instr() -> void
            {
                int op, t, k, n;
                i64 a, b;
                byte* s1;
                byte* s2;
                i64* tbl;
                FvmVars* evars;
                op = this.rd_u8();
                switch (this.failed) { case (true) { ->; } default {}; };
                switch (op >= 120)
                {
                    case (true) { this.bin_fail_n(g"unknown opcode \0", op); ->; }
                    default {};
                };
                switch (fvm_bin_shape(op))
                {
                    case (1)
                    {
                        a = this.rd_i64();
                        this.code.add(op, a, (i64)0, (i64)0, (byte*)0, 0);
                    }
                    case (2)
                    {
                        s1 = this.rd_blob((int*)0);
                        this.code.add(op, (i64)0, (i64)0, (i64)0, s1, 0);
                    }
                    case (3)
                    {
                        s1 = this.rd_blob((int*)0);
                        a = this.rd_i64();
                        this.code.add(op, a, (i64)0, (i64)0, s1, 0);
                    }
                    case (4)
                    {
                        t = this.rd_ttag();
                        b = this.rd_i64();
                        this.code.add(op, (i64)t, b, (i64)0, (byte*)0, 0);
                    }
                    case (5)
                    {
                        t = this.rd_ttag();
                        s1 = (byte*)0;
                        switch (this.rd_u8() != 0) { case (true) { s1 = this.rd_blob((int*)0); } default {}; };
                        this.code.add(op, (i64)t, (i64)0, (i64)0, s1, 0);
                    }
                    case (6)
                    {
                        a = this.rd_i64();
                        t = this.rd_ttag();
                        this.code.add(op, a, (i64)t, (i64)0, (byte*)0, 0);
                    }
                    case (7)
                    {
                        s1 = this.rd_blob((int*)0);
                        t = this.rd_ttag();
                        n = this.rd_count();
                        tbl = (i64*)fvm_alloc((n + 1) * 8);
                        switch (tbl == (i64*)0) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                        k = 0;
                        while (k < n & !this.failed)
                        {
                            tbl[k] = (i64)this.rd_ttag();
                            k++;
                        };
                        this.code.add(op, (i64)t, (i64)n, fvm_p2i((byte*)tbl), s1, 0);
                    }
                    case (8)
                    {
                        a = this.rd_i64();
                        n = this.rd_count();
                        tbl = (i64*)fvm_alloc((n + 1) * 8);
                        switch (tbl == (i64*)0) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                        k = 0;
                        while (k < n & !this.failed)
                        {
                            tbl[k] = this.rd_i64();
                            k++;
                        };
                        this.code.add(op, a, (i64)n, (i64)0, (byte*)tbl, 0);
                    }
                    case (9)
                    {
                        this.rd_val();
                        this.code.add(op, (i64)this.pt, this.pd, this.pm, (byte*)0, 0);
                    }
                    case (10)
                    {


                        this.rd_skip_blob();
                        this.rd_skip_blob();
                        this.rd_i64();
                        this.rd_i64();
                        n = this.rd_count();
                        while (n > 0 & !this.failed) { this.rd_skip_blob(); n--; };
                        this.code.add(op, (i64)0, (i64)0, (i64)0, (byte*)0, 0);
                    }
                    case (11)
                    {
                        s2 = this.rd_blob((int*)0);
                        n = this.rd_count();
                        evars = fvm_vars_new(n);
                        switch (evars == (FvmVars*)0) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                        k = 0;
                        while (k < n & !this.failed)
                        {
                            evars.names[k] = this.rd_blob((int*)0);
                            evars.slots[k] = (int)this.rd_i64();
                            k++;
                        };
                        this.code.add(op, (i64)n, (i64)0, fvm_p2i((byte*)evars), s2, 0);
                    }
                    default { this.code.add(op, (i64)0, (i64)0, (i64)0, (byte*)0, 0); };
                };
                ->;
            };



            decompile(FvmBuf* o) -> void
            {
                int k, st, ln;
                o.put_str(g"# Generated by compiler.idkvm.dump\n\n\0");
                this.ser_bin = false;
                this.ser_structs(o);
                this.ser_funcs(o);
                switch (this.main_locals > 0)
                {
                    case (true) {
                        o.put_str(g"locals \0");
                        o.put_int(this.main_locals);
                        o.put(10);
                    }
                    default {};
                };
                st = this.code.ustart[this.main_unit];
                ln = this.code.ulen[this.main_unit];
                k = 0;
                while (k < ln)
                {
                    this.ser_item(o, st + k, 0);
                    k++;
                };
                switch (!this.ser_ends_halt(o)) { case (true) { o.put_str(g"HALT\n\0"); } default {}; };
                ->;
            };



            compile_loaded(FvmBuf* o) -> void
            {
                int k, st, ln, n;
                bool need_halt;
                FvmBuf body;
                body.__init();
                switch (!this.bin_begin()) { case (true) { ->; } default {}; };
                this.bin_structs(@body);
                body.put_u32(this.funcs.n);
                this.ser_funcs(@body);
                st = this.code.ustart[this.main_unit];
                ln = this.code.ulen[this.main_unit];
                need_halt = ln == 0;
                switch (ln > 0) { case (true) { need_halt = this.code.ops[st + ln - 1] != 46; } default {}; };
                n = ln;
                switch (need_halt) { case (true) { n++; } default {}; };
                body.put_u32(this.main_locals);
                body.put_u32(n);
                k = 0;
                while (k < ln)
                {
                    this.ser_item(@body, st + k, 0);
                    k++;
                };
                switch (need_halt) { case (true) { body.put(46); } default {}; };
                this.bin_pack(o, @body);
                body.__exit();
                ->;
            };




            strings_file(byte* image, int len, FvmBuf* o) -> bool
            {
                bool ok;
                FvmBuf scratch;
                scratch.__init();
                this.str_out = o;
                switch (fvm_is_bin_image(image, len))
                {
                    case (true) {
                        this.bin_lenient = true;
                        ok = this.load_bin(image, len);
                        this.bin_lenient = false;
                    }
                    default
                    {
                        ok = this.load_fvm(image, len);
                        switch (ok) { case (true) { this.compile_loaded(@scratch); } default {}; };
                    };
                };
                this.str_out = (FvmBuf*)0;
                scratch.__exit();
                -> ok;
            };



            inspect_file(byte* image, int len, FvmBuf* o) -> bool
            {
                bool ok;
                bool bin = fvm_is_bin_image(image, len);
                int i, fu, total;
                switch (bin)
                {
                    case (true) {
                        this.bin_lenient = true;
                        ok = this.load_bin(image, len);
                        this.bin_lenient = false;
                    }
                    default { ok = this.load_fvm(image, len); };
                };
                switch (!ok) { case (true) { -> false; } default {}; };
                switch (bin)
                {
                    case (true) {
                        o.put_str(g"format: IDKB version \0");
                        o.put_int((int)image[4]);
                        switch ((this.ib_flags `& 1) != 0)
                        {
                            case (true) { o.put_str(g" (compressed)\n\0"); }
                            default { o.put_str(g" (stored)\n\0"); };
                        };
                        o.put_str(g"size: \0");
                        fvm_put_pl(o, len, g"byte\0");
                        o.put(10);
                        o.put_str(g"payload: \0");
                        fvm_put_pl(o, this.ib_raw, g"byte\0");
                        o.put(10);
                        o.put_str(g"strings: \0");
                        o.put_int(this.ib_nstr);
                        o.put(10);
                    }
                    default
                    {
                        o.put_str(g"format: IDKVM text\nsize: \0");
                        fvm_put_pl(o, len, g"byte\0");
                        o.put(10);
                    };
                };
                o.put_str(g"structs: \0");
                o.put_int(this.layouts.n);
                o.put(10);
                i = 0;
                while (i < this.layouts.n)
                {
                    o.put_str(g"  \0");
                    o.put_str(this.layouts.sname[i]);
                    o.put_str(g"  size \0");
                    fvm_put_pl(o, this.layouts.ssize[i], g"byte\0");
                    o.put_str(g", \0");
                    fvm_put_pl(o, this.layouts.sbits[i], g"bit\0");
                    o.put_str(g", \0");
                    fvm_put_pl(o, this.layouts.scount[i], g"field\0");
                    o.put(10);
                    i++;
                };
                o.put_str(g"functions: \0");
                o.put_int(this.funcs.n);
                o.put(10);
                i = 0;
                while (i < this.funcs.n)
                {
                    fu = this.funcs.units[i];
                    o.put_str(g"  \0");
                    o.put_str(this.funcs.names[i]);
                    o.put_str(g"  \0");
                    fvm_put_pl(o, this.code.ulen[fu], g"instruction\0");
                    o.put(10);
                    total = total + this.code.ulen[fu];
                    i++;
                };
                o.put_str(g"main: \0");
                fvm_put_pl(o, this.main_locals, g"local\0");
                o.put_str(g", \0");
                fvm_put_pl(o, this.code.ulen[this.main_unit], g"instruction\0");
                o.put(10);
                total = total + this.code.ulen[this.main_unit];
                o.put_str(g"instructions: \0");
                o.put_int(total);
                o.put(10);
                -> true;
            };



            decompile_bin(byte* image, int len, FvmBuf* o) -> bool
            {
                bool ok;
                this.bin_lenient = true;
                ok = this.load_bin(image, len);
                this.bin_lenient = false;
                switch (ok) { case (true) { this.decompile(o); } default {}; };
                -> ok;
            };



            load_bin(byte* image, int len) -> bool
            {
                int i, k, n, nf, ni, unit, tg, sz, bits, off, fsz, ver, flags, lerr, rl, plen, tl;
                byte* nm;
                byte* en;
                byte* own;
                this.bd = image;
                this.bl = len;
                this.bp = 4;
                switch (len < 4 | !fvm_eq_n(image, 4, g"IDKB\0"))
                {
                    case (true) { this.bin_fail(g"bad magic\0"); -> false; }
                    default {};
                };
                switch (len < 6) { case (true) { this.bin_fail(g"unexpected end of file\0"); -> false; } default {}; };
                ver = (int)image[4];
                switch (ver != 2) { case (true) { this.bin_fail_n(g"unsupported version \0", ver); -> false; } default {}; };
                flags = (int)image[5];
                this.bp = 6;
                rl = this.rd_u32();
                plen = len - this.bp;
                switch (this.failed) { case (true) { -> false; } default {}; };

                switch ((flags `& 1) != 0)
                {
                    case (true) {
                        own = fvm_lz_decompress(image + this.bp, plen, rl, @lerr);
                        switch (own == (byte*)0)
                        {
                            case (true) {
                                switch (lerr == 1) { case (true) { this.bin_fail(g"unexpected end of file\0"); } default {}; };
                                switch (lerr == 2) { case (true) { this.bin_fail(g"damaged data\0"); } default {}; };
                                switch (lerr == 3) { case (true) { this.fail(g"allocation failed\0"); this.failed = true; } default {}; };
                                -> false;
                            }
                            default {};
                        };
                        this.bd = own;
                        this.bl = rl;
                        this.bp = 0;
                    }
                    default
                    {
                        switch (plen != rl) { case (true) { this.bin_fail(g"damaged data\0"); -> false; } default {}; };
                        this.bd = image + this.bp;
                        this.bl = plen;
                        this.bp = 0;
                    };
                };

                this.rt_n = this.rd_count();
                this.rt_s = (byte**)fvm_alloc((this.rt_n + 1) * 8);
                this.rt_l = (int*)fvm_alloc((this.rt_n + 1) * 4);
                switch (this.rt_s == (byte**)0 | this.rt_l == (int*)0) { case (true) { this.fail(g"allocation failed\0"); this.failed = true; } default {}; };
                i = 0;
                while (i < this.rt_n & !this.failed)
                {
                    tl = this.rd_u32();
                    switch (this.rd_need(tl))
                    {
                        case (true) {
                            this.rt_s[i] = this.bd + this.bp;
                            this.rt_l[i] = tl;
                            this.bp = this.bp + tl;
                        }
                        default {};
                    };
                    i++;
                };
                this.ib_flags = flags;
                this.ib_raw = rl;
                this.ib_nstr = this.rt_n;
                i = 0;
                while (i < this.rt_n & this.str_out != (FvmBuf*)0 & !this.failed)
                {
                    fvm_put_esc_line(this.str_out, this.rt_s[i], this.rt_l[i]);
                    i++;
                };
                n = this.rd_count();
                i = 0;
                while (i < n & !this.failed)
                {
                    nm = this.rd_blob((int*)0);
                    en = this.rd_blob((int*)0);
                    sz = this.rd_u32();
                    bits = this.rd_u32();
                    nf = this.rd_count();
                    switch (!this.failed)
                    {
                        case (true) {
                            switch (nm == (byte*)0 | en == (byte*)0 | !this.layouts.add_struct(nm, en, sz, bits))
                            {
                                case (true) { this.fail(g"struct layout allocation failed\0"); }
                                default {};
                            };
                        }
                        default {};
                    };
                    k = 0;
                    while (k < nf & !this.failed)
                    {
                        nm = this.rd_blob((int*)0);
                        tg = this.rd_ttag();
                        off = this.rd_u32();
                        fsz = this.rd_u32();
                        switch (!this.failed)
                        {
                            case (true) {
                                switch (nm == (byte*)0 | !this.layouts.add_field(nm, tg, off, fsz))
                                {
                                    case (true) { this.fail(g"struct layout allocation failed\0"); }
                                    default {};
                                };
                            }
                            default {};
                        };
                        k++;
                    };
                    i++;
                };
                n = this.rd_count();
                i = 0;
                while (i < n & !this.failed)
                {
                    nm = this.rd_blob((int*)0);
                    ni = this.rd_count();
                    unit = this.code.unit_begin();
                    switch (!this.failed & (nm == (byte*)0 | unit < 0)) { case (true) { this.fail(g"code pool allocation failed\0"); } default {}; };
                    k = 0;
                    while (k < ni & !this.failed)
                    {
                        this.rd_instr();
                        k++;
                    };
                    switch (!this.failed)
                    {
                        case (true) {
                            this.code.unit_end(unit);
                            this.register_function(nm, unit);
                        }
                        default {};
                    };
                    i++;
                };
                this.main_locals = this.rd_u32();
                ni = this.rd_count();
                unit = this.code.unit_begin();
                switch (!this.failed & unit < 0) { case (true) { this.fail(g"code pool allocation failed\0"); } default {}; };
                k = 0;
                while (k < ni & !this.failed)
                {
                    this.rd_instr();
                    k++;
                };
                this.code.unit_end(unit);
                this.main_unit = unit;

                switch (own != (byte*)0) { case (true) { ffree(own); } default {}; };
                switch (this.rt_s != (byte**)0) { case (true) { ffree((byte*)this.rt_s); } default {}; };
                switch (this.rt_l != (int*)0) { case (true) { ffree((byte*)this.rt_l); } default {}; };
                this.rt_s = (byte**)0;
                this.rt_l = (int*)0;
                this.rt_n = 0;
                this.bd = (byte*)0;
                this.bl = 0;
                -> !this.failed;
            };




            push_number_text(i64 v) -> void
            {
                this.tmp.clear();
                this.tmp.put_i64(v);
                this.push_bytes(this.tmp.mem, this.tmp.len);
                ->;
            };


            print_value(int tag, i64 d, bool newline) -> void
            {
                byte* s = this.str_of(tag, d);
                switch (s != (byte*)0)
                {
                    case (true) { standard::io::console::print(s); }
                    default
                    {
                        this.tmp.clear();
                        this.tmp.put_i64(d);
                        standard::io::console::print(this.tmp.mem);
                    };
                };
                switch (newline)
                {
                    case (true) { standard::io::console::print(g"\n\0"); }
                    default {};
                };
                ->;
            };

            str_op(int op) -> void
            {
                int at, n, an, bn, i, j;
                i64 ad, bd, cd;
                byte* a;
                byte* b;
                byte* r;
                bool ok2;
                i64 v;
                switch (op)
                {
                    case (102)
                    {
                        this.pop_val();
                        a = this.str_of(this.pt, this.pd);
                        switch (this.failed) { case (true) { ->; } default {}; };
                        switch (a == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"_read_vm_string: cannot read string from value\0");
                                ->;
                            }
                            default {};
                        };
                        this.push(1, (i64)fvm_strlen(a), (i64)0);
                    }
                    case (105)
                    {
                        this.pop_val();
                        b = this.str_of(this.pt, this.pd);
                        this.pop_val();
                        a = this.str_of(this.pt, this.pd);
                        switch (this.failed) { case (true) { ->; } default {}; };
                        switch (a == (byte*)0 | b == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"_read_vm_string: cannot read string from value\0");
                                ->;
                            }
                            default {};
                        };
                        switch (fvm_streq(a, b))
                        {
                            case (true) { this.push(6, (i64)1, (i64)0); }
                            default { this.push(6, (i64)0, (i64)0); };
                        };
                    }
                    case (103)
                    {
                        this.pop_val();
                        b = this.str_of(this.pt, this.pd);
                        this.pop_val();
                        a = this.str_of(this.pt, this.pd);
                        switch (this.failed) { case (true) { ->; } default {}; };
                        switch (a == (byte*)0 | b == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"_read_vm_string: cannot read string from value\0");
                                ->;
                            }
                            default {};
                        };
                        an = fvm_strlen(a);
                        bn = fvm_strlen(b);
                        r = fvm_alloc(an + bn + 1);
                        switch (r == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"allocation failed\0");
                                ->;
                            }
                            default {};
                        };
                        i = 0;
                        while (i < an) { r[i] = a[i]; i++; };
                        j = 0;
                        while (j < bn) { r[an + j] = b[j]; j++; };
                        this.push(15, fvm_p2i(r), (i64)(an + bn));
                    }
                    case (104)
                    {
                        this.pop_val();
                        cd = this.pd;
                        this.pop_val();
                        bd = this.pd;
                        this.pop_val();
                        a = this.str_of(this.pt, this.pd);
                        switch (this.failed) { case (true) { ->; } default {}; };
                        switch (a == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"_read_vm_string: cannot read string from value\0");
                                ->;
                            }
                            default {};
                        };
                        an = fvm_strlen(a);
                        switch (bd < (i64)0) { case (true) { bd = (i64)0; } default {}; };
                        switch (bd > (i64)an) { case (true) { bd = (i64)an; } default {}; };
                        switch (cd < (i64)0) { case (true) { cd = (i64)0; } default {}; };
                        switch (bd + cd > (i64)an) { case (true) { cd = (i64)an - bd; } default {}; };
                        this.push_bytes(a + (int)bd, (int)cd);
                    }
                    case (106)
                    {
                        this.pop_val();
                        b = this.str_of(this.pt, this.pd);
                        this.pop_val();
                        a = this.str_of(this.pt, this.pd);
                        switch (this.failed) { case (true) { ->; } default {}; };
                        switch (a == (byte*)0 | b == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"_read_vm_string: cannot read string from value\0");
                                ->;
                            }
                            default {};
                        };
                        an = fvm_strlen(a);
                        bn = fvm_strlen(b);
                        n = -1;
                        i = 0;
                        while (i + bn <= an & n < 0)
                        {
                            switch (fvm_eq_n(a + i, bn, b)) { case (true) { n = i; } default {}; };
                            i++;
                        };
                        this.push(0, (i64)n, (i64)0);
                    }
                    case (107)
                    {
                        this.pop_val();
                        at = this.pt;
                        ad = this.pd;
                        bd = this.pm;
                        switch (this.failed) { case (true) { ->; } default {}; };
                        switch (at == 15)
                        {
                            case (true) { this.push(15, ad, bd); }
                            default
                            {
                                switch (at == 10)
                                {
                                    case (true) {
                                        a = this.str_of(at, ad);
                                        switch (a == (byte*)0)
                                        {
                                            case (true) {
                                                this.fail(g"_read_vm_string: cannot read string from value\0");
                                                ->;
                                            }
                                            default {};
                                        };
                                        this.push_bytes(a, fvm_strlen(a));
                                    }
                                    default
                                    {
                                        switch (at == 8)
                                        {
                                            case (true) {
                                                this.tmp.clear();
                                                this.tmp.put((int)(ad `& (i64)255));
                                                this.push_bytes(this.tmp.mem, 1);
                                            }
                                            default {
                                                switch (fvm_isf(at, bd))
                                                {
                                                    case (true)
                                                    {

                                                        this.tmp.clear();
                                                        switch (at == 4)
                                                        {
                                                            case (true) { fvm_float2str(@this.tmp, fvm_bits_dbl(ad)); }
                                                            default { fvm_dbl2str(@this.tmp, fvm_bits_dbl(ad)); };
                                                        };
                                                        this.push_bytes(this.tmp.mem, this.tmp.len);
                                                    }
                                                    default { this.push_number_text(ad); };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    }
                    default
                    {

                        this.pop_val();
                        a = this.str_of(this.pt, this.pd);
                        switch (this.failed) { case (true) { ->; } default {}; };
                        switch (a == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"_read_vm_string: cannot read string from value\0");
                                ->;
                            }
                            default {};
                        };
                        an = fvm_strlen(a);
                        i = 0;
                        while (i < an & (a[i] == ' ' | a[i] == 9 | a[i] == 10 | a[i] == 13)) { i++; };
                        while (an > i & (a[an - 1] == ' ' | a[an - 1] == 9 | a[an - 1] == 10 | a[an - 1] == 13)) { an--; };
                        v = fvm_parse_int(a + i, an - i, @ok2);
                        switch (!ok2)
                        {
                            case (true) {
                                this.fail(g"STR_TO_INT: cannot convert string to integer\0");
                                ->;
                            }
                            default {};
                        };
                        this.push(0, v, (i64)0);
                    };
                };
                ->;
            };






            arr_free_all() -> void
            {
                int i;
                while (i < this.an)
                {
                    ffree((byte*)this.arrs[i]);
                    i++;
                };
                switch (this.arrs != (i64*)0) { case (true) { ffree((byte*)this.arrs); } default {}; };
                this.an = 0;
                ->;
            };

            arr_make(int count, int etag) -> i64*
            {
                i64* b = (i64*)fvm_alloc(16 + count * 24);
                i64* na;
                int i;
                switch (b == (i64*)0)
                {
                    case (true) { this.fail(g"array allocation failed\0"); -> b; }
                    default {};
                };
                switch (this.an >= this.acap)
                {
                    case (true)
                    {
                        na = (i64*)fvm_grow((byte*)this.arrs, this.acap * 2 * 8);
                        switch (na == (i64*)0) { case (true) { this.fail(g"array allocation failed\0"); -> b; } default {}; };
                        this.arrs = na;
                        this.acap = this.acap * 2;
                    }
                    default {};
                };
                this.arrs[this.an] = (i64)b;
                this.an++;
                b[0] = (i64)count;
                b[1] = (i64)etag;
                while (i < count)
                {
                    b[2 + i * 3] = (i64)etag;
                    i++;
                };
                -> b;
            };


            name_ttag(byte* n) -> int
            {
                switch (fvm_streq(n, g"int\0")) { case (true) { -> 0; } default {}; };
                switch (fvm_streq(n, g"uint\0")) { case (true) { -> 1; } default {}; };
                switch (fvm_streq(n, g"long\0")) { case (true) { -> 2; } default {}; };
                switch (fvm_streq(n, g"ulong\0")) { case (true) { -> 3; } default {}; };
                switch (fvm_streq(n, g"float\0")) { case (true) { -> 4; } default {}; };
                switch (fvm_streq(n, g"double\0")) { case (true) { -> 5; } default {}; };
                switch (fvm_streq(n, g"bool\0")) { case (true) { -> 6; } default {}; };
                switch (fvm_streq(n, g"byte\0")) { case (true) { -> 7; } default {}; };
                switch (fvm_streq(n, g"char\0")) { case (true) { -> 8; } default {}; };
                switch (fvm_streq(n, g"data\0")) { case (true) { -> 9; } default {}; };
                switch (fvm_streq(n, g"void\0")) { case (true) { -> 11; } default {}; };
                -> 10;
            };

            op_array_new(i64 count, byte* tn) -> void
            {
                i64* b = this.arr_make((int)count, this.name_ttag(tn));
                switch (this.failed) { case (true) { ->; } default {}; };
                this.push(14, (i64)b, count);
                ->;
            };

            op_array_len() -> void
            {
                this.pop_val();
                switch (this.failed) { case (true) { ->; } default {}; };
                switch (this.pt == 14)
                {
                    case (true) { this.push(0, this.pm, (i64)0); }
                    default { this.push(0, (i64)0, (i64)0); };
                };
                ->;
            };



            ptr_is_os(i64 addr) -> bool
            {
                int k;
                switch (addr < (i64)0 | addr > (i64)this.vheap.size) { case (true) { -> true; } default {}; };
                while (k < this.osn)
                {
                    switch (this.osp[k] == addr) { case (true) { -> true; } default {}; };
                    k++;
                };
                -> false;
            };


            os_add(i64 addr) -> void
            {
                int k;
                i64* n1;
                while (k < this.osn)
                {
                    switch (this.osp[k] == addr) { case (true) { ->; } default {}; };
                    k++;
                };
                switch (this.osn >= this.oscap)
                {
                    case (true)
                    {
                        n1 = (i64*)fvm_grow((byte*)this.osp, this.oscap * 2 * 8);
                        switch (n1 == (i64*)0) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                        this.osp = n1;
                        this.oscap = this.oscap * 2;
                    }
                    default {};
                };
                this.osp[this.osn] = addr;
                this.osn++;
                ->;
            };


            os_rd(i64 a, int sz) -> i64
            {
                i64 v = (i64)0;
                int k = sz - 1;
                byte* p = fvm_i2p(a);
                while (k >= 0)
                {
                    v = (v << 8) `| ((i64)p[k] `& (i64)255);
                    k--;
                };
                -> v;
            };

            os_wr(i64 a, int sz, i64 v) -> void
            {
                int k;
                i64 t = v;
                byte* p = fvm_i2p(a);
                while (k < sz)
                {
                    p[k] = (byte)(t `& (i64)255);
                    t = t >> 8;
                    k++;
                };
                ->;
            };


            mem_ok(i64 p, int sz) -> bool
            {
                switch (this.ptr_is_os(p)) { case (true) { -> true; } default {}; };
                -> this.vheap.in_bounds(p, sz);
            };

            mem_rd(i64 p, int sz) -> i64
            {
                switch (this.ptr_is_os(p)) { case (true) { -> this.os_rd(p, sz); } default {}; };
                -> this.vheap.rd((int)p, sz);
            };

            mem_wr(i64 p, int sz, i64 v) -> void
            {
                switch (this.ptr_is_os(p)) { case (true) { this.os_wr(p, sz, v); ->; } default {}; };
                this.vheap.wr((int)p, sz, v);
                ->;
            };



            pin_bytes(i64 d, i64 len, i64 off) -> i64
            {
                byte* src = fvm_i2p(d);
                byte* buf;
                int n = (int)len;
                int add = 1;
                switch (n > 0 & src[n - 1] == 0) { case (true) { add = 0; } default {}; };
                buf = fvm_alloc(n + add + 1);
                switch (buf == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> (i64)0; } default {}; };
                fvm_copy(buf, src, n);
                this.pin_keep(buf);
                this.os_add(fvm_p2i(buf));
                -> fvm_p2i(buf) + off;
            };


            pin_keep(byte* buf) -> void
            {
                byte** n1;
                switch (this.pinn >= this.pincap)
                {
                    case (true)
                    {
                        n1 = (byte**)fvm_grow((byte*)this.pins, this.pincap * 2 * 8);
                        switch (n1 == (byte**)0) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                        this.pins = n1;
                        this.pincap = this.pincap * 2;
                    }
                    default {};
                };
                this.pins[this.pinn] = buf;
                this.pinn++;
                ->;
            };


            tag_has_int_data(int t) -> bool
            {
                -> t == 0 | t == 1 | t == 2 | t == 3 | t == 7 | t == 8 | t == 6 | t == 9 | t == 10 | t == 13;
            };


            heap_byte_push(i64 addr) -> void
            {
                switch (!this.mem_ok(addr, 1))
                {
                    case (true) { this.fail(g"VMHeap: out-of-bounds access\0"); ->; }
                    default {};
                };
                this.push(7, this.mem_rd(addr, 1), (i64)0);
                ->;
            };


            store_byte_of(int vt, i64 vd) -> i64
            {
                switch (this.tag_has_int_data(vt))
                {
                    case (true) { -> vd `& (i64)255; }
                    default {};
                };
                switch (vt == 15)
                {
                    case (true) { -> (i64)fvm_i2p(vd)[0] `& (i64)255; }
                    default {};
                };
                -> (i64)0;
            };

            heap_byte_write(i64 addr, i64 v) -> bool
            {
                switch (!this.mem_ok(addr, 1))
                {
                    case (true) { this.fail(g"VMHeap: out-of-bounds access\0"); -> false; }
                    default {};
                };
                this.mem_wr(addr, 1, v);
                -> true;
            };

            op_array_load() -> void
            {
                i64 idx;
                i64* b;
                int fi = this.nframes - 1;
                int slot;
                int at;
                i64 ad;
                this.pop_val();
                idx = this.pd;
                this.pop_val();
                at = this.pt;
                ad = this.pd;
                switch (this.failed) { case (true) { ->; } default {}; };

                switch (at == 10)
                {
                    case (true)
                    {
                        switch (fi >= 0 & ad < (i64)this.fr_nloc[fi])
                        {
                            case (true)
                            {
                                slot = this.fr_base[fi] + (int)ad;
                                switch (this.lc_tag[slot] == 10)
                                {
                                    case (true)
                                    {
                                        this.heap_byte_push(this.lc_data[slot] + idx);
                                        ->;
                                    }
                                    default {};
                                };
                                switch (this.lc_tag[slot] == 14)
                                {
                                    case (true) { at = 14; ad = this.lc_data[slot]; }
                                    default {};
                                };
                            }
                            default
                            {
                                this.heap_byte_push(ad + idx);
                                ->;
                            };
                        };
                    }
                    default {};
                };

                switch (at != 14 & this.tag_has_int_data(at) & ad != (i64)0 & (ad < (i64)0 | ad > (i64)65535))
                {
                    case (true)
                    {
                        this.heap_byte_push(ad + idx);
                        ->;
                    }
                    default {};
                };
                switch (at != 14)
                {
                    case (true) { this.fail(g"ARRAY_LOAD: array has no elements storage\0"); ->; }
                    default {};
                };
                b = (i64*)ad;
                switch (idx < (i64)0 | idx >= b[0])
                {
                    case (true)
                    {
                        this.fail_index(g"ARRAY_LOAD: index \0", idx, b[0]);
                        ->;
                    }
                    default {};
                };
                this.push((int)b[2 + (int)idx * 3], b[3 + (int)idx * 3], b[4 + (int)idx * 3]);
                ->;
            };

            op_array_store() -> void
            {
                i64 vt;
                i64 vd;
                i64 vm;
                i64 idx;
                i64* b;
                i64* nb;
                int i, n;
                int fi = this.nframes - 1;
                int slot;
                int at;
                i64 ad;
                i64 am;
                this.pop_val();
                vt = (i64)this.pt;
                vd = this.pd;
                vm = this.pm;
                this.pop_val();
                idx = this.pd;
                this.pop_val();
                at = this.pt;
                ad = this.pd;
                am = this.pm;
                switch (this.failed) { case (true) { ->; } default {}; };
                switch (at == 10)
                {
                    case (true)
                    {
                        switch (fi >= 0 & ad < (i64)this.fr_nloc[fi])
                        {
                            case (true)
                            {
                                slot = this.fr_base[fi] + (int)ad;
                                switch (this.lc_tag[slot] == 10)
                                {
                                    case (true)
                                    {
                                        switch (this.heap_byte_write(this.lc_data[slot] + idx, this.store_byte_of((int)vt, vd)))
                                        {
                                            case (true) { this.push(10, ad, am); }
                                            default {};
                                        };
                                        ->;
                                    }
                                    default {};
                                };
                                switch (this.lc_tag[slot] == 14)
                                {
                                    case (true)
                                    {
                                        b = (i64*)this.lc_data[slot];
                                        switch (idx < (i64)0 | idx >= b[0])
                                        {
                                            case (true) { this.fail(g"ARRAY_STORE: index out of bounds\0"); ->; }
                                            default {};
                                        };
                                        n = (int)b[0];
                                        nb = this.arr_make(n, (int)b[1]);
                                        switch (this.failed) { case (true) { ->; } default {}; };
                                        while (i < n * 3)
                                        {
                                            nb[2 + i] = b[2 + i];
                                            i++;
                                        };
                                        nb[2 + (int)idx * 3] = vt;
                                        nb[3 + (int)idx * 3] = vd;
                                        nb[4 + (int)idx * 3] = vm;
                                        this.lc_data[slot] = (i64)nb;
                                        this.lc_meta[slot] = (i64)n;
                                        this.push(10, ad, am);
                                        ->;
                                    }
                                    default {};
                                };
                            }
                            default
                            {
                                switch (this.heap_byte_write(ad + idx, this.store_byte_of((int)vt, vd)))
                                {
                                    case (true) { this.push(10, ad, am); }
                                    default {};
                                };
                                ->;
                            };
                        };
                    }
                    default {};
                };
                switch (at != 14 & this.tag_has_int_data(at) & ad != (i64)0 & (ad < (i64)0 | ad > (i64)65535))
                {
                    case (true)
                    {
                        switch (this.heap_byte_write(ad + idx, this.store_byte_of((int)vt, vd)))
                        {
                            case (true) { this.push(at, ad, am); }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (at != 14)
                {
                    case (true) { this.fail(g"ARRAY_STORE: index out of bounds\0"); ->; }
                    default {};
                };
                b = (i64*)ad;
                switch (idx < (i64)0 | idx >= b[0])
                {
                    case (true)
                    {
                        this.fail(g"ARRAY_STORE: index out of bounds\0");
                        ->;
                    }
                    default {};
                };
                n = (int)b[0];
                nb = this.arr_make(n, (int)b[1]);
                switch (this.failed) { case (true) { ->; } default {}; };
                i = 0;
                while (i < n * 3)
                {
                    nb[2 + i] = b[2 + i];
                    i++;
                };
                nb[2 + (int)idx * 3] = vt;
                nb[3 + (int)idx * 3] = vd;
                nb[4 + (int)idx * 3] = vm;
                this.push(14, (i64)nb, (i64)n);
                ->;
            };






            fail_index(byte* msg, i64 idx, i64 n) -> void
            {
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(msg);
                        this.errb.put_i64(idx);
                        this.errb.put_str(g" out of bounds (len=\0");
                        this.errb.put_i64(n);
                        this.errb.put_str(g")\0");
                        this.failed = true;
                    }
                    default {};
                };
                ->;
            };


            fail_got(byte* msg, int tag) -> void
            {
                byte* nm = fvm_ttag_name(tag);
                int k;
                byte ch;
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(msg);
                        this.errb.put_str(g", got TTag.\0");
                        while (nm[k] != 0)
                        {
                            ch = nm[k];
                            switch (ch >= 'a' & ch <= 'z') { case (true) { ch = (byte)(ch - 32); } default {}; };
                            this.errb.put((int)ch);
                            k++;
                        };
                        this.failed = true;
                    }
                    default {};
                };
                ->;
            };

            fail_parts(byte* a, byte* b, byte* c, byte* d) -> void
            {
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(a);
                        this.errb.put_str(b);
                        this.errb.put_str(c);
                        this.errb.put_str(d);
                        this.failed = true;
                    }
                    default {};
                };
                ->;
            };


            field_index(int li, byte* name) -> int
            {
                int k;
                while (k < this.layouts.scount[li])
                {
                    switch (fvm_streq(this.layouts.fname[this.layouts.sfirst[li] + k], name))
                    {
                        case (true) { -> k; }
                        default {};
                    };
                    k++;
                };
                -> -1;
            };


            struct_make(byte* name) -> i64*
            {
                int li = this.layouts.find(name);
                int n, k;
                i64* b;
                switch (li < 0)
                {
                    case (true)
                    {
                        this.fail_parts(g"Unknown struct/object type: '\0", name, g"'\0", g"\0");
                        -> (i64*)0;
                    }
                    default {};
                };
                n = this.layouts.scount[li];
                b = this.arr_make(n, 0);
                switch (this.failed) { case (true) { -> (i64*)0; } default {}; };
                b[1] = (i64)li;
                while (k < n)
                {
                    b[2 + k * 3] = (i64)this.layouts.ftag[this.layouts.sfirst[li] + k];
                    k++;
                };
                -> b;
            };

            op_struct_new(byte* name) -> void
            {
                i64* b = this.struct_make(name);
                switch (b == (i64*)0) { case (true) { ->; } default {}; };
                this.push(12, (i64)b, b[1]);
                ->;
            };


            sf(i64* b, byte* fname, int tag, i64 d, i64 m) -> void
            {
                int li = (int)b[1];
                int k;
                switch (this.failed) { case (true) { ->; } default {}; };
                k = this.field_index(li, fname);
                switch (k < 0)
                {
                    case (true)
                    {
                        this.fail_parts(g"STRUCT_STORE: field '\0", fname, g"' not found in struct '\0", this.layouts.sname[li]);
                        ->;
                    }
                    default {};
                };
                b[2 + k * 3] = (i64)tag;
                b[3 + k * 3] = d;
                b[4 + k * 3] = m;
                ->;
            };


            sfs(i64* b, byte* fname, byte* s) -> void
            {
                int n;
                byte* p;
                switch (s != (byte*)0) { case (true) { n = fvm_strlen(s); } default {}; };
                p = fvm_dup(s, n);
                switch (p == (byte*)0)
                {
                    case (true) { this.fail(g"allocation failed\0"); ->; }
                    default {};
                };
                this.sf(b, fname, 15, fvm_p2i(p), (i64)n);
                ->;
            };

            sfi(i64* b, byte* fname, int v) -> void -> this.sf(b, fname, 0, (i64)v, (i64)0);

            sfb(i64* b, byte* fname, bool v) -> void
            {
                switch (v)
                {
                    case (true) { this.sf(b, fname, 6, (i64)1, (i64)0); }
                    default { this.sf(b, fname, 6, (i64)0, (i64)0); };
                };
                ->;
            };


            sfst(i64* b, byte* fname, i64* v) -> void
            {
                switch (v == (i64*)0) { case (true) { ->; } default {}; };
                this.sf(b, fname, 12, (i64)v, v[1]);
                ->;
            };


            mk_ts(FvmReflTy* t) -> i64*
            {
                i64* b = this.struct_make(g"IDKC_TYPESYS\0");
                switch (b == (i64*)0) { case (true) { -> b; } default {}; };
                switch (t == (FvmReflTy*)0)
                {
                    case (true)
                    {
                        switch (this.refl_zero == (FvmReflTy*)0)
                        {
                            case (true) { this.refl_zero = (FvmReflTy*)fvm_alloc(sizeof(FvmReflTy) / 8); }
                            default {};
                        };
                        switch (this.refl_zero == (FvmReflTy*)0)
                        {
                            case (true) { this.fail(g"allocation failed\0"); -> (i64*)0; }
