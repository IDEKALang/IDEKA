        dup_from(byte* s, int start) -> byte*
        {
            int i = start;
            int n;
            while (s[i] != 0)
            {
                i++;
            };
            n = i - start;
            byte* r = (byte*)fmalloc((u64)(n + 1));
            i = 0;
            while (i < n)
            {
                r[i] = s[start + i];
                i++;
            };
            r[n] = (byte)0;
            -> r;
        };


        bits_of(IRType* t) -> int
        {
            int i, total;
            int k = t.kind;
            switch (k == LK.INT)
            {
                case (true) { -> t.width; }
                default
                {
                    switch (k == LK.FLOAT)
                    {
                        case (true) { -> 32; }
                        default
                        {
                            switch (k == LK.DOUBLE)
                            {
                                case (true) { -> 64; }
                                default
                                {
                                    switch (k == LK.ARRAY)
                                    {
                                        case (true) { -> bits_of(t.elem) * t.count; }
                                        default
                                        {
                                            switch (k == LK.PTR)
                                            {
                                                case (true) { -> 64; }
                                                default
                                                {
                                                    switch (k == LK.STRUCT | k == LK.ISTRUCT)
                                                    {
                                                        case (true) {
                                                        while (i < t.nitems)
                                                        {
                                                            total = total + bits_of(t.items[i]);
                                                            i++;
                                                        };
                                                        -> total;
                                                    }
                                                        default
                                                        {
                                                            -> 0;
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };


        obj_field_bits(IRType* t, int* align_out) -> int
        {
            IRType* e;
            switch (t.kind == LK.INT)
            {
                case (true) {
                align_out[0] = t.width;
                -> t.width;
            }
                default
                {
                    switch (t.kind == LK.FLOAT)
                    {
                        case (true) {
                        align_out[0] = 32;
                        -> 32;
                    }
                        default
                        {
                            switch (t.kind == LK.DOUBLE)
                            {
                                case (true) {
                                align_out[0] = 64;
                                -> 64;
                            }
                                default
                                {
                                    switch (t.kind == LK.ARRAY)
                                    {
                                        case (true) {
                                        e = t.elem;
                                        switch (e.kind == LK.INT)
                                        {
                                            case (true) {
                                            align_out[0] = e.width;
                                            -> e.width * t.count;
                                        }
                                            default {};
                                        };
                                        switch (e.kind == LK.FLOAT)
                                        {
                                            case (true) {
                                            align_out[0] = 32;
                                            -> 32 * t.count;
                                        }
                                            default {};
                                        };
                                        switch (e.kind == LK.DOUBLE)
                                        {
                                            case (true) {
                                            align_out[0] = 64;
                                            -> 64 * t.count;
                                        }
                                            default {};
                                        };
                                        align_out[0] = 64;
                                        -> 64 * t.count;
                                    }
                                        default
                                        {
                                            switch (t.kind == LK.STRUCT | t.kind == LK.ISTRUCT)
                                            {
                                                case (true) {
                                                align_out[0] = 64;
                                                -> bits_of(t);
                                            }
                                                default
                                                {
                                                    align_out[0] = 64;
                                                    -> 64;
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };

