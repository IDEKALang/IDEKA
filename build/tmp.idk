                                        bi++;
                                    };
                                };
                            };
                            off = off + nb;
                            i++;
                        };
                        -> i8buf;
                    };
                };
            };



            x_bitslice(Node* n) -> IRValue*
            {
                IRValue* r = this.x_bitslice_raw(n);
                switch (r != (IRValue*)0)
                {
                    case (true) {
                        switch (r.ty.kind == LK.INT)
                        {
                            case (true) { r.spec = this.lit_spec(DataType.UINT); }
                            default {};
                        };
                    }
                    default {};
                };
                -> r;
            };




            bs_const_slice(Node* n, IRValue* base, i64 sc, i64 ec) -> IRValue*
            {
                int sw = (int)(ec - sc + (i64)1);
                int first = (int)(sc / (i64)8);
                int last = (int)(ec / (i64)8);
                int nb = last - first + 1;
                int j;
                int shin;
                int shout;
                IRType* wty;
                IRValue* acc;
                IRValue* bp;
                IRValue* bv;
                switch (nb * 8 > 64)
                {
                    case (true) {
                        this.unsup(n, g"bit slice touches more than 8 bytes\0");
                        -> (IRValue*)0;
                    }
                    default {};
                };
                wty = this.mod.t_int(nb * 8);
                acc = this.mod.c_int(wty, (i64)0);
                j = 0;
                while (j < nb)
                {
                    bp = this.bs_gep(base, this.ci32(first + j), g"bs_mb_ptr\0");
                    bv = this.mod.load(bp, g"bs_mb_byte\0");
                    switch (wty.width != 8)
                    {
                        case (true) { bv = this.mod.cast(g"zext\0", bv, wty, g"bs_mb_ext\0"); }
                        default {};
                    };
                    shin = (nb - 1 - j) * 8;
                    switch (shin != 0)
                    {
                        case (true) { bv = this.mod.binop(g"shl\0", bv, this.mod.c_int(wty, (i64)shin), g"bs_mb_sh\0"); }
                        default {};
                    };
                    acc = this.mod.binop(g"or\0", acc, bv, g"bs_mb_acc\0");
                    j++;
                };
                shout = 7 - (int)(ec % (i64)8);
                switch (shout != 0)
                {
                    case (true) { acc = this.mod.binop(g"lshr\0", acc, this.mod.c_int(wty, (i64)shout), g"bs_mb_down\0"); }
                    default {};
                };
                switch (sw < wty.width)
                {
                    case (true) {
                        acc = this.mod.binop(g"and\0", acc, this.mod.c_int(wty, ((i64)1 << sw) - (i64)1), g"bs_mb_mask\0");
                        -> this.mod.cast(g"trunc\0", acc, this.mod.t_int(sw), g"bs_mb_trunc\0");
                    }
                    default {};
                };
                -> acc;
            };

            x_bitslice_raw(Node* n) -> IRValue*
            {
                IRValue* val = this.visit(n.a);
                IRValue* sv;
                IRValue* ev;
                IRValue* base;
                IRValue* tmp;
                IRValue* wv;
                IRValue* sh;
                IRValue* bv;
                IRValue* res;
                IRValue* bval;
                IRValue* ext;
                IRValue* plc;
                IRValue* si32;
                IRValue* ei32;
                IRValue* eight;
                IRValue* bidx;
                IRValue* bstart;
                IRValue* bend;
                IRValue* bp;
                IRValue* bbyte;
                IRValue* e8;
                IRValue* s8;
                IRValue* shamt;
                IRValue* shd;
                IRValue* slen;
                IRValue* swid;
                IRValue* mraw;
                IRValue* mask;
                IRValue* masked;
                IRType* vt;
                IRType* i8t = this.t_i8;
                IRType* i8ptr = this.mod.t_ptr(this.t_i8);
                i64 sc;
                i64 ec;
                bool has_s;
                bool has_e;
                int nbytes;
                int nbits;
                int i;
                int bit_pos;
                int width;
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        sv = this.visit(n.b);
                        switch (this.bad)
                        {
                            case (true) { -> (IRValue*)0; }
                            default
                            {
                                ev = this.visit(n.c);
                                switch (this.bad)
                                {
                                    case (true) { -> (IRValue*)0; }
                                    default
                                    {
                                        switch (val == (IRValue*)0 | sv == (IRValue*)0 | ev == (IRValue*)0)
                                        {
                                            case (true) {
                                            this.unsup(n, g"void bit slice operand\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                vt = val.ty;
                                                has_s = sv.is_const & this.parse_int_text(sv.text, @sc);
                                                has_e = ev.is_const & this.parse_int_text(ev.text, @ec);

                                                switch (has_s & has_e & sc > ec)
                                                {
                                                    case (true) {
                                                    switch (vt.kind == LK.PTR & vt.elem.kind == LK.ARRAY)
                                                    {
                                                        case (true) { base = val; }
                                                        default {
                                                            switch (vt.kind == LK.PTR & this.is_aggregate_ty(vt.elem))
                                                            {
                                                                case (true) { base = this.mod.cast(g"bitcast\0", val, i8ptr, g"rev_struct_raw\0"); }
                                                                default {
                                                                    switch (this.is_aggregate_ty(vt))
                                                                    {
                                                                        case (true) {
                                                                        tmp = this.mod.alloca_here(vt, g"rev_stmp\0");
                                                                        this.mod.store(val, tmp);
                                                                        base = this.mod.cast(g"bitcast\0", tmp, i8ptr, g"rev_struct_raw\0");
                                                                    }
                                                                        default {
                                                                            switch (vt.kind == LK.INT & vt.width >= 8)
                                                                            {
                                                                                case (true) {
                                                                                nbytes = vt.width / 8;
                                                                                tmp = this.mod.alloca_here(this.mod.t_array(i8t, nbytes), g"rev_tmp\0");
                                                                                base = this.mod.cast(g"bitcast\0", tmp, i8ptr, g"rev_tmp_i8\0");
                                                                                wv = val;
                                                                                switch (vt.width < 32) { case (true) { wv = this.mod.cast(g"zext\0", val, this.t_i32, (byte*)0); } default {}; };
                                                                                i = 0;
                                                                                while (i < nbytes)
                                                                                {
                                                                                    sh = this.mod.binop(g"lshr\0", wv, this.mod.c_int(wv.ty, (i64)((nbytes - 1 - i) * 8)), (byte*)0);
                                                                                    bv = this.mod.cast(g"trunc\0", sh, i8t, (byte*)0);
                                                                                    bp = this.bs_gep(base, this.ci32(i), (byte*)0);
                                                                                    this.mod.store(bv, bp);
                                                                                    i++;
                                                                                };
                                                                            }
                                                                                default {
                                                                                    tmp = this.mod.alloca_here(i8t, g"rev_tmp\0");
                                                                                    wv = val;
                                                                                    switch (vt.kind != LK.INT) { case (true) { this.unsup(n, g"bit slice operand\0"); -> (IRValue*)0; } default {}; };
                                                                                    switch (vt.width != 8) { case (true) { wv = this.mod.cast(g"trunc\0", val, i8t, (byte*)0); } default {}; };
                                                                                    this.mod.store(wv, tmp);
                                                                                    base = tmp;
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                    nbits = (int)(sc - ec + (i64)1);
                                                    res = this.mod.c_int(i8t, (i64)0);
                                                    i = 0;
                                                    bit_pos = (int)sc;
                                                    while (bit_pos >= (int)ec)
                                                    {
                                                        bp = this.bs_gep(base, this.ci32(bit_pos / 8), (byte*)0);
                                                        bval = this.mod.load(bp, this.nm_ab(g"rev_byte_\0", i, -1));
                                                        sh = this.mod.binop(g"lshr\0", bval, this.mod.c_int(i8t, (i64)(7 - bit_pos % 8)), this.nm_ab(g"rev_ext_\0", i, -1));
                                                        ext = this.mod.binop(g"and\0", sh, this.mod.c_int(i8t, (i64)1), this.nm_ab(g"rev_bit_\0", i, -1));
                                                        plc = this.mod.binop(g"shl\0", ext, this.mod.c_int(i8t, (i64)(nbits - 1 - i)), this.nm_ab(g"rev_place_\0", i, -1));
                                                        res = this.mod.binop(g"or\0", res, plc, this.nm_ab(g"rev_acc_\0", i, -1));
                                                        i++;
                                                        bit_pos--;
                                                    };
                                                    switch (nbits >= 1 & nbits < 8)
                                                    {
                                                        case (true) { -> this.mod.cast(g"trunc\0", res, this.mod.t_int(nbits), g"rev_trunc\0"); }
                                                        default {};
                                                    };
                                                    -> res;
                                                }
                                                    default
                                                    {

                                                        switch (vt.kind == LK.PTR & vt.elem.kind == LK.ARRAY)
                                                        {
                                                            case (true) { base = val; }
                                                            default {
                                                                switch (vt.kind == LK.PTR & this.is_aggregate_ty(vt.elem))
                                                                {
                                                                    case (true) {
                                                                    base = this.bs_struct_buf(vt.elem, val);
                                                                    switch (this.bad | base == (IRValue*)0) { case (true) { -> (IRValue*)0; } default {}; };
                                                                }
                                                                    default {
                                                                        switch (vt.kind == LK.PTR)
                                                                        {
                                                                            case (true) { base = val; }
                                                                            default {
                                                                                switch (this.is_aggregate_ty(vt))
                                                                                {
                                                                                    case (true) {
                                                                                    tmp = this.mod.alloca_here(vt, g"bs_tmp\0");
                                                                                    this.mod.store(val, tmp);
                                                                                    base = this.bs_struct_buf(vt, tmp);
                                                                                    switch (this.bad | base == (IRValue*)0) { case (true) { -> (IRValue*)0; } default {}; };
                                                                                }
                                                                                    default {
                                                                                        switch (vt.kind == LK.ARRAY)
                                                                                        {
                                                                                            case (true) {
                                                                                            tmp = this.mod.alloca_here(vt, g"bs_tmp\0");
                                                                                            this.mod.store(val, tmp);
                                                                                            base = tmp;
                                                                                        }
                                                                                            default {
                                                                                                switch (vt.kind == LK.INT & vt.width >= 8)
                                                                                                {
                                                                                                    case (true) {
                                                                                                    nbytes = vt.width / 8;
                                                                                                    tmp = this.mod.alloca_here(this.mod.t_array(i8t, nbytes), g"bs_tmp\0");
                                                                                                    base = this.mod.cast(g"bitcast\0", tmp, i8ptr, g"bs_tmp_i8\0");
                                                                                                    wv = val;
                                                                                                    switch (vt.width < 32)
                                                                                                    {
                                                                                                        case (true) { wv = this.mod.cast(g"zext\0", val, this.t_i32, g"bs_widen\0"); }
                                                                                                        default {
                                                                                                            switch (vt.width > 64)
                                                                                                            {
                                                                                                                case (true) { wv = this.mod.cast(g"trunc\0", val, this.t_i64, g"bs_widen\0"); }
                                                                                                                default {};
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                    i = 0;
                                                                                                    while (i < nbytes)
                                                                                                    {
                                                                                                        sh = this.mod.binop(g"lshr\0", wv, this.mod.c_int(wv.ty, (i64)((nbytes - 1 - i) * 8)), this.nm_ab(g"bs_byteshift_\0", i, -1));
                                                                                                        bv = this.mod.cast(g"trunc\0", sh, i8t, this.nm_ab(g"bs_byte_\0", i, -1));
                                                                                                        bp = this.bs_gep(base, this.ci32(i), this.nm_ab(g"bs_bptr_\0", i, -1));
                                                                                                        this.mod.store(bv, bp);
                                                                                                        i++;
                                                                                                    };
                                                                                                }
                                                                                                    default {
                                                                                                        switch (vt.kind != LK.INT)
                                                                                                        {
                                                                                                            case (true) {
                                                                                                            this.unsup(n, g"bit slice operand\0");
                                                                                                            -> (IRValue*)0;
                                                                                                        }
                                                                                                            default
                                                                                                            {
                                                                                                                wv = this.mod.cast(g"zext\0", val, i8t, g"bs_widen\0");
                                                                                                                sh = this.mod.binop(g"shl\0", wv, this.mod.c_int(i8t, (i64)(8 - vt.width)), g"bs_prealign\0");
                                                                                                                tmp = this.mod.alloca_here(i8t, g"bs_tmp\0");
                                                                                                                this.mod.store(sh, tmp);
                                                                                                                base = tmp;
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                        switch (has_s & has_e & ec >= sc)
                                                        {
                                                            case (true) { -> this.bs_const_slice(n, base, sc, ec); }
                                                            default {};
                                                        };
                                                        switch (sv.ty.kind != LK.INT | ev.ty.kind != LK.INT)
                                                        {
                                                            case (true) {
                                                            this.unsup(n, g"bit slice index\0");
                                                            -> (IRValue*)0;
                                                        }
                                                            default
                                                            {
                                                                si32 = sv;
                                                                switch (sv.ty.width < 32)
                                                                {
                                                                    case (true) { si32 = this.mod.cast(g"zext\0", sv, this.t_i32, g"bs_start\0"); }
                                                                    default {
                                                                        switch (sv.ty.width > 32)
                                                                        {
                                                                            case (true) { si32 = this.mod.cast(g"trunc\0", sv, this.t_i32, g"bs_start\0"); }
                                                                            default {};
                                                                        };
                                                                    };
                                                                };
                                                                ei32 = ev;
                                                                switch (ev.ty.width < 32)
                                                                {
                                                                    case (true) { ei32 = this.mod.cast(g"zext\0", ev, this.t_i32, g"bs_end\0"); }
                                                                    default {
                                                                        switch (ev.ty.width > 32)
                                                                        {
                                                                            case (true) { ei32 = this.mod.cast(g"trunc\0", ev, this.t_i32, g"bs_end\0"); }
                                                                            default {};
                                                                        };
                                                                    };
                                                                };
                                                                eight = this.ci32(8);
                                                                bidx = this.mod.binop(g"udiv\0", si32, eight, g"bs_byte_idx\0");
                                                                bstart = this.mod.binop(g"urem\0", si32, eight, g"bs_bit_start\0");
                                                                bend = this.mod.binop(g"urem\0", ei32, eight, g"bs_bit_end\0");
                                                                bp = this.bs_gep(base, bidx, g"bs_byte_ptr\0");
                                                                bbyte = this.mod.load(bp, g"bs_byte\0");
                                                                e8 = this.mod.cast(g"trunc\0", bend, i8t, g"bs_bit_end_i8\0");
                                                                s8 = this.mod.cast(g"trunc\0", bstart, i8t, g"bs_bit_start_i8\0");
                                                                shamt = this.mod.binop(g"sub\0", this.mod.c_int(i8t, (i64)7), e8, g"bs_shift_amt\0");
                                                                shd = this.mod.binop(g"lshr\0", bbyte, shamt, g"bs_shift\0");
                                                                slen = this.mod.binop(g"sub\0", e8, s8, g"bs_slen\0");
                                                                swid = this.mod.binop(g"add\0", slen, this.mod.c_int(i8t, (i64)1), g"bs_swidth\0");
                                                                mraw = this.mod.binop(g"shl\0", this.ci32(1), this.mod.cast(g"zext\0", swid, this.t_i32, g"bs_swidth32\0"), g"bs_mask_raw\0");
                                                                mask = this.mod.cast(g"trunc\0", this.mod.binop(g"sub\0", mraw, this.ci32(1), g"bs_mask32\0"), i8t, g"bs_mask\0");
                                                                masked = this.mod.binop(g"and\0", shd, mask, g"bs_result\0");
                                                                switch (si32.is_const & ei32.is_const & this.parse_int_text(si32.text, @sc) & this.parse_int_text(ei32.text, @ec))
                                                                {
                                                                    case (true) {
                                                                    width = (int)(ec % (i64)8 - sc % (i64)8 + (i64)1);
                                                                    switch (width >= 1 & width <= 8)
                                                                    {
                                                                        case (true) { -> this.mod.cast(g"trunc\0", masked, this.mod.t_int(width), g"bs_trunc\0"); }
                                                                        default {};
                                                                    };
                                                                }
                                                                    default {};
                                                                };
                                                                -> masked;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            x_bitindex(Node* n) -> IRValue*
            {
                IRValue* val = this.visit(n.a);
                IRValue* iv;
                IRValue* ix;
                IRValue* sh;
                IRValue* wv;
                IRValue* shd;
                IRValue* bit;
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        iv = this.visit(n.b);
                        switch (this.bad)
                        {
                            case (true) { -> (IRValue*)0; }
                            default
                            {
                                switch (val == (IRValue*)0 | iv == (IRValue*)0)
                                {
                                    case (true) {
                                    this.unsup(n, g"void bit index operand\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        switch (val.ty.kind == LK.PTR)
                                        {
                                            case (true) {
                                            switch (val.ty.elem.kind == LK.INT) { case (true) { val = this.mod.load(val, g"bia_load\0"); } default {}; };
                                        }
                                            default {};
                                        };
                                        switch (val.ty.kind != LK.INT | iv.ty.kind != LK.INT)
                                        {
                                            case (true) {
                                            this.unsup(n, g"bit index operand\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                ix = iv;
                                                switch (iv.ty.width < 32)
                                                {
                                                    case (true) { ix = this.mod.cast(g"zext\0", iv, this.t_i32, g"bia_idx_ext\0"); }
                                                    default {
                                                        switch (iv.ty.width > 32)
                                                        {
                                                            case (true) { ix = this.mod.cast(g"trunc\0", iv, this.t_i32, g"bia_idx_trunc\0"); }
                                                            default {};
                                                        };
                                                    };
                                                };
                                                sh = this.mod.binop(g"sub\0", this.ci32(val.ty.width - 1), ix, g"bia_shift\0");
                                                wv = val;
                                                switch (val.ty.width < 32) { case (true) { wv = this.mod.cast(g"zext\0", val, this.t_i32, (byte*)0); } default {}; };
                                                shd = this.mod.binop(g"lshr\0", wv, sh, g"bia_shifted\0");
                                                bit = this.mod.binop(g"and\0", shd, this.ci32(1), g"bia_bit\0");
                                                -> this.mod.cast(g"trunc\0", bit, this.t_i8, g"bia_result\0");
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            int_to(IRValue* v, IRType* t) -> IRValue*
            {
                switch (v.ty.kind != LK.INT | t.kind != LK.INT)
                {
                    case (true) { -> v; }
                    default
                    {
                        switch (v.ty.width == t.width)
                        {
                            case (true) { -> v; }
                            default
                            {
                                switch (v.ty.width > t.width)
                                {
                                    case (true) { -> this.mod.cast(g"trunc\0", v, t, (byte*)0); }
                                    default
                                    {
                                        -> this.mod.cast(g"sext\0", v, t, (byte*)0);
                                    };
                                };
                            };
                        };
                    };
                };
            };


            x_comp(Node* n, int expected) -> IRValue*
            {
                IRType* et = this.t_i32;
                TypeSpec* vts = n.ts;
                Node* it = n.b;
                Node* sn;
                Node* en;
                IRType* at;
                IRType* rt;
                IRType** fl;
                IRValue* arr;
                IRValue* itarr;
                IRValue* rp;
                IRValue* sp;
                IRValue* sv;
                IRValue* ev;
                IRValue* xv;
                IRValue* idxp;
                IRValue* varp;
                IRValue* cur;
                IRValue* cidx;
                IRValue* ep;
                IRValue* cv;
                IRBlock* cond_b;
                IRBlock* body_b;
                IRBlock* end_b;
                int cnt;
                int i;
                switch (vts != (TypeSpec*)0)
                {
                    case (true) {
                    et = this.lower(vts, true, n.line);
                    switch (this.nerrors > this.body_errs)
                    {
                        case (true) {
                        this.unsup(n, g"comprehension element type\0");
                        -> (IRValue*)0;
                    }
                        default {};
                    };
                }
                    default { vts = this.lit_spec(DataType.SINT); };
                };
                switch (it.kind == NodeKind.ARRAY_LITERAL)
                {
                    case (true) {
                    cnt = node_count(it, 0);
                    at = this.mod.t_array(et, cnt);
                    arr = this.mod.alloca_here(at, g"comprehension_array\0");
                    itarr = this.mod.alloca_here(at, g"iterable_array\0");
                    while (i < cnt)
                    {
                        xv = this.visit(node_child(it, 0, i));
                        switch (this.bad)
                        {
                            case (true) { -> (IRValue*)0; }
                            default {};
                        };
                        switch (xv == (IRValue*)0)
                        {
                            case (true) {
                            this.unsup(n, g"void comprehension element\0");
                            -> (IRValue*)0;
                        }
                            default {};
                        };
                        xv = this.int_to(xv, et);
                        this.mod.ia[0] = this.ci32(0);
                        this.mod.ia[1] = this.ci32(i);
                        ep = this.mod.gep(itarr, this.mod.ia, 2, false, (byte*)0);
                        this.mod.store(xv, ep);
                        i++;
                    };
                    varp = this.mod.alloca_here(et, n.text);
                    this.define_var(n.text, varp, vts);
                    idxp = this.mod.alloca_here(this.t_i32, g"comp_index\0");
                    this.mod.store(this.ci32(0), idxp);
                    cond_b = this.mod.append_block(this.fn, g"comp_loop_cond\0");
                    body_b = this.mod.append_block(this.fn, g"comp_loop_body\0");
                    end_b = this.mod.append_block(this.fn, g"comp_loop_end\0");
                    this.mod.br(cond_b);
                    this.mod.position(this.fn, cond_b);
                    cidx = this.mod.load(idxp, (byte*)0);
                    cv = this.mod.icmp(g"slt\0", cidx, this.ci32(cnt), (byte*)0);
                    this.mod.cbr(cv, body_b, end_b);
                    this.mod.position(this.fn, body_b);
                    this.mod.ia[0] = this.ci32(0);
                    this.mod.ia[1] = cidx;
                    ep = this.mod.gep(itarr, this.mod.ia, 2, false, (byte*)0);
                    this.mod.store(this.mod.load(ep, (byte*)0), varp);
                    xv = this.visit(n.a);
                    switch (this.bad)
                    {
                        case (true) { -> (IRValue*)0; }
                        default {};
                    };
                    switch (xv == (IRValue*)0)
                    {
                        case (true) {
                        this.unsup(n, g"void comprehension expression\0");
                        -> (IRValue*)0;
                    }
                        default {};
                    };
                    xv = this.int_to(xv, et);
                    this.mod.ia[0] = this.ci32(0);
                    this.mod.ia[1] = cidx;
                    ep = this.mod.gep(arr, this.mod.ia, 2, false, (byte*)0);
                    this.mod.store(xv, ep);
                    this.mod.store(this.mod.binop(g"add\0", cidx, this.ci32(1), (byte*)0), idxp);
                    this.mod.br(cond_b);
                    this.mod.position(this.fn, end_b);
                    -> arr;
                }
                    default
                    {
                        switch (it.kind != NodeKind.RANGE_EXPRESSION)
                        {
                            case (true) {
                            this.unsup(n, g"comprehension iterable\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                sn = it.a;
                                en = it.b;

                                sv = this.visit(sn);
                                switch (this.bad)
                                {
                                    case (true) { -> (IRValue*)0; }
                                    default
                                    {
                                        ev = this.visit(en);
                                        switch (this.bad)
                                        {
                                            case (true) { -> (IRValue*)0; }
                                            default
                                            {
                                                switch (sv == (IRValue*)0 | ev == (IRValue*)0)
                                                {
                                                    case (true) {
                                                    this.unsup(n, g"void range bound\0");
                                                    -> (IRValue*)0;
                                                }
                                                    default
                                                    {
                                                        fl = (IRType**)fmalloc((u64)3 * (u64)((sizeof(IRType*) + 7) / 8));
                                                        this.keep((void*)fl);
                                                        fl[0] = et;
                                                        fl[1] = et;
                                                        rt = this.mod.t_struct(fl, 2);
                                                        rp = this.mod.alloca_here(rt, g"range\0");
                                                        sv = this.range_fit(sv, et);
                                                        ev = this.range_fit(ev, et);
                                                        this.mod.ia[0] = this.ci32(0);
                                                        this.mod.ia[1] = this.ci32(0);
                                                        sp = this.mod.gep(rp, this.mod.ia, 2, true, (byte*)0);
                                                        this.mod.store(sv, sp);
                                                        this.mod.ia[0] = this.ci32(0);
                                                        this.mod.ia[1] = this.ci32(1);
                                                        sp = this.mod.gep(rp, this.mod.ia, 2, true, (byte*)0);
                                                        this.mod.store(ev, sp);
                                                        sv = this.visit(sn);
                                                        ev = this.visit(en);
                                                        sv = this.int_to(sv, et);
                                                        ev = this.int_to(ev, et);
                                                        switch (sn.kind == NodeKind.LITERAL & en.kind == NodeKind.LITERAL)
                                                        {
                                                            case (true) { cnt = (int)(en.ival - sn.ival + (i64)1); }
                                                            default {
                                                                switch (expected < 0)
                                                                {
                                                                    case (true) {
                                                                    this.unsup(n, g"comprehension without size\0");
                                                                    -> (IRValue*)0;
                                                                }
                                                                    default
                                                                    {
                                                                        cnt = expected;
                                                                    };
                                                                };
                                                            };
                                                        };
                                                        at = this.mod.t_array(et, cnt);
                                                        arr = this.mod.alloca_here(at, g"comprehension_array\0");
                                                        idxp = this.mod.alloca_here(this.t_i32, g"comp_index\0");
                                                        this.mod.store(this.ci32(0), idxp);
                                                        varp = this.mod.alloca_here(et, n.text);
                                                        this.define_var(n.text, varp, vts);
                                                        sv = this.int_to(sv, et);
                                                        ev = this.int_to(ev, et);
                                                        cond_b = this.mod.append_block(this.fn, g"comp_loop_cond\0");
                                                        body_b = this.mod.append_block(this.fn, g"comp_loop_body\0");
                                                        end_b = this.mod.append_block(this.fn, g"comp_loop_end\0");
                                                        this.mod.store(sv, varp);
                                                        this.mod.br(cond_b);
                                                        this.mod.position(this.fn, cond_b);
                                                        cur = this.mod.load(varp, g"current_var\0");
                                                        cv = this.mod.icmp(g"sle\0", cur, ev, g"loop_cond\0");
                                                        this.mod.cbr(cv, body_b, end_b);
                                                        this.mod.position(this.fn, body_b);
                                                        xv = this.visit(n.a);
                                                        switch (this.bad)
                                                        {
                                                            case (true) { -> (IRValue*)0; }
                                                            default
                                                            {
                                                                switch (xv == (IRValue*)0)
                                                                {
                                                                    case (true) {
                                                                    this.unsup(n, g"void comprehension expression\0");
                                                                    -> (IRValue*)0;
                                                                }
                                                                    default
                                                                    {
                                                                        xv = this.int_to(xv, et);
                                                                        cidx = this.mod.load(idxp, g"current_index\0");
                                                                        this.mod.ia[0] = this.ci32(0);
                                                                        this.mod.ia[1] = cidx;
                                                                        ep = this.mod.gep(arr, this.mod.ia, 2, true, (byte*)0);
                                                                        this.mod.store(xv, ep);
                                                                        this.mod.store(this.mod.binop(g"add\0", cidx, this.ci32(1), g"next_index\0"), idxp);
                                                                        this.mod.store(this.mod.binop(g"add\0", cur, this.mod.c_int(et, (i64)1), g"next_var\0"), varp);
                                                                        this.mod.br(cond_b);
                                                                        this.mod.position(this.fn, end_b);
                                                                        -> arr;
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            range_fit(IRValue* v, IRType* t) -> IRValue*
            {
                switch (v.ty.kind != LK.INT | t.kind != LK.INT)
                {
                    case (true) { -> v; }
                    default
                    {
                        switch (v.ty.width == t.width)
                        {
                            case (true) { -> v; }
                            default
                            {
                                switch (v.ty.width > t.width)
                                {
                                    case (true) { -> this.mod.cast(g"trunc\0", v, t, (byte*)0); }
                                    default
                                    {
                                        -> this.mod.cast(g"sext\0", v, t, (byte*)0);
                                    };
                                };
                            };
                        };
                    };
                };
            };



            init_slot(IRValue* alloca, IRType* lt, Node* ini, Node* n) -> bool
            {
                IRValue* iv;
                int cexp;
                switch (ini != (Node*)0)
                {
                    case (true) {
                    switch (ini.kind == NodeKind.NO_INIT)
                    {
                        case (true) { -> true; }
                        default {};
                    };
                    switch (ini.kind == NodeKind.ARRAY_COMPREHENSION)
                    {
                        case (true) {
                        cexp = -1;
                        switch (lt.kind == LK.ARRAY)
                        {
                            case (true) { cexp = lt.count; }
                            default {};
                        };
                        iv = this.x_comp(ini, cexp);
                        switch (this.bad | iv == (IRValue*)0)
                        {
                            case (true) { -> false; }
                            default {};
                        };
                        this.mod.store(this.mod.load(iv, g"comp_array_load\0"), alloca);
                        -> true;
                    }
                        default {};
                    };
                    switch (ini.kind == NodeKind.ARRAY_LITERAL)
                    {
                        case (true) {
                        this.init_local_array(alloca, lt, ini);
                        -> true;
                    }
                        default {};
                    };
                    switch (ini.kind == NodeKind.STRING_LITERAL)
                    {
                        case (true) {
                        this.init_local_string(alloca, lt, ini);
                        -> true;
                    }
                        default {};
                    };
                    switch (ini.kind == NodeKind.FUNCTION_CALL & ini.text != (byte*)0)
                    {
                        case (true) {
                        switch (ends_with(ini.text, g".__init\0"))
                        {
                            case (true) {
                            this.init_ctor(alloca, lt, ini, n);
                            -> true;
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    switch (ini.kind == NodeKind.STRUCT_LITERAL & lt.kind == LK.ISTRUCT)
                    {
                        case (true) { iv = this.x_struct_lit(ini, lt); }
                        default { iv = this.visit(ini); };
                    };
                    switch (this.bad)
                    {
                        case (true) { -> false; }
                        default {};
                    };
                    switch (iv != (IRValue*)0)
                    {
                        case (true) {
                        this.store_conv(alloca, lt, iv, ini, n);
                    }
                        default {};
                    };
                    -> true;
                }
                    default
                    {
                        switch (lt.kind == LK.ARRAY)
                        {
                            case (true) {
                            switch (lt.count > 64)
                            {
                                case (true) {
                                this.memset_zero(alloca, lt);
                                -> true;
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                        this.mod.store(this.zero_of(lt), alloca);
                        -> true;
                    };
                };
            };


            vardecl_auto(Node* n) -> IRValue*
            {
                Node* ini = n.a;
                IRValue* rv;
                IRValue* alloca;
                TypeSpec* its;
                int k;
                int w;
                int d;
                int bt;
                IRType* et;
                switch (ini == (Node*)0)
                {
                    case (true) {
                    this.unsup(n, g"auto without initializer\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        rv = this.visit(ini);
                        switch (this.bad | rv == (IRValue*)0)
                        {
                            case (true) { -> (IRValue*)0; }
                            default
                            {

                                its = rv.spec;
                                switch (ini.kind == NodeKind.LITERAL)
                                {
                                    case (true) { its = (TypeSpec*)0; }
                                    default {};
                                };
                                switch (its == (TypeSpec*)0)
                                {
                                    case (true) {
                                    k = rv.ty.kind;
                                    w = rv.ty.width;
                                    switch (k == LK.INT)
                                    {
                                        case (true) {
                                        switch (w == 1) { case (true) { its = this.lit_spec(DataType.BOOL); } default {}; };
                                        switch (w == 8) { case (true) { its = this.lit_spec(DataType.BYTE); } default {}; };
                                        switch (w == 32) { case (true) { its = this.lit_spec(DataType.SINT); } default {}; };
                                        switch (w == 64) { case (true) { its = this.lit_spec(DataType.SLONG); } default {}; };
                                    }
                                        default {};
                                    };
                                    switch (k == LK.PTR)
                                    {
                                        case (true) {
                                        d = 0;
                                        et = rv.ty;
                                        while (et.kind == LK.PTR)
                                        {
                                            d++;
                                            et = et.elem;
                                        };
                                        bt = -1;
                                        switch (et.kind == LK.INT & et.width == 8) { case (true) { bt = DataType.BYTE; } default {}; };
                                        switch (et.kind == LK.INT & et.width == 32) { case (true) { bt = DataType.SINT; } default {}; };
                                        switch (et.kind == LK.INT & et.width == 64) { case (true) { bt = DataType.SLONG; } default {}; };
                                        switch (et.kind == LK.FLOAT) { case (true) { bt = DataType.FLOAT; } default {}; };
                                        switch (et.kind == LK.DOUBLE) { case (true) { bt = DataType.DOUBLE; } default {}; };
                                        switch (bt >= 0)
                                        {
                                            case (true) {
                                            its = typespec_copy(this.lit_spec(bt));
                                            its.pointer_depth = d;
                                            this.keep((void*)its);
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    switch (k == LK.FLOAT) { case (true) { its = this.lit_spec(DataType.FLOAT); } default {}; };
                                    switch (k == LK.DOUBLE) { case (true) { its = this.lit_spec(DataType.DOUBLE); } default {}; };
                                }
                                    default {};
                                };
                                switch (its == (TypeSpec*)0)
                                {
                                    case (true) {
                                    this.unsup(n, g"auto variable type\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        alloca = this.mod.alloca(rv.ty, n.text);
                                        alloca.spec = its;
                                        this.mod.store(rv, alloca);
                                        this.define_var(n.text, alloca, its);
                                        -> alloca;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            x_vardecl(Node* n) -> IRValue*
            {
                TypeSpec* ts = n.ts;
                IRType* lt;
                IRValue* alloca;
                LVar* lv;
                Node* dimn;
                IRValue* cv;
                Node* ini = n.a;
                switch (this.fn == (IRFunc*)0 | (n.flags `& 4) != 0)
                {
                    case (true) {
                    this.unsup(n, g"global variable\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (ts == (TypeSpec*)0)
                        {
                            case (true) {
                            this.unsup(n, g"declaration without type\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (ts.base_type == DataType.DICT)
                                {
                                    case (true) { -> this.vardecl_dict(n, ts); }
                                    default
                                    {
                                        switch (ts.storage_class == StorageClass.AUTO)
                                        {
                                            case (true) {
                                            -> this.vardecl_auto(n);
                                        }
                                            default
                                            {
                                                switch ((ts.flags `& 32) != 0 & ts.array_size == (Node*)0 & (ts.array_dims == (NodeVec*)0 | this.dims_empty(ts)) & ini != (Node*)0)
                                                {
                                                    case (true) {
                                                    switch (ini.kind == NodeKind.ARRAY_LITERAL & (ini.flags `& 8) == 0)
                                                    {
                                                        case (true) { ts = this.sized_by_literal(ts, ini, n); }
                                                        default {};
                                                    };

                                                    switch (ini.kind == NodeKind.STRING_LITERAL & (ini.flags `& 8) == 0 & ini.op != StorageClass.HEAP)
                                                    {
                                                        case (true) {
                                                        this.str_bytes(ini);
                                                        ts = this.sized_to(ts, this.q_len, n);
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch ((ts.flags `& 32) != 0 & ts.array_size == (Node*)0 & ts.array_dims == (NodeVec*)0)
                                                {
                                                    case (true) {
                                                    this.unsup(n, g"array without size\0");
                                                    -> (IRValue*)0;
                                                }
                                                    default
                                                    {
                                                        lt = this.lower(ts, true, n.line);
                                                        switch (this.nerrors > this.body_errs)
                                                        {
                                                            case (true) {
                                                            this.unsup(n, g"variable type lowering\0");
                                                            -> (IRValue*)0;
                                                        }
                                                            default
                                                            {
                                                                dimn = (Node*)0;
                                                                switch (lt.kind == LK.PTR & (ts.flags `& 32) != 0)
                                                                {
                                                                    case (true) {
                                                                    switch (ts.array_dims != (NodeVec*)0)
                                                                    {
                                                                        case (true) {
                                                                        switch (ts.array_dims.len > 0)
                                                                        {
                                                                            case (true) { dimn = (Node*)ts.array_dims.items[0]; }
                                                                            default {};
                                                                        };
                                                                    }
                                                                        default {};
                                                                    };
                                                                    switch (dimn == (Node*)0)
                                                                    {
                                                                        case (true) { dimn = ts.array_size; }
                                                                        default {};
                                                                    };
                                                                }
                                                                    default {};
                                                                };
                                                                switch (dimn != (Node*)0)
                                                                {
                                                                    case (true) {

                                                                    cv = this.visit(dimn);
                                                                    switch (this.bad)
                                                                    {
                                                                        case (true) { -> (IRValue*)0; }
                                                                        default {};
                                                                    };
                                                                    switch (cv == (IRValue*)0)
                                                                    {
                                                                        case (true) {
                                                                        this.unsup(n, g"variable length array\0");
                                                                        -> (IRValue*)0;
                                                                    }
                                                                        default {};
                                                                    };
                                                                    alloca = this.mod.alloca_count(lt.elem, cv, n.text);
                                                                    alloca.spec = ts;
                                                                    this.define_var(n.text, alloca, ts);
                                                                    -> alloca;
                                                                }
                                                                    default
                                                                    {
                                                                        switch (ini != (Node*)0)
                                                                        {
                                                                            case (true) {
                                                                            switch (ini.kind == NodeKind.STRUCT_RECAST)
                                                                            {
                                                                                case (true) {
                                                                                alloca = this.x_recast(ini);
                                                                                switch (this.bad | alloca == (IRValue*)0)
                                                                                {
                                                                                    case (true) { -> (IRValue*)0; }
                                                                                    default {};
                                                                                };

                                                                                switch (alloca.ty.kind != LK.PTR)
                                                                                {
                                                                                    case (true) {
                                                                                    this.unsup(n, g"struct recast by value\0");
                                                                                    -> (IRValue*)0;
                                                                                }
                                                                                    default {};
                                                                                };
                                                                                alloca.spec = ts;
                                                                                this.define_var(n.text, alloca, ts);

                                                                                switch (ini.ival == (i64)0)
                                                                                {
                                                                                    case (true) { this.recast_invalidate(ini.a); }
                                                                                    default {};
                                                                                };
                                                                                -> alloca;
                                                                            }
                                                                                default
                                                                                {
                                                                                    switch (ini.kind == NodeKind.FUNCTION_CALL)
                                                                                    {
                                                                                        case (true) {
                                                                                        switch (ini.text != (byte*)0)
                                                                                        {
                                                                                            case (true) {
                                                                                            switch (ends_with(ini.text, g".__init\0"))
                                                                                            {
                                                                                                case (true) {
                                                                                                switch (ini.text3 == (byte*)0 | node_count(ini, 0) > 0 & lt.kind != LK.ISTRUCT)
                                                                                                {
                                                                                                    case (true) {
                                                                                                    this.unsup(n, g"constructor initializer\0");
                                                                                                    -> (IRValue*)0;
                                                                                                }
                                                                                                    default {};
                                                                                                };
                                                                                            }
                                                                                                default {};
                                                                                            };
                                                                                        }
                                                                                            default {};
                                                                                        };
                                                                                    }
                                                                                        default {};
                                                                                    };
                                                                                    switch (ini.kind == NodeKind.STRING_LITERAL & this.str_init_ok(lt, ini))
                                                                                    {
                                                                                        case (true) { }
                                                                                        default {
                                                                                            switch (ini.kind == NodeKind.ARRAY_LITERAL & this.simple_array_init(lt, ini))
                                                                                            {
                                                                                                case (true) { }
                                                                                                default {
                                                                                                    switch (ini.kind == NodeKind.STRUCT_LITERAL & lt.kind == LK.ISTRUCT)
                                                                                                    {
                                                                                                        case (true) { }
                                                                                                        default {
                                                                                                            switch (ini.kind == NodeKind.ARRAY_LITERAL |
                                                                                        ini.kind == NodeKind.STRING_LITERAL | ini.kind == NodeKind.STRUCT_LITERAL)
                                                                                                            {
                                                                                                                case (true) {
                                                                                        this.unsup(n, g"aggregate initializer\0");
                                                                                        -> (IRValue*)0;
                                                                                    }
                                                                                                                default {};
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                    switch (lt.kind == LK.ARRAY & ini.kind == NodeKind.IDENTIFIER)
                                                                                    {
                                                                                        case (true) {
                                                                                        this.unsup(n, g"array copy initializer\0");
                                                                                        -> (IRValue*)0;
                                                                                    }
                                                                                        default {};
                                                                                    };
                                                                                };
                                                                            };
                                                                        }
                                                                            default {};
                                                                        };
                                                                        switch (ts.storage_class == StorageClass.SINGINIT)
                                                                        {
                                                                            case (true) { -> this.vardecl_singinit(n, lt, ts); }
                                                                            default
                                                                            {
                                                                                switch (ts.storage_class == StorageClass.HEAP)
                                                                                {
                                                                                    case (true) { -> this.vardecl_heap(n, lt, ts); }
                                                                                    default
                                                                                    {
                                                                                        alloca = this.mod.alloca(lt, n.text);
                                                                                        alloca.spec = ts;
                                                                                        lv = this.define_var(n.text, alloca, ts);
                                                                                        switch ((ts.flags `& 4) != 0)
                                                                                        {
                                                                                            case (true) { lv.vol = true; }
                                                                                            default {};
                                                                                        };
                                                                                        switch (!this.init_slot(alloca, lt, ini, n))
                                                                                        {
                                                                                            case (true) { -> (IRValue*)0; }
                                                                                            default
                                                                                            {
                                                                                                -> alloca;
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };





            s_block(Node* n) -> void
            {
                int i;
                int c = node_count(n, 0);
                PtrVec* outer = this.defers;
                this.defers = (PtrVec*)0;
                while (i < c)
                {
                    switch (this.mod.is_terminated())
                    {
                        case (true) { break; }
                        default
                        {
                            this.visit(node_child(n, 0, i));
                            switch (this.bad)
                            {
                                case (true) { break; }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                    };
                };
                switch (!this.bad & !this.mod.is_terminated())
                {
                    case (true) { this.run_defers(); }
                    default {};
                };
                switch (this.defers != (PtrVec*)0)
                {
                    case (true) { pv_free(this.defers); }
                    default {};
                };
                this.defers = outer;
                ->;
            };


            run_defers() -> void
            {
                int i;
                int j;
                Node* d;
                switch (this.defers == (PtrVec*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        i = this.defers.len - 1;
                        while (i >= 0)
                        {
                            d = (Node*)this.defers.items[i];
                            switch ((d.flags `& 32) != 0)
                            {
                                case (true) {
                                j = node_count(d, 0) - 1;
                                while (j >= 0)
                                {
                                    this.visit(node_child(d, 0, j));
                                    switch (this.bad)
                                    {
                                        case (true) { ->; }
                                        default
                                        {
                                            j--;
                                        };
                                    };
                                };
                            }
                                default { this.visit(d.a); };
                            };
                            switch (this.bad)
                            {
                                case (true) { ->; }
                                default
                                {
                                    i--;
                                };
                            };
                        };
                        ->;
                    };
                };
            };

            check_cond_node(Node* c) -> void
            {
                switch (c.kind == NodeKind.STRING_LITERAL | c.kind == NodeKind.F_STRING_LITERAL)
                {
                    case (true) {
                    this.unsup(c, g"string literal condition\0");
                }
                    default {};
                };
                ->;
            };

            cond_value(Node* c) -> IRValue*
            {
                IRValue* v;
                this.check_cond_node(c);
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        v = this.visit(c);
                        switch (this.bad)
                        {
                            case (true) { -> (IRValue*)0; }
                            default
                            {
                                switch (v == (IRValue*)0)
                                {
                                    case (true) {
                                    this.unsup(c, g"void condition\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        -> this.to_bool(v);
                                    };
                                };
                            };
                        };
                    };
                };
            };



            s_assert(Node* n) -> void
            {
                IRValue* cv = this.cond_value(n.a);
                bool bad_msg;
                IRBlock* pass_b;
                IRBlock* fail_b;
                IRFunc* pf;
                IRFunc* ef;
                IRType** ps;
                IRValue* mp;
                IRValue* cvs;
                IRGlobal* gl;
                IRType* aty;
                byte* src;
                byte* buf;
                int len;
                int i;
                byte[24] dig;
                int nd;
                u64 id = (u64)n;
                Buf gn;
                switch (this.bad)
                {
                    case (true) { ->; }
                    default
                    {
                        bad_msg = false;
                        switch (n.b != (Node*)0) { case (true) { bad_msg = n.b.kind != NodeKind.STRING_LITERAL; } default {}; };
                        switch (bad_msg)
                        {
                            case (true) {
                            -> this.unsup(n, g"assert with non-literal message\0");
                        }
                            default
                            {
                                pass_b = this.mod.append_block(this.fn, g"assert.pass\0");
                                fail_b = this.mod.append_block(this.fn, g"assert.fail\0");
                                this.mod.cbr(cv, pass_b, fail_b);
                                this.mod.position(this.fn, fail_b);
                                switch (n.b != (Node*)0)
                                {
                                    case (true) {
                                    src = n.b.text;
                                    switch (src == (byte*)0) { case (true) { src = g"\0"; } default {}; };
                                    len = (int)n.b.ival;
                                    switch (len <= 0)
                                    {
                                        case (true) { while (src[len] != 0) { len++; }; }
                                        default {};
                                    };
                                    buf = (byte*)this.zbuf((len + 8) / 8 + 1);
                                    while (i < len)
                                    {
                                        buf[i] = src[i];
                                        i++;
                                    };
                                    switch (this.null_term)
                                    {
                                        case (true) {
                                        switch (len == 0 | buf[len - 1] != (byte)0)
                                        {
                                            case (true) { buf[len] = (byte)0; len++; }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    aty = this.mod.t_array(this.t_i8, len);
                                    cvs = this.mod.c_bytes(aty, buf, len);
                                    gn.__init();
                                    defer gn.__exit();
                                    gn.put_str(g"assert_msg_\0");
                                    if (id == (u64)0) { dig[0] = '0'; nd = 1; };
                                    while (id > (u64)0)
                                    {
                                        dig[nd] = (byte)('0' + (int)(id % (u64)10));
                                        nd++;
                                        id = id / (u64)10;
                                    };
                                    while (nd > 0)
                                    {
                                        nd--;
                                        gn.put(dig[nd]);
                                    };
                                    gl = this.mod.add_global(aty, gn.mem, cvs.text);
                                    gl.linkage = this.mod.own(g"internal\0");
                                    gl.constant = true;
                                    this.mark_arr_ptr(gl.self.ty);
                                    this.mod.ia[0] = this.ci32(0);
                                    this.mod.ia[1] = this.ci32(0);
                                    mp = this.mod.gep(gl.self, this.mod.ia, 2, true, (byte*)0);
                                    pf = this.mod.find_function(g"print\0");
                                    switch (pf == (IRFunc*)0)
                                    {
                                        case (true) {
                                        pf = this.mod.find_function(g"puts\0");
                                        switch (pf == (IRFunc*)0)
                                        {
                                            case (true) {
                                            ps = (IRType**)fmalloc((u64)2 * (u64)((sizeof(IRType*) + 7) / 8));
                                            this.keep((void*)ps);
                                            ps[0] = this.t_i8p;
                                            pf = this.mod.add_function(this.mod.t_func(this.t_i32, ps, 1, false), g"puts\0");
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    this.mod.ia[0] = mp;
                                    this.mod.call(pf.self, this.mod.ia, 1, (byte*)0);
                                }
                                    default {};
                                };
                                ef = this.mod.find_function(g"ExitProcess\0");
                                switch (ef == (IRFunc*)0)
                                {
                                    case (true) {
                                    ps = (IRType**)fmalloc((u64)2 * (u64)((sizeof(IRType*) + 7) / 8));
                                    this.keep((void*)ps);
                                    ps[0] = this.t_i32;
                                    ef = this.mod.add_function(this.mod.t_func(this.t_void, ps, 1, false), g"ExitProcess\0");
                                }
                                    default {};
                                };
                                this.mod.ia[0] = this.ci32(1);
                                this.mod.call(ef.self, this.mod.ia, 1, (byte*)0);
                                this.mod.unreachable();
                                this.mod.position(this.fn, pass_b);
                            };
                        };
                    };
                };
            };

            s_if(Node* n) -> void
            {
                IRValue* cv;
                IRBlock* then_b;
                IRBlock* else_b;
                IRBlock* merge_b;
                IRBlock* et;
                IRBlock* ee;
                int i;
                int ne = node_count(n, 0);
                cv = this.cond_value(n.a);
                switch (this.bad)
                {
                    case (true) { ->; }
                    default
                    {
                        then_b = this.mod.append_block(this.fn, g"then\0");
                        else_b = this.mod.append_block(this.fn, g"else\0");
                        merge_b = this.mod.append_block(this.fn, g"ifcont\0");
                        this.mod.cbr(cv, then_b, else_b);
                        this.mod.position(this.fn, then_b);
                        this.visit(n.b);
                        switch (this.bad)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch (!this.mod.is_terminated())
                                {
                                    case (true) { this.mod.br(merge_b); }
                                    default {};
                                };
                                this.mod.position(this.fn, else_b);
                                while (i < ne)
                                {
                                    cv = this.cond_value(node_child(n, 0, i));
                                    switch (this.bad)
                                    {
                                        case (true) { ->; }
                                        default
                                        {
                                            this.sc.clear();
                                            this.sc.put_str(f"elif_then_{i}\0");
                                            et = this.mod.append_block(this.fn, this.sc.mem);
                                            this.sc.clear();
                                            this.sc.put_str(f"elif_else_{i}\0");
                                            ee = this.mod.append_block(this.fn, this.sc.mem);
                                            this.mod.cbr(cv, et, ee);
                                            this.mod.position(this.fn, et);
                                            this.visit(node_child(n, 1, i));
                                            switch (this.bad)
                                            {
                                                case (true) { ->; }
                                                default
                                                {
                                                    switch (!this.mod.is_terminated())
                                                    {
                                                        case (true) { this.mod.br(merge_b); }
                                                        default {};
                                                    };
                                                    this.mod.position(this.fn, ee);
                                                    i++;
                                                };
                                            };
                                        };
                                    };
                                };
                                switch (n.c != (Node*)0)
                                {
                                    case (true) {
                                    this.visit(n.c);
                                    switch (this.bad)
                                    {
                                        case (true) { ->; }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (!this.mod.is_terminated())
                                {
                                    case (true) { this.mod.br(merge_b); }
                                    default {};
                                };
                                -> this.mod.position(this.fn, merge_b);
                            };
                        };
                    };
                };
            };


            const_i64(IRValue* v) -> i64
            {
                byte* t = v.text;
                i64 r;
                int i;
                bool neg;
                switch (t[0] == 't')
                {
                    case (true) { -> (i64)1; }
                    default
                    {
                        switch (t[0] == 'f')
                        {
                            case (true) { -> (i64)0; }
                            default
                            {
                                switch (t[0] == '-')
                                {
                                    case (true) { neg = true; i = 1; }
                                    default {};
                                };
                                while (t[i] >= '0' & t[i] <= '9')
                                {
                                    r = r * (i64)10 + (i64)(t[i] - '0');
                                    i++;
                                };
                                switch (neg)
                                {
                                    case (true) { r = (i64)0 - r; }
                                    default {};
                                };
                                -> r;
                            };
                        };
                    };
                };
            };



            case_value(Node* e) -> IRValue*
            {
                IRValue* r;
                IRValue* o;
                IRGlobal* g;
                byte* nm;
                byte* sfx;
                int i, ln, ls, c0;
                bool hit;
                switch (e.kind == NodeKind.UNARY_OP)
                {
                    case (true)
                    {
                        switch (e.op == Operator.SUB)
                        {
                            case (true)
                            {
                                o = this.case_value(e.a);
                                switch (o == (IRValue*)0)
                                {
                                    case (true) { -> o; }
                                    default
                                    {
                                        switch (o.is_const & o.ty.kind == LK.INT)
                                        {
                                            case (true) { -> this.mod.c_int(o.ty, (i64)0 - this.const_i64(o)); }
                                            default
                                            {
                                                -> o;
                                            };
                                        };
                                    };
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                switch (e.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        switch (e.text != (byte*)0)
                        {
                            case (true)
                            {
                                nm = colons_to_underscores(e.text);
                                sfx = join3(g"__\0", nm, g"\0");
                                ls = pp_cstrlen(sfx);
                                while (i < this.mod.globals.len & !hit)
                                {
                                    g = (IRGlobal*)this.mod.globals.items[i];
                                    i++;
                                    switch (g.init == (byte*)0)
                                    {
                                        case (true) { continue; }
                                        default
                                        {
                                            switch (g.ty.kind != LK.INT)
                                            {
                                                case (true) { continue; }
                                                default
                                                {
                                                    ln = pp_cstrlen(g.name);
                                                    hit = cstr_eq(g.name, nm);
                                                    switch (!hit & ln >= ls)
                                                    {
                                                        case (true) { hit = pp_eq(g.name + ln - ls, sfx, ls); }
                                                        default {};
                                                    };
                                                    c0 = (int)g.init[0];
                                                    switch (hit & !((c0 >= '0' & c0 <= '9') | c0 == '-' | c0 == 't' | c0 == 'f'))
                                                    {
                                                        case (true) { hit = false; }
                                                        default {};
                                                    };
                                                    switch (hit)
                                                    {
                                                        case (true)
                                                        {
                                                            r = this.mod.new_value(g.ty, g.init);
                                                            r.is_const = true;
                                                        }
                                                        default {};
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                                ffree(nm);
                                ffree(sfx);
                                switch (hit)
                                {
                                    case (true) { -> r; }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                -> this.visit(e);
            };





            s_switch_typeof(Node* n) -> void
            {
                int i;
                int j;
                int nc = node_count(n, 0);
                int ncase;
                int cid;
                bool dup;
                bool all_typeof = true;
                byte* nm;
                Node* c;
                IRValue* sv;
                IRValue** vals;
                IRBlock** blocks;
                IRBlock** bodies;
                IRBlock* merge_b;
                IRBlock* dflt_b;
                int* ids;
                while (i < nc)
                {
                    c = node_child(n, 0, i);
                    switch (c.a != (Node*)0)
                    {
                        case (true) {
                        switch (c.a.kind != NodeKind.TYPE_OF)
                        {
                            case (true) { all_typeof = false; }
                            default {};
                        };
                    }
                        default {};
                    };
                    i++;
                };
                switch (!all_typeof)
                {
                    case (true) { -> this.s_switch_typeof_chain(n); }
                    default {};
                };
                nm = this.typeof_name(n.a);
                switch (nm == (byte*)0)
                {
                    case (true) { ->; }
                    default {};
                };
                sv = this.ci32(this.typeof_id(nm));
                merge_b = this.mod.append_block(this.fn, g"switch_typeof_merge\0");
                vals = (IRValue**)fmalloc((u64)(nc + 1) * (u64)((sizeof(IRValue*) + 7) / 8));
                this.keep((void*)vals);
                blocks = (IRBlock**)fmalloc((u64)(nc + 1) * (u64)((sizeof(IRBlock*) + 7) / 8));
                this.keep((void*)blocks);
                bodies = (IRBlock**)fmalloc((u64)(nc + 1) * (u64)((sizeof(IRBlock*) + 7) / 8));
                this.keep((void*)bodies);
                ids = (int*)fmalloc((u64)(nc + 1) * (u64)((sizeof(int) + 7) / 8));
                this.keep((void*)ids);
                i = 0;
                while (i < nc)
                {
                    c = node_child(n, 0, i);
                    switch (c.a == (Node*)0)
                    {
                        case (true) {
                        dflt_b = this.mod.append_block(this.fn, g"switch_typeof_default\0");
                        bodies[i] = dflt_b;
                    }
                        default
                        {
                            bodies[i] = this.mod.append_block(this.fn, this.name_n(g"switch_typeof_case_\0", i));
                            nm = this.typeof_name(c.a);
                            switch (nm == (byte*)0)
                            {
                                case (true) { ->; }
                                default {};
                            };
                            cid = this.typeof_id(nm);

                            dup = false;
                            j = 0;
                            while (j < ncase)
                            {
                                switch (ids[j] == cid)
                                {
                                    case (true) { dup = true; }
                                    default {};
                                };
                                j++;
                            };
                            switch (!dup)
                            {
                                case (true) {
                                ids[ncase] = cid;
                                vals[ncase] = this.ci32(cid);
                                blocks[ncase] = bodies[i];
                                ncase++;
                            }
                                default {};
                            };
                        };
                    };
                    i++;
                };
                switch (dflt_b == (IRBlock*)0)
                {
                    case (true) { dflt_b = merge_b; }
                    default {};
                };
                this.mod.switch_to(sv, dflt_b, vals, blocks, ncase);
                i = 0;
                while (i < nc)
                {
                    c = node_child(n, 0, i);
                    this.mod.position(this.fn, bodies[i]);
                    this.visit(c.b);
                    switch (this.bad)
                    {
                        case (true) { ->; }
                        default {};
                    };
                    switch (!this.mod.is_terminated())
                    {
                        case (true) { this.mod.br(merge_b); }
                        default {};
                    };
                    i++;
                };
                -> this.mod.position(this.fn, merge_b);
            };




            s_switch_typeof_chain(Node* n) -> void
            {
                int i;
                int nc = node_count(n, 0);
                bool done;
                Node* c;
                IRValue* sp;
                IRValue* si8;
                IRValue* cp;
                IRValue* ci8;
                IRValue* cmpv;
                IRBlock* merge_b;
                IRBlock* dflt_b;
                IRBlock* next_b;
                IRBlock** bodies;
                sp = this.visit(n.a);
                switch (this.bad)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (sp == (IRValue*)0)
                        {
                            case (true) {
                            -> this.unsup(n, g"switch typeof value\0");
                        }
                            default
                            {
                                switch (sp.ty.kind != LK.PTR)
                                {
                                    case (true) {
                                    -> this.unsup(n, g"switch typeof value\0");
                                }
                                    default
                                    {
                                        switch (sp.ty.elem.kind != LK.ARRAY)
                                        {
                                            case (true) {
                                            -> this.unsup(n, g"switch typeof value\0");
                                        }
                                            default
                                            {
                                                this.mod.ia[0] = this.ci32(0);
                                                this.mod.ia[1] = this.ci32(0);
                                                si8 = this.mod.gep(sp, this.mod.ia, 2, false, g"typeof_ptr\0");
                                                merge_b = this.mod.append_block(this.fn, g"switch_typeof_merge\0");
                                                bodies = (IRBlock**)fmalloc((u64)(nc + 1) * (u64)((sizeof(IRBlock*) + 7) / 8));
                                                this.keep((void*)bodies);
                                                while (i < nc)
                                                {
                                                    c = node_child(n, 0, i);
                                                    switch (c.a == (Node*)0)
                                                    {
                                                        case (true) {
                                                        dflt_b = this.mod.append_block(this.fn, g"switch_typeof_default\0");
                                                        bodies[i] = dflt_b;
                                                    }
                                                        default {
                                                        bodies[i] = this.mod.append_block(this.fn, this.name_n(g"switch_typeof_case_\0", i));
                                                    };
                                                    };
                                                    i++;
                                                };
                                                switch (dflt_b == (IRBlock*)0)
                                                {
                                                    case (true) { dflt_b = merge_b; }
                                                    default {};
                                                };
                                                i = 0;
                                                while (i < nc & !done)
                                                {
                                                    c = node_child(n, 0, i);
                                                    switch (c.a == (Node*)0)
                                                    {
                                                        case (true) {
                                                        this.mod.br(dflt_b);
                                                        done = true;
                                                    }
                                                        default {
                                                        cp = this.visit(c.a);
                                                        switch (this.bad)
                                                        {
                                                            case (true) { ->; }
                                                            default
                                                            {
                                                                switch (cp == (IRValue*)0)
                                                                {
                                                                    case (true) {
                                                                    -> this.unsup(c.a, g"switch typeof case value\0");
                                                                }
                                                                    default
                                                                    {
                                                                        switch (cp.ty.kind != LK.PTR)
                                                                        {
                                                                            case (true) {
                                                                            -> this.unsup(c.a, g"switch typeof case value\0");
                                                                        }
                                                                            default
                                                                            {
                                                                                switch (cp.ty.elem.kind != LK.ARRAY)
                                                                                {
                                                                                    case (true) {
                                                                                    -> this.unsup(c.a, g"switch typeof case value\0");
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        this.mod.ia[0] = this.ci32(0);
                                                                                        this.mod.ia[1] = this.ci32(0);
                                                                                        ci8 = this.mod.gep(cp, this.mod.ia, 2, false, g"typeof_ptr\0");
                                                                                        cmpv = this.mod.icmp(g"eq\0", si8, ci8, this.name_n(g"typeof_cmp_\0", i));
                                                                                        next_b = this.mod.append_block(this.fn, this.name_n(g"switch_typeof_next_\0", i));
                                                                                        this.mod.cbr(cmpv, bodies[i], next_b);
                                                                                        this.mod.position(this.fn, next_b);
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                    };
                                                    i++;
                                                };
                                                switch (!done)
                                                {
                                                    case (true) { this.mod.br(dflt_b); }
                                                    default {};
                                                };
                                                i = 0;
                                                while (i < nc)
                                                {
                                                    c = node_child(n, 0, i);
                                                    this.mod.position(this.fn, bodies[i]);
                                                    this.visit(c.b);
                                                    switch (this.bad)
                                                    {
                                                        case (true) { ->; }
                                                        default
                                                        {
                                                            switch (!this.mod.is_terminated())
                                                            {
                                                                case (true) { this.mod.br(merge_b); }
                                                                default {};
                                                            };
                                                            i++;
                                                        };
                                                    };
                                                };
                                                -> this.mod.position(this.fn, merge_b);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            find_union_key(byte* name) -> byte*
            {
                IDKC_SYMENTRY* e;
                byte* m;
                byte* key;
                switch (nm_has(this.unions, name))
                {
                    case (true) { -> name; }
                    default
                    {
                        e = st_lookup_any(this.st, name, this.cur_ns);
                        switch (e == (IDKC_SYMENTRY*)0)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                switch (e.kind_id != SymbolKind.UNION)
                                {
                                    case (true) { -> (byte*)0; }
                                    default
                                    {
                                        m = sym_mangled(e);
                                        switch (!nm_has(this.unions, m))
                                        {
                                            case (true) {
                                            ffree(m);
                                            -> (byte*)0;
                                        }
                                            default
                                            {
                                                key = this.mod.own(m);
                                                ffree(m);
                                                -> key;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            name_lt(byte* a, byte* b) -> bool
            {
                int i;
                while (a[i] != (byte)0 & b[i] != (byte)0 & a[i] == b[i])
                {
                    i++;
                };
                -> (int)a[i] < (int)b[i];
            };



            check_tag_cover(Node* n) -> void
            {
                Node* ex = n.a;
                Node* c;
                Node* ed;
                Node* ud;
                Node* item;
                LVar* lv;
                byte* ukey;
                byte* ekey;
                byte* uname;
                byte* tname;
                byte* tmp;
                PtrVec* missing;
                void* p;
                int i, j, nc, ni;
                bool found;
                bool has_default;
                switch (ex.kind != NodeKind.MEMBER_ACCESS)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (ex.text == (byte*)0 | ex.a == (Node*)0)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch (ex.text[0] != '#')
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        switch (ex.text[1] != (byte)0)
                                        {
                                            case (true) { ->; }
                                            default
                                            {
                                                switch (ex.a.kind != NodeKind.IDENTIFIER)
                                                {
                                                    case (true) { ->; }
                                                    default
                                                    {
                                                        switch (ex.a.text == (byte*)0)
                                                        {
                                                            case (true) { ->; }
                                                            default
                                                            {
                                                                nc = node_count(n, 0);
                                                                while (i < nc)
                                                                {
                                                                    c = node_child(n, 0, i);
                                                                    switch (c.a == (Node*)0)
                                                                    {
                                                                        case (true) { has_default = true; }
                                                                        default {};
                                                                    };
                                                                    i++;
                                                                };
                                                                switch (has_default)
                                                                {
                                                                    case (true) { ->; }
                                                                    default
                                                                    {
                                                                        lv = this.find_var(ex.a.text);
                                                                        switch (lv == (LVar*)0)
                                                                        {
                                                                            case (true) { ->; }
                                                                            default
                                                                            {
                                                                                switch (lv.ts == (TypeSpec*)0)
                                                                                {
                                                                                    case (true) { ->; }
                                                                                    default
                                                                                    {
                                                                                        uname = lv.ts.custom_typename;
                                                                                        switch (uname == (byte*)0)
                                                                                        {
                                                                                            case (true) { ->; }
                                                                                            default
                                                                                            {
                                                                                                ukey = this.find_union_key(uname);
                                                                                                switch (ukey == (byte*)0)
                                                                                                {
                                                                                                    case (true) { ->; }
                                                                                                    default
                                                                                                    {
                                                                                                        p = nm_get(this.union_defs, ukey);
                                                                                                        switch (p == (void*)0)
                                                                                                        {
                                                                                                            case (true) { ->; }
                                                                                                            default
                                                                                                            {
                                                                                                                ud = (Node*)p;
                                                                                                                tname = ud.text2;
                                                                                                                switch (tname == (byte*)0)
                                                                                                                {
                                                                                                                    case (true) { ->; }
                                                                                                                    default
                                                                                                                    {
                                                                                                                        ekey = this.find_enum_key(tname);
                                                                                                                        switch (ekey == (byte*)0)
                                                                                                                        {
                                                                                                                            case (true) { ->; }
                                                                                                                            default
                                                                                                                            {
                                                                                                                                p = nm_get(this.enum_defs, ekey);
                                                                                                                                switch (p == (void*)0)
                                                                                                                                {
                                                                                                                                    case (true) { ->; }
                                                                                                                                    default
                                                                                                                                    {
                                                                                                                                        ed = (Node*)p;
                                                                                                                                        missing = pv_new();
                                                                                                                                        ni = node_count(ed, 0);
                                                                                                                                        i = 0;
                                                                                                                                        while (i < ni)
                                                                                                                                        {
                                                                                                                                            item = node_child(ed, 0, i);
                                                                                                                                            found = false;
                                                                                                                                            j = 0;
                                                                                                                                            while (j < nc & !found)
                                                                                                                                            {
                                                                                                                                                c = node_child(n, 0, j);
                                                                                                                                                switch (c.a != (Node*)0)
                                                                                                                                                {
                                                                                                                                                    case (true) {
                                                                                                                                                    switch (c.a.kind == NodeKind.MEMBER_ACCESS & c.a.text != (byte*)0)
                                                                                                                                                    {
                                                                                                                                                        case (true) { found = cstr_eq(c.a.text, item.text); }
                                                                                                                                                        default {};
                                                                                                                                                    };
                                                                                                                                                }
                                                                                                                                                    default {};
                                                                                                                                                };
                                                                                                                                                j++;
                                                                                                                                            };
                                                                                                                                            switch (!found)
                                                                                                                                            {
                                                                                                                                                case (true) { pv_push(missing, (void*)item.text); }
                                                                                                                                                default {};
                                                                                                                                            };
                                                                                                                                            i++;
                                                                                                                                        };
                                                                                                                                        switch (missing.len == 0)
                                                                                                                                        {
                                                                                                                                            case (true) {
                                                                                                                                            -> pv_free(missing);
                                                                                                                                        }
                                                                                                                                            default
                                                                                                                                            {
                                                                                                                                                i = 1;
                                                                                                                                                while (i < missing.len)
                                                                                                                                                {
                                                                                                                                                    tmp = (byte*)missing.items[i];
                                                                                                                                                    j = i - 1;
                                                                                                                                                    found = true;
                                                                                                                                                    while (found)
                                                                                                                                                    {
                                                                                                                                                        switch (j < 0)
                                                                                                                                                        {
                                                                                                                                                            case (true) { found = false; }
                                                                                                                                                            default {
                                                                                                                                                            found = this.name_lt(tmp, (byte*)missing.items[j]);
                                                                                                                                                        };
                                                                                                                                                        };
                                                                                                                                                        switch (found)
                                                                                                                                                        {
                                                                                                                                                            case (true) {
                                                                                                                                                            missing.items[j + 1] = missing.items[j];
                                                                                                                                                            j--;
                                                                                                                                                        }
                                                                                                                                                            default {};
                                                                                                                                                        };
                                                                                                                                                    };
                                                                                                                                                    missing.items[j + 1] = (void*)tmp;
                                                                                                                                                    i++;
                                                                                                                                                };
                                                                                                                                                this.sc.clear();
                                                                                                                                                this.sc.put_str(f"'{uname}' is tagged and thereby a sum type. Missing case(s): \0");
                                                                                                                                                i = 0;
                                                                                                                                                while (i < missing.len)
                                                                                                                                                {
                                                                                                                                                    switch (i > 0)
                                                                                                                                                    {
                                                                                                                                                        case (true) { this.sc.put_str(g", \0"); }
                                                                                                                                                        default {};
                                                                                                                                                    };
                                                                                                                                                    this.sc.put_str(f"{tname}.\0");
                                                                                                                                                    this.sc.put_str((byte*)missing.items[i]);
                                                                                                                                                    i++;
                                                                                                                                                };
                                                                                                                                                this.fail_at(n, this.sc.mem);
                                                                                                                                                this.unsup(n, g"switch exhaustiveness\0");
                                                                                                                                                -> pv_free(missing);
                                                                                                                                            };
                                                                                                                                        };
                                                                                                                                    };
                                                                                                                                };
                                                                                                                            };
                                                                                                                        };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            s_switch(Node* n) -> void
            {
                int i;
                int nc = node_count(n, 0);
                int ncase;
                Node* c;
                IRValue* sv;
                IRValue* cv;
                IRValue** vals;
                IRBlock** blocks;
                IRBlock** bodies;
                IRBlock* merge_b;
                IRBlock* dflt_b;
                bool merge_reach;
                switch (n.a.kind == NodeKind.TYPE_OF)
                {
                    case (true) {
                    -> this.s_switch_typeof(n);
                }
                    default
                    {
                        this.check_tag_cover(n);
                        switch (this.bad)
                        {
                            case (true) { ->; }
                            default
                            {
                                sv = this.visit(n.a);
                                switch (this.bad)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        switch (sv == (IRValue*)0)
                                        {
                                            case (true) {
                                            -> this.unsup(n, g"switch value\0");
                                        }
                                            default
                                            {
                                                switch (sv.ty.kind != LK.INT)
                                                {
                                                    case (true) {
                                                    -> this.unsup(n, g"switch on non-integer\0");
                                                }
                                                    default
                                                    {
                                                        merge_b = this.mod.append_block(this.fn, g"switch_merge\0");
                                                        vals = (IRValue**)fmalloc((u64)(nc + 1) * (u64)((sizeof(IRValue*) + 7) / 8));
                                                        this.keep((void*)vals);
                                                        blocks = (IRBlock**)fmalloc((u64)(nc + 1) * (u64)((sizeof(IRBlock*) + 7) / 8));
                                                        this.keep((void*)blocks);
                                                        bodies = (IRBlock**)fmalloc((u64)(nc + 1) * (u64)((sizeof(IRBlock*) + 7) / 8));
                                                        this.keep((void*)bodies);
                                                        while (i < nc)
                                                        {
                                                            c = node_child(n, 0, i);
                                                            switch (c.a == (Node*)0)
                                                            {
                                                                case (true) {
                                                                dflt_b = this.mod.append_block(this.fn, g"switch_default\0");
                                                                bodies[i] = dflt_b;
                                                            }
                                                                default {
                                                                bodies[i] = this.mod.append_block(this.fn, this.case_name(i));
                                                                cv = this.case_value(c.a);
                                                                switch (this.bad)
                                                                {
                                                                    case (true) { ->; }
                                                                    default
                                                                    {
                                                                        switch (cv == (IRValue*)0)
                                                                        {
                                                                            case (true) {
                                                                            -> this.unsup(c.a, g"switch case value\0");
                                                                        }
                                                                            default
                                                                            {
                                                                                switch (!cv.is_const | cv.ty.kind != LK.INT)
                                                                                {
                                                                                    case (true) {
                                                                                    -> this.unsup(c.a, g"switch case value\0");
                                                                                }
                                                                                    default
                                                                                    {

                                                                                        switch (sv.ty.kind == LK.INT & sv.ty.width == 1 & cv.ty.width != 1)
                                                                                        {
                                                                                            case (true) { vals[ncase] = this.mod.c_u64(sv.ty, (u64)(this.const_i64(cv) `& (i64)1)); }
                                                                                            default { vals[ncase] = this.mod.c_int(sv.ty, this.const_i64(cv)); };
                                                                                        };
                                                                                        blocks[ncase] = bodies[i];
                                                                                        ncase++;
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                            };
                                                            i++;
                                                        };
                                                        switch (dflt_b == (IRBlock*)0)
                                                        {
                                                            case (true) { dflt_b = merge_b; }
                                                            default {};
                                                        };
                                                        merge_reach = dflt_b == merge_b;
                                                        this.mod.switch_to(sv, dflt_b, vals, blocks, ncase);
                                                        i = 0;
                                                        while (i < nc)
                                                        {
                                                            c = node_child(n, 0, i);
                                                            this.mod.position(this.fn, bodies[i]);
                                                            this.visit(c.b);
                                                            switch (this.bad)
                                                            {
                                                                case (true) { ->; }
                                                                default
                                                                {
                                                                    switch (!this.mod.is_terminated())
                                                                    {
                                                                        case (true) { this.mod.br(merge_b); merge_reach = true; }
                                                                        default {};
                                                                    };
                                                                    i++;
                                                                };
                                                            };
                                                        };
                                                        this.mod.position(this.fn, merge_b);

                                                        if (!merge_reach) { this.mod.unreachable(); };
                                                        ->;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            case_name(int i) -> byte*
            {
                Buf nb;
                nb.__init();
                nb.put_str(f"switch_case_{i}\0");
                byte* r = ts_dup(nb.mem);
                this.keep((void*)r);
                nb.__exit();
                -> r;
            };

            s_try(Node* n) -> void
            {
                IRValue* flag;
                IRValue* fz;
                IRValue* fv;
                IRValue* hx;
                IRBlock* try_b;
                IRBlock* chk_b;
                IRBlock* end_b;
                IRBlock* first_c;
                IRBlock* cb;
                PtrVec* cbs = pv_new();
                int cc = node_count(n, 0);
                int i;
                Node* cl;
                IRValue* oflag = this.exc_flag;
                IRValue* ovalue = this.exc_value;
                IRValue* evp;
                IRValue* e64;
                IRValue* ev;
                IRValue* xv;
                IRType* et;
                int k;
                flag = this.mod.alloca_here(this.t_i1, g"exception_flag\0");
                evp = this.mod.alloca_here(this.t_i64, g"exception_value\0");
                this.exc_flag = flag;
                this.exc_value = evp;
                try_b = this.mod.append_block(this.fn, g"try.body\0");
                chk_b = this.mod.append_block(this.fn, g"catch.check\0");
                end_b = this.mod.append_block(this.fn, g"try.end\0");
                i = 0;
                while (i < cc)
                {
                    this.sc.clear();
                    this.sc.put_str(f"catch.{i}\0");
                    cb = this.mod.append_block(this.fn, this.sc.mem);
                    pv_push(cbs, (void*)cb);
                    i++;
                };
                fz = this.mod.new_value(this.t_i1, g"0\0");
                fz.is_const = true;
                this.exc_handler = chk_b;
                this.mod.store(fz, flag);
                this.mod.br(try_b);
                this.mod.position(this.fn, try_b);
                this.visit(n.a);
                switch (this.bad)
                {
                    case (true) { -> pv_free(cbs); }
                    default
                    {
                        switch (!this.mod.is_terminated())
                        {
                            case (true) { this.mod.br(chk_b); }
                            default {};
                        };
                        this.mod.position(this.fn, chk_b);
                        fv = this.mod.load(flag, g"exc_flag\0");
                        hx = this.mod.icmp(g"ne\0", fv, this.mod.c_int(this.t_i32, (i64)0), g"has_exception\0");
                        switch (cc > 0)
                        {
                            case (true) { first_c = (IRBlock*)cbs.items[0]; }
                            default { first_c = end_b; };
                        };
                        this.mod.cbr(hx, first_c, end_b);
                        i = 0;
                        while (i < cc)
                        {
                            cl = node_child(n, 0, i);
                            this.mod.position(this.fn, (IRBlock*)cbs.items[i]);
                            this.mod.store(fz, flag);
                            switch (cl.text != (byte*)0)
                            {
                                case (true) {
                                switch (cl.text[0] != (byte)0)
                                {
                                    case (true) {
                                    e64 = this.mod.load(evp, g"exc_val\0");
                                    et = this.t_i64;
                                    switch (cl.ts != (TypeSpec*)0)
                                    {
                                        case (true) {
                                        switch (!(cl.ts.storage_class == StorageClass.AUTO & cl.ts.base_type == DataType.VOID))
                                        {
                                            case (true) {
                                            et = this.lower(cl.ts, false, cl.line);
                                            switch (this.nerrors > this.body_errs)
                                            {
                                                case (true) {
                                                this.unsup(cl, g"catch type lowering\0");
                                                -> pv_free(cbs);
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    xv = this.mod.alloca_here(et, cl.text);
                                    switch (et.kind == LK.INT)
                                    {
                                        case (true) {
                                        switch (et.width < 64)
                                        {
                                            case (true) { ev = this.mod.cast(g"trunc\0", e64, et, g"exc_trunc\0"); }
                                            default {
                                                switch (et.width > 64)
                                                {
                                                    case (true) { ev = this.mod.cast(g"zext\0", e64, et, g"exc_ext\0"); }
                                                    default { ev = e64; };
                                                };
                                            };
                                        };
                                    }
                                        default {
                                            switch (et.kind == LK.PTR)
                                            {
                                                case (true) { ev = this.mod.cast(g"inttoptr\0", e64, et, g"exc_int_to_ptr\0"); }
                                                default {
                                                    this.unsup(cl, g"catch type\0");
                                                    -> pv_free(cbs);
                                                };
                                            };
                                        };
                                    };
                                    this.mod.store(ev, xv);
                                    this.define_var(cl.text, xv, (TypeSpec*)0);
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                            this.visit(cl.a);
                            switch (this.bad)
                            {
                                case (true) { -> pv_free(cbs); }
                                default
                                {
                                    switch (cl.text != (byte*)0)
                                    {
                                        case (true) {
                                        switch (cl.text[0] != (byte)0)
                                        {
                                            case (true) {
                                            k = this.scopes.len - 1;
                                            while (k >= 0)
                                            {
                                                switch (nm_get((NameMap*)this.scopes.items[k], cl.text) != (void*)0)
                                                {
                                                    case (true) {
                                                    nm_del((NameMap*)this.scopes.items[k], cl.text);
                                                    break;
                                                }
                                                    default
                                                    {
                                                        k--;
                                                    };
                                                };
                                            };
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    switch (!this.mod.is_terminated())
                                    {
                                        case (true) { this.mod.br(end_b); }
                                        default {};
                                    };
                                    i++;
                                };
                            };
                        };
                        pv_free(cbs);
                        this.exc_flag = oflag;
                        this.exc_value = ovalue;
                        this.exc_handler = (IRBlock*)0;
                        -> this.mod.position(this.fn, end_b);
                    };
                };
            };


            s_throw(Node* n) -> void
            {
                IRValue* v;
                IRValue* w;
                switch (this.exc_flag == (IRValue*)0)
                {
                    case (true) { -> this.unsup(n, g"throw outside try\0"); }
                    default
                    {
                        v = this.visit(n.a);
                        switch (this.bad)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch (v == (IRValue*)0)
                                {
                                    case (true) { -> this.unsup(n, g"void throw value\0"); }
                                    default
                                    {
                                        switch (v.ty.kind == LK.INT)
                                        {
                                            case (true) {
                                            switch (v.ty.width < 64)
                                            {
                                                case (true) { w = this.mod.cast(g"zext\0", v, this.t_i64, g"exc_zext\0"); }
                                                default {
                                                    switch (v.ty.width > 64)
                                                    {
                                                        case (true) { w = this.mod.cast(g"trunc\0", v, this.t_i64, g"exc_trunc\0"); }
                                                        default { w = v; };
                                                    };
                                                };
                                            };
                                        }
                                            default {
                                                switch (v.ty.kind == LK.PTR)
                                                {
                                                    case (true) { w = this.mod.cast(g"ptrtoint\0", v, this.t_i64, g"exc_ptr_to_int\0"); }
                                                    default { -> this.unsup(n, g"throw value type\0"); };
                                                };
                                            };
                                        };
                                        this.mod.store(w, this.exc_value);
                                        w = this.mod.new_value(this.t_i1, g"1\0");
                                        w.is_const = true;
                                        this.mod.store(w, this.exc_flag);
                                        switch (this.exc_handler != (IRBlock*)0)
                                        {
                                            case (true) { this.mod.br(this.exc_handler); }
                                            default { this.mod.unreachable(); };
                                        };
                                        ->;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            collect_labels(Node* n, IRFunc* f) -> void
            {
                int i;
                int c;
                int k;
                switch (n == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        k = n.kind;
                        switch (k == NodeKind.LABEL_STATEMENT)
                        {
                            case (true) {
                            switch (n.text != (byte*)0)
                            {
                                case (true) {
                                switch (nm_get(this.labels, n.text) == (void*)0)
                                {
                                    case (true) { nm_put(this.labels, this.mod.own(n.text), (void*)this.mod.append_block(f, n.text)); }
                                    default {};
                                };
                            }
                                default {};
                            };
                            ->;
                        }
                            default
                            {
                                switch (k == NodeKind.BLOCK)
                                {
                                    case (true) {
                                    c = node_count(n, 0);
                                    while (i < c)
                                    {
                                        this.collect_labels(node_child(n, 0, i), f);
                                        i++;
                                    };
                                    ->;
                                }
                                    default
                                    {
                                        switch (k == NodeKind.IF_STATEMENT)
                                        {
                                            case (true) {
                                            this.collect_labels(n.b, f);
                                            -> this.collect_labels(n.c, f);
                                        }
                                            default
                                            {
                                                switch (k == NodeKind.WHILE_LOOP | k == NodeKind.DO_LOOP | k == NodeKind.DO_WHILE_LOOP | k == NodeKind.FOR_IN_LOOP)
                                                {
                                                    case (true) { -> this.collect_labels(n.b, f); }
                                                    default
                                                    {
                                                        switch (k == NodeKind.FOR_LOOP)
                                                        {
                                                            case (true) { -> this.collect_labels(n.d, f); }
                                                            default
                                                            {
                                                                ->;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            s_label(Node* n) -> void
            {
                IRBlock* tb = (IRBlock*)nm_get(this.labels, n.text);
                switch (tb == (IRBlock*)0)
                {
                    case (true) { -> this.unsup(n, g"label not collected\0"); }
                    default
                    {
                        switch (!this.mod.is_terminated())
                        {
                            case (true) { this.mod.br(tb); }
                            default {};
                        };
                        -> this.mod.position(this.fn, tb);
                    };
                };
            };

            s_goto(Node* n) -> void
            {
                IRBlock* tb = (IRBlock*)nm_get(this.labels, n.text);
                switch (tb == (IRBlock*)0)
                {
                    case (true) { -> this.unsup(n, g"goto to undefined label\0"); }
                    default
                    {
                        switch (!this.mod.is_terminated())
                        {
                            case (true) { this.mod.br(tb); }
                            default {};
                        };
                        ->;
                    };
                };
            };

            s_while(Node* n) -> void
            {
                IRBlock* cond_b = this.mod.append_block(this.fn, g"while.cond\0");
                IRBlock* body_b = this.mod.append_block(this.fn, g"while.body\0");
                IRBlock* end_b = this.mod.append_block(this.fn, g"while.end\0");
                IRBlock* ob = this.brk;
                IRBlock* oc = this.cont;
                IRValue* cv;
                this.brk = end_b;
                this.cont = cond_b;
                this.mod.br(cond_b);
                this.mod.position(this.fn, cond_b);
                cv = this.cond_value(n.a);
                switch (this.bad)
                {
                    case (true) { ->; }
                    default
                    {
                        this.mod.cbr(cv, body_b, end_b);
                        this.mod.position(this.fn, body_b);
                        this.visit(n.b);
                        switch (this.bad)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch (!this.mod.is_terminated())
                                {
                                    case (true) { this.mod.br(cond_b); }
                                    default {};
                                };
                                this.brk = ob;
                                this.cont = oc;
                                -> this.mod.position(this.fn, end_b);
                            };
                        };
                    };
                };
            };

            s_do(Node* n) -> void
            {
                IRBlock* body_b = this.mod.append_block(this.fn, g"do.body\0");
                IRBlock* end_b = this.mod.append_block(this.fn, g"do.end\0");
                IRBlock* ob = this.brk;
                IRBlock* oc = this.cont;
                this.brk = end_b;
                this.cont = body_b;
                this.mod.br(body_b);
                this.mod.position(this.fn, body_b);
                this.visit(n.b);
                switch (this.bad)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (!this.mod.is_terminated())
                        {
                            case (true) { this.mod.br(body_b); }
                            default {};
                        };
                        this.brk = ob;
                        this.cont = oc;
                        -> this.mod.position(this.fn, end_b);
                    };
                };
            };

            s_dowhile(Node* n) -> void
            {
                IRBlock* body_b = this.mod.append_block(this.fn, g"dowhile.body\0");
                IRBlock* cond_b = this.mod.append_block(this.fn, g"dowhile.cond\0");
                IRBlock* end_b = this.mod.append_block(this.fn, g"dowhile.end\0");
                IRBlock* ob = this.brk;
                IRBlock* oc = this.cont;
                IRValue* cv;
                this.brk = end_b;
                this.cont = cond_b;
                this.mod.br(body_b);
                this.mod.position(this.fn, body_b);
                this.visit(n.b);
                switch (this.bad)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (!this.mod.is_terminated())
                        {
                            case (true) { this.mod.br(cond_b); }
                            default {};
                        };
                        this.mod.position(this.fn, cond_b);
                        this.check_cond_node(n.a);
                        switch (this.bad)
                        {
                            case (true) { ->; }
                            default
                            {
                                cv = this.visit(n.a);
                                switch (this.bad)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        switch (cv == (IRValue*)0)
                                        {
                                            case (true) {
                                            -> this.unsup(n, g"void condition\0");
                                        }
                                            default
                                            {
                                                this.mod.cbr(cv, body_b, end_b);
                                                this.brk = ob;
                                                this.cont = oc;
                                                -> this.mod.position(this.fn, end_b);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            forin_spec(Node* it, IRType* et) -> TypeSpec*
            {
                LVar* lv;
                TypeSpec* r;

                switch (et.kind == LK.INT)
                {
                    case (true) { -> (TypeSpec*)0; }
                    default
                    {
                        switch (it.kind == NodeKind.IDENTIFIER)
                        {
                            case (true) {
                            lv = this.find_var(it.text);
                            switch (lv != (LVar*)0)
                            {
                                case (true) {
                                switch (lv.ts != (TypeSpec*)0)
                                {
                                    case (true) {
                                    r = typespec_clone(lv.ts);
                                    switch ((r.flags `& 32) != 0)
                                    {
                                        case (true) {
                                        r.flags = r.flags - (r.flags `& 32);
                                        r.array_size = (Node*)0;
                                        r.array_dims = (NodeVec*)0;
                                    }
                                        default {
                                            switch (r.pointer_depth > 0)
                                            {
                                                case (true) { r.pointer_depth = r.pointer_depth - 1; }
                                                default {};
                                            };
                                        };
                                    };
                                    -> r;
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                        -> (TypeSpec*)0;
                    };
                };
            };





            s_bititer(Node* n) -> void
            {
                IRValue* coll = this.visit(n.a);
                IRType* ct;
                IRType* bt;
                IRValue* cv0;
                IRValue* sp;
                IRValue* idxp;
                IRValue* cur;
                IRValue* cv;
                IRValue* bit;
                IRValue* vp;
                IRValue* nxt;
                IRBlock* cond_b;
                IRBlock* body_b;
                IRBlock* latch_b;
                IRBlock* end_b;
                IRBlock* ob;
                IRBlock* oc;
                Node* src;
                Node* bn;
                Node* in1;
                Node* in2;
                Node* vn;
                TypeSpec* bs;
                int total;
                switch (this.bad)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (coll == (IRValue*)0)
                {
                    case (true) { -> this.unsup(n, g"void bit iteration operand\0"); }
                    default {};
                };
                ct = coll.ty;
                bt = ct;
                switch (ct.kind == LK.PTR)
                {
                    case (true) { bt = ct.elem; }
                    default {};
                };
                total = bits_of(bt);
                switch (total <= 0)
                {
                    case (true) { -> this.unsup(n, g"bit iteration operand type\0"); }
                    default {};
                };
                switch (bt.kind == LK.ARRAY & !(bt.elem.kind == LK.INT & bt.elem.width == 8))
                {
                    case (true) { -> this.unsup(n, g"bit iteration over a non-byte array\0"); }
                    default {};
                };
                switch (n.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true) { src = n.a; }
                    default
                    {
                        cv0 = coll;
                        switch (ct.kind == LK.PTR & bt.kind != LK.ARRAY)
                        {
                            case (true) { cv0 = this.mod.load(coll, g"bititer.copy\0"); }
                            default {};
                        };
                        switch (cv0.ty.kind == LK.PTR)
                        {
                            case (true) { sp = cv0; }
                            default
                            {
                                sp = this.mod.alloca_here(cv0.ty, g"bititer.val\0");
                                this.mod.store(cv0, sp);
                            };
                        };
                        this.define_var(g"__bititer_v\0", sp, coll.spec);
                        src = node_new(NodeKind.IDENTIFIER, n.line, n.col);
                        src.text = g"__bititer_v\0";
                    };
                };
                idxp = this.mod.alloca_here(this.t_i32, g"bititer.idx\0");
                this.mod.store(this.ci32(0), idxp);
                this.define_var(g"__bititer_i\0", idxp, this.lit_spec(DataType.UINT));
                cond_b = this.mod.append_block(this.fn, g"bititer.cond\0");
                body_b = this.mod.append_block(this.fn, g"bititer.body\0");
                end_b = this.mod.append_block(this.fn, g"bititer.end\0");
                this.mod.br(cond_b);
                this.mod.position(this.fn, cond_b);
                cur = this.mod.load(idxp, g"bititer.k\0");
                cv = this.mod.icmp(g"ult\0", cur, this.ci32(total), g"loop.cond\0");
                this.mod.cbr(cv, body_b, end_b);
                this.mod.position(this.fn, body_b);
                in1 = node_new(NodeKind.IDENTIFIER, n.line, n.col);
                in1.text = g"__bititer_i\0";
                in2 = node_new(NodeKind.IDENTIFIER, n.line, n.col);
                in2.text = g"__bititer_i\0";
                switch (bt.kind == LK.INT)
                {
                    case (true) {

                        bn = node_new(NodeKind.BIT_INDEX_ACCESS, n.line, n.col);
                        bn.a = src;
                        bn.b = in1;
                    }
                    default {
                        bn = node_new(NodeKind.BIT_SLICE, n.line, n.col);
                        bn.a = src;
                        bn.b = in1;
                        bn.c = in2;
                    };
                };
                bit = this.visit(bn);
                switch (this.bad | bit == (IRValue*)0)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (bit.ty.kind == LK.INT & bit.ty.width > 1)
                {
                    case (true) { bit = this.mod.cast(g"trunc\0", bit, this.mod.t_int(1), g"bititer.bit\0"); }
                    default {};
                };
                vn = node_child(n, 0, 0);
                vp = this.mod.alloca_here(this.mod.t_int(1), vn.text);
                this.mod.store(bit, vp);
                bs = typespec_new();
                bs.base_type = DataType.DATA;
                bs.bit_width = 1;
                this.keep((void*)bs);
                this.define_var(vn.text, vp, bs);
                latch_b = this.mod.append_block(this.fn, g"bititer.latch\0");
                ob = this.brk;
                oc = this.cont;
                this.brk = end_b;
                this.cont = latch_b;
                this.visit(n.b);
                switch (!this.mod.is_terminated())
                {
                    case (true) { this.mod.br(latch_b); }
                    default {};
                };
                this.mod.position(this.fn, latch_b);
                cur = this.mod.load(idxp, g"bititer.k.latch\0");
                nxt = this.mod.binop(g"add\0", cur, this.ci32(1), g"bititer.next\0");
                this.mod.store(nxt, idxp);
                this.mod.br(cond_b);
                this.brk = ob;
                this.cont = oc;
                this.mod.position(this.fn, end_b);
            };

            s_forin(Node* n) -> void
            {
                switch ((n.flags `& 4194304) != 0)
                {
                    case (true) { this.s_bititer(n); ->; }
                    default {};
                };
                IRValue* coll = this.visit(n.a);
                IRType* ct;
                IRType* et;
                IRBlock* cond_b;
                IRBlock* body_b;
                IRBlock* end_b;
                IRBlock* ob;
                IRBlock* oc;
                IRValue* idxp;
                IRValue* curp;
                IRValue* cur;
                IRValue* ep;
                IRValue* ev;
                IRValue* vp;
                IRValue* cv;
                IRValue* slot;
                IRValue* nxt;
                IRValue* fp;
                IRValue* fa;
                SInfo* si;
                LVar* lv;
                i64 dv;
                int size;
                int k;
                int nv = node_count(n, 0);
                bool sized = false;
                Node* vn;
                switch (this.bad)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (coll == (IRValue*)0)
                        {
                            case (true) { -> this.unsup(n, g"void for-in collection\0"); }
                            default
                            {
                                ct = coll.ty;
                                switch (ct.kind != LK.PTR)
                                {
                                    case (true) { -> this.unsup(n, g"for-in collection type\0"); }
                                    default
                                    {
                                        cond_b = this.mod.append_block(this.fn, g"forin.cond\0");
                                        body_b = this.mod.append_block(this.fn, g"forin.body\0");
                                        end_b = this.mod.append_block(this.fn, g"forin.end\0");
                                        et = ct.elem;
                                        switch (et.kind == LK.ARRAY)
                                        {
                                            case (true) {
                                            size = et.count;
                                            idxp = this.mod.alloca_here(this.t_i32, g"forin.idx\0");
                                            this.mod.store(this.ci32(0), idxp);
                                            this.mod.br(cond_b);
                                            this.mod.position(this.fn, cond_b);
                                            cur = this.mod.load(idxp, g"idx\0");
                                            cv = this.mod.icmp(g"ult\0", cur, this.ci32(size), g"loop.cond\0");
                                            this.mod.cbr(cv, body_b, end_b);
                                            this.mod.position(this.fn, body_b);
                                            this.mod.ia[0] = this.ci32(0);
                                            this.mod.ia[1] = cur;
                                            ep = this.mod.gep(coll, this.mod.ia, 2, false, g"elem.ptr\0");
                                            si = this.sinfo_of(et.elem);
                                            switch ((n.flags `& 16) != 0 & si != (SInfo*)0)
                                            {
                                                case (true) {
                                                k = 0;
                                                while (k < nv)
                                                {
                                                    vn = node_child(n, 0, k);
                                                    this.mod.ia[0] = this.ci32(0);
                                                    this.mod.ia[1] = this.ci32(k);
                                                    this.sc.clear();
                                                    this.sc.put_str(f"{vn.text}.ptr\0");
                                                    fp = this.mod.gep(ep, this.mod.ia, 2, false, this.mod.own(this.sc.mem));
                                                    fa = this.mod.alloca_here(si.ftys[k], vn.text);
                                                    this.sc.clear();
                                                    this.sc.put_str(f"{vn.text}.val\0");
                                                    ev = this.mod.load(fp, this.mod.own(this.sc.mem));
                                                    this.mod.store(ev, fa);
                                                    this.define_var(vn.text, fa, si.specs[k]);
                                                    k++;
                                                };
                                            }
                                                default {
                                                    ev = this.mod.load(ep, g"elem\0");
                                                    vn = node_child(n, 0, 0);
                                                    vp = this.mod.alloca_here(et.elem, vn.text);
                                                    this.mod.store(ev, vp);
                                                    this.define_var(vn.text, vp, this.forin_spec(n.a, et.elem));
                                                };
                                            };
                                        }
                                            default {
                                                switch (et.kind == LK.PTR)
                                                {
                                                    case (true) {
                                                    curp = this.mod.alloca_here(ct, g"forin.cursor\0");
                                                    this.mod.store(coll, curp);
                                                    this.mod.br(cond_b);
                                                    this.mod.position(this.fn, cond_b);
                                                    cur = this.mod.load(curp, g"cursor\0");
                                                    slot = this.mod.load(cur, g"slot\0");
                                                    ev = this.mod.cast(g"ptrtoint\0", slot, this.t_i64, g"slot.int\0");
                                                    cv = this.mod.icmp(g"ne\0", ev, this.mod.c_int(this.t_i64, (i64)0), g"loop.cond\0");
                                                    this.mod.cbr(cv, body_b, end_b);
                                                    this.mod.position(this.fn, body_b);
                                                    vn = node_child(n, 0, 0);
                                                    vp = this.mod.alloca_here(et, vn.text);
                                                    this.mod.store(slot, vp);
                                                    this.define_var(vn.text, vp, this.forin_spec(n.a, et));
                                                }
                                                    default {
                                                        switch (et.kind == LK.INT & et.width == 8)
                                                        {
                                                            case (true) {
                                                            curp = this.mod.alloca_here(ct, g"char.ptr\0");
                                                            this.mod.store(coll, curp);
                                                            this.mod.br(cond_b);
                                                            this.mod.position(this.fn, cond_b);
                                                            cur = this.mod.load(curp, g"ptr\0");
                                                            ev = this.mod.load(cur, g"char\0");
                                                            cv = this.mod.icmp(g"ne\0", ev, this.mod.c_int(this.t_i8, (i64)0), g"loop.cond\0");
                                                            this.mod.cbr(cv, body_b, end_b);
                                                            this.mod.position(this.fn, body_b);
                                                            vn = node_child(n, 0, 0);
                                                            vp = this.mod.alloca_here(this.t_i8, vn.text);
                                                            this.mod.store(ev, vp);
                                                            this.define_var(vn.text, vp, this.forin_spec(n.a, et));
                                                        }
                                                            default {
                                                                switch (et.kind != LK.INT)
                                                                {
                                                                    case (true) { -> this.unsup(n, g"for-in collection type\0"); }
                                                                    default
                                                                    {

                                                                        size = -1;
                                                                        switch (n.a.kind == NodeKind.IDENTIFIER)
                                                                        {
                                                                            case (true) {
                                                                            lv = this.find_var(n.a.text);
                                                                            switch (lv != (LVar*)0)
                                                                            {
                                                                                case (true) {
                                                                                switch (lv.ts != (TypeSpec*)0)
                                                                                {
                                                                                    case (true) {
                                                                                    switch (lv.ts.array_size != (Node*)0)
                                                                                    {
                                                                                        case (true) {
                                                                                        switch (this.dim_value(lv.ts.array_size, @dv)) { case (true) { size = (int)dv; } default {}; };
                                                                                    }
                                                                                        default {
                                                                                            switch (lv.ts.array_dims != (NodeVec*)0)
                                                                                            {
                                                                                                case (true) {
                                                                                                switch (lv.ts.array_dims.len > 0)
                                                                                                {
                                                                                                    case (true) {
                                                                                                    switch (lv.ts.array_dims.items[0] != (Node*)0)
                                                                                                    {
                                                                                                        case (true) {
                                                                                                        switch (this.dim_value((Node*)lv.ts.array_dims.items[0], @dv)) { case (true) { size = (int)dv; } default {}; };
                                                                                                    }
                                                                                                        default {};
                                                                                                    };
                                                                                                }
                                                                                                    default {};
                                                                                                };
                                                                                            }
                                                                                                default {};
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                }
                                                                                    default {};
                                                                                };
                                                                            }
                                                                                default {};
                                                                            };
                                                                        }
                                                                            default {};
                                                                        };
                                                                        switch (size < 0)
                                                                        {
                                                                            case (true) { -> this.unsup(n, g"for-in size unknown\0"); }
                                                                            default
                                                                            {
                                                                                idxp = this.mod.alloca_here(this.t_i32, g"forin.idx\0");
                                                                                this.mod.store(this.ci32(0), idxp);
                                                                                this.mod.br(cond_b);
                                                                                this.mod.position(this.fn, cond_b);
                                                                                cur = this.mod.load(idxp, g"idx\0");
                                                                                cv = this.mod.icmp(g"ult\0", cur, this.ci32(size), g"loop.cond\0");
                                                                                this.mod.cbr(cv, body_b, end_b);
                                                                                this.mod.position(this.fn, body_b);
                                                                                this.mod.ia[0] = cur;
                                                                                ep = this.mod.gep(coll, this.mod.ia, 1, false, g"elem.ptr\0");
                                                                                ev = this.mod.load(ep, g"elem\0");
                                                                                vn = node_child(n, 0, 0);
                                                                                vp = this.mod.alloca_here(et, vn.text);
                                                                                this.mod.store(ev, vp);
                                                                                this.define_var(vn.text, vp, this.forin_spec(n.a, et));
                                                                                sized = true;
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                        ob = this.brk;
                                        oc = this.cont;
                                        this.brk = end_b;
                                        this.cont = cond_b;
                                        this.visit(n.b);
                                        switch (this.bad)
                                        {
                                            case (true) { ->; }
                                            default
                                            {
                                                switch (!this.mod.is_terminated())
                                                {
                                                    case (true) {
                                                    switch (et.kind == LK.ARRAY | sized)
                                                    {
                                                        case (true) {
                                                        cur = this.mod.load(idxp, g"idx\0");
                                                        nxt = this.mod.binop(g"add\0", cur, this.ci32(1), g"next.idx\0");
                                                        this.mod.store(nxt, idxp);
                                                    }
                                                        default {
                                                            switch (et.kind == LK.PTR)
                                                            {
                                                                case (true) {
                                                                cur = this.mod.load(curp, g"cursor.latch\0");
                                                                this.mod.ia[0] = this.ci32(1);
                                                                nxt = this.mod.gep(cur, this.mod.ia, 1, false, g"cursor.next\0");
                                                                this.mod.store(nxt, curp);
                                                            }
                                                                default {
                                                                cur = this.mod.load(curp, g"ptr.latch\0");
                                                                this.mod.ia[0] = this.ci32(1);
                                                                nxt = this.mod.gep(cur, this.mod.ia, 1, false, g"ptr.next\0");
                                                                this.mod.store(nxt, curp);
                                                            };
                                                            };
                                                        };
                                                    };
                                                    this.mod.br(cond_b);
                                                }
                                                    default {};
                                                };
                                                this.brk = ob;
                                                this.cont = oc;
                                                -> this.mod.position(this.fn, end_b);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            s_for(Node* n) -> void
            {
                IRBlock* cond_b = this.mod.append_block(this.fn, g"for.cond\0");
                IRBlock* body_b = this.mod.append_block(this.fn, g"for.body\0");
                IRBlock* upd_b = this.mod.append_block(this.fn, g"for.update\0");
                IRBlock* end_b = this.mod.append_block(this.fn, g"for.end\0");
                IRBlock* ob;
                IRBlock* oc;
                IRValue* cv;
                switch (n.a != (Node*)0)
                {
                    case (true) {
                    this.visit(n.a);
                    switch (this.bad)
                    {
                        case (true) { ->; }
                        default {};
                    };
                }
                    default {};
                };
                this.mod.br(cond_b);
                this.mod.position(this.fn, cond_b);
                switch (n.b != (Node*)0)
                {
                    case (true) {
                    cv = this.cond_value(n.b);
                    switch (this.bad)
                    {
                        case (true) { ->; }
                        default
                        {
                            this.mod.cbr(cv, body_b, end_b);
                        };
                    };
                }
                    default { this.mod.br(body_b); };
                };
                this.mod.position(this.fn, body_b);
                ob = this.brk;
                oc = this.cont;
                this.brk = end_b;
                this.cont = upd_b;
                this.visit(n.d);
                switch (this.bad)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (!this.mod.is_terminated())
                        {
                            case (true) { this.mod.br(upd_b); }
                            default {};
                        };
                        this.mod.position(this.fn, upd_b);
                        switch (n.c != (Node*)0)
                        {
                            case (true) {
                            this.visit(n.c);
                            switch (this.bad)
                            {
                                case (true) { ->; }
                                default {};
                            };
                        }
                            default {};
                        };
                        this.mod.br(cond_b);
                        this.brk = ob;
                        this.cont = oc;
                        -> this.mod.position(this.fn, end_b);
                    };
                };
            };


            s_noreturn() -> void
            {
                int i;
                bool have;
                switch (!this.mod.is_terminated())
                {
                    case (true) { this.mod.unreachable(); }
                    default {};
                };
                switch (this.fn != (IRFunc*)0)
                {
                    case (true) {
                    while (i < this.fn.attrs.len)
                    {
                        switch (cstr_eq((byte*)this.fn.attrs.items[i], g"noreturn\0"))
                        {
                            case (true) { have = true; }
                            default {};
                        };
                        i++;
                    };
                    switch (!have)
                    {
                        case (true) { pv_push(this.fn.attrs, (void*)this.mod.own(g"noreturn\0")); }
                        default {};
                    };
                }
                    default {};
                };
                ->;
            };

            s_return(Node* n) -> void
            {
                IRValue* rv;
                IRType* expected = this.fret;
                bool suppress;
                switch (this.mod.is_terminated())
                {
                    case (true) { ->; }
                    default
                    {
                        switch (n.a == (Node*)0)
                        {
                            case (true) {
                            switch (this.rec_fn) { case (true) { this.rec_call(false, (IRValue*)0); } default {}; };
                            -> this.mod.ret_void();
                        }
                            default
                            {
                                switch (n.a.kind == NodeKind.IDENTIFIER)
                                {
                                    case (true) {
                                    switch (this.local_flag(n.a.text, 16))
                                    {
                                        case (true) {
                                        -> this.unsup(n, g"local variable returned\0");
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                suppress = expected.kind == LK.STRUCT | expected.kind == LK.ISTRUCT;
                                switch (suppress)
                                {
                                    case (true) { this.in_member = true; }
                                    default {};
                                };

                                switch (n.a.kind == NodeKind.STRUCT_LITERAL & n.a.text == (byte*)0 & expected.kind == LK.ISTRUCT)
                                {
                                    case (true) { rv = this.x_struct_lit(n.a, expected); }
                                    default { rv = this.visit(n.a); };
                                };
                                switch (suppress)
                                {
                                    case (true) { this.in_member = false; }
                                    default {};
                                };
                                switch (this.bad)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        this.run_defers();
                                        switch (this.bad)
                                        {
                                            case (true) { ->; }
                                            default
                                            {
                                                switch (rv == (IRValue*)0)
                                                {
                                                    case (true) {
                                                    -> this.mod.ret_void();
                                                }
                                                    default
                                                    {
                                                        switch (this.mod.is_terminated())
                                                        {
                                                            case (true) { ->; }
                                                            default
                                                            {
                                                                switch (expected.kind == LK.VOID)
                                                                {
                                                                    case (true) {
                                                                    -> this.mod.ret_void();
                                                                }
                                                                    default
                                                                    {
                                                                        switch (rv.ty.kind == LK.PTR & rv.ty.elem.kind == LK.STRUCT & lt_eq(rv.ty.elem, expected))
                                                                        {
                                                                            case (true) {
                                                                            rv = this.mod.load(rv, g"ret_load\0");
                                                                        }
                                                                            default {};
                                                                        };
                                                                        rv = this.coerce_ret(rv, expected, n);
                                                                        switch (this.bad)
                                                                        {
                                                                            case (true) { ->; }
                                                                            default
                                                                            {
                                                                                switch (this.rec_fn)
                                                                                {
                                                                                    case (true) {
                                                                                    -> this.mod.ret(this.rec_call(true, rv));
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        -> this.mod.ret(rv);
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            rec_call(bool with_val, IRValue* v) -> IRValue*
            {
                IRFunc* f = this.fn;
                int n = f.ftype.nitems;
                int i;
                IRValue** args = (IRValue**)fmalloc((u64)(n + 1) * (u64)((sizeof(IRValue*) + 7) / 8));
                this.keep((void*)args);
                switch (with_val)
                {
                    case (true) {
                    args[0] = v;
                    n = 1;
                }
                    default {
                        while (i < n)
                        {
                            args[i] = f.args[i];
                            i++;
                        };
                    };
                };
                this.mod.must_tail = true;
                -> this.mod.call_ex(f.self, args, n, (byte*)0, f.cconv, false);
            };







            all_ones(IRType* t) -> IRValue*
            {
                IRValue* v = this.mod.new_value(t, g"-1\0");
                v.is_const = true;
                -> v;
            };



            x_unary(Node* n) -> IRValue*
            {
                int op = n.op;
                Node* opd = n.a;
                IRValue* v;
                IRValue* nv;
                IRValue* off;
                IRValue* mpv;
                LVar* lv;
                bool post = (n.flags `& 1) != 0;
                bool incdec = op == Operator.INCREMENT | op == Operator.DECREMENT;
                switch (incdec & opd.kind == NodeKind.ADDRESS_OF)
                {
                    case (true) {
                    this.unsup(n, g"increment of address-of\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        v = this.visit(opd);
                        switch (this.bad)
                        {
                            case (true) { -> (IRValue*)0; }
                            default
                            {
                                switch (v == (IRValue*)0)
                                {
                                    case (true) {
                                    this.unsup(n, g"void unary operand\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        switch (incdec & opd.kind == NodeKind.IDENTIFIER)
                                        {
                                            case (true) {
                                            switch (v.ty.kind == LK.PTR & v.ty.elem.kind == LK.PTR)
                                            {
                                                case (true) {
                                                this.sc.clear();
                                                this.sc.put_str(f"{opd.text}_loaded\0");
                                                v = this.mod.load(v, this.sc.mem);
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        switch (op == Operator.NOT)
                                        {
                                            case (true) {
                                            switch (v.ty.kind == LK.PTR)
                                            {
                                                case (true) {
                                                -> this.mod.icmp(g"eq\0", v, this.mod.c_null(v.ty), g"is_null\0");
                                            }
                                                default {};
                                            };
                                            switch (v.ty.kind != LK.INT)
                                            {
                                                case (true) {
                                                this.unsup(n, g"not of non-integer\0");
                                                -> (IRValue*)0;
                                            }
                                                default {};
                                            };
                                            -> this.mod.binop(g"xor\0", v, this.all_ones(v.ty), (byte*)0);
                                        }
                                            default
                                            {
                                                switch (op == Operator.SUB)
                                                {
                                                    case (true) {
                                                    switch (v.ty.kind == LK.FLOAT | v.ty.kind == LK.DOUBLE)
                                                    {
                                                        case (true) {
                                                        -> this.mod.binop(g"fsub\0", this.mod.c_fp(v.ty, 0.0), v, (byte*)0);
                                                    }
                                                        default {};
                                                    };
                                                    switch (v.ty.kind != LK.INT)
                                                    {
                                                        case (true) {
                                                        this.unsup(n, g"negate of non-number\0");
                                                        -> (IRValue*)0;
                                                    }
                                                        default {};
                                                    };
                                                    -> this.mod.binop(g"sub\0", this.mod.c_int(v.ty, (i64)0), v, (byte*)0);
                                                }
                                                    default
                                                    {
                                                        switch (op == Operator.BITNOT)
                                                        {
                                                            case (true) {
                                                            switch (v.ty.kind != LK.INT)
                                                            {
                                                                case (true) {
                                                                this.unsup(n, g"bit not of non-integer\0");
                                                                -> (IRValue*)0;
                                                            }
                                                                default {};
                                                            };
                                                            -> this.mod.binop(g"xor\0", v, this.all_ones(v.ty), (byte*)0);
                                                        }
                                                            default
                                                            {
                                                                switch (incdec)
                                                                {
                                                                    case (true) {
                                                                    switch (v.ty.kind)
                                                                    {
                                                                        case (LK.PTR)
                                                                        {
                                                                            switch (op)
                                                                            {
                                                                                case (Operator.INCREMENT)
                                                                                {
                                                                                    nv = this.mod.gep_ptr(v, this.ci32(1), false, g"ptr_inc\0");
                                                                                }
                                                                                default
                                                                                {
                                                                                    nv = this.mod.gep_ptr(v, this.ci32(0 - 1), false, g"ptr_dec\0");
                                                                                };
                                                                            };
                                                                        }
                                                                        case (LK.INT)
                                                                        {
                                                                            off = this.mod.c_int(v.ty, (i64)1);
                                                                            switch (op)
                                                                            {
                                                                                case (Operator.INCREMENT) { nv = this.mod.binop(g"add\0", v, off, (byte*)0); }
                                                                                default { nv = this.mod.binop(g"sub\0", v, off, (byte*)0); };
                                                                            };
                                                                        }
                                                                        default
                                                                        {
                                                                            this.unsup(n, g"increment of non-integer\0");
                                                                            -> (IRValue*)0;
                                                                        };
                                                                    };
                                                                    switch (opd.kind)
                                                                    {
                                                                        case (NodeKind.IDENTIFIER)
                                                                        {
                                                                            lv = this.find_var(opd.text);
                                                                            switch (lv == (LVar*)0)
                                                                            {
                                                                                case (true) {
                                                                                this.unsup(n, g"increment of non-local\0");
                                                                                -> (IRValue*)0;
                                                                            }
                                                                                default {};
                                                                            };
                                                                            this.mod.store(nv, lv.ptr);
                                                                        }
                                                                        case (NodeKind.MEMBER_ACCESS)
                                                                        {
                                                                            mpv = this.member_ptr(opd);
                                                                            switch (this.bad)
                                                                            {
                                                                                case (true) { -> (IRValue*)0; }
                                                                                default {};
                                                                            };
                                                                            this.mod.store(nv, mpv);
                                                                        }
                                                                        case (NodeKind.ARRAY_ACCESS)
                                                                        {
                                                                            mpv = this.index_ptr(opd);
                                                                            switch (this.bad)
                                                                            {
                                                                                case (true) { -> (IRValue*)0; }
                                                                                default {};
                                                                            };
                                                                            this.mod.store(nv, mpv);
                                                                        }
                                                                        default {};
                                                                    };
                                                                    switch (post)
                                                                    {
                                                                        case (true) { -> v; }
                                                                        default {};
                                                                    };
                                                                    -> nv;
                                                                }
                                                                    default
                                                                    {
                                                                        this.unsup(n, g"unary operator\0");
                                                                        -> (IRValue*)0;
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            x_deref(Node* n) -> IRValue*
            {
                IRValue* p = this.visit(n.a);
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        switch (p == (IRValue*)0)
                        {
                            case (true) {
                            this.unsup(n, g"void dereference\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (p.ty.kind != LK.PTR)
                                {
                                    case (true) {
                                    this.unsup(n, g"dereference of non-pointer\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        -> this.mod.load(p, g"deref\0");
                                    };
                                };
                            };
                        };
                    };
                };
            };



            function_ref(byte* name) -> IRValue*
            {
                IDKC_SYMENTRY* fe = st_lookup_any(this.st, name, this.cur_ns);
                PtrVec* list;
                Overload* o;
                Overload* oc;
                IRFunc* f;
                byte* key;
                int oi;

                f = this.mod.find_function(name);
                switch (f != (IRFunc*)0)
                {
                    case (true) { -> f.self; }
                    default
                    {
                        switch (fe == (IDKC_SYMENTRY*)0)
                        {
                            case (true) { -> (IRValue*)0; }
                            default
                            {
                                switch (fe.kind_id != SymbolKind.FUNCTION)
                                {
                                    case (true) { -> (IRValue*)0; }
                                    default
                                    {
                                        key = sym_mangled(fe);
                                        list = st_overloads_of(this.st, key);
                                        ffree(key);
                                        switch (list == (PtrVec*)0)
                                        {
                                            case (true) { -> (IRValue*)0; }
                                            default
                                            {
                                                switch (list.len >= 1)
                                                {
                                                    case (true) { o = (Overload*)list.items[0]; }
                                                    default {};
                                                };

                                                oi = 1;
                                                while (oi < list.len)
                                                {
                                                    oc = (Overload*)list.items[oi];
                                                    switch (!cstr_eq(oc.mangled, o.mangled))
                                                    {
                                                        case (true) { o = (Overload*)0; break; }
                                                        default
                                                        {
                                                            oi++;
                                                        };
                                                    };
                                                };
                                                oi = 0;
                                                switch (o == (Overload*)0 & list.len > 1)
                                                {
                                                    case (true) {
                                                    while (oi < list.len)
                                                    {
                                                        oc = (Overload*)list.items[oi];
                                                        switch (oc.nparams == 0)
                                                        {
                                                            case (true) {
                                                            o = oc;
                                                            break;
                                                        }
                                                            default
                                                            {
                                                                oi++;
                                                            };
                                                        };
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (o == (Overload*)0)
                                                {
                                                    case (true) { -> (IRValue*)0; }
                                                    default
                                                    {
                                                        f = this.mod.find_function(o.mangled);
                                                        switch (f == (IRFunc*)0)
                                                        {
                                                            case (true) { -> (IRValue*)0; }
                                                            default
                                                            {
                                                                -> f.self;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            x_addrof(Node* n) -> IRValue*
            {
                Node* e = n.a;
                IRValue* v;
                IRValue* tmp;
                IRValue* fv;
                LVar* lv;
                switch (e.kind == NodeKind.LITERAL)
                {
                    case (true) {
                    v = this.visit(e);
                    switch (this.bad)
                    {
                        case (true) { -> (IRValue*)0; }
                        default {};
                    };
                    tmp = this.mod.alloca(v.ty, (byte*)0);
                    this.mod.store(v, tmp);
                    -> tmp;
                }
                    default
                    {
                        switch (e.kind == NodeKind.IDENTIFIER)
                        {
                            case (true) {
                            lv = this.find_var(e.text);
                            switch (lv == (LVar*)0)
                            {
                                case (true) {
                                fv = this.function_ref(e.text);
                                switch (fv != (IRValue*)0)
                                {
                                    case (true) { -> fv; }
                                    default {};
                                };
                                this.unsup(n, g"address of non-local\0");
                                -> (IRValue*)0;
                            }
                                default {};
                            };
                            switch (lv.ptr.ty.kind == LK.PTR & lv.ptr.ty.elem.kind == LK.PTR)
                            {
                                case (true) {
                                this.sc.clear();
                                this.sc.put_str(f"{e.text}_ptr\0");
                                -> this.mod.load(lv.ptr, this.sc.mem);
                            }
                                default {};
                            };
                            -> lv.ptr;
                        }
                            default
                            {
                                switch (e.kind == NodeKind.MEMBER_ACCESS)
                                {
                                    case (true) { -> this.member_ptr(e); }
                                    default
                                    {
                                        switch (e.kind == NodeKind.POINTER_DEREF)
                                        {
                                            case (true) { -> this.visit(e.a); }
                                            default
                                            {
                                                switch (e.kind == NodeKind.FUNCTION_CALL)
                                                {
                                                    case (true) {
                                                    v = this.visit(e);
                                                    switch (this.bad)
                                                    {
                                                        case (true) { -> (IRValue*)0; }
                                                        default {};
                                                    };
                                                    switch (v == (IRValue*)0)
                                                    {
                                                        case (true) {
                                                        this.unsup(n, g"address of void call\0");
                                                        -> (IRValue*)0;
                                                    }
                                                        default {};
                                                    };
                                                    tmp = this.mod.alloca(v.ty, g"func_result_temp\0");
                                                    this.mod.store(v, tmp);
                                                    -> tmp;
                                                }
                                                    default
                                                    {
                                                        switch (e.kind == NodeKind.ARRAY_ACCESS)
                                                        {
                                                            case (true) {
                                                            Node* an = e.a;
                                                            IRValue* arrp;
                                                            IRValue* ix;
                                                            switch (e.b.kind == NodeKind.RANGE_EXPRESSION)
                                                            {
                                                                case (true) {
                                                                this.unsup(n, g"address of range index\0");
                                                                -> (IRValue*)0;
                                                            }
                                                                default
                                                                {
                                                                    switch (an.kind)
                                                                    {
                                                                        case (NodeKind.IDENTIFIER)
                                                                        {
                                                                            lv = this.find_var(an.text);
                                                                            switch (lv == (LVar*)0)
                                                                            {
                                                                                case (true) {
                                                                                this.unsup(n, g"address of non-local array\0");
                                                                                -> (IRValue*)0;
                                                                            }
                                                                                default
                                                                                {
                                                                                    arrp = lv.ptr;
                                                                                };
                                                                            };
                                                                        }
                                                                        case (NodeKind.MEMBER_ACCESS) { arrp = this.member_ptr(an); }
                                                                        default { arrp = this.visit(an); };
                                                                    };
                                                                    switch (this.bad)
                                                                    {
                                                                        case (true) { -> (IRValue*)0; }
                                                                        default
                                                                        {
                                                                            switch (arrp == (IRValue*)0)
                                                                            {
                                                                                case (true) {
                                                                                this.unsup(n, g"address of void array\0");
                                                                                -> (IRValue*)0;
                                                                            }
                                                                                default
                                                                                {
                                                                                    ix = this.visit(e.b);
                                                                                    switch (this.bad)
                                                                                    {
                                                                                        case (true) { -> (IRValue*)0; }
                                                                                        default
                                                                                        {
                                                                                            switch (ix == (IRValue*)0)
                                                                                            {
                                                                                                case (true) {
                                                                                                this.unsup(n, g"address of void index\0");
                                                                                                -> (IRValue*)0;
                                                                                            }
                                                                                                default
                                                                                                {
                                                                                                    switch (arrp.ty.kind == LK.PTR & arrp.ty.elem.kind == LK.PTR)
                                                                                                    {
                                                                                                        case (true) { arrp = this.mod.load(arrp, g"array_param_ptr\0"); }
                                                                                                        default {};
                                                                                                    };
                                                                                                    switch (arrp.ty.kind == LK.PTR)
                                                                                                    {
                                                                                                        case (true) {
                                                                                                        switch (arrp.ty.elem.kind == LK.ARRAY)
                                                                                                        {
                                                                                                            case (true) {
                                                                                                            this.mod.ia[0] = this.ci32(0);
                                                                                                            this.mod.ia[1] = ix;
                                                                                                            -> this.mod.gep(arrp, this.mod.ia, 2, true, (byte*)0);
                                                                                                        }
                                                                                                            default
                                                                                                            {
                                                                                                                -> this.mod.gep_ptr(arrp, ix, true, (byte*)0);
                                                                                                            };
                                                                                                        };
                                                                                                    }
                                                                                                        default {};
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                        this.unsup(n, g"address-of operand\0");
                                                        -> (IRValue*)0;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            cast_endian_fix(IRValue* v, TypeSpec* tgt) -> IRValue*
            {
                switch (v.ty.kind == LK.INT & v.ty.width >= 16)
                {
                    case (true) {
                    switch (this.endian_of(v.spec) != this.endian_of(tgt))
                    {
                        case (true) { -> this.bswap(v); }
                        default {};
                    };
                }
                    default {};
                };
                -> v;
            };


            cast_void(Node* n) -> IRValue*
            {
                Node* e = n.a;
                IRGlobal* gl;
                LVar* lv;
                IRType* pt;
                IRValue* ev;
                int i;
                switch (e.kind == NodeKind.IDENTIFIER)
                {
                    case (true) {
                    lv = this.find_local(e.text);
                    switch (lv == (LVar*)0)
                    {
                        case (true) {

                        gl = this.mod.find_global(e.text);
                        switch (gl == (IRGlobal*)0)
                        {
                            case (true) {
                            this.unsup(n, g"void cast of non-local\0");
                            -> (IRValue*)0;
                        }
                            default {};
                        };
                        this.mod.store(this.mod.c_null(gl.self.ty.elem), gl.self);
                        -> (IRValue*)0;
                    }
                        default {};
                    };
                    switch (lv.ptr.ty.kind != LK.PTR)
                    {
                        case (true) {
                        this.unsup(n, g"void cast of non-pointer slot\0");
                        -> (IRValue*)0;
                    }
                        default {};
                    };
                    pt = lv.ptr.ty.elem;
                    switch (lv.is_heap)
                    {
                        case (true) {
                        this.sc.clear();
                        this.sc.put_str(f"{e.text}_heapptr\0");
                        ev = this.mod.load(lv.ptr, this.sc.mem);
                        this.emit_ffree(ev, e.text);
                        this.mod.store(this.mod.c_null(pt), lv.ptr);
                        i = this.scopes.len - 1;
                        while (i >= 0)
                        {
                            switch (nm_get((NameMap*)this.scopes.items[i], e.text) != (void*)0)
                            {
                                case (true) {
                                nm_del((NameMap*)this.scopes.items[i], e.text);
                                break;
                            }
                                default {};
                            };
                            i--;
                        };
                        -> (IRValue*)0;
                    }
                        default {};
                    };
                    switch (pt.kind != LK.PTR & pt.kind != LK.INT & pt.kind != LK.FLOAT & pt.kind != LK.DOUBLE & pt.kind != LK.STRUCT & pt.kind != LK.ISTRUCT & pt.kind != LK.ARRAY)
                    {
                        case (true) {
                        this.unsup(n, g"void cast of type\0");
                        -> (IRValue*)0;
                    }
                        default {};
                    };

                    switch (pt.kind == LK.PTR & !cstr_eq(e.text, g"this\0"))
                    {
                        case (true) {
                        this.sc.clear();
                        this.sc.put_str(f"{e.text}_voidptr\0");
                        ev = this.mod.load(lv.ptr, this.sc.mem);
                        this.emit_ffree(ev, e.text);
                    }
                        default {};
                    };
                    this.mod.store(this.mod.c_null(pt), lv.ptr);
                    i = this.scopes.len - 1;
                    while (i >= 0)
                    {
                        switch (nm_get((NameMap*)this.scopes.items[i], e.text) != (void*)0)
                        {
                            case (true) {
                            nm_del((NameMap*)this.scopes.items[i], e.text);
                            break;
                        }
                            default {};
                        };
                        i--;
                    };
                    -> (IRValue*)0;
                }
                    default
                    {
                        ev = this.visit(e);
                        switch (this.bad)
                        {
                            case (true) { -> (IRValue*)0; }
                            default
                            {
                                switch (ev != (IRValue*)0)
                                {
                                    case (true) {
                                    switch (ev.ty.kind == LK.PTR)
                                    {
                                        case (true) {
                                        this.unsup(n, g"void cast runtime free\0");
                                        -> (IRValue*)0;
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                -> (IRValue*)0;
                            };
                        };
                    };
                };
            };



            pack_bits(IRType* t) -> int
            {
                switch (t.kind)
                {
                    case (LK.INT) { -> t.width; }
                    case (LK.FLOAT) { -> 32; }
                    case (LK.DOUBLE) { -> 64; }
                    default
                    {
                        -> 0;
                    };
                };
            };


            pack_array_ptr(Node* n, IRValue* av, IRType* tt) -> IRValue*
            {
                IRType* at = av.ty.elem;
                IRType* et = at.elem;
                IRValue* res;
                IRValue* ep;
                IRValue* ev;
                int eb = this.pack_bits(et);
                int i;
                int off;
                int ew;
                switch (eb == 0 | at.count * eb != tt.width)
                {
                    case (true) {
                    this.unsup(n, g"array pointer pack cast\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        res = this.mod.c_int(tt, (i64)0);
                        i = at.count - 1;
                        while (i >= 0)
                        {
                            this.mod.ia[0] = this.ci32(0);
                            this.mod.ia[1] = this.ci32(i);
                            ep = this.mod.gep(av, this.mod.ia, 2, true, (byte*)0);
                            ev = this.mod.load(ep, (byte*)0);
                            switch (ev.ty.kind == LK.FLOAT) { case (true) { ev = this.mod.cast(g"bitcast\0", ev, this.t_i32, g"float_bits\0"); } default {}; };
                            switch (ev.ty.kind == LK.DOUBLE) { case (true) { ev = this.mod.cast(g"bitcast\0", ev, this.t_i64, g"double_bits\0"); } default {}; };
                            ew = ev.ty.width;
                            switch (ev.ty.width < tt.width) { case (true) { ev = this.mod.cast(g"zext\0", ev, tt, (byte*)0); } default {}; };
                            switch (ev.ty.width > tt.width) { case (true) { ev = this.mod.cast(g"trunc\0", ev, tt, (byte*)0); } default {}; };
                            switch (off > 0) { case (true) { ev = this.mod.binop(g"shl\0", ev, this.mod.c_int(tt, (i64)off), (byte*)0); } default {}; };
                            res = this.mod.binop(g"or\0", res, ev, (byte*)0);
                            off = off + ew;
                            i--;
                        };
                        -> res;
                    };
                };
            };



            scalar_to_bytes(IRValue* v, IRType* at) -> IRValue*
            {
                int count = at.count;
                IRValue* al = this.mod.alloca_here(this.mod.t_array(at.elem, count + 1), g"scalar_to_bytes\0");
                IRValue* wide = v;
                IRValue* sh;
                IRValue* bv;
                IRValue* dp;
                int i;
                int shift;
                switch (v.ty.width < 32) { case (true) { wide = this.mod.cast(g"zext\0", v, this.t_i32, g"scalar_widen\0"); } default {}; };
                while (i < count)
                {
                    shift = (count - 1 - i) * 8;
                    sh = wide;
                    this.sc.clear();
                    this.sc.put_str(f"scalar_shift_{i}\0");
                    switch (shift > 0)
                    {
                        case (true) { sh = this.mod.binop(g"lshr\0", wide, this.mod.c_int(wide.ty, (i64)shift), this.sc.mem); }
                        default {};
                    };
                    this.sc.clear();
                    this.sc.put_str(f"scalar_byte_{i}\0");
                    bv = this.mod.cast(g"trunc\0", sh, this.t_i8, this.sc.mem);
                    this.mod.ia[0] = this.ci32(0);
                    this.mod.ia[1] = this.ci32(i);
                    this.sc.clear();
                    this.sc.put_str(f"scalar_dst_{i}\0");
                    dp = this.mod.gep(al, this.mod.ia, 2, true, this.sc.mem);
                    this.mod.store(bv, dp);
                    i++;
                };
                this.mod.ia[0] = this.ci32(0);
                this.mod.ia[1] = this.ci32(count);
                dp = this.mod.gep(al, this.mod.ia, 2, true, g"scalar_null_term\0");
                this.mod.store(this.mod.c_int(this.t_i8, (i64)0), dp);
                -> al;
            };

            unpack_to_array(Node* n, IRValue* v, IRType* at) -> IRValue*
            {
                IRType* et = at.elem;
                IRType* it;
                IRType* iet;
                IRValue* packed = v;
                IRValue* al;
                IRValue* sh;
                IRValue* ei;
                IRValue* ev;
                IRValue* ep;
                int eb = this.pack_bits(et);
                int total = at.count * eb;
                int i;
                int pos;
                u64 mk;
                bool isf = et.kind == LK.FLOAT | et.kind == LK.DOUBLE;
                switch (eb == 0 | total > 64)
                {
                    case (true) {
                    this.unsup(n, g"cast between these types\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        it = this.mod.t_int(total);
                        iet = this.mod.t_int(eb);
                        switch (v.ty.kind == LK.INT)
                        {
                            case (true) {
                            switch (v.ty.width > total) { case (true) { packed = this.mod.cast(g"trunc\0", v, it, g"unpack_trunc\0"); } default {}; };
                            switch (v.ty.width < total) { case (true) { packed = this.mod.cast(g"zext\0", v, it, g"unpack_zext\0"); } default {}; };
                        }
                            default {
                            switch (v.ty.kind == LK.FLOAT | v.ty.kind == LK.DOUBLE)
                            {
                                case (true) { packed = this.mod.cast(g"bitcast\0", v, it, g"float_to_bits\0"); }
                                default {
                                    this.unsup(n, g"cast between these types\0");
                                    -> (IRValue*)0;
                                };
                            };
                        };
                        };
                        al = this.mod.alloca_here(at, g"unpacked_arr\0");
                        mk = ((u64)1 << (u64)eb) - (u64)1;
                        switch (eb >= 64) { case (true) { mk = (u64)0 - (u64)1; } default {}; };
                        while (i < at.count)
                        {
                            pos = (at.count - 1 - i) * eb;
                            sh = this.mod.binop(g"lshr\0", packed, this.mod.c_int(it, (i64)pos), this.nm_ab(g"unpack_shift_\0", i, -1));
                            ei = this.mod.binop(g"and\0", sh, this.mod.c_u64(it, mk), this.nm_ab(g"unpack_elem_\0", i, -1));
                            switch (total != eb)
                            {
                                case (true) {
                                switch (isf)
                                {
                                    case (true) { ei = this.mod.cast(g"trunc\0", ei, iet, this.nm_ab(g"unpack_trunc_\0", i, -1)); }
                                    default { ei = this.mod.cast(g"trunc\0", ei, et, this.nm_ab(g"unpack_trunc_\0", i, -1)); };
                                };
                            }
                                default {};
                            };
                            ev = ei;
                            switch (isf) { case (true) { ev = this.mod.cast(g"bitcast\0", ei, et, this.nm_ab(g"unpack_float_\0", i, -1)); } default {}; };
                            this.mod.ia[0] = this.ci32(0);
                            this.mod.ia[1] = this.ci32(i);
                            ep = this.mod.gep(al, this.mod.ia, 2, true, (byte*)0);
                            this.mod.store(ev, ep);
                            i++;
                        };
                        -> al;
                    };
                };
            };

            x_cast(Node* n) -> IRValue*
            {
                IRType* tt;
                IRType* st;
                IRValue* v;
                IRValue* r;
                LVar* lv;
                TypeSpec* tsp = n.ts;
                bool su, tu;
                tt = this.lower(tsp, true, n.line);
                switch (this.nerrors > this.body_errs)
                {
                    case (true) {
                    this.unsup(n, g"cast type lowering\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (tt.kind == LK.VOID)
                        {
                            case (true) {
                            -> this.cast_void(n);
                        }
                            default
                            {
                                switch (n.a.kind == NodeKind.LITERAL & n.a.op == DataType.VOID)
                                {
                                    case (true) {
                                    switch (tt.kind == LK.PTR)
                                    {
                                        case (true) { -> this.mod.c_null(tt); }
                                        default {};
                                    };
                                    switch (tt.kind == LK.INT)
                                    {
                                        case (true) { -> this.mod.c_int(tt, (i64)0); }
                                        default {};
                                    };
                                    switch (tt.kind == LK.FLOAT | tt.kind == LK.DOUBLE)
                                    {
                                        case (true) { -> this.mod.c_fp(tt, 0.0); }
                                        default {};
                                    };
                                    this.unsup(n, g"void literal cast\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        v = this.visit(n.a);
                                        switch (this.bad)
                                        {
                                            case (true) { -> (IRValue*)0; }
                                            default
                                            {
                                                switch (v == (IRValue*)0)
                                                {
                                                    case (true) {
                                                    this.unsup(n, g"cast of void value\0");
                                                    -> (IRValue*)0;
                                                }
                                                    default
                                                    {
                                                        st = v.ty;
                                                        switch (lt_eq(st, tt))
                                                        {
                                                            case (true) {
                                                            v = this.cast_endian_fix(v, tsp);
                                                            v.spec = tsp;
                                                            -> v;
                                                        }
                                                            default
                                                            {
                                                                switch (lt_eq(tt, this.t_i8p) & st.kind == LK.PTR)
                                                                {
                                                                    case (true) {
                                                                    -> this.mod.cast(g"bitcast\0", v, this.t_i8p, g"to_void_ptr\0");
                                                                }
                                                                    default
                                                                    {
                                                                        switch (lt_eq(st, this.t_i8p) & tt.kind == LK.PTR)
                                                                        {
                                                                            case (true) {
                                                                            -> this.mod.cast(g"bitcast\0", v, tt, g"from_void_ptr\0");
                                                                        }
                                                                            default
                                                                            {
                                                                                switch (st.kind == LK.INT & tt.kind == LK.INT)
                                                                                {
                                                                                    case (true) {
                                                                                    switch (st.width > tt.width)
                                                                                    {
                                                                                        case (true) { r = this.mod.cast(g"trunc\0", v, tt, (byte*)0); }
                                                                                        default {
                                                                                            switch (st.width < tt.width)
                                                                                            {
                                                                                                case (true) {
                                                                                        switch (n.a.kind)
                                                                                        {
                                                                                            case (NodeKind.LITERAL)
                                                                                            {
                                                                                                switch (n.a.op)
                                                                                                {
                                                                                                    case (DataType.UINT) { r = this.mod.cast(g"zext\0", v, tt, (byte*)0); }
                                                                                                    default { r = this.mod.cast(g"sext\0", v, tt, (byte*)0); };
                                                                                                };
                                                                                            }
                                                                                            default
                                                                                            {
                                                                                                su = this.is_uns(v);
                                                                                                switch (!su & n.a.kind == NodeKind.IDENTIFIER)
                                                                                                {
                                                                                                    case (true) {
                                                                                                    lv = this.find_var(n.a.text);
                                                                                                    switch (lv != (LVar*)0)
                                                                                                    {
                                                                                                        case (true) {
                                                                                                        switch (lv.ts != (TypeSpec*)0)
                                                                                                        {
                                                                                                            case (true) { su = (lv.ts.flags `& 1) == 0; }
                                                                                                            default {};
                                                                                                        };
                                                                                                    }
                                                                                                        default {};
                                                                                                    };
                                                                                                }
                                                                                                    default {};
                                                                                                };
                                                                                                tu = su | tsp.base_type == DataType.UINT | tsp.base_type == DataType.BYTE;
                                                                                                switch (tsp.base_type == DataType.DATA & (tsp.flags `& 1) == 0)
                                                                                                {
                                                                                                    case (true) { tu = true; }
                                                                                                    default {};
                                                                                                };
                                                                                                switch (tsp.custom_typename != (byte*)0)
                                                                                                {
                                                                                                    case (true) {
                                                                                                    switch (tsp.custom_typename[0] == 'u')
                                                                                                    {
                                                                                                        case (true) { tu = true; }
                                                                                                        default {};
                                                                                                    };
                                                                                                }
                                                                                                    default {};
                                                                                                };
                                                                                                switch (tu)
                                                                                                {
                                                                                                    case (true) { r = this.mod.cast(g"zext\0", v, tt, (byte*)0); }
                                                                                                    default { r = this.mod.cast(g"sext\0", v, tt, (byte*)0); };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    }
                                                                                                default { r = v; };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                    r = this.cast_endian_fix(r, tsp);
                                                                                    r.spec = tsp;
                                                                                    -> r;
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        switch (st.kind == LK.INT & (tt.kind == LK.FLOAT | tt.kind == LK.DOUBLE))
                                                                                        {
                                                                                            case (true) {
                                                                                            -> this.mod.cast(g"sitofp\0", v, tt, (byte*)0);
                                                                                        }
                                                                                            default
                                                                                            {
                                                                                                switch ((st.kind == LK.FLOAT | st.kind == LK.DOUBLE) & tt.kind == LK.INT)
                                                                                                {
                                                                                                    case (true) {
                                                                                                    -> this.mod.cast(g"fptosi\0", v, tt, (byte*)0);
                                                                                                }
                                                                                                    default
                                                                                                    {
                                                                                                        switch (st.kind == LK.FLOAT & tt.kind == LK.DOUBLE)
                                                                                                        {
                                                                                                            case (true) {
                                                                                                            -> this.mod.cast(g"fpext\0", v, tt, (byte*)0);
                                                                                                        }
                                                                                                            default
                                                                                                            {
                                                                                                                switch (st.kind == LK.DOUBLE & tt.kind == LK.FLOAT)
                                                                                                                {
                                                                                                                    case (true) {
                                                                                                                    -> this.mod.cast(g"fptrunc\0", v, tt, (byte*)0);
                                                                                                                }
                                                                                                                    default
                                                                                                                    {
                                                                                                                        switch (st.kind == LK.PTR & tt.kind == LK.PTR)
                                                                                                                        {
                                                                                                                            case (true) {
                                                                                                                            -> this.mod.cast(g"bitcast\0", v, tt, (byte*)0);
                                                                                                                        }
                                                                                                                            default
                                                                                                                            {
                                                                                                                                switch (st.kind == LK.INT & tt.kind == LK.PTR)
                                                                                                                                {
                                                                                                                                    case (true) {
                                                                                                                                    switch (st.width < 64)
                                                                                                                                    {
                                                                                                                                        case (true) { v = this.mod.cast(g"zext\0", v, this.t_i64, g"int_to_ptr_zext\0"); }
                                                                                                                                        default {};
                                                                                                                                    };
                                                                                                                                    -> this.mod.cast(g"inttoptr\0", v, tt, g"int_to_ptr\0");
                                                                                                                                }
                                                                                                                                    default
                                                                                                                                    {
                                                                                                                                        switch (st.kind == LK.PTR & tt.kind == LK.INT)
                                                                                                                                        {
                                                                                                                                            case (true) {
                                                                                                                                            switch (st.elem.kind == LK.ARRAY)
                                                                                                                                            {
                                                                                                                                                case (true) { -> this.pack_array_ptr(n, v, tt); }
                                                                                                                                                default {};
                                                                                                                                            };
                                                                                                                                            -> this.mod.cast(g"ptrtoint\0", v, tt, g"ptr_to_int\0");
                                                                                                                                        }
                                                                                                                                            default
                                                                                                                                            {
                                                                                                                                                switch (tt.kind == LK.ARRAY & st.kind == LK.INT & tt.elem.kind == LK.INT & tt.elem.width == 8)
                                                                                                                                                {
                                                                                                                                                    case (true) { -> this.scalar_to_bytes(v, tt); }
                                                                                                                                                    default
                                                                                                                                                    {
                                                                                                                                                        switch (tt.kind == LK.ARRAY & ((st.kind == LK.INT & !(tt.elem.kind == LK.INT & tt.elem.width == 8)) | st.kind == LK.FLOAT | st.kind == LK.DOUBLE))
                                                                                                                                                        {
                                                                                                                                                            case (true) { -> this.unpack_to_array(n, v, tt); }
                                                                                                                                                            default
                                                                                                                                                            {
                                                                                                                                                                this.unsup(n, g"cast between these types\0");
                                                                                                                                                                -> (IRValue*)0;
                                                                                                                                                            };
                                                                                                                                                        };
                                                                                                                                                    };
                                                                                                                                                };
                                                                                                                                            };
                                                                                                                                        };
                                                                                                                                    };
                                                                                                                                };
                                                                                                                            };
                                                                                                                        };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            x_string(Node* n) -> IRValue*
            {
                int len = (int)n.ival;
                int i;
                byte* src = n.text;
                byte* buf;
                IRType* aty;
                IRValue* cv;
                IRValue* arr;
                IRValue* gp;
                IRGlobal* gl;
                void* hit;
                switch (src == (byte*)0)
                {
                    case (true) {
                    this.unsup(n, g"string without text\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (len <= 0)
                        {
                            case (true) {
                            while (src[len] != 0)
                            {
                                len++;
                            };
                        }
                            default {};
                        };
                        switch (n.op == StorageClass.HEAP)
                        {
                            case (true) {
                            this.unsup(n, g"heap string\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                buf = (byte*)fmalloc((u64)(len + 2));
                                this.keep((void*)buf);
                                i = 0;
                                while (i < len)
                                {
                                    buf[i] = src[i];
                                    i++;
                                };
                                switch (this.null_term)
                                {
                                    case (true) {
                                    switch (len == 0)
                                    {
                                        case (true) {
                                        buf[0] = (byte)0;
                                        len = 1;
                                    }
                                        default {
                                            switch (buf[len - 1] != (byte)0)
                                            {
                                                case (true) {
                                        buf[len] = (byte)0;
                                        len++;
                                    }
                                                default {};
                                            };
                                        };
                                    };
                                }
                                    default {};
                                };
                                aty = this.mod.t_array(this.t_i8, len);
                                switch (n.op == StorageClass.GLOBAL)
                                {
                                    case (true) {
                                    cv = this.mod.c_bytes(aty, buf, len);
                                    hit = nm_get(this.gcache, cv.text);
                                    switch (hit != (void*)0)
                                    {
                                        case (true) { -> (IRValue*)hit; }
                                        default {};
                                    };
                                    this.sc.clear();
                                    this.sc.put_str(f".str.{this.nstr}\0");
                                    this.nstr++;
                                    gl = this.mod.add_global(aty, this.sc.mem, cv.text);
                                    gl.linkage = this.mod.own(g"internal\0");
                                    gl.constant = true;
                                    this.mark_arr_ptr(gl.self.ty);
                                    nm_put(this.gcache, this.mod.own(cv.text), (void*)gl.self);
                                    -> gl.self;
                                }
                                    default
                                    {
                                        arr = this.mod.alloca_here(aty, g"str_stack\0");
                                        i = 0;
                                        while (i < len)
                                        {
                                            this.mod.ia[0] = this.ci32(0);
                                            this.mod.ia[1] = this.ci32(i);
                                            this.sc.clear();
                                            this.sc.put_str(f"str_char_{i}\0");
                                            gp = this.mod.gep(arr, this.mod.ia, 2, false, this.sc.mem);
                                            this.mod.store(this.mod.c_int(this.t_i8, (i64)((int)buf[i])), gp);
                                            i++;
                                        };
                                        this.mark_arr_ptr(arr.ty);
                                        -> arr;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            pref_align(IRType* t) -> int
            {
                int b;
                switch (t.kind == LK.INT)
                {
                    case (true) {
                    b = (t.width + 7) / 8;
                    switch (b > 8) { case (true) { -> -1; } default {}; };
                    switch (b == 3) { case (true) { b = 4; } default {}; };
                    switch (b > 4 & b < 8) { case (true) { b = 8; } default {}; };
                    -> b;
                }
                    default
                    {
                        switch (t.kind == LK.FLOAT) { case (true) { -> 4; } default
                            {
                                switch (t.kind == LK.DOUBLE | t.kind == LK.PTR) { case (true) { -> 8; } default
                                    {
                                        switch (t.kind == LK.ARRAY) { case (true) { -> this.pref_align(t.elem); } default
                                            {
                                                -> -1;
                                            }; };
                                    }; };
                            }; };
                    };
                };
            };


            x_alignof(Node* n) -> IRValue*
            {
                TypeSpec* ts = n.ts;
                IRType* lt;
                int a;
                switch (ts == (TypeSpec*)0)
                {
                    case (true) {
                    this.unsup(n, g"alignof of expression\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (ts.alignment > 0)
                        {
                            case (true) { -> this.mod.c_int(this.t_i32, (i64)ts.alignment); }
                            default
                            {
                                switch (ts.base_type == DataType.DATA & ts.bit_width > 0)
                                {
                                    case (true) { -> this.mod.c_int(this.t_i32, (i64)((ts.bit_width + 7) / 8)); }
                                    default
                                    {
                                        lt = this.lower(ts, true, n.line);
                                        switch (this.nerrors > this.body_errs)
                                        {
                                            case (true) {
                                            this.unsup(n, g"alignof type lowering\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                a = this.pref_align(lt);
                                                switch (a < 0)
                                                {
                                                    case (true) {
                                                    this.unsup(n, g"alignof of aggregate\0");
                                                    -> (IRValue*)0;
                                                }
                                                    default
                                                    {
                                                        -> this.mod.c_int(this.t_i32, (i64)a);
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            x_sizeof(Node* n) -> IRValue*
            {
                IRType* t;
                IRValue* v;
                IDKC_SYMENTRY* e;
                LVar* lv;
                switch (n.ts != (TypeSpec*)0)
                {
                    case (true) {
                    t = this.lower(n.ts, true, n.line);
                    switch (this.nerrors > this.body_errs)
                    {
                        case (true) {
                        this.unsup(n, g"sizeof type lowering\0");
                        -> (IRValue*)0;
                    }
                        default {};
                    };
                    -> this.mod.c_int(this.t_i32, (i64)bits_of(t));
                }
                    default
                    {
                        switch (n.a == (Node*)0)
                        {
                            case (true) {
                            this.unsup(n, g"sizeof without target\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (n.a.kind == NodeKind.IDENTIFIER)
                                {
                                    case (true) {
                                    e = st_lookup_any(this.st, n.a.text, this.cur_ns);
                                    switch (e != (IDKC_SYMENTRY*)0)
                                    {
                                        case (true) {
                                        switch (e.kind_id == SymbolKind.STRUCT | e.kind_id == SymbolKind.OBJECT |
                                            e.kind_id == SymbolKind.UNION | e.kind_id == SymbolKind.ENUM |
                                            e.kind_id == SymbolKind.TYPE)
                                        {
                                            case (true) {
                                            t = this.resolve_custom(n.a.text);
                                            switch (t != (IRType*)0)
                                            {
                                                case (true) { -> this.mod.c_int(this.t_i32, (i64)bits_of(t)); }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    lv = this.find_var(n.a.text);
                                    switch (lv != (LVar*)0)
                                    {
                                        case (true) {
                                        switch (lv.ts != (TypeSpec*)0)
                                        {
                                            case (true) {
                                            t = this.lower(lv.ts, true, n.line);
                                            switch (this.nerrors > this.body_errs)
                                            {
                                                case (true) {
                                                this.unsup(n, g"sizeof variable type\0");
                                                -> (IRValue*)0;
                                            }
                                                default {};
                                            };
                                            -> this.mod.c_int(this.t_i32, (i64)bits_of(t));
                                        }
                                            default {};
                                        };
                                        -> this.mod.c_int(this.t_i32, (i64)bits_of(lv.ptr.ty.elem));
                                    }
                                        default {};
                                    };
                                    switch (this.pst != (IDKC_SYMTABLE*)0)
                                    {
                                        case (true) {
                                        TypeSpec* pts = st_get_type_spec(this.pst, n.a.text);
                                        switch (pts != (TypeSpec*)0)
                                        {
                                            case (true) {
                                            t = this.lower(pts, true, n.line);
                                            switch (this.nerrors > this.body_errs)
                                            {
                                                case (true) {
                                                this.unsup(n, g"sizeof variable type\0");
                                                -> (IRValue*)0;
                                            }
                                                default {};
                                            };
                                            -> this.mod.c_int(this.t_i32, (i64)bits_of(t));
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    this.unsup(n, g"sizeof unresolved name\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        v = this.visit(n.a);
                                        switch (this.bad)
                                        {
                                            case (true) { -> (IRValue*)0; }
                                            default
                                            {
                                                switch (v == (IRValue*)0)
                                                {
                                                    case (true) {
                                                    this.unsup(n, g"sizeof void\0");
                                                    -> (IRValue*)0;
                                                }
                                                    default
                                                    {
                                                        -> this.mod.c_int(this.t_i32, (i64)bits_of(v.ty));
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };







            mark_arr_ptr(IRType* t) -> void
            {
                -> pv_push(this.arr_ptrs, (void*)t);
            };

            is_arr_ptr(IRType* t) -> bool
            {
                int i;
                while (i < this.arr_ptrs.len)
                {
                    switch (this.arr_ptrs.items[i] == (void*)t)
                    {
                        case (true) { -> true; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> false;
            };


            star_name(byte* base, int depth) -> byte*
            {
                Buf nb;
                byte* r;
                int i;
                nb.__init();
                nb.put_str(base);
                while (i < depth)
                {
                    nb.put_str(g"*\0");
                    i++;
                };
                r = this.mod.own(nb.mem);
                nb.__exit();
                -> r;
            };


            name_n(byte* prefix, int i) -> byte*
            {
                Buf nb;
                byte* r;
                nb.__init();
                nb.put_str(f"{prefix}{i}\0");
                r = this.mod.own(nb.mem);
                nb.__exit();
                -> r;
            };


            typeof_name_ts(TypeSpec* t) -> byte*
            {
                byte* base = datatype_text(t.base_type);
                int depth = t.pointer_depth;
                switch (t.custom_typename != (byte*)0)
                {
                    case (true) {
                    switch (t.custom_typename[0] != (byte)0)
                    {
                        case (true) { base = t.custom_typename; }
                        default {};
                    };
                }
                    default {};
                };
                switch (ts_is_pointer(t) & depth < 1)
                {
                    case (true) { depth = 1; }
                    default {};
                };
                switch (ts_is_array(t))
                {
                    case (true) { depth++; }
                    default {};
                };
                -> this.star_name(base, depth);
            };


            typeof_name_llvm(IRType* t) -> byte*
            {
                IRType* inner;
                byte* b;
                int depth;
                switch (t.kind == LK.INT)
                {
                    case (true) {
                    switch (t.width == 1)
                    {
                        case (true) { -> datatype_text(DataType.BOOL); }
                        default {};
                    };
                    switch (t.width == 8)
                    {
                        case (true) { -> datatype_text(DataType.BYTE); }
                        default {};
                    };
                    switch (t.width == 64)
                    {
                        case (true) { -> datatype_text(DataType.SLONG); }
                        default {};
                    };
                    -> datatype_text(DataType.SINT);
                }
                    default
                    {
                        switch (t.kind == LK.FLOAT)
                        {
                            case (true) { -> datatype_text(DataType.FLOAT); }
                            default
                            {
                                switch (t.kind == LK.DOUBLE)
                                {
                                    case (true) { -> datatype_text(DataType.DOUBLE); }
                                    default
                                    {
                                        switch (t.kind == LK.PTR)
                                        {
                                            case (true) {
                                            switch (t.elem.kind == LK.ARRAY & this.is_arr_ptr(t))
                                            {
                                                case (true) {
                                                b = this.typeof_name_llvm(t.elem.elem);
                                                switch (b == (byte*)0)
                                                {
                                                    case (true) { -> (byte*)0; }
                                                    default {};
                                                };
                                                -> this.star_name(b, 1);
                                            }
                                                default {};
                                            };
                                            inner = t;
                                            while (inner.kind == LK.PTR)
                                            {
                                                depth++;
                                                inner = inner.elem;
                                            };
                                            b = this.typeof_name_llvm(inner);
                                            switch (b == (byte*)0)
                                            {
                                                case (true) { -> (byte*)0; }
                                                default {};
                                            };
                                            -> this.star_name(b, depth);
                                        }
                                            default
                                            {
                                                switch (t.kind == LK.ARRAY)
                                                {
                                                    case (true) {
                                                    b = this.typeof_name_llvm(t.elem);
                                                    switch (b == (byte*)0)
                                                    {
                                                        case (true) { -> (byte*)0; }
                                                        default {};
                                                    };
                                                    -> this.star_name(b, 1);
                                                }
                                                    default
                                                    {
                                                        switch (t.kind == LK.ISTRUCT)
                                                        {
                                                            case (true) {
                                                            switch (t.name != (byte*)0)
                                                            {
                                                                case (true) {
                                                                switch (t.name[0] != (byte)0)
                                                                {
                                                                    case (true) { -> t.name; }
                                                                    default {};
                                                                };
                                                            }
                                                                default {};
                                                            };
                                                            -> datatype_text(DataType.STRUCT);
                                                        }
                                                            default
                                                            {
                                                                switch (t.kind == LK.STRUCT)
                                                                {
                                                                    case (true) { -> datatype_text(DataType.STRUCT); }
                                                                    default
                                                                    {
                                                                        switch (t.kind == LK.VOID)
                                                                        {
                                                                            case (true) { -> datatype_text(DataType.VOID); }
                                                                            default
                                                                            {
                                                                                -> (byte*)0;
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            has_named_type(byte* name) -> bool
            {
                int i;
                IRType* t;
                while (i < this.mod.named.len)
                {
                    t = (IRType*)this.mod.named.items[i];
                    switch (cstr_eq(t.name, name))
                    {
                        case (true) { -> true; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> false;
            };


            typeof_resolve_ident(byte* name) -> byte*
            {
                IDKC_SYMENTRY* e;
                LVar* lv;
                int i, ln, ls1, ls2;
                byte* key;
                byte* m;
                byte* sfx1;
                byte* sfx2;
                bool hit;
                e = st_lookup_type(this.st, name, this.cur_ns);
                switch (e != (IDKC_SYMENTRY*)0)
                {
                    case (true) { -> name; }
                    default
                    {
                        switch (nm_has(this.structs, name) | nm_has(this.unions, name) | nm_has(this.enums, name))
                        {
                            case (true) { -> name; }
                            default
                            {
                                while (i < this.st.registered_ns.len)
                                {
                                    m = mangle_namespace_name((byte*)this.st.registered_ns.items[i], name);
                                    hit = nm_has(this.structs, m);
                                    ffree(m);
                                    switch (hit)
                                    {
                                        case (true) { -> name; }
                                        default
                                        {
                                            i++;
                                        };
                                    };
                                };
                                i = 0;
                                while (i < this.st.using_ns.len)
                                {
                                    m = mangle_namespace_name((byte*)this.st.using_ns.items[i], name);
                                    hit = nm_has(this.structs, m);
                                    ffree(m);
                                    switch (hit)
                                    {
                                        case (true) { -> name; }
                                        default
                                        {
                                            i++;
                                        };
                                    };
                                };
                                switch (this.cur_ns[0] != (byte)0)
                                {
                                    case (true) {
                                    m = mangle_namespace_name(this.cur_ns, name);
                                    hit = nm_has(this.structs, m);
                                    ffree(m);
                                    switch (hit)
                                    {
                                        case (true) { -> name; }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                lv = this.find_var(name);
                                switch (lv != (LVar*)0)
                                {
                                    case (true) {
                                    switch (lv.ts != (TypeSpec*)0)
                                    {
                                        case (true) { -> this.typeof_name_ts(lv.ts); }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (this.has_named_type(name))
                                {
                                    case (true) { -> name; }
                                    default
                                    {
                                        sfx1 = join3(g"__\0", name, g"\0");
                                        sfx2 = join3(g".\0", name, g"\0");
                                        ls1 = pp_cstrlen(sfx1);
                                        ls2 = pp_cstrlen(sfx2);
                                        i = 0;
                                        hit = false;
                                        while (i < this.structs.count & !hit)
                                        {
                                            key = this.structs.keys[i];
                                            ln = pp_cstrlen(key);
                                            hit = cstr_eq(key, name);
                                            switch (!hit & ln >= ls1)
                                            {
                                                case (true) { hit = pp_eq(key + ln - ls1, sfx1, ls1); }
                                                default {};
                                            };
                                            switch (!hit & ln >= ls2)
                                            {
                                                case (true) { hit = pp_eq(key + ln - ls2, sfx2, ls2); }
                                                default {};
                                            };
                                            i++;
                                        };
                                        ffree(sfx1);
                                        ffree(sfx2);
                                        switch (hit)
                                        {
                                            case (true) { -> name; }
                                            default
                                            {
                                                -> (byte*)0;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            typeof_str(byte* name) -> IRValue*
            {
                void* hit = nm_get(this.tcache, name);
                int len = pp_cstrlen(name);
                IRType* aty;
                IRValue* cv;
                IRGlobal* gl;
                byte* gn;
                switch (hit != (void*)0)
                {
                    case (true) { -> (IRValue*)hit; }
                    default
                    {
                        aty = this.mod.t_array(this.t_i8, len);
                        cv = this.mod.c_bytes(aty, name, len);
                        gn = join3(g".typeof.\0", name, g"\0");
                        gl = this.mod.add_global(aty, gn, cv.text);
                        ffree(gn);
                        gl.linkage = this.mod.own(g"internal\0");
                        gl.constant = true;
                        this.mark_arr_ptr(gl.self.ty);
                        nm_put(this.tcache, name, (void*)gl.self);
                        -> gl.self;
                    };
                };
            };



            typeof_name(Node* n) -> byte*
            {
                IRValue* v;
                byte* nm;
                switch (n.ts != (TypeSpec*)0)
                {
                    case (true) { -> this.typeof_name_ts(n.ts); }
                    default {};
                };
                switch (n.a == (Node*)0)
                {
                    case (true) {
                    this.unsup(n, g"typeof without target\0");
                    -> (byte*)0;
                }
                    default {};
                };
                switch (n.a.kind == NodeKind.IDENTIFIER & n.a.text != (byte*)0)
                {
                    case (true) {
                    nm = this.typeof_resolve_ident(n.a.text);
                    switch (nm != (byte*)0)
                    {
                        case (true) { -> nm; }
                        default {};
                    };
                }
                    default {};
                };
                switch (n.a.kind == NodeKind.LITERAL)
                {
                    case (true) { -> datatype_text(n.a.op); }
                    default {};
                };
                v = this.visit(n.a);
                switch (this.bad)
                {
                    case (true) { -> (byte*)0; }
                    default {};
                };
                switch (v == (IRValue*)0)
                {
                    case (true) {
                    this.unsup(n, g"typeof void\0");
                    -> (byte*)0;
                }
                    default {};
                };
                switch (v.spec != (TypeSpec*)0)
                {
                    case (true) { -> this.typeof_name_ts(v.spec); }
                    default {};
                };
                nm = this.typeof_name_llvm(v.ty);
                switch (nm == (byte*)0)
                {
                    case (true) {
                    this.sc.clear();
                    this.sc.put_str(f"typeof(): cannot determine a IDEKA type name for LLVM type {this.mod.type_str(v.ty)}\0");
                    this.fail_at(n, this.sc.mem);
                    this.unsup(n, g"typeof llvm type name\0");
                    -> (byte*)0;
                }
                    default {};
                };
                -> nm;
            };



            typeof_id(byte* name) -> int
            {
                void* hit = nm_get(this.tids, name);
                switch (hit != (void*)0)
                {
                    case (true) { -> (int)(i64)hit; }
                    default
                    {
                        this.tid_n++;
                        nm_put(this.tids, name, (void*)(i64)this.tid_n);
                        -> this.tid_n;
                    };
                };
            };


            x_typeof(Node* n) -> IRValue*
            {
                byte* nm = this.typeof_name(n);
                switch (nm == (byte*)0)
                {
                    case (true) { -> (IRValue*)0; }
                    default { -> this.typeof_str(nm); };
                };
            };


            typeof_category_for_name(byte* name) -> int
            {
                void* p;
                SInfo* si;
                LVar* lv;
                p = nm_get(this.structs, name);
                switch (p != (void*)0)
                {
                    case (true) {
                    si = (SInfo*)p;
                    switch (si.is_object)
                    {
                        case (true) { -> DataType.OBJECT; }
                        default {};
                    };
                    -> DataType.STRUCT;
                }
                    default
                    {
                        switch (nm_has(this.unions, name) | nm_has(this.enums, name))
                        {
                            case (true) { -> -1; }
                            default
                            {
                                lv = this.find_var(name);
                                switch (lv != (LVar*)0)
                                {
                                    case (true) {
                                    switch (lv.ts != (TypeSpec*)0)
                                    {
                                        case (true) {
                                        switch (lv.ts.custom_typename != (byte*)0)
                                        {
                                            case (true) { -> this.typeof_category_for_name(lv.ts.custom_typename); }
                                            default
                                            {
                                                switch (lv.ts.base_type == DataType.STRUCT | lv.ts.base_type == DataType.OBJECT)
                                                {
                                                    case (true) { -> lv.ts.base_type; }
                                                    default {};
                                                };
                                            };
                                        };
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (this.has_named_type(name))
                                {
                                    case (true) { -> DataType.STRUCT; }
                                    default
                                    {
                                        -> -1;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            typeof_arg_category(Node* t) -> int
            {
                switch (t.ts != (TypeSpec*)0)
                {
                    case (true) {
                    switch (t.ts.custom_typename != (byte*)0)
                    {
                        case (true) { -> this.typeof_category_for_name(t.ts.custom_typename); }
                        default {};
                    };
                    switch (t.ts.base_type == DataType.STRUCT | t.ts.base_type == DataType.OBJECT)
                    {
                        case (true) { -> t.ts.base_type; }
                        default {};
                    };
                    -> -1;
                }
                    default
                    {
                        switch (t.a == (Node*)0)
                        {
                            case (true) { -> -1; }
                            default
                            {
                                switch (t.a.kind == NodeKind.IDENTIFIER & t.a.text != (byte*)0)
                                {
                                    case (true) { -> this.typeof_category_for_name(t.a.text); }
                                    default
                                    {
                                        switch (t.a.kind == NodeKind.LITERAL)
                                        {
                                            case (true) {
                                            switch (t.a.op == DataType.STRUCT | t.a.op == DataType.OBJECT)
                                            {
                                                case (true) { -> t.a.op; }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        -> -1;
                                    };
                                };
                            };
                        };
                    };
                };
            };



            typeof_bare_cat(Node* t) -> int
            {
                TypeSpec* s = t.ts;
                switch (s != (TypeSpec*)0)
                {
                    case (true) {
                    switch (s.custom_typename == (byte*)0 & (s.base_type == DataType.STRUCT | s.base_type == DataType.OBJECT) &
                            !ts_is_pointer(s) & !ts_is_array(s) & s.pointer_depth == 0)
                    {
                        case (true) { -> s.base_type; }
                        default {};
                    };
                    -> -1;
                }
                    default
                    {
                        switch (t.a == (Node*)0)
                        {
                            case (true) { -> -1; }
                            default
                            {
                                switch (t.a.kind == NodeKind.LITERAL & (t.a.op == DataType.STRUCT | t.a.op == DataType.OBJECT) & t.a.text != (byte*)0)
                                {
                                    case (true) {
                                    switch (cstr_eq(t.a.text, datatype_text(t.a.op)))
                                    {
                                        case (true) { -> t.a.op; }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                -> -1;
                            };
                        };
                    };
                };
            };





            sty(IRType* t) -> bool -> t.kind == LK.STRUCT | t.kind == LK.ISTRUCT;

            is_struct_ptr_ty(IRType* t) -> bool
            {
                switch (t.kind != LK.PTR)
                {
                    case (true) { -> false; }
                    default
                    {
                        -> this.sty(t.elem);
                    };
                };
            };


            union_key_of(IRType* t) -> byte*
            {
                int i;
                while (i < this.unions.count)
                {
                    switch (lt_eq((IRType*)this.unions.vals[i], t))
                    {
                        case (true) { -> this.unions.keys[i]; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> (byte*)0;
            };


            union_member(byte* key, byte* name) -> IRType*
            {
                Node* ud = (Node*)nm_get(this.union_defs, key);
                Node* mem;
                int i;
                int c;
                switch (ud == (Node*)0)
                {
                    case (true) { -> (IRType*)0; }
                    default
                    {
                        c = node_count(ud, 0);
                        while (i < c)
                        {
                            mem = node_child(ud, 0, i);
                            switch (cstr_eq(mem.text, name))
                            {
                                case (true) { -> this.lower(mem.ts, false, ud.line); }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                        -> (IRType*)0;
                    };
                };
            };


            union_read(Node* n, IRValue* obj, byte* key) -> IRValue*
            {
                Node* ud = (Node*)nm_get(this.union_defs, key);
                bool tagged = ud.text2 != (byte*)0;
                IRType* mt;
                IRValue* dp;
                IRValue* cp;
                switch (cstr_eq(n.text, g"#\0"))
                {
                    case (true) {
                    switch (!tagged)
                    {
                        case (true) {
                        this.unsup(n, g"tag access on non-tagged union\0");
                        -> (IRValue*)0;
                    }
                        default {};
                    };
                    this.mod.ia[0] = this.ci32(0);
                    this.mod.ia[1] = this.ci32(0);
                    dp = this.mod.gep(obj, this.mod.ia, 2, true, g"union_tag_ptr\0");
                    -> this.mod.load(dp, g"union_tag_value\0");
                }
                    default
                    {
                        mt = this.union_member(key, n.text);
                        switch (mt == (IRType*)0)
                        {
                            case (true) {
                            this.unsup(n, g"union member not found\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                this.sc.clear();
                                this.sc.put_str(f"union_as_{n.text}\0");
                                switch (tagged)
                                {
                                    case (true) {
                                    this.mod.ia[0] = this.ci32(0);
                                    this.mod.ia[1] = this.ci32(1);
                                    dp = this.mod.gep(obj, this.mod.ia, 2, true, g"union_data_ptr\0");
                                    cp = this.mod.cast(g"bitcast\0", dp, this.mod.t_ptr(mt), this.sc.mem);
                                }
                                    default {
                                    cp = this.mod.cast(g"bitcast\0", obj, this.mod.t_ptr(mt), this.sc.mem);
                                    switch (this.sty(mt))
                                    {
                                        case (true) {
                                        cp.flags = cp.flags `| 16;
                                        -> cp;
                                    }
                                        default {};
                                    };
                                };
                                };
                                this.sc.clear();
                                this.sc.put_str(f"union_{n.text}_value\0");
                                -> this.mod.load(cp, this.sc.mem);
                            };
                        };
                    };
                };
            };


            union_store(Node* t, IRValue* obj, byte* key, IRValue* val) -> IRValue*
            {
                Node* ud = (Node*)nm_get(this.union_defs, key);
                bool tagged = ud.text2 != (byte*)0;
                IRType* mt;
                IRValue* dp;
                IRValue* cp;
                int i;
                switch (cstr_eq(t.text, g"#\0"))
                {
                    case (true) {
                    switch (!tagged)
                    {
                        case (true) {
                        this.unsup(t, g"tag assignment on non-tagged union\0");
                        -> (IRValue*)0;
                    }
                        default {};
                    };
                    this.mod.ia[0] = this.ci32(0);
                    this.mod.ia[1] = this.ci32(0);
                    dp = this.mod.gep(obj, this.mod.ia, 2, true, g"union_tag_ptr\0");
                    this.mod.store(val, dp);
                    -> val;
                }
                    default
                    {
                        mt = this.union_member(key, t.text);
                        switch (mt == (IRType*)0)
                        {
                            case (true) {
                            this.unsup(t, g"union member not found\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                while (i < this.inited_unions.len)
                                {
                                    switch (this.inited_unions.items[i] == (void*)obj)
                                    {
                                        case (true) {
                                        this.unsup(t, g"union variable is immutable after initialization\0");
                                        -> (IRValue*)0;
                                    }
                                        default
                                        {
                                            i++;
                                        };
                                    };
                                };
                                pv_push(this.inited_unions, (void*)obj);
                                this.sc.clear();
                                this.sc.put_str(f"union_as_{t.text}\0");
                                switch (tagged)
                                {
                                    case (true) {
                                    this.mod.ia[0] = this.ci32(0);
                                    this.mod.ia[1] = this.ci32(1);
                                    dp = this.mod.gep(obj, this.mod.ia, 2, true, g"union_data_ptr\0");
                                    cp = this.mod.cast(g"bitcast\0", dp, this.mod.t_ptr(mt), this.sc.mem);
                                }
                                    default { cp = this.mod.cast(g"bitcast\0", obj, this.mod.t_ptr(mt), this.sc.mem); };
                                };
                                this.mod.store(val, cp);
                                -> val;
                            };
                        };
                    };
                };
            };

            sinfo_of(IRType* t) -> SInfo*
            {
                switch (t.kind != LK.ISTRUCT)
                {
                    case (true) { -> (SInfo*)0; }
                    default
                    {
                        -> (SInfo*)nm_get(this.structs, t.name);
                    };
                };
            };

            sidx(SInfo* si, byte* name) -> int
            {
                int i;
                while (i < si.n)
                {
                    switch (cstr_eq(si.names[i], name))
                    {
                        case (true) { -> i; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> -1;
            };


            is_struct_val(IRType* t) -> bool
            {
                IRType* b = t;
                switch (b.kind == LK.PTR)
                {
                    case (true) { b = b.elem; }
                    default {};
                };
                switch (b.kind != LK.ISTRUCT)
                {
                    case (true) { -> false; }
                    default
                    {
                        -> nm_has(this.structs, b.name);
                    };
                };
            };



            meta_from_type(IRValue* v) -> IRValue*
            {
                int i;
                bool uns;
                TypeSpec* as_;
                TypeSpec* ts;
                IRType* at;
                while (i < this.al_tys.len)
                {
                    at = (IRType*)this.al_tys.items[i];
                    switch ((i64)this.al_idx.items[i] > (i64)this.cur_stmt)
                    {
                        case (true) { i++; continue; }
                        default
                        {
                            switch (lt_eq(at, v.ty))
                            {
                                case (true) {
                                uns = false;
                                as_ = (TypeSpec*)this.al_specs.items[i];
                                switch (as_ != (TypeSpec*)0)
                                {
                                    case (true) { uns = (as_.flags `& 1) == 0; }
                                    default {};
                                };
                                ts = typespec_new();
                                this.keep((void*)ts);
                                switch (uns)
                                {
                                    case (true) { ts.base_type = DataType.UINT; }
                                    default {
                                    ts.base_type = DataType.SINT;
                                    ts.flags = 1;
                                };
                                };
                                switch (v.ty.kind == LK.INT)
                                {
                                    case (true) { ts.bit_width = v.ty.width; }
                                    default {};
                                };
                                ts.custom_typename = (byte*)this.al_names.items[i];
                                v.spec = ts;
                                -> v;
                            }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                    };
                };
                -> v;
            };


            elem_meta(IRValue* loaded, IRValue* src) -> IRValue*
            {
                TypeSpec* es = src.espec;
                switch (es == (TypeSpec*)0)
                {
                    case (true) {
                    switch (src.spec != (TypeSpec*)0)
                    {
                        case (true) { es = src.spec.array_elem; }
                        default {};
                    };


                    switch (es == (TypeSpec*)0 & src.spec != (TypeSpec*)0)
                    {
                        case (true) {
                        switch (src.spec.pointer_depth > 0 & (src.spec.flags `& 32) == 0)
                        {
                            case (true) {
                            es = typespec_clone(src.spec);
                            es.pointer_depth = es.pointer_depth - 1;
                            switch (es.pointer_depth == 0)
                            {
                                case (true) { es.flags = es.flags - (es.flags `& 64); }
                                default {};
                            };
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                }
                    default {};
                };
                switch (es != (TypeSpec*)0)
                {
                    case (true) {
                    switch (loaded.spec == (TypeSpec*)0)
                    {
                        case (true) { loaded.spec = es; }
                        default {};
                    };
                    -> loaded;
                }
                    default
                    {
                        -> this.meta_from_type(loaded);
                    };
                };
            };


            idx_i32(IRValue* v) -> IRValue*
            {
                switch (v.ty.kind == LK.INT & v.ty.width != 32)
                {
                    case (true) {
                    switch (v.ty.width > 32)
                    {
                        case (true) { -> this.mod.cast(g"trunc\0", v, this.t_i32, g"idx_trunc\0"); }
                        default {};
                    };
                    -> this.mod.cast(g"sext\0", v, this.t_i32, g"idx_ext\0");
                }
                    default
                    {
                        -> v;
                    };
                };
            };


            find_enum_key(byte* name) -> byte*
            {
                IDKC_SYMENTRY* e;
                byte* m;
                byte* key;
                switch (nm_has(this.enums, name))
                {
                    case (true) { -> name; }
                    default
                    {
                        e = st_lookup_any(this.st, name, this.cur_ns);
                        switch (e == (IDKC_SYMENTRY*)0)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                switch (e.kind_id != SymbolKind.ENUM)
                                {
                                    case (true) { -> (byte*)0; }
                                    default
                                    {
                                        m = sym_mangled(e);
                                        switch (!nm_has(this.enums, m))
                                        {
                                            case (true) {
                                            ffree(m);
                                            -> (byte*)0;
                                        }
                                            default
                                            {
                                                key = this.mod.own(m);
                                                ffree(m);
                                                -> key;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            enum_member(Node* n, byte* key) -> IRValue*
            {
                IRType* ty = (IRType*)nm_get(this.enums, key);
                byte* full = join3(key, g".\0", n.text);
                void* p = nm_get(this.enumvals, full);
                IRGlobal* gl;
                i64* box;
                IRValue* r;
                switch (p == (void*)0)
                {
                    case (true) {
                    ffree(full);
                    this.unsup(n, g"enum member not found\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (ty.kind == LK.STRUCT | ty.kind == LK.ISTRUCT | ty.kind == LK.ARRAY)
                        {
                            case (true) {
                            gl = this.mod.find_global(full);
                            ffree(full);
                            switch (gl == (IRGlobal*)0)
                            {
                                case (true) {
                                this.unsup(n, g"enum member not found\0");
                                -> (IRValue*)0;
                            }
                                default {};
                            };
                            -> gl.self;
                        }
                            default
                            {
                                ffree(full);
                                box = (i64*)p;
                                r = this.mod.c_int(ty, box[0]);
                                -> r;
                            };
                        };
                    };
                };
            };


            struct_field(Node* n, Node* objn, byte* field) -> IRValue*
            {
                IRValue* inst = this.visit(objn);
                IRValue* fp;
                LVar* lv;
                SInfo* si;
                IRType* pe;
                int idx;
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        switch (inst == (IRValue*)0)
                        {
                            case (true) {
                            this.unsup(n, g"void struct instance\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (objn.kind == NodeKind.IDENTIFIER)
                                {
                                    case (true) {
                                    switch (inst.ty.kind != LK.PTR & this.sty(inst.ty))
                                    {
                                        case (true) {
                                        lv = this.find_var(objn.text);
                                        switch (lv != (LVar*)0)
                                        {
                                            case (true) {
                                            switch (this.is_struct_ptr_ty(lv.ptr.ty))
                                            {
                                                case (true) { inst = lv.ptr; }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (inst.ty.kind == LK.PTR & this.sty(inst.ty.elem))
                                {
                                    case (true) {
                                    pe = inst.ty.elem;
                                    si = this.sinfo_of(pe);
                                    switch (si == (SInfo*)0)
                                    {
                                        case (true) {
                                        this.unsup(n, g"field of unnamed struct\0");
                                        -> (IRValue*)0;
                                    }
                                        default {};
                                    };
                                    idx = this.sidx(si, field);
                                    switch (idx < 0)
                                    {
                                        case (true) {
                                        this.unsup(n, g"field not found\0");
                                        -> (IRValue*)0;
                                    }
                                        default {};
                                    };
                                    this.sc.clear();
                                    this.sc.put_str(f"{field}_ptr\0");
                                    fp = this.mod.gep_field(inst, idx, true, this.sc.mem);
                                    switch (fp.ty.elem.kind == LK.ARRAY | this.sty(fp.ty.elem))
                                    {
                                        case (true) { -> fp; }
                                        default {};
                                    };
                                    IRValue* sfld = this.mod.load(fp, field);
                                    switch (si.specs[idx] != (TypeSpec*)0 & sfld.spec == (TypeSpec*)0)
                                    {
                                        case (true) { sfld.spec = si.specs[idx]; }
                                        default {};
                                    };
                                    -> sfld;
                                }
                                    default
                                    {
                                        this.unsup(n, g"field access on struct value\0");
                                        -> (IRValue*)0;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            x_member(Node* n) -> IRValue*
            {
                Node* o = n.a;
                byte* key;
                LVar* lv;
                IRValue* obj;
                IRValue* obj2;
                IRValue* r;
                IRValue* mp;
                IRValue* ld;
                IRType* pe;
                byte* ukey;
                SInfo* si;
                int idx;
                bool prev;
                switch (o.kind == NodeKind.IDENTIFIER)
                {
                    case (true) {
                    key = this.find_enum_key(o.text);
                    switch (key != (byte*)0)
                    {
                        case (true) { -> this.enum_member(n, key); }
                        default
                        {
                            lv = this.find_var(o.text);
                            switch (lv != (LVar*)0)
                            {
                                case (true) {
                                switch (lv.ts != (TypeSpec*)0)
                                {
                                    case (true) {
                                    switch (lv.ts.custom_typename != (byte*)0)
                                    {
                                        case (true) {
                                        key = this.find_enum_key(lv.ts.custom_typename);
                                        switch (key != (byte*)0)
                                        {
                                            case (true) { -> this.enum_member(n, key); }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        };
                    };
                }
                    default {};
                };
                prev = this.in_member;
                this.in_member = true;
                obj = this.visit(o);
                switch (this.bad)
                {
                    case (true) {
                    this.in_member = prev;
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (obj == (IRValue*)0)
                        {
                            case (true) {
                            this.in_member = prev;
                            this.unsup(n, g"void member access object\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (this.is_struct_val(obj.ty))
                                {
                                    case (true) {
                                    r = this.struct_field(n, o, n.text);
                                    this.in_member = prev;
                                    -> r;
                                }
                                    default
                                    {
                                        obj2 = this.visit(o);
                                        this.in_member = prev;
                                        switch (this.bad)
                                        {
                                            case (true) { -> (IRValue*)0; }
                                            default
                                            {
                                                switch (obj2 == (IRValue*)0)
                                                {
                                                    case (true) {
                                                    this.unsup(n, g"void member access object\0");
                                                    -> (IRValue*)0;
                                                }
                                                    default
                                                    {
                                                        switch (o.kind == NodeKind.IDENTIFIER)
                                                        {
                                                            case (true) {
                                                            switch (cstr_eq(o.text, g"this\0"))
                                                            {
                                                                case (true) {
                                                                switch (obj2.ty.kind == LK.PTR & obj2.ty.elem.kind == LK.PTR & obj2.ty.elem.elem.kind == LK.STRUCT)
                                                                {
                                                                    case (true) {
                                                                    obj2 = this.mod.load(obj2, g"this_ptr\0");
                                                                }
                                                                    default {};
                                                                };
                                                            }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                        switch (obj2.ty.kind == LK.PTR & obj2.ty.elem.kind == LK.PTR)
                                                        {
                                                            case (true) {
                                                            switch (this.is_struct_ptr_ty(obj2.ty.elem))
                                                            {
                                                                case (true) { obj2 = this.mod.load(obj2, g"deref_struct_ptr\0"); }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                        switch (this.is_struct_ptr_ty(obj2.ty))
                                                        {
                                                            case (true) {
                                                            ukey = this.union_key_of(obj2.ty.elem);
                                                            switch (ukey != (byte*)0)
                                                            {
                                                                case (true) { -> this.union_read(n, obj2, ukey); }
                                                                default {};
                                                            };
                                                            si = this.sinfo_of(obj2.ty.elem);
                                                            switch (si == (SInfo*)0)
                                                            {
                                                                case (true) {
                                                                this.unsup(n, g"member of union or unnamed struct\0");
                                                                -> (IRValue*)0;
                                                            }
                                                                default {};
                                                            };
                                                            idx = this.sidx(si, n.text);
                                                            switch (idx < 0)
                                                            {
                                                                case (true) {
                                                                this.unsup(n, g"member not found\0");
                                                                -> (IRValue*)0;
                                                            }
                                                                default {};
                                                            };

                                                            switch ((obj2.flags `& 16) != 0) { case (true) { idx = si.n - 1 - idx; } default {}; };
                                                            mp = this.mod.gep_field(obj2, idx, true, (byte*)0);
                                                            pe = mp.ty.elem;
                                                            switch (pe.kind == LK.ARRAY)
                                                            {
                                                                case (true) {
                                                                switch (si.specs[idx] != (TypeSpec*)0)
                                                                {
                                                                    case (true) { mp.espec = si.specs[idx].array_elem; }
                                                                    default {};
                                                                };
                                                                -> mp;
                                                            }
                                                                default {};
                                                            };
                                                            switch (this.sty(pe))
                                                            {
                                                                case (true) { -> mp; }
                                                                default {};
                                                            };
                                                            ld = this.mod.load(mp, (byte*)0);
                                                            switch (si.specs[idx] != (TypeSpec*)0)
                                                            {
                                                                case (true) {
                                                                ld.spec = si.specs[idx];
                                                                -> ld;
                                                            }
                                                                default {};
                                                            };
                                                            -> this.meta_from_type(ld);
                                                        }
                                                            default
                                                            {
                                                                this.unsup(n, g"member access on unsupported type\0");
                                                                -> (IRValue*)0;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            enum_key_of_ident(byte* name) -> byte*
            {
                byte* key = this.find_enum_key(name);
                LVar* lv;
                switch (key != (byte*)0)
                {
                    case (true) { -> key; }
                    default
                    {
                        lv = this.find_var(name);
                        switch (lv == (LVar*)0)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                switch (lv.ts == (TypeSpec*)0)
                                {
                                    case (true) { -> (byte*)0; }
                                    default
                                    {
                                        switch (lv.ts.custom_typename == (byte*)0)
                                        {
                                            case (true) { -> (byte*)0; }
                                            default
                                            {
                                                -> this.find_enum_key(lv.ts.custom_typename);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            member_ptr(Node* n) -> IRValue*
            {
                Node* o = n.a;
                IRValue* obj;
                LVar* lv;
                SInfo* si;
                int idx;
                byte* ekey;
                switch (o.kind == NodeKind.IDENTIFIER)
                {
                    case (true) {
                    ekey = this.enum_key_of_ident(o.text);
                    switch (ekey != (byte*)0)
                    {
                        case (true) { -> this.enum_member(n, ekey); }
                        default {};
                    };
                }
                    default {};
                };
                switch (o.kind)
                {
                    case (NodeKind.IDENTIFIER)
                    {
                        switch (cstr_eq(o.text, g"this\0"))
                        {
                            case (true) {
                            obj = this.visit(o);
                            switch (this.bad)
                            {
                                case (true) { -> (IRValue*)0; }
                                default
                                {
                                    switch (obj.ty.kind == LK.PTR & obj.ty.elem.kind == LK.PTR & obj.ty.elem.elem.kind == LK.STRUCT)
                                    {
                                        case (true) {
                                        obj = this.mod.load(obj, g"this_ptr\0");
                                    }
                                        default {};
                                    };
                                };
                            };
                        }
                            default {
                            lv = this.find_local(o.text);
                            switch (lv == (LVar*)0)
                            {
                                case (true) {

                                lv = this.find_global_var(o.text);
                                switch (lv == (LVar*)0)
                                {
                                    case (true) {
                                    this.unsup(n, g"member of non-local\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        switch (lv.ptr.ty.elem.kind == LK.STRUCT | lv.ptr.ty.elem.kind == LK.ISTRUCT)
                                        {
                                            case (true) {
                                            obj = lv.ptr;
                                        }
                                            default {
                                            obj = this.visit(o);
                                            switch (this.bad)
                                            {
                                                case (true) { -> (IRValue*)0; }
                                                default {};
                                            };
                                        };
                                        };
                                    };
                                };
                            }
                                default { obj = lv.ptr; };
                            };
                        };
                        };
                    }
                    default
                    {
                        obj = this.visit(o);
                        switch (this.bad)
                        {
                            case (true) { -> (IRValue*)0; }
                            default {};
                        };
                    };
                };
                switch (obj == (IRValue*)0)
                {
                    case (true) {
                    this.unsup(n, g"void member object\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (obj.ty.kind == LK.PTR & obj.ty.elem.kind == LK.PTR)
                        {
                            case (true) {
                            switch (this.is_struct_ptr_ty(obj.ty.elem))
                            {
                                case (true) { obj = this.mod.load(obj, g"struct_ptr\0"); }
                                default {};
                            };
                        }
                            default {};
                        };
                        switch (this.is_struct_ptr_ty(obj.ty))
                        {
                            case (true) {
                            si = this.sinfo_of(obj.ty.elem);
                            switch (si == (SInfo*)0)
                            {
                                case (true) {
                                this.unsup(n, g"member pointer of unnamed struct\0");
                                -> (IRValue*)0;
                            }
                                default {};
                            };
                            idx = this.sidx(si, n.text);
                            switch (idx < 0)
                            {
                                case (true) {
                                this.unsup(n, g"member not found\0");
                                -> (IRValue*)0;
                            }
                                default {};
                            };
                            -> this.mod.gep_field(obj, idx, true, (byte*)0);
                        }
                            default
                            {
                                this.unsup(n, g"member pointer of non-struct\0");
                                -> (IRValue*)0;
                            };
                        };
                    };
                };
            };


            needs_ptr_load(IRValue* a) -> bool
            {
                TypeSpec* ts = a.spec;
                int depth = 1;
                bool is_arr = false;
                switch (ts != (TypeSpec*)0)
                {
                    case (true) {
                    depth = ts.pointer_depth;
                    is_arr = (ts.flags `& 32) != 0;
                }
                    default {};
                };
                switch (is_arr | depth > 1)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch ((a.flags `& (4 `| 8)) == 0)
                        {
                            case (true) { -> false; }
                            default
                            {
                                switch (a.ty.kind != LK.PTR)
                                {
                                    case (true) { -> false; }
                                    default
                                    {
                                        switch (a.ty.elem.kind != LK.PTR)
                                        {
                                            case (true) { -> false; }
                                            default
                                            {
                                                switch (a.ty.elem.elem.kind == LK.ARRAY | a.ty.elem.elem.kind == LK.PTR)
                                                {
                                                    case (true) { -> false; }
                                                    default
                                                    {
                                                        -> true;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            is_dict_ty(IRType* t) -> bool
            {
                IRType* b = t;
                switch (b.kind == LK.PTR)
                {
                    case (true) { b = b.elem; }
                    default {};
                };
                switch (b.kind != LK.STRUCT)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (b.nitems != 3)
                        {
                            case (true) { -> false; }
                            default
                            {
                                -> b.items[0].kind == LK.ARRAY & b.items[1].kind == LK.ARRAY & b.items[2].kind == LK.INT;
                            };
                        };
                    };
                };
            };


            x_dictlit(Node* n) -> IRValue*
            {
                int cap = node_count(n, 0);
                int i;
                IRValue** kvs = (IRValue**)this.zbuf(cap + 1);
                IRValue** vvs = (IRValue**)this.zbuf(cap + 1);
                IRType* kl = this.t_i32;
                IRType* vl = this.t_i32;
                IRType* st;
                IRValue* dp;
                while (i < cap)
                {
                    kvs[i] = this.visit(node_child(n, 0, i));
                    switch (this.bad) { case (true) { -> (IRValue*)0; } default
                        {
                            switch (kvs[i] == (IRValue*)0)
                            {
                                case (true) { this.unsup(n, g"void dict key\0"); -> (IRValue*)0; }
                                default
                                {
                                    i++;
                                };
                            };
                        }; };
                };
                i = 0;
                while (i < cap)
                {
                    vvs[i] = this.visit(node_child(n, 1, i));
                    switch (this.bad) { case (true) { -> (IRValue*)0; } default
                        {
                            switch (vvs[i] == (IRValue*)0)
                            {
                                case (true) { this.unsup(n, g"void dict value\0"); -> (IRValue*)0; }
                                default
                                {
                                    i++;
                                };
                            };
                        }; };
                };
                switch (cap > 0)
                {
                    case (true) {
                    kl = kvs[0].ty;
                    vl = vvs[0].ty;
                }
                    default {};
                };
                st = this.dict_struct(kl, vl, cap);
                dp = this.mod.alloca_here(st, g"dictlit\0");
                this.mod.store(this.mod.c_undef(st), dp);
                i = 0;
                while (i < cap)
                {
                    this.mod.ia[0] = this.ci32(0);
                    this.mod.ia[1] = this.ci32(0);
                    this.mod.ia[2] = this.ci32(i);
                    this.mod.store(kvs[i], this.mod.gep(dp, this.mod.ia, 3, true, (byte*)0));
                    i++;
                };
                i = 0;
                while (i < cap)
                {
                    this.mod.ia[0] = this.ci32(0);
                    this.mod.ia[1] = this.ci32(1);
                    this.mod.ia[2] = this.ci32(i);
                    this.mod.store(vvs[i], this.mod.gep(dp, this.mod.ia, 3, true, (byte*)0));
                    i++;
                };
                this.mod.ia[0] = this.ci32(0);
                this.mod.ia[1] = this.ci32(2);
                this.mod.store(this.ci32(cap), this.mod.gep(dp, this.mod.ia, 2, true, (byte*)0));
                -> dp;
            };

            dict_name(byte* a, byte* b, int i, bool with_i) -> byte*
            {
                this.sc.clear();
                this.sc.put_str(f"{a}{b}\0");
                switch (with_i)
                {
                    case (true) { this.sc.put_int(i); }
                    default {};
                };
                -> this.sc.mem;
            };


            dict_name2(byte* pre, byte* lbl, int i) -> byte*
            {
                this.sc.clear();
                this.sc.put_str(f"{pre}{lbl}\0");
                this.sc.put(95);
                this.sc.put_int(i);
                -> this.sc.mem;
            };



            dict_scan(IRValue* dp, IRType* st, Node* index, byte* lbl, bool named) -> IRValue*
            {
                int cap = st.items[0].count;
                IRType* kl = st.items[0].elem;
                IRType* vl = st.items[1].elem;
                IRValue* lk0 = this.visit(index);
                IRValue* lk;
                IRValue* rp;
                IRValue* sk;
                IRValue* cr;
                IRValue* cmp;
                IRValue* vp;
                IRValue* res;
                IRBlock* mb;
                IRBlock** cbs;
                IRBlock** fbs;
                IRBlock* nx;
                IRFunc* sf;
                IRType** ps;
                IRType* rpt;
                bool is_str;
                int i;
                byte* nm;
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        switch (lk0 == (IRValue*)0)
                        {
                            case (true) { this.unsup(index, g"void dict key\0"); -> (IRValue*)0; }
                            default
                            {
                                cbs = (IRBlock**)this.zbuf(cap + 1);
                                fbs = (IRBlock**)this.zbuf(cap + 1);
                                mb = this.mod.append_block(this.fn, this.mod.own(this.dict_name(g"dict_merge_\0", lbl, 0, false)));
                                rpt = this.ptr_of(vl);
                                rp = this.mod.alloca_here(rpt, this.dict_name(lbl, g"_result_ptr\0", 0, false));
                                this.mod.store(this.mod.c_null(rpt), rp);
                                switch (named)
                                {
                                    case (true) {
                                    i = 0;
                                    while (i < cap)
                                    {
                                        cbs[i] = this.mod.append_block(this.fn, this.dict_name2(g"dict_check_\0", lbl, i));
                                        fbs[i] = this.mod.append_block(this.fn, this.dict_name2(g"dict_found_\0", lbl, i));
                                        i++;
                                    };
                                }
                                    default {
                                    i = 0;
                                    while (i < cap)
                                    {
                                        cbs[i] = this.mod.append_block(this.fn, this.dict_name2(g"dict_check_\0", lbl, i));
                                        i++;
                                    };
                                    i = 0;
                                    while (i < cap)
                                    {
                                        fbs[i] = this.mod.append_block(this.fn, this.dict_name2(g"dict_found_\0", lbl, i));
                                        i++;
                                    };
                                };
                                };
                                switch (cap > 0)
                                {
                                    case (true) { this.mod.br(cbs[0]); }
                                    default { this.mod.br(mb); };
                                };
                                is_str = false;
                                switch (kl.kind == LK.PTR)
                                {
                                    case (true) {
                                    switch (kl.elem.kind == LK.INT)
                                    {
                                        case (true) { is_str = kl.elem.width == 8; }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                i = 0;
                                while (i < cap)
                                {
                                    this.mod.position(this.fn, cbs[i]);
                                    this.mod.ia[0] = this.ci32(0);
                                    this.mod.ia[1] = this.ci32(0);
                                    this.mod.ia[2] = this.ci32(i);
                                    nm = (byte*)0;
                                    switch (named) { case (true) { nm = this.dict_name(g"kptr_\0", g"\0", i, true); } default {}; };
                                    sk = this.mod.load(this.mod.gep(dp, this.mod.ia, 3, true, nm), this.dict_name(g"key_\0", g"\0", i, true));
                                    lk = lk0;
                                    switch (is_str)
                                    {
                                        case (true) {
                                        switch (lk.ty.kind == LK.PTR)
                                        {
                                            case (true) {
                                            switch (lk.ty.elem.kind == LK.ARRAY)
                                            {
                                                case (true) {
                                                this.mod.ia[0] = this.ci32(0);
                                                this.mod.ia[1] = this.ci32(0);
                                                lk = this.mod.gep(lk, this.mod.ia, 2, true, this.dict_name(g"lk_decay_\0", g"\0", i, true));
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        sf = this.mod.find_function(g"strcmp\0");
                                        switch (sf == (IRFunc*)0)
                                        {
                                            case (true) {
                                            ps = (IRType**)fmalloc((u64)3 * (u64)((sizeof(IRType*) + 7) / 8));
                                            this.keep((void*)ps);
                                            ps[0] = this.t_i8p;
                                            ps[1] = this.t_i8p;
                                            sf = this.mod.add_function(this.mod.t_func(this.t_i32, ps, 2, false), g"strcmp\0");
                                        }
                                            default {};
                                        };
                                        this.mod.ia[0] = sk;
                                        this.mod.ia[1] = lk;
                                        cr = this.mod.call(sf.self, this.mod.ia, 2, this.dict_name(g"strcmp_\0", g"\0", i, true));
                                        cmp = this.mod.icmp(g"eq\0", cr, this.ci32(0), this.dict_name(g"keycmp_\0", g"\0", i, true));
                                    }
                                        default {
                                        switch (kl.kind == LK.PTR)
                                        {
                                            case (true) {
                                            cmp = this.mod.icmp(g"eq\0", sk, lk, this.dict_name(g"keycmp_\0", g"\0", i, true));
                                        }
                                            default {
                                            switch (!named & lk.ty.kind == LK.INT & sk.ty.kind == LK.INT)
                                            {
                                                case (true) {
                                                switch (lk.ty.width > sk.ty.width)
                                                {
                                                    case (true) {
                                                    lk = this.mod.cast(g"trunc\0", lk, sk.ty, this.dict_name(g"key_trunc_\0", g"\0", i, true));
                                                }
                                                    default {
                                                    switch (lk.ty.width < sk.ty.width)
                                                    {
                                                        case (true) {
                                                        lk = this.mod.cast(g"zext\0", lk, sk.ty, this.dict_name(g"key_ext_\0", g"\0", i, true));
                                                    }
                                                        default {};
                                                    };
                                                };
                                                };
                                            }
                                                default {};
                                            };
                                            cmp = this.mod.icmp(g"eq\0", sk, lk, this.dict_name(g"keycmp_\0", g"\0", i, true));
                                        };
                                        };
                                    };
                                    };
                                    nx = mb;
                                    switch (i + 1 < cap) { case (true) { nx = cbs[i + 1]; } default {}; };
                                    this.mod.cbr(cmp, fbs[i], nx);
                                    this.mod.position(this.fn, fbs[i]);
                                    this.mod.ia[0] = this.ci32(0);
                                    this.mod.ia[1] = this.ci32(1);
                                    this.mod.ia[2] = this.ci32(i);
                                    nm = (byte*)0;
                                    switch (named) { case (true) { nm = this.dict_name(g"vptr_\0", g"\0", i, true); } default {}; };
                                    vp = this.mod.gep(dp, this.mod.ia, 3, true, nm);
                                    this.mod.store(vp, rp);
                                    this.mod.br(mb);
                                    i++;
                                };
                                this.mod.position(this.fn, mb);
                                res = this.mod.load(rp, this.dict_name(lbl, g"_valptr\0", 0, false));
                                switch (vl.kind == LK.STRUCT | vl.kind == LK.ISTRUCT | vl.kind == LK.ARRAY)
                                {
                                    case (true) { -> res; }
                                    default
                                    {
                                        -> this.mod.load(res, this.dict_name(lbl, g"_val\0", 0, false));
                                    };
                                };
                            };
                        };
                    };
                };
            };


            dict_access_named(Node* n) -> IRValue*
            {
                byte* name = n.a.text;
                DictInfo* di = (DictInfo*)nm_get(this.dicts, name);
                LVar* lv = this.find_var(name);
                IRValue* dp;
                IRType* st;
                switch (lv == (LVar*)0)
                {
                    case (true) {
                    this.unsup(n, g"dict variable not found\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        dp = lv.ptr;

                        switch (dp.ty.kind == LK.PTR)
                        {
                            case (true) {
                            switch (dp.ty.elem.kind == LK.PTR)
                            {
                                case (true) {
                                switch (this.is_dict_struct(dp.ty.elem.elem))
                                {
                                    case (true) {
                                    dp = this.mod.load(dp, this.dict_name(name, g"_deref\0", 0, false));
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                        st = di.st;
                        switch (dp.ty.kind == LK.PTR)
                        {
                            case (true) {
                            switch (this.is_dict_struct(dp.ty.elem)) { case (true) { st = dp.ty.elem; } default {}; };
                        }
                            default {};
                        };
                        -> this.dict_scan(dp, st, n.b, name, true);
                    };
                };
            };


            dict_merge_ir(IRValue* lp, IRValue* rp, DictInfo* li, DictInfo* ri) -> IRValue*
            {
                int nc = li.cap + ri.cap;
                IRType* st = this.dict_struct(li.kl, li.vl, nc);
                IRValue* al = this.mod.alloca_here(st, g"dict_merged\0");
                IRValue* sk;
                IRValue* sv;
                IRValue* dk;
                IRValue* dv;
                IRValue* src;
                int pass;
                int i;
                int cap;
                int off;
                this.mod.store(this.mod.c_null(st), al);
                pass = 0;
                while (pass < 2)
                {
                    src = lp;
                    cap = li.cap;
                    off = 0;
                    switch (pass == 1)
                    {
                        case (true) { src = rp; cap = ri.cap; off = li.cap; }
                        default {};
                    };
                    i = 0;
                    while (i < cap)
                    {
                        this.mod.ia[0] = this.ci32(0);
                        this.mod.ia[1] = this.ci32(0);
                        this.mod.ia[2] = this.ci32(i);
                        sk = this.mod.gep(src, this.mod.ia, 3, true, (byte*)0);
                        this.mod.ia[0] = this.ci32(0);
                        this.mod.ia[1] = this.ci32(1);
                        this.mod.ia[2] = this.ci32(i);
                        sv = this.mod.gep(src, this.mod.ia, 3, true, (byte*)0);
                        this.mod.ia[0] = this.ci32(0);
                        this.mod.ia[1] = this.ci32(0);
                        this.mod.ia[2] = this.ci32(off + i);
                        dk = this.mod.gep(al, this.mod.ia, 3, true, (byte*)0);
                        this.mod.ia[0] = this.ci32(0);
                        this.mod.ia[1] = this.ci32(1);
                        this.mod.ia[2] = this.ci32(off + i);
                        dv = this.mod.gep(al, this.mod.ia, 3, true, (byte*)0);
                        this.mod.store(this.mod.load(sk, this.dict_name(g"mk\0", g"\0", i, true)), dk);
                        this.mod.store(this.mod.load(sv, this.dict_name(g"mv\0", g"\0", i, true)), dv);
                        i++;
                    };
                    pass++;
                };
                this.mod.ia[0] = this.ci32(0);
                this.mod.ia[1] = this.ci32(2);
                this.mod.store(this.ci32(nc), this.mod.gep(al, this.mod.ia, 2, true, (byte*)0));
                -> al;
            };


            dict_binary(Node* n, IRValue* lhs, IRValue* rhs, bool* handled) -> IRValue*
            {
                DictInfo* li = (DictInfo*)0;
                DictInfo* ri = (DictInfo*)0;
                *handled = false;
                switch (n.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true) { li = (DictInfo*)nm_get(this.dicts, n.a.text); }
                    default {};
                };
                switch (n.b.kind == NodeKind.IDENTIFIER)
                {
                    case (true) { ri = (DictInfo*)nm_get(this.dicts, n.b.text); }
                    default {};
                };
                switch (li == (DictInfo*)0 & ri == (DictInfo*)0)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        *handled = true;
                        switch (li == (DictInfo*)0 | ri == (DictInfo*)0)
                        {
                            case (true) {
                            this.fail(g"Dict operator '+' requires both operands to be dicts\0", n.line);
                            this.unsup(n, g"dict operator operand\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (n.op != Operator.ADD)
                                {
                                    case (true) {
                                    this.fail(g"Unsupported operator for dict types\0", n.line);
                                    this.unsup(n, g"dict operator\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        switch (li.kl != ri.kl | li.vl != ri.vl)
                                        {
                                            case (true) {
                                            this.fail(g"Dict type mismatch: cannot combine dicts of different key or value types\0", n.line);
                                            this.unsup(n, g"dict type mismatch\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                -> this.dict_merge_ir(lhs, rhs, li, ri);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            vardecl_dict(Node* n, TypeSpec* ts) -> IRValue*
            {
                DictInfo* di = this.dict_make(n.text, ts, n.line);
                Node* ini = n.a;
                IRValue* al;
                IRValue* src;
                IRValue* kv;
                IRValue* vv;
                IRType* st = di.st;
                int np;
                int i;
                switch (ini != (Node*)0)
                {
                    case (true) {
                    switch (ini.kind == NodeKind.DICT_LITERAL & node_count(ini, 0) > 0)
                    {
                        case (true) {
                        np = node_count(ini, 0) / 2;
                        al = this.mod.alloca_here(st, n.text);
                        this.mod.store(this.mod.c_null(st), al);
                        while (i < np)
                        {
                            kv = this.visit(node_child(ini, 0, i * 2));
                            switch (this.bad) { case (true) { -> (IRValue*)0; } default
                                {
                                    vv = this.visit(node_child(ini, 0, i * 2 + 1));
                                    switch (this.bad) { case (true) { -> (IRValue*)0; } default
                                        {
                                            switch (kv == (IRValue*)0 | vv == (IRValue*)0)
                                            {
                                                case (true) { this.unsup(n, g"void dict entry\0"); -> (IRValue*)0; }
                                                default
                                                {
                                                    this.mod.ia[0] = this.ci32(0);
                                                    this.mod.ia[1] = this.ci32(0);
                                                    this.mod.ia[2] = this.ci32(i);
                                                    this.mod.store(kv, this.mod.gep(al, this.mod.ia, 3, true, this.dict_name(n.text, g"_k\0", i, true)));
                                                    this.mod.ia[0] = this.ci32(0);
                                                    this.mod.ia[1] = this.ci32(1);
                                                    this.mod.ia[2] = this.ci32(i);
                                                    this.mod.store(vv, this.mod.gep(al, this.mod.ia, 3, true, this.dict_name(n.text, g"_v\0", i, true)));
                                                    i++;
                                                };
                                            };
                                        }; };
                                }; };
                        };
                        this.mod.ia[0] = this.ci32(0);
                        this.mod.ia[1] = this.ci32(2);
                        this.mod.store(this.ci32(np), this.mod.gep(al, this.mod.ia, 2, true, this.dict_name(n.text, g"_count\0", 0, false)));
                    }
                        default {
                        src = this.visit(ini);
                        switch (this.bad) { case (true) { -> (IRValue*)0; } default
                            {
                                switch (src == (IRValue*)0)
                                {
                                    case (true) { this.unsup(n, g"void dict initializer\0"); -> (IRValue*)0; }
                                    default
                                    {
                                        switch (src.ty.kind == LK.PTR)
                                        {
                                            case (true) {
                                            switch (this.is_dict_struct(src.ty.elem))
                                            {
                                                case (true) {
                                                st = src.ty.elem;
                                                di.cap = st.items[0].count;
                                                di.st = st;
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        al = this.mod.alloca_here(st, n.text);
                                        this.mod.store(this.mod.load(src, g"dict_init_load\0"), al);
                                    };
                                };
                            }; };
                    };
                    };
                }
                    default {
                    al = this.mod.alloca_here(st, n.text);
                    this.mod.store(this.mod.c_null(st), al);
                };
                };
                al.spec = ts;
                this.define_var(n.text, al, ts);
                -> al;
            };


            x_index(Node* n) -> IRValue*
            {
                IRValue* arr;
                IRValue* idx;
                IRValue* gp;
                IRValue* ld;
                IRValue* t1;
                IRValue* t2;
                IRValue* t3;
                switch (n.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true) {
                    switch (nm_get(this.dicts, n.a.text) != (void*)0)
                    {
                        case (true) { -> this.dict_access_named(n); }
                        default {};
                    };
                }
                    default {};
                };
                switch (n.b.kind == NodeKind.RANGE_EXPRESSION)
                {
                    case (true) {
                    this.unsup(n, g"range index\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        arr = this.visit(n.a);
                        switch (this.bad)
                        {
                            case (true) { -> (IRValue*)0; }
                            default
                            {
                                switch (arr == (IRValue*)0)
                                {
                                    case (true) {
                                    this.unsup(n, g"void indexed value\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        switch (this.is_dict_ty(arr.ty))
                                        {
                                            case (true) {
                                            switch (arr.ty.kind == LK.PTR)
                                            {
                                                case (true) {
                                                this.sc.clear();
                                                this.sc.put_str(g"dictexpr_\0");
                                                t1 = (IRValue*)0;
                                                put_u64(@this.sc, (u64)arr);
                                                -> this.dict_scan(arr, arr.ty.elem, n.b, this.mod.own(this.sc.mem), false);
                                            }
                                                default {};
                                            };
                                            this.unsup(n, g"dict access by value\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                switch (this.needs_ptr_load(arr))
                                                {
                                                    case (true) {
                 IRValue* pl = arr;
                 arr = this.mod.load(arr, g"ptr_loaded_for_access\0");
                 switch (arr.spec == (TypeSpec*)0) { case (true) { arr.spec = pl.spec; } default {}; };
                 switch (arr.espec == (TypeSpec*)0) { case (true) { arr.espec = pl.espec; } default {}; };
             }
                                                    default {};
                                                };
                                                idx = this.visit(n.b);
                                                switch (this.bad)
                                                {
                                                    case (true) { -> (IRValue*)0; }
                                                    default
                                                    {
                                                        switch (idx == (IRValue*)0)
                                                        {
                                                            case (true) {
                                                            this.unsup(n, g"void index\0");
                                                            -> (IRValue*)0;
                                                        }
                                                            default
                                                            {
                                                                idx = this.idx_i32(idx);
                                                                switch ((arr.flags `& 8) != 0 | (arr.ty.kind == LK.PTR & arr.ty.elem.kind == LK.ARRAY))
                                                                {
                                                                    case (true) {
                                                                    this.mod.ia[0] = this.ci32(0);
                                                                    this.mod.ia[1] = idx;
                                                                    gp = this.mod.gep(arr, this.mod.ia, 2, true, g"array_gep\0");
                                                                    switch (gp.ty.elem.kind == LK.ARRAY | this.sty(gp.ty.elem))
                                                                    {
                                                                        case (true) { -> gp; }
                                                                        default {};
                                                                    };
                                                                    ld = this.mod.load(gp, g"array_load\0");
                                                                    -> this.elem_meta(ld, arr);
                                                                }
                                                                    default
                                                                    {
                                                                        switch (arr.ty.kind == LK.PTR)
                                                                        {
                                                                            case (true) {
                                                                            gp = this.mod.gep_ptr(arr, idx, true, g"ptr_gep\0");
                                                                            switch (this.sty(gp.ty.elem))
                                                                            {
                                                                                case (true) { -> gp; }
                                                                                default {};
                                                                            };
                                                                            ld = this.mod.load(gp, g"ptr_load\0");
                                                                            -> this.elem_meta(ld, arr);
                                                                        }
                                                                            default
                                                                            {
                                                                                switch (arr.ty.kind == LK.INT)
                                                                                {
                                                                                    case (true) {
                                                                                    switch (idx.ty.width != 64)
                                                                                    {
                                                                                        case (true) { t1 = this.mod.cast(g"sext\0", idx, this.t_i64, g"idx_i64\0"); }
                                                                                        default { t1 = idx; };
                                                                                    };
                                                                                    t2 = this.mod.binop(g"mul\0", t1, this.mod.c_int(this.t_i64, (i64)8), g"byte_shift\0");
                                                                                    switch (arr.ty.width != 64)
                                                                                    {
                                                                                        case (true) { t3 = this.mod.cast(g"zext\0", arr, this.t_i64, g"val_i64\0"); }
                                                                                        default { t3 = arr; };
                                                                                    };
                                                                                    t3 = this.mod.binop(g"lshr\0", t3, t2, g"byte_shr\0");
                                                                                    -> this.mod.cast(g"trunc\0", t3, this.t_i8, g"byte_extract\0");
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        this.unsup(n, g"element access type\0");
                                                                                        -> (IRValue*)0;
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            index_ptr(Node* n) -> IRValue*
            {
                IRValue* arr = this.visit(n.a);
                IRValue* idx;
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        switch (arr == (IRValue*)0)
                        {
                            case (true) {
                            this.unsup(n, g"void indexed value\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (this.needs_ptr_load(arr))
                                {
                                    case (true) { arr = this.mod.load(arr, g"ptr_loaded_for_inc\0"); }
                                    default {};
                                };
                                idx = this.visit(n.b);
                                switch (this.bad)
                                {
                                    case (true) { -> (IRValue*)0; }
                                    default
                                    {
                                        switch (idx == (IRValue*)0)
                                        {
                                            case (true) {
                                            this.unsup(n, g"void index\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                idx = this.idx_i32(idx);
                                                switch ((arr.flags `& 8) != 0 | (arr.ty.kind == LK.PTR & arr.ty.elem.kind == LK.ARRAY))
                                                {
                                                    case (true) {
                                                    this.mod.ia[0] = this.ci32(0);
                                                    this.mod.ia[1] = idx;
                                                    -> this.mod.gep(arr, this.mod.ia, 2, true, g"inc_gep\0");
                                                }
                                                    default
                                                    {
                                                        switch (arr.ty.kind == LK.PTR)
                                                        {
                                                            case (true) { -> this.mod.gep_ptr(arr, idx, true, g"inc_gep\0"); }
                                                            default
                                                            {
                                                                this.unsup(n, g"element pointer type\0");
                                                                -> (IRValue*)0;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            first_char(Node* s) -> IRValue*
            {
                int c = 0;
                switch (s.text != (byte*)0)
                {
                    case (true) {
                    switch (s.ival > (i64)0 | s.text[0] != (byte)0)
                    {
                        case (true) { c = (int)s.text[0]; }
                        default {};
                    };
                }
                    default {};
                };
                -> this.mod.c_int(this.t_i8, (i64)c);
            };


            assign_member(Node* t, IRValue* val0, Node* vexpr) -> IRValue*
            {
                Node* o = t.a;
                IRValue* obj;
                IRValue* mp;
                IRValue* val = val0;
                IRType* mt;
                LVar* lv;
                byte* ukey;
                SInfo* si;
                int idx;
                bool glob = false;
                switch (o.kind == NodeKind.IDENTIFIER)
                {
                    case (true) {
                    switch (this.find_local(o.text) == (LVar*)0)
                    {
                        case (true) {
                        glob = this.find_global_var(o.text) != (LVar*)0;
                    }
                        default {};
                    };
                }
                    default {};
                };
                switch (glob)
                {
                    case (true) {
                    lv = this.find_global_var(o.text);
                    switch (lv.ptr.ty.elem.kind == LK.STRUCT | lv.ptr.ty.elem.kind == LK.ISTRUCT)
                    {
                        case (true) {

                        obj = lv.ptr;
                    }
                        default {

                        obj = this.visit(o);
                        switch (this.bad)
                        {
                            case (true) { -> (IRValue*)0; }
                            default {};
                        };
                    };
                    };
                }
                    default {
                        switch (o.kind == NodeKind.IDENTIFIER)
                        {
                            case (true) {
                    lv = this.find_var(o.text);
                    switch (lv == (LVar*)0)
                    {
                        case (true) {
                        this.unsup(t, g"member assignment to non-local\0");
                        -> (IRValue*)0;
                    }
                        default
                        {
                            obj = lv.ptr;
                            switch (obj.ty.kind == LK.PTR & obj.ty.elem.kind == LK.PTR)
                            {
                                case (true) {
                                switch (this.is_struct_ptr_ty(obj.ty.elem))
                                {
                                    case (true) {
                                    this.sc.clear();
                                    this.sc.put_str(f"{o.text}_ptr\0");
                                    obj = this.mod.load(obj, this.sc.mem);
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        };
                    };
                }
                            default {
                                switch (o.kind == NodeKind.MEMBER_ACCESS)
                                {
                                    case (true) {
                    obj = this.member_ptr(o);
                    switch (this.bad)
                    {
                        case (true) { -> (IRValue*)0; }
                        default {};
                    };
                }
                                    default {
                    obj = this.visit(o);
                    switch (this.bad)
                    {
                        case (true) { -> (IRValue*)0; }
                        default {};
                    };
                };
                                };
                            };
                        };
                    };
                };
                switch (obj == (IRValue*)0)
                {
                    case (true) {
                    this.unsup(t, g"void member assignment object\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (obj.ty.kind == LK.PTR & obj.ty.elem.kind == LK.PTR)
                        {
                            case (true) {
                            switch (this.is_struct_ptr_ty(obj.ty.elem))
                            {
                                case (true) { obj = this.mod.load(obj, g"struct_ptr\0"); }
                                default {};
                            };
                        }
                            default {};
                        };
                        switch (!this.is_struct_ptr_ty(obj.ty))
                        {
                            case (true) {
                            this.unsup(t, g"member assignment to non-struct\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                ukey = this.union_key_of(obj.ty.elem);
                                switch (ukey != (byte*)0)
                                {
                                    case (true) { -> this.union_store(t, obj, ukey, val); }
                                    default
                                    {
                                        si = this.sinfo_of(obj.ty.elem);
                                        switch (si == (SInfo*)0)
                                        {
                                            case (true) {
                                            this.unsup(t, g"member assignment to union or unnamed struct\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                idx = this.sidx(si, t.text);
                                                switch (idx < 0)
                                                {
                                                    case (true) {
                                                    this.unsup(t, g"member not found\0");
                                                    -> (IRValue*)0;
                                                }
                                                    default
                                                    {
                                                        mp = this.mod.gep_field(obj, idx, true, (byte*)0);
                                                        mt = mp.ty.elem;
                                                        switch (vexpr.kind == NodeKind.ARRAY_LITERAL & mt.kind == LK.ARRAY)
                                                        {
                                                            case (true) {
                                                            this.init_local_array(mp, mt, vexpr);
                                                            -> mp;
                                                        }
                                                            default
                                                            {
                                                                switch (val.ty.kind == LK.PTR & val.ty.elem.kind == LK.ARRAY & mt.kind == LK.ARRAY)
                                                                {
                                                                    case (true) {
                                                                    switch (lt_eq(val.ty.elem.elem, mt.elem) & val.ty.elem.count <= mt.count)
                                                                    {
                                                                        case (true) {
                                                                        this.array_widen(mp, val, mt);
                                                                        -> val;
                                                                    }
                                                                        default {};
                                                                    };
                                                                }
                                                                    default {};
                                                                };
                                                                switch (val.ty.kind == LK.PTR & mt.kind != LK.PTR)
                                                                {
                                                                    case (true) {
                                                                    switch (lt_eq(val.ty.elem, mt))
                                                                    {
                                                                        case (true) { val = this.mod.load(val, g"obj_val_deref\0"); }
                                                                        default {};
                                                                    };
                                                                }
                                                                    default {};
                                                                };
                                                                val = this.convert_assign(val, mt);
                                                                switch (this.bad)
                                                                {
                                                                    case (true) { -> (IRValue*)0; }
                                                                    default
                                                                    {
                                                                        this.mod.store(val, mp);
                                                                        -> val;
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            assign_index(Node* t, IRValue* val0, Node* vexpr) -> IRValue*
            {
                Node* an = t.a;
                Node* ix = t.b;
                IRValue* val = val0;
                IRValue* arr;
                IRValue* idx;
                IRValue* ep;
                IRValue* mp;
                IRType* et;
                switch (an.kind == NodeKind.MEMBER_ACCESS)
                {
                    case (true) {
                    mp = this.member_ptr(an);
                    switch (this.bad)
                    {
                        case (true) { -> (IRValue*)0; }
                        default
                        {
                            switch (mp.ty.kind == LK.PTR & mp.ty.elem.kind == LK.ARRAY)
                            {
                                case (true) {
                                switch (ix.kind == NodeKind.RANGE_EXPRESSION)
                                {
                                    case (true) {
                                    this.unsup(t, g"member slice assignment\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        idx = this.visit(ix);
                                        switch (this.bad)
                                        {
                                            case (true) { -> (IRValue*)0; }
                                            default
                                            {
                                                idx = this.idx_i32(idx);
                                                this.mod.ia[0] = this.ci32(0);
                                                this.mod.ia[1] = idx;
                                                ep = this.mod.gep(mp, this.mod.ia, 2, true, (byte*)0);
                                                et = mp.ty.elem.elem;
                                                switch (!lt_eq(val.ty, et))
                                                {
                                                    case (true) {
                                                    switch (val.ty.kind == LK.INT & et.kind == LK.INT)
                                                    {
                                                        case (true) {
                                                        switch (val.ty.width > et.width)
                                                        {
                                                            case (true) { val = this.mod.cast(g"trunc\0", val, et, g"val_trunc\0"); }
                                                            default { val = this.mod.cast(g"sext\0", val, et, g"val_ext\0"); };
                                                        };
                                                    }
                                                        default {
                                                            switch (val.ty.kind == LK.PTR & lt_eq(val.ty.elem, et))
                                                            {
                                                                case (true) {
                                                        val = this.mod.load(val, g"struct_elem_load\0");
                                                    }
                                                                default {
                                                                    switch (val.ty.kind == LK.PTR & val.ty.elem.kind == LK.ARRAY & et.kind == LK.PTR)
                                                                    {
                                                                        case (true) {
                                                        switch (lt_eq(val.ty.elem.elem, et.elem))
                                                        {
                                                            case (true) {
                                                            this.mod.ia[0] = this.ci32(0);
                                                            this.mod.ia[1] = this.ci32(0);
                                                            val = this.mod.gep(val, this.mod.ia, 2, true, g"arr_decay\0");
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                                        default {};
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                }
                                                    default {};
                                                };
                                                this.mod.store(val, ep);
                                                -> val;
                                            };
                                        };
                                    };
                                };
                            }
                                default {};
                            };
                        };
                    };
                }
                    default {};
                };
                arr = this.visit(an);
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        switch (arr == (IRValue*)0)
                        {
                            case (true) {
                            this.unsup(t, g"void indexed target\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (ix.kind == NodeKind.RANGE_EXPRESSION)
                                {
                                    case (true) {
                                    this.unsup(t, g"slice assignment\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        idx = this.visit(ix);
                                        switch (this.bad)
                                        {
                                            case (true) { -> (IRValue*)0; }
                                            default
                                            {
                                                switch (idx == (IRValue*)0)
                                                {
                                                    case (true) {
                                                    this.unsup(t, g"void index\0");
                                                    -> (IRValue*)0;
                                                }
                                                    default
                                                    {
                                                        switch (arr.ty.kind == LK.PTR & arr.ty.elem.kind == LK.ARRAY)
                                                        {
                                                            case (true) {
                                                            this.mod.ia[0] = this.ci32(0);
                                                            this.mod.ia[1] = idx;
                                                            ep = this.mod.gep(arr, this.mod.ia, 2, true, (byte*)0);
                                                            et = arr.ty.elem.elem;
                                                            switch (vexpr.kind == NodeKind.STRING_LITERAL & et.kind == LK.INT & et.width == 8)
                                                            {
                                                                case (true) {
                                                                val = this.first_char(vexpr);
                                                            }
                                                                default {
                                                                    switch (val.ty.kind == LK.PTR & val.ty.elem.kind == LK.ARRAY & et.kind == LK.PTR)
                                                                    {
                                                                        case (true) {
                                                                switch (et.elem.kind == LK.INT & et.elem.width == 8)
                                                                {
                                                                    case (true) {
                                                                    this.mod.ia[0] = this.ci32(0);
                                                                    this.mod.ia[1] = this.ci32(0);
                                                                    val = this.mod.gep(val, this.mod.ia, 2, true, g"str_to_ptr\0");
                                                                }
                                                                    default {};
                                                                };
                                                            }
                                                                        default {};
                                                                    };
                                                                };
                                                            };
                                                            switch (val.ty.kind == LK.PTR & et.kind != LK.PTR)
                                                            {
                                                                case (true) {
                                                                switch (this.sty(val.ty.elem) & lt_eq(val.ty.elem, et))
                                                                {
                                                                    case (true) { val = this.mod.load(val, g"struct_elem_load\0"); }
                                                                    default { ep = this.mod.cast(g"bitcast\0", ep, this.ptr_of(val.ty), g"void_arr_elem_ptr\0"); };
                                                                };
                                                            }
                                                                default {
                                                                    switch (val.ty.kind == LK.PTR & et.kind == LK.PTR)
                                                                    {
                                                                        case (true) {
                                                                switch (!lt_eq(val.ty, et))
                                                                {
                                                                    case (true) { val = this.mod.cast(g"bitcast\0", val, et, g"ptr_cast\0"); }
                                                                    default {};
                                                                };
                                                            }
                                                                        default {};
                                                                    };
                                                                };
                                                            };
                                                            val = this.convert_assign(val, et);
                                                            switch (this.bad)
                                                            {
                                                                case (true) { -> (IRValue*)0; }
                                                                default {};
                                                            };
                                                            this.mod.store(val, ep);
                                                            -> val;
                                                        }
                                                            default
                                                            {
                                                                switch (arr.ty.kind == LK.PTR)
                                                                {
                                                                    case (true) {
                                                                    ep = this.mod.gep_ptr(arr, idx, true, (byte*)0);
                                                                    et = arr.ty.elem;
                                                                    switch (val.ty.kind == LK.PTR & val.ty.elem.kind == LK.ARRAY & et.kind == LK.PTR & et.elem.kind == LK.INT & et.elem.width == 8)
                                                                    {
                                                                        case (true) {
                                                                        this.mod.ia[0] = this.ci32(0);
                                                                        this.mod.ia[1] = this.ci32(0);
                                                                        val = this.mod.gep(val, this.mod.ia, 2, true, g"str_to_ptr\0");
                                                                    }
                                                                        default {
                                                                            switch (vexpr.kind == NodeKind.STRING_LITERAL & et.kind == LK.INT & et.width == 8)
                                                                            {
                                                                                case (true) {
                                                                        val = this.first_char(vexpr);
                                                                    }
                                                                                default {};
                                                                            };
                                                                        };
                                                                    };
                                                                    switch (val.ty.kind == LK.PTR & et.kind == LK.PTR)
                                                                    {
                                                                        case (true) {
                                                                        switch (!lt_eq(val.ty, et))
                                                                        {
                                                                            case (true) { val = this.mod.cast(g"bitcast\0", val, et, g"ptr_cast\0"); }
                                                                            default {};
                                                                        };
                                                                    }
                                                                        default {};
                                                                    };
                                                                    switch (val.ty.kind == LK.PTR & et.kind != LK.PTR)
                                                                    {
                                                                        case (true) {
                                                                        switch (!lt_eq(val.ty.elem, et))
                                                                        {
                                                                            case (true) {
                                                                            ep = this.mod.cast(g"bitcast\0", ep, this.ptr_of(val.ty), g"void_arr_elem_ptr\0");
                                                                        }
                                                                            default {};
                                                                        };
                                                                    }
                                                                        default {};
                                                                    };
                                                                    val = this.convert_assign(val, et);
                                                                    switch (this.bad)
                                                                    {
                                                                        case (true) { -> (IRValue*)0; }
                                                                        default {};
                                                                    };
                                                                    this.mod.store(val, ep);
                                                                    -> val;
                                                                }
                                                                    default
                                                                    {
                                                                        this.unsup(t, g"index assignment on non-pointer\0");
                                                                        -> (IRValue*)0;
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            assign_deref(Node* t, IRValue* val0) -> IRValue*
            {
                IRValue* p = this.visit(t.a);
                IRValue* val = val0;
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        switch (p == (IRValue*)0)
                        {
                            case (true) {
                            this.unsup(t, g"void dereference target\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (p.ty.kind == LK.PTR & p.ty.elem.kind == LK.PTR & p.ty.elem.elem.kind == LK.PTR)
                                {
                                    case (true) {
                                    p = this.mod.load(p, g"deref_ptr_loaded\0");
                                }
                                    default {};
                                };
                                switch (p.ty.kind != LK.PTR)
                                {
                                    case (true) {
                                    this.unsup(t, g"dereference assignment to non-pointer\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        val = this.convert_assign(val, p.ty.elem);
                                        switch (this.bad)
                                        {
                                            case (true) { -> (IRValue*)0; }
                                            default
                                            {
                                                switch (!lt_eq(val.ty, p.ty.elem))
                                                {
                                                    case (true) { p = this.mod.cast(g"bitcast\0", p, this.ptr_of(val.ty), (byte*)0); }
                                                    default {};
                                                };
                                                this.mod.store(val, p);
                                                -> val;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            visit(Node* n) -> IRValue*
            {
                int k;
                IRValue* r;
                switch (n == (Node*)0)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        switch (this.bad)
                        {
                            case (true) { -> (IRValue*)0; }
                            default
                            {
                                k = n.kind;
                                switch (k == NodeKind.COMPTIME_BLOCK | k == NodeKind.EMIT_IDEKA | k == NodeKind.IDEKAVM_BLOCK)
                                {
                                    case (true) { -> this.ct_visit(n); }
                                    default {};
                                };
                                switch (k == NodeKind.LITERAL)
                                {
                                    case (true) { -> this.x_literal(n); }
                                    default
                                    {
                                        switch (k == NodeKind.IDENTIFIER)
                                        {
                                            case (true) { -> this.x_ident(n); }
                                            default
                                            {
                                                switch (k == NodeKind.BINARY_OP)
                                                {
                                                    case (true) { -> this.x_binary(n); }
                                                    default
                                                    {
                                                        switch (k == NodeKind.FUNCTION_CALL)
                                                        {
                                                            case (true) { -> this.x_call(n); }
                                                            default
                                                            {
                                                                switch (k == NodeKind.ASSIGNMENT)
                                                                {
                                                                    case (true) { -> this.x_assign(n); }
                                                                    default
                                                                    {
                                                                        switch (k == NodeKind.COMPOUND_ASSIGNMENT)
                                                                        {
                                                                            case (true) { -> this.x_compound(n); }
                                                                            default
                                                                            {
                                                                                switch (k == NodeKind.NOT_NULL)
                                                                                {
                                                                                    case (true) { -> this.x_notnull(n); }
                                                                                    default
                                                                                    {
                                                                                        switch (k == NodeKind.IN_EXPRESSION)
                                                                                        {
                                                                                            case (true) { -> this.x_in(n); }
                                                                                            default
                                                                                            {
                                                                                                switch (k == NodeKind.TERNARY_OP)
                                                                                                {
                                                                                                    case (true) { -> this.x_ternary(n); }
                                                                                                    default
                                                                                                    {
                                                                                                        switch (k == NodeKind.TERNARY_ASSIGN)
                                                                                                        {
                                                                                                            case (true) { -> this.x_ternassign(n); }
                                                                                                            default
                                                                                                            {
                                                                                                                switch (k == NodeKind.TIE_EXPRESSION)
                                                                                                                {
                                                                                                                    case (true) { -> this.x_tie(n); }
                                                                                                                    default
                                                                                                                    {
                                                                                                                        switch (k == NodeKind.STRINGIFY)
                                                                                                                        {
                                                                                                                            case (true) { -> this.x_stringify(n); }
                                                                                                                            default
                                                                                                                            {
                                                                                                                                switch (k == NodeKind.STRUCT_RECAST)
                                                                                                                                {
                                                                                                                                    case (true) { -> this.x_recast(n); }
                                                                                                                                    default
                                                                                                                                    {
                                                                                                                                        switch (k == NodeKind.VARIADIC_ACCESS)
                                                                                                                                        {
                                                                                                                                            case (true) { -> this.x_vaaccess(n); }
                                                                                                                                            default
                                                                                                                                            {
                                                                                                                                                switch (k == NodeKind.NULL_COALESCE)
                                                                                                                                                {
                                                                                                                                                    case (true) { -> this.x_coalesce(n); }
                                                                                                                                                    default
                                                                                                                                                    {
                                                                                                                                                        switch (k == NodeKind.IF_EXPRESSION)
                                                                                                                                                        {
                                                                                                                                                            case (true) { -> this.x_ifexpr(n); }
                                                                                                                                                            default
                                                                                                                                                            {
                                                                                                                                                                switch (k == NodeKind.ARRAY_LITERAL & (n.flags `& 8) == 0)
                                                                                                                                                                {
                                                                                                                                                                    case (true) { -> this.x_array_literal(n); }
                                                                                                                                                                    default
                                                                                                                                                                    {
                                                                                                                                                                        switch (k == NodeKind.STRUCT_LITERAL)
                                                                                                                                                                        {
                                                                                                                                                                            case (true) { -> this.x_struct_lit(n, (IRType*)0); }
                                                                                                                                                                            default
                                                                                                                                                                            {
                                                                                                                                                                                switch (k == NodeKind.INLINE_ASM)
                                                                                                                                                                                {
                                                                                                                                                                                    case (true) { -> this.x_asm(n); }
                                                                                                                                                                                    default
                                                                                                                                                                                    {
                                                                                                                                                                                        switch (k == NodeKind.METHOD_CALL)
                                                                                                                                                                                        {
                                                                                                                                                                                            case (true) { -> this.x_method(n); }
                                                                                                                                                                                            default
                                                                                                                                                                                            {
                                                                                                                                                                                                switch (k == NodeKind.UNARY_OP)
                                                                                                                                                                                                {
                                                                                                                                                                                                    case (true) { -> this.x_unary(n); }
                                                                                                                                                                                                    default
                                                                                                                                                                                                    {
                                                                                                                                                                                                        switch (k == NodeKind.POINTER_DEREF)
                                                                                                                                                                                                        {
                                                                                                                                                                                                            case (true) { -> this.x_deref(n); }
                                                                                                                                                                                                            default
                                                                                                                                                                                                            {
