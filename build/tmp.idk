                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                            case (true) { *ttype = TokenType.BITNOT_OP; -> 2; }
                                                                                                                                                                                                                                                                                            default
                                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                                                switch (this.match(g"`&", 2))
                                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                                    case (true) { *ttype = TokenType.BITAND_OP; -> 2; }
                                                                                                                                                                                                                                                                                                    default
                                                                                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                                                                                        switch (this.match(g"`|", 2))
                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                            case (true) { *ttype = TokenType.BITOR_OP; -> 2; }
                                                                                                                                                                                                                                                                                                            default {};
                                                                                                                                                                                                                                                                                                        };
                                                                                                                                                                                                                                                                                                    };
                                                                                                                                                                                                                                                                                                };
                                                                                                                                                                                                                                                                                            };
                                                                                                                                                                                                                                                                                        };
