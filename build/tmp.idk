                                                                    }
                                                                        default
                                                                        {
                                                                            lt = this.lower(ts, true, n.line);
                                                                            switch (lt == (IRType*)0)
                                                                            {
                                                                                case (true) { ->; }
                                                                                default
                                                                                {
                                                                                    this.str_bytes(n.a);
