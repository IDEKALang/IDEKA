                                            this.error(g"Comma-separated names are only allowed for prototypes (forward declarations)\0");
                                            -> this.done(o);
                                        }
                                            default
                                            {
                                                pv_free(names);

                                                switch (o.d != (Node*)0)
                                                {
                                                    case (true) { nm_put(this.tobj_fwd, o.text, (void*)o); }
                                                    default {};
                                                };
                                                switch (!this.consume(TokenType.LEFT_BRACE))
                                                {
