                                                                            default {};
                                                                        };
                                                                        switch (!this.process_file(text + ts, te - ts, 2))
                                                                        {
                                                                            case (true) { -> -1; }
                                                                            default {};
                                                                        };
                                                                        j = q2 + 1;
                                                                    }
                                                                    case (34)
                                                                    {
                                                                        j++;
                                                                        q2 = pp_find(text, j, b, 34);
                                                                        switch (q2 == -1)
                                                                        {
                                                                            case (true) {
                                                                            this.e_begin(PPError.SYNTAX);
                                                                            this.errb.put_str(g"[PREPROCESSOR] Unterminated \"\" in #import at line \0");
                                                                            this.errb.put_int(i + 1);
                                                                            -> -1;
                                                                        }
                                                                            default {};
                                                                        };
                                                                        ts = j;
                                                                        te = q2;
                                                                        pp_trim(text, @ts, @te);
                                                                        switch (this.verbose)
                                                                        {
                                                                            case (true) { this.vline(g"[PREPROCESSOR] Local import: \0", text + ts, te - ts, g"\0"); }
                                                                            default {};
                                                                        };
                                                                        switch (!this.process_file(text + ts, te - ts, 1))
                                                                        {
                                                                            case (true) { -> -1; }
                                                                            default {};
                                                                        };
                                                                        j = q2 + 1;
                                                                    }
                                                                    default
                                                                    {
                                                                        j++;
                                                                    };
                                                                };
                                                            };
                                                            this.emit_blank(this.cur_lineno);
                                                            -> i + 1;
                                                        }
                                                            default
                                                            {

                                                                switch (pp_starts(text, s, e, g"#warn\0", 5))
                                                                {
                                                                    case (true) {
                                                                    switch (text[e - 1] != 59)
                                                                    {
                                                                        case (true) {
                                                                        this.e_begin(PPError.SYNTAX);
                                                                        this.errb.put_str(g"[PREPROCESSOR] #warn directive missing semicolon at line \0");
                                                                        this.errb.put_int(i + 1);
                                                                        -> -1;
                                                                    }
                                                                        default {};
                                                                    };
                                                                    q1 = pp_find(text, lo, hi, 34);
                                                                    switch (q1 != -1)
                                                                    {
                                                                        case (true) {
                                                                        q2 = pp_find(text, q1 + 1, hi, 34);
                                                                        switch (q2 != -1)
                                                                        {
                                                                            case (true) {
                                                                            this.vline(g"[PREPROCESSOR] \0", text + q1 + 1, q2 - q1 - 1, g"\0");
                                                                        }
                                                                            default {};
                                                                        };
                                                                    }
                                                                        default {};
                                                                    };
                                                                    this.emit_blank(this.cur_lineno);
                                                                    -> i + 1;
                                                                }
                                                                    default
                                                                    {

                                                                        switch (pp_starts(text, s, e, g"#stop\0", 5))
                                                                        {
                                                                            case (true) {
                                                                            switch (text[e - 1] != 59)
                                                                            {
                                                                                case (true) {
                                                                                this.e_begin(PPError.SYNTAX);
                                                                                this.errb.put_str(g"[PREPROCESSOR] #stop directive missing semicolon at line \0");
                                                                                this.errb.put_int(i + 1);
                                                                                -> -1;
                                                                            }
                                                                                default {};
                                                                            };
                                                                            q1 = pp_find(text, lo, hi, 34);
                                                                            switch (q1 != -1)
                                                                            {
                                                                                case (true) {
                                                                                q2 = pp_find(text, q1 + 1, hi, 34);
                                                                                switch (q2 != -1)
                                                                                {
                                                                                    case (true) {
                                                                                    this.vline(g"[PREPROCESSOR] \0", text + q1 + 1, q2 - q1 - 1, g"\0");
                                                                                }
                                                                                    default {};
                                                                                };
                                                                            }
                                                                                default {};
                                                                            };
                                                                            standard::io::console::println(g"Compilation failed, preprocessor stopped by constant.\0");
                                                                            this.e_begin(PPError.STOP);
                                                                            -> -1;
                                                                        }
                                                                            default
                                                                            {

                                                                                switch (pp_starts(text, s, e, g"#endif;\0", 7))
                                                                                {
                                                                                    case (true) {
                                                                                    this.emit_blank(this.cur_lineno);
                                                                                    -> i + 1;
                                                                                }
                                                                                    default
                                                                                    {

                                                                                        switch (e - s == 5)
                                                                                        {
                                                                                            case (true) {
                                                                                            switch (pp_eq(text + s, g"#else\0", 5))
                                                                                            {
                                                                                                case (true) {
                                                                                                this.emit_blank(this.cur_lineno);
                                                                                                -> i + 1;
                                                                                            }
                                                                                                default {};
                                                                                            };
                                                                                        }
                                                                                            default {};
                                                                                        };


                                                                                        switch (!this.substitute_constants(text + lo, hi - lo))
                                                                                        {
                                                                                            case (true) { -> -1; }
                                                                                            default
                                                                                            {
                                                                                                this.emit(this.sub_ptr, this.sub_len, this.cur_lineno);
                                                                                                -> i + 1;
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };




            cond_true(byte* text, int off, int n, bool invert, bool check_macros) -> bool
            {
                bool defined = false;
                int e;
                switch (check_macros)
                {
                    case (true) {
                    defined = this.psubs.find(text + off, n) >= 0;
                }
                    default {
                    e = this.consts.find(text + off, n);
                    switch (e >= 0)
                    {
                        case (true) {
                        defined = true;
                        switch (this.consts.val_len(e) == 1)
                        {
                            case (true) {
                            switch (this.consts.val_ptr(e)[0] == '0')
                            {
                                case (true) { defined = false; }
                                default {};
                            };
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                };
                };
                switch (invert)
                {
                    case (true) { -> !defined; }
                    default
                    {
                        -> defined;
                    };
                };
            };



            parse_condition(byte* text, int lo, int hi, int lineno) -> bool
            {
                int p, q, n, w;
                bool inv = false;
                bool ok3 = false;


                p = lo;
                switch (pp_at(text, hi, p) == '!')
                {
                    case (true) {
                    inv = true;
                    p++;
                    while (true)
                    {
                        w = pp_ws_fwd(text, hi, p);
                        switch (w == 0)
                        {
                            case (true) { break; }
                            default
                            {
                                p = p + w;
                            };
                        };
                    };
                }
                    default {};
                };
                switch (pp_starts(text, p, hi, g"defined\0", 7))
                {
                    case (true) {
                    p = p + 7;
                    while (true)
                    {
                        w = pp_ws_fwd(text, hi, p);
                        switch (w == 0)
                        {
                            case (true) { break; }
                            default
                            {
                                p = p + w;
                            };
                        };
                    };
                    switch (pp_at(text, hi, p) == '(')
                    {
                        case (true) {
                        p++;
                        while (true)
                        {
                            w = pp_ws_fwd(text, hi, p);
                            switch (w == 0)
                            {
                                case (true) { break; }
                                default
                                {
                                    p = p + w;
                                };
                            };
                        };
                        q = p;
                        while (q < hi)
                        {
                            switch (!pp_is_word((int)text[q]))
                            {
                                case (true) { break; }
                                default
                                {
                                    q++;
                                };
                            };
                        };
                        switch (q > p)
                        {
                            case (true) {
                            n = q;
                            while (true)
                            {
                                w = pp_ws_fwd(text, hi, n);
                                switch (w == 0)
                                {
                                    case (true) { break; }
                                    default
                                    {
                                        n = n + w;
                                    };
                                };
                            };
                            switch (pp_at(text, hi, n) == ')')
                            {
                                case (true) {
                                n++;
                                switch (n == hi)
                                {
                                    case (true) {
                                    this.pc_off = p;
                                    this.pc_len = q - p;
                                    this.pc_inv = inv;
                                    -> true;
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                }
                    default {};
                };


                switch (hi > lo)
                {
                    case (true) {
                    ok3 = true;
                    p = lo;
                    while (p < hi)
                    {
                        switch (!pp_is_word((int)text[p]))
                        {
                            case (true) {
                            ok3 = false;
                            break;
                        }
                            default
                            {
                                p++;
                            };
                        };
                    };
                }
                    default {};
                };
                switch (ok3)
                {
                    case (true) {
                    this.pc_off = lo;
                    this.pc_len = hi - lo;
                    this.pc_inv = false;
                    -> true;
                }
                    default
                    {
                        this.e_begin(PPError.SYNTAX);
                        this.errb.put_str(g"[PREPROCESSOR] Unsupported #elif condition '\0");
                        this.errb.put_n(text + lo, hi - lo);
                        this.errb.put_str(f"' at line {lineno}. Only 'SYMBOL', 'defined(SYMBOL)', and '!defined(SYMBOL)' are supported.\0");
                        -> false;
                    };
                };
            };



            process_conditional(LineList* ll, int start_i, int name_off, int name_n, bool is_ifndef, bool check_macros) -> int
            {
                IntVec c_off();
                IntVec c_len();
                IntVec c_orig();
                IntVec b_start();
                IntVec b_name();
                IntVec b_nlen();
                IntVec b_inv();
                IntVec b_always();
                defer c_off.__exit();
                defer c_len.__exit();
                defer c_orig.__exit();
                defer b_start.__exit();
                defer b_name.__exit();
                defer b_nlen.__exit();
                defer b_inv.__exit();
                defer b_always.__exit();
                LineList sub;

                byte* text = ll.text;
                int entry_local = this.cur_lineno;
                int i, depth, lo, hi, s, e, orig, a, b, ch, bs, be, bi, j, w, nb;
                bool has_else;

                this.emit_blank(this.cur_lineno);

                b_start.push(0);
                b_name.push(name_off);
                b_nlen.push(name_n);
                switch (is_ifndef)
                {
                    case (true) { b_inv.push(1); }
                    default { b_inv.push(0); };
                };
                b_always.push(0);
                has_else = false;

                i = start_i + 1;
                depth = 1;

                while (i < ll.n)
                {
                    lo = ll.off[i];
                    hi = lo + ll.len[i];
                    s = lo;
                    e = hi;
                    pp_trim(text, @s, @e);
                    orig = entry_local + (i - start_i);

                    switch (pp_starts(text, s, e, g"#ifdef\0", 6) | pp_starts(text, s, e, g"#ifndef\0", 7)
                        | pp_starts(text, s, e, g"#ifnpsub\0", 8) | pp_starts(text, s, e, g"#ifpsub\0", 7))
                    {
                        case (true) {
                        depth++;
                    }
                        default {};
                    };

                    switch (pp_starts(text, s, e, g"#endif;\0", 7))
                    {
                        case (true) {
                        depth--;
                        switch (depth == 0)
                        {
                            case (true) {
                            this.emit_blank(orig);

                            nb = b_start.len;
                            ch = -1;
                            bi = 0;
                            while (bi < nb)
                            {
                                switch (b_always.arr[bi] == 1)
                                {
                                    case (true) {
                                    ch = bi;
                                    break;
                                }
                                    default {};
                                };
                                switch (this.cond_true(text, b_name.arr[bi], b_nlen.arr[bi], b_inv.arr[bi] == 1, check_macros))
                                {
                                    case (true) {
                                    ch = bi;
                                    break;
                                }
                                    default {};
                                };
                                bi++;
                            };


                            bi = 0;
                            while (bi < nb)
                            {
                                switch (bi != ch)
                                {
                                    case (true) {
                                    bs = b_start.arr[bi];
                                    be = c_off.len;
                                    switch (bi + 1 < nb)
                                    {
                                        case (true) { be = b_start.arr[bi + 1]; }
                                        default {};
                                    };
                                    j = bs;
                                    while (j < be)
                                    {
                                        this.emit_blank(c_orig.arr[j]);
                                        j++;
                                    };
                                }
                                    default {};
                                };
                                bi++;
                            };

                            switch (ch >= 0)
                            {
                                case (true) {
                                bs = b_start.arr[ch];
                                be = c_off.len;
                                switch (ch + 1 < nb)
                                {
                                    case (true) { be = b_start.arr[ch + 1]; }
                                    default {};
                                };
                                switch (be > bs)
                                {
                                    case (true) {
                                    sub.text = text;
                                    sub.off = c_off.arr + bs;
                                    sub.len = c_len.arr + bs;
                                    sub.n = be - bs;
                                    j = 0;
                                    while (j < sub.n)
                                    {
                                        this.cur_lineno = c_orig.arr[bs + j];
                                        j = this.process_line(@sub, j);
                                        switch (j < 0)
                                        {
                                            case (true) { -> -1; }
                                            default {};
                                        };
                                    };
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                            -> i + 1;
                        }
                            default {};
                        };
                        c_off.push(lo);
                        c_len.push(hi - lo);
                        c_orig.push(orig);
                        i++;
                        continue;
                    }
                        default
                        {
                            switch (depth == 1)
                            {
                                case (true) {
                                switch (pp_starts(text, s, e, g"#elif\0", 5))
                                {
                                    case (true) {
                                    switch (has_else)
                                    {
                                        case (true) {
                                        this.e_begin(PPError.SYNTAX);
                                        this.errb.put_str(g"[PREPROCESSOR] #elif after #else at line \0");
                                        this.errb.put_int(i + 1);
                                        -> -1;
                                    }
                                        default {};
                                    };
                                    a = s + 5;
                                    b = e;
                                    while (b > a)
                                    {
                                        switch (text[b - 1] != 59)
                                        {
                                            case (true) { break; }
                                            default {};
                                        };
                                        b--;
                                    };
                                    pp_trim(text, @a, @b);
                                    switch (!this.parse_condition(text, a, b, i + 1))
                                    {
                                        case (true) { -> -1; }
                                        default {};
                                    };
                                    b_start.push(c_off.len);
                                    b_name.push(this.pc_off);
                                    b_nlen.push(this.pc_len);
                                    switch (this.pc_inv)
                                    {
                                        case (true) { b_inv.push(1); }
                                        default { b_inv.push(0); };
                                    };
                                    b_always.push(0);
                                    this.emit_blank(orig);
                                    i++;
                                    continue;
                                }
                                    default
                                    {
                                        w = e - s;
                                        switch (pp_eq(text + s, g"#else\0", 5) & w == 5 | pp_eq(text + s, g"#else;\0", 6) & w == 6)
                                        {
                                            case (true) {
                                            switch (has_else)
                                            {
                                                case (true) {
                                                this.e_begin(PPError.SYNTAX);
                                                this.errb.put_str(g"[PREPROCESSOR] Multiple #else in same conditional block at line \0");
                                                this.errb.put_int(i + 1);
                                                -> -1;
                                            }
                                                default
                                                {
                                                    has_else = true;
                                                    b_start.push(c_off.len);
                                                    b_name.push(0);
                                                    b_nlen.push(0);
                                                    b_inv.push(0);
                                                    b_always.push(1);
                                                    this.emit_blank(orig);
                                                    i++;
                                                    continue;
                                                };
                                            };
                                        }
                                            default {};
                                        };
                                    };
                                };
                            }
                                default {};
                            };

                            c_off.push(lo);
                            c_len.push(hi - lo);
                            c_orig.push(orig);
                            i++;
                        };
                    };
                };

                this.e_begin(PPError.SYNTAX);
                this.errb.put_str(g"Unclosed conditional block starting at line \0");
                this.errb.put_int(start_i + 1);
                -> -1;
            };





            macro_pass(byte* src, int n) -> int
            {
                int i, j, k, c, depth, rs, re, ent, np, na, cstart, p, plen, d, ra, rb;
                bool in_str, changed;
                int str_char;
                byte* ppar;

                this.mc.clear();
                while (i < n)
                {
                    c = (int)src[i];
                    switch (!pp_is_alpha_us(c))
                    {
                        case (true) {
                        this.mc.put(c);
                        i++;
                        continue;
                    }
                        default
                        {
                            j = i;
                            while (j < n)
                            {
                                switch (!pp_is_word((int)src[j]))
                                {
                                    case (true) { break; }
                                    default
                                    {
                                        j++;
                                    };
                                };
                            };

                            ent = this.psubs.find(src + i, j - i);
                            switch (ent < 0)
                            {
                                case (true) {
                                this.mc.put_n(src + i, j - i);
                                i = j;
                                continue;
                            }
                                default
                                {
                                    switch (pp_at(src, n, j) != '(')
                                    {
                                        case (true) {
                                        this.mc.put_n(src + i, j - i);
                                        i = j;
                                        continue;
                                    }
                                        default
                                        {

                                            k = j + 1;
                                            depth = 1;
                                            in_str = false;
                                            str_char = 0;
                                            while (k < n & depth > 0)
                                            {
                                                c = (int)src[k];
                                                switch (in_str)
                                                {
                                                    case (true) {
                                                    switch (c == 92)
                                                    {
                                                        case (true) { k++; }
                                                        default {
                                                            switch (c == str_char)
                                                            {
                                                                case (true) { in_str = false; }
                                                                default {};
                                                            };
                                                        };
                                                    };
                                                }
                                                    default {
                                                    switch (c == 34 | c == 39)
                                                    {
                                                        case (true) {
                                                        in_str = true;
                                                        str_char = c;
                                                    }
                                                        default {
                                                            switch (c == '(')
                                                            {
                                                                case (true) { depth++; }
                                                                default {
                                                                    switch (c == ')')
                                                                    {
                                                                        case (true) { depth--; }
                                                                        default {};
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                                };
                                                k++;
                                            };

                                            rs = j + 1;
                                            re = k - 1;
                                            switch (re > n)
                                            {
                                                case (true) { re = n; }
                                                default {};
                                            };
                                            switch (re < rs)
                                            {
                                                case (true) { re = rs; }
                                                default {};
                                            };


                                            this.aoff.clear();
                                            this.alen.clear();
                                            depth = 0;
                                            in_str = false;
                                            str_char = 0;
                                            cstart = rs;
                                            na = 0;
                                            p = rs;
                                            while (p < re)
                                            {
                                                c = (int)src[p];
                                                switch (in_str)
                                                {
                                                    case (true) {
                                                    switch (c == str_char)
                                                    {
                                                        case (true) { in_str = false; }
                                                        default {};
                                                    };
                                                }
                                                    default {
                                                        switch (c == 34 | c == 39)
                                                        {
                                                            case (true) {
                                                    in_str = true;
                                                    str_char = c;
                                                }
                                                            default {
                                                                switch (c == '(')
                                                                {
                                                                    case (true) { depth++; }
                                                                    default {
                                                                        switch (c == ')')
                                                                        {
                                                                            case (true) { depth--; }
                                                                            default {
                                                                                switch (c == ',' & depth == 0)
                                                                                {
                                                                                    case (true) {
                                                    this.aoff.push(cstart);
                                                    this.alen.push(p - cstart);
                                                    na++;
                                                    cstart = p + 1;
                                                }
                                                                                    default {};
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                                p++;
                                            };
                                            switch (re - cstart > 0 | na > 0)
                                            {
                                                case (true) {
                                                this.aoff.push(cstart);
                                                this.alen.push(re - cstart);
                                                na++;
                                            }
                                                default {};
                                            };

                                            np = this.psubs.par_count(ent);
                                            switch (na != np)
                                            {
                                                case (true) {
                                                this.e_begin(PPError.SYNTAX);
                                                this.errb.put_str(g"[PREPROCESSOR] Macro '\0");
                                                this.errb.put_n(src + i, j - i);
                                                this.errb.put_str(f"' expects {np} argument(s), got {na}: '\0");
                                                d = k;
                                                switch (d > n)
                                                {
                                                    case (true) { d = n; }
                                                    default {};
                                                };
                                                this.errb.put_n(src + i, d - i);
                                                this.errb.put_str(g"'\0");
                                                -> -1;
                                            }
                                                default
                                                {

                                                    this.x1.clear();
                                                    this.x1.put_n(this.psubs.val_ptr(ent), this.psubs.val_len(ent));
                                                    ppar = this.psubs.par_ptr(ent);
                                                    p = 0;
                                                    while (p < np)
                                                    {
                                                        plen = pp_cstrlen(ppar);
                                                        ra = this.aoff.arr[p];
                                                        rb = ra + this.alen.arr[p];
                                                        pp_trim(src, @ra, @rb);
                                                        this.x2.clear();
                                                        this.x2.put_replaced_word(this.x1.mem, this.x1.len, ppar, plen, src + ra, rb - ra);
                                                        this.x1.clear();
                                                        this.x1.put_n(this.x2.mem, this.x2.len);
                                                        ppar = ppar + plen + 1;
                                                        p++;
                                                    };
                                                    this.mc.put_n(this.x1.mem, this.x1.len);
                                                    changed = true;
                                                    i = k;
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };

                switch (changed)
                {
                    case (true) { -> 1; }
                    default
                    {
                        -> 0;
                    };
                };
            };



            expand_macros(byte* s, int n) -> bool
            {
                int depth, rc;
                this.ex_ptr = s;
                this.ex_len = n;
                switch (this.psubs.count == 0)
                {
                    case (true) { -> true; }
                    default
                    {
                        while (true)
                        {
                            switch (depth > 64)
                            {
                                case (true) {
                                this.e_begin(PPError.RECURSION);
                                this.errb.put_str(g"[PREPROCESSOR] Macro expansion exceeded depth limit (64). Possible infinite recursion.\0");
                                -> false;
                            }
                                default
                                {
                                    rc = this.macro_pass(this.ex_ptr, this.ex_len);
                                    switch (rc < 0)
                                    {
                                        case (true) { -> false; }
                                        default
                                        {
                                            switch (rc == 0)
                                            {
                                                case (true) { -> true; }
                                                default
                                                {
                                                    this.ma.clear();
                                                    this.ma.put_n(this.mc.mem, this.mc.len);
                                                    this.ex_ptr = this.ma.mem;
                                                    this.ex_len = this.ma.len;
                                                    depth++;
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        -> true;
                    };
                };
            };


            flush_token(byte* s, int ts, int te, bool in_quotes) -> void
            {
                int e = -1;
                int w, a, b;
                byte* v;
                switch (!in_quotes)
                {
                    case (true) { e = this.consts.find(s + ts, te - ts); }
                    default {};
                };
                switch (e < 0)
                {
                    case (true) {
                    -> this.sc.put_n(s + ts, te - ts);
                }
                    default
                    {
                        v = this.consts.val_ptr(e);
                        w = this.consts.val_len(e);
                        switch (w > 0)
                        {
                            case (true) {
                            switch (v[w - 1] == 59)
                            {
                                case (true) {
                                while (w > 0)
                                {
                                    switch (v[w - 1] != 59)
                                    {
                                        case (true) { break; }
                                        default
                                        {
                                            w--;
                                        };
                                    };
                                };
                                a = 0;
                                b = w;
                                pp_trim(v, @a, @b);
                                -> this.sc.put_n(v + a, b - a);
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                        -> this.sc.put_n(v, w);
                    };
                };
            };



            substitute_constants(byte* s, int n) -> bool
            {
                int i, w, ts, a, b, c;
                bool in_quotes;
                switch (!this.expand_macros(s, n))
                {
                    case (true) { -> false; }
                    default
                    {
                        byte* t = this.ex_ptr;
                        int tn = this.ex_len;
                        this.sub_ptr = t;
                        this.sub_len = tn;
                        switch (tn == 0)
                        {
                            case (true) { -> true; }
                            default
                            {
                                a = 0;
                                b = tn;
                                pp_trim(t, @a, @b);
                                switch (b - a == 1)
                                {
                                    case (true) {
                                    switch (t[a] == 59)
                                    {
                                        case (true) { -> true; }
                                        default {};
                                    };
                                }
                                    default {};
                                };

                                this.sc.clear();
                                ts = -1;
                                in_quotes = false;
                                while (i < tn)
                                {
                                    c = (int)t[i];
                                    switch (c == 34)
                                    {
                                        case (true) {
                                        in_quotes = !in_quotes;
                                        switch (ts < 0)
                                        {
                                            case (true) { ts = i; }
                                            default {};
                                        };
                                        i++;
                                        continue;
                                    }
                                        default
                                        {
                                            w = pp_ws_fwd(t, tn, i);
                                            switch (w == 0)
                                            {
                                                case (true) {
                                                switch (pp_is_delim(c))
                                                {
                                                    case (true) { w = 1; }
                                                    default {};
                                                };
                                            }
                                                default {};
                                            };
                                            switch (w > 0)
                                            {
                                                case (true) {
                                                switch (ts >= 0)
                                                {
                                                    case (true) {
                                                    this.flush_token(t, ts, i, in_quotes);
                                                    ts = -1;
                                                }
                                                    default {};
                                                };
                                                this.sc.put_n(t + i, w);
                                                i = i + w;
                                            }
                                                default {
                                                switch (ts < 0)
                                                {
                                                    case (true) { ts = i; }
                                                    default {};
                                                };
                                                i++;
                                            };
                                            };
                                        };
                                    };
                                };
                                switch (ts >= 0)
                                {
                                    case (true) { this.flush_token(t, ts, tn, in_quotes); }
                                    default {};
                                };

                                this.sub_ptr = this.sc.mem;
                                this.sub_len = this.sc.len;
                                -> true;
                            };
                        };
                    };
                };
            };




            process() -> bool
            {
                int pl, iteration, ls, le;
                bool replaced, first;

                switch (this.err_kind != 0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (this.realpath_into(this.srcpath.mem))
                        {
                            case (true) {
                            pl = pp_parent_len(this.rbuf.mem, this.rbuf.len);
                            this.root_dir_off = this.pool_add(this.rbuf.mem, pl);
                        }
                            default {
                            pl = pp_parent_len(this.srcpath.mem, this.srcpath.len);
                            this.root_dir_off = this.pool_add(this.srcpath.mem, pl);
                        };
                        };

                        switch (!this.process_file(this.srcpath.mem, this.srcpath.len, 0))
                        {
                            case (true) { -> false; }
                            default
                            {
                                replaced = true;
                                while (replaced)
                                {
                                    iteration++;
                                    switch (this.verbose)
                                    {
                                        case (true) {
                                        standard::io::console::print(g"[PREPROCESSOR] constant substitution passes: \0");
                                        standard::io::console::println(iteration);
                                    }
                                        default {};
                                    };
                                    replaced = false;
                                    this.passb.clear();
                                    first = true;
                                    ls = 0;
                                    while (true)
                                    {
                                        le = ls;
                                        while (le < this.outb.len)
                                        {
                                            switch (this.outb.mem[le] == 10)
                                            {
                                                case (true) { break; }
                                                default
                                                {
                                                    le++;
                                                };
                                            };
                                        };
                                        switch (!this.substitute_constants(this.outb.mem + ls, le - ls))
                                        {
                                            case (true) { -> false; }
                                            default
                                            {
                                                switch (!first)
                                                {
                                                    case (true) { this.passb.put(10); }
                                                    default {};
                                                };
                                                first = false;
                                                this.passb.put_n(this.sub_ptr, this.sub_len);
                                                switch (this.sub_len != le - ls)
                                                {
                                                    case (true) {
                                                    replaced = true;
                                                }
                                                    default {
                                                        switch (!pp_eq(this.sub_ptr, this.outb.mem + ls, this.sub_len))
                                                        {
                                                            case (true) {
                                                    replaced = true;
                                                }
                                                            default {};
                                                        };
                                                    };
                                                };
                                                switch (le >= this.outb.len)
                                                {
                                                    case (true) { break; }
                                                    default
                                                    {
                                                        ls = le + 1;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                    this.outb.clear();
                                    this.outb.put_n(this.passb.mem, this.passb.len);
                                };

                                switch (this.verbose)
                                {
                                    case (true) {
                                    switch (iteration > 1)
                                    {
                                        case (true) {
                                        standard::io::console::print(g"[PREPROCESSOR] Completed after \0");
                                        standard::io::console::print(iteration);
                                        standard::io::console::println(g" constant passes.\0");
                                    }
                                        default {
                                        standard::io::console::print(g"[PREPROCESSOR] Completed after \0");
                                        standard::io::console::print(iteration);
                                        standard::io::console::println(g" constant pass.\0");
                                    };
                                    };
                                    standard::io::console::print(g"[PREPROCESSOR] Processed \0");
                                    standard::io::console::print(this.processed.count);
                                    standard::io::console::println(g" file(s)\0");
                                }
                                    default {};
                                };

                                switch (!this.alloc_ok())
                                {
                                    case (true) {
                                    this.e_begin(PPError.ALLOC);
                                    this.errb.put_str(g"[PREPROCESSOR] allocation failed\0");
                                    -> false;
                                }
                                    default
                                    {
                                        -> true;
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
};
































using standard::io::console;
using IDEKA::lexer;
using IDEKA::preprocessor;

namespace IDEKA
{
    namespace errors
    {

        const int SEV_ERROR = 0;
        const int SEV_WARNING = 1;

        const int DIAG_TAB_WIDTH = 4;


        bool DIAG_COLOR_ON = false;


        int WARN_COUNT = 0;



        diag_sgr(Buf* out, byte* code) -> void
        {
            out.put(27);
            out.put_str("[\0");
            out.put_str(code);
            out.put_str("m\0");
        };

        diag_sev_code(int sev) -> byte*
        {
            if (sev == SEV_WARNING) { -> g"93\0"; };
            -> g"91\0";
        };




        sym_of(int t) -> byte*
        {
            switch (t)
            {
                case (TokenType.PLUS) { -> g"+\0"; }
                case (TokenType.MINUS) { -> g"-\0"; }
                case (TokenType.MULTIPLY) { -> g"*\0"; }
                case (TokenType.DIVIDE) { -> g"/\0"; }
                case (TokenType.MODULO) { -> g"%\0"; }
                case (TokenType.LESS_THAN) { -> g"<\0"; }
                case (TokenType.GREATER_THAN) { -> g">\0"; }
                case (TokenType.ASSIGN) { -> g"=\0"; }
                case (TokenType.LOGICAL_OR) { -> g"|\0"; }
                case (TokenType.LOGICAL_AND) { -> g"&\0"; }
                case (TokenType.BITXOR_OP) { -> g"^\0"; }
                case (TokenType.NOT) { -> g"!\0"; }
                case (TokenType.QUESTION) { -> g"?\0"; }
                case (TokenType.ADDRESS_OF) { -> g"@\0"; }
                case (TokenType.TIE) { -> g"~\0"; }
                case (TokenType.INCREMENT) { -> g"++\0"; }
                case (TokenType.DECREMENT) { -> g"--\0"; }
                case (TokenType.EQUAL) { -> g"==\0"; }
                case (TokenType.NOT_EQUAL) { -> g"!=\0"; }
                case (TokenType.LESS_EQUAL) { -> g"<=\0"; }
                case (TokenType.GREATER_EQUAL) { -> g">=\0"; }
                case (TokenType.NAND_OP) { -> g"!&\0"; }
                case (TokenType.NOR_OP) { -> g"!|\0"; }
                case (TokenType.XOR_OP) { -> g"^|\0"; }
                case (TokenType.BITSHIFT_LEFT) { -> g"<<\0"; }
                case (TokenType.BITSHIFT_RIGHT) { -> g">>\0"; }
                case (TokenType.BITNAND_OP) { -> g"`!&\0"; }
                case (TokenType.BITNOR_OP) { -> g"`!|\0"; }
                case (TokenType.BITXNAND) { -> g"`^|!&\0"; }
                case (TokenType.BITXNOR) { -> g"`^|!|\0"; }
                case (TokenType.LEFT_PAREN) { -> g"(\0"; }
                case (TokenType.RIGHT_PAREN) { -> g")\0"; }
                case (TokenType.LEFT_BRACE) { -> g"{\0"; }
                case (TokenType.RIGHT_BRACE) { -> g"}\0"; }
                case (TokenType.LEFT_BRACKET) { -> g"[\0"; }
                case (TokenType.RIGHT_BRACKET) { -> g"]\0"; }
                case (TokenType.SEMICOLON) { -> g";\0"; }
                case (TokenType.COLON) { -> g":\0"; }
                case (TokenType.COMMA) { -> g",\0"; }
                case (TokenType.DOT) { -> g".\0"; }
                case (TokenType.RETURN_ARROW) { -> g"->\0"; }
                case (TokenType.SCOPE) { -> g"::\0"; }
                case (TokenType.BACKSLASH) { -> g"\\\0"; }
                default { -> (byte*)0; };
            };
            -> (byte*)0;
        };


        ends_prev_line(int t) -> bool -> t == TokenType.SEMICOLON | t == TokenType.COMMA;




        line_bounds(byte* src, int n, int ln, int* ls, int* le) -> bool
        {
            int k = 1;
            int p = 0;
            int e;
            while (k < ln & p < n)
            {
                if (src[p] == 10) { k++; };
                p++;
            };
            if (k != ln) { -> false; };
            e = p;
            while (e < n & src[e] != 10 & src[e] != 13) { e++; };
            *ls = p;
            *le = e;
            -> true;
        };



        expand_tabs(Buf* out, byte* raw, int rn, int stop_col) -> int
        {
            int i = 0;
            int vis = 1;
            int sp, col_in_raw, k;
            int base = out.len;
            while (i < rn)
            {
                col_in_raw = i + 1;
                if (raw[i] == 9)
                {
                    sp = DIAG_TAB_WIDTH - ((out.len - base) % DIAG_TAB_WIDTH);
                    k = 0;
                    while (k < sp) { out.put(32); k++; };
                    if (col_in_raw < stop_col) { vis = vis + sp; };
                }
                else
                {
                    out.put((int)raw[i]);
                    if (col_in_raw < stop_col) { vis++; };
                };
                i++;
            };
            -> vis;
        };

        is_space(int c) -> bool -> c == 32 | c == 9 | c == 10 | c == 13 | c == 11 | c == 12;







        build_suggestion(Buf* out, int expected, int got, int got_len, int tok_line, int tok_col, int prev_line, byte* raw, int rn, byte* ex, int en, int dash_count) -> bool
        {
            byte* fix_sym = sym_of(expected);
            int i, j, k, be, ind_end, t_end, v_start, v_end, col0, end_col, before_end, after_start, bn;
            bool has_after, starts;
            Buf fixed;
            if (fix_sym == (byte*)0) { -> false; };
            if (ends_prev_line(expected))
            {

                if (expected == TokenType.SEMICOLON & got == TokenType.LEFT_BRACKET & prev_line > 0)
                {
                    be = rn;
                    while (be > 0 & is_space((int)raw[be - 1])) { be--; };
                    ind_end = 0;
                    while (ind_end < be & is_space((int)raw[ind_end])) { ind_end++; };
                    t_end = ind_end;
                    while (t_end < be & !is_space((int)raw[t_end])) { t_end++; };
                    if (t_end > ind_end & t_end < be)
                    {
                        v_start = t_end;
                        while (v_start < be & is_space((int)raw[v_start])) { v_start++; };
                        v_end = be;
                        if (v_end > v_start & raw[v_end - 1] == ';') { v_end--; };

                        if (v_end > v_start & raw[v_end - 1] == ']')
                        {
                            k = v_end - 2;
                            while (k >= v_start & raw[k] >= '0' & raw[k] <= '9') { k--; };
                            if (k >= v_start & raw[k] == '[' & k < v_end - 2 & k > v_start)
                            {
                                j = v_start;
                                while (j < k & !is_space((int)raw[j])) { j++; };
                                if (j == k)
                                {
                                    out.put_n(raw, t_end);
                                    out.put_n(raw + k, v_end - k);
                                    out.put(32);
                                    out.put_n(raw + v_start, k - v_start);
                                    out.put_str(";  // try this\0");
                                    -> true;
                                };
                            };
                        };
                    };
                };

                if (prev_line > 0 & prev_line == tok_line)
                {
                    bn = pp_cstrlen(fix_sym);
                    be = rn;
                    while (be > 0 & is_space((int)raw[be - 1])) { be--; };
                    if (be >= bn)
                    {
                        starts = true;
                        k = 0;
                        while (k < bn) { if (raw[be - bn + k] != fix_sym[k]) { starts = false; }; k++; };
                        if (starts) { -> false; };
                    };
                    col0 = tok_col - 1;
                    end_col = col0 + got_len;
                    if (end_col > rn) { end_col = rn; };
                    if (col0 > rn) { col0 = rn; };
                    before_end = col0;
                    while (before_end > 0 & is_space((int)raw[before_end - 1])) { before_end--; };
                    after_start = end_col;
                    while (after_start < rn & is_space((int)raw[after_start])) { after_start++; };
                    has_after = after_start < rn;
                    starts = false;
                    if (has_after & rn - after_start >= bn)
                    {
                        starts = true;
                        k = 0;
                        while (k < bn) { if (raw[after_start + k] != fix_sym[k]) { starts = false; }; k++; };
                    };
                    fixed.__init();
                    defer fixed.__exit();
                    fixed.put_n(raw, before_end);
                    if (before_end > 0 & has_after & !starts) { fixed.put(32); };
                    fixed.put_n(raw + after_start, rn - after_start);

                    while (fixed.len > 0 & is_space((int)fixed.mem[fixed.len - 1])) { fixed.len--; };
                    fixed.mem[fixed.len] = (byte)0;
                    starts = false;
                    if (fixed.len >= bn)
                    {
                        starts = true;
                        k = 0;
                        while (k < bn) { if (fixed.mem[fixed.len - bn + k] != fix_sym[k]) { starts = false; }; k++; };
                    };
                    out.put_n(fixed.mem, fixed.len);
                    if (!starts) { out.put_str(fix_sym); };
                    out.put_str("  // try this\0");
                    -> true;
                };

                out.put_n(ex, en);
                out.put_str(fix_sym);
                out.put_str("  // try this\0");
                -> true;
            };
            if (expected == TokenType.RETURN_ARROW | (expected == TokenType.ASSIGN & got == TokenType.LEFT_BRACE))
            {
                i = dash_count;
                if (i > en) { i = en; };
                out.put_n(ex, i);
                out.put_str(fix_sym);
                out.put(32);
                while (i < en & is_space((int)ex[i])) { i++; };
                out.put_n(ex + i, en - i);
                out.put_str("  // try this\0");
                -> true;
            };
            -> false;
        };












        render(Buf* out, bool color, int sev, byte* msg, int line, int col, byte* src, int n, int* lmap, int lmapn, byte** lfiles, int expected, int got, int got_len, int prev_line, byte* annotation) -> void
        {
            int show_line = line;
            int show_col = col;
            int ls, le, pls, ple, disp_line, rn, en, vis, dash, k;
            byte* sym;
            Buf ex, sug;
            bool have_sug;

            if (sev == SEV_WARNING) { WARN_COUNT++; };
            if (expected >= 0 & ends_prev_line(expected) & prev_line > 0 & prev_line < line)
            {
                if (line_bounds(src, n, prev_line, @pls, @ple))
                {
                    show_line = prev_line;
                    show_col = (ple - pls) + 1;
                };
            };
            disp_line = show_line;
            if (lmap != (int*)0 & show_line >= 1 & show_line <= lmapn) { disp_line = lmap[show_line - 1]; };
            byte* disp_file = (byte*)0;
            if (lfiles != (byte**)0 & show_line >= 1 & show_line <= lmapn) { disp_file = lfiles[show_line - 1]; };


            if (color)
            {
                diag_sgr(out, "1\0");
                diag_sgr(out, diag_sev_code(sev));
                out.put_str(msg);
                diag_sgr(out, "0\0");
                out.put(32);
                diag_sgr(out, "96\0");
                out.put_str("at \0");
                if (disp_file != (byte*)0) { out.put_str(disp_file); out.put(58); };
                out.put_int(disp_line);
                out.put(58);
                out.put_int(show_col);
                diag_sgr(out, "0\0");
            }
            else
            {
                out.put_str(msg);
                out.put_str(" at \0");
                if (disp_file != (byte*)0) { out.put_str(disp_file); out.put(58); };
                out.put_int(disp_line);
                out.put(58);
                out.put_int(show_col);
            };

            if (!line_bounds(src, n, show_line, @ls, @le)) { ->; };
            rn = le - ls;
            ex.__init();
            defer ex.__exit();
            vis = expand_tabs(@ex, src + ls, rn, show_col);
            en = ex.len;
            if (show_col > rn) { dash = en; } else { dash = vis - 1; };
            if (dash < 0) { dash = 0; };

            sug.__init();
            defer sug.__exit();
            have_sug = false;
            if (expected >= 0)
            {
                have_sug = build_suggestion(@sug, expected, got, got_len, line, col, prev_line, src + ls, rn, ex.mem, en, dash);
            };

            out.put(10);
            out.put_n(ex.mem, en);
            out.put(10);


            if (color)
            {
                diag_sgr(out, "2\0");
                k = 0;
                while (k < dash) { out.put(45); k++; };
                diag_sgr(out, "0\0");
                diag_sgr(out, "1\0");
                diag_sgr(out, diag_sev_code(sev));
                out.put(94);
                diag_sgr(out, "0\0");
            }
            else
            {
                k = 0;
                while (k < dash) { out.put(45); k++; };
                out.put(94);
            };
            if (expected >= 0)
            {
                sym = sym_of(expected);
                if (color) { diag_sgr(out, "92\0"); };
                out.put(32);
                if (sym != (byte*)0) { out.put_str(sym); } else { out.put_str(token_name(expected)); };
                out.put_str(" expected here\0");
                if (color) { diag_sgr(out, "0\0"); };
            };

            if (have_sug)
            {
                out.put(10);
                if (color) { diag_sgr(out, "92\0"); };
                out.put_n(sug.mem, sug.len);
                if (color) { diag_sgr(out, "0\0"); };
            }
            else
            {
                if (annotation != (byte*)0)
                {
                    if (annotation[0] != 0)
                    {
                        out.put(32);
                        if (color) { diag_sgr(out, "95\0"); };
                        out.put_str(annotation);
                        if (color) { diag_sgr(out, "0\0"); };
                    };
                };
            };
            ->;
        };



        diag_color_enabled(bool tty, byte* no_color, byte* force_color) -> bool
        {
            if (no_color != (byte*)0) { -> false; };
            if (force_color != (byte*)0) { if (force_color[0] == '1' & force_color[1] == 0) { -> true; }; };
            -> tty;
        };
    };
};







































































namespace IDEKA
{
    namespace ast
    {
        enum DataType
        {
            SINT,
            UINT,
            SLONG,
            ULONG,
            FLOAT,
            DOUBLE,
            CHAR,
            BOOL,
            DATA,
            BYTE,
            STRUCT,
            ENUM,
            UNION,
            OBJECT,
            VOID,
            THIS,
            FUNC_PTR,
            DICT
        };

        enum StorageClass
        {
            AUTO,
            STACK,
            HEAP,
            GLOBAL,
            LOCAL,
            REGISTER,
            SINGINIT
        };

        enum SymbolKind
        {
            TYPE,
            VARIABLE,
            FUNCTION,
            NAMESPACE,
            OBJECT,
            STRUCT,
            UNION,
            ENUM,
            TRAIT,
            OPERATOR,
            INTERFACE
        };

        enum ProtocolKind
        {
            CALL_ON,
            PASS_INTO,
            RETURN_TO
        };


        enum Operator
        {
            ADD,
            SUB,
            INCREMENT,
            DECREMENT,
            MUL,
            DIV,
            MOD,
            NOT,
            POWER,
            AND,
            OR,
            NAND,
            NOR,
            XOR,
            EQUAL,
            NOT_EQUAL,
            LESS_THAN,
            LESS_EQUAL,
            GREATER_THAN,
            GREATER_EQUAL,
            ASSIGN,
            PLUS_ASSIGN,
            MINUS_ASSIGN,
            MULTIPLY_ASSIGN,
            DIVIDE_ASSIGN,
            MODULO_ASSIGN,
            EXPONENT_ASSIGN,
            BITNOT,
            BITAND,
            BITOR,
            BITNAND,
            BITNOR,
            BITXOR,
            BITXNOT,
            BITXNAND,
            BITXNOR,
            AND_ASSIGN,
            OR_ASSIGN,
            XOR_ASSIGN,
            BITAND_ASSIGN,
            BITOR_ASSIGN,
            BITNAND_ASSIGN,
            BITNOR_ASSIGN,
            BITXOR_ASSIGN,
            BITXNOT_ASSIGN,
            BITXNAND_ASSIGN,
            BITXNOR_ASSIGN,
            BITSHIFT_LEFT,
            BITSHIFT_RIGHT,
            BITSHIFT_LEFT_ASSIGN,
            BITSHIFT_RIGHT_ASSIGN,
            ADDRESS_OF,
            RANGE,
            SCOPE,
            QUESTION,
            COLON,
            TIE,
            LAMBDA_ARROW,
            RETURN_ARROW,
            CHAIN_ARROW,
            RECURSE_ARROW,
            NULL_COALESCE,
            NO_MANGLE,
            FUNCTION_POINTER,
            ADDRESS_CAST
        };


        enum NodeKind
        {
            NODE_LIST,    
            LITERAL,    
            IDENTIFIER,    
            ARRAY_LITERAL,    
            STRING_LITERAL,    
            BINARY_OP,    
            IN_EXPRESSION,    
            HAS_EXPRESSION,    
            UNARY_OP,    
            CAST_EXPRESSION,    
            TYPE_CONVERT_EXPRESSION,    
            RANGE_EXPRESSION,    
            ARRAY_COMPREHENSION,    
            F_STRING_LITERAL,    
            FUNCTION_CALL,    
            MEMBER_ACCESS,    
            METHOD_CALL,    
            VARIADIC_ACCESS,    
            ARRAY_ACCESS,    
            ARRAY_SLICE,    
            BIT_SLICE,    
            BIT_INDEX_ACCESS,    
            POINTER_DEREF,    
            ADDRESS_OF,    
            STRINGIFY,    
            CODIFY,    
            ALIGN_OF,    
            TYPE_OF,    
            SIZE_OF,    
            ENDIAN_OF,    
            NO_INIT,    
            VARIABLE_DECLARATION,    
            TYPE_DECLARATION,    
            EXPRESSION_STATEMENT,    
            ASSIGNMENT,    
            COMPOUND_ASSIGNMENT,    
            RANGE_ASSIGNMENT,    
            TERNARY_ASSIGN,    
            BLOCK,    
            IF_STATEMENT,    
            IF_EXPRESSION,    
            TERNARY_OP,    
