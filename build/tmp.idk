            put_i64(Buf* cb, i64 v) -> void
            {
                byte* tmp = (byte*)fmalloc((u64)24);
                int n = 0;
                int j;
                u64 u;
                bool neg = v < (i64)0;
                switch (neg)
                {
                    case (true) { u = (u64)0 - (u64)v; }
                    default { u = (u64)v; };
                };
                switch (u == (u64)0)
                {
                    case (true) { tmp[0] = '0'; n = 1; }
                    default {};
                };
                while (u != (u64)0)
                {
                    tmp[n] = (byte)((int)(u % (u64)10) + 48);
                    u = u / (u64)10;
                    n++;
                };
                switch (neg) { case (true) { cb.put('-'); } default {}; };
                j = n - 1;
                while (j >= 0)
                {
                    cb.put((int)tmp[j]);
                    j--;
                };
                -> ffree(tmp);
            };


            ctv(Node* e) -> int
            {
                int k = e.kind;
                int st;
                int op;
                i64 lv;
                i64 rv;
                int lk;
                int rk;
                bool b;
                int cm;
                i64 res;
                IRGlobal* gl;
                IDKC_SYMENTRY* se;
                byte* sm;
                byte* sn;
