                                    {
                                        case (0) { iv[ni] = (i64)(int)d; }
                                        case (1) { iv[ni] = d `& (i64)4294967295; }
                                        case (2) { iv[ni] = d; }
                                        case (3) { iv[ni] = d; }
                                        case (6) { switch (d != (i64)0) { case (true) { iv[ni] = (i64)1; } default { iv[ni] = (i64)0; }; }; }
                                        case (7) { iv[ni] = d `& (i64)255; }
                                        case (8) { iv[ni] = d `& (i64)255; }
