                    default {};
                };
                -> true;
            };



            recast_bits(int ft, int fsize) -> int
            {
                switch (ft)
                {
                    case (6) { -> 1; }
                    case (7) { -> 8; }
                    case (8) { -> 8; }
                    case (0) { -> 32; }
                    case (1) { -> 32; }
                    case (2) { -> 64; }
                    case (3) { -> 64; }
                    case (4) { -> 32; }
                    case (5) { -> 64; }
                    default { -> fsize * 8; };
                };
                -> fsize * 8;
            };



            visit_member_access(Node* n) -> bool
