            gen_body(Node* fd, IRFunc* f, byte* obj) -> void
            {
                int i;
                int off = 0;
                TypeSpec* this_ts;
                int np = node_count(fd, 0);
                Node* p;
                byte* pname;
                IRBlock* ebk;
                int dd;
                bool plain;
                IRValue* a;
                IRValue* slot;
                IRType* ft = f.ftype;
                this.bad = false;
                this.bad_what = (byte*)0;
                this.bad_detail = (byte*)0;
                this.body_errs = this.nerrors;
                this.brk = (IRBlock*)0;
                this.cont = (IRBlock*)0;
                this.in_member = false;
                this.va_list_v = (IRValue*)0;
                this.va_list_p = (IRValue*)0;
                this.fn = f;
                                this.fnd = fd;
                this.fret = ft.elem;
                switch (fd.ts2 != (TypeSpec*)0)
                {
                    case (true) {
                    -> this.unsup(fd, g"dual return function\0");
                }
                    default
                    {
                        this.rec_fn = (fd.flags `& 4096) != 0;
                        ebk = this.mod.append_block(f, g"entry\0");
                        this.mod.position(f, ebk);
                        this.mod.set_entry(ebk);
                        this.inited_unions.len = 0;
                        nm_free(this.labels);
                        this.labels = nm_new();
                        nm_free(this.untied);
                        this.untied = nm_new();
                        nm_put(this.labels, this.mod.own(g"entry\0"), (void*)ebk);
                        this.collect_labels(fd.a, f);
                        this.push_scope();
                        switch (obj != (byte*)0)
                        {
                            case (true) {
                            off = 1;
                            this_ts = typespec_new();
                            this.keep((void*)this_ts);
                            this_ts.base_type = DataType.DATA;
                            this_ts.custom_typename = this.mod.own(obj);
                            this_ts.pointer_depth = 1;
                            f.args[0].spec = this_ts;



                            plain = true;
                            dd = 0;
                            while (obj[dd] != (byte)0)
                            {
                                switch (obj[dd] == (byte)'_' & obj[dd + 1] == (byte)'_')
                                {
                                    case (true) { plain = false; }
                                    default {};
                                };
                                dd++;
                            };
                            switch (!plain & !nm_has(f.names, g"this\0"))
                            {
                                case (true) {
                                this.mod.rename_arg(f, 0, g"this\0");
                                i = 0;
                                while (i < np)
                                {
                                    p = node_child(fd, 0, i);
                                    switch (p.text != (byte*)0)
                                    {
                                        case (true) { this.mod.rename_arg(f, i + 1, p.text); }
                                        default {
                                        this.sc.clear();
                                        this.sc.put_str(f"arg{i}\0");
                                        this.mod.rename_arg(f, i + 1, this.sc.mem);
                                    };
                                    };
                                    i++;
                                };
                            }
                                default {};
                            };
                            this.define_var(g"this\0", f.args[0], this_ts);
                        }
                            default {};
                        };
                        i = 0;
                        while (i < np)
                        {
                            p = node_child(fd, 0, i);
                            switch (p.text != (byte*)0)
                            {
                                case (true) { pname = p.text; }
                                default {
                                this.sc.clear();
                                this.sc.put_str(f"arg{i}\0");
                                pname = this.mod.own(this.sc.mem);
                            };
                            };
                            a = f.args[i + off];
                            this.sc.clear();
                            this.sc.put_str(f"{pname}.addr\0");
                            slot = this.mod.alloca(a.ty, this.sc.mem);
                            slot.spec = p.ts;
                            a.spec = p.ts;
                            this.mod.store(a, slot);
                            this.define_var(pname, slot, p.ts);
                            switch (p.ts != (TypeSpec*)0)
                            {
                                case (true) {
                                switch (p.ts.base_type == DataType.DICT)
                                {
                                    case (true) { this.dict_make(pname, p.ts, p.line); }
                                    default {};
                                };
                            }
                                default {};
                            };
                            i++;
                        };
                        switch ((fd.flags `& 2048) != 0)
                        {
                            case (true) {
                            this.va_list_v = this.mod.alloca(this.mod.t_array(this.t_i8p, 1), g"va_list\0");
                            this.va_list_p = this.mod.cast(g"bitcast\0", this.va_list_v, this.t_i8p, g"va_list_ptr\0");
                            this.mod.ia[0] = this.va_list_p;
                            this.mod.call(this.va_intrinsic(g"llvm.va_start\0", 1).self, this.mod.ia, 1, (byte*)0);
                        }
                            default {};
                        };
                        this.visit(fd.a);
                        this.pop_scope();
                        switch (this.bad)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch (!this.mod.is_terminated())
                                {
                                    case (true) {
                                    switch (obj != (byte*)0 & cstr_eq(fd.text, g"__init\0"))
                                    {
                                        case (true) { this.mod.ret(f.args[0]); }
                                        default {
                                            switch (this.fret.kind == LK.VOID)
                                            {
                                                case (true) {
                                                    switch (this.rec_fn) { case (true) { this.rec_call(false, (IRValue*)0); } default {}; };
                                                    this.mod.ret_void();
                                                }
                                                default {
                                                    switch (this.mod.cb.lines.len == 0)
                                                    {
                                                        case (true) { this.mod.unreachable(); }
                                                        default { this.unsup(fd, g"function must end with return\0"); };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                }
                                    default {};
                                };
                                ->;
                            };
                        };
                    };
                };
            };

            skip_exit() -> void
            {
                int i;
                while (i < this.skip_log.len)
                {
                    ffree((byte*)this.skip_log.items[i]);
                    i++;
                };
                pv_free(this.skip_log);
                ->;
            };


            log_skip(Node* fd) -> void
            {
                FvmBuf b;
                byte* t;
                b.__init();
                b.put_str(g"function '\0");
                if (fd.text != (byte*)0) { b.put_str(fd.text); };
                b.put_str(g"' line \0");
                b.put_i64((i64)this.bad_line);
                b.put_str(g": \0");
                if (this.bad_what != (byte*)0) { b.put_str(this.bad_what); };
                if (this.bad_detail != (byte*)0)
                {
                    b.put_str(g" '\0");
                    b.put_str(this.bad_detail);
                    b.put_str(g"'\0");
                };
                t = ts_dup(b.mem);
                b.__exit();
                pv_push(this.skip_log, (void*)t);
                ->;
            };


            run_body(Node* fd, IRFunc* f, byte* ns, byte* obj) -> void
            {
                int i;
                Node* pfd;
                byte* prev = this.cur_obj;
                this.set_ns(ns);
                switch (obj != (byte*)0)
                {
                    case (true) { this.cur_obj = this.mod.own(obj); }
                    default {};
                };
                pfd = this.cur_fd;
                this.cur_fd = fd;
                this.gen_body(fd, f, obj);
                this.cur_fd = pfd;
                this.cur_obj = prev;
                switch (this.bad)
                {
                    case (true) {
                    this.nskipped++;
                    f.is_decl = true;
                    this.log_skip(fd);
                }
                    default { this.nbodies++; };
                };

                switch (!this.tf_drain)
                {
                    case (true) {
                    this.tf_drain = true;
                    i = 0;
                    Node* sfd;
                    while (i < this.tf_pend.len)
                    {
                        sfd = (Node*)this.tf_pend.items[i];
                        node_child(sfd, 0, 0).ts = (TypeSpec*)this.tf_pend.items[i + 2];
                        this.run_body(sfd, (IRFunc*)this.tf_pend.items[i + 1], g"\0", (byte*)0);
                        i = i + 3;
                    };
                    this.tf_pend.len = 0;
                    this.tf_drain = false;
                }
                    default {};
                };
                ->;
            };


            object_bodies(Node* od, byte* ns) -> void
            {
                byte* oname;
                byte* mn;
                byte* full;
                Node* m;
                IRFunc* f;
                int i;
                switch (this.is_template(od))
                {
                    case (true) { ->; }
                    default
                    {
                        oname = mangle_namespace_name(ns, od.text);
                        while (i < node_count(od, 1))
                        {
                            m = node_child(od, 1, i);
                            i++;
                            switch (m.text == (byte*)0)
                            {
                                case (true) { continue; }
                                default
                                {
                                    switch ((m.flags `& 524288) != 0)
                                    {
                                        case (true) { continue; }
                                        default
                                        {
                                            switch ((m.flags `& 512) != 0)
                                            {
                                                case (true) { continue; }
                                                default
                                                {
                                                    switch (m.a == (Node*)0)
                                                    {
                                                        case (true) { continue; }
                                                        default
                                                        {
                                                            this.cur_obj = this.mod.own(oname);
                                                            mn = this.mangled_name(m.text, m);
                                                            this.cur_obj = (byte*)0;
                                                            full = join3(oname, g".\0", mn);
                                                            f = this.mod.find_function(full);
                                                            ffree(mn);
                                                            ffree(full);
                                                            switch (f == (IRFunc*)0)
                                                            {
                                                                case (true) { continue; }
                                                                default
                                                                {
                                                                    switch (!f.is_decl)
                                                                    {
                                                                        case (true) { continue; }
                                                                        default
                                                                        {
                                                                            this.run_body(m, f, ns, oname);
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        -> ffree(oname);
                    };
                };
            };


            dotted_body(Node* fd, byte* ns) -> void
            {
                byte* full = fd.text;
                byte* oname = this.dotted_object(fd, ns);
                byte* mn;
                byte* fn;
                IRFunc* f;
                byte* prev = this.cur_obj;
                fd.text = full + this.dot_index(full) + 1;
                this.cur_obj = this.mod.own(oname);
                mn = this.mangled_name(fd.text, fd);
                this.cur_obj = prev;
                fn = join3(oname, g".\0", mn);
                f = this.mod.find_function(fn);
                ffree(mn);
                ffree(fn);
                switch (f != (IRFunc*)0)
                {
                    case (true) {
                    switch (f.is_decl) { case (true) { this.run_body(fd, f, ns, oname); } default {}; };
                }
                    default {};
                };
                fd.text = full;
                -> ffree(oname);
            };


            bodies_pass(Node* n0, byte* ns) -> void
            {
                Node* n = this.unwrap(n0);
                int k = n.kind;
                int s, c, e, j;
                byte* full;
                IRFunc* f;
                byte* mn;
                byte* base;
                switch (k)
                {
                    case (NodeKind.FUNCTION_DEF)
                    {
                        switch (n.text == (byte*)0)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch ((n.flags `& 524288) != 0)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        switch ((n.flags `& 512) != 0)
                                        {
                                            case (true) { ->; }
                                            default
                                            {
                                                switch (n.a == (Node*)0)
                                                {
                                                    case (true) { ->; }
                                                    default
                                                    {
                                                        switch (this.dot_index(n.text) > 0)
                                                        {
                                                            case (true) { -> this.dotted_body(n, ns); }
                                                            default
                                                            {
                                                                base = mangle_namespace_name(ns, n.text);
                                                                switch ((n.flags `& 1024) != 0)
                                                                {
                                                                    case (true) { mn = ts_dup(base); }
                                                                    default { mn = this.mangled_name(base, n); };
                                                                };
                                                                f = this.mod.find_function(mn);
                                                                ffree(base);
                                                                ffree(mn);
                                                                switch (f == (IRFunc*)0)
                                                                {
                                                                    case (true) { ->; }
                                                                    default
                                                                    {
                                                                        switch (!f.is_decl)
                                                                        {
                                                                            case (true) { ->; }
                                                                            default
                                                                            {
                                                                                this.run_body(n, f, ns, (byte*)0);
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    }
                    case (NodeKind.OBJECT_DEF) { this.object_bodies(n, ns); }
                    case (NodeKind.EXPORT_BLOCK)
                    {
                        c = node_count(n, 0);
                        while (e < c)
                        {
                            this.bodies_pass(node_child(n, 0, e), ns);
                            e++;
                        };
                    }
                    case (NodeKind.NAMESPACE_DEF)
                    {
                        full = this.join_ns(ns, n.text);
                        this.set_ns(full);
                        while (j < 3)
                        {

                            switch (j)
                            {
                                case (0) { s = 7; }
                                case (1) { s = 0; }
                                default { s = 2; };
                            };
                            c = this.ns_count(n, s);
                            e = 0;
                            while (e < c)
                            {
                                this.bodies_pass(this.ns_child(n, s, e), full);
                                e++;
                            };
                            j++;
                        };
                        this.set_ns(ns);
                        ffree(full);
                    }
                    default {};
                };
                ->;
            };


            ifc_set(NameMap* table, byte* a, byte* b) -> NameMap*
            {
                byte* key = this.mod.own(join3(a, g"|\0", b));
                NameMap* set = (NameMap*)nm_get(table, key);
                switch (set == (NameMap*)0)
                {
                    case (true) {
                    set = nm_new();
                    nm_put(table, key, (void*)set);
                }
                    default {};
                };
                -> set;
            };


            ifc_find(Node* prog, byte* name) -> Node*
            {
                int i;
                Node* s;
                while (i < node_count(prog, 0))
                {
                    s = this.unwrap(node_child(prog, 0, i));
                    switch (s.kind == NodeKind.INTERFACE_DEF)
                    {
                        case (true) {
                        switch (cstr_eq(s.text, name))
                        {
                            case (true) { -> s; }
                            default {};
                        };
                    }
                        default {};
                    };
                    i++;
                };
                -> (Node*)0;
            };



            build_interfaces(Node* prog) -> void
            {
                int i, k, j, p, m;
                Node* od;
                Node* at;
                Node* idef;
                Node* pr;
                Node* prm;
                byte* caller;
                byte* callee;
                byte* arg;
                NameMap* set;
                NameMap* table;
                while (i < node_count(prog, 0))
                {
                    od = this.unwrap(node_child(prog, 0, i));
                    switch (od.kind == NodeKind.OBJECT_DEF & od.e != (Node*)0 & !this.is_template(od))
                    {
                        case (true) {
                        k = 0;
                        while (k < node_count(od.e, 0))
                        {
                            at = node_child(od.e, 0, k);
                            idef = this.ifc_find(prog, at.text);
                            switch (idef == (Node*)0)
                            {
                                case (true) {
                                this.fail(join3(g"Interface '\0", at.text, g"' attached to an object is not defined\0"), od.line);
                            }
                                default
                                {
                                    switch (node_count(at, 0) != node_count(idef, 0))
                                    {
                                        case (true) {
                                        this.fail(join3(g"Interface '\0", at.text, g"' is given the wrong number of arguments\0"), od.line);
                                    }
                                        default
                                        {

                                            p = 0;
                                            while (p < node_count(idef, 1))
                                            {
                                                pr = node_child(idef, 1, p);
                                                caller = (byte*)0;
                                                callee = (byte*)0;
                                                j = 0;
                                                while (j < node_count(idef, 0))
                                                {
                                                    prm = node_child(idef, 0, j);
                                                    arg = node_child(at, 0, j).text;
                                                    switch (cstr_eq(arg, g"this\0"))
                                                    {
                                                        case (true) { arg = od.text; }
                                                        default {};
                                                    };
                                                    switch (cstr_eq(prm.text, pr.text)) { case (true) { caller = arg; } default {}; };
                                                    switch (cstr_eq(prm.text, pr.text2)) { case (true) { callee = arg; } default {}; };
                                                    j++;
                                                };
                                                switch (caller != (byte*)0 & callee != (byte*)0)
                                                {
                                                    case (true) {
                                                    switch (pr.op)
                                                    {
                                                        case (ProtocolKind.CALL_ON) { table = this.ifc_call; }
                                                        case (ProtocolKind.PASS_INTO) { table = this.ifc_pass; }
                                                        default { table = this.ifc_ret; };
                                                    };
                                                    set = this.ifc_set(table, caller, callee);
                                                    m = 0;
                                                    while (m < node_count(pr, 0))
                                                    {
                                                        nm_put(set, node_child(pr, 0, m).text, (void*)set);
                                                        m++;
                                                    };
                                                }
                                                    default {};
                                                };
                                                p++;
                                            };
                                        };
                                    };
                                };
                            };
                            k++;
                        };
                    }
                        default {};
                    };
                    i++;
                };
                ->;
            };



            ifc_check_pass(Node* arg, byte* consumer) -> bool
            {
                LVar* lv;
                IRType* t;
                NameMap* set;


                switch (this.cur_obj == (byte*)0 | arg.kind != NodeKind.METHOD_CALL | arg.a == (Node*)0)
                {
                    case (true) { -> true; }
                    default {};
                };
                switch (arg.a.kind != NodeKind.IDENTIFIER)
                {
                    case (true) { -> true; }
                    default {};
                };
                lv = this.find_local(arg.a.text);
                switch (lv == (LVar*)0 | lv.ptr == (IRValue*)0 | lv.ptr.ty.kind != LK.PTR)
                {
                    case (true) { -> true; }
                    default {};
                };
                t = lv.ptr.ty.elem;
                switch (t.kind == LK.PTR)
                {
                    case (true) { t = t.elem; }
                    default {};
                };
                switch (t.kind != LK.ISTRUCT | t.name == (byte*)0)
                {
                    case (true) { -> true; }
                    default {};
                };
                set = (NameMap*)nm_get(this.ifc_pass, join3(t.name, g"|\0", consumer));
                switch (set != (NameMap*)0 & arg.text != (byte*)0)
                {
                    case (true) {
                    switch (!nm_has(set, arg.text))
                    {
                        case (true) {
                        this.sc.clear();
                        this.sc.put_str(f"Interface violation: return value of '{t.name}.{arg.text}' is not permitted to be passed as an argument into '{consumer}' [{arg.line}:{arg.col}]\0");
                        this.fail_at(arg, this.sc.mem);
                        -> false;
                    }
                        default {};
                    };
                }
                    default {};
                };
                -> true;
            };


            ifc_check_call(Node* n, byte* callee, byte* meth) -> bool
            {
                NameMap* rset;
                NameMap* cset;
                bool allowed;
                switch (this.cur_obj == (byte*)0 | callee == (byte*)0)
                {
                    case (true) { -> true; }
                    default {};
                };
                rset = (NameMap*)nm_get(this.ifc_ret, join3(callee, g"|\0", this.cur_obj));
                switch (rset != (NameMap*)0)
                {
                    case (true) {
                    allowed = nm_has(rset, meth);
                    switch (!allowed)
                    {
                        case (true) {
                        this.sc.clear();
                        this.sc.put_str(f"Interface violation: '{callee}.{meth}' is not permitted to be called from inside '{this.cur_obj}' [{n.line}:{n.col}]\0");
                        this.fail_at(n, this.sc.mem);
                        -> false;
                    }
                        default {};
                    };
                }
                    default {};
                };
                switch (!allowed)
                {
                    case (true) {
                    cset = (NameMap*)nm_get(this.ifc_call, join3(this.cur_obj, g"|\0", callee));
                    switch (cset != (NameMap*)0)
                    {
                        case (true) {
                        switch (!nm_has(cset, meth))
                        {
                            case (true) {
                            this.sc.clear();
                            this.sc.put_str(f"Interface violation: {this.cur_obj} is not permitted to call {meth} from {callee} [{n.line}:{n.col}]\0");
                            this.fail_at(n, this.sc.mem);
                            -> false;
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                }
                    default {};
                };
                -> true;
            };








            ct_exit() -> void
            {
                int i;
                FVMCodegen* c;
                Lexer* sl;
                Parser* sp;
                while (i < this.ct_nodes.len)
                {
                    node_free((Node*)this.ct_nodes.items[i]);
                    i++;
                };
                pv_free(this.ct_nodes);
                i = 0;
                while (i < this.ct_persist.len)
                {
                    ffree((byte*)this.ct_persist.items[i]);
                    i++;
                };
                pv_free(this.ct_persist);
                nm_free(this.ct_pidx);
                this.refl_drop();
                pv_free(this.ct_refl_mem);
                pv_free(this.ct_refl_vec);
                pv_free(this.ct_cck);
                pv_free(this.ct_ccv);
                if (this.ct_vm != (IDEKAVM*)0)
                {
                    this.ct_vm.__exit();
                    ffree((byte*)this.ct_vm);
                };
                i = 0;
                while (i < this.ct_cgs.len)
                {
                    c = (FVMCodegen*)this.ct_cgs.items[i];
                    c.__exit();
                    ffree((byte*)c);
                    i++;
                };
                pv_free(this.ct_cgs);
                i = 0;
                while (i < this.ct_par.len)
                {
                    sp = (Parser*)this.ct_par.items[i];
                    if (sp.st != (IDKC_SYMTABLE*)0) { st_free(sp.st); };
                    sp.__exit();
                    ffree((byte*)sp);
                    i++;
                };
                pv_free(this.ct_par);
                i = 0;
                while (i < this.ct_lex.len)
                {
                    sl = (Lexer*)this.ct_lex.items[i];
                    sl.__exit();
                    ffree((byte*)sl);
                    i++;
                };
                pv_free(this.ct_lex);
                ->;
            };


            ct_count(byte* what, i64 n) -> void
            {
                i64* box = (i64*)nm_get(this.ucounts, what);
                if (box == (i64*)0)
                {
                    box = (i64*)fmalloc((u64)8);
                    this.keep((void*)box);
                    *box = (i64)0;
                    nm_put(this.ucounts, what, (void*)box);
                };
                *box = *box + n;
                ->;
            };


            ct_note(FVMCodegen* c) -> void
            {
                int i;
                while (i < c.ucounts.count)
                {
                    this.ct_count((byte*)c.ucounts.keys[i], *(i64*)c.ucounts.vals[i]);
                    i++;
                };
                ->;
            };





            refl_drop() -> void
            {
                int i;
                while (i < this.ct_refl_mem.len)
                {
                    ffree((byte*)this.ct_refl_mem.items[i]);
                    i++;
                };
                this.ct_refl_mem.len = 0;
                this.ct_refl_vec.len = 0;
                ->;
            };


            refl_storage(int sc) -> byte*
            {
                switch (sc)
                {
                    case (StorageClass.AUTO)     { -> g"auto\0"; }
                    case (StorageClass.STACK)    { -> g"stack\0"; }
                    case (StorageClass.HEAP)     { -> g"heap\0"; }
                    case (StorageClass.GLOBAL)   { -> g"global\0"; }
                    case (StorageClass.LOCAL)    { -> g"local\0"; }
                    case (StorageClass.REGISTER) { -> g"register\0"; }
                    case (StorageClass.SINGINIT) { -> g"singinit\0"; }
                    default                      { -> (byte*)0; };
                };
                -> (byte*)0;
            };


            refl_ts_text(TypeSpec* t) -> byte*
            {
                if (t == (TypeSpec*)0) { -> (byte*)0; };
                if (t.custom_typename != (byte*)0) { -> t.custom_typename; };
                -> datatype_text(t.base_type);
            };


            refl_ty(FvmReflTy* o, TypeSpec* t) -> void
            {
                if (t == (TypeSpec*)0) { ->; };
                o.base_type = datatype_text(t.base_type);
                o.custom = t.custom_typename;
                if (t.storage_class >= 0) { o.storage = this.refl_storage(t.storage_class); };
                o.pdepth = t.pointer_depth;
                if (t.bit_width > 0) { o.bits = t.bit_width; };
                if (t.alignment > 0) { o.align = t.alignment; };
                o.endian = t.endianness;
                o.is_signed = (t.flags `& 1) != 0;
                o.is_const = (t.flags `& 2) != 0;
                o.is_volatile = (t.flags `& 4) != 0;
                o.is_tied = (t.flags `& 8) != 0;
                o.is_pointer = (t.flags `& 64) != 0;
                o.is_array = (t.flags `& 32) != 0;
                o.is_dict = t.base_type == DataType.DICT;
                if (t.array_size != (Node*)0)
                {
                    if (t.array_size.kind == NodeKind.LITERAL) { o.asize = (int)t.array_size.ival; };
                };
                o.dkey = this.refl_ts_text(t.dict_key);
                o.dval = this.refl_ts_text(t.dict_value);
                ->;
            };


            refl_join(byte* ns, byte* name) -> byte*
            {
                int a = pp_cstrlen(ns);
                int b = pp_cstrlen(name);
                int i, j;
                byte* r = (byte*)fmalloc((u64)(a + b + 3));
                while (i < a)
                {
                    r[i] = ns[i];
                    i++;
                };
                r[i] = ':';
                r[i + 1] = ':';
                i = i + 2;
                while (j < b)
                {
                    r[i + j] = name[j];
                    j++;
                };
                r[i + b] = (byte)0;
                pv_push(this.ct_refl_mem, (void*)r);
                -> r;
            };


            refl_add(PtrVec* out, byte* name, byte* kind, byte* ns, TypeSpec* ts, Node* fn) -> void
            {
                FvmRefl* r = (FvmRefl*)fvm_alloc((int)(sizeof(FvmRefl) / 8));
                FvmReflFn* f;
                Node* p;
                int i, np;
                pv_push(this.ct_refl_mem, (void*)r);
                r.name = name;
                r.kind = kind;
                r.ns = ns;
                this.refl_ty(@r.ty, ts);
                if (fn != (Node*)0)
                {
                    f = (FvmReflFn*)fvm_alloc((int)(sizeof(FvmReflFn) / 8));
                    pv_push(this.ct_refl_mem, (void*)f);
                    np = node_count(fn, 0);
                    f.nparams = np;
                    f.params = (FvmReflParam*)fvm_alloc(np * (int)(sizeof(FvmReflParam) / 8) + 1);
                    pv_push(this.ct_refl_mem, (void*)f.params);
                    while (i < np)
                    {
                        p = node_child(fn, 0, i);
                        f.params[i].name = p.text;
                        this.refl_ty(@f.params[i].ty, p.ts);
                        i++;
                    };
                    this.refl_ty(@f.ret, fn.ts);
                    f.cc = fn.text2;
                    f.variadic = (fn.flags `& 2048) != 0;
                    f.recursive = (fn.flags `& 4096) != 0;
                    f.inl = (fn.flags `& 8192) != 0;
                    f.nomangle = (fn.flags `& 1024) != 0;
                    f.has_eff = fn.b != (Node*)0;
                    f.has_att = fn.c != (Node*)0;
                    f.pre = (int)fn.ival;
                    f.post = fn.op;
                    r.fn = f;
                };
                pv_push(out, (void*)r);
                ->;
            };


            refl_ns(PtrVec* out, Node* nsd, byte* ns) -> void
            {
                byte* full = nsd.text;
                Node* x;
                Node* l;
                int i, n, k;
                if (ns[0] != 0) { full = this.refl_join(ns, nsd.text); };
                this.refl_add(out, nsd.text, g"namespace\0", ns, (TypeSpec*)0, (Node*)0);
                n = node_count(nsd, 0);
                while (i < n)
                {
                    x = node_child(nsd, 0, i);
                    this.refl_add(out, x.text, g"function\0", full, x.ts, x);
                    i++;
                };
                i = 0;
                n = node_count(nsd, 1);
                while (i < n)
                {
                    x = node_child(nsd, 1, i);
                    this.refl_add(out, x.text, g"struct\0", full, (TypeSpec*)0, (Node*)0);
                    i++;
                };
                i = 0;
                n = node_count(nsd, 2);
                while (i < n)
                {
                    x = node_child(nsd, 2, i);
                    this.refl_add(out, x.text, g"object\0", full, (TypeSpec*)0, (Node*)0);
                    i++;
                };
                i = 0;
                n = node_count(nsd, 3);
                while (i < n)
                {
                    x = node_child(nsd, 3, i);
                    this.refl_add(out, x.text, g"enum\0", full, (TypeSpec*)0, (Node*)0);
                    i++;
                };
                i = 0;
                n = node_count(nsd, 4);
                while (i < n)
                {
                    x = node_child(nsd, 4, i);
                    this.refl_add(out, x.text, g"union\0", full, (TypeSpec*)0, (Node*)0);
                    i++;
                };
                i = 0;
                n = node_count(nsd, 5);
                while (i < n)
                {
                    l = node_child(nsd, 5, i);
                    k = 0;
                    while (k < node_count(l, 0))
                    {
                        x = node_child(l, 0, k);
                        this.refl_add(out, x.text, g"function\0", full, x.ts, x);
                        k++;
                    };
                    i++;
                };
                if (nsd.a != (Node*)0)
                {
                    i = 0;
                    n = node_count(nsd.a, 0);
                    while (i < n)
                    {
                        x = node_child(nsd.a, 0, i);
                        this.refl_add(out, x.text, g"variable\0", full, x.ts, (Node*)0);
                        i++;
                    };
                };
                if (nsd.b != (Node*)0)
                {
                    i = 0;
                    n = node_count(nsd.b, 0);
                    while (i < n)
                    {
                        this.refl_ns(out, node_child(nsd.b, 0, i), full);
                        i++;
                    };
                };
                ->;
            };




            ct_reflect(IDEKAVM* vm) -> void
            {
                PtrVec* out = pv_new();
                PtrVec* k = pv_new();
                PtrVec* v = pv_new();
                Node* s;
                Node* x;
                int i, n, j;
                byte* e = ts_dup(g"\0");
                this.refl_drop();
                pv_push(this.ct_refl_mem, (void*)e);
                if (this.ct_pstmts != (NodeVec*)0)
                {
                    n = this.ct_pstmts.len;
                    if (this.ct_top_i >= 0 & this.ct_top_i < n) { n = this.ct_top_i; };
                    while (i < n)
                    {
                        s = this.ct_pstmts.items[i];
                        if (s.kind == NodeKind.FUNCTION_DEF_STATEMENT | s.kind == NodeKind.STRUCT_DEF_STATEMENT | s.kind == NodeKind.OBJECT_DEF_STATEMENT | s.kind == NodeKind.UNION_DEF_STATEMENT | s.kind == NodeKind.ENUM_DEF_STATEMENT | s.kind == NodeKind.NAMESPACE_DEF_STATEMENT)
                        {
                            s = s.a;
                        };
                        switch (s.kind)
                        {
                            case (NodeKind.FUNCTION_DEF)  { this.refl_add(out, s.text, g"function\0", e, s.ts, s); }
                            case (NodeKind.STRUCT_DEF)    { this.refl_add(out, s.text, g"struct\0", e, (TypeSpec*)0, (Node*)0); }
                            case (NodeKind.OBJECT_DEF)    { this.refl_add(out, s.text, g"object\0", e, (TypeSpec*)0, (Node*)0); }
                            case (NodeKind.UNION_DEF)     { this.refl_add(out, s.text, g"union\0", e, (TypeSpec*)0, (Node*)0); }
                            case (NodeKind.ENUM_DEF)      { this.refl_add(out, s.text, g"enum\0", e, (TypeSpec*)0, (Node*)0); }
                            case (NodeKind.TRAIT_DEF)     { this.refl_add(out, s.text, g"trait\0", e, (TypeSpec*)0, (Node*)0); }
                            case (NodeKind.INTERFACE_DEF) { this.refl_add(out, s.text, g"interface\0", e, (TypeSpec*)0, (Node*)0); }
                            case (NodeKind.NAMESPACE_DEF) { this.refl_ns(out, s, e); }
                            case (NodeKind.EXTERN_BLOCK)
                            {
                                j = 0;
                                while (j < node_count(s, 0))
                                {
                                    x = node_child(s, 0, j);
                                    this.refl_add(out, x.text, g"function\0", e, x.ts, x);
                                    j++;
                                };
                            }
                            case (NodeKind.VARIABLE_DECLARATION) { this.refl_add(out, s.text, g"variable\0", e, s.ts, (Node*)0); }
                            case (NodeKind.EFFECT_DEF)    { this.refl_add(out, s.text, g"effect\0", e, (TypeSpec*)0, (Node*)0); }
                            case (NodeKind.CONTRACT_DEF)  { this.refl_add(out, s.text, g"contract\0", e, (TypeSpec*)0, (Node*)0); }
                            case (NodeKind.CONSTRA_DEF)   { this.refl_add(out, s.text, g"constraint\0", e, (TypeSpec*)0, (Node*)0); }
                            default {};
                        };
                        i++;
                    };
                };
                pv_free(this.ct_refl_vec);
                this.ct_refl_vec = out;
                vm.refl = out;
                i = 0;
                if (this.pp_consts != (SymTab*)0)
                {
                    while (i < this.pp_consts.count)
                    {
                        if (this.pp_consts.par_count(i) == 0)
                        {
                            pv_push(k, (void*)(this.pp_consts.keys.mem + this.pp_consts.ents[i * 8]));
                            pv_push(v, (void*)this.pp_consts.val_ptr(i));
                        };
                        i++;
                    };
                };
                pv_free(this.ct_cck);
                pv_free(this.ct_ccv);
                this.ct_cck = k;
                this.ct_ccv = v;
                vm.cc_k = k;
                vm.cc_v = v;
                ->;
            };

            ct_finish() -> void
            {
                int i;
                if (this.ct_vm == (IDEKAVM*)0) { ->; };
                while (i < this.ct_vm.stubs.n)
                {
                    this.ct_count(this.ct_vm.stubs.names[i], (i64)this.ct_vm.stubs.counts[i]);
                    i++;
                };
                ->;
            };


            ct_persist_put(byte* name, int tag, i64 d, i64 m) -> void
            {
                FvmCap* c = (FvmCap*)nm_get(this.ct_pidx, name);
                if (c == (FvmCap*)0)
                {
                    c = (FvmCap*)fmalloc((u64)((sizeof(FvmCap) + 7) / 8));
                    c.name = ts_dup(name);
                    nm_put(this.ct_pidx, name, (void*)c);
                    pv_push(this.ct_persist, (void*)c);
                };
                c.tag = tag;
                c.d = d;
                c.m = m;
                ->;
            };


            ct_fail(Node* n, byte* what, byte* msg) -> void
            {
                FvmBuf b;
                b.__init();
                b.put_str(what);
                b.put_str(msg);
                b.put(0);
                this.fail_at(n, b.mem);
                b.__exit();
                ->;
            };



            ct_parse(Node* at, byte* text, PtrVec* out) -> bool
            {
                int n = fvm_strlen(text);
                byte* t = ts_dup(text);
                Lexer* sl = (Lexer*)fmalloc((u64)((sizeof(Lexer) + 7) / 8));
                Parser* sp;
                Node* stmt;
                Buf eb;
                FvmBuf mb;
                int k;
                this.keep((void*)t);
                sl.__init(t, n);
                pv_push(this.ct_lex, (void*)sl);
                if (!sl.tokenize())
                {
                    this.ct_fail(at, g"comptime emitideka parse failed: \0", IDEKA::lexer::error_message(sl.err_code));
                    -> false;
                };
                sp = (Parser*)fmalloc((u64)((sizeof(Parser) + 7) / 8));
                sp.__init(sl);
                pv_push(this.ct_par, (void*)sp);
                sp.st = st_new();
                sp.toks = sl.tokens;
                sp.count = sl.count;
                sp.pos = 0;
                while (!sp.failed & !sp.expect(TokenType.EOF))
                {
                    stmt = sp.statement();
                    if (sp.failed) { break; };
                    if (stmt != (Node*)0) { pv_push(out, (void*)stmt); };
                    k = 0;
                    while (k < sp.pending.len)
                    {
                        pv_push(out, sp.pending.items[k]);
                        k++;
                    };
                    sp.pending.len = 0;
                };
                if (sp.failed)
                {
                    eb.__init();
                    sp.render_error(@eb);
                    mb.__init();
                    mb.put_str(eb.mem);
                    mb.put_str(g"\n  emitted text: \0");
                    mb.put_str(text);
                    mb.put(0);
                    this.ct_fail(at, g"comptime emitideka parse failed: \0", mb.mem);
                    mb.__exit();
                    eb.__exit();
                    -> false;
                };
                -> true;
            };




            ct_basename(byte* p) -> byte*
            {
                byte* r = p;
                int i = 0;
                while (p[i] != 0)
                {
                    switch (p[i] == '/' | p[i] == '\\') { case (true) { r = p + i + 1; } default {}; };
                    i++;
                };
                -> r;
            };



            ct_line_of(byte* text, int n, int ln, FvmBuf* out, int* indent) -> bool
            {
                int cur = 1;
                int i = 0;
                int ls;
                int le;
                int st;
                int en;
                while (i < n & cur < ln)
                {
                    switch (text[i] == 10) { case (true) { cur++; } default {}; };
                    i++;
                };
                switch (cur != ln | ln < 1) { case (true) { -> false; } default {}; };
                ls = i;
                le = i;
                while (le < n & text[le] != 10) { le++; };
                st = ls;
                while (st < le & (text[st] == 32 | text[st] == 9 | text[st] == 13)) { st++; };
                en = le;
                while (en > st & (text[en - 1] == 32 | text[en - 1] == 9 | text[en - 1] == 13)) { en--; };
                *indent = st - ls;
                out.put_n(text + st, en - st);
                -> true;
            };


            ct_src_line(byte* path, int ln, FvmBuf* out, int* indent) -> bool
            {
                Buf fb;
                bool r;
                fb.__init();
                switch (fb.load_file(path) < 0) { case (true) { fb.__exit(); -> false; } default {}; };
                r = this.ct_line_of(fb.mem, fb.len, ln, out, indent);
                fb.__exit();
                -> r;
            };



            ct_loc_at(byte* s, int i, int* a, int* b, int* e) -> bool
            {
                int j = i + 1;
                int va = 0;
                int vb = 0;
                switch (s[i] != '[') { case (true) { -> false; } default {}; };
                switch (!(s[j] >= '0' & s[j] <= '9')) { case (true) { -> false; } default {}; };
                while (s[j] >= '0' & s[j] <= '9') { va = va * 10 + (int)(s[j] - '0'); j++; };
                switch (s[j] != ':') { case (true) { -> false; } default {}; };
                j++;
                switch (!(s[j] >= '0' & s[j] <= '9')) { case (true) { -> false; } default {}; };
                while (s[j] >= '0' & s[j] <= '9') { vb = vb * 10 + (int)(s[j] - '0'); j++; };
                switch (s[j] != ']') { case (true) { -> false; } default {}; };
                *a = va;
                *b = vb;
                *e = j + 1;
                -> true;
            };



            ct_fx_in_msg(byte* msg, FvmBuf* out) -> bool
            {
                int i = 0;
                int j;
                int e;
                int best;
                while (msg[i] != 0)
                {
                    switch (msg[i] == '[')
                    {
                        case (true)
                        {
                            e = i + 1;
                            while (msg[e] != 0 & msg[e] != ']') { e++; };
                            best = -1;
                            j = i + 2;
                            while (j + 3 <= e)
                            {
                                switch (msg[j] == '.' & msg[j + 1] == 'f' & msg[j + 2] == 'x' & msg[j + 3] == ':') { case (true) { best = j; } default {}; };
                                j++;
                            };
                            switch (best >= 0)
                            {
                                case (true)
                                {
                                    out.put_n(msg + i + 1, best + 3 - (i + 1));
                                    -> true;
                                }
                                default {};
                            };
                        }
                        default {};
                    };
                    i++;
                };
                -> false;
            };



            ct_import_fail(Node* at, int kind, byte* path, byte* msg) -> void
            {
                FvmBuf b;
                FvmBuf real;
                b.__init();
                real.__init();
                b.put_str(msg);
                switch (kind == 1)
                {
                    case (true)
                    {
                        b.put_str(g" (stdlib: \0");
                        switch (this.ct_fx_in_msg(msg, @real))
                        {
                            case (true) { real.put(0); b.put_str(this.ct_basename(real.mem)); }
                            default { b.put_str(path); };
                        };
                        b.put(41);
                    }
                    default
                    {
                        b.put_str(g" (local: \0");
                        b.put_str(path);
                        b.put(41);
                    };
                };
                b.put(0);
                this.ct_fail(at, g"comptime execution failed: \0", b.mem);
                real.__exit();
                b.__exit();
                ->;
            };




            ct_import(Node* at, IDEKAVM* vm, int kind, byte* path) -> bool
            {
                FvmBuf m;           
                FvmBuf tn;          
                FvmBuf wr;          
                FvmBuf tx;
                Buf eb;
                Lexer* sl;
                Parser* sp;
                PtrVec* stmts;
                Node* stmt;
                byte* t;
                byte* src;
                byte* sdir;
                void* fh;
                int i;
                int k;
                int n;
                int ln;
                int col;
                int indent;
                bool ok;
                m.__init();
                tn.__init();
                wr.__init();
                tx.__init();
                this.ct_imports++;
                switch (kind == 1)
                {
                    case (true) { wr.put_str(g"#import <\0"); wr.put_str(path); wr.put_str(g">;\n\0"); }
                    default { wr.put_str(g"#import \"\0"); wr.put_str(path); wr.put_str(g"\";\n\0"); };
                };



                switch (kind == 2 & this.ct_srcfile != (byte*)0)
                {
                    case (true)
                    {
                        k = -1;
                        i = 0;
                        while (this.ct_srcfile[i] != 0)
                        {
                            switch (this.ct_srcfile[i] == '/' | this.ct_srcfile[i] == '\\') { case (true) { k = i; } default {}; };
                            i++;
                        };
                        switch (k >= 0)
                        {
                            case (true) { tn.put_n(this.ct_srcfile, k + 1); }
                            default {};
                        };
                    }
                    default {};
                };
                tn.put_str(g"__ct_import_\0");
                tn.put_int(this.ct_imports);
                tn.put_str(g".idk\0");
                fh = fopen(tn.mem, g"wb\0");
                switch (fh == (void*)0)
                {
                    case (true)
                    {
                        m.put_str(g"compiler.import: cannot write '\0");
                        m.put_str(tn.mem);
                        m.put_str(g"'\0");
                        m.put(0);
                        this.ct_import_fail(at, kind, path, m.mem);
                        m.__exit(); tn.__exit(); wr.__exit(); tx.__exit();
                        -> false;
                    }
                    default {};
                };
                fwrite(wr.mem, 1, wr.len, fh);
                fclose(fh);

                Preprocessor pp(tn.mem);
                defer pp.__exit();
                sdir = getenv(g"IDEKA_SRCDIR\0");
                switch (sdir != (byte*)0) { case (true) { pp.set_srcdir(sdir); } default {}; };

                switch (this.pp_consts != (SymTab*)0)
                {
                    case (true)
                    {
                        i = 0;
                        while (i < this.pp_consts.count)
                        {
                            switch (this.pp_consts.par_count(i) == 0)
                            {
                                case (true) { pp.define(this.pp_consts.keys.mem + this.pp_consts.ents[i * 8], this.pp_consts.val_ptr(i)); }
                                default {};
                            };
                            i++;
                        };
                    }
                    default {};
                };
                ok = pp.process();
                remove(tn.mem);
                switch (!ok)
                {
                    case (true)
                    {
                        m.put_str(g"compiler.import: \0");
                        m.put_str(pp.err_text());
                        m.put(0);
                        this.ct_import_fail(at, kind, path, m.mem);
                        m.__exit(); tn.__exit(); wr.__exit(); tx.__exit();
                        -> false;
                    }
                    default {};
                };


                n = pp.text_len();
                i = 0;
                while (i < n & (pp.text_ptr()[i] == 32 | pp.text_ptr()[i] == 9 | pp.text_ptr()[i] == 10 | pp.text_ptr()[i] == 13)) { i++; };
                switch (i >= n)
                {
                    case (true) { m.__exit(); tn.__exit(); wr.__exit(); tx.__exit(); -> true; }
                    default {};
                };

                t = ts_dup(pp.text_ptr());
                this.keep((void*)t);
                sl = (Lexer*)fmalloc((u64)((sizeof(Lexer) + 7) / 8));
                sl.__init(t, n);
                pv_push(this.ct_lex, (void*)sl);
                switch (!sl.tokenize())
                {
                    case (true)
                    {
                        this.ct_fail(at, g"comptime execution failed: \0", IDEKA::lexer::error_message(sl.err_code));
                        m.__exit(); tn.__exit(); wr.__exit(); tx.__exit();
                        -> false;
                    }
                    default {};
                };
                sp = (Parser*)fmalloc((u64)((sizeof(Parser) + 7) / 8));
                sp.__init(sl);
                pv_push(this.ct_par, (void*)sp);
                sp.st = st_new();
                sp.toks = sl.tokens;
                sp.count = sl.count;
                sp.pos = 0;
                stmts = pv_new();
                while (!sp.failed & !sp.expect(TokenType.EOF))
                {
                    stmt = sp.statement();
                    switch (sp.failed) { case (true) { break; } default {}; };
                    switch (stmt != (Node*)0) { case (true) { pv_push(stmts, (void*)stmt); } default {}; };
                    k = 0;
                    while (k < sp.pending.len)
                    {
                        pv_push(stmts, sp.pending.items[k]);
                        k++;
                    };
                    sp.pending.len = 0;
                };
                switch (sp.failed)
                {
                    case (true)
                    {
                        eb.__init();
                        sp.render_error(@eb);
                        this.ct_fail(at, g"comptime execution failed: \0", eb.mem);
                        eb.__exit();
                        m.__exit(); tn.__exit(); wr.__exit(); tx.__exit();
                        -> false;
                    }
                    default {};
                };

                heap FVMCodegen c;
                c.__init();
                pv_push(this.ct_cgs, (void*)c);
                ok = c.compile_import(stmts, vm);
                switch (c.failed)
                {
                    case (true)
                    {


                        c.errb.put(0);
                        ln = -1;
                        col = -1;
                        i = 0;
                        while (c.errb.mem[i] != 0 & ln < 0)
                        {
                            switch (this.ct_loc_at(c.errb.mem, i, @ln, @col, @k)) { case (true) { break; } default { ln = -1; }; };
                            i++;
                        };
                        m.put_str(g"compiler.import (compiling imported declarations): \0");

                        i = 0;
                        while (c.errb.mem[i] != 0)
                        {
                            if (c.errb.mem[i] == 32 & this.ct_loc_at(c.errb.mem, i + 1, @k, @indent, @n))
                            {
                                i = n;
                            }
                            else
                            {
                                m.put((int)c.errb.mem[i]);
                                i++;
                            };
                        };
                        m.put_str(g" [\0");
                        tx.clear();
                        indent = 0;
                        ok = false;
                        switch (ln >= 1 & ln <= pp.map_line.len)
                        {
                            case (true)
                            {
                                m.put_str(this.ct_basename(pp.line_files()[ln - 1]));
                                k = pp.map_line.arr[ln - 1];
                                ok = this.ct_src_line(pp.line_files()[ln - 1], k, @tx, @indent);
                                switch (!ok) { case (true) { ok = this.ct_line_of(pp.text_ptr(), pp.text_len(), k, @tx, @indent); } default {}; };
                            }
                            default
                            {
                                m.put_str(path);
                                k = ln;
                                switch (ln >= 1) { case (true) { ok = this.ct_line_of(pp.text_ptr(), pp.text_len(), ln, @tx, @indent); } default {}; };
                            };
                        };
                        m.put(58);
                        switch (ln >= 1) { case (true) { m.put_int(k); } default { m.put_str(g"None\0"); }; };
                        m.put(58);
                        switch (ln >= 1) { case (true) { m.put_int(col); } default { m.put_str(g"None\0"); }; };
                        m.put(93);
                        switch (ln >= 1 & ok)
                        {
                            case (true)
                            {
                                m.put_str(g"\n\t\0");
                                m.put_n(tx.mem, tx.len);
                                m.put_str(g"\n\t\0");
                                k = (col - 1) - indent;
                                switch (k < 0) { case (true) { k = 0; } default {}; };
                                while (k > 0) { m.put(32); k--; };
                                m.put(94);
                            }
                            default {};
                        };
                        m.put(0);
                        this.ct_import_fail(at, kind, path, m.mem);
                        m.__exit(); tn.__exit(); wr.__exit(); tx.__exit();
                        -> false;
                    }
                    default {};
                };
                switch (!ok) { case (true) { this.ct_note(c); } default {}; };
                switch (!c.register_new_functions(vm))
                {
                    case (true)
                    {
                        this.ct_fail(at, g"comptime: \0", g"instruction pool allocation failed\0");
                        m.__exit(); tn.__exit(); wr.__exit(); tx.__exit();
                        -> false;
                    }
                    default {};
                };
                c.collect_externs(vm);
                switch (!c.lay_merge_into(@vm.layouts))
                {
                    case (true)
                    {
                        this.ct_fail(at, g"comptime: \0", g"struct layout allocation failed\0");
                        m.__exit(); tn.__exit(); wr.__exit(); tx.__exit();
                        -> false;
                    }
                    default {};
                };
                m.__exit(); tn.__exit(); wr.__exit(); tx.__exit();
                -> true;
            };




            ct_run(Node* n, PtrVec* out) -> int
            {
                IDEKAVM* vm;
                FvmBuf tb;
                FvmCap* cap;
                i64* sbox;
                byte* nm;
                int i;
                int u;
                int es;
                int hk;
                int slot;
                int tag;
                bool ok;
                this.ct_runs++;
                if (this.ct_runs > 10000)
                {
                    this.ct_fail(n, g"comptime: \0", g"too many comptime blocks, emitideka is expanding itself\0");
                    -> 2;
                };
                if (this.ct_vm == (IDEKAVM*)0)
                {

                    heap IDEKAVM nvm;
                    this.ct_vm = nvm;
                    this.ct_vm.__init();
                };
                vm = this.ct_vm;
                heap FVMCodegen c;
                c.__init();
                pv_push(this.ct_cgs, (void*)c);
                c.lay_copy_from(@vm.layouts);
                c.pstmts = this.ct_pstmts;
                i = 0;
                while (i < this.ct_enums.len)
                {
                    c.enum_seed((Node*)this.ct_enums.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.ct_macros.len)
                {
                    c.macro_seed((Node*)this.ct_macros.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.al_names.len)
                {
                    c.alias_seed((byte*)this.al_names.items[i], (TypeSpec*)this.al_specs.items[i]);
                    i++;
                };



                i = 0;
                while (i < this.ct_persist.len)
                {
                    cap = (FvmCap*)this.ct_persist.items[i];
                    c.capture(cap.name, cap.tag, cap.d, cap.m);
                    i++;
                };
                i = 0;
                while (i < vm.funcs.n)
                {
                    c.known_add(vm.funcs.names[i]);
                    i++;
                };
                i = 0;
                while (i < vm.gn)
                {
                    c.capture(vm.g_name[i], vm.g_tag[i], vm.g_data[i], vm.g_meta[i]);
                    i++;
                };
                i = 0;
                while (i < this.consts.count)
                {
                    c.capture((byte*)this.consts.keys[i], 0, *(i64*)this.consts.vals[i], (i64)0);
                    i++;
                };
                i = 0;
                if (this.pp_consts != (SymTab*)0)
                {
                    while (i < this.pp_consts.count)
                    {
                        if (this.pp_consts.par_count(i) == 0)
                        {
                            c.capture_macro(this.pp_consts.keys.mem + this.pp_consts.ents[i * 8], this.pp_consts.val_ptr(i));
                        };
                        i++;
                    };
                };

                if (!c.compile_comptime(n))
                {
                    this.ct_note(c);
                    if (c.failed)
                    {
                        c.errb.put(0);
                        this.pend_col = n.col;
                        this.ct_fail(n, g"comptime codegen failed: \0", c.errb.mem);
                        -> 2;
                    };
                    -> 1;
                };
                if (!c.register_functions(vm))
                {
                    this.ct_fail(n, g"comptime: \0", g"instruction pool allocation failed\0");
                    -> 2;
                };
                if (!c.lay_merge_into(@vm.layouts))
                {
                    this.ct_fail(n, g"comptime: \0", g"struct layout allocation failed\0");
                    -> 2;
                };
                u = vm.import_unit(@c.code, c.unit);
                if (u < 0)
                {
                    this.ct_fail(n, g"comptime: \0", g"instruction pool allocation failed\0");
                    -> 2;
                };
                this.ct_reflect(vm);
                es = vm.emit_count;
                ok = vm.execute(u, c.nlocals);

                while (ok & vm.host_kind != 0)
                {
                    hk = vm.host_kind;
                    if (!this.ct_import(n, vm, hk, vm.host_arg)) { -> 2; };
                    ok = vm.resume();
                };
                if (!ok)
                {
                    this.ct_fail(n, g"comptime execution failed: \0", vm.err_text());
                    -> 2;
                };


                i = 0;
                while (i < c.lnames.len)
                {
                    nm = (byte*)c.lnames.items[i];
                    sbox = (i64*)nm_get(c.locals, nm);
                    if (!(nm[0] == '_' & nm[1] == '_') & sbox != (i64*)0)
                    {
                        slot = (int)*sbox;
                        tag = vm.lc_tag[slot];
                        if (tag == 0 | tag == 1 | tag == 2 | tag == 3 | tag == 4 | tag == 5 | tag == 6 | tag == 7 | tag == 8 | tag == 9 | tag == 10)
                        {
                            this.ct_persist_put(nm, tag, vm.lc_data[slot], vm.lc_meta[slot]);
                        };
                    };
                    i++;
                };


                tb.__init();
                i = es;
                while (i < vm.emit_count)
                {
                    if (vm.e_kind[i] == 3)
                    {
                        if (tb.len > 0) { tb.put(' '); };
                        tb.put_str(vm.e_text[i]);
                    };
                    i++;
                };
                if (tb.len > 0)
                {
                    tb.put(0);
                    ok = this.ct_parse(n, tb.mem, out);
                    tb.__exit();
                    if (!ok) { -> 2; };
                    -> 0;
                };
                tb.__exit();
                -> 0;
            };


            ct_splice(NodeVec* v, int at, PtrVec* out) -> void
            {
                int k;
                int m = out.len;
                int old = v.len;
                while (k < m - 1)
                {
                    nv_push(v, (Node*)0);
                    k++;
                };

                if (m == 0)
                {
                    k = at;
                    while (k < old - 1)
                    {
                        v.items[k] = v.items[k + 1];
                        k++;
                    };
                    v.len = old - 1;
                    ->;
                };
                k = old - 1;
                while (k > at)
                {
                    v.items[k + m - 1] = v.items[k];
                    k--;
                };
                k = 0;
                while (k < m)
                {
                    v.items[at + k] = (Node*)out.items[k];
                    k++;
                };
                ->;
            };




            ct_expand(NodeVec* v, byte* root, bool top) -> void
            {
                int i;
                int r;
                Node* s;
                PtrVec* out;


                if (top)
                {
                    while (i < v.len)
                    {
                        s = v.items[i];
                        if (s.kind == NodeKind.NAMESPACE_DEF | s.kind == NodeKind.NAMESPACE_DEF_STATEMENT) { this.collect_consts(s, root); };
                        if (s.kind == NodeKind.MACRO_DEF_STATEMENT) { pv_push(this.ct_macros, (void*)s.a); };
                        i++;
                    };
                    i = 0;
                };
                while (i < v.len)
                {
                    s = v.items[i];
                    if (top) { this.ct_top_i = i; };
                    if (s.kind == NodeKind.COMPTIME_BLOCK)
                    {
                        out = pv_new();
                        r = this.ct_run(s, out);
                        if (r == 1) { this.note_unsup(g"comptime block not run (FVM codegen not ported)\0"); };
                        this.ct_splice(v, i, out);
                        pv_free(out);
                        node_free(s);
                    }
                    elif (s.kind == NodeKind.EMIT_IDEKA)
                    {
                        this.ct_fail(s, g"\0", g"emitideka encountered outside a comptime block during code generation\0");
                        i++;
                    }
                    else
                    {
                        if (top) { this.collect_consts(s, root); };
                        if (top & s.kind == NodeKind.ENUM_DEF) { pv_push(this.ct_enums, (void*)s); };
                        if (top & s.kind == NodeKind.ENUM_DEF_STATEMENT) { pv_push(this.ct_enums, (void*)s.a); };
                        this.ct_walk(s, root);
                        i++;
                    };
                };
                ->;
            };



            ct_walk(Node* n, byte* root) -> void
            {
                int s;
                NodeVec* v;
                if (n == (Node*)0) { ->; };
                if (n.kind == NodeKind.COMPTIME_BLOCK | n.kind == NodeKind.IDEKAVM_BLOCK) { ->; };
                this.ct_walk(n.a, root);
                this.ct_walk(n.b, root);
                this.ct_walk(n.c, root);
                this.ct_walk(n.d, root);
                this.ct_walk(n.e, root);
                while (s < 6)
                {
                    if (s == 0) { v = n.l0; }
                    elif (s == 1) { v = n.l1; }
                    elif (s == 2) { v = n.l2; }
                    elif (s == 3) { v = n.l3; }
                    elif (s == 4) { v = n.l4; }
                    else { v = n.l5; };
                    if (v != (NodeVec*)0) { this.ct_expand(v, root, false); };
                    s++;
                };
                ->;
            };




            comptime_expand(Node* prog) -> void
            {
                byte* root;
                if (this.ct_expanded) { ->; };
                this.ct_expanded = true;
                this.ct_pstmts = prog.l0;
                if (prog.l0 == (NodeVec*)0) { ->; };
                root = ts_dup(g"\0");
                this.ct_expand(prog.l0, root, true);
                this.ct_top_i = -1;
                ffree(root);
                ->;
            };



            ct_visit(Node* n) -> IRValue*
            {
                PtrVec* out;
                int r;
                int i;
                Node* st;
                if (n.kind == NodeKind.EMIT_IDEKA)
                {
                    this.ct_fail(n, g"\0", g"emitideka encountered outside a comptime block during code generation\0");
                    -> (IRValue*)0;
                };
                if (n.kind == NodeKind.IDEKAVM_BLOCK)
                {
                    this.unsup(n, g"idkvm block\0");
                    -> (IRValue*)0;
                };
                out = pv_new();
                r = this.ct_run(n, out);
                if (r == 1) { this.unsup(n, g"comptime block not run (FVM codegen not ported)\0"); };
                while (i < out.len)
                {
                    st = (Node*)out.items[i];
                    pv_push(this.ct_nodes, (void*)st);
                    if (r == 0) { this.visit(st); };
                    i++;
                };
                pv_free(out);
                -> (IRValue*)0;
            };

            gen_program(Node* prog) -> void
            {
                int i;
                int n = node_count(prog, 0);
                Node* s;
                bool has_inst;
                byte* root = ts_dup(g"\0");
                int nns;
                while (i < n)
                {
                    s = node_child(prog, 0, i);
                    switch (s.kind == NodeKind.NAMESPACE_DEF | s.kind == NodeKind.NAMESPACE_DEF_STATEMENT)
                    {
                        case (true) { nns++; }
                        default {};
                    };
                    i++;
                };
                i = 0;
                standard::io::console::println(g"[AST] Begining codegen for IDEKA program ...\0");
                standard::io::console::print(g"[AST] Total statements in AST: \0");
                standard::io::console::println(n);
                standard::io::console::print(g"[AST] Namespace definitions: \0");
                standard::io::console::println(nns);
                standard::io::console::println(g"[AST] Pass 1: Processing using statements...\0");
                standard::io::console::println(g"[AST] Pass 2: Processing not using statements...\0");
                while (i < n)
                {
                    s = node_child(prog, 0, i);
                    switch (s.kind)
                    {
                        case (NodeKind.USING_STATEMENT) { st_add_using_namespace(this.st, s.text); }
                        case (NodeKind.NOT_USING_STATEMENT) { st_remove_using_namespace(this.st, s.text); }
                        default {};
                    };
                    i++;
                };

                this.comptime_expand(prog);
                n = node_count(prog, 0);
                i = 0;
                standard::io::console::println(g"[AST] Pre-pass: Registering all object types and extern blocks...\0");
                while (i < n)
                {
                    this.collect_consts(node_child(prog, 0, i), root);
                    i++;
                };
                i = 0;
                while (i < n)
                {
                    this.cur_stmt = i;
                    this.types_pass(node_child(prog, 0, i), root);
                    i++;
                };

                int rp = 0;
                this.retry_mode = true;
                while (this.fwd_hit & rp <= n)
                {
                    this.fwd_hit = false;
                    i = 0;
                    while (i < n)
                    {
                        this.cur_stmt = i;
                        this.types_pass(node_child(prog, 0, i), root);
                        i++;
                    };
                    rp++;
                };
                this.retry_mode = false;
                this.fwd_hit = false;
                this.build_interfaces(prog);

                i = 0;
                while (i < n)
                {
                    switch (node_child(prog, 0, i).kind == NodeKind.EXTERN_BLOCK)
                    {
                        case (true) { this.decls_pass(node_child(prog, 0, i), root); }
                        default {};
                    };
                    i++;
                };
                i = 0;
                while (i < n)
                {
                    this.decls_pass(node_child(prog, 0, i), root);
                    i++;
                };
                i = 0;
                has_inst = false;
                while (i < n)
                {
                    s = node_child(prog, 0, i);
                    switch (s.kind == NodeKind.FUNCTION_DEF)
                    {
                        case (true) {
                        switch ((s.flags `& 1048576) != 0) { case (true) { has_inst = true; } default {}; };
                    }
                        default {};
                    };
                    i++;
                };
                i = 0;
                standard::io::console::println(g"[AST] Pass 3: Processing all other statements...\0");
                while (i < n)
                {
                    this.cur_stmt = i;
                    s = node_child(prog, 0, i);


                    switch (!this.si_closed & (s.kind == NodeKind.NAMESPACE_DEF | s.kind == NodeKind.NAMESPACE_DEF_STATEMENT))
                    {
                        case (true) { this.static_init_block(); }
                        default {};
                    };



                    switch (!this.si_closed & has_inst & this.pass3_runs(s))
                    {
                        case (true) { this.si_closed = true; }
                        default {};
                    };
                    this.bodies_pass(s, root);
                    switch (s.kind == NodeKind.FUNCTION_DEF)
                    {
                        case (true) {
                        switch (s.a != (Node*)0)
                        {
                            case (true) { this.si_closed = true; }
                            default {};
                        };
                    }
                        default {};
                    };
                    i++;
                };
                ffree(root);
                standard::io::console::println(g"[AST] Pass 4: Re-emitting pending bodies...\0");
                this.ct_finish();
                -> this.main_stubs();
            };






            pass3_runs(Node* s) -> bool
            {
                int k = s.kind;
                switch (k == NodeKind.NAMESPACE_DEF | k == NodeKind.NAMESPACE_DEF_STATEMENT | k == NodeKind.USING_STATEMENT | k == NodeKind.NOT_USING_STATEMENT)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (k == NodeKind.EXTERN_BLOCK | k == NodeKind.STRUCT_DEF | k == NodeKind.STRUCT_DEF_STATEMENT | k == NodeKind.OBJECT_DEF)
                        {
                            case (true) { -> false; }
                            default
                            {
                                switch (k == NodeKind.OBJECT_DEF_STATEMENT | k == NodeKind.CONTRACT_DEF)
                                {
                                    case (true) { -> false; }
                                    default
                                    {
                                        switch (k == NodeKind.VARIABLE_DECLARATION)
                                        {
                                            case (true) {
                                            switch (s.ts != (TypeSpec*)0)
                                            {
                                                case (true) {
                                                switch (s.ts.base_type == DataType.DICT) { case (true) { -> false; } default {}; };
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        switch (k == NodeKind.FUNCTION_DEF)
                                        {
                                            case (true) {
                                            switch ((s.flags `& 1048576) != 0) { case (true) { -> false; } default {}; };
                                        }
                                            default {};
                                        };
                                        -> true;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            static_init_block() -> void
            {
                IRFunc* f = this.mod.find_function(g"__static_init\0");
                IRBlock* b;
                switch (f == (IRFunc*)0)
                {
                    case (true) {
                    f = this.mod.add_function(this.mod.t_func(this.t_void, (IRType**)0, 0, false), g"__static_init\0");
                    b = this.mod.append_block(f, g"entry\0");
                }
                    default { b = this.mod.append_block(f, g"cont\0"); };
                };
                this.mod.position(f, b);
                -> this.mod.ret_void();
            };

            main_stubs() -> void
            {
                IRFunc* m0 = this.mod.find_function(g"main__0__ret_intE1\0");
                IRFunc* m2 = this.mod.find_function(g"main__2__intE1__byteE1_ptr2__ret_intE1\0");
                IRBlock* eb;
                switch (m0 == (IRFunc*)0 | m2 == (IRFunc*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (m0.is_decl & !m2.is_decl)
                        {
                            case (true) {
                            eb = this.mod.append_block(m0, g"entry\0");
                            this.mod.position(m0, eb);
                            this.mod.set_entry(eb);
                            this.mod.ia[0] = this.mod.c_int(this.t_i32, (i64)0);
                            this.mod.ia[1] = this.mod.c_null(m2.ftype.items[1]);
                            this.mod.ret(this.mod.call(m2.self, this.mod.ia, 2, (byte*)0));
                            m0.is_decl = false;
                        }
                            default {
                                switch (m2.is_decl & !m0.is_decl)
                                {
                                    case (true) {
                                        eb = this.mod.append_block(m2, g"entry\0");
                                        this.mod.position(m2, eb);
                                        this.mod.set_entry(eb);
                                        this.mod.ret(this.mod.call(m0.self, this.mod.ia, 0, (byte*)0));
                                        m2.is_decl = false;
                                    }
                                    default {};
                                };
                            };
                        };
                        ->;
                    };
                };
            };
        };
    };
};




























using IDEKA::ast;
using IDEKA::preprocessor;
using IDEKA::types;

namespace IDEKA
{
    namespace dce
    {
        dce_count(Node* n, int s) -> int
        {
            switch (n == (Node*)0)
            {
                case (true) { -> 0; }
                default
                {
                    -> node_count(n, s);
                };
            };
        };


        dce_contains(byte* hay, byte* needle) -> bool
        {
            int i = 0;
            int j;
            switch (needle[0] == 0)
            {
                case (true) { -> true; }
                default
                {
                    while (hay[i] != 0)
                    {
                        j = 0;
                        while (needle[j] != 0)
                        {
                            switch (hay[i + j] != needle[j])
                            {
                                case (true) { break; }
                                default
                                {
                                    j++;
                                };
                            };
                        };
                        switch (needle[j] == 0)
                        {
                            case (true) { -> true; }
                            default
                            {
                                i++;
                            };
                        };
                    };
                    -> false;
                };
            };
        };


        dce_find(byte* hay, byte* needle) -> int
        {
            int i = 0;
            int j;
            while (hay[i] != 0)
            {
                j = 0;
                while (needle[j] != 0)
                {
                    switch (hay[i + j] != needle[j])
                    {
                        case (true) { break; }
                        default
                        {
                            j++;
                        };
                    };
                };
                switch (needle[j] == 0)
                {
                    case (true) { -> i; }
                    default
                    {
                        i++;
                    };
                };
            };
            -> -1;
        };


        dce_ptr_key(Buf* b, void* p) -> byte*
        {
            u64 v = (u64)p;
            int i = 0;
            int d;
            b.clear();
            switch (v == (u64)0)
            {
                case (true) {
                b.put('0');
                -> b.mem;
            }
                default
                {
                    while (i < 16)
                    {
                        d = (int)((v >> (u64)((15 - i) * 4)) `& (u64)15);
                        switch (d < 10)
                        {
                            case (true) { b.put('0' + d); }
                            default { b.put('a' + (d - 10)); };
                        };
                        i++;
                    };
                    -> b.mem;
                };
            };
        };


        dce_fstr_name(int i) -> byte*
        {
            switch (i)
            {
                case (0) { -> g"standard__strings__fstr_append__3__floatE1__byteE1_ptr1__intE1_ptr1__ret_intE1\0"; }
                case (1) { -> g"standard__strings__fstr_append__3__doubleE1__byteE1_ptr1__intE1_ptr1__ret_intE1\0"; }
                case (2) { -> g"standard__strings__fstr_append__3__byteE1_ptr1__byteE1_ptr1__intE1_ptr1__ret_intE1\0"; }
                case (3) { -> g"standard__strings__fstr_append__3__dataE1_ubits16__byteE1_ptr1__intE1_ptr1__ret_intE1\0"; }
                case (4) { -> g"standard__strings__fstr_append__3__dataE1_ubits32__byteE1_ptr1__intE1_ptr1__ret_intE1\0"; }
                case (5) { -> g"standard__strings__fstr_append__3__dataE1_ubits64__byteE1_ptr1__intE1_ptr1__ret_intE1\0"; }
                case (6) { -> g"standard__strings__fstr_append__3__dataE1_sbits16__byteE1_ptr1__intE1_ptr1__ret_intE1\0"; }
                case (7) { -> g"standard__strings__fstr_append__3__dataE1_sbits32__byteE1_ptr1__intE1_ptr1__ret_intE1\0"; }
                case (8) { -> g"standard__strings__fstr_append__3__dataE1_sbits64__byteE1_ptr1__intE1_ptr1__ret_intE1\0"; }
                default { -> (byte*)0; };
            };
            -> (byte*)0;
        };


        dce_prim_name(int i) -> byte*
        {
            switch (i)
            {
                case (0) { -> g"int\0"; }
                case (1) { -> g"uint\0"; }
                case (2) { -> g"float\0"; }
                case (3) { -> g"double\0"; }
                case (4) { -> g"bool\0"; }
                case (5) { -> g"byte\0"; }
                case (6) { -> g"char\0"; }
                case (7) { -> g"void\0"; }
                case (8) { -> g"str\0"; }
                case (9) { -> g"i8\0"; }
                case (10) { -> g"i16\0"; }
                case (11) { -> g"i32\0"; }
                case (12) { -> g"i64\0"; }
                case (13) { -> g"i128\0"; }
                case (14) { -> g"u8\0"; }
                case (15) { -> g"u16\0"; }
                case (16) { -> g"u32\0"; }
                case (17) { -> g"u64\0"; }
                case (18) { -> g"u128\0"; }
                case (19) { -> g"f32\0"; }
                case (20) { -> g"f64\0"; }
                case (21) { -> g"ptr\0"; }
                case (22) { -> g"ref\0"; }
                case (23) { -> g"null\0"; }
                case (24) { -> g"nullptr\0"; }
                case (25) { -> g"true\0"; }
                case (26) { -> g"false\0"; }
                default { -> (byte*)0; };
            };
            -> (byte*)0;
        };

        object Dce
        {
            NameMap* prims;
            NameMap* live;
            NameMap* nsf;       
            NameMap* tlf;       
            NameMap* objm;      
            NameMap* objmq;     
            NameMap* owner;     
            PtrVec* keep;       
            Buf sb;
            Buf kb;
            Buf kb2;
            byte* entry;
            PtrVec* extra_roots;    
            PtrVec* usedns;         
            int eliminated;

            __init(byte* entry_name) -> this
            {
                int i;
                byte* p;
                this.prims = nm_new();
                this.live = nm_new();
                this.nsf = nm_new();
                this.tlf = nm_new();
                this.objm = nm_new();
                this.objmq = nm_new();
                this.owner = nm_new();
                this.keep = pv_new();
                this.sb.__init();
                this.kb.__init();
                this.kb2.__init();
                this.entry = entry_name;
                this.extra_roots = (PtrVec*)0;
                this.usedns = pv_new();
                this.eliminated = 0;
                p = dce_prim_name(0);
                while (p != (byte*)0)
                {
                    nm_put(this.prims, p, (void*)1);
                    i++;
                    p = dce_prim_name(i);
                };
                -> this;
            };

            __expr() -> Dce* -> this;

            __exit() -> void
            {
                int i;
                nm_free(this.prims);
                nm_free(this.live);
                nm_free(this.nsf);
                nm_free(this.tlf);
                nm_free(this.objm);
                nm_free(this.objmq);
                nm_free(this.owner);
                while (i < this.keep.len)
                {
                    ffree((byte*)this.keep.items[i]);
                    i++;
                };
                pv_free(this.keep);
                this.sb.__exit();
                this.kb.__exit();
                -> this.kb2.__exit();
            };

            own(void* p) -> void*
            {
                pv_push(this.keep, p);
                -> p;
            };

            is_prim(byte* s) -> bool -> nm_has(this.prims, s);






            add_suffixes(NameMap* refs, byte* s) -> void
            {
                int i = 0;
                switch (s[0] != 0)
                {
                    case (true) {
                    switch (!this.is_prim(s))
                    {
                        case (true) { nm_put(refs, s, (void*)1); }
                        default {};
                    };
                }
                    default {};
                };
                while (s[i] != 0)
                {
                    switch (s[i] == '_')
                    {
                        case (true) {
                        switch (s[i + 1] == '_')
                        {
                            case (true) {
                            i = i + 2;
                            switch (s[i] != 0)
                            {
                                case (true) {
                                switch (!this.is_prim(s + i))
                                {
                                    case (true) { nm_put(refs, s + i, (void*)1); }
                                    default {};
                                };
                            }
                                default {};
                            };
                            continue;
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    i++;
                };
                ->;
            };


            any_suffix_live(byte* s) -> bool
            {
                int i = 0;
                switch (s[0] != 0)
                {
                    case (true) {
                    switch (nm_has(this.live, s))
                    {
                        case (true) { -> true; }
                        default {};
                    };
                }
                    default {};
                };
                while (s[i] != 0)
                {
                    switch (s[i] == '_')
                    {
                        case (true) {
                        switch (s[i + 1] == '_')
                        {
                            case (true) {
                            i = i + 2;
                            switch (s[i] != 0)
                            {
                                case (true) {
                                switch (nm_has(this.live, s + i))
                                {
                                    case (true) { -> true; }
                                    default {};
                                };
                            }
                                default {};
                            };
                            continue;
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    i++;
                };
                -> false;
            };


            add_ref(NameMap* refs, byte* name) -> void
            {
                Buf nb;
                Buf db;
                int i = 0;
                int r;
                int k;
                bool dot = false;
                switch (name == (byte*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (name[0] == 0)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch (this.is_prim(name))
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        nb.__init();
                                        db.__init();
                                        defer nb.__exit();
                                        defer db.__exit();

                                        while (name[i] != 0)
                                        {
                                            switch (name[i] == ':')
                                            {
                                                case (true) {
                                                switch (name[i + 1] == ':')
                                                {
                                                    case (true) {
                                                    nb.put_str(g"__\0");
                                                    i = i + 2;
                                                    continue;
                                                }
                                                    default {};
                                                };
                                            }
                                                default {};
                                            };
                                            nb.put(name[i]);
                                            i++;
                                        };

                                        i = 0;
                                        while (nb.mem[i] != 0)
                                        {
                                            switch (nb.mem[i] == '.')
                                            {
                                                case (true) {
                                                dot = true;
                                                db.put_str(g"__\0");
                                            }
                                                default { db.put(nb.mem[i]); };
                                            };
                                            i++;
                                        };
                                        switch (dot)
                                        {
                                            case (true) { this.add_suffixes(refs, db.mem); }
                                            default {};
                                        };
                                        this.add_suffixes(refs, nb.mem);

                                        r = dce_find(nb.mem, g"__ret_\0");
                                        switch (r >= 0)
                                        {
                                            case (true) {
                                            db.clear();
                                            k = 0;
                                            while (k < r)
                                            {
                                                db.put(nb.mem[k]);
                                                k++;
                                            };
                                            this.add_suffixes(refs, db.mem);
                                            db.clear();
                                            k = 0;
                                            while (k < r)
                                            {
                                                switch (nb.mem[k] == '_')
                                                {
                                                    case (true) {
                                                    switch (nb.mem[k + 1] == '_')
                                                    {
                                                        case (true) { break; }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                db.put(nb.mem[k]);
                                                k++;
                                            };
                                            switch (db.mem[0] != 0)
                                            {
                                                case (true) {
                                                switch (!this.is_prim(db.mem))
                                                {
                                                    case (true) { nm_put(refs, db.mem, (void*)1); }
                                                    default {};
                                                };
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        ->;
                                    };
                                };
                            };
                        };
                    };
                };
            };



            add_arity_ref(NameMap* refs, byte* name, int nargs) -> void
            {
                Buf nb;
                int i = 0;
                int last = 0;
                nb.__init();
                defer nb.__exit();
                while (name[i] != 0)
                {
                    switch (name[i] == ':')
                    {
                        case (true) {
                        switch (name[i + 1] == ':')
                        {
                            case (true) {
                            nb.put_str(g"__\0");
                            i = i + 2;
                            continue;
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    nb.put(name[i]);
                    i++;
                };

                i = nb.len - 2;
                last = 0;
                while (i >= 0)
                {
                    switch (nb.mem[i] == '_')
                    {
                        case (true) {
                        switch (nb.mem[i + 1] == '_')
                        {
                            case (true) {
                            last = i + 2;
                            break;
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    i--;
                };
                this.sb.clear();
                this.sb.put_str(nb.mem + last);
                switch (this.sb.mem[0] == 0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (this.is_prim(this.sb.mem))
                        {
                            case (true) { ->; }
                            default
                            {
                                this.sb.put_str(f"__{nargs}\0");
                                -> nm_put(refs, this.sb.mem, (void*)1);
                            };
                        };
                    };
                };
            };





            walk_ts(NameMap* refs, TypeSpec* t) -> void
            {
                int i;
                switch (t == (TypeSpec*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (t.custom_typename != (byte*)0)
                        {
                            case (true) { this.add_ref(refs, t.custom_typename); }
                            default {};
                        };
                        this.collect(refs, t.array_size);
                        switch (t.array_dims != (NodeVec*)0)
                        {
                            case (true) {
                            while (i < t.array_dims.len)
                            {
                                this.collect(refs, t.array_dims.items[i]);
                                i++;
                            };
                        }
                            default {};
                        };
                        -> this.walk_ts(refs, t.array_elem);
                    };
                };
            };



            walk_fp(NameMap* refs, TypeSpec* t) -> void
            {
                int i;
                switch (t == (TypeSpec*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        this.walk_ts(refs, t.fp_ret);
                        this.walk_fp(refs, t.fp_ret);
                        switch (t.fp_params != (TypeSpec**)0)
                        {
                            case (true) {
                            while (i < t.fp_nparams)
                            {
                                this.walk_ts(refs, t.fp_params[i]);
                                this.walk_fp(refs, t.fp_params[i]);
                                i++;
                            };
                        }
                            default {};
                        };
                        ->;
                    };
                };
            };

            walk_list(NameMap* refs, Node* n, int slot) -> void
            {
                int c = dce_count(n, slot);
                int i;
                while (i < c)
                {
                    this.collect(refs, node_child(n, slot, i));
                    i++;
                };
                ->;
            };

            collect(NameMap* refs, Node* n) -> void
            {
                int k;
                int i;
                int c;
                Node* o;
                switch (n == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        k = n.kind;
                        switch (k == NodeKind.IDENTIFIER)
                        {
                            case (true) {
                            -> this.add_ref(refs, n.text);
                        }
                            default
                            {
                                switch (k == NodeKind.FUNCTION_CALL)
                                {
                                    case (true) {
                                    switch (n.text != (byte*)0)
                                    {
                                        case (true) {
                                        this.add_ref(refs, n.text);
                                        this.add_arity_ref(refs, n.text, dce_count(n, 0));
                                    }
                                        default {};
                                    };
                                    -> this.walk_list(refs, n, 0);
                                }
                                    default
                                    {
                                        switch (k == NodeKind.METHOD_CALL)
                                        {
                                            case (true) {
                                            o = n.a;
                                            switch (n.text != (byte*)0)
                                            {
                                                case (true) {
                                                switch (n.text[0] != 0)
                                                {
                                                    case (true) {
                                                    this.add_ref(refs, n.text);
                                                    this.sb.clear();
                                                    this.sb.put_str(f"{n.text}__{dce_count(n, 0)}\0");
                                                    nm_put(refs, this.sb.mem, (void*)1);
                                                    switch (o != (Node*)0)
                                                    {
                                                        case (true) {
                                                        switch (o.kind == NodeKind.IDENTIFIER | o.kind == NodeKind.FUNCTION_CALL | o.kind == NodeKind.MACRO_CALL)
                                                        {
                                                            case (true) {
                                                            switch (o.text != (byte*)0)
                                                            {
                                                                case (true) {
                                                                switch (o.text[0] != 0)
                                                                {
                                                                    case (true) {
                                                                    this.kb.clear();
                                                                    this.kb.put_str(f"{o.text}__{n.text}\0");
                                                                    this.add_ref(refs, this.kb.mem);
                                                                }
                                                                    default {};
                                                                };
                                                            }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                            }
                                                default {};
                                            };
                                            this.collect(refs, o);
                                            -> this.walk_list(refs, n, 0);
                                        }
                                            default
                                            {
                                                switch (k == NodeKind.F_STRING_LITERAL)
                                                {
                                                    case (true) {
                                                    i = 0;
                                                    while (i < 9)
                                                    {
                                                        this.add_ref(refs, dce_fstr_name(i));
                                                        i++;
                                                    };
                                                    -> this.walk_list(refs, n, 0);
                                                }
                                                    default
                                                    {
                                                        switch (k == NodeKind.MEMBER_ACCESS)
                                                        {
                                                            case (true) {
                                                            -> this.collect(refs, n.a);
                                                        }
                                                            default
                                                            {
                                                                switch (k == NodeKind.STRUCT_FIELD_ACCESS)
                                                                {
                                                                    case (true) { ->; }
                                                                    default
                                                                    {
                                                                        switch (k == NodeKind.ENUM_DEF)
                                                                        {
                                                                            case (true) {
                                                                            -> this.walk_ts(refs, n.ts);
                                                                        }
                                                                            default
                                                                            {
                                                                                switch (k == NodeKind.NAMESPACE_DEF)
                                                                                {
                                                                                    case (true) {

                                                                                    this.walk_list(refs, n, 0);
                                                                                    this.walk_list(refs, n, 1);
                                                                                    this.walk_list(refs, n, 2);
                                                                                    this.walk_list(refs, n, 3);
                                                                                    this.walk_list(refs, n, 4);
                                                                                    this.walk_list(refs, n, 5);
                                                                                    this.collect(refs, n.a);
                                                                                    -> this.collect(refs, n.b);
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        this.walk_ts(refs, n.ts);
                                                                                        this.walk_ts(refs, n.ts2);
                                                                                        switch (k == NodeKind.FUNCTION_POINTER_DECLARATION)
                                                                                        {
                                                                                            case (true) { this.walk_fp(refs, n.ts); }
                                                                                            default {};
                                                                                        };

                                                                                        this.collect(refs, n.a);
                                                                                        this.collect(refs, n.b);
                                                                                        this.collect(refs, n.c);
                                                                                        switch (k != NodeKind.OBJECT_DEF)
                                                                                        {
                                                                                            case (true) {
                                                                                            this.collect(refs, n.d);
                                                                                            this.collect(refs, n.e);
                                                                                        }
                                                                                            default {};
                                                                                        };


                                                                                        switch (k == NodeKind.FOR_IN_LOOP | k == NodeKind.STRUCT_INSTANCE | k == NodeKind.STRUCT_LITERAL |
                                                                                            k == NodeKind.INTERFACE_DEF | k == NodeKind.MACRO_DEF | k == NodeKind.CONTRACT_DEF |
                                                                                            k == NodeKind.CONSTRA_DEF)
                                                                                        {
                                                                                            case (true) {
                                                                                            switch (k == NodeKind.STRUCT_INSTANCE | k == NodeKind.STRUCT_LITERAL)
                                                                                            {
                                                                                                case (true) {
                                                                                                this.walk_list(refs, n, 1);
                                                                                                this.walk_list(refs, n, 2);
                                                                                            }
                                                                                                default {
                                                                                                    switch (k == NodeKind.INTERFACE_DEF)
                                                                                                    {
                                                                                                        case (true) { this.walk_list(refs, n, 1); }
                                                                                                        default {
                                                                                                            switch (k == NodeKind.CONTRACT_DEF | k == NodeKind.CONSTRA_DEF | k == NodeKind.MACRO_DEF)
                                                                                                            {
                                                                                                                case (true) { }
                                                                                                                default {
                                                                                                this.walk_list(refs, n, 1);
                                                                                                this.walk_list(refs, n, 2);
                                                                                            };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                            ->;
                                                                                        }
                                                                                            default
                                                                                            {
                                                                                                switch (k == NodeKind.STRUCT_DEF)
                                                                                                {
                                                                                                    case (true) {
                                                                                                    this.walk_list(refs, n, 0);
                                                                                                    this.walk_list(refs, n, 3);
                                                                                                    -> this.walk_list(refs, n, 5);
                                                                                                }
                                                                                                    default
                                                                                                    {
                                                                                                        switch (k == NodeKind.OBJECT_DEF)
                                                                                                        {
                                                                                                            case (true) {
                                                                                                            this.walk_list(refs, n, 0);
                                                                                                            this.walk_list(refs, n, 1);
                                                                                                            this.walk_list(refs, n, 3);
                                                                                                            -> this.walk_list(refs, n, 4);
                                                                                                        }
                                                                                                            default
                                                                                                            {
                                                                                                                switch (k == NodeKind.DESTRUCTURING_ASSIGNMENT)
                                                                                                                {
                                                                                                                    case (true) {
                                                                                                                    c = dce_count(n, 0);
                                                                                                                    i = 0;
                                                                                                                    while (i < c)
                                                                                                                    {
                                                                                                                        o = node_child(n, 0, i);
                                                                                                                        switch (o.kind != NodeKind.IDENTIFIER)
                                                                                                                        {
                                                                                                                            case (true) { this.collect(refs, o); }
                                                                                                                            default {};
                                                                                                                        };
                                                                                                                        i++;
                                                                                                                    };
                                                                                                                    this.walk_list(refs, n, 1);
                                                                                                                    this.walk_list(refs, n, 2);
                                                                                                                    this.walk_list(refs, n, 3);
                                                                                                                    this.walk_list(refs, n, 4);
                                                                                                                    -> this.walk_list(refs, n, 5);
                                                                                                                }
                                                                                                                    default
                                                                                                                    {
                                                                                                                        this.walk_list(refs, n, 0);
                                                                                                                        this.walk_list(refs, n, 1);
                                                                                                                        this.walk_list(refs, n, 2);
                                                                                                                        this.walk_list(refs, n, 3);
                                                                                                                        this.walk_list(refs, n, 4);
                                                                                                                        -> this.walk_list(refs, n, 5);
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };





            idx_add(NameMap* m, byte* key, Node* f) -> void
            {
                PtrVec* v;
                switch (key[0] == 0)
                {
                    case (true) { ->; }
                    default
                    {
                        v = (PtrVec*)nm_get(m, key);
                        switch (v == (PtrVec*)0)
                        {
                            case (true) {
                            v = pv_new();
                            nm_put(m, key, (void*)v);
                        }
                            default {};
                        };
                        -> pv_push(v, (void*)f);
                    };
                };
            };


            idx_suffixes(NameMap* m, byte* key, Node* f) -> void
            {
                int i = 0;
                this.idx_add(m, key, f);
                while (key[i] != 0)
                {
                    switch (key[i] == '_')
                    {
                        case (true) {
                        switch (key[i + 1] == '_')
                        {
                            case (true) {
                            i = i + 2;
                            this.idx_add(m, key + i, f);
                            continue;
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    i++;
                };
                ->;
            };

            ns_of(Node* s) -> Node*
            {
                switch (s.kind == NodeKind.NAMESPACE_DEF)
                {
                    case (true) { -> s; }
                    default
                    {
                        switch (s.kind == NodeKind.NAMESPACE_DEF_STATEMENT)
                        {
                            case (true) { -> s.a; }
                            default
                            {
                                -> (Node*)0;
                            };
                        };
                    };
                };
            };


            join_prefix(byte* prefix, byte* name) -> byte*
            {
                this.kb2.clear();
                switch (prefix[0] != 0)
                {
                    case (true) {
                    this.kb2.put_str(f"{prefix}__\0");
                }
                    default {};
                };
                this.kb2.put_str(name);
                -> this.kb2.mem;
            };


            child_prefix(byte* prefix, Node* ns) -> byte*
            {
                Buf pb;
                byte* r;
                pb.__init();
                defer pb.__exit();
                switch (prefix[0] != 0)
                {
                    case (true) {
                    pb.put_str(prefix);
                    switch (ns.text != (byte*)0)
                    {
                        case (true) {
                        switch (ns.text[0] != 0)
                        {
                            case (true) { pb.put_str(g"__\0"); }
                            default {};
                        };
                    }
                        default {};
                    };
                }
                    default {};
                };
                switch (ns.text != (byte*)0)
                {
                    case (true) { pb.put_str(ns.text); }
                    default {};
                };
                r = ts_dup(pb.mem);
                this.own((void*)r);
                -> r;
            };

            index_ns(Node* ns, byte* prefix) -> void
            {
                byte* cur = this.child_prefix(prefix, ns);
                int c;
                int i;
                int j;
                int mc;
                Node* f;
                Node* o;
                Node* m;
                byte* full;
                byte* anchor;
                Buf kq;
                byte* key;
                c = dce_count(ns, 0);
                while (i < c)
                {
                    f = node_child(ns, 0, i);
                    i++;
                    switch (f.kind != NodeKind.FUNCTION_DEF)
                    {
                        case (true) { continue; }
                        default
                        {
                            switch (f.text == (byte*)0)
                            {
                                case (true) { continue; }
                                default
                                {
                                    full = this.join_prefix(cur, f.text);
                                    this.idx_suffixes(this.nsf, full, f);
                                    this.sb.clear();
                                    this.sb.put_str(f"{f.text}__{dce_count(f, 0)}\0");
                                    this.idx_add(this.nsf, this.sb.mem, f);
                                };
                            };
                        };
                    };
                };

                kq.__init();
                defer kq.__exit();
                c = dce_count(ns, 2);
                i = 0;
                while (i < c)
                {
                    o = node_child(ns, 2, i);
                    i++;
                    switch (o.kind != NodeKind.OBJECT_DEF)
                    {
                        case (true) { continue; }
                        default
                        {
                            mc = dce_count(o, 1);
                            j = 0;
                            while (j < mc)
                            {
                                m = node_child(o, 1, j);
                                j++;
                                switch (m.text == (byte*)0)
                                {
                                    case (true) { continue; }
                                    default
                                    {
                                        kq.clear();
                                        switch (o.text != (byte*)0)
                                        {
                                            case (true) { kq.put_str(o.text); }
                                            default {};
                                        };
                                        kq.put_str(f"__{m.text}\0");
                                        anchor = ts_dup(kq.mem);
                                        this.own((void*)anchor);
                                        full = this.join_prefix(cur, anchor);
                                        key = ts_dup(full);
                                        this.own((void*)key);
                                        nm_put(this.owner, dce_ptr_key(@this.sb, (void*)m), (void*)o.text);
                                        this.index_method(key, anchor, m);
                                    };
                                };
                            };
                        };
                    };
                };
                c = dce_count(ns.b, 0);
                i = 0;
                while (i < c)
                {
                    this.index_ns(node_child(ns.b, 0, i), cur);
                    i++;
                };
                ->;
            };



            index_method(byte* full, byte* anchor, Node* m) -> void
            {
                int i = 0;
                this.idx_add(this.objm, full, m);
                this.idx_add(this.objmq, full, m);
                while (full[i] != 0)
                {
                    switch (full[i] == '_')
                    {
                        case (true) {
                        switch (full[i + 1] == '_')
                        {
                            case (true) {
                            i = i + 2;
                            switch (full[i] != 0)
                            {
                                case (true) {
                                this.idx_add(this.objm, full + i, m);
                                switch (dce_contains(full + i, anchor))
                                {
                                    case (true) { this.idx_add(this.objmq, full + i, m); }
                                    default {};
                                };
                            }
                                default {};
                            };
                            continue;
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    i++;
                };
                ->;
            };





            is_entry(Node* f) -> bool
            {
                switch (f.text == (byte*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (cstr_eq(f.text, this.entry))
                        {
                            case (true) { -> true; }
                            default
                            {
                                -> cstr_eq(f.text, g"_start\0");
                            };
                        };
                    };
                };
            };


            refs_into(Node* f, NameMap* out) -> void
            {
                NameMap* r = nm_new();
                int e;
                this.collect(r, f);
                while (e < r.count)
                {
                    switch (r.vals[e] != (void*)0)
                    {
                        case (true) {
                        switch (!nm_has(this.live, r.keys[e]))
                        {
                            case (true) { nm_put(out, r.keys[e], (void*)1); }
                            default {};
                        };
                    }
                        default {};
                    };
                    e++;
                };
                -> nm_free(r);
            };

            walk_funcs(PtrVec* v, NameMap* out) -> void
            {
                int i;
                switch (v == (PtrVec*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        while (i < v.len)
                        {
                            this.refs_into((Node*)v.items[i], out);
                            i++;
                        };
                        ->;
                    };
                };
            };


            count_key(Node* f) -> byte*
            {
                this.kb.clear();
                this.kb.put_str(f"{f.text}__{dce_count(f, 0)}\0");
                -> this.kb.mem;
            };



            expand(NameMap* frontier, bool narrow) -> void
            {
                NameMap* cur = frontier;
                NameMap* nxt;
                int e;
                int i;
                bool has_count;
                PtrVec* funcs;
                Node* f;
                byte* name;
                while (cur.count > 0)
                {
                    nxt = nm_new();
                    e = 0;
                    while (e < cur.count)
                    {
                        switch (cur.vals[e] == (void*)0)
                        {
                            case (true) { e++; continue; }
                            default
                            {
                                name = cur.keys[e];
                                e++;
                                switch (nm_has(this.live, name))
                                {
                                    case (true) { continue; }
                                    default
                                    {
                                        nm_put(this.live, name, (void*)1);
                                        funcs = (PtrVec*)nm_get(this.nsf, name);
                                        switch (funcs != (PtrVec*)0)
                                        {
                                            case (true) {
                                            has_count = false;
                                            switch (narrow)
                                            {
                                                case (true) {
                                                i = 0;
                                                while (i < funcs.len)
                                                {
                                                    f = (Node*)funcs.items[i];
                                                    i++;
                                                    switch (nm_has(this.live, this.count_key(f)))
                                                    {
                                                        case (true) { has_count = true; }
                                                        default {};
                                                    };
                                                };
                                            }
                                                default {};
                                            };
                                            i = 0;
                                            while (i < funcs.len)
                                            {
                                                f = (Node*)funcs.items[i];
                                                i++;
                                                switch (has_count)
                                                {
                                                    case (true) {
                                                    switch (!nm_has(this.live, this.count_key(f)))
                                                    {
                                                        case (true) { continue; }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                this.refs_into(f, nxt);
                                            };
                                        }
                                            default {};
                                        };
                                        this.walk_funcs((PtrVec*)nm_get(this.tlf, name), nxt);
                                        this.walk_funcs((PtrVec*)nm_get(this.objmq, name), nxt);
                                    };
                                };
                            };
                        };
                    };
                    switch (cur != frontier)
                    {
                        case (true) { nm_free(cur); }
                        default {};
                    };
                    cur = nxt;
                };
                switch (cur != frontier)
                {
                    case (true) { nm_free(cur); }
                    default {};
                };
                ->;
            };


            type_field_refs(Node* ns, byte* prefix, NameMap* out) -> void
            {
                byte* cur = this.child_prefix(prefix, ns);
                int s;
                int c;
                int i;
                Node* d;
                while (s < 2)
                {
                    switch (s)
                    {
                        case (0) { c = dce_count(ns, 1); }
                        default { c = dce_count(ns, 2); };
                    };
                    i = 0;
                    while (i < c)
                    {
                        switch (s)
                        {
                            case (0) { d = node_child(ns, 1, i); }
                            default { d = node_child(ns, 2, i); };
                        };
                        i++;
                        switch (d.text == (byte*)0)
                        {
                            case (true) { continue; }
                            default
                            {
                                switch (d.text[0] == 0)
                                {
                                    case (true) { continue; }
                                    default
                                    {
                                        switch (!this.any_suffix_live(this.join_prefix(cur, d.text)))
                                        {
                                            case (true) { continue; }
                                            default
                                            {
                                                this.refs_into(d, out);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                    s++;
                };
                c = dce_count(ns.b, 0);
                i = 0;
                while (i < c)
                {
                    this.type_field_refs(node_child(ns.b, 0, i), cur, out);
                    i++;
                };
                ->;
            };


            seed_traits(Node* ns, byte* prefix, NameMap* seed) -> void
            {
                byte* cur = this.child_prefix(prefix, ns);
                int c = dce_count(ns, 2);
                int i;
                int j;
                int mc;
                int e;
                int q;
                Node* o;
                Node* m;
                bool refd;
                byte* full;
                byte* anchor;
                byte* v;
                Buf kq;
                kq.__init();
                defer kq.__exit();
                while (i < c)
                {
                    o = node_child(ns, 2, i);
                    i++;
                    switch (o.kind != NodeKind.OBJECT_DEF)
                    {
                        case (true) { continue; }
                        default
                        {
                            switch (dce_count(o, 5) == 0)
                            {
                                case (true) { continue; }
                                default
                                {
                                    switch (o.text == (byte*)0)
                                    {
                                        case (true) { continue; }
                                        default
                                        {
                                            switch (o.text[0] == 0)
                                            {
                                                case (true) { continue; }
                                                default
                                                {
                                                    refd = false;
                                                    e = 0;
                                                    while (e < seed.count)
                                                    {
                                                        switch (seed.vals[e] != (void*)0)
                                                        {
                                                            case (true) {
                                                            switch (dce_contains(seed.keys[e], o.text))
                                                            {
                                                                case (true) { refd = true; break; }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                        e++;
                                                    };
                                                    switch (!refd)
                                                    {
                                                        case (true) { continue; }
                                                        default
                                                        {
                                                            mc = dce_count(o, 1);
                                                            j = 0;
                                                            while (j < mc)
                                                            {
                                                                m = node_child(o, 1, j);
                                                                j++;
                                                                switch (m.text == (byte*)0)
                                                                {
                                                                    case (true) { continue; }
                                                                    default
                                                                    {
                                                                        kq.clear();
                                                                        kq.put_str(f"{o.text}__{m.text}\0");
                                                                        anchor = ts_dup(kq.mem);
                                                                        this.own((void*)anchor);
                                                                        full = ts_dup(this.join_prefix(cur, anchor));
                                                                        this.own((void*)full);
                                                                        nm_put(seed, full, (void*)1);
                                                                        q = 0;
                                                                        while (full[q] != 0)
                                                                        {
                                                                            switch (full[q] == '_')
                                                                            {
                                                                                case (true) {
                                                                                switch (full[q + 1] == '_')
                                                                                {
                                                                                    case (true) {
                                                                                    q = q + 2;
                                                                                    v = full + q;
                                                                                    switch (v[0] != 0)
                                                                                    {
                                                                                        case (true) {
                                                                                        switch (dce_contains(v, anchor))
                                                                                        {
                                                                                            case (true) { nm_put(seed, v, (void*)1); }
                                                                                            default {};
                                                                                        };
                                                                                    }
                                                                                        default {};
                                                                                    };
                                                                                    continue;
                                                                                }
                                                                                    default {};
                                                                                };
                                                                            }
                                                                                default {};
                                                                            };
                                                                            q++;
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                c = dce_count(ns.b, 0);
                i = 0;
                while (i < c)
                {
                    this.seed_traits(node_child(ns.b, 0, i), cur, seed);
                    i++;
                };
                ->;
            };

            seed_externs(Node* ns, NameMap* seed) -> void
            {
                int c = dce_count(ns, 5);
                int i;
                int j;
                int dc;
                Node* b;
                while (i < c)
                {
                    b = node_child(ns, 5, i);
                    i++;
                    switch (b.kind != NodeKind.EXTERN_BLOCK)
                    {
                        case (true) { continue; }
                        default
                        {
                            dc = dce_count(b, 0);
                            j = 0;
                            while (j < dc)
                            {
                                this.collect(seed, node_child(b, 0, j));
                                j++;
                            };
                        };
                    };
                };
                c = dce_count(ns.b, 0);
                i = 0;
                while (i < c)
                {
                    this.seed_externs(node_child(ns.b, 0, i), seed);
                    i++;
                };
                ->;
            };


            is_op_name(byte* s) -> bool
            {
                byte* p = g"operator__\0";
                int i = 0;
                while (p[i] != 0)
                {
                    switch (s[i] != p[i])
                    {
                        case (true) { -> false; }
                        default {};
                    };
                    i++;
                };
                -> true;
            };


            ns_used(byte* full) -> bool
            {
                int k = 0;
                int n;
                byte* u;
                while (k < this.usedns.len)
                {
                    u = (byte*)this.usedns.items[k];
                    k++;
                    n = 0;
                    while (u[n] != 0 & full[n] == u[n]) { n++; };
                    switch (u[n] == 0 & (full[n] == 0 | (full[n] == '_' & full[n + 1] == '_')))
                    {
                        case (true) { -> true; }
                        default {};
                    };
                };
                -> false;
            };




            seed_ns_operators(Node* ns, byte* prefix, NameMap* seed) -> void
            {
                byte* cur = this.child_prefix(prefix, ns);
                int c;
                int i;
                Node* f;
                byte* full;
                switch (this.ns_used(cur))
                {
                    case (true) {
                        c = dce_count(ns, 0);
                        i = 0;
                        while (i < c)
                        {
                            f = node_child(ns, 0, i);
                            i++;
                            switch (f.kind == NodeKind.FUNCTION_DEF & f.text != (byte*)0)
                            {
                                case (true) {
                                    switch (this.is_op_name(f.text))
                                    {
                                        case (true) {
                                            full = this.join_prefix(cur, f.text);
                                            this.add_suffixes(seed, full);
                                            nm_put(seed, this.count_key(f), (void*)1);
                                        }
                                        default {};
                                    };
                                }
                                default {};
                            };
                        };
                    }
                    default {};
                };
                c = dce_count(ns.b, 0);
                i = 0;
                while (i < c)
                {
                    this.seed_ns_operators(node_child(ns.b, 0, i), cur, seed);
                    i++;
                };
                ->;
            };


            collect_used(Node* prog) -> void
            {
                int c = dce_count(prog, 0);
                int i = 0;
                int n;
                Node* s;
                Buf ub;
                byte* r;
                ub.__init();
                defer ub.__exit();
                while (i < c)
                {
                    s = node_child(prog, 0, i);
                    i++;
                    switch (s.kind == NodeKind.USING_STATEMENT & s.text != (byte*)0)
                    {
                        case (true) {
                            ub.clear();
                            n = 0;
                            while (s.text[n] != 0)
                            {
                                switch (s.text[n] == ':' & s.text[n + 1] == ':')
                                {
                                    case (true) { ub.put_str(g"__\0"); n = n + 2; }
                                    default { ub.put(s.text[n]); n++; };
                                };
                            };
                            r = ts_dup(ub.mem);
                            this.own((void*)r);
                            pv_push(this.usedns, (void*)r);
                        }
                        default {};
                    };
                };
                ->;
            };

            compute_live(Node* prog) -> void
            {
                NameMap* seed = nm_new();
                NameMap* walked;
                NameMap* bare;
                NameMap* types;
                Node* s;
                Node* ns;
                int c = dce_count(prog, 0);
                int i;
                int e;
                int j;
                int before;
                bool progressed;
                PtrVec* ms;
                Node* m;
                byte* on;
                byte* key;
                Buf eb;
                eb.__init();
                defer eb.__exit();


                eb.put_str(this.entry);
                this.add_suffixes(seed, eb.mem);
                this.add_suffixes(seed, g"standard__strings__fstr_append\0");
                nm_put(seed, g"fstr_append__3\0", (void*)1);
                i = 0;
                while (i < 9)
                {
                    this.add_suffixes(seed, dce_fstr_name(i));
                    i++;
                };



                this.add_suffixes(seed, g"memset\0");


                if (this.extra_roots != (PtrVec*)0)
                {
                    i = 0;
                    while (i < this.extra_roots.len)
                    {
                        this.add_suffixes(seed, (byte*)this.extra_roots.items[i]);
                        i++;
                    };
                };


                i = 0;
                while (i < c)
                {
                    s = node_child(prog, 0, i);
                    i++;
                    switch (this.ns_of(s) != (Node*)0)
                    {
                        case (true) { continue; }
                        default
                        {
                            switch (s.kind == NodeKind.USING_STATEMENT)
                            {
                                case (true) { continue; }
                                default
                                {
                                    switch (s.kind == NodeKind.FUNCTION_DEF)
                                    {
                                        case (true) {
                                        switch (this.is_entry(s))
                                        {
                                            case (true) { this.collect(seed, s); }
                                            default {};
                                        };
                                        continue;
                                    }
                                        default
                                        {
                                            this.collect(seed, s);
                                        };
                                    };
                                };
                            };
                        };
                    };
                };


                i = 0;
                while (i < c)
                {
                    s = node_child(prog, 0, i);
                    i++;
                    switch (s.kind != NodeKind.FUNCTION_DEF)
                    {
                        case (true) { continue; }
                        default
                        {
                            switch (s.text == (byte*)0)
                            {
                                case (true) { continue; }
                                default
                                {
                                    this.idx_suffixes(this.tlf, s.text, s);
                                    this.idx_add(this.tlf, this.count_key(s), s);
                                    switch (this.is_entry(s))
                                    {
                                        case (true) { nm_put(seed, s.text, (void*)1); }
                                        default {};
                                    };
                                    switch (this.is_op_name(s.text))
                                    {
                                        case (true) {
                                            this.add_suffixes(seed, s.text);
                                            nm_put(seed, this.count_key(s), (void*)1);
                                        }
                                        default {};
                                    };
                                };
                            };
                        };
                    };
                };


                i = 0;
                while (i < c)
                {
                    ns = this.ns_of(node_child(prog, 0, i));
                    i++;
                    switch (ns != (Node*)0)
                    {
                        case (true) { this.index_ns(ns, g"\0"); }
                        default {};
                    };
                };
                i = 0;
                while (i < c)
                {
                    ns = this.ns_of(node_child(prog, 0, i));
                    i++;
                    switch (ns != (Node*)0)
                    {
                        case (true) { this.seed_traits(ns, g"\0", seed); }
                        default {};
                    };
                };
                i = 0;
                while (i < c)
                {
                    ns = this.ns_of(node_child(prog, 0, i));
                    i++;
                    switch (ns != (Node*)0)
                    {
                        case (true) { this.seed_externs(ns, seed); }
                        default {};
                    };
                };
                this.collect_used(prog);
                i = 0;
                while (i < c)
                {
                    ns = this.ns_of(node_child(prog, 0, i));
                    i++;
                    switch (ns != (Node*)0)
                    {
                        case (true) { this.seed_ns_operators(ns, g"\0", seed); }
                        default {};
                    };
                };


                this.expand(seed, true);
                nm_free(seed);


                while (true)
                {
                    before = this.live.count;
                    walked = nm_new();
                    progressed = true;
                    while (progressed)
                    {
                        progressed = false;
                        bare = nm_new();
                        e = 0;
                        while (e < this.objm.count)
                        {
                            key = this.objm.keys[e];
                            ms = (PtrVec*)this.objm.vals[e];
                            e++;
                            switch (ms == (PtrVec*)0)
                            {
                                case (true) { continue; }
                                default
                                {
                                    switch (dce_contains(key, g"__\0"))
                                    {
                                        case (true) { continue; }
                                        default
                                        {
                                            switch (!nm_has(this.live, key))
                                            {
                                                case (true) { continue; }
                                                default
                                                {
                                                    j = 0;
                                                    while (j < ms.len)
                                                    {
                                                        m = (Node*)ms.items[j];
                                                        j++;
                                                        switch (nm_has(walked, dce_ptr_key(@this.kb2, (void*)m)))
                                                        {
                                                            case (true) { continue; }
                                                            default
                                                            {
                                                                on = (byte*)nm_get(this.owner, dce_ptr_key(@this.kb2, (void*)m));
                                                                switch (on != (byte*)0)
                                                                {
                                                                    case (true) {
                                                                    switch (on[0] != 0)
                                                                    {
                                                                        case (true) {
                                                                        switch (!nm_has(this.live, on))
                                                                        {
                                                                            case (true) { continue; }
                                                                            default {};
                                                                        };
                                                                    }
                                                                        default {};
                                                                    };
                                                                }
                                                                    default {};
                                                                };
                                                                nm_put(walked, dce_ptr_key(@this.kb2, (void*)m), (void*)1);
                                                                progressed = true;
                                                                this.refs_into(m, bare);
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        this.expand(bare, false);
                        nm_free(bare);
                    };
                    nm_free(walked);

                    types = nm_new();
                    i = 0;
                    while (i < c)
                    {
                        ns = this.ns_of(node_child(prog, 0, i));
                        i++;
                        switch (ns != (Node*)0)
                        {
                            case (true) { this.type_field_refs(ns, g"\0", types); }
                            default {};
                        };
                    };
                    this.expand(types, false);
                    nm_free(types);

                    switch (this.live.count == before)
                    {
                        case (true) { break; }
                        default {};
                    };
                };
                ->;
            };





            type_live(byte* prefix, byte* name) -> bool -> this.any_suffix_live(this.join_prefix(prefix, name));


            set_len(NodeVec* v, int n) -> void
            {
                switch (v == (NodeVec*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        v.len = n;
                        ->;
                    };
                };
            };


            prune_named(NodeVec* v, byte* prefix) -> void
            {
                int i;
                int k;
                Node* d;
                bool keepd;
                switch (v == (NodeVec*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        while (i < v.len)
                        {
                            d = v.items[i];
                            i++;
                            keepd = true;
                            switch (d.text != (byte*)0)
                            {
                                case (true) {
                                switch (d.text[0] != 0)
                                {
                                    case (true) {
                                    switch (!this.type_live(prefix, d.text))
                                    {
                                        case (true) {
                                        keepd = false;
                                        this.eliminated++;
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                            switch (keepd)
                            {
                                case (true) {
                                v.items[k] = d;
                                k++;
                            }
                                default {};
                            };
                        };
                        v.len = k;
                        ->;
                    };
                };
            };

            prune_ns(Node* ns, byte* prefix) -> void
            {
                byte* cur = this.child_prefix(prefix, ns);
                NodeVec* v;
                NameMap* counted;
                int i;
                int k;
                int j;
                int jk;
                Node* f;
                Node* o;
                Node* m;
                bool lv;
                bool keepd;
                byte* full;
                byte* anchor;
                Buf kq;
                Buf fq;
                kq.__init();
                fq.__init();
                defer kq.__exit();
                defer fq.__exit();


                v = ns.l0;
                switch (v != (NodeVec*)0)
                {
                    case (true) {
                    counted = nm_new();
                    i = 0;
                    while (i < v.len)
                    {
                        f = v.items[i];
                        i++;
                        switch (f.kind != NodeKind.FUNCTION_DEF)
                        {
                            case (true) { continue; }
                            default
                            {
                                switch (f.text == (byte*)0)
                                {
                                    case (true) { continue; }
                                    default
                                    {
                                        switch (nm_has(this.live, this.count_key(f)))
                                        {
                                            case (true) { nm_put(counted, f.text, (void*)1); }
                                            default {};
                                        };
                                    };
                                };
                            };
                        };
                    };
                    i = 0;
                    k = 0;
                    while (i < v.len)
                    {
                        f = v.items[i];
                        i++;
                        keepd = true;
                        switch (f.kind == NodeKind.FUNCTION_DEF & f.text != (byte*)0)
                        {
                            case (true) {
                            lv = this.any_suffix_live(this.join_prefix(cur, f.text));
                            switch (lv)
                            {
                                case (true) {
                                switch (nm_has(counted, f.text))
                                {
                                    case (true) { lv = nm_has(this.live, this.count_key(f)); }
                                    default {};
                                };
                            }
                                default {};
                            };
                            switch (!(this.is_entry(f) | lv))
                            {
                                case (true) {
                                keepd = false;
                                this.eliminated++;
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                        switch (keepd)
                        {
                            case (true) {
                            v.items[k] = f;
                            k++;
                        }
                            default {};
                        };
                    };
                    v.len = k;
                    nm_free(counted);
                }
                    default {};
                };


                switch (ns.a != (Node*)0)
                {
                    case (true) { this.prune_named(ns.a.l0, cur); }
                    default {};
                };
                this.prune_named(ns.l1, cur);
                this.prune_named(ns.l3, cur);
                this.prune_named(ns.l4, cur);


                v = ns.l2;
                switch (v != (NodeVec*)0)
                {
                    case (true) {
                    i = 0;
                    k = 0;
                    while (i < v.len)
                    {
                        o = v.items[i];
                        i++;
                        keepd = true;
                        switch (o.kind != NodeKind.OBJECT_DEF)
                        {
                            case (true) {
                            switch (o.text != (byte*)0)
                            {
                                case (true) {
                                switch (o.text[0] != 0)
                                {
                                    case (true) {
                                    switch (!this.type_live(cur, o.text))
                                    {
                                        case (true) {
                                        keepd = false;
                                        this.eliminated++;
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        }
                            default {
                                switch (o.text != (byte*)0)
                                {
                                    case (true) {
                            switch (!this.type_live(cur, o.text))
                            {
                                case (true) {
                                keepd = false;
                                this.eliminated++;
                            }
                                default {switch (o.l1 != (NodeVec*)0)
{
    case (true) {
                                j = 0;
                                jk = 0;
                                while (j < o.l1.len)
                                {
                                    m = o.l1.items[j];
                                    j++;
                                    lv = true;
                                    switch (m.text != (byte*)0)
                                    {
                                        case (true) {
                                        kq.clear();
                                        kq.put_str(f"{o.text}__{m.text}\0");
                                        anchor = kq.mem;
                                        fq.clear();
                                        switch (cur[0] != 0)
                                        {
                                            case (true) {
                                            fq.put_str(f"{cur}__\0");
                                        }
                                            default {};
                                        };
                                        fq.put_str(anchor);
                                        full = fq.mem;
                                        lv = this.method_live(full, anchor);
                                        switch (!lv)
                                        {
                                            case (true) {
                                            switch (nm_has(this.live, m.text))
                                            {
                                                case (true) { lv = true; }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    switch (lv)
                                    {
                                        case (true) {
                                        o.l1.items[jk] = m;
                                        jk++;
                                    }
                                        default { this.eliminated++; };
                                    };
                                };
                                o.l1.len = jk;
                            }
    default {};
};};
                            };
                        }
                                    default {};
                                };
                            };
                        };
                        switch (keepd)
                        {
                            case (true) {
                            v.items[k] = o;
                            k++;
                        }
                            default {};
                        };
                    };
                    v.len = k;
                }
                    default {};
                };

                switch (ns.b != (Node*)0)
                {
                    case (true) {
                    i = 0;
                    while (i < dce_count(ns.b, 0))
                    {
                        this.prune_ns(node_child(ns.b, 0, i), cur);
                        i++;
                    };
                }
                    default {};
                };
                ->;
            };


            method_live(byte* full, byte* anchor) -> bool
            {
                int i = 0;
                switch (nm_has(this.live, full))
                {
                    case (true) { -> true; }
                    default
                    {
                        while (full[i] != 0)
                        {
                            switch (full[i] == '_')
                            {
                                case (true) {
                                switch (full[i + 1] == '_')
                                {
                                    case (true) {
                                    i = i + 2;
                                    switch (full[i] != 0)
                                    {
                                        case (true) {
                                        switch (dce_contains(full + i, anchor))
                                        {
                                            case (true) {
                                            switch (nm_has(this.live, full + i))
                                            {
                                                case (true) { -> true; }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    continue;
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                            i++;
                        };
                        -> false;
                    };
                };
            };


            run(Node* prog) -> int
            {
                int c;
                int i;
                int k;
                Node* s;
                Node* ns;
                bool keepd;
                this.compute_live(prog);
                c = dce_count(prog, 0);

                i = 0;
                k = 0;
                while (i < c)
                {
                    s = node_child(prog, 0, i);
                    i++;
                    keepd = true;
                    switch (s.kind == NodeKind.FUNCTION_DEF & s.text != (byte*)0)
                    {
                        case (true) {
                        switch (!(this.is_entry(s) | this.any_suffix_live(s.text)))
                        {
                            case (true) {
                            keepd = false;
                            this.eliminated++;
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    switch (keepd)
                    {
                        case (true) {
                        prog.l0.items[k] = s;
                        k++;
                    }
                        default {};
                    };
                };
                prog.l0.len = k;
                c = k;
                i = 0;
                while (i < c)
                {
                    ns = this.ns_of(node_child(prog, 0, i));
                    i++;
                    switch (ns != (Node*)0)
                    {
                        case (true) { this.prune_ns(ns, g"\0"); }
                        default {};
                    };
                };
                -> this.eliminated;
            };
        };


        eliminate(Node* prog, byte* entry) -> int
        {
            Dce d(entry);
            defer d.__exit();
            -> d.run(prog);
        };


        eliminate_roots(Node* prog, byte* entry, PtrVec* roots) -> int
        {
            Dce d(entry);
            defer d.__exit();
            d.extra_roots = roots;
            -> d.run(prog);
        };
    };
};


































using IDEKA::ast;
using IDEKA::preprocessor;
using IDEKA::types;

namespace IDEKA
{
    namespace unused
    {
        struct FuEnt
        {
            byte* name;
            Node* node;
            bool used;
        };

        struct FuState
        {
            PtrVec* scopes;        
            PtrVec* found;         
            byte* src;
            int n;
            int* lmap;
            int lmapn;
            byte** lfiles;
            bool color;
        };

        fu_push(FuState* st) -> void
        {
            pv_push(st.scopes, (void*)pv_new());
        };

        fu_pop(FuState* st) -> void
        {
            PtrVec* sc = (PtrVec*)st.scopes.items[st.scopes.len - 1];
            FuEnt* e;
            int i;
            st.scopes.len = st.scopes.len - 1;
            while (i < sc.len)
            {
                e = (FuEnt*)sc.items[i];

                if (!e.used) { pv_push(st.found, (void*)e); }
                else { ffree((byte*)e); };
                i++;
            };
            pv_free(sc);
        };

        fu_use(FuState* st, byte* name) -> void
        {
            PtrVec* sc;
            FuEnt* e;
            int s = st.scopes.len - 1;
            int i;
            if (name == (byte*)0) { ->; };
            while (s >= 0)
            {
                sc = (PtrVec*)st.scopes.items[s];
                i = 0;
                while (i < sc.len)
                {
                    e = (FuEnt*)sc.items[i];
                    if (cstr_eq(e.name, name))
                    {
                        e.used = true;
                        ->;
                    };
                    i++;
                };
                s--;
            };
        };

        fu_ends_with(byte* s, byte* suffix) -> bool
        {
            int n = 0;
            int m = 0;
            int i;
            while (s[n] != 0) { n++; };
            while (suffix[m] != 0) { m++; };
            if (m > n) { -> false; };
            while (i < m)
            {
                if (s[n - m + i] != suffix[i]) { -> false; };
                i++;
            };
            -> true;
        };

        fu_declare(FuState* st, Node* d) -> void
        {
            PtrVec* sc;
            FuEnt* e;
            if (st.scopes.len == 0) { ->; };
            if ((d.flags `& 4) != 0) { ->; };
            if (d.text == (byte*)0) { ->; };
            if (d.text[0] == 0 | d.text[0] == '_') { ->; };
            if (d.ts != (TypeSpec*)0)
            {
                if (d.ts.storage_class == StorageClass.GLOBAL | d.ts.storage_class == StorageClass.SINGINIT) { ->; };
            };
            if (d.a != (Node*)0)
            {
                if (d.a.kind == NodeKind.STRUCT_RECAST) { ->; };
                if (d.a.kind == NodeKind.FUNCTION_CALL)
                {
                    if (d.a.text != (byte*)0)
                    {
                        if (fu_ends_with(d.a.text, ".__init\0")) { ->; };
                    };
                };
            };
            e = (FuEnt*)fmalloc((u64)((sizeof(FuEnt) + 7) / 8));
            e.name = d.text;
            e.node = d;
            e.used = false;
            sc = (PtrVec*)st.scopes.items[st.scopes.len - 1];
            pv_push(sc, (void*)e);
            ->;
        };

        def fu_walk(FuState* st, Node* n) -> void;

        fu_walk_list(FuState* st, Node* n, int s) -> void
        {
            int c = node_count(n, s);
            int i;
            while (i < c)
            {
                fu_walk(st, node_child(n, s, i));
                i++;
            };
        };


        fu_asm_operands(FuState* st, byte* c) -> void
        {
            int i, a, b;
            byte sv;
            if (c == (byte*)0) { ->; };
            while (c[i] != (byte)0)
            {
                if (c[i] == (byte)34)
                {
                    i++;
                    while (c[i] != (byte)0 & c[i] != (byte)34) { i++; };
                    if (c[i] == (byte)34) { i++; };
                    while (c[i] == (byte)32) { i++; };
                    if (c[i] == (byte)40)
                    {
                        i++;
                        a = i;
                        while (c[i] != (byte)0 & c[i] != (byte)41) { i++; };
                        b = i;
                        while (a < b & c[a] == (byte)32) { a++; };
                        while (b > a & c[b - 1] == (byte)32) { b--; };
                        sv = c[b];
                        c[b] = (byte)0;
                        fu_use(st, @c[a]);
                        c[b] = sv;
                    };
                }
                else { i++; };
            };
            ->;
        };

        fu_walk(FuState* st, Node* n) -> void
        {
            int k, s;
            bool scoped;
            PtrVec* saved;
            if (n == (Node*)0) { ->; };
            k = n.kind;
            if (k == NodeKind.FUNCTION_DEF)
            {
                saved = st.scopes;
                st.scopes = pv_new();
                fu_push(st);
                fu_walk_list(st, n, 0);
                fu_walk(st, n.a);
                fu_pop(st);
                pv_free(st.scopes);
                st.scopes = saved;
                ->;
            };
            if (k == NodeKind.VARIABLE_DECLARATION)
            {
                fu_walk(st, n.a);
                fu_declare(st, n);
                ->;
            };
            if (k == NodeKind.IDENTIFIER | k == NodeKind.STRINGIFY)
            {
                fu_use(st, n.text);
                ->;
            };
            if (k == NodeKind.INLINE_ASM)
            {
                fu_asm_operands(st, n.text2);
                ->;
            };
            scoped = false;
            if (st.scopes.len > 0)
            {
                if (k == NodeKind.BLOCK | k == NodeKind.FOR_LOOP | k == NodeKind.FOR_IN_LOOP) { scoped = true; };
            };
            if (scoped) { fu_push(st); };
            if (k == NodeKind.FUNCTION_CALL) { fu_use(st, n.text); };
            fu_walk(st, n.a);
            fu_walk(st, n.b);
            fu_walk(st, n.c);
            fu_walk(st, n.d);
            fu_walk(st, n.e);
            s = 0;
            while (s < 6)
            {

                if (!(k == NodeKind.FOR_IN_LOOP & s == 0)) { fu_walk_list(st, n, s); };
                s++;
            };
            if (scoped) { fu_pop(st); };
            ->;
        };

        fu_is_stdlib(byte* path) -> bool
        {
            int i = 0;
            int seg = 0;
            int j;
            byte* want = "stdlib\0";
            if (path == (byte*)0) { -> false; };
            while (true)
            {

                i = seg;
                while (path[i] != 0 & path[i] != '/' & path[i] != 92) { i++; };
                if (i - seg == 6)
                {
                    j = 0;
                    while (j < 6)
                    {
                        if (path[seg + j] != want[j]) { break; };
                        j++;
                    };
                    if (j == 6) { -> true; };
                };
                if (path[i] == 0) { break; };
                seg = i + 1;
            };
            -> false;
        };

        fu_ident_char(byte c) -> bool
        {
            -> (c >= 'a' & c <= 'z') | (c >= 'A' & c <= 'Z') | (c >= '0' & c <= '9') | c == '_';
        };


        fu_name_col(FuState* st, int line, int col, byte* name) -> int
        {
            int ls, le, nl, i, j;
            bool ok;
            if (!IDEKA::errors::line_bounds(st.src, st.n, line, @ls, @le)) { -> col; };
            while (name[nl] != 0) { nl++; };
            i = ls;
            if (col > 1) { i = ls + col - 1; };
            while (i + nl <= le)
            {
                ok = true;
                j = 0;
                while (j < nl)
                {
                    if (st.src[i + j] != name[j]) { ok = false; break; };
                    j++;
                };
                if (ok)
                {
                    if (i > ls) { if (fu_ident_char(st.src[i - 1])) { ok = false; }; };
                    if (i + nl < le) { if (fu_ident_char(st.src[i + nl])) { ok = false; }; };
                };
                if (ok) { -> i - ls + 1; };
                i++;
            };
            -> col;
        };


        unused_warnings(Node* prog, byte* src, int n, int* lmap, int lmapn, byte** lfiles, bool color) -> int
        {
            FuState st;
            FuEnt* a;
            FuEnt* b;
            PtrVec* rep = pv_new();
            PtrVec* keys = pv_new();
            Buf mb, wb, kb;
            int i, j, col, ll, cnt;
            byte* fl;
            st.scopes = pv_new();
            st.found = pv_new();
            st.src = src;
            st.n = n;
            st.lmap = lmap;
            st.lmapn = lmapn;
            st.lfiles = lfiles;
            st.color = color;
            fu_walk_list(@st, prog, 0);

            i = 1;
            while (i < st.found.len)
            {
                a = (FuEnt*)st.found.items[i];
                j = i - 1;
                while (j >= 0)
                {
                    b = (FuEnt*)st.found.items[j];
                    if (b.node.line > a.node.line | (b.node.line == a.node.line & b.node.col > a.node.col))
                    {
                        st.found.items[j + 1] = st.found.items[j];
                        j--;
                    }
                    else { break; };
                };
                st.found.items[j + 1] = (void*)a;
                i++;
            };
            kb.__init();
            defer kb.__exit();
            i = 0;
            while (i < st.found.len)
            {
                a = (FuEnt*)st.found.items[i];
                i++;
                fl = (byte*)0;
                ll = a.node.line;
                if (lfiles != (byte**)0 & a.node.line >= 1 & a.node.line <= lmapn) { fl = lfiles[a.node.line - 1]; };
                if (lmap != (int*)0 & a.node.line >= 1 & a.node.line <= lmapn) { ll = lmap[a.node.line - 1]; };
                if (fu_is_stdlib(fl)) { continue; };
                kb.clear();
                if (fl != (byte*)0) { kb.put_str(fl); };
                kb.put_str("|\0");
                kb.put_int(ll);
                kb.put_str("|\0");
                kb.put_int(a.node.col);
                kb.put_str("|\0");
                kb.put_str(a.name);
                j = 0;
                cnt = 0;
                while (j < keys.len)
                {
                    if (cstr_eq((byte*)keys.items[j], kb.mem)) { cnt = 1; };
                    j++;
                };
                if (cnt == 1) { continue; };
                pv_push(keys, (void*)ts_dup(kb.mem));
                pv_push(rep, (void*)a);
            };
            i = 0;
            while (i < rep.len)
            {
                a = (FuEnt*)rep.items[i];
                i++;
                col = fu_name_col(@st, a.node.line, a.node.col, a.name);
                mb.__init();
                wb.__init();
                mb.put_str("Warning: unused variable '\0");
                mb.put_str(a.name);
                mb.put_str("'\0");
                IDEKA::errors::render(@wb, color, IDEKA::errors::SEV_WARNING, mb.mem, a.node.line, col, src, n, lmap, lmapn, lfiles, -1, 0, 0, 0, (byte*)0);
                println(wb.mem);
                mb.__exit();
                wb.__exit();
            };
            cnt = rep.len;
            i = 0;
            while (i < st.found.len)
            {
                ffree((byte*)st.found.items[i]);
                i++;
            };
            i = 0;
            while (i < keys.len)
            {
                ffree((byte*)keys.items[i]);
                i++;
            };
            pv_free(st.found);
            pv_free(st.scopes);
            pv_free(keys);
            pv_free(rep);
            -> cnt;
        };
    };
};






































using IDEKA::ast;
using IDEKA::preprocessor;
using IDEKA::types;
using IDEKA::lexer;

namespace IDEKA
{
    namespace borrow
    {




        def bc_len(byte* s) -> int
        {
            int n = 0;
            while (s[n] != 0) { n++; };
            return n;
        };

        def bc_starts(byte* s, byte* p) -> bool
        {
            int i = 0;
            while (p[i] != 0)
            {
                if (s[i] != p[i]) { return false; };
                i++;
            };
            return true;
        };

        def bc_ends(byte* s, byte* suf) -> bool
        {
            int ls = bc_len(s);
            int lf = bc_len(suf);
            if (lf > ls) { return false; };
            return cstr_eq(s + (ls - lf), suf);
        };

        def bc_lower(int c) -> int
        {
            if (c >= 65 & c <= 90) { return c + 32; };
            return c;
        };


        def bc_has_ci(byte* s, byte* needle) -> bool
        {
            int i = 0;
            int j;
            bool hit;
            while (s[i] != 0)
            {
                j = 0;
                hit = true;
                while (needle[j] != 0)
                {
                    if (bc_lower((int)s[i + j]) != (int)needle[j])
                    {
                        hit = false;
                        break;
                    };
                    j++;
                };
                if (hit) { return true; };
                i++;
            };
            return false;
        };


        def bc_last_seg(byte* s) -> byte*
        {
            int i = 0;
            int start = 0;
            while (s[i] != 0)
            {
                if (s[i] == '_' & s[i + 1] == '_')
                {
                    start = i + 2;
                    i = i + 2;
                }
                else
                {
                    i++;
                };
            };
            return ts_dup(s + start);
        };



        def bc_overload_base(byte* s) -> byte*
        {
            int start = 0;
            int j;
            bool digits;
            int pend;
            byte* r;

            while (true)
            {
                pend = start;
                while (s[pend] != 0)
                {
                    if (s[pend] == '_' & s[pend + 1] == '_') { break; };
                    pend++;
                };
                digits = pend > start;
                j = start;
                while (j < pend)
                {
                    if (s[j] < '0' | s[j] > '9') { digits = false; };
                    j++;
                };
                if (digits)
                {
                    if (start == 0) { return ts_dup(g"\0"); };
                    r = (byte*)fmalloc((u64)(start - 2 + 1));
                    j = 0;
                    while (j < start - 2)
                    {
                        r[j] = s[j];
                        j++;
                    };
                    r[start - 2] = (byte)0;
                    return r;
                };
                if (s[pend] == 0) { break; };
                start = pend + 2;
            };
            return ts_dup(s);
        };


        def bc_mangled_arity(byte* s) -> int
        {
            int start = 0;
            int pend;
            int j;
            int v;
            bool digits;
            while (true)
            {
                pend = start;
                while (s[pend] != 0)
                {
                    if (s[pend] == '_' & s[pend + 1] == '_') { break; };
                    pend++;
                };
                digits = pend > start;
                v = 0;
                j = start;
                while (j < pend)
                {
                    if (s[j] < '0' | s[j] > '9') { digits = false; };
                    v = v * 10 + (int)(s[j] - '0');
                    j++;
                };
                if (digits) { return v; };
                if (s[pend] == 0) { break; };
                start = pend + 2;
            };
            return -1;
        };

        def bx_new(int v) -> int*
        {
            int* p = (int*)fmalloc((u64)((sizeof(int) + 7) / 8));
            p[0] = v;
            return p;
        };






        struct OMap
        {
            PtrVec* ks;
            PtrVec* vs;
        };

        def om_new() -> OMap*
        {
            OMap* m = (OMap*)fmalloc((u64)((sizeof(OMap) + 7) / 8));
            m.ks = pv_new();
            m.vs = pv_new();
            return m;
        };


        def om_free(OMap* m) -> void
        {
            if (m == (OMap*)0) { return; };
            pv_free(m.ks);
            pv_free(m.vs);
            ffree((byte*)m);
            return;
        };

        def om_find(OMap* m, byte* key) -> int
        {
            int i = 0;
            while (i < m.ks.len)
            {
                if (cstr_eq((byte*)m.ks.items[i], key)) { return i; };
                i++;
            };
            return -1;
        };

        def om_has(OMap* m, byte* key) -> bool -> om_find(m, key) >= 0;

        def om_get(OMap* m, byte* key) -> void*
        {
            int i = om_find(m, key);
            if (i < 0) { return (void*)0; };
            return m.vs.items[i];
        };

        def om_put(OMap* m, byte* key, void* v) -> void
        {
            int i = om_find(m, key);
            if (i >= 0)
            {
                m.vs.items[i] = v;
                return;
            };
            pv_push(m.ks, (void*)key);
            pv_push(m.vs, v);
            return;
        };

        def om_remove_at(OMap* m, int at) -> void
        {
            int j = at;
            while (j < m.ks.len - 1)
            {
                m.ks.items[j] = m.ks.items[j + 1];
                m.vs.items[j] = m.vs.items[j + 1];
                j++;
            };
            m.ks.len--;
            m.vs.len--;
            return;
        };

        def om_del(OMap* m, byte* key) -> void
        {
            int i = om_find(m, key);
            if (i >= 0) { om_remove_at(m, i); };
            return;
        };

        def om_clear(OMap* m) -> void
        {
            m.ks.len = 0;
            m.vs.len = 0;
            return;
        };

        def om_copy(OMap* m) -> OMap*
        {
            OMap* r = om_new();
            int i = 0;
            while (i < m.ks.len)
            {
                pv_push(r.ks, m.ks.items[i]);
                pv_push(r.vs, m.vs.items[i]);
                i++;
            };
            return r;
        };





        struct BPtr
        {
            byte* var_name;
            byte* site;
            byte* func_name;
            byte* file;
            bool mut;
            int depth;
            int line;
        };

        struct BPos
        {
            byte* file;
            int line;
        };

        struct BVio
        {
            byte* kind;
            byte* msg;
            byte* file;
            int line;
            PtrVec* detail;     
            byte* func;         
        };

        struct ScopeFrame
        {
            int depth;
            byte* func_name;
            OMap* ptrs;         
            OMap* owned;        
            OMap* var_sites;    
        };

        def bpos_new(byte* file, int line) -> BPos*
        {
            BPos* p = (BPos*)fmalloc((u64)((sizeof(BPos) + 7) / 8));
            p.file = file;
            p.line = line;
            return p;
        };

        def frame_new(int depth, byte* func_name) -> ScopeFrame*
        {
            ScopeFrame* f = (ScopeFrame*)fmalloc((u64)((sizeof(ScopeFrame) + 7) / 8));
            f.depth = depth;
            f.func_name = func_name;
            f.ptrs = om_new();
            f.owned = om_new();
            f.var_sites = om_new();
            return f;
        };





        object AliasMap
        {
            PtrVec* frames;         
            PtrVec* violations;     
            byte* func_name;
            OMap* heap_sites;       
            OMap* freed_sites;      
            OMap* alloc_sizes;      
            OMap* escaped_sites;    
            Buf sb;

            __init() -> this
            {
                this.frames = pv_new();
                this.violations = pv_new();
                this.func_name = g"<global>\0";
                this.heap_sites = om_new();
                this.freed_sites = om_new();
                this.alloc_sizes = om_new();
                this.escaped_sites = om_new();
                this.sb.__init();
                -> this;
            };

            __expr() -> AliasMap* -> this;

            __exit() -> void
            {
                -> this.sb.__exit();
            };


            take() -> byte* -> ts_dup(this.sb.mem);

            add_vio(byte* kind, byte* msg, byte* file, int line, PtrVec* detail) -> void
            {
                BVio* v = (BVio*)fmalloc((u64)((sizeof(BVio) + 7) / 8));
                v.kind = kind;
                v.msg = msg;
                v.file = file;
                v.line = line;
                v.detail = detail;
                v.func = this.func_name;
                switch (detail == (PtrVec*)0)
                {
                    case (true) { v.detail = pv_new(); }
                    default {};
                };
                -> pv_push(this.violations, (void*)v);
            };


            loc_text(byte* file, int line) -> byte*
            {
                this.sb.clear();
                this.sb.put_str(f"{file}:{line}\0");
                -> this.take();
            };



            push_scope() -> void
            {
                -> pv_push(this.frames, (void*)frame_new(this.frames.len, this.func_name));
            };

            pop_scope() -> void
            {
                int fi;
                int k;
                ScopeFrame* f;
                BPtr* p;
                ScopeFrame* frame;
                switch (this.frames.len == 0)
                {
                    case (true) { ->; }
                    default
                    {
                        frame = (ScopeFrame*)this.frames.items[this.frames.len - 1];
                        this.frames.len--;
                        switch (frame.owned.ks.len > 0)
                        {
                            case (true) { this.check_escape_after_pop(frame.owned); }
                            default {};
                        };
                        while (fi < this.frames.len)
                        {
                            f = (ScopeFrame*)this.frames.items[fi];
                            k = 0;
                            while (k < f.ptrs.ks.len)
                            {
                                p = (BPtr*)f.ptrs.vs.items[k];
                                switch (p.depth == frame.depth)
                                {
                                    case (true) { om_remove_at(f.ptrs, k); }
                                    default { k++; };
                                };
                            };
                            fi++;
                        };
                        ->;
                    };
                };
            };

            check_escape_after_pop(OMap* dead) -> void
            {
                int fi;
                int k;
                ScopeFrame* f;
                BPtr* p;
                byte* msg;
                while (fi < this.frames.len)
                {
                    f = (ScopeFrame*)this.frames.items[fi];
                    k = 0;
                    while (k < f.ptrs.ks.len)
                    {
                        p = (BPtr*)f.ptrs.vs.items[k];
                        switch (om_has(dead, p.site))
                        {
                            case (true) {
                            this.sb.clear();
                            this.sb.put_str(f"pointer '{p.var_name}' outlives its stack allocation '{p.site}' (allocation scope exited)\0");
                            msg = this.take();
                            this.add_vio(g"scope_escape\0", msg, p.file, p.line, (PtrVec*)0);
                        }
                            default {};
                        };
                        k++;
                    };
                    fi++;
                };
                ->;
            };



            find_ptr(byte* var_name) -> BPtr*
            {
                int fi = this.frames.len - 1;
                ScopeFrame* f;
                int k;
                while (fi >= 0)
                {
                    f = (ScopeFrame*)this.frames.items[fi];
                    k = om_find(f.ptrs, var_name);
                    switch (k >= 0)
                    {
                        case (true) { -> (BPtr*)f.ptrs.vs.items[k]; }
                        default
                        {
                            fi--;
                        };
                    };
                };
                -> (BPtr*)0;
            };

            declare_ptr(byte* var_name, byte* site, bool mutable, byte* file, int line,
                        bool is_stack_owner) -> void
            {
                ScopeFrame* frame;
                BPtr* info;
                switch (this.frames.len == 0)
                {
                    case (true) { ->; }
                    default
                    {
                        frame = (ScopeFrame*)this.frames.items[this.frames.len - 1];
                        switch (is_stack_owner)
                        {
                            case (true) { om_put(frame.owned, site, (void*)1); }
                            default {};
                        };
                        info = (BPtr*)fmalloc((u64)((sizeof(BPtr) + 7) / 8));
                        info.var_name = var_name;
                        info.site = site;
                        info.mut = mutable;
                        info.depth = frame.depth;
                        info.func_name = this.func_name;
                        info.file = file;
                        info.line = line;
                        -> om_put(frame.ptrs, var_name, (void*)info);
                    };
                };
            };

            assign_ptr(byte* var_name, byte* site, bool mutable, byte* file, int line) -> void
            {
                BPtr* info = this.find_ptr(var_name);
                byte* old_site;
                bool still_used;
                int fi;
                int k;
                ScopeFrame* f;
                BPtr* p;
                switch (info == (BPtr*)0)
                {
                    case (true) {
                    this.declare_ptr(var_name, site, mutable, file, line, false);
                    ->;
                }
                    default
                    {
                        old_site = info.site;
                        info.site = site;
                        info.mut = mutable;
                        info.file = file;
                        info.line = line;
                        switch (old_site[0] != 0 & om_has(this.freed_sites, old_site) & !cstr_eq(site, old_site)
                                & !bc_starts(site, g"freed:\0"))
                        {
                            case (true) {
                            still_used = false;
                            fi = 0;
                            while (fi < this.frames.len)
                            {
                                f = (ScopeFrame*)this.frames.items[fi];
                                k = 0;
                                while (k < f.ptrs.ks.len)
                                {
                                    p = (BPtr*)f.ptrs.vs.items[k];
                                    switch (cstr_eq(p.site, old_site) & !cstr_eq(p.var_name, var_name))
                                    {
                                        case (true) { still_used = true; }
                                        default {};
                                    };
                                    k++;
                                };
                                fi++;
                            };
                            switch (!still_used)
                            {
                                case (true) { om_del(this.freed_sites, old_site); }
                                default {};
                            };
                        }
                            default {};
                        };
                        ->;
                    };
                };
            };



            record_malloc(byte* site, byte* file, int line) -> void
            {
                -> om_put(this.heap_sites, site, (void*)bpos_new(file, line));
            };

            record_free(byte* site) -> void
            {
                -> om_del(this.heap_sites, site);
            };


            base_site(byte* site) -> byte*
            {
                switch (bc_starts(site, g"derived:\0"))
                {
                    case (true) { -> site + 8; }
                    default
                    {
                        -> site;
                    };
                };
            };

            mark_freed(byte* site, byte* file, int line) -> void
            {
                switch (site[0] != 0 & !cstr_eq(site, g"unknown\0") & !bc_starts(site, g"derived:\0"))
                {
                    case (true) { om_put(this.freed_sites, site, (void*)bpos_new(file, line)); }
                    default {};
                };
                ->;
            };

            check_use_after_free(byte* var_name, byte* file, int line) -> void
            {
                BPtr* info = this.find_ptr(var_name);
                byte* site;
                byte* base;
                byte* matched = (byte*)0;
                BPos* fp;
                PtrVec* det;
                switch (info == (BPtr*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        site = info.site;
                        base = this.base_site(site);
                        switch (om_has(this.freed_sites, site))
                        {
                            case (true) { matched = site; }
                            default {
                            switch (!cstr_eq(base, site))
                            {
                                case (true) {
                                switch (om_has(this.freed_sites, base))
                                {
                                    case (true) { matched = base; }
                                    default {};
                                };
                            }
                                default {};
                            };
                        };
                        };
                        switch (matched == (byte*)0)
                        {
                            case (true) { ->; }
                            default
                            {
                                fp = (BPos*)om_get(this.freed_sites, matched);
                                det = pv_new();
                                this.sb.clear();
                                this.sb.put_str(f"ffree called at {fp.file}:{fp.line}\0");
                                pv_push(det, (void*)this.take());
                                this.sb.clear();
                                this.sb.put_str(f"'{var_name}' -> {site} at {file}:{line}\0");
                                pv_push(det, (void*)this.take());
                                this.sb.clear();
                                this.sb.put_str(f"pointer '{var_name}' used after its allocation site '{matched}' was passed to ffree\0");
                                -> this.add_vio(g"use_after_free\0", this.take(), file, line, det);
                            };
                        };
                    };
                };
            };

            record_alloc_size(byte* site, int size) -> void
            {
                switch (site[0] != 0 & !cstr_eq(site, g"unknown\0") & !bc_starts(site, g"derived:\0"))
                {
                    case (true) { om_put(this.alloc_sizes, site, (void*)bx_new(size)); }
                    default {};
                };
                ->;
            };


            check_bounds(byte* var_name, int index, byte* file, int line, bool write) -> void
            {
                BPtr* info = this.find_ptr(var_name);
                byte* site;
                byte* base;
                byte* lookup;
                int size;
                PtrVec* det;
                switch (info == (BPtr*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        site = info.site;
                        base = this.base_site(site);
                        switch (om_has(this.alloc_sizes, site))
                        {
                            case (true) { lookup = site; }
                            default {
                            switch (!cstr_eq(base, site) & om_has(this.alloc_sizes, base))
                            {
                                case (true) { lookup = base; }
                                default { ->; };
                            };
                        };
                        };
                        size = ((int*)om_get(this.alloc_sizes, lookup))[0];
                        switch (size < 0)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch (index < 0 | index >= size)
                                {
                                    case (true) {
                                    det = pv_new();
                                    this.sb.clear();
                                    this.sb.put_str(f"'{var_name}' -> {site} (size {size}) at {file}:{line}\0");
                                    pv_push(det, (void*)this.take());
                                    this.sb.clear();
                                    this.sb.put_str(f"index {index}\0");
                                    switch (index < 0)
                                    {
                                        case (true) { this.sb.put_str(g" < 0\0"); }
                                        default { this.sb.put_str(g" >= size\0"); };
                                    };
                                    pv_push(det, (void*)this.take());
                                    this.sb.clear();
                                    this.sb.put_str(g"array \0");
                                    switch (write)
                                    {
                                        case (true) { this.sb.put_str(g"write\0"); }
                                        default { this.sb.put_str(g"access\0"); };
                                    };
                                    this.sb.put_str(f" through '{var_name}' at index {index} is out of bounds for site '{lookup}' (size {size})\0");
                                    switch (write)
                                    {
                                        case (true) { this.add_vio(g"buffer_overflow\0", this.take(), file, line, det); }
                                        default { this.add_vio(g"out_of_bounds\0", this.take(), file, line, det); };
                                    };
                                }
                                    default {};
                                };
                                ->;
                            };
                        };
                    };
                };
            };


            check_heap_leaks() -> void
            {
                int i;
                BPos* p;
                while (i < this.heap_sites.ks.len)
                {
                    p = (BPos*)this.heap_sites.vs.items[i];
                    this.sb.clear();
                    this.sb.put_str(g"heap allocation '\0");
                    this.sb.put_str((byte*)this.heap_sites.ks.items[i]);
                    this.sb.put_str(g"' has no reachable ffree on all paths\0");
                    this.add_vio(g"heap_leak\0", this.take(), p.file, p.line, (PtrVec*)0);
                    i++;
                };
                om_clear(this.heap_sites);
                om_clear(this.freed_sites);
                -> om_clear(this.alloc_sizes);
            };



            mut_text(bool m) -> byte*
            {
                switch (m)
                {
                    case (true) { -> g"mutable\0"; }
                    default
                    {
                        -> g"immutable\0";
                    };
                };
            };


            alias_line(byte* name, byte* site, bool m, byte* file, int line) -> byte*
            {
                this.sb.clear();
                this.sb.put_str(f"'{name}' -> {site} ({this.mut_text(m)}) at {file}:{line}\0");
                -> this.take();
            };


            check_write_alias(byte* var_name, byte* file, int line) -> void
            {
                BPtr* info = this.find_ptr(var_name);
                BPtr* ex;
                byte* site;
                byte* base;
                byte* ex_base;
                int fi;
                int k;
                ScopeFrame* f;
                PtrVec* det;
                switch (info == (BPtr*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        site = info.site;
                        base = this.base_site(site);
                        while (fi < this.frames.len)
                        {
                            f = (ScopeFrame*)this.frames.items[fi];
                            k = 0;
                            while (k < f.ptrs.ks.len)
                            {
                                ex = (BPtr*)f.ptrs.vs.items[k];
                                k++;
                                switch (cstr_eq(ex.var_name, var_name))
                                {
                                    case (true) { continue; }
                                    default
                                    {
                                        switch (cstr_eq(ex.site, g"unknown\0"))
                                        {
                                            case (true) { continue; }
                                            default
                                            {
                                                ex_base = this.base_site(ex.site);
                                                switch (om_has(this.freed_sites, ex.site) | om_has(this.freed_sites, ex_base))
                                                {
                                                    case (true) { continue; }
                                                    default
                                                    {
                                                        switch (!cstr_eq(ex_base, base))
                                                        {
                                                            case (true) { continue; }
                                                            default
                                                            {
                                                                switch (!(info.mut | ex.mut))
                                                                {
                                                                    case (true) { continue; }
                                                                    default
                                                                    {
                                                                        det = pv_new();
                                                                        pv_push(det, (void*)this.alias_line(var_name, site, info.mut, file, line));
                                                                        pv_push(det, (void*)this.alias_line(ex.var_name, ex.site, ex.mut, ex.file, ex.line));
                                                                        this.sb.clear();
                                                                        this.sb.put_str(f"mutable alias violation on site '{base}' (write through derived pointer into same allocation)\0");
                                                                        -> this.add_vio(g"mutable_alias\0", this.take(), file, line, det);
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                            fi++;
                        };
                        ->;
                    };
                };
            };



            check_call_args(PtrVec* names, PtrVec* sites, byte* file, int line) -> void
            {
                int i;
                int j;
                byte* sa;
                byte* sb2;
                PtrVec* det;
                while (i < sites.len)
                {
                    sa = (byte*)sites.items[i];
                    switch (cstr_eq(sa, g"unknown\0") | bc_starts(sa, g"derived:\0"))
                    {
                        case (true) { i++; continue; }
                        default
                        {
                            j = i + 1;
                            while (j < sites.len)
                            {
                                sb2 = (byte*)sites.items[j];
                                switch (cstr_eq(sb2, g"unknown\0") | bc_starts(sb2, g"derived:\0"))
                                {
                                    case (true) { j++; continue; }
                                    default
                                    {
                                        switch (cstr_eq(sa, sb2))
                                        {
                                            case (true) {
                                            det = pv_new();
                                            this.sb.clear();
                                            this.sb.put_str(g"argument '\0");
                                            this.sb.put_str((byte*)names.items[i]);
                                            this.sb.put_str(f"' -> {sa} (mutable) at {file}:{line}\0");
                                            pv_push(det, (void*)this.take());
                                            this.sb.clear();
                                            this.sb.put_str(g"argument '\0");
                                            this.sb.put_str((byte*)names.items[j]);
                                            this.sb.put_str(f"' -> {sb2} (mutable) at {file}:{line}\0");
                                            pv_push(det, (void*)this.take());
                                            this.sb.clear();
                                            this.sb.put_str(f"mutable alias violation on site '{sa}'\0");
                                            this.add_vio(g"mutable_alias\0", this.take(), file, line, det);
                                        }
                                            default {};
                                        };
                                        j++;
                                    };
                                };
                            };
                            i++;
                        };
                    };
                };
                ->;
            };



            check_thread_escape(byte* ptr_var, byte* file, int line) -> void
            {
                BPtr* info = this.find_ptr(ptr_var);
                BPtr* ex;
                int fi;
                int k;
                ScopeFrame* f;
                PtrVec* det;
                switch (info == (BPtr*)0)
                {
                    case (true) { ->; }
                    default
                    {

                        while (fi < this.frames.len)
                        {
                            f = (ScopeFrame*)this.frames.items[fi];
                            k = 0;
                            while (k < f.ptrs.ks.len)
                            {
                                ex = (BPtr*)f.ptrs.vs.items[k];
                                k++;
                                switch (cstr_eq(ex.var_name, ptr_var))
                                {
                                    case (true) { continue; }
                                    default
                                    {
                                        switch (!cstr_eq(ex.site, info.site))
                                        {
                                            case (true) { continue; }
                                            default
                                            {
                                                switch (cstr_eq(ex.site, g"unknown\0") | bc_starts(ex.site, g"derived:\0"))
                                                {
                                                    case (true) { continue; }
                                                    default
                                                    {
                                                        switch (ex.mut | info.mut)
                                                        {
                                                            case (true) {
                                                            det = pv_new();
                                                            this.sb.clear();
                                                            this.sb.put_str(f"'{ex.var_name}' -> {ex.site} at {ex.file}:{ex.line}\0");
                                                            pv_push(det, (void*)this.take());
                                                            this.sb.clear();
                                                            this.sb.put_str(f"pointer '{ptr_var}' passed to thread while mutable alias '{ex.var_name}' exists on site '{info.site}'\0");
                                                            this.add_vio(g"thread_escape\0", this.take(), file, line, det);
                                                        }
                                                            default {};
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                            fi++;
                        };

                        switch (info.mut & !cstr_eq(info.site, g"unknown\0") & !bc_starts(info.site, g"derived:\0"))
                        {
                            case (true) { om_put(this.escaped_sites, info.site, (void*)bpos_new(file, line)); }
                            default {};
                        };
                        ->;
                    };
                };
            };

            check_use_after_escape(byte* ptr_var, byte* file, int line) -> void
            {
                BPtr* info = this.find_ptr(ptr_var);
                byte* site;
                byte* base;
                byte* matched = (byte*)0;
                BPos* sp;
                PtrVec* det;
                switch (info == (BPtr*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        site = info.site;
                        base = this.base_site(site);
                        switch (om_has(this.escaped_sites, site))
                        {
                            case (true) { matched = site; }
                            default {
                            switch (!cstr_eq(base, site) & om_has(this.escaped_sites, base))
                            {
                                case (true) { matched = base; }
                                default {};
                            };
                        };
                        };
                        switch (matched == (byte*)0)
                        {
                            case (true) { ->; }
                            default
                            {
                                sp = (BPos*)om_get(this.escaped_sites, matched);
                                switch (sp.line == line)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        det = pv_new();
                                        this.sb.clear();
                                        this.sb.put_str(f"site escaped to thread at {sp.file}:{sp.line}\0");
                                        pv_push(det, (void*)this.take());
                                        this.sb.clear();
                                        this.sb.put_str(f"'{ptr_var}' -> {site} (mutable) at {file}:{line}\0");
                                        pv_push(det, (void*)this.take());
                                        this.sb.clear();
                                        this.sb.put_str(f"pointer '{ptr_var}' accessed after its site '{matched}' was passed to a thread (potential data race)\0");
                                        -> this.add_vio(g"thread_race\0", this.take(), file, line, det);
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };





        def bc_unk() -> byte* -> g"<unknown>\0";

        def bc_contains(byte* hay, byte* needle) -> bool
        {
            int i = 0;
            int j;
            bool hit;
            while (hay[i] != 0)
            {
                j = 0;
                hit = true;
                while (needle[j] != 0)
                {
                    if (hay[i + j] != needle[j])
                    {
                        hit = false;
                        break;
                    };
                    j++;
                };
                if (hit) { return true; };
                i++;
            };
            return false;
        };

        def bc_count(Node* n, int s) -> int
        {
            if (n == (Node*)0) { return 0; };
            return node_count(n, s);
        };

        def bc_is_pointer_type(TypeSpec* t) -> bool
        {
            if (t == (TypeSpec*)0) { return false; };
            if ((t.flags `& 64) != 0) { return true; };
            return t.pointer_depth > 0;
        };

        def bc_stack_site(byte* func_name, byte* var_name, int line) -> byte*
        {
            Buf b;
            b.__init();
            b.put_str(f"stack:{func_name}:{var_name}@{line}\0");
            byte* r = ts_dup(b.mem);
            b.__exit();
            return r;
        };

        def bc_heap_site(byte* func_name, int line) -> byte*
        {
            Buf b;
            b.__init();
            b.put_str(f"heap:{func_name}:{line}\0");
            byte* r = ts_dup(b.mem);
            b.__exit();
            return r;
        };

        def bc_param_site(byte* func_name, byte* param_name) -> byte*
        {
            Buf b;
            b.__init();
            b.put_str(f"param:{func_name}:{param_name}\0");
            byte* r = ts_dup(b.mem);
            b.__exit();
            return r;
        };

        def bc_prefixed(byte* prefix, byte* s) -> byte*
        {
            Buf b;
            b.__init();
            b.put_str(f"{prefix}{s}\0");
            byte* r = ts_dup(b.mem);
            b.__exit();
            return r;
        };

        def bc_is_call_named(Node* n, byte* name) -> bool
        {
            if (n == (Node*)0) { return false; };
            if (n.kind != NodeKind.FUNCTION_CALL) { return false; };
            if (n.text == (byte*)0) { return false; };
            return cstr_eq(n.text, name);
        };

        def bc_is_fmalloc(Node* n) -> bool -> bc_is_call_named(n, g"fmalloc\0");

        def bc_is_ffree(Node* n) -> bool -> bc_is_call_named(n, g"ffree\0");

        def bc_is_thread_spawn(Node* n) -> bool
        {
            if (n.kind != NodeKind.FUNCTION_CALL & n.kind != NodeKind.METHOD_CALL) { return false; };
            if (n.text == (byte*)0) { return false; };
            return bc_has_ci(n.text, g"spawn\0") | bc_has_ci(n.text, g"thread\0");
        };

        def bc_is_cast(Node* n) -> bool
        {
            return n.kind == NodeKind.CAST_EXPRESSION | n.kind == NodeKind.TYPE_CONVERT_EXPRESSION;
        };


        def bc_unwrap_fn(Node* n) -> Node*
        {
            if (n.kind == NodeKind.FUNCTION_DEF_STATEMENT) { return n.a; };
            return n;
        };

        def bc_is_proto(Node* f) -> bool -> (f.flags `& 512) != 0;






        struct AUse
        {
            byte* key;
            Node* fd, use;
        };

        object CallGraph
        {
            NameMap* funcs;             
            NameMap* short_names;       
            NameMap* overloads;         
            NameMap* visited_main;      
            NameMap* visited_thread;
            NameMap* spawn_count;       
            NameMap* async_names;       
            NameMap* async_tags;        
            PtrVec* async_uses;         
            Buf kb;

            __init() -> this
            {
                this.funcs = nm_new();
                this.short_names = nm_new();
                this.overloads = nm_new();
                this.visited_main = nm_new();
                this.visited_thread = nm_new();
                this.spawn_count = nm_new();
                this.async_names = nm_new();
                this.async_tags = nm_new();
                this.async_uses = pv_new();
                this.kb.__init();
                -> this;
            };

            __expr() -> CallGraph* -> this;

            __exit() -> void
            {
                nm_free(this.funcs);
                nm_free(this.short_names);
                nm_free(this.overloads);
                nm_free(this.visited_main);
                nm_free(this.visited_thread);
                nm_free(this.spawn_count);
                nm_free(this.async_names);
                nm_free(this.async_tags);
                -> this.kb.__exit();
            };


            ctx_key(byte* name, PtrVec* ctx) -> byte*
            {
                int i;
                this.kb.clear();
                this.kb.put_str(f"{name}\x1e\0");
                while (i < ctx.len)
                {
                    switch (i > 0)
                    {
                        case (true) { this.kb.put_str(g"\x1f\0"); }
                        default {};
                    };
                    this.kb.put_str((byte*)ctx.items[i]);
                    i++;
                };
                -> this.kb.mem;
            };

            is_visited(byte* name, PtrVec* ctx, bool thread) -> bool
            {
                byte* k = this.ctx_key(name, ctx);
                switch (thread)
                {
                    case (true) { -> nm_has(this.visited_thread, k); }
                    default
                    {
                        -> nm_has(this.visited_main, k);
                    };
                };
            };

            mark_visited(byte* name, PtrVec* ctx, bool thread) -> void
            {
                byte* k = this.ctx_key(name, ctx);
                switch (thread)
                {
                    case (true) { nm_put(this.visited_thread, k, (void*)1); }
                    default { nm_put(this.visited_main, k, (void*)1); };
                };
                ->;
            };

            note_async(Node* f, byte* key) -> void
            {
                int c = bc_count(f, 1);
                int i;
                AUse* u;
                if ((f.flags `& 2097152) != 0) { nm_put(this.async_names, key, (void*)1); };
                while (i < c)
                {
                    u = (AUse*)fmalloc((u64)((sizeof(AUse) + 7) / 8));
                    u
                    {
                        .key = key;
                        .fd = f;
                        .use = node_child(f, 1, i);
                    };
                    pv_push(this.async_uses, (void*)u);
                    i++;
                };
                ->;
            };

            add_func(byte* name, Node* f) -> void
            {
                -> nm_put(this.funcs, name, (void*)f);
            };

            collect(Node* program) -> void
            {
                int c = bc_count(program, 0);
                int i;
                byte* mangled;
                byte* short_name;
                byte* base;
                NameMap* short_count = nm_new();
                int* cnt;
                PtrVec* lst;
                while (i < c)
                {
                    this.collect_node(node_child(program, 0, i), (byte*)0);
                    i++;
                };

                i = 0;
                while (i < this.funcs.count)
                {
                    switch (this.funcs.vals[i] != (void*)0)
                    {
                        case (true) {
                        short_name = bc_last_seg(this.funcs.keys[i]);
                        cnt = (int*)nm_get(short_count, short_name);
                        switch (cnt == (int*)0)
                        {
                            case (true) { nm_put(short_count, short_name, (void*)bx_new(1)); }
                            default { cnt[0] = cnt[0] + 1; };
                        };
                    }
                        default {};
                    };
                    i++;
                };
                i = 0;
                while (i < this.funcs.count)
                {
                    switch (this.funcs.vals[i] != (void*)0)
                    {
                        case (true) {
                        mangled = this.funcs.keys[i];
                        short_name = bc_last_seg(mangled);
                        cnt = (int*)nm_get(short_count, short_name);
                        switch (cnt[0] == 1)
                        {
                            case (true) { nm_put(this.short_names, short_name, (void*)mangled); }
                            default {};
                        };
                        base = bc_overload_base(mangled);
                        lst = (PtrVec*)nm_get(this.overloads, base);
                        switch (lst == (PtrVec*)0)
                        {
                            case (true) {
                            lst = pv_new();
                            nm_put(this.overloads, base, (void*)lst);
                        }
                            default {};
                        };
                        pv_push(lst, (void*)mangled);
                    }
                        default {};
                    };
                    i++;
                };
                -> nm_free(short_count);
            };

            join_prefix(byte* prefix, byte* name) -> byte*
            {
                switch (prefix == (byte*)0)
                {
                    case (true) { -> ts_dup(name); }
                    default
                    {
                        switch (prefix[0] == 0)
                        {
                            case (true) { -> ts_dup(name); }
                            default
                            {
                                -> join3(prefix, g"__\0", name);
                            };
                        };
                    };
                };
            };

            collect_node(Node* node, byte* ns_prefix) -> void
            {
                int k;
                int i;
                int c;
                Node* f;
                byte* prefix;
                switch (node == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        k = node.kind;
                        switch (k == NodeKind.ASYNC_TAG_DEF)
                        {
                            case (true) { -> nm_put(this.async_tags, node.text, (void*)node); }
                            default
                            {
                                switch (k == NodeKind.FUNCTION_DEF)
                                {
                                    case (true) {
                                    this.note_async(node, node.text);
                                    switch (!bc_is_proto(node))
                                    {
                                        case (true) { this.add_func(node.text, node); }
                                        default {};
                                    };
                                    ->;
                                }
                                    default
                                    {
                                        switch (k == NodeKind.FUNCTION_DEF_STATEMENT)
                                        {
                                            case (true) { -> this.collect_node(node.a, ns_prefix); }
                                            default
                                            {
                                                switch (k == NodeKind.NAMESPACE_DEF_STATEMENT)
                                                {
                                                    case (true) { -> this.collect_node(node.a, ns_prefix); }
                                                    default
                                                    {
                                                        switch (k == NodeKind.NAMESPACE_DEF)
                                                        {
                                                            case (true) {
                                                            prefix = this.join_prefix(ns_prefix, node.text);
                                                            c = bc_count(node, 0);
                                                            i = 0;
                                                            while (i < c)
                                                            {
                                                                f = bc_unwrap_fn(node_child(node, 0, i));
                                                                i++;
                                                                switch (f.kind == NodeKind.FUNCTION_DEF)
                                                                {
                                                                    case (true) {
                                                                    this.note_async(f, this.join_prefix(prefix, f.text));
                                                                    switch (!bc_is_proto(f))
                                                                    {
                                                                        case (true) { this.add_func(this.join_prefix(prefix, f.text), f); }
                                                                        default {};
                                                                    };
                                                                }
                                                                    default {};
                                                                };
                                                            };
                                                            c = bc_count(node, 2);
                                                            i = 0;
                                                            while (i < c)
                                                            {
                                                                this.collect_object(node_child(node, 2, i), prefix);
                                                                i++;
                                                            };
                                                            switch (node.b != (Node*)0)
                                                            {
                                                                case (true) {
                                                                c = bc_count(node.b, 0);
                                                                i = 0;
                                                                while (i < c)
                                                                {
                                                                    this.collect_node(node_child(node.b, 0, i), prefix);
                                                                    i++;
                                                                };
                                                            }
                                                                default {};
                                                            };
                                                            ->;
                                                        }
                                                            default
                                                            {
                                                                switch (k == NodeKind.OBJECT_DEF)
                                                                {
                                                                    case (true) { -> this.collect_object(node, ns_prefix); }
                                                                    default
                                                                    {
                                                                        switch (k == NodeKind.OBJECT_DEF_STATEMENT)
                                                                        {
                                                                            case (true) { -> this.collect_object(node.a, ns_prefix); }
                                                                            default
                                                                            {
                                                                                switch (k == NodeKind.EXPORT_BLOCK)
                                                                                {
                                                                                    case (true) {
                                                                                    c = bc_count(node, 0);
                                                                                    i = 0;
                                                                                    while (i < c)
                                                                                    {
                                                                                        f = bc_unwrap_fn(node_child(node, 0, i));
                                                                                        i++;
                                                                                        switch (f.kind == NodeKind.FUNCTION_DEF)
                                                                                        {
                                                                                            case (true) {
                                                                                            switch (!bc_is_proto(f))
                                                                                            {
                                                                                                case (true) { this.add_func(f.text, f); }
                                                                                                default {};
                                                                                            };
                                                                                        }
                                                                                            default {};
                                                                                        };
                                                                                    };
                                                                                }
                                                                                    default {};
                                                                                };
                                                                                ->;
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            collect_object(Node* obj, byte* prefix) -> void
            {
                int c;
                int i;
                Node* m;
                byte* mangled;
                byte* inner;
                switch (obj == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (obj.kind != NodeKind.OBJECT_DEF)
                        {
                            case (true) { ->; }
                            default
                            {
                                c = bc_count(obj, 1);
                                i = 0;
                                while (i < c)
                                {
                                    m = node_child(obj, 1, i);
                                    i++;
                                    switch (m.text != (byte*)0 & m.a != (Node*)0)
                                    {
                                        case (true) {
                                        switch (m.text[0] != 0)
                                        {
                                            case (true) {
                                            mangled = this.join_prefix(this.join_prefix(prefix, obj.text), m.text);
                                            this.add_func(mangled, m);
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                };
                                inner = this.join_prefix(prefix, obj.text);
                                c = bc_count(obj, 3);
                                i = 0;
                                while (i < c)
                                {
                                    this.collect_object(node_child(obj, 3, i), inner);
                                    i++;
                                };
                                ->;
                            };
                        };
                    };
                };
            };
        };





        object BorrowChecker
        {
            CallGraph* cg;
            byte* entry;
            bool check_threads;
            bool check_leaks;
            Preprocessor* pp;
            AliasMap alias;
            PtrVec* violations;         
            NameMap* seen;
            int funcs_checked;
            bool in_thread;
            NameMap* call_stack;
            Node* cur_func;
            OMap* array_heap;           
            i64 lit_val;
            Buf sb;

            __init(CallGraph* g, byte* entry_name, bool threads, bool leaks, Preprocessor* p) -> this
            {
                this.cg = g;
                this.entry = entry_name;
                this.check_threads = threads;
                this.check_leaks = leaks;
                this.pp = p;
                this.alias.__init();
                this.violations = pv_new();
                this.seen = nm_new();
                this.funcs_checked = 0;
                this.in_thread = false;
                this.call_stack = nm_new();
                this.cur_func = (Node*)0;
                this.array_heap = om_new();
                this.sb.__init();
                -> this;
            };

            __expr() -> BorrowChecker* -> this;

            __exit() -> void
            {
                this.alias.__exit();
                nm_free(this.seen);
                nm_free(this.call_stack);
                -> this.sb.__exit();
            };



            remap_file(int merged) -> byte*
            {
                int idx = merged - 1;
                switch (this.pp != (Preprocessor*)0)
                {
                    case (true) {
                    switch (idx >= 0 & idx < this.pp.map_line.len)
                    {
                        case (true) { -> this.pp.map_path(idx); }
                        default {};
                    };
                }
                    default {};
                };
                -> bc_unk();
            };

            remap_line(int merged) -> int
            {
                int idx = merged - 1;
                switch (this.pp != (Preprocessor*)0)
                {
                    case (true) {
                    switch (idx >= 0 & idx < this.pp.map_line.len)
                    {
                        case (true) { -> this.pp.map_lineno(idx); }
                        default {};
                    };
                }
                    default {};
                };
                -> merged;
            };



            remap_detail(byte* d) -> byte*
            {
                int n = bc_len(d);
                int first = -1;
                int i = 0;
                int colon = -1;
                int j;
                int merged;
                bool digits;

                while (i + 4 <= n)
                {
                    switch (bc_starts(d + i, g" at \0"))
                    {
                        case (true) {
                        switch (first < 0)
                        {
                            case (true) { first = i; i = i + 4; }
                            default { -> d; };
                        };
                    }
                        default { i++; };
                    };
                };
                switch (first < 0)
                {
                    case (true) { -> d; }
                    default
                    {

                        j = first + 4;
                        while (j < n)
                        {
                            switch (d[j] == ':')
                            {
                                case (true) { colon = j; }
                                default {};
                            };
                            j++;
                        };
                        switch (colon < 0)
                        {
                            case (true) { -> d; }
                            default
                            {
                                digits = colon + 1 < n;
                                merged = 0;
                                j = colon + 1;
                                while (j < n)
                                {
                                    switch (d[j] < '0' | d[j] > '9')
                                    {
                                        case (true) { digits = false; }
                                        default { merged = merged * 10 + ((int)d[j] - 48); };
                                    };
                                    j++;
                                };
                                switch (!digits)
                                {
                                    case (true) { -> d; }
                                    default
                                    {
                                        this.sb.clear();
                                        j = 0;
                                        while (j < first)
                                        {
                                            this.sb.put((int)d[j]);
                                            j++;
                                        };
                                        this.sb.put_str(f" at {this.remap_file(merged)}:{this.remap_line(merged)}\0");
                                        -> ts_dup(this.sb.mem);
                                    };
                                };
                            };
                        };
                    };
                };
            };

            viol_key(BVio* v) -> byte*
            {
                this.sb.clear();
                this.sb.put_str(f"{v.kind}\x1f{v.file}\x1f{v.line}\x1f{v.msg}\0");
                -> this.sb.mem;
            };



            run() -> void
            {
                int i;
                Node* f;
                switch (!nm_has(this.cg.funcs, this.entry))
                {
                    case (true) {
                    print(g"[FBC] Warning: entry point '\0");
                    print(this.entry);
                    println(g"' not found as a non-prototype function.\0");
                    println(g"      This usually means the entry point body is inside an unresolved #ifdef block.\0");
                    println(g"      Checking all reachable functions instead.\0");
                    while (i < this.cg.funcs.count)
                    {
                        f = (Node*)this.cg.funcs.vals[i];
                        switch (f != (Node*)0)
                        {
                            case (true) {
                            switch (!this.cg.is_visited(this.cg.funcs.keys[i], pv_new(), false))
                            {
                                case (true) { this.check_function(f, false, pv_new()); }
                                default {};
                            };
                        }
                            default {};
                        };
                        i++;
                    };
                }
                    default {
                    this.check_function((Node*)nm_get(this.cg.funcs, this.entry), false, pv_new());
                };
                };
                ->;
            };


            func_returns_allocation(Node* func) -> bool
            {
                Node* s;
                Node* e;
                switch (cstr_eq(func.text, g"fmalloc\0") | cstr_eq(func.text, g"ffree\0"))
                {
                    case (true) { -> true; }
                    default
                    {
                        switch (func.a == (Node*)0)
                        {
                            case (true) { -> false; }
                            default
                            {
                                switch (func.a.kind != NodeKind.BLOCK)
                                {
                                    case (true) { -> false; }
                                    default
                                    {
                                        switch (bc_count(func.a, 0) != 1)
                                        {
                                            case (true) { -> false; }
                                            default
                                            {
                                                s = node_child(func.a, 0, 0);
                                                switch (s.kind == NodeKind.RETURN_STATEMENT & s.a != (Node*)0)
                                                {
                                                    case (true) {
                                                    switch (bc_is_fmalloc(s.a))
                                                    {
                                                        case (true) { -> true; }
                                                        default
                                                        {
                                                            switch (s.a.kind == NodeKind.CAST_EXPRESSION)
                                                            {
                                                                case (true) {
                                                                switch (bc_is_fmalloc(s.a.a))
                                                                {
                                                                    case (true) { -> true; }
                                                                    default {};
                                                                };
                                                            }
                                                                default {};
                                                            };
                                                            switch (s.a.kind == NodeKind.FUNCTION_CALL & s.a.text != (byte*)0)
                                                            {
                                                                case (true) {
                                                                switch (bc_has_ci(s.a.text, g"malloc\0") | bc_has_ci(s.a.text, g"alloc\0"))
                                                                {
                                                                    case (true) { -> true; }
                                                                    default {};
                                                                };
                                                            }
                                                                default {};
                                                            };
                                                        };
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (s.kind == NodeKind.EXPRESSION_STATEMENT)
                                                {
                                                    case (true) {
                                                    e = s.a;
                                                    switch (e != (Node*)0)
                                                    {
                                                        case (true) {
                                                        switch (e.kind == NodeKind.RETURN_STATEMENT & e.a != (Node*)0)
                                                        {
                                                            case (true) {
                                                            switch (bc_is_fmalloc(e.a))
                                                            {
                                                                case (true) { -> true; }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                -> false;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            ptr_params(Node* func) -> PtrVec*
            {
                PtrVec* r = pv_new();
                int c = bc_count(func, 0);
                int i;
                Node* p;
                while (i < c)
                {
                    p = node_child(func, 0, i);
                    switch (p.text != (byte*)0 & bc_is_pointer_type(p.ts))
                    {
                        case (true) {
                        switch (p.text[0] != 0)
                        {
                            case (true) { pv_push(r, (void*)p); }
                            default {};
                        };
                    }
                        default {};
                    };
                    i++;
                };
                -> r;
            };

            check_function(Node* func, bool thread_context, PtrVec* call_ctx) -> void
            {
                byte* prev_func;
                bool prev_thread;
                Node* prev_node;
                PtrVec* prev_frames;
                OMap* prev_heap;
                OMap* prev_freed;
                OMap* prev_alloc;
                OMap* prev_array;
                PtrVec* params;
                PtrVec* names;
                PtrVec* sites;
                Node* param;
                byte* site;
                int idx;
                int i;
                BVio* v;
                int merged;
                PtrVec* nd;
                byte* key;

                switch (this.cg.is_visited(func.text, call_ctx, thread_context))
                {
                    case (true) { ->; }
                    default
                    {

                        switch (nm_has(this.call_stack, func.text))
                        {
                            case (true) { ->; }
                            default
                            {
                                this.cg.mark_visited(func.text, call_ctx, thread_context);
                                nm_put(this.call_stack, func.text, (void*)1);
                                this.funcs_checked++;

                                prev_func = this.alias.func_name;
                                prev_thread = this.in_thread;
                                prev_node = this.cur_func;

                                prev_frames = this.alias.frames;
                                this.alias.frames = pv_new();
                                prev_heap = this.alias.heap_sites;
                                this.alias.heap_sites = om_new();
                                prev_freed = this.alias.freed_sites;
                                this.alias.freed_sites = om_new();
                                prev_alloc = this.alias.alloc_sizes;
                                this.alias.alloc_sizes = om_new();
                                prev_array = this.array_heap;
                                this.array_heap = om_new();
                                this.alias.func_name = func.text;
                                this.in_thread = thread_context;
                                this.cur_func = func;

                                this.alias.push_scope();

                                params = this.ptr_params(func);
                                names = pv_new();
                                sites = pv_new();
                                idx = 0;
                                while (idx < params.len)
                                {
                                    param = (Node*)params.items[idx];
                                    site = (byte*)0;
                                    switch (idx < call_ctx.len)
                                    {
                                        case (true) {
                                        key = (byte*)call_ctx.items[idx];
                                        switch (!cstr_eq(key, g"unknown\0") & key[0] != 0)
                                        {
                                            case (true) {
                                            site = key;
                                            switch (om_has(prev_alloc, site))
                                            {
                                                case (true) { om_put(this.alias.alloc_sizes, site, om_get(prev_alloc, site)); }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    switch (site == (byte*)0)
                                    {
                                        case (true) { site = bc_param_site(func.text, param.text); }
                                        default {};
                                    };
                                    this.alias.declare_ptr(param.text, site, true, bc_unk(), func.line, false);
                                    pv_push(names, (void*)param.text);
                                    pv_push(sites, (void*)site);
                                    idx++;
                                };
                                this.alias.check_call_args(names, sites, bc_unk(), func.line);

                                switch (func.a != (Node*)0)
                                {
                                    case (true) {
                                    switch (func.a.kind == NodeKind.BLOCK)
                                    {
                                        case (true) { this.walk_block(func.a); }
                                        default { this.walk_expr(func.a); };
                                    };
                                }
                                    default {};
                                };

                                switch (this.check_leaks & !this.func_returns_allocation(func))
                                {
                                    case (true) { this.alias.check_heap_leaks(); }
                                    default {
                                    om_clear(this.alias.heap_sites);
                                    om_clear(this.alias.freed_sites);
                                    om_clear(this.alias.alloc_sizes);
                                };
                                };

                                this.alias.pop_scope();
                                nm_del(this.call_stack, func.text);
                                this.alias.frames = prev_frames;
                                this.alias.heap_sites = prev_heap;
                                this.alias.freed_sites = prev_freed;
                                this.alias.alloc_sizes = prev_alloc;
                                this.array_heap = prev_array;
                                this.alias.func_name = prev_func;
                                this.cur_func = prev_node;
                                this.in_thread = prev_thread;


                                i = 0;
                                while (i < this.alias.violations.len)
                                {
                                    v = (BVio*)this.alias.violations.items[i];
                                    merged = v.line;
                                    v.file = this.remap_file(merged);
                                    v.line = this.remap_line(merged);
                                    nd = pv_new();
                                    idx = 0;
                                    while (idx < v.detail.len)
                                    {
                                        pv_push(nd, (void*)ts_dup(this.remap_detail((byte*)v.detail.items[idx])));
                                        idx++;
                                    };
                                    v.detail = nd;
                                    i++;
                                };
                                i = 0;
                                while (i < this.alias.violations.len)
                                {
                                    v = (BVio*)this.alias.violations.items[i];
                                    key = ts_dup(this.viol_key(v));
                                    switch (!nm_has(this.seen, key))
                                    {
                                        case (true) {
                                        pv_push(this.violations, (void*)v);
                                        nm_put(this.seen, key, (void*)1);
                                    }
                                        default {};
                                    };
                                    i++;
                                };
                                this.alias.violations.len = 0;
                                ->;
                            };
                        };
                    };
                };
            };

            walk_block(Node* block) -> void
            {
                int c = bc_count(block, 0);
                int i;
                Node* s;
                this.alias.push_scope();
                while (i < c)
                {
                    s = node_child(block, 0, i);
                    switch (s != (Node*)0)
                    {
                        case (true) { this.walk_stmt(s); }
                        default {};
                    };
                    i++;
                };
                -> this.alias.pop_scope();
            };



            om_intersect(OMap* a, OMap* b) -> OMap*
            {
                OMap* r = om_new();
                int i;
                while (i < a.ks.len)
                {
                    switch (om_has(b, (byte*)a.ks.items[i]))
                    {
                        case (true) { om_put(r, (byte*)a.ks.items[i], a.vs.items[i]); }
                        default {};
                    };
                    i++;
                };
                -> r;
            };

            om_update(OMap* dst, OMap* src) -> void
            {
                int i;
                while (i < src.ks.len)
                {
                    om_put(dst, (byte*)src.ks.items[i], src.vs.items[i]);
                    i++;
                };
                ->;
            };


            loop_merge_heap(OMap* pre_heap) -> void
            {
                OMap* loop_heap = om_copy(this.alias.heap_sites);
                OMap* merged = om_new();
                int i;
                while (i < pre_heap.ks.len)
                {
                    switch (om_has(loop_heap, (byte*)pre_heap.ks.items[i]))
                    {
                        case (true) { om_put(merged, (byte*)pre_heap.ks.items[i], pre_heap.vs.items[i]); }
                        default {};
                    };
                    i++;
                };
                i = 0;
                while (i < loop_heap.ks.len)
                {
                    switch (!om_has(pre_heap, (byte*)loop_heap.ks.items[i]))
                    {
                        case (true) { om_put(merged, (byte*)loop_heap.ks.items[i], loop_heap.vs.items[i]); }
                        default {};
                    };
                    i++;
                };
                this.alias.heap_sites = merged;
                ->;
            };


            walk_loop_body(Node* body) -> void
            {
                OMap* pre_freed = om_copy(this.alias.freed_sites);
                OMap* pre_heap = om_copy(this.alias.heap_sites);
                this.walk_block(body);
                this.alias.freed_sites = om_copy(pre_freed);
                -> this.loop_merge_heap(pre_heap);
            };

            walk_stmt(Node* node) -> void
            {
                int k = node.kind;
                OMap* pre_freed;
                OMap* pre_heap;
                OMap* then_freed;
                OMap* then_heap;
                OMap* else_freed;
                OMap* else_heap;
                OMap* merged;
                OMap* inter;
                PtrVec* case_freeds;
                PtrVec* case_heaps;
                Node* cs;
                int i;
                int c;

                switch (k == NodeKind.VARIABLE_DECLARATION)
                {
                    case (true) { -> this.on_var_decl(node); }
                    default
                    {
                        switch (k == NodeKind.ASSIGNMENT)
                        {
                            case (true) { -> this.on_assign(node); }
                            default
                            {
                                switch (k == NodeKind.COMPOUND_ASSIGNMENT)
                                {
                                    case (true) { -> this.walk_expr(node.b); }
                                    default
                                    {
                                        switch (k == NodeKind.EXPRESSION_STATEMENT)
                                        {
                                            case (true) { -> this.walk_expr(node.a); }
                                            default
                                            {
                                                switch (k == NodeKind.BLOCK)
                                                {
                                                    case (true) { -> this.walk_block(node); }
                                                    default
                                                    {
                                                        switch (k == NodeKind.IF_STATEMENT)
                                                        {
                                                            case (true) {
                                                            this.walk_expr(node.a);
                                                            pre_freed = om_copy(this.alias.freed_sites);
                                                            pre_heap = om_copy(this.alias.heap_sites);
                                                            switch (node.b != (Node*)0)
                                                            {
                                                                case (true) { this.walk_block(node.b); }
                                                                default {};
                                                            };
                                                            then_freed = om_copy(this.alias.freed_sites);
                                                            then_heap = om_copy(this.alias.heap_sites);
                                                            this.alias.freed_sites = om_copy(pre_freed);
                                                            this.alias.heap_sites = om_copy(pre_heap);
                                                            switch (node.c != (Node*)0)
                                                            {
                                                                case (true) { this.walk_block(node.c); }
                                                                default {};
                                                            };
                                                            else_freed = om_copy(this.alias.freed_sites);
                                                            else_heap = om_copy(this.alias.heap_sites);
                                                            switch (node.c != (Node*)0)
                                                            {
                                                                case (true) {

                                                                this.alias.freed_sites = this.om_intersect(then_freed, else_freed);
                                                                merged = om_copy(then_heap);
                                                                this.om_update(merged, else_heap);
                                                                this.alias.heap_sites = merged;
                                                            }
                                                                default {
                                                                this.alias.freed_sites = om_copy(pre_freed);
                                                                merged = om_copy(pre_heap);
                                                                this.om_update(merged, then_heap);
                                                                this.alias.heap_sites = merged;
                                                            };
                                                            };
                                                            ->;
                                                        }
                                                            default
                                                            {
                                                                switch (k == NodeKind.WHILE_LOOP)
                                                                {
                                                                    case (true) {
                                                                    this.walk_expr(node.a);
                                                                    switch (node.b != (Node*)0)
                                                                    {
                                                                        case (true) { this.walk_loop_body(node.b); }
                                                                        default {};
                                                                    };
                                                                    ->;
                                                                }
                                                                    default
                                                                    {
                                                                        switch (k == NodeKind.DO_WHILE_LOOP)
                                                                        {
                                                                            case (true) {
                                                                            switch (node.b != (Node*)0)
                                                                            {
                                                                                case (true) { this.walk_loop_body(node.b); }
                                                                                default {};
                                                                            };
                                                                            -> this.walk_expr(node.a);
                                                                        }
                                                                            default
                                                                            {
                                                                                switch (k == NodeKind.FOR_LOOP)
                                                                                {
                                                                                    case (true) {
                                                                                    switch (node.a != (Node*)0) { case (true) { this.walk_stmt(node.a); } default {}; };
                                                                                    switch (node.b != (Node*)0) { case (true) { this.walk_expr(node.b); } default {}; };
                                                                                    switch (node.c != (Node*)0) { case (true) { this.walk_stmt(node.c); } default {}; };
                                                                                    switch (node.d != (Node*)0) { case (true) { this.walk_loop_body(node.d); } default {}; };
                                                                                    ->;
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        switch (k == NodeKind.FOR_IN_LOOP)
                                                                                        {
                                                                                            case (true) {
                                                                                            switch (node.b != (Node*)0) { case (true) { this.walk_loop_body(node.b); } default {}; };
                                                                                            ->;
                                                                                        }
                                                                                            default
                                                                                            {
                                                                                                switch (k == NodeKind.SWITCH_STATEMENT)
                                                                                                {
                                                                                                    case (true) {
                                                                                                    this.walk_expr(node.a);
                                                                                                    pre_freed = om_copy(this.alias.freed_sites);
                                                                                                    pre_heap = om_copy(this.alias.heap_sites);
                                                                                                    case_freeds = pv_new();
                                                                                                    case_heaps = pv_new();
                                                                                                    c = bc_count(node, 0);
                                                                                                    i = 0;
                                                                                                    while (i < c)
                                                                                                    {
                                                                                                        cs = node_child(node, 0, i);
                                                                                                        i++;
                                                                                                        this.alias.freed_sites = om_copy(pre_freed);
                                                                                                        this.alias.heap_sites = om_copy(pre_heap);
                                                                                                        switch (cs.b != (Node*)0)
                                                                                                        {
                                                                                                            case (true) { this.walk_block(cs.b); }
                                                                                                            default {};
                                                                                                        };
                                                                                                        pv_push(case_freeds, (void*)om_copy(this.alias.freed_sites));
                                                                                                        pv_push(case_heaps, (void*)om_copy(this.alias.heap_sites));
                                                                                                    };
                                                                                                    switch (case_freeds.len > 0)
                                                                                                    {
                                                                                                        case (true) {
                                                                                                        inter = om_copy((OMap*)case_freeds.items[0]);
                                                                                                        i = 1;
                                                                                                        while (i < case_freeds.len)
                                                                                                        {
                                                                                                            inter = this.om_intersect(inter, (OMap*)case_freeds.items[i]);
                                                                                                            i++;
                                                                                                        };
                                                                                                        this.alias.freed_sites = inter;
                                                                                                        merged = om_new();
                                                                                                        i = 0;
                                                                                                        while (i < case_heaps.len)
                                                                                                        {
                                                                                                            this.om_update(merged, (OMap*)case_heaps.items[i]);
                                                                                                            i++;
                                                                                                        };
                                                                                                        this.alias.heap_sites = merged;
                                                                                                    }
                                                                                                        default {
                                                                                                        this.alias.freed_sites = om_copy(pre_freed);
                                                                                                        this.alias.heap_sites = om_copy(pre_heap);
                                                                                                    };
                                                                                                    };
                                                                                                    ->;
                                                                                                }
                                                                                                    default
                                                                                                    {
                                                                                                        switch (k == NodeKind.RETURN_STATEMENT)
                                                                                                        {
                                                                                                            case (true) {
                                                                                                            switch (node.a != (Node*)0) { case (true) { this.walk_expr(node.a); } default {}; };
                                                                                                            ->;
                                                                                                        }
                                                                                                            default
                                                                                                            {
                                                                                                                switch (k == NodeKind.DEFER_STATEMENT)
                                                                                                                {
                                                                                                                    case (true) {


                                                                                                                    pre_freed = om_copy(this.alias.freed_sites);
                                                                                                                    switch (node.a != (Node*)0) { case (true) { this.walk_expr(node.a); } default {}; };
                                                                                                                    c = bc_count(node, 0);
                                                                                                                    i = 0;
                                                                                                                    while (i < c)
                                                                                                                    {
                                                                                                                        this.walk_stmt(node_child(node, 0, i));
                                                                                                                        i++;
                                                                                                                    };
                                                                                                                    this.alias.freed_sites = om_copy(pre_freed);
                                                                                                                    ->;
                                                                                                                }
                                                                                                                    default
                                                                                                                    {
                                                                                                                        switch (k == NodeKind.TRY_BLOCK)
                                                                                                                        {
                                                                                                                            case (true) {
                                                                                                                            pre_freed = om_copy(this.alias.freed_sites);
                                                                                                                            pre_heap = om_copy(this.alias.heap_sites);
                                                                                                                            switch (node.a != (Node*)0)
                                                                                                                            {
                                                                                                                                case (true) { this.walk_block(node.a); }
                                                                                                                                default {};
                                                                                                                            };
                                                                                                                            then_freed = om_copy(this.alias.freed_sites);
                                                                                                                            then_heap = om_copy(this.alias.heap_sites);
                                                                                                                            case_freeds = pv_new();
                                                                                                                            case_heaps = pv_new();
                                                                                                                            c = bc_count(node, 0);
                                                                                                                            i = 0;
                                                                                                                            while (i < c)
                                                                                                                            {
                                                                                                                                cs = node_child(node, 0, i);
                                                                                                                                i++;
                                                                                                                                this.alias.freed_sites = om_copy(pre_freed);
                                                                                                                                this.alias.heap_sites = om_copy(pre_heap);
                                                                                                                                switch (cs.a != (Node*)0)
                                                                                                                                {
                                                                                                                                    case (true) { this.walk_block(cs.a); }
                                                                                                                                    default {};
                                                                                                                                };
                                                                                                                                pv_push(case_freeds, (void*)om_copy(this.alias.freed_sites));
                                                                                                                                pv_push(case_heaps, (void*)om_copy(this.alias.heap_sites));
                                                                                                                            };
                                                                                                                            inter = om_copy(then_freed);
                                                                                                                            i = 0;
                                                                                                                            while (i < case_freeds.len)
                                                                                                                            {
                                                                                                                                inter = this.om_intersect(inter, (OMap*)case_freeds.items[i]);
                                                                                                                                i++;
                                                                                                                            };
                                                                                                                            this.alias.freed_sites = inter;
                                                                                                                            merged = om_copy(then_heap);
                                                                                                                            i = 0;
                                                                                                                            while (i < case_heaps.len)
                                                                                                                            {
                                                                                                                                this.om_update(merged, (OMap*)case_heaps.items[i]);
                                                                                                                                i++;
                                                                                                                            };
                                                                                                                            this.alias.heap_sites = merged;
                                                                                                                            ->;
                                                                                                                        }
                                                                                                                            default
                                                                                                                            {
                                                                                                                                switch (k == NodeKind.FUNCTION_DEF_STATEMENT)
                                                                                                                                {
                                                                                                                                    case (true) {

                                                                                                                                    -> this.check_function(node.a, this.in_thread, pv_new());
                                                                                                                                }
                                                                                                                                    default
                                                                                                                                    {

                                                                                                                                        ->;
                                                                                                                                    };
                                                                                                                                };
                                                                                                                            };
                                                                                                                        };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };





            const_int(Node* e) -> bool
            {
                i64 lv;
                i64 rv;
                switch (e == (Node*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (e.kind == NodeKind.LITERAL)
                        {
                            case (true) {
                            switch (e.op == DataType.SINT | e.op == DataType.UINT | e.op == DataType.SLONG | e.op == DataType.ULONG)
                            {
                                case (true) {
                                this.lit_val = e.ival;
                                -> true;
                            }
                                default {};
                            };
                            -> false;
                        }
                            default
                            {
                                switch (bc_is_cast(e))
                                {
                                    case (true) { -> this.const_int(e.a); }
                                    default
                                    {
                                        switch (e.kind == NodeKind.UNARY_OP)
                                        {
                                            case (true) {
                                            switch (e.op == Operator.SUB)
                                            {
                                                case (true) {
                                                switch (this.const_int(e.a))
                                                {
                                                    case (true) { this.lit_val = (i64)0 - this.lit_val; -> true; }
                                                    default {};
                                                };
                                            }
                                                default {};
                                            };
                                            -> false;
                                        }
                                            default
                                            {
                                                switch (e.kind == NodeKind.BINARY_OP)
                                                {
                                                    case (true) {
                                                    switch (!this.const_int(e.a)) { case (true) { -> false; } default {}; };
                                                    lv = this.lit_val;
                                                    switch (!this.const_int(e.b)) { case (true) { -> false; } default {}; };
                                                    rv = this.lit_val;
                                                    switch (e.op == Operator.ADD) { case (true) { this.lit_val = lv + rv; -> true; } default {}; };
                                                    switch (e.op == Operator.SUB) { case (true) { this.lit_val = lv - rv; -> true; } default {}; };
                                                    switch (e.op == Operator.MUL) { case (true) { this.lit_val = lv * rv; -> true; } default {}; };
                                                    switch (e.op == Operator.DIV & rv > (i64)0 & lv >= (i64)0) { case (true) { this.lit_val = lv / rv; -> true; } default {}; };
                                                    switch (e.op == Operator.MOD & rv > (i64)0 & lv >= (i64)0) { case (true) { this.lit_val = lv % rv; -> true; } default {}; };
                                                    switch (e.op == Operator.BITSHIFT_LEFT & rv >= (i64)0 & rv < (i64)63) { case (true) { this.lit_val = lv << (int)rv; -> true; } default {}; };
                                                    switch (e.op == Operator.BITSHIFT_RIGHT & rv >= (i64)0 & rv < (i64)63 & lv >= (i64)0) { case (true) { this.lit_val = lv >> (int)rv; -> true; } default {}; };
                                                    switch (e.op == Operator.BITAND) { case (true) { this.lit_val = lv `& rv; -> true; } default {}; };
                                                    switch (e.op == Operator.BITOR) { case (true) { this.lit_val = lv `| rv; -> true; } default {}; };
                                                    switch (e.op == Operator.BITXOR) { case (true) { this.lit_val = lv `^| rv; -> true; } default {}; };
                                                    -> false;
                                                }
                                                    default
                                                    {
                                                        -> false;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            rhs_is_heap_alloc(Node* e) -> bool
            {
                switch (e == (Node*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (bc_is_fmalloc(e))
                        {
                            case (true) { -> true; }
                            default
                            {
                                switch (bc_is_cast(e))
                                {
                                    case (true) { -> this.rhs_is_heap_alloc(e.a); }
                                    default
                                    {
                                        -> false;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            on_var_decl(Node* node) -> void
            {
                byte* file = bc_unk();
                int line = node.line;
                bool is_ptr = bc_is_pointer_type(node.ts);
                byte* site;
                byte* ptr_site;
                ScopeFrame* frame;
                switch (!is_ptr & this.check_leaks & this.rhs_is_heap_alloc(node.a))
                {
                    case (true) { is_ptr = true; }
                    default {};
                };
                site = bc_stack_site(this.alias.func_name, node.text, line);
                switch (is_ptr)
                {
                    case (true) {
                    ptr_site = this.resolve_site(node.a, node.text, file, line);
                    this.alias.declare_ptr(node.text, ptr_site, true, file, line, false);
                }
                    default {

                    switch (this.alias.frames.len > 0)
                    {
                        case (true) {
                        frame = (ScopeFrame*)this.alias.frames.items[this.alias.frames.len - 1];
                        om_put(frame.owned, site, (void*)1);
                        om_put(frame.var_sites, node.text, site);
                    }
                        default {};
                    };

                    switch (node.ts != (TypeSpec*)0)
                    {
                        case (true) {
                        switch (node.ts.array_size != (Node*)0)
                        {
                            case (true) {
                            switch (this.const_int(node.ts.array_size))
                            {
                                case (true) { this.alias.record_alloc_size(site, (int)this.lit_val); }
                                default {};
                            };
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                };
                };
                switch (node.a != (Node*)0)
                {
                    case (true) { this.walk_expr(node.a); }
                    default {};
                };
                ->;
            };


            note_array_store(byte* arr_name, byte* ptr_name) -> void
            {
                BPtr* info = this.alias.find_ptr(ptr_name);
                PtrVec* lst;
                int i;
                bool dup;
                switch (info == (BPtr*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (!om_has(this.alias.heap_sites, info.site))
                        {
                            case (true) { ->; }
                            default
                            {
                                lst = (PtrVec*)om_get(this.array_heap, arr_name);
                                switch (lst == (PtrVec*)0)
                                {
                                    case (true) {
                                    lst = pv_new();
                                    om_put(this.array_heap, arr_name, (void*)lst);
                                }
                                    default {};
                                };
                                while (i < lst.len)
                                {
                                    switch (cstr_eq((byte*)lst.items[i], info.site)) { case (true) { dup = true; } default {}; };
                                    i++;
                                };
                                switch (!dup)
                                {
                                    case (true) { pv_push(lst, (void*)info.site); }
                                    default {};
                                };
                                ->;
                            };
                        };
                    };
                };
            };

            on_assign(Node* node) -> void
            {
                byte* file = bc_unk();
                int line = node.line;
                byte* var_name;
                byte* new_site;
                this.walk_expr(node.b);
                switch (node.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true) {
                    var_name = node.a.text;
                    switch (this.alias.find_ptr(var_name) != (BPtr*)0)
                    {
                        case (true) {
                        new_site = this.resolve_site(node.b, var_name, file, line);
                        this.alias.assign_ptr(var_name, new_site, true, file, line);
                    }
                        default {
                        switch (this.check_leaks & this.rhs_is_heap_alloc(node.b))
                        {
                            case (true) {

                            new_site = this.resolve_site(node.b, var_name, file, line);
                            this.alias.declare_ptr(var_name, new_site, true, file, line, false);
                        }
                            default {};
                        };
                    };
                    };
                }
                    default {};
                };

                switch (this.check_leaks & node.a.kind == NodeKind.ARRAY_ACCESS)
                {
                    case (true) {
                    switch (node.a.a.kind == NodeKind.IDENTIFIER & node.b.kind == NodeKind.IDENTIFIER)
                    {
                        case (true) { this.note_array_store(node.a.a.text, node.b.text); }
                        default {};
                    };
                }
                    default {};
                };
                ->;
            };

            in_spawn_impl() -> bool
            {
                byte* f = this.alias.func_name;
                -> bc_contains(f, g"thread_create\0") | bc_contains(f, g"pthread_create\0") | bc_contains(f, g"CreateThread\0");
            };

            check_ident_escape(byte* name, byte* file, int line) -> void
            {
                switch (this.check_threads & !this.in_spawn_impl())
                {
                    case (true) { this.alias.check_use_after_escape(name, file, line); }
                    default {};
                };
                ->;
            };


            unwrap_ptr_ident(Node* e) -> byte*
            {
                switch (e == (Node*)0)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        switch (e.kind == NodeKind.IDENTIFIER)
                        {
                            case (true) { -> e.text; }
                            default
                            {
                                switch (bc_is_cast(e) | e.kind == NodeKind.ADDRESS_OF)
                                {
                                    case (true) { -> this.unwrap_ptr_ident(e.a); }
                                    default
                                    {
                                        switch (e.kind == NodeKind.FUNCTION_CALL & bc_count(e, 0) > 0)
                                        {
                                            case (true) { -> this.unwrap_ptr_ident(node_child(e, 0, 0)); }
                                            default
                                            {
                                                -> (byte*)0;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            collect_arg_sites(NodeVec* args, byte* file, int line, PtrVec* names, PtrVec* sites) -> void
            {
                int i;
                byte* hint;
                Node* a;
                switch (args == (NodeVec*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        while (i < args.len)
                        {
                            a = args.items[i];
                            hint = this.unwrap_ptr_ident(a);
                            switch (hint == (byte*)0)
                            {
                                case (true) { hint = g"<arg>\0"; }
                                default {
                                switch (hint[0] == 0) { case (true) { hint = g"<arg>\0"; } default {}; };
                            };
                            };
                            pv_push(names, (void*)hint);
                            pv_push(sites, (void*)this.resolve_site(a, hint, file, line));
                            i++;
                        };
                        ->;
                    };
                };
            };


            build_call_ctx(Node* func, NodeVec* args, byte* file, int line) -> PtrVec*
            {
                PtrVec* r = pv_new();
                PtrVec* pp2 = this.ptr_params(func);
                int c = bc_count(func, 0);
                int i;
                int j;
                int full_idx;
                Node* p;
                Node* q;
                int nargs;
                switch (pp2.len == 0)
                {
                    case (true) { -> r; }
                    default
                    {
                        nargs = 0;
                        switch (args != (NodeVec*)0) { case (true) { nargs = args.len; } default {}; };
                        while (i < pp2.len)
                        {
                            p = (Node*)pp2.items[i];
                            full_idx = -1;
                            j = 0;
                            while (j < c)
                            {
                                q = node_child(func, 0, j);
                                switch (full_idx < 0 & q.text != (byte*)0)
                                {
                                    case (true) {
                                    switch (cstr_eq(q.text, p.text)) { case (true) { full_idx = j; } default {}; };
                                }
                                    default {};
                                };
                                j++;
                            };
                            switch (full_idx >= 0 & full_idx < nargs)
                            {
                                case (true) { pv_push(r, (void*)this.resolve_site(args.items[full_idx], p.text, file, line)); }
                                default { pv_push(r, (void*)g"unknown\0"); };
                            };
                            i++;
                        };
                        -> r;
                    };
                };
            };


            resolve_ffree_arg(Node* arg) -> byte*
            {
                BPtr* info;
                PtrVec* lst;
                byte* s;
                int j;
                switch (arg.kind == NodeKind.IDENTIFIER)
                {
                    case (true) {
                    info = this.alias.find_ptr(arg.text);
                    switch (info != (BPtr*)0) { case (true) { -> info.site; } default {}; };
                    -> g"unknown\0";
                }
                    default
                    {
                        switch (arg.kind == NodeKind.CAST_EXPRESSION)
                        {
                            case (true) { -> this.resolve_ffree_arg(arg.a); }
                            default
                            {
                                switch (arg.kind == NodeKind.FUNCTION_CALL & arg.text != (byte*)0 & bc_count(arg, 0) > 0)
                                {
                                    case (true) { -> this.resolve_ffree_arg(node_child(arg, 0, 0)); }
                                    default
                                    {
                                        switch (arg.kind == NodeKind.ADDRESS_OF)
                                        {
                                            case (true) {
                                            switch (arg.a.kind == NodeKind.IDENTIFIER)
                                            {
                                                case (true) {
                                                info = this.alias.find_ptr(arg.a.text);
                                                switch (info != (BPtr*)0) { case (true) { -> info.site; } default
                                                    {
                                                        -> g"unknown\0";
                                                    }; };
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        switch (arg.kind == NodeKind.TYPE_CONVERT_EXPRESSION)
                                        {
                                            case (true) { -> this.resolve_ffree_arg(arg.a); }
                                            default
                                            {

                                                switch (arg.kind == NodeKind.ARRAY_ACCESS)
                                                {
                                                    case (true) {
                                                    switch (arg.a.kind == NodeKind.IDENTIFIER)
                                                    {
                                                        case (true) {
                                                        lst = (PtrVec*)om_get(this.array_heap, arg.a.text);
                                                        switch (lst != (PtrVec*)0)
                                                        {
                                                            case (true) {
                                                            switch (lst.len > 0)
                                                            {
                                                                case (true) {
                                                                s = (byte*)lst.items[0];
                                                                j = 0;
                                                                while (j < lst.len - 1)
                                                                {
                                                                    lst.items[j] = lst.items[j + 1];
                                                                    j++;
                                                                };
                                                                lst.len--;
                                                                -> s;
                                                            }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                -> g"unknown\0";
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            var_site_of(byte* name) -> byte*
            {
                int fi = this.alias.frames.len - 1;
                ScopeFrame* f;
                int k;
                while (fi >= 0)
                {
                    f = (ScopeFrame*)this.alias.frames.items[fi];
                    k = om_find(f.var_sites, name);
                    switch (k >= 0) { case (true) { -> (byte*)f.var_sites.vs.items[k]; } default
                        {
                            fi--;
                        }; };
                };
                -> (byte*)0;
            };


            str_site(Node* e) -> byte*
            {
                int n = (int)e.ival;
                int a = 0;
                int b;
                int c;
                bool going = true;
                switch (n <= 0) { case (true) { n = bc_len(e.text); } default {}; };
                while (a < n & going)
                {
                    c = (int)e.text[a];
                    if ((c >= 9 & c <= 13) | (c >= 28 & c <= 32)) { a++; } else { going = false; };
                };
                b = n;
                going = true;
                while (b > a & going)
                {
                    c = (int)e.text[b - 1];
                    if ((c >= 9 & c <= 13) | (c >= 28 & c <= 32)) { b--; } else { going = false; };
                };
                this.sb.clear();
                this.sb.put_str(f"param:{this.alias.func_name}:\0");
                c = a;
                while (c < b)
                {
                    if (e.text[c] == 0) { break; };
                    this.sb.put((int)e.text[c]);
                    c++;
                };
                -> ts_dup(this.sb.mem);
            };

            resolve_site(Node* expr, byte* var_name, byte* file, int line) -> byte*
            {
                Node* inner;
                byte* s;
                byte* t;
                BPtr* info;
                switch (expr == (Node*)0)
                {
                    case (true) { -> g"unknown\0"; }
                    default
                    {

                        switch (expr.kind == NodeKind.ADDRESS_OF)
                        {
                            case (true) {
                            inner = expr.a;
                            switch (inner.kind == NodeKind.IDENTIFIER)
                            {
                                case (true) {
                                s = this.var_site_of(inner.text);
                                switch (s != (byte*)0) { case (true) { -> s; } default {}; };
                                -> bc_stack_site(this.alias.func_name, inner.text, line);
                            }
                                default {};
                            };
                            switch (inner.kind == NodeKind.ARRAY_ACCESS)
                            {
                                case (true) {
                                switch (inner.a.kind == NodeKind.IDENTIFIER)
                                {
                                    case (true) {
                                    s = this.var_site_of(inner.a.text);
                                    switch (s != (byte*)0) { case (true) { -> s; } default {}; };
                                    -> bc_stack_site(this.alias.func_name, inner.a.text, line);
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                            -> g"unknown\0";
                        }
                            default
                            {
                                switch (bc_is_fmalloc(expr))
                                {
                                    case (true) { -> bc_heap_site(this.alias.func_name, expr.line); }
                                    default
                                    {
                                        switch (bc_is_ffree(expr))
                                        {
                                            case (true) { -> g"unknown\0"; }
                                            default
                                            {

                                                switch (expr.kind == NodeKind.BINARY_OP)
                                                {
                                                    case (true) {
                                                    switch (expr.op == Operator.ADD | expr.op == Operator.SUB)
                                                    {
                                                        case (true) {
                                                        s = this.resolve_site(expr.a, var_name, file, line);
                                                        switch (!cstr_eq(s, g"unknown\0")) { case (true) { -> bc_prefixed(g"derived:\0", s); } default
                                                            {
                                                                t = this.resolve_site(expr.b, var_name, file, line);
                                                                switch (!cstr_eq(t, g"unknown\0")) { case (true) { -> t; } default
                                                                    {
                                                                        -> g"unknown\0";
                                                                    }; };
                                                            }; };
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };

                                                switch (expr.kind == NodeKind.IDENTIFIER)
                                                {
                                                    case (true) {
                                                    info = this.alias.find_ptr(expr.text);
                                                    switch (info != (BPtr*)0)
                                                    {
                                                        case (true) {
                                                        switch (om_has(this.alias.freed_sites, info.site))
                                                        {
                                                            case (true) { -> bc_prefixed(g"freed:\0", info.site); }
                                                            default {};
                                                        };
                                                        -> info.site;
                                                    }
                                                        default {};
                                                    };
                                                    s = this.var_site_of(expr.text);
                                                    switch (s != (byte*)0) { case (true) { -> s; } default {}; };
                                                    -> g"unknown\0";
                                                }
                                                    default
                                                    {

                                                        switch (expr.kind == NodeKind.STRING_LITERAL)
                                                        {
                                                            case (true) { -> this.str_site(expr); }
                                                            default
                                                            {

                                                                switch (bc_is_cast(expr))
                                                                {
                                                                    case (true) {
                                                                    switch (bc_is_fmalloc(expr.a))
                                                                    {
                                                                        case (true) { -> bc_heap_site(this.alias.func_name, expr.a.line); }
                                                                        default {};
                                                                    };
                                                                    s = this.resolve_site(expr.a, var_name, file, line);
                                                                    switch (!cstr_eq(s, g"unknown\0")) { case (true) { -> bc_prefixed(g"derived:\0", s); } default {}; };
                                                                    -> g"unknown\0";
                                                                }
                                                                    default
                                                                    {
                                                                        -> g"unknown\0";
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            check_bounds_at_access(byte* var_name, Node* index_expr, byte* file, int line, bool write) -> void
            {
                int idx;
                int fi;
                int k;
                ScopeFrame* f;
                byte* site;
                int size;
                PtrVec* det;
                switch (index_expr == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {

                        switch (!this.const_int(index_expr))
                        {
                            case (true) { ->; }
                            default
                            {
                                idx = (int)this.lit_val;
                                switch (this.alias.find_ptr(var_name) != (BPtr*)0)
                                {
                                    case (true) {
                                    -> this.alias.check_bounds(var_name, idx, file, line, write);
                                }
                                    default
                                    {

                                        fi = this.alias.frames.len - 1;
                                        while (fi >= 0)
                                        {
                                            f = (ScopeFrame*)this.alias.frames.items[fi];
                                            k = om_find(f.var_sites, var_name);
                                            switch (k >= 0)
                                            {
                                                case (true) {
                                                site = (byte*)f.var_sites.vs.items[k];
                                                switch (om_has(this.alias.alloc_sizes, site))
                                                {
                                                    case (true) {
                                                    size = ((int*)om_get(this.alias.alloc_sizes, site))[0];
                                                    switch (size >= 0 & (idx < 0 | idx >= size))
                                                    {
                                                        case (true) {
                                                        det = pv_new();
                                                        this.sb.clear();
                                                        this.sb.put_str(f"'{var_name}' -> {site} (size {size})\0");
                                                        pv_push(det, (void*)ts_dup(this.sb.mem));
                                                        this.sb.clear();
                                                        this.sb.put_str(f"index {idx}\0");
                                                        switch (idx < 0)
                                                        {
                                                            case (true) { this.sb.put_str(g" < 0\0"); }
                                                            default { this.sb.put_str(g" >= size\0"); };
                                                        };
                                                        pv_push(det, (void*)ts_dup(this.sb.mem));
                                                        this.sb.clear();
                                                        this.sb.put_str(g"array \0");
                                                        switch (write)
                                                        {
                                                            case (true) { this.sb.put_str(g"write\0"); }
                                                            default { this.sb.put_str(g"access\0"); };
                                                        };
                                                        this.sb.put_str(f" on '{var_name}' at index {idx} is out of bounds (size {size})\0");
                                                        switch (write)
                                                        {
                                                            case (true) { this.alias.add_vio(g"buffer_overflow\0", ts_dup(this.sb.mem), file, line, det); }
                                                            default { this.alias.add_vio(g"out_of_bounds\0", ts_dup(this.sb.mem), file, line, det); };
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                ->;
                                            }
                                                default
                                                {
                                                    fi--;
                                                };
                                            };
                                        };
                                        ->;
                                    };
                                };
                            };
                        };
                    };
                };
            };



            walk_args(NodeVec* args) -> void
            {
                int i;
                switch (args == (NodeVec*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        while (i < args.len)
                        {
                            this.walk_expr(args.items[i]);
                            i++;
                        };
                        ->;
                    };
                };
            };


            enter_callee(byte* name, NodeVec* args, byte* file, int line) -> void
            {
                Node* f = (Node*)nm_get(this.cg.funcs, name);
                PtrVec* ctx = this.build_call_ctx(f, args, file, line);
                switch (!this.cg.is_visited(name, ctx, this.in_thread))
                {
                    case (true) { this.check_function(f, this.in_thread, ctx); }
                    default {};
                };
                ->;
            };

            handle_spawn(Node* node, byte* file, int line) -> void
            {
                NodeVec* args = node.l0;
                byte* spawned = (byte*)0;
                byte* cand;
                int i;
                Node* sf;
                PtrVec* ctx;
                PtrVec* mp;
                int* sc;
                int prev_count;
                PtrVec* det;
                byte* shortn;
                Node* mpn;
                int na = 0;
                switch (args != (NodeVec*)0) { case (true) { na = args.len; } default {}; };
                while (i < na & spawned == (byte*)0)
                {
                    cand = this.unwrap_ptr_ident(args.items[i]);
                    i++;
                    switch (cand != (byte*)0)
                    {
                        case (true) {
                        switch (cand[0] != 0)
                        {
                            case (true) {
                            switch (nm_has(this.cg.funcs, cand))
                            {
                                case (true) { spawned = cand; }
                                default {
                                shortn = (byte*)nm_get(this.cg.short_names, cand);
                                switch (shortn != (byte*)0)
                                {
                                    case (true) { spawned = shortn; }
                                    default {};
                                };
                            };
                            };
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                };
                i = 0;
                while (i < na)
                {
                    cand = this.unwrap_ptr_ident(args.items[i]);
                    i++;
                    switch (cand != (byte*)0)
                    {
                        case (true) {
                        switch (cand[0] != 0) { case (true) { this.alias.check_thread_escape(cand, file, line); } default {}; };
                    }
                        default {};
                    };
                };
                switch (spawned != (byte*)0)
                {
                    case (true) {
                    switch (nm_has(this.cg.funcs, spawned))
                    {
                        case (true) {
                        sc = (int*)nm_get(this.cg.spawn_count, spawned);
                        prev_count = 0;
                        switch (sc != (int*)0) { case (true) { prev_count = sc[0]; } default {}; };
                        nm_put(this.cg.spawn_count, spawned, (void*)bx_new(prev_count + 1));
                        sf = (Node*)nm_get(this.cg.funcs, spawned);
                        ctx = this.build_call_ctx(sf, args, file, line);
                        switch (!this.cg.is_visited(spawned, ctx, true))
                        {
                            case (true) { this.check_function(sf, true, ctx); }
                            default {};
                        };

                        switch (prev_count >= 1)
                        {
                            case (true) {
                            mp = this.ptr_params(sf);
                            switch (mp.len > 0)
                            {
                                case (true) {
                                this.sb.clear();
                                this.sb.put_str(f"function '{spawned}' is spawned as a thread \0");
                                this.sb.put_int(prev_count + 1);
                                this.sb.put_str(g" times -- concurrent instances share mutable pointer parameter(s): \0");
                                i = 0;
                                while (i < mp.len)
                                {
                                    switch (i > 0) { case (true) { this.sb.put_str(g", \0"); } default {}; };
                                    mpn = (Node*)mp.items[i];
                                    this.sb.put_str(mpn.text);
                                    i++;
                                };
                                det = pv_new();
                                pv_push(det, (void*)g"each spawn receives a separate pointer value but if those values alias the same allocation site, a data race exists between the concurrent instances\0");
                                this.add_direct(g"thread_self_race\0", ts_dup(this.sb.mem), file, line, det);
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                }
                    default {};
                };
                ->;
            };


            add_direct(byte* kind, byte* msg, byte* file, int line, PtrVec* det) -> void
            {
                BVio* v = (BVio*)fmalloc((u64)((sizeof(BVio) + 7) / 8));
                v.kind = kind;
                v.msg = msg;
                v.file = file;
                v.line = line;
                v.detail = det;
                v.func = this.alias.func_name;
                -> pv_push(this.violations, (void*)v);
            };

            handle_call(Node* node, byte* file, int line) -> void
            {
                byte* callee = node.text;
                byte* resolved;
                byte* base_name;
                bool is_alloc;
                PtrVec* ov;
                PtrVec* names;
                PtrVec* sites;
                int i;
                switch (callee != (byte*)0)
                {
                    case (true) { switch (callee[0] == 0) { case (true) { callee = (byte*)0; } default {}; }; }
                    default {};
                };
                switch (callee != (byte*)0)
                {
                    case (true) {
                    resolved = (byte*)0;
                    switch (nm_has(this.cg.funcs, callee))
                    {
                        case (true) { resolved = callee; }
                        default { resolved = (byte*)nm_get(this.cg.short_names, callee); };
                    };

                    switch (resolved != (byte*)0)
                    {
                        case (true) { base_name = bc_last_seg(resolved); }
                        default { base_name = bc_last_seg(callee); };
                    };
                    is_alloc = cstr_eq(base_name, g"fmalloc\0") | cstr_eq(base_name, g"ffree\0")
                               | cstr_eq(callee, g"fmalloc\0") | cstr_eq(callee, g"ffree\0");
                    switch (resolved != (byte*)0 & !is_alloc)
                    {
                        case (true) { this.enter_callee(resolved, node.l0, file, line); }
                        default {
                        switch (!is_alloc)
                        {
                            case (true) {
                            ov = (PtrVec*)nm_get(this.cg.overloads, callee);
                            switch (ov != (PtrVec*)0)
                            {
                                case (true) {
                                i = 0;
                                while (i < ov.len)
                                {
                                    this.enter_callee((byte*)ov.items[i], node.l0, file, line);
                                    i++;
                                };
                            }
                                default {};
                            };

                            switch (ov == (PtrVec*)0)
                            {
                                case (true) {
                                names = pv_new();
                                sites = pv_new();
                                this.collect_arg_sites(node.l0, file, line, names, sites);
                                this.alias.check_call_args(names, sites, file, line);
                            }
                                default {
                                switch (ov.len == 0)
                                {
                                    case (true) {
                                    names = pv_new();
                                    sites = pv_new();
                                    this.collect_arg_sites(node.l0, file, line, names, sites);
                                    this.alias.check_call_args(names, sites, file, line);
                                }
                                    default {};
                                };
                            };
                            };
                        }
                            default {};
                        };
                    };
                    };
                }
                    default {
                    names = pv_new();
                    sites = pv_new();
                    this.collect_arg_sites(node.l0, file, line, names, sites);
                    this.alias.check_call_args(names, sites, file, line);
                };
                };
                -> this.walk_args(node.l0);
            };

            handle_method_call(Node* node, byte* file, int line) -> void
            {
                byte* method = node.text;
                byte* hint;
                byte* resolved = (byte*)0;
                byte* cand;
                byte* sfx;
                byte* shortn;
                int pass;
                int i;
                PtrVec* names;
                PtrVec* sites;
                this.walk_expr(node.a);
                this.walk_args(node.l0);
                switch (method == (byte*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (method[0] == 0)
                        {
                            case (true) { ->; }
                            default
                            {
                                hint = this.unwrap_ptr_ident(node.a);
                                switch (hint == (byte*)0) { case (true) { hint = g"\0"; } default {}; };

                                pass = 0;
                                while (pass < 2 & resolved == (byte*)0)
                                {
                                    cand = (byte*)0;
                                    switch (pass == 0)
                                    {
                                        case (true) {
                                        switch (hint[0] != 0) { case (true) { cand = join3(hint, g"__\0", method); } default {}; };
                                    }
                                        default { cand = method; };
                                    };
                                    switch (cand != (byte*)0)
                                    {
                                        case (true) {
                                        switch (nm_has(this.cg.funcs, cand))
                                        {
                                            case (true) { resolved = cand; }
                                            default {
                                            shortn = (byte*)nm_get(this.cg.short_names, cand);
                                            switch (shortn != (byte*)0) { case (true) { resolved = shortn; } default {}; };
                                        };
                                        };
                                    }
                                        default {};
                                    };
                                    pass++;
                                };

                                switch (resolved == (byte*)0)
                                {
                                    case (true) {
                                    sfx = join3(g"__\0", method, g"\0");
                                    i = 0;
                                    while (i < this.cg.funcs.count & resolved == (byte*)0)
                                    {
                                        switch (this.cg.funcs.vals[i] != (void*)0)
                                        {
                                            case (true) {
                                            switch (bc_ends(this.cg.funcs.keys[i], sfx))
                                            {
                                                case (true) { resolved = this.cg.funcs.keys[i]; }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        i++;
                                    };
                                }
                                    default {};
                                };
                                switch (resolved != (byte*)0)
                                {
                                    case (true) { this.enter_callee(resolved, node.l0, file, line); }
                                    default {
                                    names = pv_new();
                                    sites = pv_new();
                                    this.collect_arg_sites(node.l0, file, line, names, sites);
                                    this.alias.check_call_args(names, sites, file, line);
                                };
                                };
                                ->;
                            };
                        };
                    };
                };
            };


            handle_assign_expr(Node* node, byte* file, int line) -> void
            {
                Node* arr;
                byte* new_site;
                this.walk_expr(node.b);
                switch (this.check_threads)
                {
                    case (true) {
                    switch (node.a.kind == NodeKind.IDENTIFIER)
                    {
                        case (true) { this.check_ident_escape(node.a.text, file, line); }
                        default {
                        switch (node.a.kind == NodeKind.ARRAY_ACCESS)
                        {
                            case (true) {
                            switch (node.a.a.kind == NodeKind.IDENTIFIER)
                            {
                                case (true) { this.check_ident_escape(node.a.a.text, file, line); }
                                default {};
                            };
                        }
                            default {};
                        };
                    };
                    };
                }
                    default {};
                };
                switch (node.a.kind == NodeKind.POINTER_DEREF)
                {
                    case (true) {
                    arr = node.a.a;
                    switch (arr.kind == NodeKind.IDENTIFIER)
                    {
                        case (true) {
                        this.alias.check_use_after_free(arr.text, file, line);
                        this.alias.check_write_alias(arr.text, file, line);
                    }
                        default {};
                    };
                }
                    default {
                    switch (node.a.kind == NodeKind.ARRAY_ACCESS)
                    {
                        case (true) {
                        arr = node.a.a;
                        switch (arr.kind == NodeKind.IDENTIFIER)
                        {
                            case (true) {
                            this.alias.check_use_after_free(arr.text, file, line);
                            this.alias.check_write_alias(arr.text, file, line);
                            this.check_bounds_at_access(arr.text, node.a.b, file, line, true);
                            switch (this.check_leaks & node.b.kind == NodeKind.IDENTIFIER)
                            {
                                case (true) { this.note_array_store(arr.text, node.b.text); }
                                default {};
                            };
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                };
                };
                switch (node.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true) {
                    switch (this.alias.find_ptr(node.a.text) != (BPtr*)0)
                    {
                        case (true) {
                        new_site = this.resolve_site(node.b, node.a.text, bc_unk(), node.line);
                        this.alias.assign_ptr(node.a.text, new_site, true, bc_unk(), node.line);
                    }
                        default {};
                    };
                }
                    default {};
                };
                ->;
            };

            walk_expr(Node* node) -> void
            {
                byte* file;
                int line;
                int k;
                Node* fnode;
                byte* site;
                Node* arg;
                byte* freed_site;
                switch (node == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        file = bc_unk();
                        line = node.line;
                        k = node.kind;


                        fnode = node;
                        switch (bc_is_cast(node))
                        {
                            case (true) { fnode = node.a; }
                            default {};
                        };
                        switch (fnode != (Node*)0 & this.check_leaks)
                        {
                            case (true) {
                            switch (bc_is_fmalloc(fnode))
                            {
                                case (true) {
                                site = bc_heap_site(this.alias.func_name, fnode.line);
                                this.alias.record_malloc(site, file, fnode.line);

                                switch (bc_count(fnode, 0) > 0)
                                {
                                    case (true) {
                                    switch (this.const_int(node_child(fnode, 0, 0)))
                                    {
                                        case (true) { this.alias.record_alloc_size(site, (int)this.lit_val); }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };

                        switch (bc_is_ffree(node) & this.check_leaks)
                        {
                            case (true) {
                            switch (bc_count(node, 0) > 0)
                            {
                                case (true) {
                                arg = node_child(node, 0, 0);
                                freed_site = this.resolve_ffree_arg(arg);
                                switch (freed_site[0] != 0 & !cstr_eq(freed_site, g"unknown\0"))
                                {
                                    case (true) {
                                    this.alias.record_free(freed_site);
                                    this.alias.mark_freed(freed_site, file, line);
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };

                        switch (this.check_threads)
                        {
                            case (true) {
                            switch (bc_is_thread_spawn(node))
                            {
                                case (true) { this.handle_spawn(node, file, line); }
                                default {};
                            };
                            switch (k == NodeKind.IDENTIFIER)
                            {
                                case (true) { this.check_ident_escape(node.text, file, line); }
                                default {};
                            };
                        }
                            default {};
                        };

                        switch (k == NodeKind.FUNCTION_CALL)
                        {
                            case (true) { -> this.handle_call(node, file, line); }
                            default
                            {
                                switch (k == NodeKind.METHOD_CALL)
                                {
                                    case (true) { -> this.handle_method_call(node, file, line); }
                                    default
                                    {
                                        switch (k == NodeKind.BINARY_OP)
                                        {
                                            case (true) { this.walk_expr(node.a); this.walk_expr(node.b); ->; }
                                            default
                                            {
                                                switch (k == NodeKind.UNARY_OP | k == NodeKind.ADDRESS_OF | bc_is_cast(node))
                                                {
                                                    case (true) { -> this.walk_expr(node.a); }
                                                    default
                                                    {
                                                        switch (k == NodeKind.POINTER_DEREF)
                                                        {
                                                            case (true) {
                                                            switch (node.a.kind == NodeKind.IDENTIFIER)
                                                            {
                                                                case (true) {
                                                                switch (this.check_threads)
                                                                {
                                                                    case (true) { this.alias.check_use_after_escape(node.a.text, file, line); }
                                                                    default {};
                                                                };
                                                                this.alias.check_use_after_free(node.a.text, file, line);
                                                            }
                                                                default {};
                                                            };
                                                            -> this.walk_expr(node.a);
                                                        }
                                                            default
                                                            {
                                                                switch (k == NodeKind.MEMBER_ACCESS)
                                                                {
                                                                    case (true) { -> this.walk_expr(node.a); }
                                                                    default
                                                                    {
                                                                        switch (k == NodeKind.ARRAY_ACCESS)
                                                                        {
                                                                            case (true) {
                                                                            switch (node.a.kind == NodeKind.IDENTIFIER)
                                                                            {
                                                                                case (true) {
                                                                                switch (this.check_threads)
                                                                                {
                                                                                    case (true) { this.alias.check_use_after_escape(node.a.text, file, line); }
                                                                                    default {};
                                                                                };
                                                                                this.alias.check_use_after_free(node.a.text, file, line);
                                                                                this.check_bounds_at_access(node.a.text, node.b, file, line, false);
                                                                            }
                                                                                default {};
                                                                            };
                                                                            this.walk_expr(node.a);
                                                                            -> this.walk_expr(node.b);
                                                                        }
                                                                            default
                                                                            {
                                                                                switch (k == NodeKind.IF_EXPRESSION)
                                                                                {
                                                                                    case (true) {

                                                                                    this.walk_expr(node.b);
                                                                                    this.walk_expr(node.a);
                                                                                    -> this.walk_expr(node.c);
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        switch (k == NodeKind.TERNARY_OP)
                                                                                        {
                                                                                            case (true) {
                                                                                            this.walk_expr(node.a);
                                                                                            this.walk_expr(node.b);
                                                                                            -> this.walk_expr(node.c);
                                                                                        }
                                                                                            default
                                                                                            {
                                                                                                switch (k == NodeKind.ASSIGNMENT)
                                                                                                {
                                                                                                    case (true) { -> this.handle_assign_expr(node, file, line); }
                                                                                                    default
                                                                                                    {
                                                                                                        switch (k == NodeKind.COMPOUND_ASSIGNMENT)
                                                                                                        {
                                                                                                            case (true) { this.walk_expr(node.b); }
                                                                                                            default {};
                                                                                                        };
                                                                                                        ->;
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };





        def bc_str_lt(byte* a, byte* b) -> bool
        {
            int i = 0;
            while (a[i] != 0 & b[i] != 0)
            {
                if (a[i] != b[i]) { return a[i] < b[i]; };
                i++;
            };
            return a[i] < b[i];
        };

        def bc_print_violations(PtrVec* vs, bool warn) -> void
        {
            int i;
            int j;
            BVio* v;
            switch (vs.len == 0)
            {
                case (true) { ->; }
                default
                {
                    while (i < vs.len)
                    {
                        v = (BVio*)vs.items[i];
                        if (warn & !cstr_eq(v.kind, g"async_contradiction\0")) { print(g"[FBC warning] \0"); }
                        else { print(g"[FBC error] \0"); };
                        println(v.kind);
                        print(g"  \0");
                        print(v.file);
                        print(g":\0");
                        print(v.line);
                        print(g"  \0");
                        println(v.msg);
                        j = 0;
                        while (j < v.detail.len)
                        {
                            print(g"  \0");
                            println((byte*)v.detail.items[j]);
                            j++;
                        };
                        println(g"\0");
                        i++;
                    };
                    ->;
                };
            };
        };

        def bc_print_summary(PtrVec* vs, int files_checked, int funcs_checked) -> void
        {
            int i;
            int j;
            int n = vs.len;
            BVio* v;
            OMap* kinds;
            int* cnt;
            PtrVec* order;
            byte* tmp;
            if (n == 0)
            {
                print(g"[FBC] OK -- \0");
                print(files_checked);
                print(g" file(s), \0");
                print(funcs_checked);
                println(g" function(s) checked, no violations found.\0");
                return;
            };
            kinds = om_new();
            order = pv_new();
            while (i < n)
            {
                v = (BVio*)vs.items[i];
                cnt = (int*)om_get(kinds, v.kind);
                switch (cnt == (int*)0)
                {
                    case (true) {
                    om_put(kinds, v.kind, (void*)bx_new(1));
                    pv_push(order, (void*)v.kind);
                }
                    default { cnt[0] = cnt[0] + 1; };
                };
                i++;
            };

            i = 1;
            while (i < order.len)
            {
                j = i;
                while (j > 0)
                {
                    if (!bc_str_lt((byte*)order.items[j], (byte*)order.items[j - 1])) { break; };
                    tmp = (byte*)order.items[j];
                    order.items[j] = order.items[j - 1];
                    order.items[j - 1] = (void*)tmp;
                    j--;
                };
                i++;
            };
            print(g"[FBC] \0");
            print(n);
            print(g" violation(s) -- \0");
            print(files_checked);
            print(g" file(s), \0");
            print(funcs_checked);
            println(g" function(s) checked\0");
            print(g"  \0");
            i = 0;
            while (i < order.len)
            {
                switch (i > 0) { case (true) { print(g", \0"); } default {}; };
                print((byte*)order.items[i]);
                print(g": \0");
                cnt = (int*)om_get(kinds, (byte*)order.items[i]);
                print(cnt[0]);
                i++;
            };
            println(g"\0");
            i = 0;
            while (i < kinds.vs.len)
            {
                ffree((byte*)kinds.vs.items[i]);
                i++;
            };
            om_free(kinds);
            pv_free(order);
            return;
        };














































        struct LTerm
        {
            int p;              
            int c;
        };

        struct LRng
        {
            LTerm* lo, hi;
        };

        struct LAcc
        {
            int bits;
            bool atomic;
            LRng* rng;          
        };


        struct LTask
        {
            byte* fn;
            OMap* fp;           
            int line;
            byte* result_var, bid;
            Node* node;
        };


        struct LPat
        {
            byte* name;
            LTerm* lo, hi;
        };

        def lf_term(int p, int c) -> LTerm*
        {
            LTerm* t = (LTerm*)fmalloc((u64)((sizeof(LTerm) + 7) / 8));
            t
            {
                .p = p;
                .c = c;
            };
            return t;
        };

        def lf_term_eq(LTerm* a, LTerm* b) -> bool
        {
            if (a == (LTerm*)0) { return b == (LTerm*)0; };
            if (b == (LTerm*)0) { return false; };
            return a.p == b.p & a.c == b.c;
        };

        def lf_rng(LTerm* lo, LTerm* hi) -> LRng*
        {
            LRng* r = (LRng*)fmalloc((u64)((sizeof(LRng) + 7) / 8));
            r
            {
                .lo = lo;
                .hi = hi;
            };
            return r;
        };

        def lf_rng_eq(LRng* a, LRng* b) -> bool
        {
            if (a == (LRng*)0) { return b == (LRng*)0; };
            if (b == (LRng*)0) { return false; };
            return lf_term_eq(a.lo, b.lo) & lf_term_eq(a.hi, b.hi);
        };

        def lf_acc(int bits, bool atomic, LRng* rng) -> LAcc*
        {
            LAcc* a = (LAcc*)fmalloc((u64)((sizeof(LAcc) + 7) / 8));
            a
            {
                .bits = bits;
                .atomic = atomic;
                .rng = rng;
            };
            return a;
        };

        def lf_acc_eq(LAcc* a, LAcc* b) -> bool
        {
            return a.bits == b.bits & a.atomic == b.atomic & lf_rng_eq(a.rng, b.rng);
        };


        def lf_modes_conflict(LAcc* a, LAcc* b) -> bool
        {
            int bits = a.bits `| b.bits;
            if ((bits `& 4) != 0) { return true; };
            if ((bits `& 2) != 0) { return !(a.atomic & b.atomic); };
            return false;
        };


        def lf_term_le(LTerm* a, LTerm* b) -> bool
        {
            if (a.p == b.p) { return a.c <= b.c; };
            return false;
        };


        def lf_ranges_overlap(LRng* r1, LRng* r2) -> bool
        {
            if (r1 == (LRng*)0 | r2 == (LRng*)0) { return true; };
            if (lf_term_le(r1.hi, r1.lo) | lf_term_le(r2.hi, r2.lo)) { return false; };
            if (lf_term_le(r1.hi, r2.lo) | lf_term_le(r2.hi, r1.lo)) { return false; };
            return true;
        };

        def lf_mode_name(LAcc* m) -> byte*
        {
            if ((m.bits `& 4) != 0) { return g"free\0"; };
            if ((m.bits `& 2) != 0)
            {
                if (m.atomic) { return g"atomic write\0"; };
                return g"write\0";
            };
            if (m.atomic) { return g"atomic read\0"; };
            return g"read\0";
        };


        def lf_op_bit(byte* op) -> int
        {
            if (op[0] == '#') { return 1; };
            if (op[0] == '>') { return 2; };
            if (op[0] == '~') { return 4; };
            if (op[0] == '!') { return 8; };
            return 16;
        };


        def lf_pair_key(byte* a, byte* b) -> byte*
        {
            return join3(a, g"\x1f\0", b);
        };


        def lf_fp_list(OMap* d, byte* key) -> PtrVec*
        {
            PtrVec* lst = (PtrVec*)om_get(d, key);
            if (lst == (PtrVec*)0)
            {
                lst = pv_new();
                om_put(d, key, (void*)lst);
            };
            return lst;
        };


        def lf_merge_fp(OMap* d, byte* key, int bits, bool atomic, LRng* rng) -> void
        {
            PtrVec* lst = lf_fp_list(d, key);
            LAcc* t = lf_acc(bits, atomic, rng);
            int i, b;
            bool at;
            PtrVec* one;
            while (i < lst.len)
            {
                if (lf_acc_eq((LAcc*)lst.items[i], t)) { return; };
                i++;
            };
            pv_push(lst, (void*)t);
            if (lst.len > 8)
            {
                b = 0;
                at = true;
                i = 0;
                while (i < lst.len)
                {
                    b = b `| ((LAcc*)lst.items[i]).bits;
                    at = at & ((LAcc*)lst.items[i]).atomic;
                    i++;
                };
                one = pv_new();
                pv_push(one, (void*)lf_acc(b, at, (LRng*)0));
                om_put(d, key, (void*)one);
            };
            return;
        };

        struct LocInfo
        {
            int kind;           
            byte* reg;
        };

        struct LState
        {
            OMap* env;          
            OMap* held;         
            OMap* status;       
            OMap* esc;          
            OMap* free_at;      
            PtrVec* active;     
            bool dead;
            OMap* tasks;        
            OMap* terms;        
        };

        struct LHeld
        {
            int idx;
            PtrVec* path;       
            PtrVec* regs;
        };

        struct LPos
        {
            int seq;
            PtrVec* path;       
            PtrVec* loops;      
        };


        struct LAl
        {
            OMap* ix;           
            OMap* uses;         
            OMap* defs;         
            OMap* first;        
            OMap* writers;
            OMap* loop_start;   
            OMap* loop_end, ptr_vars;
            OMap* deriv;        
            OMap* wr_params;    
            int seq;
        };

        struct LSumm
        {
            OMap* wr;           
            PtrVec* ret;
            int nparams;
            OMap* param_status; 
            PtrVec* param_held; 
            OMap* heap_status;  
            OMap* esc, free_at;
            OMap* fp;           
        };

        struct LRet
        {
            LState* st;
            PtrVec* regs;
        };

        struct LLoop
        {
            PtrVec* breaks, conts;
        };



        def lf_rs_new() -> PtrVec* -> pv_new();

        def lf_rs_has(PtrVec* s, byte* r) -> bool
        {
            int i;
            while (i < s.len)
            {
                if (cstr_eq((byte*)s.items[i], r)) { return true; };
                i++;
            };
            return false;
        };


        def lf_rs_add(PtrVec* s, byte* r) -> void
        {
            int i, at;
            if (lf_rs_has(s, r)) { return; };
            at = s.len;
            while (i < s.len)
            {
                if (bc_str_lt(r, (byte*)s.items[i]))
                {
                    at = i;
                    break;
                };
                i++;
            };
            pv_push(s, (void*)r);
            i = s.len - 1;
            while (i > at)
            {
                s.items[i] = s.items[i - 1];
                i--;
            };
            s.items[at] = (void*)r;
            return;
        };

        def lf_rs_one(byte* r) -> PtrVec*
        {
            PtrVec* s = pv_new();
            pv_push(s, (void*)r);
            return s;
        };

        def lf_rs_union(PtrVec* a, PtrVec* b) -> PtrVec*
        {
            int i;
            PtrVec* r;
            if (a.len == 0) { return b; };
            if (b.len == 0) { return a; };
            r = pv_new();
            while (i < a.len) { lf_rs_add(r, (byte*)a.items[i]); i++; };
            i = 0;
            while (i < b.len) { lf_rs_add(r, (byte*)b.items[i]); i++; };
            return r;
        };

        def lf_rs_eq(PtrVec* a, PtrVec* b) -> bool
        {
            int i;
            if (a.len != b.len) { return false; };
            while (i < a.len)
            {
                if (!cstr_eq((byte*)a.items[i], (byte*)b.items[i])) { return false; };
                i++;
            };
            return true;
        };



        def lf_key(byte* tag, byte* a, byte* b, byte* c) -> byte*
        {
            Buf k;
            byte* out;
            k.__init();
            k.put_str(tag);
            if (a != (byte*)0) { k.put_str(g"|\0"); k.put_str(a); };
            if (b != (byte*)0) { k.put_str(g"|\0"); k.put_str(b); };
            if (c != (byte*)0) { k.put_str(g"|\0"); k.put_str(c); };
            out = ts_dup(k.mem);
            k.__exit();
            return out;
        };

        def lf_itoa(int n) -> byte*
        {
            Buf k;
            byte* out;
            k.__init();
            k.put_int(n);
            out = ts_dup(k.mem);
            k.__exit();
            return out;
        };

        def lf_atoi(byte* s) -> int
        {
            int v, i;
            while (s[i] >= '0' & s[i] <= '9')
            {
                v = v * 10 + ((int)s[i] - 48);
                i++;
            };
            return v;
        };


        def lf_seg(byte* r, int n) -> byte*
        {
            int i, seg, start, j;
            Buf k;
            byte* out;
            while (r[i] != 0 & seg < n)
            {
                if (r[i] == '|') { seg++; start = i + 1; };
                i++;
            };
            j = start;
            k.__init();
            while (r[j] != 0 & r[j] != '|')
            {
                k.put((int)r[j]);
                j++;
            };
            out = ts_dup(k.mem);
            k.__exit();
            return out;
        };


        def lf_after(byte* r, int n) -> byte*
        {
            int i, seen;
            while (r[i] != 0)
            {
                if (r[i] == '|')
                {
                    seen++;
                    if (seen == n) { return r + i + 1; };
                };
                i++;
            };
            return (byte*)0;
        };

        def lf_stack(byte* func, byte* name, byte* bid) -> byte*
        {
            Buf k;
            byte* out;
            k.__init();
            k.put_str(f"S|{func}|{name}|{bid}\0");
            out = ts_dup(k.mem);
            k.__exit();
            return out;
        };

        def lf_param(byte* func, int idx) -> byte*
        {
            byte* t = lf_itoa(idx);
            return lf_key(g"P\0", func, t, (byte*)0);
        };

        def lf_static(byte* name) -> byte* -> lf_key(g"G\0", name, (byte*)0, (byte*)0);

        def lf_dangling(byte* func, byte* name) -> byte* -> lf_key(g"D\0", func, name, (byte*)0);

        def lf_heap(byte* func, int line, byte* inner) -> byte*
        {
            Buf k;
            byte* out;
            k.__init();
            k.put_str(f"H|{func}|{line}\0");
            if (inner != (byte*)0)
            {
                k.put_str(f"|{inner}\0");
            };
            out = ts_dup(k.mem);
            k.__exit();
            return out;
        };


        def lf_heap_c(byte* func, int line, int col, byte* inner) -> byte*
        {
            Buf k;
            byte* out;
            k.__init();
            k.put_str(f"H|{func}|{line}@{col}|{inner}\0");
            out = ts_dup(k.mem);
            k.__exit();
            return out;
        };

        def lf_fld(byte* cell, byte* member) -> byte*
        {
            Buf k;
            byte* out;
            k.__init();
            k.put_str(f"F|{cell}|{member}\0");
            out = ts_dup(k.mem);
            k.__exit();
            return out;
        };


        def lf_fld_cell(byte* c) -> byte*
        {
            int n = bc_len(c);
            int last, i;
            Buf k;
            byte* out;
            while (i < n)
            {
                if (c[i] == '|') { last = i; };
                i++;
            };
            k.__init();
            i = 2;
            while (i < last)
            {
                k.put((int)c[i]);
                i++;
            };
            out = ts_dup(k.mem);
            k.__exit();
            return out;
        };

        def lf_fld_member(byte* c) -> byte*
        {
            int n = bc_len(c);
            int last, i;
            while (i < n)
            {
                if (c[i] == '|') { last = i; };
                i++;
            };
            return ts_dup(c + last + 1);
        };

        def lf_root(byte* c) -> byte*
        {
            byte* r = c;
            while (r[0] == 'F')
            {
                r = lf_fld_cell(r);
            };
            return r;
        };


        def lf_origin(byte* r) -> byte*
        {
            byte* cur = r;
            byte* inner;
            while (cur[0] == 'H')
            {
                inner = lf_after(cur, 3);
                if (inner == (byte*)0) { break; };
                cur = inner;
            };
            return cur;
        };



        def lf_state_new() -> LState*
        {
            LState* s = (LState*)fmalloc((u64)((sizeof(LState) + 7) / 8));
            s
            {
                .env = om_new();
                .held = om_new();
                .status = om_new();
                .esc = om_new();
                .free_at = om_new();
                .active = pv_new();
                .dead = false;
                .tasks = om_new();
                .terms = om_new();
            };
            return s;
        };

        def lf_state_copy(LState* a) -> LState*
        {
            LState* s = (LState*)fmalloc((u64)((sizeof(LState) + 7) / 8));
            int i;
            s
            {
                .env = om_copy(a.env);
                .held = om_copy(a.held);
                .status = om_copy(a.status);
                .esc = om_copy(a.esc);
                .free_at = om_copy(a.free_at);
                .active = pv_new();
            };
            while (i < a.active.len) { pv_push(s.active, a.active.items[i]); i++; };
            s
            {
                .dead = a.dead;
                .tasks = om_copy(a.tasks);
                .terms = om_copy(a.terms);
            };
            return s;
        };

        def lf_state_set(LState* dst, LState* src) -> void
        {
            dst
            {
                .env = src.env;
                .held = src.held;
                .status = src.status;
                .esc = src.esc;
                .free_at = src.free_at;
                .active = src.active;
                .dead = src.dead;
                .tasks = src.tasks;
                .terms = src.terms;
            };
            return;
        };


        def lf_join_sets(OMap* a, OMap* b) -> OMap*
        {
            OMap* out = om_copy(a);
            int i;
            byte* k;
            while (i < b.ks.len)
            {
                k = (byte*)b.ks.items[i];
                if (om_has(out, k))
                {
                    om_put(out, k, (void*)lf_rs_union((PtrVec*)om_get(out, k), (PtrVec*)b.vs.items[i]));
                }
                else
                {
                    om_put(out, k, b.vs.items[i]);
                };
                i++;
            };
            return out;
        };

        def lf_join_flags(OMap* a, OMap* b) -> OMap*
        {
            OMap* out = om_copy(a);
            int i;
            byte* k;
            int* x, y;
            while (i < b.ks.len)
            {
                k = (byte*)b.ks.items[i];
                if (om_has(out, k))
                {
                    x = (int*)om_get(out, k);
                    y = (int*)b.vs.items[i];
                    om_put(out, k, (void*)bx_new(x[0] `| y[0]));
                }
                else
                {
                    om_put(out, k, b.vs.items[i]);
                };
                i++;
            };
            return out;
        };

        def lf_join(LState* a, LState* b) -> LState*
        {
            LState* s;
            int i;
            if (a == (LState*)0) { return b; };
            if (b == (LState*)0) { return a; };
            if (a.dead) { return lf_state_copy(b); };
            if (b.dead) { return lf_state_copy(a); };
            s = (LState*)fmalloc((u64)((sizeof(LState) + 7) / 8));
            s
            {
                .env = lf_join_sets(a.env, b.env);
                .held = lf_join_sets(a.held, b.held);
                .status = lf_join_flags(a.status, b.status);
                .esc = om_copy(a.esc);
            };
            i = 0;
            while (i < b.esc.ks.len)
            {
                om_put(s.esc, (byte*)b.esc.ks.items[i], b.esc.vs.items[i]);
                i++;
            };
            s.free_at = om_copy(a.free_at);
            i = 0;
            while (i < b.free_at.ks.len)
            {
                om_put(s.free_at, (byte*)b.free_at.ks.items[i], b.free_at.vs.items[i]);
                i++;
            };
            s.dead = false;
            if (a.active.len <= b.active.len) { s.active = a.active; } else { s.active = b.active; };
            s.tasks = om_copy(a.tasks);
            i = 0;
            while (i < b.tasks.ks.len)
            {
                om_put(s.tasks, (byte*)b.tasks.ks.items[i], b.tasks.vs.items[i]);
                i++;
            };
            s.terms = om_new();
            i = 0;
            while (i < a.terms.ks.len)
            {
                if (om_has(b.terms, (byte*)a.terms.ks.items[i]))
                {
                    if (lf_term_eq((LTerm*)a.terms.vs.items[i], (LTerm*)om_get(b.terms, (byte*)a.terms.ks.items[i])))
                    {
                        om_put(s.terms, (byte*)a.terms.ks.items[i], a.terms.vs.items[i]);
                    };
                };
                i++;
            };
            return s;
        };

        def lf_eq_sets(OMap* a, OMap* b) -> bool
        {
            int i;
            if (a.ks.len != b.ks.len) { return false; };
            while (i < a.ks.len)
            {
                if (!om_has(b, (byte*)a.ks.items[i])) { return false; };
                if (!lf_rs_eq((PtrVec*)a.vs.items[i], (PtrVec*)om_get(b, (byte*)a.ks.items[i]))) { return false; };
                i++;
            };
            return true;
        };

        def lf_eq_flags(OMap* a, OMap* b) -> bool
        {
            int i;
            int* x, y;
            if (a.ks.len != b.ks.len) { return false; };
            while (i < a.ks.len)
            {
                if (!om_has(b, (byte*)a.ks.items[i])) { return false; };
                x = (int*)a.vs.items[i];
                y = (int*)om_get(b, (byte*)a.ks.items[i]);
                if (x[0] != y[0]) { return false; };
                i++;
            };
            return true;
        };

        def lf_eq_keys(OMap* a, OMap* b) -> bool
        {
            int i;
            if (a.ks.len != b.ks.len) { return false; };
            while (i < a.ks.len)
            {
                if (!om_has(b, (byte*)a.ks.items[i])) { return false; };
                i++;
            };
            return true;
        };

        def lf_eq_terms(OMap* a, OMap* b) -> bool
        {
            int i;
            if (a.ks.len != b.ks.len) { return false; };
            while (i < a.ks.len)
            {
                if (!om_has(b, (byte*)a.ks.items[i])) { return false; };
                if (!lf_term_eq((LTerm*)a.vs.items[i], (LTerm*)om_get(b, (byte*)a.ks.items[i]))) { return false; };
                i++;
            };
            return true;
        };

        def lf_state_eq(LState* a, LState* b) -> bool
        {
            if (a.dead != b.dead) { return false; };
            if (!lf_eq_sets(a.env, b.env)) { return false; };
            if (!lf_eq_sets(a.held, b.held)) { return false; };
            if (!lf_eq_flags(a.status, b.status)) { return false; };
            if (!lf_eq_keys(a.esc, b.esc)) { return false; };
            if (!lf_eq_keys(a.tasks, b.tasks)) { return false; };
            if (!lf_eq_terms(a.terms, b.terms)) { return false; };
            return true;
        };

        def lf_active_has(PtrVec* act, byte* bid) -> bool
        {
            int i;
            while (i < act.len)
            {
                if (cstr_eq((byte*)act.items[i], bid)) { return true; };
                i++;
            };
            return false;
        };

        def lf_flags(OMap* m, byte* k) -> int
        {
            int* p;
            if (!om_has(m, k)) { return 0; };
            p = (int*)om_get(m, k);
            return p[0];
        };

        def lf_is_stmt_kind(int k) -> bool
        {
            return k == NodeKind.EXPRESSION_STATEMENT | k == NodeKind.ASSIGNMENT
                | k == NodeKind.COMPOUND_ASSIGNMENT | k == NodeKind.RANGE_ASSIGNMENT
                | k == NodeKind.TERNARY_ASSIGN | k == NodeKind.BLOCK
                | k == NodeKind.IF_STATEMENT | k == NodeKind.WHILE_LOOP
                | k == NodeKind.DO_LOOP | k == NodeKind.DO_WHILE_LOOP
                | k == NodeKind.FOR_LOOP | k == NodeKind.FOR_IN_LOOP
                | k == NodeKind.RETURN_STATEMENT | k == NodeKind.ERROR_RETURN_STATEMENT
                | k == NodeKind.BREAK_STATEMENT | k == NodeKind.BREAK_SWITCH_STATEMENT
                | k == NodeKind.CONTINUE_STATEMENT | k == NodeKind.DEFER_STATEMENT
                | k == NodeKind.NORETURN_STATEMENT | k == NodeKind.ESCAPE_STATEMENT
                | k == NodeKind.LABEL_STATEMENT | k == NodeKind.GOTO_STATEMENT
                | k == NodeKind.JUMP_STATEMENT | k == NodeKind.SWITCH_STATEMENT
                | k == NodeKind.TRY_BLOCK | k == NodeKind.THROW_STATEMENT
                | k == NodeKind.ASSERT_STATEMENT;
        };

        def lf_al_new() -> LAl*
        {
            LAl* a = (LAl*)fmalloc((u64)((sizeof(LAl) + 7) / 8));
            a
            {
                .ix = om_new();
                .uses = om_new();
                .defs = om_new();
                .first = om_new();
                .writers = om_new();
                .loop_start = om_new();
                .loop_end = om_new();
                .ptr_vars = om_new();
                .deriv = om_new();
                .wr_params = om_new();
                .seq = 0;
            };
            return a;
        };

        def lf_addr_key(void* p) -> byte*
        {
            u64 a = (u64)p;
            Buf k;
            byte* out;
            k.__init();
            k.put_int((int)(a >> 32));
            k.put_str(g"_\0");
            k.put_int((int)(a `& 4294967295));
            out = ts_dup(k.mem);
            k.__exit();
            return out;
        };

        def lf_pos_new(int seq, PtrVec* path, PtrVec* loops) -> LPos*
        {
            LPos* p = (LPos*)fmalloc((u64)((sizeof(LPos) + 7) / 8));
            p
            {
                .seq = seq;
                .path = path;
                .loops = loops;
            };
            return p;
        };

        def lf_pv_add(PtrVec* v, byte* e) -> PtrVec*
        {
            PtrVec* r = pv_new();
            int i;
            while (i < v.len) { pv_push(r, v.items[i]); i++; };
            pv_push(r, (void*)e);
            return r;
        };

        def lf_pv_has(PtrVec* v, byte* e) -> bool
        {
            int i;
            while (i < v.len)
            {
                if (cstr_eq((byte*)v.items[i], e)) { return true; };
                i++;
            };
            return false;
        };


        def lf_pe(byte* node_key, int branch) -> byte*
        {
            Buf k;
            byte* out;
            k.__init();
            k.put_str(f"{node_key}:{branch}\0");
            out = ts_dup(k.mem);
            k.__exit();
            return out;
        };

        def lf_pe_split(byte* e) -> int
        {
            int i;
            while (e[i] != 0)
            {
                if (e[i] == ':') { return i; };
                i++;
            };
            return i;
        };

        def lf_exclusive(PtrVec* a, PtrVec* b) -> bool
        {
            int i, j, ca, cb;
            byte* x, y;
            int q;
            bool same;
            while (i < a.len)
            {
                x = (byte*)a.items[i];
                ca = lf_pe_split(x);
                j = 0;
                while (j < b.len)
                {
                    y = (byte*)b.items[j];
                    cb = lf_pe_split(y);
                    if (ca == cb)
                    {

                        q = 0;
                        same = true;
                        while (q < ca)
                        {
                            if (x[q] != y[q]) { same = false; };
                            q++;
                        };
                        if (same)
                        {
                            if (!cstr_eq(x + ca, y + cb)) { return true; };
                        };
                    };
                    j++;
                };
                i++;
            };
            return false;
        };

        def lf_prefix(PtrVec* p, PtrVec* q) -> bool
        {
            int i;
            if (p.len > q.len) { return false; };
            while (i < p.len)
            {
                if (!cstr_eq((byte*)p.items[i], (byte*)q.items[i])) { return false; };
                i++;
            };
            return true;
        };

        def lf_int_get(OMap* m, byte* k, int dflt) -> int
        {
            int* p;
            if (!om_has(m, k)) { return dflt; };
            p = (int*)om_get(m, k);
            return p[0];
        };

        def lf_rs_inter(PtrVec* a, PtrVec* b) -> PtrVec*
        {
            PtrVec* r = pv_new();
            int i;
            while (i < a.len)
            {
                if (lf_rs_has(b, (byte*)a.items[i])) { lf_rs_add(r, (byte*)a.items[i]); };
                i++;
            };
            return r;
        };

        def lf_loc_put(OMap* m, byte* name, int kind, byte* reg) -> void
        {
            LocInfo* li = (LocInfo*)fmalloc((u64)((sizeof(LocInfo) + 7) / 8));
            li
            {
                .kind = kind;
                .reg = reg;
            };
            om_put(m, name, (void*)li);
            return;
        };

        def lf_loc_get(OMap* m, byte* name) -> LocInfo*
        {
            return (LocInfo*)om_get(m, name);
        };

        def lf_env_get(OMap* env, byte* name) -> PtrVec*
        {
            PtrVec* v = (PtrVec*)om_get(env, name);
            if (v == (PtrVec*)0) { return lf_rs_new(); };
            return v;
        };

        object LifeChecker
        {
            CallGraph* cg;
            byte* entry;
            Preprocessor* pp;
            PtrVec* violations;     
            NameMap* seen;
            NameMap* summaries;     
            NameMap* active_summ;
            OMap* multi;            
            int funcs_checked;
            byte* fn;
            OMap* locals;           
            OMap* heapvars;         
            PtrVec* loops;          
            PtrVec* defers;         
            PtrVec* returns;        
            PtrVec* blks;           
            int cur_line;
            int call_col;
            LAl* al;
            bool warn_mode;
            OMap* fp;               
            Node* async_node;       
            LTask* last_task;
            OMap* ivars;            
            bool no_access;
            OMap* rel;              
            OMap* async_launched;   
            OMap* async_seq;        
            OMap* async_waits;      
            OMap* async_target;     
            LAcc* hit_a, hit_b;
            Buf xb, mb;
            PtrVec* cells_r;        
            PtrVec* deref_r;
            Buf sb, tb;

            __init(CallGraph* g, byte* entry_name, Preprocessor* p, bool warn) -> this
            {
                this.cg = g;
                this.entry = entry_name;
                this.pp = p;
                this.warn_mode = warn;
                this.fp = om_new();
                this.async_node = (Node*)0;
                this.last_task = (LTask*)0;
                this.ivars = om_new();
                this.no_access = false;
                this.rel = om_new();
                this.async_launched = om_new();
                this.async_seq = om_new();
                this.async_waits = om_new();
                this.async_target = om_new();
                this.xb.__init();
                this.mb.__init();
                this.violations = pv_new();
                this.seen = nm_new();
                this.summaries = nm_new();
                this.active_summ = nm_new();
                this.multi = om_new();
                this.funcs_checked = 0;
                this.fn = (byte*)0;
                this.locals = om_new();
                this.heapvars = om_new();
                this.loops = pv_new();
                this.defers = pv_new();
                this.returns = pv_new();
                this.blks = pv_new();
                this.cur_line = 0;
                this.al = lf_al_new();
                this.cells_r = pv_new();
                this.deref_r = pv_new();
                this.sb.__init();
                this.tb.__init();
                -> this;
            };

            __expr() -> LifeChecker* -> this;

            __exit() -> void
            {
                nm_free(this.seen);
                nm_free(this.summaries);
                nm_free(this.active_summ);
                -> this.sb.__exit();
            };



            remap_file(int merged) -> byte*
            {
                int idx = merged - 1;
                if (this.pp != (Preprocessor*)0)
                {
                    if (idx >= 0 & idx < this.pp.map_line.len)
                    {
                        -> this.pp.map_path(idx);
                    };
                };
                -> bc_unk();
            };

            remap_line(int merged) -> int
            {
                int idx = merged - 1;
                if (this.pp != (Preprocessor*)0)
                {
                    if (idx >= 0 & idx < this.pp.map_line.len)
                    {
                        -> this.pp.map_lineno(idx);
                    };
                };
                -> merged;
            };

            take() -> byte* -> ts_dup(this.sb.mem);

            where(int line) -> byte*
            {
                this.tb.clear();
                this.tb.put_str(f"{this.remap_file(line)}:{this.remap_line(line)}\0");
                -> ts_dup(this.tb.mem);
            };

            report(byte* kind, byte* msg, int line, PtrVec* detail) -> void
            {
                byte* file = this.remap_file(line);
                int l = this.remap_line(line);
                byte* key;
                BVio* v;
                this.sb.clear();
                this.sb.put_str(f"{kind}\x1f{file}\x1f{l}\x1f{msg}\0");
                key = this.take();
                if (nm_has(this.seen, key)) { ->; };
                nm_put(this.seen, key, (void*)1);
                v = (BVio*)fmalloc((u64)((sizeof(BVio) + 7) / 8));
                v
                {
                    .kind = kind;
                    .msg = msg;
                    .file = file;
                    .line = l;
                    .detail = detail;
                    .func = this.fn;
                };
                if (detail == (PtrVec*)0) { v.detail = pv_new(); };
                -> pv_push(this.violations, (void*)v);
            };

            det1(byte* a, byte* loc) -> PtrVec*
            {
                PtrVec* d = pv_new();
                this.sb.clear();
                this.sb.put_str(f"{a}{loc}\0");
                pv_push(d, (void*)this.take());
                -> d;
            };


            rdesc(byte* r) -> byte*
            {
                byte* o, f, n, t;
                this.tb.clear();
                if (r[0] == 'H')
                {
                    o = lf_origin(r);
                    f = lf_seg(o, 1);
                    t = lf_seg(o, 2);
                    this.tb.put_str(f"heap:{f}:\0");
                    this.tb.put_int(this.remap_line(lf_atoi(t)));
                    -> ts_dup(this.tb.mem);
                };
                if (r[0] == 'S' | r[0] == 'D')
                {
                    f = lf_seg(r, 1);
                    n = lf_seg(r, 2);
                    this.tb.put_str(f"stack:{f}:{n}\0");
                    -> ts_dup(this.tb.mem);
                };
                if (r[0] == 'P')
                {
                    f = lf_seg(r, 1);
                    n = lf_seg(r, 2);
                    this.tb.put_str(f"param:{f}:{n}\0");
                    -> ts_dup(this.tb.mem);
                };
                -> lf_seg(r, 1);
            };





            is_async(byte* fname) -> bool
            {
                Node* fd;
                if (nm_has(this.cg.async_names, fname)) { -> true; };
                fd = (Node*)nm_get(this.cg.funcs, fname);
                if (fd != (Node*)0)
                {
                    if ((fd.flags `& 2097152) != 0) { -> true; };
                };
                -> false;
            };


            roots_of(PtrVec* cells) -> PtrVec*
            {
                PtrVec* out = lf_rs_new();
                int i;
                while (i < cells.len)
                {
                    lf_rs_add(out, lf_root((byte*)cells.items[i]));
                    i++;
                };
                -> out;
            };


            fp_key(byte* r0) -> byte*
            {
                byte* r = lf_root(r0);
                if (r[0] == 'P')
                {
                    if (cstr_eq(lf_seg(r, 1), this.fn)) { -> join3(g"p|\0", lf_seg(r, 2), g"\0"); };
                    -> (byte*)0;
                };
                if (r[0] == 'G') { -> join3(g"g|\0", lf_seg(r, 1), g"\0"); };
                -> (byte*)0;
            };


            merge_fp_roots(OMap* tfp) -> void
            {
                int i, j;
                byte* key;
                PtrVec* lst;
                LAcc* a;
                while (i < tfp.ks.len)
                {
                    key = this.fp_key((byte*)tfp.ks.items[i]);
                    if (key != (byte*)0)
                    {
                        lst = (PtrVec*)tfp.vs.items[i];
                        j = 0;
                        while (j < lst.len)
                        {
                            a = (LAcc*)lst.items[j];
                            lf_merge_fp(this.fp, key, a.bits, a.atomic, a.rng);
                            j++;
                        };
                    };
                    i++;
                };
                ->;
            };


            fp_conflict(PtrVec* la, PtrVec* lb) -> bool
            {
                int i, j;
                LAcc* a, b;
                while (i < la.len)
                {
                    a = (LAcc*)la.items[i];
                    j = 0;
                    while (j < lb.len)
                    {
                        b = (LAcc*)lb.items[j];
                        if (lf_modes_conflict(a, b) & lf_ranges_overlap(a.rng, b.rng))
                        {
                            this.hit_a = a;
                            this.hit_b = b;
                            -> true;
                        };
                        j++;
                    };
                    i++;
                };
                -> false;
            };




            term_of(Node* e, LState* st) -> LTerm*
            {
                LTerm* l, r;
                if (e == (Node*)0) { -> (LTerm*)0; };
                if (e.kind == NodeKind.LITERAL)
                {
                    if (e.op == DataType.SINT | e.op == DataType.UINT | e.op == DataType.SLONG | e.op == DataType.ULONG)
                    {
                        -> lf_term(-1, (int)e.ival);
                    };
                    -> (LTerm*)0;
                };
                if (e.kind == NodeKind.IDENTIFIER) { -> (LTerm*)om_get(st.terms, e.text); };
                if (bc_is_cast(e)) { -> this.term_of(e.a, st); };
                if (e.kind == NodeKind.BINARY_OP)
                {
                    if (e.op == Operator.ADD | e.op == Operator.SUB)
                    {
                        l = this.term_of(e.a, st);
                        r = this.term_of(e.b, st);
                        if (l == (LTerm*)0 | r == (LTerm*)0) { -> (LTerm*)0; };
                        if (r.p == -1)
                        {
                            if (e.op == Operator.ADD) { -> lf_term(l.p, l.c + r.c); };
                            -> lf_term(l.p, l.c - r.c);
                        };
                        if (e.op == Operator.ADD & l.p == -1) { -> lf_term(r.p, r.c + l.c); };
                    };
                };
                -> (LTerm*)0;
            };

            idents_in(Node* e, OMap* out) -> void
            {
                int s, c, i;
                if (e == (Node*)0) { ->; };
                if (e.kind == NodeKind.IDENTIFIER)
                {
                    if (e.text != (byte*)0) { om_put(out, e.text, (void*)1); };
                    ->;
                };
                this.idents_in(e.a, out);
                this.idents_in(e.b, out);
                this.idents_in(e.c, out);
                this.idents_in(e.d, out);
                this.idents_in(e.e, out);
                while (s < 6)
                {
                    c = bc_count(e, s);
                    i = 0;
                    while (i < c)
                    {
                        this.idents_in(node_child(e, s, i), out);
                        i++;
                    };
                    s++;
                };
                ->;
            };

            mentions_ivar(Node* e) -> bool
            {
                OMap* names = om_new();
                int i;
                this.idents_in(e, names);
                while (i < names.ks.len)
                {
                    if (om_has(this.ivars, (byte*)names.ks.items[i])) { -> true; };
                    i++;
                };
                -> false;
            };

            index_range(Node* idx, LState* st) -> LRng*
            {
                LRng* r;
                LTerm* c, t;
                Node* var_side, const_side;
                bool ok;
                int pass, d;
                if (idx.kind == NodeKind.IDENTIFIER)
                {
                    if (om_has(this.ivars, idx.text)) { -> (LRng*)om_get(this.ivars, idx.text); };
                };
                if (bc_is_cast(idx)) { -> this.index_range(idx.a, st); };
                if (idx.kind == NodeKind.BINARY_OP)
                {
                    if (idx.op == Operator.ADD | idx.op == Operator.SUB)
                    {
                        while (pass < 2)
                        {
                            if (pass == 0) { var_side = idx.a; const_side = idx.b; ok = true; }
                            else { var_side = idx.b; const_side = idx.a; ok = idx.op == Operator.ADD; };
                            pass++;
                            if (!ok) { continue; };
                            r = (LRng*)0;
                            if (this.mentions_ivar(var_side)) { r = this.index_range(var_side, st); };
                            if (r == (LRng*)0) { continue; };
                            if (this.mentions_ivar(const_side)) { continue; };
                            c = this.term_of(const_side, st);
                            if (c != (LTerm*)0)
                            {
                                if (c.p == -1)
                                {
                                    d = c.c;
                                    if (idx.op == Operator.SUB) { d = 0 - c.c; };
                                    -> lf_rng(lf_term(r.lo.p, r.lo.c + d), lf_term(r.hi.p, r.hi.c + d));
                                };
                            };
                        };
                    };
                };


                if (this.mentions_ivar(idx)) { -> (LRng*)0; };
                t = this.term_of(idx, st);
                if (t != (LTerm*)0) { -> lf_rng(t, lf_term(t.p, t.c + 1)); };
                -> (LRng*)0;
            };


            acc_range(Node* e0, LState* st) -> LRng*
            {
                Node* e = e0;
                bool via_member;
                while (e.kind == NodeKind.MEMBER_ACCESS)
                {
                    e = e.a;
                    via_member = true;
                };
                if (e.kind == NodeKind.ARRAY_ACCESS)
                {
                    if (e.a.kind == NodeKind.IDENTIFIER) { -> this.index_range(e.b, st); };
                    -> (LRng*)0;
                };
                if (e.kind == NodeKind.POINTER_DEREF) { -> lf_rng(lf_term(-1, 0), lf_term(-1, 1)); };
                if (e.kind == NodeKind.IDENTIFIER & via_member) { -> lf_rng(lf_term(-1, 0), lf_term(-1, 1)); };
                -> (LRng*)0;
            };

            count_mods(Node* node, byte* name) -> int
            {
                int n, s, c, i;
                if (node == (Node*)0) { -> 0; };
                if (node.kind == NodeKind.ASSIGNMENT | node.kind == NodeKind.COMPOUND_ASSIGNMENT)
                {
                    if (node.a != (Node*)0)
                    {
                        if (node.a.kind == NodeKind.IDENTIFIER)
                        {
                            if (cstr_eq(node.a.text, name)) { n++; };
                        };
                    };
                }
                else
                {
                    if (node.kind == NodeKind.UNARY_OP)
                    {
                        if (node.op == Operator.INCREMENT | node.op == Operator.DECREMENT)
                        {
                            if (node.a != (Node*)0)
                            {
                                if (node.a.kind == NodeKind.IDENTIFIER)
                                {
                                    if (cstr_eq(node.a.text, name)) { n++; };
                                };
                            };
                        };
                    }
                    else
                    {
                        if (node.kind == NodeKind.VARIABLE_DECLARATION)
                        {
                            if (cstr_eq(node.text, name)) { n++; };
                        };
                    };
                };
                n = n + this.count_mods(node.a, name);
                n = n + this.count_mods(node.b, name);
                n = n + this.count_mods(node.c, name);
                n = n + this.count_mods(node.d, name);
                n = n + this.count_mods(node.e, name);
                while (s < 6)
                {
                    c = bc_count(node, s);
                    i = 0;
                    while (i < c)
                    {
                        n = n + this.count_mods(node_child(node, s, i), name);
                        i++;
                    };
                    s++;
                };
                -> n;
            };

            is_one(Node* e) -> bool
            {
                if (e == (Node*)0) { -> false; };
                if (e.kind != NodeKind.LITERAL) { -> false; };
                if (e.op == DataType.SINT | e.op == DataType.UINT | e.op == DataType.SLONG | e.op == DataType.ULONG)
                {
                    -> e.ival == (i64)1;
                };
                -> false;
            };

            is_inc(Node* stmt, byte* name) -> bool
            {
                Node* s = stmt;
                Node* v;
                if (s.kind == NodeKind.EXPRESSION_STATEMENT) { s = s.a; };
                if (s.kind == NodeKind.UNARY_OP)
                {
                    -> s.op == Operator.INCREMENT & s.a.kind == NodeKind.IDENTIFIER & cstr_eq(s.a.text, name);
                };
                if (s.kind == NodeKind.COMPOUND_ASSIGNMENT)
                {
                    -> s.a.kind == NodeKind.IDENTIFIER & cstr_eq(s.a.text, name)
                       & s.op == TokenType.PLUS_ASSIGN & this.is_one(s.b);
                };
                if (s.kind == NodeKind.ASSIGNMENT)
                {
                    v = s.b;
                    if (s.a.kind != NodeKind.IDENTIFIER) { -> false; };
                    if (!cstr_eq(s.a.text, name)) { -> false; };
                    if (v.kind != NodeKind.BINARY_OP) { -> false; };
                    if (v.op != Operator.ADD) { -> false; };
                    if (v.a.kind != NodeKind.IDENTIFIER) { -> false; };
                    if (!cstr_eq(v.a.text, name)) { -> false; };
                    -> this.is_one(v.b);
                };
                -> false;
            };



            loop_pattern(Node* cond, Node* body, Node* update, LState* st) -> LPat*
            {
                LPat* pat;
                LTerm* lo, hi;
                OMap* names;
                byte* name;
                int mods, i, c;
                if (cond == (Node*)0) { -> (LPat*)0; };
                if (cond.kind != NodeKind.BINARY_OP) { -> (LPat*)0; };
                if (cond.op != Operator.LESS_THAN & cond.op != Operator.LESS_EQUAL) { -> (LPat*)0; };
                if (cond.a.kind != NodeKind.IDENTIFIER) { -> (LPat*)0; };
                name = cond.a.text;
                lo = (LTerm*)om_get(st.terms, name);
                hi = this.term_of(cond.b, st);
                if (lo == (LTerm*)0 | hi == (LTerm*)0) { -> (LPat*)0; };
                if (cond.op == Operator.LESS_EQUAL) { hi = lf_term(hi.p, hi.c + 1); };
                names = om_new();
                this.idents_in(cond.b, names);
                i = 0;
                while (i < names.ks.len)
                {
                    if (this.count_mods(body, (byte*)names.ks.items[i]) != 0) { -> (LPat*)0; };
                    if (update != (Node*)0)
                    {
                        if (this.count_mods(update, (byte*)names.ks.items[i]) != 0) { -> (LPat*)0; };
                    };
                    i++;
                };
                mods = this.count_mods(body, name);
                c = bc_count(body, 0);
                if (update != (Node*)0)
                {
                    if (mods != 0) { -> (LPat*)0; };
                    if (!this.is_inc(update, name)) { -> (LPat*)0; };
                }
                else
                {
                    if (mods != 1 | c == 0) { -> (LPat*)0; };
                    if (!this.is_inc(node_child(body, 0, c - 1), name)) { -> (LPat*)0; };
                };
                pat = (LPat*)fmalloc((u64)((sizeof(LPat) + 7) / 8));
                pat
                {
                    .name = name;
                    .lo = lo;
                    .hi = hi;
                };
                -> pat;
            };

            fmt_term(LTerm* t) -> void
            {
                Node* fd, pn;
                byte* nm;
                if (t.p == -1)
                {
                    -> this.xb.put_int(t.c);
                };
                fd = (Node*)nm_get(this.cg.funcs, this.fn);
                if (fd != (Node*)0)
                {
                    if (t.p < bc_count(fd, 0))
                    {
                        pn = node_child(fd, 0, t.p);
                        nm = pn.text;
                    };
                };
                if (nm != (byte*)0)
                {
                    if (nm[0] == 0) { nm = (byte*)0; };
                };
                if (nm == (byte*)0)
                {
                    this.xb.put_str(f"arg{t.p}\0");
                }
                else
                {
                    this.xb.put_str(nm);
                };
                if (t.c != 0)
                {
                    if (t.c > 0) { this.xb.put_str(g"+\0"); };
                    this.xb.put_int(t.c);
                };
                ->;
            };

            fmt_rng(LRng* rng) -> byte*
            {
                if (rng == (LRng*)0) { -> g"[whole object]\0"; };
                this.xb.clear();
                this.xb.put_str(g"[\0");
                this.fmt_term(rng.lo);
                this.xb.put_str(g", \0");
                this.fmt_term(rng.hi);
                this.xb.put_str(g")\0");
                -> ts_dup(this.xb.mem);
            };


            offset_zero(Node* a0) -> bool
            {
                Node* a = a0;
                Node* x;
                while (bc_is_cast(a)) { a = a.a; };
                if (a.kind == NodeKind.IDENTIFIER) { -> true; };
                if (a.kind == NodeKind.ADDRESS_OF)
                {
                    x = a.a;
                    if (x.kind == NodeKind.IDENTIFIER) { -> true; };
                    if (x.kind == NodeKind.ARRAY_ACCESS)
                    {
                        if (x.b.kind == NodeKind.LITERAL)
                        {
                            if (x.b.ival == (i64)0) { -> x.a.kind == NodeKind.IDENTIFIER; };
                        };
                    };
                    -> false;
                };
                -> false;
            };

            subst_term(LTerm* t, PtrVec* aterms) -> LTerm*
            {
                LTerm* at;
                if (t.p == -1) { -> t; };
                if (t.p >= aterms.len) { -> (LTerm*)0; };
                at = (LTerm*)aterms.items[t.p];
                if (at == (LTerm*)0) { -> (LTerm*)0; };
                -> lf_term(at.p, at.c + t.c);
            };

            subst_rng(LRng* rng, PtrVec* aterms) -> LRng*
            {
                LTerm* lo, hi;
                if (rng == (LRng*)0) { -> (LRng*)0; };
                lo = this.subst_term(rng.lo, aterms);
                hi = this.subst_term(rng.hi, aterms);
                if (lo == (LTerm*)0 | hi == (LTerm*)0) { -> (LRng*)0; };
                -> lf_rng(lo, hi);
            };


            translate_fp(LSumm* summ, PtrVec* arg_regs, Node* call, LState* st) -> OMap*
            {
                OMap* out = om_new();
                PtrVec* aterms = pv_new();
                int n = bc_count(call, 0);
                int i, j, k;
                byte* key;
                PtrVec* lst, regs;
                bool off0;
                LAcc* a;
                LRng* rr;
                while (i < n)
                {
                    pv_push(aterms, (void*)this.term_of(node_child(call, 0, i), st));
                    i++;
                };
                i = 0;
                while (i < summ.fp.ks.len)
                {
                    key = (byte*)summ.fp.ks.items[i];
                    lst = (PtrVec*)summ.fp.vs.items[i];
                    i++;
                    if (key[0] == 'p')
                    {
                        j = lf_atoi(lf_seg(key, 1));
                        regs = lf_rs_new();
                        if (j < arg_regs.len) { regs = (PtrVec*)arg_regs.items[j]; };
                        off0 = false;
                        if (j < n) { off0 = this.offset_zero(node_child(call, 0, j)); };
                    }
                    else
                    {
                        regs = lf_rs_one(lf_static(lf_seg(key, 1)));
                        off0 = true;
                    };
                    k = 0;
                    while (k < regs.len)
                    {
                        j = 0;
                        while (j < lst.len)
                        {
                            a = (LAcc*)lst.items[j];
                            rr = (LRng*)0;
                            if (off0) { rr = this.subst_rng(a.rng, aterms); };
                            lf_merge_fp(out, lf_root((byte*)regs.items[k]), a.bits, a.atomic, rr);
                            j++;
                        };
                        k++;
                    };
                };
                -> out;
            };

            outcome(byte* fn0) -> byte*
            {
                byte* sh = bc_last_seg(fn0);
                this.mb.clear();
                this.mb.put_str(f"; '{sh}\0");
                if (this.warn_mode) { this.mb.put_str(g"' runs sequentially\0"); }
                else { this.mb.put_str(g"' cannot be proven safe to run concurrently\0"); };
                -> ts_dup(this.mb.mem);
            };



            access(PtrVec* regs, int bits, LState* st, bool atomic, byte* what, LRng* rng) -> void
            {
                int i, j, q;
                byte* key, kind, r, msg, oc;
                LTask* t;
                PtrVec* tl, mine, det;
                LAcc* m;
                if (regs.len == 0 | this.no_access) { ->; };
                while (i < regs.len)
                {
                    key = this.fp_key((byte*)regs.items[i]);
                    if (key != (byte*)0) { lf_merge_fp(this.fp, key, bits, atomic, rng); };
                    i++;
                };
                if (st.tasks.ks.len == 0) { ->; };
                m = lf_acc(bits, atomic, rng);
                mine = pv_new();
                pv_push(mine, (void*)m);
                q = 0;
                while (q < st.tasks.vs.len)
                {
                    t = (LTask*)st.tasks.vs.items[q];
                    q++;
                    j = 0;
                    while (j < regs.len)
                    {
                        r = (byte*)regs.items[j];
                        j++;
                        tl = (PtrVec*)om_get(t.fp, lf_root(r));
                        if (tl == (PtrVec*)0) { continue; };
                        if (!this.fp_conflict(mine, tl)) { continue; };
                        om_put(this.async_seq, lf_addr_key((void*)t.node), (void*)1);
                        kind = what;
                        if (kind == (byte*)0)
                        {
                            kind = g"access\0";
                            if (bits == 1) { kind = g"read\0"; };
                            if (bits == 2) { kind = g"write\0"; };
                            if (bits == 4) { kind = g"free\0"; };
                        };
                        oc = this.outcome(t.fn);
                        this.mb.clear();
                        this.mb.put_str(f"{kind} of '{this.rdesc(r)}' conflicts with async call '{bc_last_seg(t.fn)}' still running ({lf_mode_name(this.hit_a)} {this.fmt_rng(this.hit_a.rng)} vs {lf_mode_name(this.hit_b)} {this.fmt_rng(this.hit_b.rng)}); the call has no relation to this code{oc}\0");
                        msg = ts_dup(this.mb.mem);
                        det = pv_new();
                        pv_push(det, (void*)join3(g"async call launched at \0", this.where(t.line), g"\0"));
                        pv_push(det, (void*)g"use the call's result, or relate the two with an async tag, to order them\0");
                        this.report(g"async_conflict\0", msg, this.cur_line, det);
                    };
                };
                ->;
            };

            rel_bits(byte* a, byte* b) -> int
            {
                int* p = (int*)om_get(this.rel, lf_pair_key(a, b));
                if (p == (int*)0) { -> 0; };
                -> p[0];
            };




            check_launch(LTask* task, LState* st) -> void
            {
                int q, i, ops;
                LTask* u;
                PtrVec* ul, lst, det;
                byte* r, what, a, b, oc;
                LAcc* ma, mb2;
                bool found;
                while (q < st.tasks.vs.len)
                {
                    u = (LTask*)st.tasks.vs.items[q];
                    q++;
                    found = false;
                    r = (byte*)0;
                    i = 0;
                    while (i < task.fp.ks.len)
                    {
                        ul = (PtrVec*)om_get(u.fp, (byte*)task.fp.ks.items[i]);
                        if (ul != (PtrVec*)0)
                        {
                            lst = (PtrVec*)task.fp.vs.items[i];
                            if (this.fp_conflict(lst, ul))
                            {
                                r = (byte*)task.fp.ks.items[i];
                                found = true;
                                break;
                            };
                        };
                        i++;
                    };
                    if (!found) { continue; };
                    ma = this.hit_a;
                    mb2 = this.hit_b;
                    ops = this.rel_bits(task.fn, u.fn);
                    if ((ops `& (8 `| 2 `| 16)) != 0) { continue; };
                    om_put(this.async_seq, lf_addr_key((void*)task.node), (void*)1);
                    a = bc_last_seg(task.fn);
                    b = bc_last_seg(u.fn);
                    this.mb.clear();
                    this.mb.put_str(f"'{this.rdesc(r)}' ({lf_mode_name(ma)} {this.fmt_rng(ma.rng)} vs {lf_mode_name(mb2)} {this.fmt_rng(mb2.rng)})\0");
                    what = ts_dup(this.mb.mem);
                    det = pv_new();
                    pv_push(det, (void*)join3(g"first call launched at \0", this.where(u.line), g"\0"));
                    if ((ops `& 1) != 0)
                    {
                        pv_push(det, (void*)g"the derived footprint is the truth, the tag claim is wrong\0");
                        this.mb.clear();
                        this.mb.put_str(f"relation '#' between '{a}' and '{b}' is contradicted by the code: both reach {what}\0");
                        this.report(g"async_contradiction\0", ts_dup(this.mb.mem), this.cur_line, det);
                    }
                    else
                    {
                        if ((ops `& 4) != 0)
                        {
                            pv_push(det, (void*)g"the derived footprint is the truth, the tag claim is wrong\0");
                            this.mb.clear();
                            this.mb.put_str(f"relation '~' between '{a}' and '{b}' is contradicted by the code: the accesses to {what} are not all atomic\0");
                            this.report(g"async_contradiction\0", ts_dup(this.mb.mem), this.cur_line, det);
                        }
                        else
                        {
                            oc = this.outcome(task.fn);
                            pv_push(det, (void*)g"declare #<Tag>(...) with ! or > between them if that is intended\0");
                            this.mb.clear();
                            this.mb.put_str(f"async calls '{a}' and '{b}' both reach {what} and no relation orders or separates them{oc}\0");
                            this.report(g"async_conflict\0", ts_dup(this.mb.mem), this.cur_line, det);
                        };
                    };
                };
                ->;
            };



            apply_quiet(byte* fname, PtrVec* arg_regs, LState* st, Node* call) -> PtrVec*
            {
                bool prev = this.no_access;
                PtrVec* r;
                this.no_access = true;
                this.call_col = 0;
                if (call != (Node*)0) { this.call_col = call.col; };
                r = this.apply(fname, arg_regs, st);
                this.no_access = prev;
                -> r;
            };


            join_result(byte* name, LState* st) -> void
            {
                int i;
                LTask* t;
                if (st.tasks.ks.len == 0) { ->; };
                while (i < st.tasks.vs.len)
                {
                    t = (LTask*)st.tasks.vs.items[i];
                    if (t.result_var != (byte*)0)
                    {
                        if (cstr_eq(t.result_var, name))
                        {
                            om_remove_at(st.tasks, i);
                            continue;
                        };
                    };
                    i++;
                };
                ->;
            };



            resolve_target(Node* tgt, byte* carrier) -> PtrVec*
            {
                PtrVec* cands = pv_new();
                PtrVec* lst, keep;
                byte* name = tgt.text;
                byte* k;
                Node* fd;
                int i, j, n;
                bool ok;
                if (cstr_eq(name, g"this\0"))
                {
                    pv_push(cands, (void*)carrier);
                    -> cands;
                };
                if (nm_has(this.cg.funcs, name))
                {
                    pv_push(cands, (void*)name);
                }
                else
                {
                    lst = (PtrVec*)nm_get(this.cg.overloads, name);
                    if (lst != (PtrVec*)0)
                    {
                        i = 0;
                        while (i < lst.len) { pv_push(cands, lst.items[i]); i++; };
                    };
                    if (cands.len == 0)
                    {
                        if (nm_has(this.cg.short_names, name))
                        {
                            pv_push(cands, nm_get(this.cg.short_names, name));
                        };
                    };
                    if (cands.len == 0)
                    {
                        i = 0;
                        while (i < this.cg.async_names.count)
                        {
                            k = this.cg.async_names.keys[i];
                            if (this.cg.async_names.vals[i] != (void*)0)
                            {
                                if (cstr_eq(k, name) | bc_ends(k, join3(g"__\0", name, g"\0")))
                                {
                                    pv_push(cands, (void*)k);
                                };
                            };
                            i++;
                        };
                    };
                };
                if (tgt.ival == (i64)1)
                {
                    keep = pv_new();
                    n = bc_count(tgt, 0);
                    i = 0;
                    while (i < cands.len)
                    {
                        fd = (Node*)nm_get(this.cg.funcs, (byte*)cands.items[i]);
                        i++;
                        if (fd == (Node*)0) { continue; };
                        if (bc_count(fd, 0) != n) { continue; };
                        ok = true;
                        j = 0;
                        while (j < n)
                        {
                            if (!typespec_equal(node_child(fd, 0, j).ts, node_child(tgt, 0, j).ts)) { ok = false; };
                            j++;
                        };
                        if (ok) { pv_push(keep, cands.items[i - 1]); };
                    };
                    cands = keep;
                };
                -> cands;
            };

            rel_add(byte* a, byte* b, int bit) -> void
            {
                byte* key = lf_pair_key(a, b);
                int* p = (int*)om_get(this.rel, key);
                if (p == (int*)0)
                {
                    -> om_put(this.rel, key, (void*)bx_new(bit));
                };
                p[0] = p[0] `| bit;
                ->;
            };


            build_relations() -> void
            {
                int ui, pi, ri, k, x, y, bit, flip;
                AUse* u;
                Node* tag, rr;
                PtrVec* ba, bb;
                OMap* bind;
                byte* op;
                while (ui < this.cg.async_uses.len)
                {
                    u = (AUse*)this.cg.async_uses.items[ui];
                    ui++;
                    tag = (Node*)nm_get(this.cg.async_tags, u.use.text);
                    if (tag == (Node*)0) { continue; };
                    if (bc_count(u.use, 0) != bc_count(tag, 0)) { continue; };
                    bind = om_new();
                    pi = 0;
                    while (pi < bc_count(tag, 0))
                    {
                        om_put(bind, node_child(tag, 0, pi).text, (void*)this.resolve_target(node_child(u.use, 0, pi), u.key));
                        pi++;
                    };
                    ri = 0;
                    while (ri < bc_count(tag, 1))
                    {
                        rr = node_child(tag, 1, ri);
                        ri++;
                        k = 0;
                        while (k < bc_count(rr, 1))
                        {
                            op = node_child(rr, 1, k).text;
                            bit = lf_op_bit(op);
                            flip = bit;
                            if (bit == 2) { flip = 16; };
                            ba = (PtrVec*)om_get(bind, node_child(rr, 0, k).text);
                            bb = (PtrVec*)om_get(bind, node_child(rr, 0, k + 1).text);
                            if (ba != (PtrVec*)0 & bb != (PtrVec*)0)
                            {
                                x = 0;
                                while (x < ba.len)
                                {
                                    y = 0;
                                    while (y < bb.len)
                                    {
                                        this.rel_add((byte*)ba.items[x], (byte*)bb.items[y], bit);
                                        this.rel_add((byte*)bb.items[y], (byte*)ba.items[x], flip);
                                        y++;
                                    };
                                    x++;
                                };
                            };
                            k++;
                        };
                    };
                };
                ->;
            };



            call_resolved(Node* e, byte* resolved, LSumm* summ, PtrVec* arg_regs, LState* st) -> PtrVec*
            {
                bool launch;
                bool is_as = this.is_async(resolved);
                int q, i;
                LTask* u, task;
                PtrVec* w, ret, v, lst;
                OMap* tfp;
                LAcc* a;
                byte* nk;
                if (is_as & e == this.async_node) { launch = true; };
                this.async_node = (Node*)0;
                if (is_as) { om_put(this.async_target, lf_addr_key((void*)e), (void*)resolved); };
                if (is_as & st.tasks.ks.len > 0)
                {

                    q = 0;
                    while (q < st.tasks.vs.len)
                    {
                        u = (LTask*)st.tasks.vs.items[q];
                        if ((this.rel_bits(u.fn, resolved) `& 2) != 0)
                        {
                            w = (PtrVec*)om_get(this.async_waits, lf_addr_key((void*)e));
                            if (w == (PtrVec*)0)
                            {
                                w = pv_new();
                                om_put(this.async_waits, lf_addr_key((void*)e), (void*)w);
                            };
                            nk = lf_addr_key((void*)u.node);
                            if (!lf_pv_has(w, nk)) { pv_push(w, (void*)nk); };
                            om_remove_at(st.tasks, q);
                            continue;
                        };
                        q++;
                    };
                };
                if (bc_starts(resolved, g"standard__atomic__\0"))
                {


                    i = 0;
                    while (i < arg_regs.len)
                    {
                        v = (PtrVec*)arg_regs.items[i];
                        if (v.len > 0)
                        {
                            this.access(this.roots_of(v), 1 `| 2, st, true, (byte*)0, (LRng*)0);
                        };
                        i++;
                    };
                    -> this.apply_quiet(resolved, arg_regs, st, e);
                };
                tfp = this.translate_fp(summ, arg_regs, e, st);
                if (launch)
                {
                    task = (LTask*)fmalloc((u64)((sizeof(LTask) + 7) / 8));
                    task
                    {
                        .fn = resolved;
                        .fp = tfp;
                        .line = this.cur_line;
                        .result_var = (byte*)0;
                        .bid = g"fn\0";
                    };
                    if (st.active.len > 0) { task.bid = (byte*)st.active.items[st.active.len - 1]; };
                    task.node = e;
                    om_put(this.async_launched, lf_addr_key((void*)e), (void*)1);
                    this.check_launch(task, st);
                    this.merge_fp_roots(tfp);
                    ret = this.apply_quiet(resolved, arg_regs, st, e);
                    om_put(st.tasks, lf_addr_key((void*)e), (void*)task);
                    this.last_task = task;
                    -> ret;
                };
                i = 0;
                while (i < tfp.ks.len)
                {
                    lst = (PtrVec*)tfp.vs.items[i];
                    q = 0;
                    while (q < lst.len)
                    {
                        a = (LAcc*)lst.items[q];
                        this.mb.clear();
                        this.mb.put_str(f"call to '{bc_last_seg(resolved)}'\0");
                        this.access(lf_rs_one((byte*)tfp.ks.items[i]), a.bits, st, a.atomic, ts_dup(this.mb.mem), a.rng);
                        q++;
                    };
                    i++;
                };
                -> this.apply_quiet(resolved, arg_regs, st, e);
            };



            run() -> void
            {
                int i;
                this.build_relations();
                if (nm_has(this.cg.funcs, this.entry))
                {
                    this.summary(this.entry);
                }
                else
                {
                    while (i < this.cg.funcs.count)
                    {
                        this.summary(this.cg.funcs.keys[i]);
                        i++;
                    };
                };
                ->;
            };



            resolve(byte* name, int nargs) -> byte*
            {
                PtrVec* cands;
                int i;
                byte* c;
                byte* base;
                Node* f;
                if (name == (byte*)0) { -> (byte*)0; };
                if (name[0] == 0) { -> (byte*)0; };
                if (nm_has(this.cg.funcs, name)) { -> name; };
                if (nm_has(this.cg.short_names, name)) { -> (byte*)nm_get(this.cg.short_names, name); };
                cands = (PtrVec*)nm_get(this.cg.overloads, name);
                if (cands == (PtrVec*)0)
                {

                    base = bc_overload_base(name);
                    if (base[0] != 0)
                    {
                        cands = (PtrVec*)nm_get(this.cg.overloads, base);
                        if (cands == (PtrVec*)0)
                        {
                            if (nm_has(this.cg.funcs, base))
                            {
                                cands = pv_new();
                                pv_push(cands, (void*)base);
                            };
                        };
                        nargs = bc_mangled_arity(name);
                    };
                };
                if (cands == (PtrVec*)0) { -> (byte*)0; };
                if (cands.len == 1) { -> (byte*)cands.items[0]; };
                i = 0;
                while (i < cands.len)
                {
                    c = (byte*)cands.items[i];
                    f = (Node*)nm_get(this.cg.funcs, c);
                    if (f != (Node*)0)
                    {
                        if (bc_count(f, 0) == nargs) { -> c; };
                    };
                    i++;
                };
                -> (byte*)0;
            };



            blk_id(Node* n) -> byte*
            {
                int i;
                while (i < this.blks.len)
                {
                    if ((Node*)this.blks.items[i] == n) { -> lf_itoa(i); };
                    i++;
                };
                pv_push(this.blks, (void*)n);
                -> lf_itoa(this.blks.len - 1);
            };

            active_push(LState* st, byte* bid) -> void
            {
                PtrVec* a = pv_new();
                int i;
                while (i < st.active.len) { pv_push(a, st.active.items[i]); i++; };
                pv_push(a, (void*)bid);
                st.active = a;
                ->;
            };

            active_pop(LState* st, byte* bid) -> void
            {
                PtrVec* a = pv_new();
                int i;
                while (i < st.active.len)
                {
                    if (!cstr_eq((byte*)st.active.items[i], bid)) { pv_push(a, st.active.items[i]); };
                    i++;
                };
                st.active = a;
                ->;
            };



            summary(byte* name) -> LSumm*
            {
                Node* func, p;
                LState* st, exit_state;
                int i, n, j;
                byte* reg, pr, k, c;
                LSumm* sm;
                PtrVec* ret, path, v;
                LRet* lr;
                LHeld* lh;

                byte* s_fn;
                OMap* s_locals, s_fp, s_ivars, s_heapvars;
                PtrVec* s_loops, s_defers, s_returns;
                int s_line;
                LAl* s_al;
                Node* s_async_node;
                LTask* s_last_task;

                if (nm_has(this.summaries, name)) { -> (LSumm*)nm_get(this.summaries, name); };
                sm = (LSumm*)fmalloc((u64)((sizeof(LSumm) + 7) / 8));
                sm
                {
                    .ret = pv_new();
                    .nparams = 0;
                    .param_status = om_new();
                    .wr = om_new();
                    .param_held = pv_new();
                    .heap_status = om_new();
                    .esc = om_new();
                    .free_at = om_new();
                    .fp = om_new();
                };
                if (nm_has(this.active_summ, name)) { -> sm; };
                nm_put(this.active_summ, name, (void*)1);
                s_fn = this.fn;
                s_locals = this.locals;
                s_heapvars = this.heapvars;
                s_loops = this.loops;
                s_defers = this.defers;
                s_returns = this.returns;
                s_line = this.cur_line;
                s_al = this.al;
                s_fp = this.fp;
                s_async_node = this.async_node;
                s_last_task = this.last_task;
                s_ivars = this.ivars;
                this.fp = om_new();
                this.async_node = (Node*)0;
                this.last_task = (LTask*)0;
                this.ivars = om_new();

                func = (Node*)nm_get(this.cg.funcs, name);
                this.funcs_checked++;
                this.al = lf_al_new();
                this.index_function(func);
                this.fn = name;
                this.locals = om_new();
                this.heapvars = om_new();
                this.loops = pv_new();
                this.defers = pv_new();
                pv_push(this.defers, (void*)pv_new());
                this.returns = pv_new();
                this.cur_line = func.line;

                st = lf_state_new();
                pv_push(st.active, (void*)g"fn\0");
                n = bc_count(func, 0);
                i = 0;
                while (i < n)
                {
                    p = node_child(func, 0, i);
                    if (p.text != (byte*)0)
                    {
                        if (p.text[0] != 0)
                        {
                            reg = lf_stack(name, p.text, g"fn\0");
                            lf_loc_put(this.locals, p.text, 0, reg);
                            if (bc_is_pointer_type(p.ts)) { om_put(this.al.ptr_vars, p.text, (void*)1); };
                            om_put(this.al.first, p.text, (void*)bx_new(-1));
                            if (this.may_carry_pointer(p.ts))
                            {
                                om_put(st.env, p.text, (void*)lf_rs_one(lf_param(name, i)));
                            }
                            else
                            {
                                om_put(st.env, p.text, (void*)lf_rs_new());
                            };
                            if (!bc_is_pointer_type(p.ts))
                            {
                                if (p.ts == (TypeSpec*)0) { om_put(st.terms, p.text, (void*)lf_term(i, 0)); }
                                else
                                {
                                    if ((p.ts.flags `& 32) == 0) { om_put(st.terms, p.text, (void*)lf_term(i, 0)); };
                                };
                            };
                        };
                    };
                    i++;
                };
                if (func.a != (Node*)0)
                {
                    if (func.a.kind == NodeKind.BLOCK)
                    {
                        this.block(func.a, st, false);
                    }
                    else
                    {
                        this.eval(func.a, st);
                    };
                };
                if (!st.dead)
                {
                    this.run_defers_all(st);
                    this.exit_path(st, lf_rs_new(), this.cur_line);
                    lr = (LRet*)fmalloc((u64)((sizeof(LRet) + 7) / 8));
                    lr
                    {
                        .st = lf_state_copy(st);
                        .regs = lf_rs_new();
                    };
                    pv_push(this.returns, (void*)lr);
                };
                exit_state = (LState*)0;
                ret = lf_rs_new();
                i = 0;
                while (i < this.returns.len)
                {
                    lr = (LRet*)this.returns.items[i];
                    exit_state = lf_join(exit_state, lr.st);
                    ret = lf_rs_union(ret, lr.regs);
                    i++;
                };
                sm
                {
                    .ret = ret;
                    .nparams = n;
                };
                if (exit_state != (LState*)0)
                {
                    int q, along;
                    int* fl;
                    bool seen_any;
                    i = 0;
                    while (i < n)
                    {
                        pr = lf_param(name, i);
                        if (om_has(exit_state.status, pr))
                        {
                            om_put(sm.param_status, lf_itoa(i), om_get(exit_state.status, pr));
                        };
                        j = 0;
                        while (j < exit_state.held.ks.len)
                        {
                            k = (byte*)exit_state.held.ks.items[j];
                            v = (PtrVec*)exit_state.held.vs.items[j];
                            path = pv_new();
                            c = k;
                            while (c[0] == 'F')
                            {
                                pv_push(path, (void*)lf_fld_member(c));
                                c = lf_fld_cell(c);
                            };
                            if (cstr_eq(c, pr) & v.len > 0)
                            {
                                lh = (LHeld*)fmalloc((u64)((sizeof(LHeld) + 7) / 8));
                                lh
                                {
                                    .idx = i;
                                    .regs = v;
                                };

                                lh.path = pv_new();
                                {
                                    q = path.len - 1;
                                    while (q >= 0)
                                    {
                                        pv_push(lh.path, path.items[q]);
                                        q--;
                                    };
                                };
                                pv_push(sm.param_held, (void*)lh);
                            };
                            j++;
                        };
                        i++;
                    };
                    j = 0;
                    while (j < exit_state.status.ks.len)
                    {
                        k = (byte*)exit_state.status.ks.items[j];
                        if (k[0] == 'H') { om_put(sm.heap_status, k, exit_state.status.vs.items[j]); };
                        j++;
                    };

                    j = 0;
                    while (j < ret.len)
                    {
                        k = (byte*)ret.items[j];
                        j++;
                        if (k[0] != 'H') { continue; };
                        along = 0;
                        seen_any = false;
                        q = 0;
                        while (q < this.returns.len)
                        {
                            lr = (LRet*)this.returns.items[q];
                            q++;
                            if (!lf_rs_has(lr.regs, k)) { continue; };
                            fl = (int*)om_get(lr.st.status, k);
                            if (fl == (int*)0) { continue; };
                            along = along `| fl[0];
                            seen_any = true;
                        };
                        if (seen_any)
                        {
                            om_put(sm.heap_status, k, (void*)bx_new(along));
                        };
                    };
                    sm
                    {
                        .esc = om_copy(exit_state.esc);
                        .free_at = om_copy(exit_state.free_at);
                    };
                };
                this.fn = s_fn;
                this.locals = s_locals;
                this.heapvars = s_heapvars;
                this.loops = s_loops;
                this.defers = s_defers;
                this.returns = s_returns;
                sm.fp = this.fp;
                this.fp = s_fp;
                this.async_node = s_async_node;
                this.last_task = s_last_task;
                this.ivars = s_ivars;
                sm.wr = om_copy(this.al.wr_params);
                this.al = s_al;
                this.cur_line = s_line;
                nm_del(this.active_summ, name);
                nm_put(this.summaries, name, (void*)sm);
                -> sm;
            };



            block(Node* b, LState* st, bool new_scope) -> void
            {
                byte* bid = g"fn\0";
                int c = bc_count(b, 0);
                int i;
                Node* s;
                if (new_scope)
                {
                    bid = this.blk_id(b);
                    this.active_push(st, bid);
                };
                pv_push(this.defers, (void*)pv_new());
                while (i < c)
                {
                    s = node_child(b, 0, i);
                    if (s != (Node*)0)
                    {
                        if (st.dead) { break; };
                        this.stmt(s, st, bid);
                    };
                    i++;
                };
                if (!st.dead) { this.run_defers_top(st); };
                this.defers.len--;
                if (new_scope)
                {
                    this.active_pop(st, bid);
                    i = 0;
                    while (i < st.tasks.vs.len)
                    {
                        if (cstr_eq(((LTask*)st.tasks.vs.items[i]).bid, bid)) { om_remove_at(st.tasks, i); continue; };
                        i++;
                    };
                };
                ->;
            };

            run_defers_top(LState* st) -> void
            {
                PtrVec* top = (PtrVec*)this.defers.items[this.defers.len - 1];
                int i = top.len - 1;
                while (i >= 0)
                {
                    this.run_defer((Node*)top.items[i], st);
                    i--;
                };
                this.defers.items[this.defers.len - 1] = (void*)pv_new();
                ->;
            };

            run_defers_all(LState* st) -> void
            {
                int lv = this.defers.len - 1;
                PtrVec* top;
                int i;
                while (lv >= 0)
                {
                    top = (PtrVec*)this.defers.items[lv];
                    i = top.len - 1;
                    while (i >= 0)
                    {
                        this.run_defer((Node*)top.items[i], st);
                        i--;
                    };
                    lv--;
                };
                ->;
            };

            run_defer(Node* d, LState* st) -> void
            {
                int c = bc_count(d, 0);
                int i;
                if ((d.flags `& 32) != 0)
                {
                    while (i < c)
                    {
                        this.stmt(node_child(d, 0, i), st, g"fn\0");
                        i++;
                    };
                }
                else
                {
                    if (d.a != (Node*)0) { this.eval(d.a, st); };
                };
                ->;
            };

            stmt(Node* node, LState* st, byte* bid) -> void
            {
                int k = node.kind;
                int ln = node.line;
                Node* cc;
                LState* pre, s2, res;
                int i, c;
                if (ln != 0) { this.cur_line = ln; };

                if (k == NodeKind.VARIABLE_DECLARATION) { -> this.decl(node, st, bid); };
                if (k == NodeKind.EXPRESSION_STATEMENT)
                {
                    this.async_node = node.a;
                    this.eval(node.a, st);
                    ->;
                };
                if (k == NodeKind.ASSIGNMENT) { -> this.assign(node.a, node.b, st); };
                if (k == NodeKind.COMPOUND_ASSIGNMENT) { -> this.compound(node, st); };
                if (k == NodeKind.BLOCK) { this.block(node, st, true); ->; };
                if (k == NodeKind.RETURN_STATEMENT) { -> this.do_return(node, st); };
                if (k == NodeKind.IF_STATEMENT) { -> this.do_if(node, st); };
                if (k == NodeKind.WHILE_LOOP)
                {
                    -> this.loop(st, node.a, node.b, true, (Node*)0, false);
                };
                if (k == NodeKind.DO_WHILE_LOOP)
                {
                    -> this.loop(st, node.a, node.b, false, (Node*)0, false);
                };
                if (k == NodeKind.DO_LOOP)
                {
                    -> this.loop(st, (Node*)0, node.b, false, (Node*)0, true);
                };
                if (k == NodeKind.FOR_LOOP)
                {
                    cc = node;
                    this.active_push(st, this.blk_id(cc));
                    if (node.a != (Node*)0) { this.stmt(node.a, st, this.blk_id(cc)); };
                    this.loop(st, node.b, node.d, true, node.c, false);
                    -> this.active_pop(st, this.blk_id(cc));
                };
                if (k == NodeKind.FOR_IN_LOOP)
                {
                    this.eval(node.a, st);
                    c = bc_count(node, 0);
                    i = 0;
                    while (i < c)
                    {
                        cc = node_child(node, 0, i);
                        om_put(st.env, cc.text, (void*)lf_rs_new());
                        lf_loc_put(this.locals, cc.text, 0, lf_stack(this.fn, cc.text, this.blk_id(node.b)));
                        i++;
                    };
                    -> this.loop(st, (Node*)0, node.b, true, (Node*)0, false);
                };
                if (k == NodeKind.SWITCH_STATEMENT) { -> this.do_switch(node, st); };
                if (k == NodeKind.BREAK_STATEMENT)
                {
                    if (this.loops.len > 0)
                    {
                        LLoop* lp = (LLoop*)this.loops.items[this.loops.len - 1];
                        pv_push(lp.breaks, (void*)lf_state_copy(st));
                    };
                    st.dead = true;
                    ->;
                };
                if (k == NodeKind.CONTINUE_STATEMENT)
                {
                    if (this.loops.len > 0)
                    {
                        LLoop* lp2 = (LLoop*)this.loops.items[this.loops.len - 1];
                        pv_push(lp2.conts, (void*)lf_state_copy(st));
                    };
                    st.dead = true;
                    ->;
                };
                if (k == NodeKind.DEFER_STATEMENT)
                {
                    -> pv_push((PtrVec*)this.defers.items[this.defers.len - 1], (void*)node);
                };
                if (k == NodeKind.TRY_BLOCK)
                {
                    pre = lf_state_copy(st);
                    this.block(node.a, st, true);
                    res = lf_join(pre, st);
                    c = bc_count(node, 0);
                    i = 0;
                    while (i < c)
                    {
                        cc = node_child(node, 0, i);
                        s2 = lf_state_copy(pre);
                        if (cc.a != (Node*)0) { this.block(cc.a, s2, true); };
                        res = lf_join(res, s2);
                        i++;
                    };
                    -> lf_state_set(st, res);
                };
                -> this.generic(node, st);
            };

            generic_child(Node* v, LState* st) -> void
            {
                if (v == (Node*)0) { ->; };
                if (v.kind == NodeKind.BLOCK) { this.block(v, st, true); ->; };
                if (lf_is_stmt_kind(v.kind)) { -> this.stmt(v, st, g"fn\0"); };
                this.eval(v, st);
                ->;
            };


            generic(Node* node, LState* st) -> void
            {
                int s, c, i;
                this.generic_child(node.a, st);
                this.generic_child(node.b, st);
                this.generic_child(node.c, st);
                this.generic_child(node.d, st);
                while (s < 6)
                {
                    c = bc_count(node, s);
                    i = 0;
                    while (i < c)
                    {
                        this.generic_child(node_child(node, s, i), st);
                        i++;
                    };
                    s++;
                };
                ->;
            };



            decl(Node* node, LState* st, byte* bid) -> void
            {
                TypeSpec* ts = node.ts;
                byte* reg = lf_stack(this.fn, node.text, bid);
                bool is_arr;
                Node* iv = node.a;
                PtrVec* v;
                int c, i;
                LTerm* tm;
                byte* hsite;
                bool is_heap;
                if ((node.flags `& 4) != 0) { reg = lf_static(node.text); };
                if (ts != (TypeSpec*)0)
                {
                    if ((ts.flags `& 32) != 0) { is_arr = true; };
                };
                if (is_arr) { lf_loc_put(this.locals, node.text, 1, reg); }
                else { lf_loc_put(this.locals, node.text, 0, reg); };
                om_put(st.env, node.text, (void*)lf_rs_new());
                om_del(st.terms, node.text);
                if (bc_is_pointer_type(ts) & !is_arr) { om_put(this.al.ptr_vars, node.text, (void*)1); };

                if (ts != (TypeSpec*)0 & (node.flags `& 4) == 0)
                {
                    if (ts.storage_class == StorageClass.HEAP)
                    {
                        hsite = lf_heap(this.fn, this.cur_line, (byte*)0);
                        om_put(st.status, hsite, (void*)bx_new(1));
                        om_del(st.esc, hsite);
                        om_del(st.free_at, hsite);
                        om_put(this.heapvars, node.text, (void*)1);
                        om_put(this.al.ptr_vars, node.text, (void*)1);
                        om_put(st.env, node.text, (void*)lf_rs_one(hsite));
                        is_heap = true;
                    };
                };
                if (!is_heap) { om_del(this.heapvars, node.text); };
                if (iv != (Node*)0) { this.add_deriv(node.text, iv); };
                if (iv != (Node*)0)
                {
                    if (iv.kind == NodeKind.ARRAY_LITERAL)
                    {
                        c = bc_count(iv, 0);
                        i = 0;
                        while (i < c)
                        {
                            v = this.eval(node_child(iv, 0, i), st);
                            this.store_cells(lf_rs_one(reg), v, st, false, node);
                            i++;
                        };
                        ->;
                    };
                    this.async_node = iv;
                    this.last_task = (LTask*)0;
                    tm = (LTerm*)0;
                    if (!is_arr & !bc_is_pointer_type(ts)) { tm = this.term_of(iv, st); };
                    v = this.eval(iv, st);
                    if (tm != (LTerm*)0) { om_put(st.terms, node.text, (void*)tm); };
                    if (this.last_task != (LTask*)0)
                    {
                        if (this.last_task.node == iv)
                        {
                            this.last_task.result_var = node.text;
                            this.last_task = (LTask*)0;
                        };
                    };
                    if (!is_arr) { om_put(st.env, node.text, (void*)v); };
                };
                if (is_heap) { om_put(st.env, node.text, (void*)lf_rs_one(hsite)); };
                ->;
            };



            assign(Node* target, Node* value, LState* st) -> void
            {
                PtrVec* v, cells, dr;
                LocInfo* info;
                byte* reg;
                int i;
                LTerm* tm;
                this.async_node = value;
                this.last_task = (LTask*)0;
                v = this.eval(value, st);
                if (this.last_task != (LTask*)0)
                {
                    if (this.last_task.node == value)
                    {
                        if (target.kind == NodeKind.IDENTIFIER) { this.last_task.result_var = target.text; };
                        this.last_task = (LTask*)0;
                    };
                };
                if (target.kind == NodeKind.IDENTIFIER)
                {
                    info = lf_loc_get(this.locals, target.text);
                    if (info != (LocInfo*)0)
                    {
                        if (info.reg[0] != 'G')
                        {
                            this.add_deriv(target.text, value);
                            this.access(lf_rs_one(info.reg), 2, st, false, (byte*)0, (LRng*)0);
                            tm = this.term_of(value, st);
                            if (tm != (LTerm*)0) { om_put(st.terms, target.text, (void*)tm); }
                            else { om_del(st.terms, target.text); };
                            -> om_put(st.env, target.text, (void*)v);
                        };
                    };
                    reg = lf_static(target.text);
                    this.access(lf_rs_one(reg), 2, st, false, (byte*)0, (LRng*)0);
                    this.escape_check(lf_rs_one(reg), v, st, target);
                    om_put(st.held, reg, (void*)v);
                    -> this.mark_esc(v, st);
                };
                this.cells_of(target, st);
                cells = this.cells_r;
                dr = this.deref_r;
                if (dr.len > 0)
                {
                    this.deref_check(dr, target, st);
                    this.alias_check(target, dr, st, true);
                };
                this.access(this.roots_of(cells), 2, st, false, (byte*)0, this.acc_range(target, st));
                if (target.kind == NodeKind.ARRAY_ACCESS)
                {
                    if (target.b.kind != NodeKind.LITERAL & target.b.kind != NodeKind.STRING_LITERAL)
                    {
                        i = 0;
                        while (i < v.len)
                        {
                            if (((byte*)v.items[i])[0] == 'H' | ((byte*)v.items[i])[0] == 'P')
                            {
                                om_put(this.multi, (byte*)v.items[i], (void*)1);
                            };
                            i++;
                        };
                    };
                };
                -> this.store_cells(cells, v, st, true, target);
            };

            compound(Node* node, LState* st) -> void
            {
                Node* t = node.a;
                PtrVec* v, cells;
                LocInfo* info;
                if (t.kind != NodeKind.IDENTIFIER)
                {
                    this.cells_of(t, st);
                    cells = this.cells_r;
                    if (this.deref_r.len > 0)
                    {
                        this.deref_check(this.deref_r, t, st);
                        this.alias_check(t, this.deref_r, st, true);
                    };
                    this.access(this.roots_of(cells), 1 `| 2, st, false, (byte*)0, this.acc_range(t, st));
                }
                else
                {
                    info = lf_loc_get(this.locals, t.text);
                    if (info != (LocInfo*)0)
                    {
                        om_del(st.terms, t.text);
                        this.access(lf_rs_one(info.reg), 1 `| 2, st, false, (byte*)0, (LRng*)0);
                    }
                    else
                    {
                        this.access(lf_rs_one(lf_static(t.text)), 1 `| 2, st, false, (byte*)0, (LRng*)0);
                    };
                };
                v = this.eval(node.b, st);
                if (t.kind == NodeKind.IDENTIFIER)
                {
                    if (lf_loc_get(this.locals, t.text) != (LocInfo*)0)
                    {
                        om_put(st.env, t.text, (void*)lf_rs_union(lf_env_get(st.env, t.text), v));
                    };
                };
                ->;
            };

            store_cells(PtrVec* cells, PtrVec* v, LState* st, bool check, Node* node) -> void
            {
                int i;
                byte* c;
                if (v.len == 0) { ->; };
                if (check) { this.escape_check(cells, v, st, node); };
                while (i < cells.len)
                {
                    c = (byte*)cells.items[i];
                    if (om_has(st.held, c))
                    {
                        om_put(st.held, c, (void*)lf_rs_union((PtrVec*)om_get(st.held, c), v));
                    }
                    else
                    {
                        om_put(st.held, c, (void*)v);
                    };
                    i++;
                };
                -> this.mark_esc(v, st);
            };

            mark_esc(PtrVec* v, LState* st) -> void
            {
                int i;
                byte* r;
                while (i < v.len)
                {
                    r = (byte*)v.items[i];
                    if (r[0] == 'H' | r[0] == 'P') { om_put(st.esc, r, (void*)1); };
                    i++;
                };
                ->;
            };


            escape_check(PtrVec* cells, PtrVec* v, LState* st, Node* node) -> void
            {
                PtrVec* locs = pv_new();
                int i, j;
                byte* r, c, cf, what, nm;
                bool outlives;
                while (i < v.len)
                {
                    r = (byte*)v.items[i];
                    if (r[0] == 'S')
                    {
                        if (cstr_eq(lf_seg(r, 1), this.fn)) { pv_push(locs, (void*)r); };
                    };
                    i++;
                };
                if (locs.len == 0) { ->; };
                i = 0;
                while (i < cells.len)
                {
                    c = lf_root((byte*)cells.items[i]);
                    outlives = c[0] == 'P' | c[0] == 'H' | c[0] == 'G';
                    if (c[0] == 'S')
                    {
                        cf = lf_seg(c, 1);
                        if (!cstr_eq(cf, this.fn)) { outlives = true; };
                    };
                    if (outlives)
                    {
                        what = g"an outer cell\0";
                        if (c[0] == 'P') { what = g"a parameter pointee\0"; };
                        if (c[0] == 'H') { what = g"a heap cell\0"; };
                        if (c[0] == 'G') { what = g"a global\0"; };
                        j = 0;
                        while (j < locs.len)
                        {
                            r = (byte*)locs.items[j];
                            nm = lf_seg(r, 2);
                            this.sb.clear();
                            this.sb.put_str(f"pointer to local '{nm}' stored in {what} and outlives its stack allocation '{this.rdesc(r)}' (allocation scope exited)\0");
                            this.report(g"scope_escape\0", this.take(), this.cur_line,
                                        this.det1(g"stored at \0", this.where(this.cur_line)));
                            j++;
                        };
                    };
                    i++;
                };
                ->;
            };



            do_return(Node* node, LState* st) -> void
            {
                PtrVec* v = lf_rs_new();
                int i;
                byte* r;
                LRet* lr;
                if (node.a != (Node*)0) { v = this.eval(node.a, st); };
                while (i < v.len)
                {
                    r = (byte*)v.items[i];
                    if (r[0] == 'S')
                    {
                        if (cstr_eq(lf_seg(r, 1), this.fn))
                        {
                            this.sb.clear();
                            this.sb.put_str(f"pointer to local '{lf_seg(r, 2)}' returned and outlives its stack allocation '{this.rdesc(r)}' (allocation scope exited)\0");
                            this.report(g"scope_escape\0", this.take(), this.cur_line,
                                        this.det1(g"returned at \0", this.where(this.cur_line)));
                        };
                    };
                    i++;
                };
                this.run_defers_all(st);
                this.exit_path(st, v, this.cur_line);
                lr = (LRet*)fmalloc((u64)((sizeof(LRet) + 7) / 8));
                lr
                {
                    .st = lf_state_copy(st);
                    .regs = v;
                };
                pv_push(this.returns, (void*)lr);
                st.dead = true;
                ->;
            };


            exit_path(LState* st, PtrVec* ret, int line) -> void
            {
                int i;
                byte* r, o;
                int* fl;
                PtrVec* d;
                while (i < st.status.ks.len)
                {
                    r = (byte*)st.status.ks.items[i];
                    fl = (int*)st.status.vs.items[i];
                    i++;
                    if (r[0] != 'H') { continue; };
                    if (lf_rs_has(ret, r)) { continue; };
                    if (om_has(st.esc, r)) { continue; };
                    if (fl[0] != 1) { continue; };
                    o = lf_origin(r);
                    this.sb.clear();
                    this.sb.put_str(f"heap allocation '{this.rdesc(r)}' has no reachable ffree on all paths\0");
                    d = pv_new();
                    this.sb.clear();
                    this.sb.put_str(g"allocated at \0");
                    this.sb.put_str(this.where(lf_atoi(lf_seg(o, 2))));
                    pv_push(d, (void*)this.take());
                    this.sb.clear();
                    this.sb.put_str(f"never freed or handed off on the path ending at {this.where(line)}\0");
                    pv_push(d, (void*)this.take());
                    this.sb.clear();
                    this.sb.put_str(f"heap allocation '{this.rdesc(r)}' has no reachable ffree on all paths\0");
                    this.report(g"heap_leak\0", this.take(), lf_atoi(lf_seg(r, 2)), d);
                };
                ->;
            };





            nf_bare(Node* e) -> Node*
            {
                while (e != (Node*)0 & bc_is_cast(e)) { e = e.a; };
                return e;
            };

            nf_zero(Node* e) -> bool
            {
                if (e == (Node*)0) { return false; };
                if (e.kind != NodeKind.LITERAL) { return false; };
                if (e.op == DataType.SINT | e.op == DataType.UINT | e.op == DataType.SLONG | e.op == DataType.ULONG | e.op == DataType.BOOL)
                {
                    return e.ival == 0;
                };
                return false;
            };


            null_facts(Node* cond, bool truth, PtrVec* out) -> void
            {
                Node* c = this.nf_bare(cond);
                Node* l, r, t;
                bool is_eq;
                if (c == (Node*)0) { ->; };
                if (c.kind == NodeKind.UNARY_OP)
                {
                    if (c.op == Operator.NOT & ((c.flags `& 1) == 0))
                    {
                        this.null_facts(c.a, !truth, out);
                    };
                    ->;
                };
                if (c.kind == NodeKind.IDENTIFIER)
                {
                    if (!truth) { pv_push(out, (void*)c.text); };
                    ->;
                };
                if (c.kind == NodeKind.BINARY_OP)
                {
                    if (c.op == Operator.EQUAL | c.op == Operator.NOT_EQUAL)
                    {
                        l = this.nf_bare(c.a);
                        r = this.nf_bare(c.b);
                        if (r != (Node*)0 & l != (Node*)0)
                        {
                            if (r.kind == NodeKind.IDENTIFIER & l.kind == NodeKind.LITERAL)
                            {
                                t = l;
                                l = r;
                                r = t;
                            };
                        };
                        if (l != (Node*)0 & r != (Node*)0)
                        {
                            if (l.kind == NodeKind.IDENTIFIER & this.nf_zero(r))
                            {
                                is_eq = c.op == Operator.EQUAL;
                                if (is_eq == truth) { pv_push(out, (void*)l.text); };
                            };
                        };
                        ->;
                    };
                    if (c.op == Operator.AND & truth)
                    {
                        this.null_facts(c.a, true, out);
                        this.null_facts(c.b, true, out);
                        ->;
                    };
                    if (c.op == Operator.OR & !truth)
                    {
                        this.null_facts(c.a, false, out);
                        this.null_facts(c.b, false, out);
                    };
                };
                ->;
            };


            narrow(LState* st, Node* cond, bool truth) -> void
            {
                PtrVec* names = pv_new();
                PtrVec* regs;
                int i, j;
                byte* r;
                this.null_facts(cond, truth, names);
                while (i < names.len)
                {
                    regs = (PtrVec*)om_get(st.env, (byte*)names.items[i]);
                    if (regs != (PtrVec*)0)
                    {
                        if (regs.len > 0)
                        {
                            j = 0;
                            while (j < regs.len)
                            {
                                r = (byte*)regs.items[j];
                                if (r[0] == 'H') { om_del(st.status, r); };
                                j++;
                            };
                            om_put(st.env, (byte*)names.items[i], (void*)lf_rs_new());
                        };
                    };
                    i++;
                };
                pv_free(names);
                ->;
            };


            case_truth(Node* c) -> int
            {
                Node* v = c.a;
                if (v == (Node*)0) { return -1; };
                if (v.kind == NodeKind.LITERAL & v.op == DataType.BOOL)
                {
                    if (v.ival != 0) { return 1; };
                    return 0;
                };
                return -1;
            };

            do_if(Node* node, LState* st) -> void
            {
                PtrVec* outs = pv_new();
                LState* s1, rest, s, res;
                int c, i;
                this.eval(node.a, st);
                s1 = lf_state_copy(st);
                this.narrow(s1, node.a, true);
                this.block(node.b, s1, true);
                pv_push(outs, (void*)s1);
                rest = lf_state_copy(st);
                this.narrow(rest, node.a, false);
                c = bc_count(node, 0);
                i = 0;
                while (i < c)
                {
                    this.eval(node_child(node, 0, i), rest);
                    s = lf_state_copy(rest);
                    this.narrow(s, node_child(node, 0, i), true);
                    this.block(node_child(node, 1, i), s, true);
                    pv_push(outs, (void*)s);
                    this.narrow(rest, node_child(node, 0, i), false);
                    i++;
                };
                if (node.c != (Node*)0)
                {
                    s = lf_state_copy(rest);
                    this.block(node.c, s, true);
                    pv_push(outs, (void*)s);
                }
                else
                {
                    pv_push(outs, (void*)rest);
                };
                res = (LState*)0;
                i = 0;
                while (i < outs.len)
                {
                    res = lf_join(res, (LState*)outs.items[i]);
                    i++;
                };
                if (res != (LState*)0) { lf_state_set(st, res); };
                ->;
            };

            do_switch(Node* node, LState* st) -> void
            {
                PtrVec* outs = pv_new();
                bool has_default;
                int c = bc_count(node, 0);
                int i, tv, nseen, seen0, k;
                Node* cs, o;
                LState* s, res;
                this.eval(node.a, st);
                while (i < c)
                {
                    cs = node_child(node, 0, i);
                    if (cs.a == (Node*)0) { has_default = true; }
                    else { this.eval(cs.a, lf_state_copy(st)); };
                    s = lf_state_copy(st);
                    tv = this.case_truth(cs);
                    if ((tv < 0) & (cs.a == (Node*)0))
                    {
                        nseen = 0;
                        k = 0;
                        while (k < c)
                        {
                            o = node_child(node, 0, k);
                            if (o.a != (Node*)0)
                            {
                                nseen++;
                                seen0 = this.case_truth(o);
                            };
                            k++;
                        };
                        if ((nseen == 1) & (seen0 >= 0)) { tv = 1 - seen0; };
                    };
                    if (tv >= 0) { this.narrow(s, node.a, tv == 1); };
                    if (cs.b != (Node*)0)
                    {
                        if (cs.b.kind == NodeKind.BLOCK) { this.block(cs.b, s, true); }
                        else { this.stmt(cs.b, s, g"fn\0"); };
                    };
                    pv_push(outs, (void*)s);
                    i++;
                };
                if (!has_default) { pv_push(outs, (void*)lf_state_copy(st)); };
                res = (LState*)0;
                i = 0;
                while (i < outs.len)
                {
                    res = lf_join(res, (LState*)outs.items[i]);
                    i++;
                };
                if (res != (LState*)0) { lf_state_set(st, res); };
                ->;
            };

            loop(LState* st, Node* cond, Node* body, bool check_first, Node* update, bool once) -> void
            {
                LLoop* ctx = (LLoop*)fmalloc((u64)((sizeof(LLoop) + 7) / 8));
                LState* entry = lf_state_copy(st);
                LState* cur = entry;
                LState* s, nxt, out;
                LState* back = entry;
                int pass, i;
                LPat* pat;
                LRng* prev_iv;
                if (check_first & !once) { pat = this.loop_pattern(cond, body, update, st); };
                ctx
                {
                    .breaks = pv_new();
                    .conts = pv_new();
                };
                while (pass < 4)
                {
                    ctx
                    {
                        .breaks = pv_new();
                        .conts = pv_new();
                    };
                    pv_push(this.loops, (void*)ctx);
                    s = lf_state_copy(cur);
                    if (cond != (Node*)0 & check_first) { this.eval(cond, s); };
                    if (pat != (LPat*)0)
                    {
                        prev_iv = (LRng*)om_get(this.ivars, pat.name);
                        om_put(this.ivars, pat.name, (void*)lf_rng(pat.lo, pat.hi));
                    };
                    this.block(body, s, true);
                    if (pat != (LPat*)0)
                    {
                        if (prev_iv == (LRng*)0) { om_del(this.ivars, pat.name); }
                        else { om_put(this.ivars, pat.name, (void*)prev_iv); };
                    };
                    this.loops.len--;
                    back = s;
                    i = 0;
                    while (i < ctx.conts.len)
                    {
                        back = lf_join(back, (LState*)ctx.conts.items[i]);
                        i++;
                    };
                    if (update != (Node*)0)
                    {
                        if (!back.dead) { this.stmt(update, back, g"fn\0"); };
                    };
                    if (cond != (Node*)0 & !check_first)
                    {
                        if (!back.dead) { this.eval(cond, back); };
                    };
                    if (once) { nxt = entry; } else { nxt = lf_join(entry, back); };
                    if (lf_state_eq(nxt, cur)) { break; };
                    cur = nxt;
                    pass++;
                };
                if (once)
                {
                    out = back;
                }
                else
                {
                    if (check_first)
                    {
                        out = lf_state_copy(cur);
                        if (cond != (Node*)0) { this.eval(cond, out); };
                    }
                    else
                    {
                        if (!back.dead) { out = back; } else { out = cur; };
                    };
                };
                i = 0;
                while (i < ctx.breaks.len)
                {
                    out = lf_join(out, (LState*)ctx.breaks.items[i]);
                    i++;
                };
                if (pat != (LPat*)0) { om_del(out.terms, pat.name); };
                -> lf_state_set(st, out);
            };



            load(PtrVec* cells, LState* st) -> PtrVec*
            {
                PtrVec* out = lf_rs_new();
                int i;
                byte* c;
                while (i < cells.len)
                {
                    c = (byte*)cells.items[i];
                    if (om_has(st.held, c))
                    {
                        out = lf_rs_union(out, (PtrVec*)om_get(st.held, c));
                    };
                    i++;
                };
                -> out;
            };



            cells_of(Node* e, LState* st) -> void
            {
                LocInfo* info;
                PtrVec* vals, bc, dr, inner, loaded, out, v;
                Node* base;
                bool is_m;
                int i;
                if (e.kind == NodeKind.IDENTIFIER)
                {
                    info = lf_loc_get(this.locals, e.text);
                    if (info == (LocInfo*)0)
                    {
                        this.cells_r = lf_rs_one(lf_static(e.text));
                        this.deref_r = lf_rs_new();
                        ->;
                    };
                    if (info.kind == 1)
                    {
                        this.cells_r = lf_rs_one(info.reg);
                        this.deref_r = lf_rs_new();
                        ->;
                    };
                    vals = lf_env_get(st.env, e.text);
                    if (vals.len > 0)
                    {
                        this.cells_r = vals;
                        this.deref_r = vals;
                        ->;
                    };
                    this.cells_r = lf_rs_one(info.reg);
                    this.deref_r = lf_rs_new();
                    ->;
                };
                if (e.kind == NodeKind.MEMBER_ACCESS | e.kind == NodeKind.ARRAY_ACCESS)
                {
                    is_m = e.kind == NodeKind.MEMBER_ACCESS;
                    base = e.a;
                    if (!is_m) { this.eval(e.b, st); };
                    if (base.kind == NodeKind.IDENTIFIER)
                    {
                        this.cells_of(base, st);
                        bc = this.cells_r;
                        dr = this.deref_r;
                    }
                    else
                    {
                        this.cells_of(base, st);
                        inner = this.cells_r;
                        loaded = this.load(inner, st);
                        if (loaded.len > 0)
                        {
                            bc = loaded;
                            dr = loaded;
                        }
                        else
                        {
                            bc = inner;
                            dr = lf_rs_new();
                        };
                    };
                    if (is_m)
                    {
                        out = lf_rs_new();
                        i = 0;
                        while (i < bc.len)
                        {
                            lf_rs_add(out, lf_fld((byte*)bc.items[i], e.text));
                            i++;
                        };
                        this.cells_r = out;
                        this.deref_r = dr;
                        ->;
                    };
                    this.cells_r = bc;
                    this.deref_r = dr;
                    ->;
                };
                if (e.kind == NodeKind.POINTER_DEREF)
                {
                    v = this.eval(e.a, st);
                    this.cells_r = v;
                    this.deref_r = v;
                    ->;
                };
                v = this.eval(e, st);
                this.cells_r = v;
                this.deref_r = v;
                ->;
            };

            hint(Node* e) -> byte*
            {
                Node* x = e;
                while (true)
                {
                    if (x.kind == NodeKind.IDENTIFIER) { -> x.text; };
                    if (x.kind == NodeKind.POINTER_DEREF) { x = x.a; }
                    else
                    {
                        if (x.kind == NodeKind.MEMBER_ACCESS) { x = x.a; }
                        else
                        {
                            if (x.kind == NodeKind.ARRAY_ACCESS) { x = x.a; }
                            else
                            {
                                if (x.kind == NodeKind.CAST_EXPRESSION | x.kind == NodeKind.ADDRESS_OF) { x = x.a; }
                                else { -> g"<expr>\0"; };
                            };
                        };
                    };
                    if (x == (Node*)0) { -> g"<expr>\0"; };
                };
                -> g"<expr>\0";
            };

            deref_check(PtrVec* regs, Node* node, LState* st) -> void
            {
                byte* name = this.hint(node);
                PtrVec* hp = pv_new();
                bool allf;
                int i, fl;
                byte* r;
                int* wp;
                PtrVec* det;
                while (i < regs.len)
                {
                    r = (byte*)regs.items[i];
                    if (r[0] == 'H' | r[0] == 'P')
                    {
                        if (!om_has(this.multi, r)) { pv_push(hp, (void*)r); };
                    };
                    i++;
                };
                if (hp.len > 0)
                {
                    allf = true;
                    i = 0;
                    while (i < hp.len)
                    {
                        if ((lf_flags(st.status, (byte*)hp.items[i]) `& 2) == 0) { allf = false; };
                        i++;
                    };
                };
                i = 0;
                while (i < regs.len)
                {
                    r = (byte*)regs.items[i];
                    i++;
                    if (r[0] == 'H' | r[0] == 'P')
                    {
                        if (!allf) { continue; };
                        if (!lf_rs_has(hp, r)) { continue; };
                        fl = lf_flags(st.status, r);
                        if ((fl `& 2) != 0)
                        {
                            det = pv_new();
                            if (om_has(st.free_at, r))
                            {
                                wp = (int*)om_get(st.free_at, r);
                                this.sb.clear();
                                this.sb.put_str(g"ffree called at \0");
                                this.sb.put_str(this.where(wp[0]));
                                pv_push(det, (void*)this.take());
                            };
                            if ((fl `& 3) == 2)
                            {
                                this.sb.clear();
                                this.sb.put_str(f"pointer '{name}' used after its allocation site '{this.rdesc(r)}' was passed to ffree\0");
                                this.report(g"use_after_free\0", this.take(), this.cur_line, det);
                            }
                            else
                            {
                                this.sb.clear();
                                this.sb.put_str(f"pointer '{name}' used but its allocation site '{this.rdesc(r)}' may already have been passed to ffree\0");
                                this.report(g"maybe_use_after_free\0", this.take(), this.cur_line, det);
                            };
                        };
                        continue;
                    };
                    if (r[0] == 'S')
                    {
                        if (!lf_active_has(st.active, lf_seg(r, 3)))
                        {
                            this.sb.clear();
                            this.sb.put_str(f"pointer '{name}' used after its stack allocation '{this.rdesc(r)}' went out of scope\0");
                            this.report(g"use_after_scope\0", this.take(), this.cur_line, (PtrVec*)0);
                        };
                        continue;
                    };
                    if (r[0] == 'D')
                    {
                        this.sb.clear();
                        this.sb.put_str(f"pointer '{name}' used after the stack allocation '{this.rdesc(r)}' it points to was returned from a callee\0");
                        this.report(g"use_after_scope\0", this.take(), this.cur_line, (PtrVec*)0);
                    };
                };
                ->;
            };

            eval(Node* e, LState* st) -> PtrVec*
            {
                int k;
                LocInfo* info;
                PtrVec* l, r, cells, dr;
                if (e == (Node*)0) { -> lf_rs_new(); };
                k = e.kind;
                if (e.line != 0) { this.cur_line = e.line; };

                if (k == NodeKind.LITERAL | k == NodeKind.STRING_LITERAL) { -> lf_rs_new(); };
                if (k == NodeKind.ASSIGNMENT)
                {
                    this.assign(e.a, e.b, st);
                    if (e.a.kind == NodeKind.IDENTIFIER) { -> this.eval(e.a, st); };
                    -> lf_rs_new();
                };
                if (k == NodeKind.COMPOUND_ASSIGNMENT)
                {
                    this.compound(e, st);
                    -> lf_rs_new();
                };
                if (k == NodeKind.IDENTIFIER)
                {
                    this.join_result(e.text, st);
                    info = lf_loc_get(this.locals, e.text);
                    if (info == (LocInfo*)0)
                    {
                        this.access(lf_rs_one(lf_static(e.text)), 1, st, false, (byte*)0, (LRng*)0);
                        -> this.load(lf_rs_one(lf_static(e.text)), st);
                    };
                    if (info.kind == 1) { -> lf_rs_one(info.reg); };
                    this.access(lf_rs_one(info.reg), 1, st, false, (byte*)0, (LRng*)0);
                    -> lf_env_get(st.env, e.text);
                };
                if (k == NodeKind.ADDRESS_OF) { -> this.addr_of(e.a, st); };
                if (k == NodeKind.POINTER_DEREF | k == NodeKind.ARRAY_ACCESS | k == NodeKind.MEMBER_ACCESS)
                {
                    this.cells_of(e, st);
                    cells = this.cells_r;
                    dr = this.deref_r;
                    if (dr.len > 0)
                    {
                        this.deref_check(dr, e, st);
                        this.alias_check(e, dr, st, false);
                    };
                    this.access(this.roots_of(cells), 1, st, false, (byte*)0, this.acc_range(e, st));
                    -> this.load(cells, st);
                };
                if (k == NodeKind.CAST_EXPRESSION)
                {
                    if (e.a != (Node*)0 & e.ts != (TypeSpec*)0)
                    {
                        if (e.a.kind == NodeKind.TIE_EXPRESSION & e.ts.base_type == DataType.VOID & !bc_is_pointer_type(e.ts))
                        {

                            this.do_free(this.eval(e.a, st), st, true);
                            -> lf_rs_new();
                        };
                        if (e.a.kind == NodeKind.IDENTIFIER & e.ts.base_type == DataType.VOID & !bc_is_pointer_type(e.ts))
                        {
                            if (om_has(this.heapvars, e.a.text) | om_has(this.al.ptr_vars, e.a.text))
                            {

                                this.do_free(this.eval(e.a, st), st, true);
                                -> lf_rs_new();
                            };
                        };
                    };
                    -> this.eval(e.a, st);
                };
                if (k == NodeKind.BINARY_OP)
                {
                    l = this.eval(e.a, st);
                    r = this.eval(e.b, st);
                    if (e.op == Operator.EQUAL | e.op == Operator.NOT_EQUAL | e.op == Operator.LESS_THAN
                        | e.op == Operator.LESS_EQUAL | e.op == Operator.GREATER_THAN
                        | e.op == Operator.GREATER_EQUAL | e.op == Operator.AND | e.op == Operator.OR
                        | e.op == Operator.NAND | e.op == Operator.NOR | e.op == Operator.XOR
                        | e.op == Operator.NOT)
                    {
                        -> lf_rs_new();
                    };
                    -> lf_rs_union(l, r);
                };
                if (k == NodeKind.UNARY_OP)
                {
                    if (e.op == Operator.INCREMENT | e.op == Operator.DECREMENT)
                    {
                        if (e.a.kind == NodeKind.POINTER_DEREF | e.a.kind == NodeKind.ARRAY_ACCESS | e.a.kind == NodeKind.MEMBER_ACCESS)
                        {
                            this.cells_of(e.a, st);
                            cells = this.cells_r;
                            dr = this.deref_r;
                            if (dr.len > 0)
                            {
                                this.deref_check(dr, e.a, st);
                                this.alias_check(e.a, dr, st, true);
                            };
                            this.access(this.roots_of(cells), 1 `| 2, st, false, (byte*)0, this.acc_range(e.a, st));
                            -> this.load(cells, st);
                        };
                    };
                    l = this.eval(e.a, st);
                    if (e.op == Operator.INCREMENT | e.op == Operator.DECREMENT)
                    {
                        if (e.a.kind == NodeKind.IDENTIFIER) { om_del(st.terms, e.a.text); };
                    };
                    if (e.op == Operator.NOT) { -> lf_rs_new(); };
                    -> l;
                };
                if (k == NodeKind.TIE_EXPRESSION) { -> this.tie(e, st); };
                if (k == NodeKind.TYPE_CONVERT_EXPRESSION) { -> this.eval(e.a, st); };
                if (k == NodeKind.NULL_COALESCE)
                {
                    l = this.eval(e.a, st);
                    r = this.eval(e.b, st);
                    -> lf_rs_union(l, r);
                };
                if (k == NodeKind.NOT_NULL)
                {
                    this.eval(e.a, st);
                    -> lf_rs_new();
                };
                if (k == NodeKind.TERNARY_OP)
                {
                    this.eval(e.a, st);
                    l = this.eval(e.b, st);
                    r = this.eval(e.c, st);
                    -> lf_rs_union(l, r);
                };
                if (k == NodeKind.IF_EXPRESSION)
                {
                    this.eval(e.b, st);
                    l = this.eval(e.a, st);
                    if (e.c != (Node*)0) { l = lf_rs_union(l, this.eval(e.c, st)); };
                    -> l;
                };
                if (k == NodeKind.FUNCTION_CALL) { -> this.call(e, st); };
                if (k == NodeKind.METHOD_CALL) { -> this.method(e, st); };

                this.generic_expr(e, st);
                -> lf_rs_new();
            };

            generic_expr(Node* e, LState* st) -> void
            {
                int s, c, i;
                if (e.a != (Node*)0) { this.eval(e.a, st); };
                if (e.b != (Node*)0) { this.eval(e.b, st); };
                if (e.c != (Node*)0) { this.eval(e.c, st); };
                if (e.d != (Node*)0) { this.eval(e.d, st); };
                while (s < 6)
                {
                    c = bc_count(e, s);
                    i = 0;
                    while (i < c)
                    {
                        this.eval(node_child(e, s, i), st);
                        i++;
                    };
                    s++;
                };
                ->;
            };

            addr_of(Node* e, LState* st) -> PtrVec*
            {
                LocInfo* info;
                PtrVec* out, cells;
                int i;
                if (e.kind == NodeKind.IDENTIFIER)
                {
                    info = lf_loc_get(this.locals, e.text);
                    if (info == (LocInfo*)0) { -> lf_rs_one(lf_static(e.text)); };
                    -> lf_rs_one(info.reg);
                };
                if (e.kind == NodeKind.MEMBER_ACCESS | e.kind == NodeKind.ARRAY_ACCESS)
                {
                    this.cells_of(e, st);
                    cells = this.cells_r;
                    out = lf_rs_new();
                    i = 0;
                    while (i < cells.len)
                    {
                        lf_rs_add(out, lf_root((byte*)cells.items[i]));
                        i++;
                    };
                    -> out;
                };
                if (e.kind == NodeKind.POINTER_DEREF) { -> this.eval(e.a, st); };
                -> this.eval(e, st);
            };



            may_carry_pointer(TypeSpec* ts) -> bool
            {
                int bt;
                if (ts == (TypeSpec*)0) { -> false; };
                if (bc_is_pointer_type(ts)) { -> true; };
                if ((ts.flags `& 32) != 0) { -> false; };
                if (ts.custom_typename != (byte*)0)
                {
                    if (ts.custom_typename[0] != 0) { -> false; };
                };
                bt = ts.base_type;
                if (bt == DataType.FLOAT | bt == DataType.DOUBLE | bt == DataType.STRUCT | bt == DataType.UNION
                    | bt == DataType.OBJECT | bt == DataType.ENUM | bt == DataType.VOID | bt == DataType.FUNC_PTR
                    | bt == DataType.DICT | bt == DataType.THIS | bt == DataType.BOOL)
                {
                    -> false;
                };
                -> true;
            };


            tie(Node* e, LState* st) -> PtrVec*
            {
                Node* op = e.a;
                LocInfo* info;
                PtrVec* v;
                if (op.kind != NodeKind.IDENTIFIER) { -> this.eval(op, st); };
                info = lf_loc_get(this.locals, op.text);
                v = this.eval(op, st);
                if (info != (LocInfo*)0)
                {
                    if (info.kind == 1) { -> v; };
                };
                om_put(st.env, op.text, (void*)lf_rs_new());
                if (info != (LocInfo*)0)
                {

                    this.mark_esc(this.load(lf_rs_one(info.reg), st), st);
                };
                -> v;
            };

            root_ident(Node* e) -> Node*
            {
                Node* x = e;
                while (x != (Node*)0)
                {
                    if (x.kind == NodeKind.IDENTIFIER) { -> x; };
                    if (x.kind == NodeKind.POINTER_DEREF | x.kind == NodeKind.ARRAY_ACCESS
                        | x.kind == NodeKind.MEMBER_ACCESS | x.kind == NodeKind.CAST_EXPRESSION)
                    {
                        x = x.a;
                    }
                    else { -> (Node*)0; };
                };
                -> (Node*)0;
            };

            arg_ident(Node* a) -> Node*
            {
                Node* x = a;
                while (x != (Node*)0)
                {
                    if (x.kind == NodeKind.IDENTIFIER) { -> x; };
                    if (x.kind == NodeKind.CAST_EXPRESSION | x.kind == NodeKind.ADDRESS_OF) { x = x.a; }
                    else { -> (Node*)0; };
                };
                -> (Node*)0;
            };

            rhs_vars(Node* n, byte* exclude, OMap* out) -> void
            {
                int s, c, i;
                if (n == (Node*)0) { ->; };
                if (n.kind == NodeKind.IDENTIFIER)
                {
                    if (!cstr_eq(n.text, exclude))
                    {
                        if (lf_loc_get(this.locals, n.text) != (LocInfo*)0) { om_put(out, n.text, (void*)1); };
                    };
                    ->;
                };
                this.rhs_vars(n.a, exclude, out);
                this.rhs_vars(n.b, exclude, out);
                this.rhs_vars(n.c, exclude, out);
                this.rhs_vars(n.d, exclude, out);
                while (s < 6)
                {
                    c = bc_count(n, s);
                    i = 0;
                    while (i < c)
                    {
                        this.rhs_vars(node_child(n, s, i), exclude, out);
                        i++;
                    };
                    s++;
                };
                ->;
            };

            add_deriv(byte* name, Node* rhs) -> void
            {
                OMap* cur = (OMap*)om_get(this.al.deriv, name);
                int i;
                OMap* tmp = om_new();
                if (cur == (OMap*)0)
                {
                    cur = om_new();
                    om_put(this.al.deriv, name, (void*)cur);
                };
                this.rhs_vars(rhs, name, tmp);
                while (i < tmp.ks.len)
                {
                    om_put(cur, (byte*)tmp.ks.items[i], (void*)1);
                    i++;
                };
                ->;
            };

            uses_add(OMap* m, byte* name, LPos* p) -> void
            {
                PtrVec* v = (PtrVec*)om_get(m, name);
                if (v == (PtrVec*)0)
                {
                    v = pv_new();
                    om_put(m, name, (void*)v);
                };
                -> pv_push(v, (void*)p);
            };

            note_writer(Node* target) -> void
            {
                Node* r = this.root_ident(target);
                if (r != (Node*)0) { om_put(this.al.writers, r.text, (void*)1); };
                ->;
            };

            ix_walk(Node* n, PtrVec* path, PtrVec* loops) -> void
            {
                int k, s, c, i;
                byte* nk;
                LPos* p;
                PtrVec* p2, l2;
                if (n == (Node*)0) { ->; };
                k = n.kind;
                if (k == NodeKind.FUNCTION_DEF) { ->; };
                if (k == NodeKind.IDENTIFIER)
                {
                    p = lf_pos_new(this.al.seq, path, loops);
                    this.al.seq++;
                    om_put(this.al.ix, lf_addr_key((void*)n), (void*)p);
                    -> this.uses_add(this.al.uses, n.text, p);
                };
                if (k == NodeKind.IF_STATEMENT)
                {
                    nk = lf_addr_key((void*)n);
                    this.ix_walk(n.a, path, loops);
                    this.ix_walk(n.b, lf_pv_add(path, lf_pe(nk, 0)), loops);
                    c = bc_count(n, 0);
                    i = 0;
                    while (i < c)
                    {
                        p2 = lf_pv_add(path, lf_pe(nk, i + 1));
                        this.ix_walk(node_child(n, 0, i), p2, loops);
                        this.ix_walk(node_child(n, 1, i), p2, loops);
                        i++;
                    };
                    if (n.c != (Node*)0) { this.ix_walk(n.c, lf_pv_add(path, lf_pe(nk, c + 1)), loops); };
                    ->;
                };
                if (k == NodeKind.SWITCH_STATEMENT)
                {
                    nk = lf_addr_key((void*)n);
                    this.ix_walk(n.a, path, loops);
                    c = bc_count(n, 0);
                    i = 0;
                    while (i < c)
                    {
                        this.ix_walk(node_child(n, 0, i).a, path, loops);
                        this.ix_walk(node_child(n, 0, i).b, lf_pv_add(path, lf_pe(nk, i)), loops);
                        i++;
                    };
                    ->;
                };
                if (k == NodeKind.WHILE_LOOP | k == NodeKind.DO_WHILE_LOOP | k == NodeKind.DO_LOOP
                    | k == NodeKind.FOR_LOOP | k == NodeKind.FOR_IN_LOOP)
                {
                    nk = lf_addr_key((void*)n);
                    if (k == NodeKind.FOR_LOOP) { this.ix_walk(n.a, path, loops); };
                    if (k == NodeKind.FOR_IN_LOOP) { this.ix_walk(n.a, path, loops); };
                    om_put(this.al.loop_start, nk, (void*)bx_new(this.al.seq));
                    l2 = lf_pv_add(loops, nk);
                    if (k == NodeKind.FOR_LOOP)
                    {
                        this.ix_walk(n.b, path, l2);
                        this.ix_walk(n.d, path, l2);
                        this.ix_walk(n.c, path, l2);
                    };
                    if (k == NodeKind.FOR_IN_LOOP) { this.ix_walk(n.b, path, l2); };
                    if (k == NodeKind.WHILE_LOOP)
                    {
                        this.ix_walk(n.a, path, l2);
                        this.ix_walk(n.b, path, l2);
                    };
                    if (k == NodeKind.DO_WHILE_LOOP)
                    {
                        this.ix_walk(n.a, path, l2);
                        this.ix_walk(n.b, path, l2);
                    };
                    if (k == NodeKind.DO_LOOP) { this.ix_walk(n.b, path, l2); };
                    -> om_put(this.al.loop_end, nk, (void*)bx_new(this.al.seq));
                };
                if (k == NodeKind.ASSIGNMENT)
                {
                    this.ix_walk(n.b, path, loops);
                    if (n.a.kind == NodeKind.IDENTIFIER)
                    {
                        this.uses_add(this.al.defs, n.a.text, lf_pos_new(this.al.seq, path, loops));
                        this.al.seq++;
                        ->;
                    };
                    this.ix_walk(n.a, path, loops);
                    -> this.note_writer(n.a);
                };
                if (k == NodeKind.COMPOUND_ASSIGNMENT)
                {
                    this.ix_walk(n.b, path, loops);
                    this.ix_walk(n.a, path, loops);
                    if (n.a.kind != NodeKind.IDENTIFIER) { this.note_writer(n.a); };
                    ->;
                };
                if (k == NodeKind.UNARY_OP)
                {
                    if (n.op == Operator.INCREMENT | n.op == Operator.DECREMENT)
                    {
                        this.ix_walk(n.a, path, loops);
                        if (n.a.kind != NodeKind.IDENTIFIER) { this.note_writer(n.a); };
                        ->;
                    };
                };
                if (k == NodeKind.VARIABLE_DECLARATION)
                {
                    this.ix_walk(n.a, path, loops);
                    om_put(this.al.first, n.text, (void*)bx_new(this.al.seq));
                    this.uses_add(this.al.defs, n.text, lf_pos_new(this.al.seq, path, loops));
                    this.al.seq++;
                    ->;
                };
                this.ix_walk(n.a, path, loops);
                this.ix_walk(n.b, path, loops);
                this.ix_walk(n.c, path, loops);
                this.ix_walk(n.d, path, loops);
                s = 0;
                while (s < 6)
                {
                    c = bc_count(n, s);
                    i = 0;
                    while (i < c)
                    {
                        this.ix_walk(node_child(n, s, i), path, loops);
                        i++;
                    };
                    s++;
                };
                ->;
            };

            index_function(Node* func) -> void
            {
                -> this.ix_walk(func.a, pv_new(), pv_new());
            };


            live_after(byte* name, LPos* pos) -> bool
            {
                PtrVec* defs = (PtrVec*)om_get(this.al.defs, name);
                PtrVec* uses = (PtrVec*)om_get(this.al.uses, name);
                int ui, di, li, first, lstart, lend;
                LPos* u, d;
                bool killed, k1, k2;
                byte* L;
                if (uses == (PtrVec*)0) { -> false; };
                if (defs == (PtrVec*)0) { defs = pv_new(); };
                while (ui < uses.len)
                {
                    u = (LPos*)uses.items[ui];
                    ui++;
                    if (u.seq > pos.seq & !lf_exclusive(u.path, pos.path))
                    {
                        killed = false;
                        di = 0;
                        while (di < defs.len)
                        {
                            d = (LPos*)defs.items[di];
                            di++;
                            if (d.seq > pos.seq & lf_prefix(d.path, pos.path) & d.seq < u.seq & lf_prefix(d.path, u.path))
                            {
                                killed = true;
                            };
                        };
                        if (!killed) { -> true; };
                    };
                    li = 0;
                    while (li < u.loops.len)
                    {
                        L = (byte*)u.loops.items[li];
                        li++;
                        if (!lf_pv_has(pos.loops, L)) { continue; };
                        first = lf_int_get(this.al.first, name, -1);
                        lstart = lf_int_get(this.al.loop_start, L, 0);
                        if (first >= lstart) { continue; };
                        lend = lf_int_get(this.al.loop_end, L, 1073741824);
                        k1 = false;
                        k2 = false;
                        di = 0;
                        while (di < defs.len)
                        {
                            d = (LPos*)defs.items[di];
                            di++;
                            if (d.seq > pos.seq & lf_prefix(d.path, pos.path) & lf_pv_has(d.loops, L) & d.seq < lend)
                            {
                                k1 = true;
                            };
                            if (lstart <= d.seq & d.seq < u.seq & lf_prefix(d.path, u.path) & lf_pv_has(d.loops, L))
                            {
                                k2 = true;
                            };
                        };
                        if (k1 | k2) { continue; };
                        -> true;
                    };
                };
                -> false;
            };

            ancestors(byte* name) -> OMap*
            {
                OMap* seen = om_new();
                PtrVec* todo = pv_new();
                byte* x;
                OMap* ds;
                int i;
                pv_push(todo, (void*)name);
                while (todo.len > 0)
                {
                    x = (byte*)todo.items[todo.len - 1];
                    todo.len--;
                    ds = (OMap*)om_get(this.al.deriv, x);
                    if (ds != (OMap*)0)
                    {
                        i = 0;
                        while (i < ds.ks.len)
                        {
                            if (!om_has(seen, (byte*)ds.ks.items[i]))
                            {
                                om_put(seen, (byte*)ds.ks.items[i], (void*)1);
                                pv_push(todo, ds.ks.items[i]);
                            };
                            i++;
                        };
                    };
                };
                -> seen;
            };

            note_write(PtrVec* dr) -> void
            {
                int i;
                byte* r;
                while (i < dr.len)
                {
                    r = (byte*)dr.items[i];
                    if (r[0] == 'P')
                    {
                        if (cstr_eq(lf_seg(r, 1), this.fn)) { om_put(this.al.wr_params, lf_seg(r, 2), (void*)1); };
                    };
                    i++;
                };
                ->;
            };


            pick_site(PtrVec* both) -> byte*
            {
                int i = 1;
                byte* best = this.rdesc((byte*)both.items[0]);
                byte* d;
                while (i < both.len)
                {
                    d = this.rdesc((byte*)both.items[i]);
                    if (bc_str_lt(d, best)) { best = d; };
                    i++;
                };
                -> best;
            };

            alias_check(Node* e, PtrVec* dr, LState* st, bool is_write) -> void
            {
                Node* rn;
                byte* p;
                LPos* pos;
                if (is_write) { this.note_write(dr); };
                rn = this.root_ident(e);
                if (rn == (Node*)0) { ->; };
                p = rn.text;
                if (!om_has(this.al.ptr_vars, p)) { ->; };
                if (!lf_rs_eq(dr, lf_env_get(st.env, p))) { ->; };
                pos = (LPos*)om_get(this.al.ix, lf_addr_key((void*)rn));
                if (pos == (LPos*)0) { ->; };
                -> this.alias_vs_live(p, pos, dr, is_write, st, (OMap*)0);
            };

            alias_vs_live(byte* p, LPos* pos, PtrVec* regs, bool is_write, LState* st, OMap* skip) -> void
            {
                OMap* anc = this.ancestors(p);
                int i;
                byte* y, site;
                PtrVec* yregs, both, d;
                int n = st.env.ks.len;
                byte* msg;
                while (i < n)
                {
                    y = (byte*)st.env.ks.items[i];
                    yregs = (PtrVec*)st.env.vs.items[i];
                    i++;
                    if (cstr_eq(y, p)) { continue; };
                    if (skip != (OMap*)0)
                    {
                        if (om_has(skip, y)) { continue; };
                    };
                    if (!om_has(this.al.ptr_vars, y)) { continue; };
                    if (yregs.len == 0) { continue; };
                    both = lf_rs_inter(regs, yregs);
                    if (both.len == 0) { continue; };
                    if (om_has(anc, y)) { continue; };
                    if (!this.live_after(y, pos)) { continue; };
                    if (!(is_write | om_has(this.al.writers, y) | om_has(this.al.writers, p))) { continue; };
                    site = this.pick_site(both);
                    this.sb.clear();
                    this.sb.put_str(f"pointer '{p}' is \0");
                    if (is_write) { this.sb.put_str(g"written\0"); } else { this.sb.put_str(g"read\0"); };
                    this.sb.put_str(f" through while pointer '{y}' to the same allocation '{site}' is still live (many readers or one writer)\0");
                    d = pv_new();
                    this.sb.clear();
                    this.sb.put_str(f"pointer '{p}' is \0");
                    if (is_write) { this.sb.put_str(g"written\0"); } else { this.sb.put_str(g"read\0"); };
                    this.sb.put_str(f" through while pointer '{y}' to the same allocation '{site}' is still live (many readers or one writer)\0");
                    {
                        msg = this.take();
                        this.sb.clear();
                        this.sb.put_str(f"'{p}' accessed at {this.where(this.cur_line)}\0");
                        pv_push(d, (void*)this.take());
                        this.sb.clear();
                        this.sb.put_str(f"'{y}' is used again after this point\0");
                        pv_push(d, (void*)this.take());
                        this.report(g"mutable_alias\0", msg, this.cur_line, d);
                    };
                };
                ->;
            };


            check_call_alias(Node* call, PtrVec* arg_regs, OMap* wr, LState* st) -> void
            {
                int n = arg_regs.len;
                PtrVec* roots = pv_new();
                OMap* names = om_new();
                int i, j;
                Node* r, a;
                PtrVec* both, d;
                bool wi, wj;
                byte* site;
                LPos* pos;
                while (i < n)
                {
                    r = this.arg_ident(node_child(call, 0, i));
                    pv_push(roots, (void*)r);
                    if (r != (Node*)0) { om_put(names, r.text, (void*)1); };
                    i++;
                };
                i = 0;
                byte* msg2;
                while (i < n)
                {
                    j = i + 1;
                    while (j < n)
                    {
                        if ((Node*)roots.items[i] != (Node*)0 & (Node*)roots.items[j] != (Node*)0)
                        {
                            both = lf_rs_inter((PtrVec*)arg_regs.items[i], (PtrVec*)arg_regs.items[j]);
                            if (both.len > 0)
                            {
                                wi = true;
                                wj = true;
                                if (wr != (OMap*)0)
                                {
                                    wi = om_has(wr, lf_itoa(i));
                                    wj = om_has(wr, lf_itoa(j));
                                };
                                if (wi | wj)
                                {
                                    site = this.pick_site(both);
                                    this.sb.clear();
                                    this.sb.put_str(g"arguments '\0");
                                    this.sb.put_str(((Node*)roots.items[i]).text);
                                    this.sb.put_str(g"' and '\0");
                                    this.sb.put_str(((Node*)roots.items[j]).text);
                                    this.sb.put_str(f"' alias the same allocation '{site}' and the callee may write through one of them (many readers or one writer)\0");
                                    {
                                        msg2 = this.take();
                                        d = this.det1(g"call at \0", this.where(this.cur_line));
                                        this.report(g"mutable_alias\0", msg2, this.cur_line, d);
                                    };
                                };
                            };
                        };
                        j++;
                    };
                    i++;
                };
                i = 0;
                while (i < n)
                {
                    r = (Node*)roots.items[i];
                    a = node_child(call, 0, i);
                    i++;
                    if (r == (Node*)0) { continue; };
                    if (a.kind == NodeKind.ADDRESS_OF) { continue; };
                    if (!om_has(this.al.ptr_vars, r.text)) { continue; };
                    if (((PtrVec*)arg_regs.items[i - 1]).len == 0) { continue; };
                    if (!lf_rs_eq((PtrVec*)arg_regs.items[i - 1], lf_env_get(st.env, r.text))) { continue; };
                    pos = (LPos*)om_get(this.al.ix, lf_addr_key((void*)r));
                    if (pos == (LPos*)0) { continue; };
                    wi = true;
                    if (wr != (OMap*)0) { wi = om_has(wr, lf_itoa(i - 1)); };
                    this.alias_vs_live(r.text, pos, (PtrVec*)arg_regs.items[i - 1], wi, st, names);
                };
                ->;
            };



            call(Node* e, LState* st) -> PtrVec*
            {
                byte* name = e.text;
                int n = bc_count(e, 0);
                int i;
                byte* base, site, resolved;
                PtrVec* v, old, arg_regs;
                LSumm* summ;
                if (name != (byte*)0)
                {
                    if (name[0] == 0) { name = (byte*)0; };
                };
                if (name == (byte*)0)
                {
                    if (e.a != (Node*)0) { this.eval(e.a, st); };
                };
                base = g"\0";
                if (name != (byte*)0) { base = bc_last_seg(name); };

                if (cstr_eq(base, g"frealloc\0") & n >= 1)
                {
                    old = this.eval(node_child(e, 0, 0), st);
                    i = 1;
                    while (i < n) { this.eval(node_child(e, 0, i), st); i++; };
                    this.mark_esc(old, st);
                    site = lf_heap(this.fn, this.cur_line, (byte*)0);
                    om_put(st.status, site, (void*)bx_new(1));
                    om_del(st.esc, site);
                    om_del(st.free_at, site);
                    -> lf_rs_one(site);
                };
                if (cstr_eq(base, g"fmalloc\0") | cstr_eq(base, g"fcalloc\0"))
                {
                    i = 0;
                    while (i < n) { this.eval(node_child(e, 0, i), st); i++; };
                    site = lf_heap(this.fn, this.cur_line, (byte*)0);
                    om_put(st.status, site, (void*)bx_new(1));
                    om_del(st.esc, site);
                    om_del(st.free_at, site);
                    -> lf_rs_one(site);
                };
                if (cstr_eq(base, g"ffree\0") & n == 1)
                {
                    v = this.eval(node_child(e, 0, 0), st);
                    this.do_free(v, st, true);
                    -> lf_rs_new();
                };

                arg_regs = pv_new();
                i = 0;
                while (i < n)
                {
                    pv_push(arg_regs, (void*)this.eval(node_child(e, 0, i), st));
                    i++;
                };
                resolved = (byte*)0;
                if (name != (byte*)0) { resolved = this.resolve(name, n); };
                if (resolved == (byte*)0)
                {
                    this.check_call_alias(e, arg_regs, (OMap*)0, st);
                    i = 0;
                    while (i < arg_regs.len) { this.mark_esc((PtrVec*)arg_regs.items[i], st); i++; };
                    -> lf_rs_new();
                };
                summ = this.summary(resolved);
                this.check_call_alias(e, arg_regs, summ.wr, st);
                -> this.call_resolved(e, resolved, summ, arg_regs, st);
            };

            method(Node* e, LState* st) -> PtrVec*
            {
                PtrVec* obj = this.eval(e.a, st);
                int n = bc_count(e, 0);
                int i;
                PtrVec* regs = pv_new();
                while (i < n)
                {
                    pv_push(regs, (void*)this.eval(node_child(e, 0, i), st));
                    i++;
                };
                this.mark_esc(obj, st);
                i = 0;
                while (i < regs.len) { this.mark_esc((PtrVec*)regs.items[i], st); i++; };
                -> lf_rs_new();
            };

            do_free(PtrVec* regs, LState* st, bool definite) -> void
            {
                bool single = regs.len == 1;
                PtrVec* hp = pv_new();
                bool allf, has_stat;
                int i, stat;
                byte* r;
                int* wp;
                PtrVec* det;
                while (i < regs.len)
                {
                    r = (byte*)regs.items[i];
                    if (r[0] == 'H' | r[0] == 'P')
                    {
                        if (!om_has(this.multi, r)) { pv_push(hp, (void*)r); };
                    };
                    i++;
                };
                if (hp.len > 0)
                {
                    allf = true;
                    i = 0;
                    while (i < hp.len)
                    {
                        if ((lf_flags(st.status, (byte*)hp.items[i]) `& 2) == 0) { allf = false; };
                        i++;
                    };
                };
                i = 0;
                {
                    PtrVec* fr = pv_new();
                    while (i < regs.len)
                    {
                        r = (byte*)regs.items[i];
                        if (r[0] == 'H' | r[0] == 'P') { pv_push(fr, (void*)r); };
                        i++;
                    };
                    this.access(this.roots_of(fr), 4, st, false, (byte*)0, (LRng*)0);
                };
                i = 0;
                while (i < regs.len)
                {
                    r = (byte*)regs.items[i];
                    i++;
                    if (r[0] == 'H' | r[0] == 'P')
                    {
                        if (om_has(this.multi, r)) { continue; };
                        has_stat = om_has(st.status, r);
                        stat = lf_flags(st.status, r);
                        if (r[0] == 'P' & !has_stat) { stat = 1; has_stat = true; };
                        if (has_stat & (stat `& 2) != 0 & allf)
                        {
                            det = pv_new();
                            if (om_has(st.free_at, r))
                            {
                                wp = (int*)om_get(st.free_at, r);
                                this.sb.clear();
                                this.sb.put_str(g"first ffree at \0");
                                this.sb.put_str(this.where(wp[0]));
                                pv_push(det, (void*)this.take());
                            };
                            this.sb.clear();
                            this.sb.put_str(f"allocation site '{this.rdesc(r)}' passed to ffree again\0");
                            if ((stat `& 3) != 2) { this.sb.put_str(g" (it may already have been freed)\0"); };
                            this.report(g"double_free\0", this.take(), this.cur_line, det);
                        };
                        if (definite & single) { om_put(st.status, r, (void*)bx_new(2)); }
                        else
                        {
                            if (single) { om_put(st.status, r, (void*)bx_new(stat `| 2)); }
                            else
                            {


                                om_put(st.status, r, (void*)bx_new(stat `| 4));
                                continue;
                            };
                        };
                        om_put(st.free_at, r, (void*)bx_new(this.cur_line));
                        continue;
                    };
                    if (r[0] == 'S' | r[0] == 'D')
                    {
                        this.sb.clear();
                        this.sb.put_str(f"ffree called on stack address '{this.rdesc(r)}'\0");
                        this.report(g"invalid_free\0", this.take(), this.cur_line, (PtrVec*)0);
                        continue;
                    };
                    if (r[0] == 'G')
                    {
                        this.sb.clear();
                        this.sb.put_str(f"ffree called on static address '{lf_seg(r, 1)}'\0");
                        this.report(g"invalid_free\0", this.take(), this.cur_line, (PtrVec*)0);
                    };
                };
                ->;
            };


            map_region(byte* r, byte* fname, LSumm* sm, PtrVec* arg_regs, int call_line, OMap* cache, LState* st) -> PtrVec*
            {
                PtrVec* out;
                byte* ns;
                int idx;
                if (om_has(cache, r)) { -> (PtrVec*)om_get(cache, r); };
                if (r[0] == 'P')
                {
                    idx = lf_atoi(lf_seg(r, 2));
                    out = lf_rs_new();
                    if (idx < arg_regs.len & cstr_eq(lf_seg(r, 1), fname))
                    {
                        out = (PtrVec*)arg_regs.items[idx];
                    };
                }
                else
                {
                    if (r[0] == 'H')
                    {
                        ns = lf_heap_c(this.fn, call_line, this.call_col, r);

                        if (om_has(sm.heap_status, r))
                        {
                            om_put(st.status, ns, om_get(sm.heap_status, r));
                            if (om_has(sm.esc, r)) { om_put(st.esc, ns, (void*)1); };
                            if (om_has(sm.free_at, r)) { om_put(st.free_at, ns, om_get(sm.free_at, r)); };
                        };
                        out = lf_rs_one(ns);
                    }
                    else
                    {
                        if (r[0] == 'S')
                        {
                            out = lf_rs_one(lf_dangling(lf_seg(r, 1), lf_seg(r, 2)));
                        }
                        else
                        {
                            out = lf_rs_one(r);
                        };
                    };
                };
                om_put(cache, r, (void*)out);
                -> out;
            };

            map_set(PtrVec* s, byte* fname, LSumm* sm, PtrVec* arg_regs, int call_line, OMap* cache, LState* st) -> PtrVec*
            {
                PtrVec* o = lf_rs_new();
                int i;
                while (i < s.len)
                {
                    o = lf_rs_union(o, this.map_region((byte*)s.items[i], fname, sm, arg_regs, call_line, cache, st));
                    i++;
                };
                -> o;
            };

            apply(byte* fname, PtrVec* arg_regs, LState* st) -> PtrVec*
            {
                LSumm* sm = this.summary(fname);
                int call_line = this.cur_line;
                OMap* cache = om_new();
                int i, j, fl, q;
                LHeld* lh;
                PtrVec* mapped, regs;
                byte* c, key;
                while (i < sm.wr.ks.len)
                {
                    key = (byte*)sm.wr.ks.items[i];
                    if (lf_atoi(key) < arg_regs.len) { this.note_write((PtrVec*)arg_regs.items[lf_atoi(key)]); };
                    i++;
                };
                i = 0;
                while (i < sm.nparams)
                {
                    key = lf_itoa(i);
                    if (om_has(sm.param_status, key))
                    {
                        fl = lf_flags(sm.param_status, key);
                        if ((fl `& 2) != 0 & i < arg_regs.len)
                        {
                            this.cur_line = call_line;
                            this.do_free((PtrVec*)arg_regs.items[i], st, fl == 2);
                            this.cur_line = call_line;
                        };
                    };
                    i++;
                };
                j = 0;
                while (j < sm.param_held.len)
                {
                    lh = (LHeld*)sm.param_held.items[j];
                    j++;
                    if (lh.idx >= arg_regs.len) { continue; };
                    mapped = this.map_set(lh.regs, fname, sm, arg_regs, call_line, cache, st);
                    regs = (PtrVec*)arg_regs.items[lh.idx];
                    i = 0;
                    while (i < regs.len)
                    {
                        c = (byte*)regs.items[i];
                        q = 0;
                        while (q < lh.path.len)
                        {
                            c = lf_fld(c, (byte*)lh.path.items[q]);
                            q++;
                        };
                        if (om_has(st.held, c))
                        {
                            om_put(st.held, c, (void*)lf_rs_union((PtrVec*)om_get(st.held, c), mapped));
                        }
                        else
                        {
                            om_put(st.held, c, (void*)mapped);
                        };
                        i++;
                    };
                    this.mark_esc(mapped, st);
                };

                i = 0;
                while (i < sm.esc.ks.len)
                {
                    c = (byte*)sm.esc.ks.items[i];
                    i++;
                    if (c[0] != 'P') { continue; };
                    if (!cstr_eq(lf_seg(c, 1), fname)) { continue; };
                    if (lf_atoi(lf_seg(c, 2)) < arg_regs.len)
                    {
                        this.mark_esc((PtrVec*)arg_regs.items[lf_atoi(lf_seg(c, 2))], st);
                    };
                };
                -> this.map_set(sm.ret, fname, sm, arg_regs, call_line, cache, st);
            };
        };



        struct BcOwners
        {
            NameMap* full;      
            NameMap* bare;      
        };

        def bc_owner_of(BcOwners* o, byte* fn) -> byte*
        {
            if (fn == (byte*)0) { return (byte*)0; };
            if (fn[0] == 0) { return (byte*)0; };
            if (nm_has(o.full, fn)) { return (byte*)nm_get(o.full, fn); };
            byte* b = bc_last_seg(fn);
            byte* r = (byte*)0;
            if (nm_has(o.bare, b)) { r = (byte*)nm_get(o.bare, b); };
            ffree(b);
            return r;
        };


        def bc_owner_on(BcOwners* o, NameMap* on, byte* fn) -> bool
        {
            byte* m = bc_owner_of(o, fn);
            if (m == (byte*)0) { return true; };
            return nm_has(on, m);
        };

        def borrow_check_filtered(Node* prog, Preprocessor* pp, byte* entry, bool warn, BcOwners* owners, NameMap* on) -> int
        {
            CallGraph cg;
            cg.__init();
            defer cg.__exit();
            cg.collect(prog);
            BorrowChecker bc;
            bc.__init(@cg, entry, true, true, pp);
            defer bc.__exit();
            bc.run();

            LifeChecker lc;
            lc.__init(@cg, entry, pp, warn);
            defer lc.__exit();
            lc.run();
            PtrVec* all = pv_new();
            int vi;
            BVio* vv;
            while (vi < lc.violations.len) { pv_push(all, lc.violations.items[vi]); vi++; };
            vi = 0;
            while (vi < bc.violations.len)
            {
                vv = (BVio*)bc.violations.items[vi];
                if (!(cstr_eq(vv.kind, g"scope_escape\0") | cstr_eq(vv.kind, g"use_after_scope\0")
                      | cstr_eq(vv.kind, g"use_after_free\0") | cstr_eq(vv.kind, g"heap_leak\0") | cstr_eq(vv.kind, g"mutable_alias\0")))
                {
                    pv_push(all, (void*)vv);
                };
                vi++;
            };
            if (on != (NameMap*)0)
            {
                PtrVec* kept = pv_new();
                vi = 0;
                while (vi < all.len)
                {
                    vv = (BVio*)all.items[vi];
                    if (bc_owner_on(owners, on, vv.func)) { pv_push(kept, (void*)vv); };
                    vi++;
                };
                pv_free(all);
                all = kept;
            };
            bc_print_violations(all, warn);
            bc_print_summary(all, 1, bc.funcs_checked);
            int n = all.len;
            pv_free(all);
            return n;
        };

        def borrow_check_program(Node* prog, Preprocessor* pp, byte* entry, bool warn) -> int
        {
            return borrow_check_filtered(prog, pp, entry, warn, (BcOwners*)0, (NameMap*)0);
        };
    };
};




















































using IDEKA::lexer;
using IDEKA::preprocessor;
using IDEKA::ast;
using IDEKA::parser;
using IDEKA::types;
using IDEKA::borrow;

namespace IDEKA
{
    namespace asyncl
    {


        def al_stubs() -> byte*
        {
            return g"unsigned data{64} as u64;\nstruct Thread { byte[8] handle; int alive; };\nstruct Mutex { byte[64] storage; };\n\0";
        };

        def al_th() -> byte* -> g"standard::threading::\0";


        def al_roots() -> PtrVec*
        {
            PtrVec* r = pv_new();
            pv_push(r, (void*)g"standard__threading__thread_create\0");
            pv_push(r, (void*)g"standard__threading__thread_join\0");
            pv_push(r, (void*)g"standard__threading__mutex_init\0");
            pv_push(r, (void*)g"standard__threading__mutex_lock\0");
            pv_push(r, (void*)g"standard__threading__mutex_unlock\0");
            pv_push(r, (void*)g"standard__threading__Thread\0");
            pv_push(r, (void*)g"standard__threading__Mutex\0");
            pv_push(r, (void*)g"standard__memory__allocators__stdheap__fmalloc\0");
            pv_push(r, (void*)g"standard__memory__allocators__stdheap__ffree\0");
            return r;
        };







        def al_parse(byte* text, bool* ok) -> Node*
        {
            byte* src = ts_dup(text);
            int n;
            Node* prog;
            while (src[n] != 0) { n++; };
            Lexer lx(src, n);
            if (!lx.tokenize())
            {
                *ok = false;
                return (Node*)0;
            };
            Parser ps(@lx);
            ps.st = st_new();
            prog = ps.parse();
            if (ps.failed)
            {
                print(g"[ASYNC] internal error: synthetic code did not parse: \0");
                if (ps.err_msg != (byte*)0) { print(ps.err_msg); };
                println(g"\0");
                *ok = false;
                return (Node*)0;
            };
            return prog;
        };

        def al_unwrap(Node* n) -> Node*
        {
            if (n.kind == NodeKind.FUNCTION_DEF_STATEMENT) { return n.a; };
            if (n.kind == NodeKind.STRUCT_DEF_STATEMENT) { return n.a; };
            return n;
        };


        def al_body_of(Node* prog, byte* name) -> PtrVec*
        {
            int i, j;
            int c = node_count(prog, 0);
            Node* f;
            PtrVec* out;
            while (i < c)
            {
                f = al_unwrap(node_child(prog, 0, i));
                i++;
                if (f.kind == NodeKind.FUNCTION_DEF)
                {
                    if (cstr_eq(f.text, name))
                    {
                        out = pv_new();
                        j = 0;
                        while (j < node_count(f.a, 0))
                        {
                            pv_push(out, (void*)node_child(f.a, 0, j));
                            j++;
                        };
                        return out;
                    };
                };
            };
            return (PtrVec*)0;
        };

        def al_cat(PtrVec* a, PtrVec* b) -> PtrVec*
        {
            PtrVec* r = pv_new();
            int i;
            while (i < a.len) { pv_push(r, a.items[i]); i++; };
            i = 0;
            while (i < b.len) { pv_push(r, b.items[i]); i++; };
            return r;
        };


        def al_set_list(Node* n, int s, PtrVec* items) -> void
        {
            int i;
            NodeVec* v = node_list(n, s);
            v.len = 0;
            while (i < items.len)
            {
                node_push(n, s, (Node*)items.items[i]);
                i++;
            };
            return;
        };

        def al_block_items(Node* b) -> PtrVec*
        {
            PtrVec* r = pv_new();
            int i;
            int c = node_count(b, 0);
            while (i < c)
            {
                pv_push(r, (void*)node_child(b, 0, i));
                i++;
            };
            return r;
        };


        def al_is_block(Node* n) -> bool -> n.kind == NodeKind.BLOCK;


        def al_mentions(Node* n, byte* name) -> bool
        {
            int s, c, i;
            if (n == (Node*)0) { return false; };
            if (n.kind == NodeKind.IDENTIFIER)
            {
                if (cstr_eq(n.text, name)) { return true; };
            };
            if (al_mentions(n.a, name)) { return true; };
            if (al_mentions(n.b, name)) { return true; };
            if (al_mentions(n.c, name)) { return true; };
            if (al_mentions(n.d, name)) { return true; };
            if (al_mentions(n.e, name)) { return true; };
            while (s < 6)
            {
                c = node_count(n, s);
                i = 0;
                while (i < c)
                {
                    if (al_mentions(node_child(n, s, i), name)) { return true; };
                    i++;
                };
                s++;
            };
            return false;
        };


        def al_shallow_calls(Node* n, PtrVec* out) -> void
        {
            int s, c, i;
            if (n == (Node*)0) { return; };
            if (n.kind == NodeKind.FUNCTION_CALL) { pv_push(out, (void*)n); };
            if (n.a != (Node*)0) { if (!al_is_block(n.a)) { al_shallow_calls(n.a, out); }; };
            if (n.b != (Node*)0) { if (!al_is_block(n.b)) { al_shallow_calls(n.b, out); }; };
            if (n.c != (Node*)0) { if (!al_is_block(n.c)) { al_shallow_calls(n.c, out); }; };
            if (n.d != (Node*)0) { if (!al_is_block(n.d)) { al_shallow_calls(n.d, out); }; };
            if (n.e != (Node*)0) { if (!al_is_block(n.e)) { al_shallow_calls(n.e, out); }; };
            while (s < 6)
            {
                c = node_count(n, s);
                i = 0;
                while (i < c)
                {
                    if (!al_is_block(node_child(n, s, i))) { al_shallow_calls(node_child(n, s, i), out); };
                    i++;
                };
                s++;
            };
            return;
        };

        def al_str_lt(byte* a, byte* b) -> bool
        {
            int i;
            while (a[i] != 0 & b[i] != 0)
            {
                if (a[i] != b[i]) { return a[i] < b[i]; };
                i++;
            };
            return a[i] < b[i];
        };

        def al_sort(PtrVec* v) -> void
        {
            int i = 1;
            int j;
            void* t;
            while (i < v.len)
            {
                j = i;
                while (j > 0)
                {
                    if (!al_str_lt((byte*)v.items[j], (byte*)v.items[j - 1])) { break; };
                    t = v.items[j];
                    v.items[j] = v.items[j - 1];
                    v.items[j - 1] = t;
                    j--;
                };
                i++;
            };
            return;
        };




        def al_relines(Node* n, int line) -> void
        {
            int s, c, i;
            if (n == (Node*)0) { return; };
            n.line = line;
            al_relines(n.a, line);
            al_relines(n.b, line);
            al_relines(n.c, line);
            al_relines(n.d, line);
            al_relines(n.e, line);
            while (s < 6)
            {
                c = node_count(n, s);
                i = 0;
                while (i < c)
                {
                    al_relines(node_child(n, s, i), line);
                    i++;
                };
                s++;
            };
            return;
        };


        def al_pair_half(byte* key, int which, int sep) -> byte*
        {
            int n;
            byte* r;
            if (which == 0)
            {
                r = (byte*)fmalloc((u64)(sep + 1));
                while (n < sep) { r[n] = key[n]; n++; };
                r[sep] = (byte)0;
                return r;
            };
            return ts_dup(key + sep + 1);
        };





        struct AlTask
        {
            byte* fv;           
            byte* rv;           
            byte* sname;
            bool joined_at_use;
        };

        struct AlFrame
        {
            byte* sname, tname;
            bool has_ret;
        };

        object AsyncLowering
        {
            Node* program;
            CallGraph* cg;
            LifeChecker* life;
            OMap* tasks;        
            OMap* frames;       
            int counter, launched, nstub;
            bool failed;
            Buf tb;

            __init(Node* prog, CallGraph* g, LifeChecker* lc) -> this
            {
                bool ok = true;
                Node* sp;
                this.program = prog;
                this.cg = g;
                this.life = lc;
                this.tasks = om_new();
                this.frames = om_new();
                this.counter = 0;
                this.launched = 0;
                this.failed = false;
                this.tb.__init();
                sp = al_parse(al_stubs(), @ok);
                this.nstub = node_count(sp, 0);
                -> this;
            };

            __expr() -> AsyncLowering* -> this;

            __exit() -> void
            {
                -> this.tb.__exit();
            };

            is_ok(Node* call) -> bool
            {
                byte* k = lf_addr_key((void*)call);
                return om_has(this.life.async_launched, k) & !om_has(this.life.async_seq, k);
            };

            any_ok() -> bool
            {
                int i;
                while (i < this.life.async_launched.ks.len)
                {
                    if (!om_has(this.life.async_seq, (byte*)this.life.async_launched.ks.items[i])) { return true; };
                    i++;
                };
                return false;
            };


            parse_body(byte* text, byte* fname, int line) -> PtrVec*
            {
                bool ok = true;
                Node* prog = al_parse(text, @ok);
                PtrVec* b;
                if (!ok) { this.failed = true; return pv_new(); };
                al_relines(prog, line);
                b = al_body_of(prog, fname);
                if (b == (PtrVec*)0)
                {
                    print(g"[ASYNC] internal error: synthetic function '\0");
                    print(fname);
                    println(g"' was not produced\0");
                    this.failed = true;
                    return pv_new();
                };
                return b;
            };

            run() -> int
            {
                int i;
                bool has_thread;
                int c = node_count(this.program, 0);
                Node* s, fd;
                PtrVec* keys = pv_new();
                if (this.failed) { return -1; };
                i = 0;
                while (i < c)
                {
                    s = al_unwrap(node_child(this.program, 0, i));
                    i++;
                    if (s.kind == NodeKind.STRUCT_DEF)
                    {
                        if (cstr_eq(s.text, g"Thread\0")) { has_thread = true; };
                    };
                };
                if (!has_thread)
                {
                    if (this.any_ok() | this.groups().len > 0)
                    {
                        println(g"[ASYNC] error: async lowering needs the threading library; add #import <threading.idk>;\0");
                        return -1;
                    };
                };
                i = 0;
                while (i < this.life.summaries.count)
                {
                    if (this.life.summaries.vals[i] != (void*)0) { pv_push(keys, (void*)this.life.summaries.keys[i]); };
                    i++;
                };
                al_sort(keys);
                i = 0;
                while (i < keys.len)
                {
                    fd = (Node*)nm_get(this.cg.funcs, (byte*)keys.items[i]);
                    i++;
                    if (fd != (Node*)0)
                    {
                        if (fd.a != (Node*)0)
                        {
                            if (fd.a.kind == NodeKind.BLOCK) { this.block(fd.a); };
                        };
                    };
                };
                if (!this.mutexes()) { return -1; };
                if (this.failed) { return -1; };
                return this.launched;
            };



            frame(byte* key, byte* callee_name) -> AlFrame*
            {
                AlFrame* fr = (AlFrame*)om_get(this.frames, key);
                Node* fd, prog, sdef, tramp, st_, m, fn_;
                int np, i, n, c;
                bool has_ret;
                bool ok = true;
                byte* sname, tname;
                if (fr != (AlFrame*)0) { return fr; };
                fd = (Node*)nm_get(this.cg.funcs, key);
                n = this.frames.ks.len;
                np = node_count(fd, 0);
                has_ret = true;
                if (fd.ts.base_type == DataType.VOID & !bc_is_pointer_type(fd.ts)) { has_ret = false; };

                this.tb.clear();
                this.tb.put_str(f"{al_stubs()}struct __af_{n}\0");
                this.tb.put_str(g" { \0");
                i = 0;
                while (i < np)
                {
                    this.tb.put_str(f"int a{i}; \0");
                    i++;
                };
                if (has_ret) { this.tb.put_str(g"int r; \0"); };
                this.tb.put_str(g"int joined; Thread th; };\ndef __af_\0");
                this.tb.put_int(n);
                this.tb.put_str(g"_run(void* p) -> void*\n{\n    __af_\0");
                this.tb.put_str(f"{n}* fr = (__af_{n}*)p;\n    \0");
                if (has_ret) { this.tb.put_str(g"fr.r = \0"); };
                this.tb.put_str(f"{callee_name}(\0");
                i = 0;
                while (i < np)
                {
                    if (i > 0) { this.tb.put_str(g", \0"); };
                    this.tb.put_str(f"fr.a{i}\0");
                    i++;
                };
                this.tb.put_str(g");\n    return (void*)0;\n};\n\0");
                prog = al_parse(this.tb.mem, @ok);
                if (!ok) { this.failed = true; return (AlFrame*)0; };
                al_relines(prog, fd.line);
                this.tb.clear();
                this.tb.put_str(f"__af_{n}\0");
                sname = ts_dup(this.tb.mem);
                this.tb.put_str(g"_run\0");
                tname = ts_dup(this.tb.mem);
                sdef = (Node*)0;
                tramp = (Node*)0;
                c = node_count(prog, 0);
                i = 0;
                while (i < c)
                {
                    st_ = node_child(prog, 0, i);
                    fn_ = al_unwrap(st_);
                    i++;
                    if (fn_.kind == NodeKind.STRUCT_DEF)
                    {
                        if (cstr_eq(fn_.text, sname)) { sdef = st_; };
                    };
                    if (fn_.kind == NodeKind.FUNCTION_DEF)
                    {
                        if (cstr_eq(fn_.text, tname)) { tramp = st_; };
                    };
                };
                if (sdef == (Node*)0 | tramp == (Node*)0)
                {
                    print(g"[ASYNC] internal error: trampoline '\0");
                    print(tname);
                    println(g"' was not produced\0");
                    this.failed = true;
                    return (AlFrame*)0;
                };

                c = node_count(al_unwrap(sdef), 0);
                i = 0;
                while (i < c)
                {
                    m = node_child(al_unwrap(sdef), 0, i);
                    i++;
                    if (m.text[0] == 'a' & m.text[1] >= '0' & m.text[1] <= '9')
                    {
                        m.ts = typespec_copy(node_child(fd, 0, lf_atoi(m.text + 1)).ts);
                    };
                    if (m.text[0] == 'r' & m.text[1] == 0)
                    {
                        m.ts = typespec_copy(fd.ts);
                    };
                };
                if (!this.insert_after_decl(callee_name, sdef, tramp)) { this.failed = true; return (AlFrame*)0; };
                fr = (AlFrame*)fmalloc((u64)((sizeof(AlFrame) + 7) / 8));
                fr
                {
                    .sname = sname;
                    .tname = tname;
                    .has_ret = has_ret;
                };
                om_put(this.frames, key, (void*)fr);
                return fr;
            };

            insert_after_decl(byte* fname, Node* a, Node* b) -> bool
            {
                int c = node_count(this.program, 0);
                int i, j;
                Node* f;
                NodeVec* v;
                while (i < c)
                {
                    f = al_unwrap(node_child(this.program, 0, i));
                    if (f.kind == NodeKind.FUNCTION_DEF)
                    {
                        if (cstr_eq(f.text, fname))
                        {
                            node_push(this.program, 0, a);
                            node_push(this.program, 0, b);
                            v = this.program.l0;
                            j = v.len - 1;
                            while (j > i + 2)
                            {
                                v.items[j] = v.items[j - 2];
                                j--;
                            };
                            v.items[i + 1] = a;
                            v.items[i + 2] = b;
                            return true;
                        };
                    };
                    i++;
                };
                print(g"[ASYNC] internal error: declaration of '\0");
                print(fname);
                println(g"' not found\0");
                return false;
            };




            launch_of(Node* s, int* kind) -> Node*
            {
                Node* e;
                if (s.kind == NodeKind.EXPRESSION_STATEMENT)
                {
                    e = s.a;
                    if (e.kind == NodeKind.FUNCTION_CALL) { *kind = 1; return e; };
                    if (e.kind == NodeKind.ASSIGNMENT)
                    {
                        if (e.a.kind == NodeKind.IDENTIFIER & e.b.kind == NodeKind.FUNCTION_CALL)
                        {
                            *kind = 3;
                            return e.b;
                        };
                    };
                };
                if (s.kind == NodeKind.VARIABLE_DECLARATION)
                {
                    if (s.a != (Node*)0)
                    {
                        if (s.a.kind == NodeKind.FUNCTION_CALL)
                        {
                            if (s.ts == (TypeSpec*)0) { *kind = 2; return s.a; };
                            if ((s.ts.flags `& 32) == 0) { *kind = 2; return s.a; };
                        };
                    };
                };
                if (s.kind == NodeKind.ASSIGNMENT)
                {
                    if (s.a.kind == NodeKind.IDENTIFIER & s.b.kind == NodeKind.FUNCTION_CALL)
                    {
                        *kind = 3;
                        return s.b;
                    };
                };
                return (Node*)0;
            };

            lowerable(Node* call) -> byte*
            {
                byte* key;
                Node* fd;
                if (!this.is_ok(call)) { return (byte*)0; };
                if (call.text == (byte*)0) { return (byte*)0; };
                key = (byte*)om_get(this.life.async_target, lf_addr_key((void*)call));
                if (key == (byte*)0) { return (byte*)0; };
                if (!nm_has(this.life.summaries, key)) { return (byte*)0; };
                if (!cstr_eq(key, call.text)) { return (byte*)0; };
                fd = (Node*)nm_get(this.cg.funcs, key);
                if (fd == (Node*)0) { return (byte*)0; };
                if ((fd.flags `& 2048) != 0) { return (byte*)0; };
                if (fd.text2 != (byte*)0)
                {
                    if (fd.text2[0] != 0) { return (byte*)0; };
                };
                if (fd.ts2 != (TypeSpec*)0) { return (byte*)0; };
                if (node_count(call, 0) != node_count(fd, 0)) { return (byte*)0; };
                return key;
            };


            join(AlTask* t, int line) -> PtrVec*
            {
                this.tb.clear();
                this.tb.put_str(al_stubs());
                this.tb.put_str(g"def __tj() -> void { if (\0");
                this.tb.put_str(t.fv);
                this.tb.put_str(g".joined == 0) { \0");
                this.tb.put_str(f"{al_th()}thread_join(@{t.fv}.th); \0");
                if (t.rv != (byte*)0)
                {
                    this.tb.put_str(f"{t.rv} = {t.fv}.r; \0");
                };
                this.tb.put_str(t.fv);
                this.tb.put_str(g".joined = 1; }; };\n\0");
                return this.parse_body(this.tb.mem, g"__tj\0", line);
            };

            block(Node* blk) -> void
            {
                PtrVec* old = al_block_items(blk);
                PtrVec* fresh = pv_new();
                PtrVec* pending = pv_new();
                PtrVec* pre, calls, stmts, waits;
                int si, i, j, kind;
                Node* s, call;
                byte* key;
                AlTask* t, u;
                while (si < old.len)
                {
                    s = (Node*)old.items[si];
                    si++;
                    if (s == (Node*)0) { pv_push(fresh, (void*)s); continue; };
                    pre = pv_new();
                    i = 0;
                    while (i < pending.len)
                    {
                        t = (AlTask*)pending.items[i];
                        i++;
                        if (t.rv != (byte*)0 & !t.joined_at_use)
                        {
                            if (al_mentions(s, t.rv))
                            {
                                pre = al_cat(pre, this.join(t, s.line));
                                t.joined_at_use = true;
                            };
                        };
                    };
                    calls = pv_new();
                    al_shallow_calls(s, calls);
                    i = 0;
                    while (i < calls.len)
                    {
                        call = (Node*)calls.items[i];
                        i++;
                        waits = (PtrVec*)om_get(this.life.async_waits, lf_addr_key((void*)call));
                        if (waits != (PtrVec*)0)
                        {
                            j = 0;
                            while (j < waits.len)
                            {
                                u = (AlTask*)om_get(this.tasks, (byte*)waits.items[j]);
                                j++;
                                if (u != (AlTask*)0) { pre = al_cat(pre, this.join(u, s.line)); };
                            };
                        };
                    };
                    kind = 0;
                    call = this.launch_of(s, @kind);
                    key = (byte*)0;
                    if (call != (Node*)0) { key = this.lowerable(call); };
                    if (key != (byte*)0)
                    {
                        stmts = pv_new();
                        t = this.launch(s, call, kind, key, stmts);
                        if (t == (AlTask*)0) { return; };
                        om_put(this.tasks, lf_addr_key((void*)call), (void*)t);
                        pv_push(pending, (void*)t);
                        fresh = al_cat(fresh, al_cat(pre, stmts));
                        this.launched++;
                    }
                    else
                    {
                        fresh = al_cat(fresh, pre);
                        pv_push(fresh, (void*)s);
                        this.descend_children(s);
                    };
                };
                al_set_list(blk, 0, fresh);
                return;
            };

            descend_children(Node* n) -> void
            {
                int s, c, i;
                if (n.a != (Node*)0) { this.descend(n.a); };
                if (n.b != (Node*)0) { this.descend(n.b); };
                if (n.c != (Node*)0) { this.descend(n.c); };
                if (n.d != (Node*)0) { this.descend(n.d); };
                if (n.e != (Node*)0) { this.descend(n.e); };
                while (s < 6)
                {
                    c = node_count(n, s);
                    i = 0;
                    while (i < c)
                    {
                        this.descend(node_child(n, s, i));
                        i++;
                    };
                    s++;
                };
                return;
            };

            descend(Node* n) -> void
            {
                if (n == (Node*)0) { return; };
                if (n.kind == NodeKind.BLOCK)
                {
                    this.block(n);
                    return;
                };
                this.descend_children(n);
                return;
            };


            launch(Node* s, Node* call, int kind, byte* key, PtrVec* out) -> AlTask*
            {
                AlFrame* fr = this.frame(key, call.text);
                AlTask* task;
                PtrVec* body, fs;
                byte* fv, rv;
                Node* tgt, st_, asg, defer_;
                int n = node_count(call, 0);
                int i;
                if (fr == (AlFrame*)0) { return (AlTask*)0; };
                this.counter++;
                this.tb.clear();
                this.tb.put_str(f"__at{this.counter}\0");
                fv = ts_dup(this.tb.mem);
                if (kind == 2)
                {
                    rv = s.text;
                    s.a = (Node*)0;
                    pv_push(out, (void*)s);
                };
                if (kind == 3)
                {
                    tgt = s.a;
                    if (s.kind == NodeKind.EXPRESSION_STATEMENT) { tgt = s.a.a; };
                    rv = tgt.text;
                };
                if (rv != (byte*)0 & !fr.has_ret) { rv = (byte*)0; };

                this.tb.clear();
                this.tb.put_str(f"{al_stubs()}struct {fr.sname}\0");
                this.tb.put_str(g" { int joined; Thread th; };\ndef __tl() -> void\n{\n    \0");
                this.tb.put_str(f"{fr.sname}* {fv} = ({fr.sname}*)fmalloc((u64)((sizeof({fr.sname}) + 7) / 8));\n    {fv}.joined = 0;\n\0");
                i = 0;
                while (i < n)
                {
                    this.tb.put_str(f"    {fv}.a{i} = 0;\n\0");
                    i++;
                };
                this.tb.put_str(f"    {al_th()}thread_create(@{fr.tname}, (void*){fv}, @{fv}\0");
                this.tb.put_str(g".th);\n    defer { __DEFER__; };\n};\n\0");
                body = this.parse_body(this.tb.mem, g"__tl\0", s.line);
                if (this.failed) { return (AlTask*)0; };

                i = 0;
                while (i < n)
                {
                    st_ = (Node*)body.items[2 + i];
                    asg = st_;
                    if (st_.kind == NodeKind.EXPRESSION_STATEMENT) { asg = st_.a; };
                    asg.b = node_child(call, 0, i);
                    i++;
                };
                defer_ = (Node*)body.items[body.len - 1];
                task = (AlTask*)fmalloc((u64)((sizeof(AlTask) + 7) / 8));
                task
                {
                    .fv = fv;
                    .rv = rv;
                    .sname = fr.sname;
                    .joined_at_use = false;
                };
                this.tb.clear();
                this.tb.put_str(al_stubs());
                this.tb.put_str(g"def __tf() -> void { ffree((u64)\0");
                this.tb.put_str(fv);
                this.tb.put_str(g"); };\n\0");
                fs = this.parse_body(this.tb.mem, g"__tf\0", s.line);
                if (this.failed) { return (AlTask*)0; };
                al_set_list(defer_, 0, al_cat(fs, this.join(task, s.line)));
                i = 0;
                while (i < body.len) { pv_push(out, body.items[i]); i++; };
                return task;
            };



            uf_find(OMap* parent, byte* x) -> byte*
            {
                byte* p;
                byte* cur = x;
                if (!om_has(parent, cur)) { om_put(parent, cur, (void*)cur); };
                p = (byte*)om_get(parent, cur);
                while (!cstr_eq(p, cur))
                {
                    cur = p;
                    p = (byte*)om_get(parent, cur);
                };
                return cur;
            };


            groups() -> PtrVec*
            {
                OMap* parent = om_new();
                OMap* bucket = om_new();
                PtrVec* out = pv_new();
                int i, sep;
                byte* a, b, key, r;
                PtrVec* lst;
                int* bits;
                OMap* rel = this.life.rel;
                while (i < rel.ks.len)
                {
                    key = (byte*)rel.ks.items[i];
                    bits = (int*)rel.vs.items[i];
                    i++;
                    if ((bits[0] `& 8) == 0) { continue; };
                    sep = 0;
                    while (key[sep] != 0 & key[sep] != 31) { sep++; };
                    a = al_pair_half(key, 0, sep);
                    b = al_pair_half(key, 1, sep);
                    if (!nm_has(this.cg.funcs, a) | !nm_has(this.cg.funcs, b)) { continue; };
                    r = this.uf_find(parent, b);
                    om_put(parent, this.uf_find(parent, a), (void*)r);
                };
                i = 0;
                while (i < parent.ks.len)
                {
                    r = this.uf_find(parent, (byte*)parent.ks.items[i]);
                    lst = (PtrVec*)om_get(bucket, r);
                    if (lst == (PtrVec*)0)
                    {
                        lst = pv_new();
                        om_put(bucket, r, (void*)lst);
                        pv_push(out, (void*)lst);
                    };
                    pv_push(lst, parent.ks.items[i]);
                    i++;
                };
                i = 0;
                while (i < out.len)
                {
                    al_sort((PtrVec*)out.items[i]);
                    i++;
                };
                return out;
            };

            mutexes() -> bool
            {
                PtrVec* grps = this.groups();
                PtrVec* decls = pv_new();
                PtrVec* inits = pv_new();
                PtrVec* members, lock;
                int gi, at, i, k, c, pos, pass;
                Node* s, fd, prog;
                bool ok = true;
                byte* m, nm_;
                bool placed;
                int mline = 1;
                int eline = 1;
                if (grps.len == 0) { return true; };
                c = node_count(this.program, 0);
                i = 0;
                while (i < c)
                {
                    s = al_unwrap(node_child(this.program, 0, i));
                    if (s.kind == NodeKind.STRUCT_DEF)
                    {
                        if (cstr_eq(s.text, g"Mutex\0")) { at = i + 1; mline = s.line; };
                    };
                    i++;
                };
                while (gi < grps.len)
                {
                    members = (PtrVec*)grps.items[gi];
                    this.tb.clear();
                    this.tb.put_str(f"__am_{gi}\0");
                    m = ts_dup(this.tb.mem);

                    this.tb.clear();
                    this.tb.put_str(f"{al_stubs()}Mutex {m};\n\0");
                    prog = al_parse(this.tb.mem, @ok);
                    if (!ok) { return false; };
                    al_relines(prog, mline);
                    i = this.nstub;
                    while (i < node_count(prog, 0))
                    {
                        pv_push(decls, (void*)node_child(prog, 0, i));
                        i++;
                    };

                    this.tb.clear();
                    this.tb.put_str(al_stubs());
                    this.tb.put_str(g"def __ti() -> void { \0");
                    this.tb.put_str(f"{al_th()}mutex_init(@{m}\0");
                    this.tb.put_str(g"); };\n\0");
                    inits = al_cat(inits, this.parse_body(this.tb.mem, g"__ti\0", eline));
                    k = 0;
                    while (k < members.len)
                    {
                        fd = (Node*)nm_get(this.cg.funcs, (byte*)members.items[k]);
                        k++;
                        if (fd == (Node*)0) { continue; };
                        if (fd.a == (Node*)0) { continue; };
                        this.tb.clear();
                        this.tb.put_str(al_stubs());
                        this.tb.put_str(g"def __tk() -> void { \0");
                        this.tb.put_str(f"{al_th()}mutex_lock(@{m}); defer {al_th()}mutex_unlock(@{m}\0");
                        this.tb.put_str(g"); };\n\0");
                        lock = this.parse_body(this.tb.mem, g"__tk\0", fd.line);
                        if (this.failed) { return false; };
                        al_set_list(fd.a, 0, al_cat(lock, al_block_items(fd.a)));
                    };
                    gi++;
                };

                {
                    NodeVec* v;
                    int n0 = node_count(this.program, 0);
                    int d;
                    d = 0;
                    while (d < decls.len)
                    {
                        node_push(this.program, 0, (Node*)decls.items[d]);
                        d++;
                    };
                    v = this.program.l0;

                    {
                        int j = n0 - 1;
                        while (j >= at)
                        {
                            v.items[j + decls.len] = v.items[j];
                            j--;
                        };
                        d = 0;
                        while (d < decls.len)
                        {
                            v.items[at + d] = (Node*)decls.items[d];
                            d++;
                        };
                    };
                };



                pass = 0;
                while (pass < 2 & !placed)
                {
                    nm_ = this.life.entry;
                    if (pass == 1) { nm_ = g"main\0"; };
                    pass++;
                    fd = (Node*)nm_get(this.cg.funcs, nm_);
                    if (fd == (Node*)0) { continue; };
                    if (fd.a == (Node*)0) { continue; };
                    pos = -1;
                    i = 0;
                    c = node_count(this.program, 0);
                    while (i < c)
                    {
                        if (al_unwrap(node_child(this.program, 0, i)) == fd) { pos = i; };
                        i++;
                    };
                    if (pos >= 0 & pos >= at + decls.len)
                    {
                        i = 0;
                        while (i < inits.len)
                        {
                            al_relines((Node*)inits.items[i], fd.line);
                            i++;
                        };
                        al_set_list(fd.a, 0, al_cat(inits, al_block_items(fd.a)));
                        placed = true;
                    };
                };
                if (!placed)
                {
                    println(g"[ASYNC] error: cannot place mutex initialisation: no entry function is declared after the threading library\0");
                    return false;
                };
                return true;
            };
        };



        def lower_program(Node* prog, byte* entry, Preprocessor* pp, bool report) -> int
        {
            CallGraph cg;
            cg.__init();
            defer cg.__exit();
            cg.collect(prog);
            if (cg.async_names.count == 0) { return 0; };
            LifeChecker lc;
            lc.__init(@cg, entry, pp, true);
            defer lc.__exit();
            lc.run();
            PtrVec* mine = pv_new();
            PtrVec* fatal = pv_new();
            defer pv_free(mine);
            defer pv_free(fatal);
            int i;
            BVio* v;
            while (i < lc.violations.len)
            {
                v = (BVio*)lc.violations.items[i];
                if (bc_starts(v.kind, g"async_\0")) { pv_push(mine, (void*)v); };
                if (cstr_eq(v.kind, g"async_contradiction\0")) { pv_push(fatal, (void*)v); };
                i++;
            };
            if (report & mine.len > 0) { bc_print_violations(mine, true); };
            if (fatal.len > 0)
            {
                if (!report) { bc_print_violations(fatal, true); };
                return -1;
            };
            AsyncLowering al(prog, @cg, @lc);
            defer al.__exit();
            return al.run();
        };


        def program_has_async(Node* prog) -> bool
        {
            CallGraph cg;
            cg.__init();
            cg.collect(prog);
            return cg.async_names.count > 0;
        };
    };
};


































using IDEKA::ast;
using IDEKA::preprocessor;
using IDEKA::types;
using IDEKA::borrow;

namespace IDEKA
{
    namespace effects
    {




        struct EEntry
        {
            byte* name;
            bool impl, req, excl, weak, atten, one, supp, cprop;
        };

        def ee_new(byte* name, bool atten) -> EEntry*
        {
            EEntry* e = (EEntry*)fmalloc((u64)((sizeof(EEntry) + 7) / 8));
            e.name = name;
            e.impl = false;
            e.req = false;
            e.excl = false;
            e.weak = false;
            e.atten = atten;
            e.one = false;
            e.supp = false;
            e.cprop = false;
            return e;
        };


        def es_new() -> OMap* -> om_new();

        def es_add(OMap* s, EEntry* e) -> void
        {
            EEntry* ex = (EEntry*)om_get(s, e.name);
            if (ex == (EEntry*)0)
            {
                om_put(s, e.name, (void*)e);
                return;
            };
            ex.impl = ex.impl | e.impl;
            ex.req = ex.req | e.req;
            ex.excl = ex.excl | e.excl;
            ex.weak = ex.weak | e.weak;
            if (!e.atten) { ex.atten = false; };
            ex.one = ex.one | e.one;
            ex.supp = ex.supp | e.supp;
            ex.cprop = ex.cprop | e.cprop;
            return;
        };

        def es_copy(OMap* s) -> OMap*
        {
            OMap* r = es_new();
            EEntry* e;
            EEntry* n;
            int i = 0;
            while (i < s.ks.len)
            {
                e = (EEntry*)s.vs.items[i];
                n = ee_new(e.name, e.atten);
                n.impl = e.impl;
                n.req = e.req;
                n.excl = e.excl;
                n.weak = e.weak;
                n.one = e.one;
                n.supp = e.supp;
                n.cprop = e.cprop;
                om_put(r, n.name, (void*)n);
                i++;
            };
            return r;
        };

        def es_has(OMap* s, byte* name) -> bool -> om_has(s, name);


        def es_free(OMap* s) -> void
        {
            int i = 0;
            while (i < s.vs.len)
            {
                ffree((byte*)s.vs.items[i]);
                i++;
            };
            om_free(s);
            return;
        };


        def es_merge(OMap* a, OMap* b) -> void
        {
            int i = 0;
            while (i < b.ks.len)
            {
                es_add(a, (EEntry*)b.vs.items[i]);
                i++;
            };
            return;
        };





        def ss_new() -> OMap* -> om_new();

        def ss_add(OMap* s, byte* k) -> void
        {
            if (!om_has(s, k)) { om_put(s, k, (void*)1); };
            return;
        };

        def ss_has(OMap* s, byte* k) -> bool -> om_has(s, k);

        def ss_len(OMap* s) -> int -> s.ks.len;

        def ss_key(OMap* s, int i) -> byte* -> (byte*)s.ks.items[i];

        def ss_copy(OMap* s) -> OMap*
        {
            OMap* r = ss_new();
            int i = 0;
            while (i < s.ks.len)
            {
                ss_add(r, (byte*)s.ks.items[i]);
                i++;
            };
            return r;
        };





        def ef_prefix_dup(byte* s, int n) -> byte*
        {
            byte* r = (byte*)fmalloc((u64)(n + 1));
            int i = 0;
            while (i < n)
            {
                r[i] = s[i];
                i++;
            };
            r[n] = (byte)0;
            return r;
        };


        def ef_last_dot(byte* s, int len) -> int
        {
            int j = len - 1;
            while (j >= 0)
            {
                if (s[j] == '.') { return j; };
                j--;
            };
            return -1;
        };


        def ef_prefix_eq(byte* s, int n, byte* t) -> bool
        {
            int i = 0;
            while (i < n)
            {
                if (t[i] == 0) { return false; };
                if (s[i] != t[i]) { return false; };
                i++;
            };
            return t[n] == 0;
        };


        def ef_dotted_anc_eq(byte* v, byte* anc) -> bool
        {
            int len = bc_len(v);
            int j;
            while (true)
            {
                j = ef_last_dot(v, len);
                if (j < 0) { return false; };
                len = j;
                if (ef_prefix_eq(v, len, anc)) { return true; };
            };
            return false;
        };


        def ef_starts_dotted(byte* s, byte* p) -> bool
        {
            int n = bc_len(p);
            int i = 0;
            while (i < n)
            {
                if (s[i] != p[i]) { return false; };
                i++;
            };
            return s[n] == '.';
        };


        def ef_rsplit_last(byte* s) -> byte*
        {
            int n = bc_len(s);
            int j = n - 2;
            while (j >= 0)
            {
                if (s[j] == '_' & s[j + 1] == '_') { return ts_dup(s + j + 2); };
                j--;
            };
            return ts_dup(s);
        };


        def ef_split(byte* list) -> PtrVec*
        {
            PtrVec* v = pv_new();
            int i = 0;
            int st = 0;
            while (true)
            {
                if (list[i] == ' ' | list[i] == 0)
                {
                    if (i > st) { pv_push(v, (void*)ef_prefix_dup(list + st, i - st)); };
                    st = i + 1;
                    if (list[i] == 0) { break; };
                };
                i++;
            };
            return v;
        };





        struct EReg
        {
            OMap* user;            
            OMap* cache;           
            OMap* fe;              
            OMap* ia;              
            NameMap* children;     
            NameMap* parent;       
            NameMap* perm;         
            NameMap* implies;      
            OMap* builtins;        
            int depth;
            bool failed;
        };

        def er_hier(EReg* r, byte* parent, byte* kids) -> void
        {
            PtrVec* v = ef_split(kids);
            int i = 0;
            nm_put(r.children, parent, (void*)v);
            ss_add(r.builtins, parent);
            while (i < v.len)
            {
                nm_put(r.parent, (byte*)v.items[i], (void*)parent);
                ss_add(r.builtins, (byte*)v.items[i]);
                i++;
            };
            return;
        };

        def er_impl(EReg* r, byte* name, byte* list) -> void
        {
            nm_put(r.implies, name, (void*)ef_split(list));
            return;
        };

        def er_new() -> EReg*
        {
            EReg* r = (EReg*)fmalloc((u64)((sizeof(EReg) + 7) / 8));
            PtrVec* pv;
            int i;
            r.user = om_new();
            r.cache = om_new();
            r.fe = om_new();
            r.ia = om_new();
            r.children = nm_new();
            r.parent = nm_new();
            r.perm = nm_new();
            r.implies = nm_new();
            r.builtins = ss_new();
            r.depth = 0;
            r.failed = false;
            er_hier(r, g"IO\0", g"IO.Console IO.File IO.Socket IO.Pipe IO.Device IO.Serial IO.USB IO.GPU\0");
            er_hier(r, g"Alloc\0", g"Alloc.Heap Alloc.Pool Alloc.Stack Alloc.Virtual Alloc.Shared\0");
            er_hier(r, g"Unsafe\0", g"Unsafe.Ptr Unsafe.Cast Unsafe.ASM Unsafe.FFI Unsafe.Uninit\0");
            er_hier(r, g"Mem\0", g"Mem.Read Mem.Write Mem.Exec\0");
            er_hier(r, g"Mem.Read\0", g"Mem.Read.Process Mem.Read.Kernel Mem.Read.Mapped\0");
            er_hier(r, g"Mem.Write\0", g"Mem.Write.Process Mem.Write.Kernel Mem.Write.Exec Mem.Write.Mapped\0");
            er_hier(r, g"Mem.Exec\0", g"Mem.Exec.JIT Mem.Exec.Shellcode\0");
            er_hier(r, g"Sync\0", g"Sync.Lock Sync.Atomic Sync.Signal Sync.Wait\0");
            er_hier(r, g"Crypto\0", g"Crypto.Hash Crypto.Encrypt Crypto.Decrypt Crypto.Random Crypto.Key\0");
            er_hier(r, g"Process\0", g"Process.Spawn Process.Kill Process.Inject Process.Suspend Process.Token\0");
            er_hier(r, g"Hook\0", g"Hook.Detour Hook.IAT Hook.SSDT Hook.Vtable Hook.Exception\0");
            er_hier(r, g"Privilege\0", g"Privilege.Elevate Privilege.Drop Privilege.Check\0");
            er_hier(r, g"Time\0", g"Time.RealTime Time.Sleep Time.Timer\0");
            ss_add(r.builtins, g"Pure\0");
            ss_add(r.builtins, g"Throw\0");
            pv = ef_split(g"Unsafe Unsafe.Ptr Unsafe.Cast Unsafe.ASM Unsafe.FFI Unsafe.Uninit\0");
            i = 0;
            while (i < pv.len)
            {
                nm_put(r.perm, (byte*)pv.items[i], (void*)1);
                ffree((byte*)pv.items[i]);
                i++;
            };
            pv_free(pv);
            er_impl(r, g"Hook.Detour\0", g"Hook Unsafe Mem.Write.Exec\0");
            er_impl(r, g"Hook.IAT\0", g"Hook Mem.Write\0");
            er_impl(r, g"Hook.SSDT\0", g"Hook Privilege Mem.Write.Kernel Unsafe\0");
            er_impl(r, g"Hook.Vtable\0", g"Hook Mem.Write\0");
            er_impl(r, g"Process.Inject\0", g"Process Alloc.Virtual Mem.Write.Exec Hook Unsafe\0");
            er_impl(r, g"Crypto.Key\0", g"Crypto\0");
            return r;
        };


        def er_kids(EReg* r, byte* name) -> PtrVec* -> (PtrVec*)nm_get(r.children, name);

        def er_parent(EReg* r, byte* name) -> byte* -> (byte*)nm_get(r.parent, name);

        def er_is_perm(EReg* r, byte* name) -> bool -> nm_has(r.perm, name);


        def er_add_parents(EReg* r, OMap* s, byte* name) -> void
        {
            byte* p = er_parent(r, name);
            while (p != (byte*)0)
            {
                ss_add(s, p);
                p = er_parent(r, p);
            };
            return;
        };


        def er_parent_in(EReg* r, OMap* s, byte* name) -> bool
        {
            byte* p = er_parent(r, name);
            while (p != (byte*)0)
            {
                if (ss_has(s, p)) { return true; };
                p = er_parent(r, p);
            };
            return false;
        };





        def er_resolve(EReg* r, byte* name) -> OMap*;

        def ef_unary_code(byte* op) -> int
        {
            if (cstr_eq(op, g"*\0")) { return 1; };
            if (cstr_eq(op, g"~\0")) { return 2; };
            if (cstr_eq(op, g"!\0")) { return 3; };
            if (cstr_eq(op, g"?\0")) { return 4; };
            if (cstr_eq(op, g"@\0")) { return 5; };
            if (cstr_eq(op, g"!@\0")) { return 6; };
            if (cstr_eq(op, g"..\0")) { return 7; };
            if (cstr_eq(op, g"...\0")) { return 8; };
            if (cstr_eq(op, g"^suppress\0")) { return 9; };
            if (cstr_eq(op, g"<*\0")) { return 10; };
            return 0;
        };

        def er_eval(EReg* r, Node* n) -> OMap*
        {
            OMap* es = es_new();
            OMap* inner;
            OMap* left;
            OMap* right;
            OMap* res;
            OMap* all;
            byte* name;
            byte* ns;
            byte* op;
            EEntry* e;
            int i;
            int code;
            int len;
            bool wild;
            if (n == (Node*)0) { return es; };
            if (r.failed) { return es; };
            if (n.kind == NodeKind.EFFECT_NAME)
            {
                name = n.text;
                if (cstr_eq(name, g"*.*\0"))
                {
                    all = ss_copy(r.builtins);
                    i = 0;
                    while (i < r.user.ks.len)
                    {
                        ss_add(all, (byte*)r.user.ks.items[i]);
                        i++;
                    };
                    i = 0;
                    while (i < all.ks.len)
                    {
                        res = er_resolve(r, ss_key(all, i));
                        es_merge(es, res);
                        om_free(res);
                        i++;
                    };
                    om_free(all);
                    return es;
                };
                len = bc_len(name);
                wild = false;
                if (len >= 2)
                {
                    if (name[len - 2] == '.' & name[len - 1] == '*') { wild = true; };
                };
                if (wild)
                {
                    ns = ef_prefix_dup(name, len - 2);
                    all = ss_copy(r.builtins);
                    i = 0;
                    while (i < r.user.ks.len)
                    {
                        ss_add(all, (byte*)r.user.ks.items[i]);
                        i++;
                    };
                    i = 0;
                    while (i < all.ks.len)
                    {
                        if (cstr_eq(ss_key(all, i), ns) | ef_starts_dotted(ss_key(all, i), ns))
                        {
                            res = er_resolve(r, ss_key(all, i));
                            es_merge(es, res);
                            om_free(res);
                        };
                        i++;
                    };
                    om_free(all);
                    ffree(ns);
                    return es;
                };
                res = er_resolve(r, name);
                es_merge(es, res);
                om_free(res);
                if (er_is_perm(r, name))
                {
                    e = (EEntry*)om_get(es, name);
                    if (e != (EEntry*)0) { e.atten = false; };
                };
                return es;
            };
            if (n.kind == NodeKind.EFFECT_EXPR)
            {
                op = n.text;
                code = ef_unary_code(op);
                if (code > 0)
                {
                    om_free(es);
                    inner = er_eval(r, n.a);
                    i = 0;
                    while (i < inner.ks.len)
                    {
                        e = (EEntry*)inner.vs.items[i];
                        if (code == 1) { e.impl = true; };
                        if (code == 2) { e.req = true; };
                        if (code == 3) { e.excl = true; };
                        if (code == 4) { e.weak = true; };
                        if (code == 5) { e.atten = true; };
                        if (code == 6) { e.atten = false; e.excl = true; };
                        if (code == 7) { e.one = true; };
                        if (code == 8) { e.one = false; };
                        if (code == 9) { e.supp = true; };
                        if (code == 10) { e.cprop = true; };
                        i++;
                    };
                    return inner;
                };
                if (cstr_eq(op, g"&\0") | cstr_eq(op, g"|\0") | cstr_eq(op, g">\0") | cstr_eq(op, g"->\0"))
                {
                    om_free(es);
                    left = er_eval(r, n.a);
                    right = er_eval(r, n.b);
                    res = es_copy(left);
                    es_merge(res, right);
                    es_free(left);
                    om_free(right);
                    return res;
                };

                return es;
            };
            return es;
        };


        def er_resolve(EReg* r, byte* name) -> OMap*
        {
            OMap* cached = (OMap*)om_get(r.cache, name);
            OMap* es;
            OMap* impl_es;
            Node* defn;
            PtrVec* imp;
            int i;
            bool perm;
            if (cached != (OMap*)0) { return es_copy(cached); };
            r.depth++;
            if (r.depth > 150)
            {
                r.failed = true;
                r.depth--;
                return es_new();
            };
            es = es_new();
            perm = er_is_perm(r, name);
            if (om_has(r.user, name))
            {
                defn = (Node*)om_get(r.user, name);
                if (defn.a != (Node*)0)
                {
                    om_free(es);
                    es = er_eval(r, defn.a);
                };
                es_add(es, ee_new(name, !perm));
            }
            else
            {
                es_add(es, ee_new(name, !perm));
                imp = (PtrVec*)nm_get(r.implies, name);
                if (imp != (PtrVec*)0)
                {
                    i = 0;
                    while (i < imp.len)
                    {
                        impl_es = er_resolve(r, (byte*)imp.items[i]);
                        es_merge(es, impl_es);
                        om_free(impl_es);
                        i++;
                    };
                };
            };
            r.depth--;
            om_put(r.cache, name, (void*)es);
            return es_copy(es);
        };







        struct EVio
        {
            int kind;
            byte* s1;
            byte* s2;
            byte* s3;
            int line;
            int col;
        };

        def ev_new(int kind, byte* s1, byte* s2, byte* s3, int line, int col) -> EVio*
        {
            EVio* v = (EVio*)fmalloc((u64)((sizeof(EVio) + 7) / 8));
            v.kind = kind;
            v.s1 = s1;
            v.s2 = s2;
            v.s3 = s3;
            v.line = line;
            v.col = col;
            return v;
        };

        def ev_kind_name(int kind) -> byte*
        {
            if (kind == 0) { return g"exclusion\0"; };
            if (kind == 1) { return g"boundary\0"; };
            if (kind == 2) { return g"attenuation\0"; };
            return g"conflict\0";
        };


        def ev_print_str(EVio* v) -> void
        {
            if (v.kind == 0)
            {
                print(g"Effect violation at \0");
                if (v.line != 0)
                {
                    print(v.line);
                    print(g":\0");
                    print(v.col);
                }
                else { print(g"?\0"); };
                print(g": '\0");
                print(v.s1);
                print(g"' excludes effect '\0");
                print(v.s3);
                print(g"' but calls '\0");
                print(v.s2);
                print(g"' which introduces it\0");
                return;
            };
            if (v.kind == 1)
            {
                print(g"Effect '\0");
                print(v.s2);
                print(g"' in '\0");
                print(v.s1);
                print(g"' crosses boundary '\0");
                print(v.s3);
                print(g"' without attenuation\0");
                return;
            };
            if (v.kind == 2)
            {
                print(g"Cannot attenuate permanent effect '\0");
                print(v.s1);
                print(g"' at boundary '\0");
                print(v.s2);
                print(g"' (!@ prevents attenuation)\0");
                return;
            };
            print(g"Effects '\0");
            print(v.s1);
            print(g"' and '\0");
            print(v.s2);
            print(g"' conflict at '\0");
            print(v.s3);
            print(g"' with no priority resolution\0");
            return;
        };


        def ev_print_msg(EVio* v) -> void
        {
            if (v.kind == 0)
            {
                print(g"Function \0");
                print(v.s1);
                print(g" excludes effect \0");
                print(v.s3);
                print(g" but calls function \0");
                print(v.s2);
                print(g" which introduces it\0");
                return;
            };
            if (v.kind == 1)
            {
                print(v.s1);
                print(g" introduces effect \0");
                print(v.s2);
                print(g" which crosses boundary \0");
                print(v.s3);
                print(g" without attenuation\0");
                return;
            };
            if (v.kind == 2)
            {
                print(g"Cannot attenuate permanent effect \0");
                print(v.s1);
                print(g" at boundary \0");
                print(v.s2);
                print(g" -- !@ prevents attenuation\0");
                return;
            };
            print(g"Effects \0");
            print(v.s1);
            print(g" and \0");
            print(v.s2);
            print(g" conflict at \0");
            print(v.s3);
            print(g" with no priority resolution\0");
            return;
        };


        def ef_print_violations(PtrVec* vs, bool strict) -> void
        {
            int i = 0;
            EVio* v;
            while (i < vs.len)
            {
                v = (EVio*)vs.items[i];
                print(g"[\0");
                if (strict) { print(g"error\0"); } else { print(g"warning\0"); };
                print(g"] \0");
                if (strict) { println(ev_kind_name(v.kind)); } else { println(g"warning\0"); };
                if (strict)
                {
                    print(g"  \0");
                    if (v.kind == 0 & v.line != 0)
                    {
                        print(v.line);
                        print(g":\0");
                        print(v.col);
                        print(g"  \0");
                    };
                    ev_print_msg(v);
                    println(g"\0");
                    if (v.kind == 0)
                    {
                        print(g"  caller \0");
                        print(v.s1);
                        print(g" declared effect !\0");
                        println(v.s3);
                        print(g"  callee \0");
                        print(v.s2);
                        print(g" declared effect \0");
                        println(v.s3);
                    };
                    if (v.kind == 1)
                    {
                        print(g"  add `# attenuate {v.effect_name}` to boundary \0");
                        print(v.s3);
                        println(g" to suppress\0");
                    };
                    if (v.kind == 2)
                    {
                        print(g"  effect \0");
                        print(v.s1);
                        println(g" is marked !@ and can never be stripped\0");
                    };
                }
                else
                {
                    print(g"  \0");
                    ev_print_str(v);
                    println(g"\0");
                };
                println(g"\0");
                i++;
            };
            return;
        };

        def ef_print_summary(PtrVec* vs, bool strict) -> void
        {
            int n = vs.len;
            int cnt0 = 0;
            int cnt1 = 0;
            int cnt2 = 0;
            int cnt3 = 0;
            int i = 0;
            bool first = true;
            EVio* v;
            if (n == 0)
            {
                println(g"[Effects] OK -- no violations found.\0");
                return;
            };
            while (i < n)
            {
                v = (EVio*)vs.items[i];
                if (v.kind == 0) { cnt0++; };
                if (v.kind == 1) { cnt1++; };
                if (v.kind == 2) { cnt2++; };
                if (v.kind == 3) { cnt3++; };
                i++;
            };
            print(g"[Effects] \0");
            print(n);
            print(g" violation(s)  \0");
            if (strict)
            {

                if (cnt2 > 0) { print(g"attenuation: \0"); print(cnt2); first = false; };
                if (cnt1 > 0)
                {
                    if (!first) { print(g", \0"); };
                    print(g"boundary: \0");
                    print(cnt1);
                    first = false;
                };
                if (cnt3 > 0)
                {
                    if (!first) { print(g", \0"); };
                    print(g"conflict: \0");
                    print(cnt3);
                    first = false;
                };
                if (cnt0 > 0)
                {
                    if (!first) { print(g", \0"); };
                    print(g"exclusion: \0");
                    print(cnt0);
                };
            }
            else
            {
                print(g"warning: \0");
                print(n);
            };
            println(g"\0");
            return;
        };





        struct EPass
        {
            EReg* reg;
            PtrVec* vios;          
            bool strict;
            OMap* transitive;      
            OMap* calls;           
            OMap* bare;            
            PtrVec* xl;            
            PtrVec* ml;            
            PtrVec* own;           
            bool failed;
        };

        def ef_unwrap(Node* s) -> Node*
        {
            if (s == (Node*)0) { return s; };
            if (s.kind == NodeKind.FUNCTION_DEF_STATEMENT) { return s.a; };
            if (s.kind == NodeKind.NAMESPACE_DEF_STATEMENT) { return s.a; };
            return s;
        };



        def ef_walk_item(PtrVec* out, Node* s0) -> void
        {
            Node* s = ef_unwrap(s0);
            int c;
            int i;
            if (s == (Node*)0) { return; };
            if (s.kind == NodeKind.FUNCTION_DEF | s.kind == NodeKind.INTERFACE_DEF | s.kind == NodeKind.EFFECT_DEF)
            {
                pv_push(out, (void*)s);
                return;
            };
            if (s.kind == NodeKind.NAMESPACE_DEF)
            {
                c = bc_count(s, 0);
                i = 0;
                while (i < c)
                {
                    ef_walk_item(out, node_child(s, 0, i));
                    i++;
                };
                if (s.b != (Node*)0)
                {
                    c = bc_count(s.b, 0);
                    i = 0;
                    while (i < c)
                    {
                        ef_walk_item(out, node_child(s.b, 0, i));
                        i++;
                    };
                };
            };
            return;
        };


        def ef_collect_calls(Node* n, PtrVec* out) -> void
        {
            int s;
            int c;
            int i;
            if (n == (Node*)0) { return; };
            if (n.kind == NodeKind.FUNCTION_CALL) { pv_push(out, (void*)n); };
            ef_collect_calls(n.a, out);
            ef_collect_calls(n.b, out);
            ef_collect_calls(n.c, out);
            ef_collect_calls(n.d, out);
            ef_collect_calls(n.e, out);
            s = 0;
            while (s < 6)
            {
                c = bc_count(n, s);
                i = 0;
                while (i < c)
                {
                    ef_collect_calls(node_child(n, s, i), out);
                    i++;
                };
                s++;
            };
            return;
        };

        def ef_has_asm(Node* n) -> bool
        {
            int s;
            int c;
            int i;
            if (n == (Node*)0) { return false; };
            if (n.kind == NodeKind.INLINE_ASM) { return true; };
            if (ef_has_asm(n.a)) { return true; };
            if (ef_has_asm(n.b)) { return true; };
            if (ef_has_asm(n.c)) { return true; };
            if (ef_has_asm(n.d)) { return true; };
            if (ef_has_asm(n.e)) { return true; };
            s = 0;
            while (s < 6)
            {
                c = bc_count(n, s);
                i = 0;
                while (i < c)
                {
                    if (ef_has_asm(node_child(n, s, i))) { return true; };
                    i++;
                };
                s++;
            };
            return false;
        };



        def ep_direct(EPass* p, byte* fname) -> OMap*
        {
            EReg* r = p.reg;
            OMap* res = ss_new();
            OMap* es = (OMap*)om_get(r.fe, fname);
            OMap* ex;
            EEntry* e;
            EEntry* x;
            Node* ud;
            int i = 0;
            int j;
            if (es == (OMap*)0) { return res; };
            while (i < es.ks.len)
            {
                e = (EEntry*)es.vs.items[i];
                i++;
                if (e.excl) { continue; };
                ss_add(res, e.name);
                ud = (Node*)om_get(r.user, e.name);
                if (ud != (Node*)0)
                {
                    if (ud.a != (Node*)0)
                    {
                        ex = er_eval(r, ud.a);
                        j = 0;
                        while (j < ex.ks.len)
                        {
                            x = (EEntry*)ex.vs.items[j];
                            j++;
                            if (!x.excl)
                            {
                                ss_add(res, x.name);
                                er_add_parents(r, res, x.name);
                            };
                        };
                        es_free(ex);
                    };
                };
                er_add_parents(r, res, e.name);
            };
            return res;
        };


        def ep_att(EPass* p, byte* fname) -> OMap*
        {
            EReg* r = p.reg;
            OMap* att = ss_new();
            OMap* es = (OMap*)om_get(r.ia, fname);
            EEntry* e;
            PtrVec* kids;
            int i = 0;
            int j;
            if (es == (OMap*)0) { return att; };
            while (i < es.ks.len)
            {
                e = (EEntry*)es.vs.items[i];
                i++;
                ss_add(att, e.name);
                kids = er_kids(r, e.name);
                if (kids != (PtrVec*)0)
                {
                    j = 0;
                    while (j < kids.len)
                    {
                        ss_add(att, (byte*)kids.items[j]);
                        j++;
                    };
                };
            };
            return att;
        };


        def ep_excluded(EPass* p, byte* fname) -> OMap*
        {
            EReg* r = p.reg;
            OMap* res = ss_new();
            OMap* es = (OMap*)om_get(r.fe, fname);
            EEntry* e;
            PtrVec* kids;
            int i = 0;
            int j;
            if (es == (OMap*)0) { return res; };
            while (i < es.ks.len)
            {
                e = (EEntry*)es.vs.items[i];
                i++;
                if (e.excl)
                {
                    ss_add(res, e.name);
                    kids = er_kids(r, e.name);
                    if (kids != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < kids.len)
                        {
                            ss_add(res, (byte*)kids.items[j]);
                            j++;
                        };
                    };
                };
            };
            return res;
        };


        def ep_callee_requires(EPass* p, byte* cname, PtrVec* own) -> OMap*
        {
            EReg* r = p.reg;
            OMap* res = ss_new();
            byte* pk;
            PtrVec* cands = (PtrVec*)om_get(p.bare, cname);
            OMap* es;
            EEntry* e;
            PtrVec* kids;
            int ci = 0;
            int i;
            int j;
            int len;
            if (cands == (PtrVec*)0) { return res; };
            while (ci < cands.len)
            {
                es = (OMap*)cands.items[ci];
                ci++;
                i = 0;
                while (i < es.ks.len)
                {
                    e = (EEntry*)es.vs.items[i];
                    i++;

                    if (e.req | e.impl | !e.excl)
                    {
                        ss_add(res, e.name);
                        er_add_parents(r, res, e.name);
                        len = bc_len(e.name);
                        while (true)
                        {
                            j = ef_last_dot(e.name, len);
                            if (j < 0) { break; };
                            len = j;
                            pk = ef_prefix_dup(e.name, len);
                            if (ss_has(res, pk)) { ffree(pk); }
                            else
                            {
                                ss_add(res, pk);
                                pv_push(own, (void*)pk);
                            };
                        };
                        kids = er_kids(r, e.name);
                        if (kids != (PtrVec*)0)
                        {
                            j = 0;
                            while (j < kids.len)
                            {
                                ss_add(res, (byte*)kids.items[j]);
                                j++;
                            };
                        };
                    };
                };
            };
            return res;
        };


        def ep_most_specific(EPass* p, OMap* m) -> OMap*
        {
            EReg* r = p.reg;
            OMap* res = ss_new();
            OMap* ex;
            PtrVec* kids;
            Node* ud;
            byte* eff;
            int i = 0;
            int j;
            bool has_child;
            while (i < m.ks.len)
            {
                eff = ss_key(m, i);
                i++;
                has_child = false;
                kids = er_kids(r, eff);
                if (kids != (PtrVec*)0)
                {
                    j = 0;
                    while (j < kids.len)
                    {
                        if (ss_has(m, (byte*)kids.items[j])) { has_child = true; };
                        j++;
                    };
                };
                ud = (Node*)om_get(r.user, eff);
                if (ud != (Node*)0)
                {
                    if (ud.a != (Node*)0)
                    {
                        ex = er_eval(r, ud.a);
                        j = 0;
                        while (j < ex.ks.len)
                        {
                            if (ss_has(m, ((EEntry*)ex.vs.items[j]).name)) { has_child = true; };
                            j++;
                        };
                        es_free(ex);
                    };
                };
                if (!has_child) { ss_add(res, eff); };
            };
            return res;
        };


        def ep_trans_of(EPass* p, byte* name) -> OMap*
        {
            OMap* t = (OMap*)om_get(p.transitive, name);
            if (t != (OMap*)0) { return t; };
            return ep_direct(p, name);
        };

        def ep_report(EPass* p, EVio* v) -> void
        {
            pv_push(p.vios, (void*)v);
            return;
        };

        def ef_matches(byte* excl, OMap* vis) -> bool
        {
            int i = 0;
            if (ss_has(vis, excl)) { return true; };
            while (i < vis.ks.len)
            {
                if (ef_dotted_anc_eq(ss_key(vis, i), excl)) { return true; };
                i++;
            };
            return false;
        };



        def ep_fill_visible(EReg* r, OMap* visible, OMap* ct, OMap* callee_att) -> void
        {
            PtrVec* kids;
            int i = 0;
            int j;
            while (i < ct.ks.len)
            {
                if (!ss_has(callee_att, ss_key(ct, i))) { ss_add(visible, ss_key(ct, i)); };
                i++;
            };
            i = 0;
            while (i < callee_att.ks.len)
            {
                kids = er_kids(r, ss_key(callee_att, i));
                if (kids != (PtrVec*)0)
                {
                    j = 0;
                    while (j < kids.len)
                    {
                        om_del(visible, (byte*)kids.items[j]);
                        j++;
                    };
                };
                i++;
            };
            return;
        };

        def ep_check_caller(EPass* p, Node* f) -> void
        {
            EReg* r = p.reg;
            OMap* excluded;
            OMap* reported;
            OMap* visible;
            OMap* callee_att;
            OMap* ct;
            OMap* matching;
            OMap* ms;
            OMap* req;
            OMap* dir;
            PtrVec* calls;
            PtrVec* own;
            Node* call;
            byte* eff;
            int ci;
            int i;
            if (bc_is_proto(f)) { return; };
            excluded = ep_excluded(p, f.text);
            if (ss_len(excluded) == 0)
            {
                om_free(excluded);
                return;
            };
            if (f.a == (Node*)0)
            {
                om_free(excluded);
                return;
            };
            calls = pv_new();
            ef_collect_calls(f.a, calls);
            reported = ss_new();
            own = pv_new();
            ci = 0;
            while (ci < calls.len)
            {
                call = (Node*)calls.items[ci];
                ci++;

                callee_att = ep_att(p, call.text);
                visible = ss_new();
                ct = (OMap*)om_get(p.transitive, call.text);
                if (ct != (OMap*)0)
                {
                    if (ss_len(ct) == 0)
                    {
                        req = ep_callee_requires(p, call.text, own);
                        ep_fill_visible(r, visible, req, callee_att);
                        om_free(req);
                    }
                    else { ep_fill_visible(r, visible, ct, callee_att); };
                }
                else
                {
                    dir = ep_direct(p, call.text);
                    if (ss_len(dir) == 0)
                    {
                        om_free(dir);
                        req = ep_callee_requires(p, call.text, own);
                        ep_fill_visible(r, visible, req, callee_att);
                        om_free(req);
                    }
                    else
                    {
                        ep_fill_visible(r, visible, dir, callee_att);
                        om_free(dir);
                    };
                };
                matching = ss_new();
                i = 0;
                while (i < excluded.ks.len)
                {
                    eff = ss_key(excluded, i);
                    i++;
                    if (ef_matches(eff, visible))
                    {
                        if (!ss_has(reported, eff)) { ss_add(matching, eff); };
                    };
                };
                if (ss_len(matching) == 0)
                {
                    om_free(matching);
                    om_free(visible);
                    om_free(callee_att);
                    continue;
                };
                ms = ep_most_specific(p, matching);
                i = 0;
                while (i < ms.ks.len)
                {
                    eff = ss_key(ms, i);
                    i++;
                    ss_add(reported, eff);
                    ep_report(p, ev_new(0, f.text, call.text, eff, call.line, call.col));
                };
                om_free(ms);
                om_free(matching);
                om_free(visible);
                om_free(callee_att);
            };
            om_free(reported);
            pv_free(calls);
            om_free(excluded);
            i = 0;
            while (i < own.len)
            {
                ffree((byte*)own.items[i]);
                i++;
            };
            pv_free(own);
            return;
        };

        def ep_check_pure(EPass* p, Node* f) -> void
        {
            EReg* r = p.reg;
            OMap* es = (OMap*)om_get(r.fe, f.text);
            OMap* trans;
            OMap* forb;
            OMap* impure;
            OMap* ms;
            OMap* ct;
            OMap* dir;
            EEntry* e;
            PtrVec* calls;
            PtrVec* kids;
            Node* call;
            byte* eff;
            int i;
            int j;
            int k;
            int line;
            int col;
            bool pure;
            bool trans_fresh;
            bool hit;
            if (bc_is_proto(f)) { return; };
            if (es == (OMap*)0) { return; };
            pure = false;
            e = (EEntry*)om_get(es, g"Pure\0");
            if (e != (EEntry*)0)
            {
                if (!e.excl) { pure = true; };
            };
            if (!pure) { return; };
            trans_fresh = false;
            trans = (OMap*)om_get(p.transitive, f.text);
            if (trans == (OMap*)0)
            {
                trans = ss_new();
                trans_fresh = true;
            };
            forb = ss_new();
            ss_add(forb, g"IO\0");
            ss_add(forb, g"Alloc\0");
            ss_add(forb, g"Mem.Write\0");
            ss_add(forb, g"Throw\0");
            i = 0;
            while (i < 4)
            {
                kids = er_kids(r, ss_key(forb, i));
                if (kids != (PtrVec*)0)
                {
                    j = 0;
                    while (j < kids.len)
                    {
                        ss_add(forb, (byte*)kids.items[j]);
                        j++;
                    };
                };
                i++;
            };
            impure = ss_new();
            i = 0;
            while (i < trans.ks.len)
            {
                if (ss_has(forb, ss_key(trans, i))) { ss_add(impure, ss_key(trans, i)); };
                i++;
            };
            if (ss_len(impure) == 0)
            {
                om_free(impure);
                om_free(forb);
                if (trans_fresh) { om_free(trans); };
                return;
            };
            ms = ep_most_specific(p, impure);
            i = 0;
            while (i < ms.ks.len)
            {
                eff = ss_key(ms, i);
                i++;
                line = 0;
                col = 0;
                if (f.a != (Node*)0)
                {
                    calls = pv_new();
                    ef_collect_calls(f.a, calls);
                    k = 0;
                    while (k < calls.len)
                    {
                        call = (Node*)calls.items[k];
                        k++;
                        ct = (OMap*)om_get(p.transitive, call.text);
                        if (ct != (OMap*)0) { hit = ss_has(ct, eff); }
                        else
                        {
                            dir = ep_direct(p, call.text);
                            hit = ss_has(dir, eff);
                            om_free(dir);
                        };
                        if (hit)
                        {
                            line = call.line;
                            col = call.col;
                            break;
                        };
                    };
                    pv_free(calls);
                };
                if (line == 0) { line = f.line; };
                if (col == 0) { col = f.col; };
                ep_report(p, ev_new(0, f.text, g"(Pure violation)\0", eff, line, col));
            };
            om_free(ms);
            om_free(impure);
            om_free(forb);
            if (trans_fresh) { om_free(trans); };
            return;
        };


        def ef_name_str(Node* n) -> byte*
        {
            if (n == (Node*)0) { return (byte*)0; };
            if (n.kind == NodeKind.EFFECT_NAME) { return n.text; };
            if (n.kind == NodeKind.EFFECT_EXPR)
            {
                if (n.b == (Node*)0)
                {
                    if (n.a != (Node*)0) { return ef_name_str(n.a); };
                };
            };
            return (byte*)0;
        };

        def ep_have_xor(EPass* p, byte* l, byte* rt, byte* src) -> bool
        {
            int i = 0;
            while (i < p.xl.len)
            {
                if (cstr_eq((byte*)p.xl.items[i], l) & cstr_eq((byte*)p.xl.items[i + 1], rt) & cstr_eq((byte*)p.xl.items[i + 2], src)) { return true; };
                i = i + 3;
            };
            return false;
        };

        def ep_have_mut(EPass* p, byte* l, byte* rt, int neg, byte* src) -> bool
        {
            int i = 0;
            while (i < p.ml.len)
            {
                if (cstr_eq((byte*)p.ml.items[i], l) & cstr_eq((byte*)p.ml.items[i + 1], rt) & (((int*)p.ml.items[i + 2])[0] == neg) & cstr_eq((byte*)p.ml.items[i + 3], src)) { return true; };
                i = i + 4;
            };
            return false;
        };

        def ep_collect_constraints(EPass* p, Node* x, byte* src) -> void
        {
            byte* ln;
            byte* rn;
            int neg;
            if (x == (Node*)0) { return; };
            if (x.kind != NodeKind.EFFECT_EXPR) { return; };
            if (cstr_eq(x.text, g"^|\0"))
            {
                ln = ef_name_str(x.a);
                rn = ef_name_str(x.b);
                if (ln != (byte*)0 & rn != (byte*)0)
                {
                    if (!ep_have_xor(p, ln, rn, src))
                    {
                        pv_push(p.xl, (void*)ln);
                        pv_push(p.xl, (void*)rn);
                        pv_push(p.xl, (void*)src);
                    };
                };
            }
            elif (cstr_eq(x.text, g"<->\0"))
            {
                ln = ef_name_str(x.a);
                rn = (byte*)0;
                neg = 0;
                if (x.b != (Node*)0)
                {
                    if (x.b.kind == NodeKind.EFFECT_EXPR)
                    {
                        if (cstr_eq(x.b.text, g"!\0"))
                        {
                            if (ef_name_str(x.b.a) != (byte*)0)
                            {
                                rn = ef_name_str(x.b.a);
                                neg = 1;
                            };
                        };
                    };
                };
                if (rn == (byte*)0)
                {
                    if (ef_name_str(x.b) != (byte*)0) { rn = ef_name_str(x.b); };
                };
                if (ln != (byte*)0 & rn != (byte*)0)
                {
                    if (!ep_have_mut(p, ln, rn, neg, src))
                    {
                        pv_push(p.ml, (void*)ln);
                        pv_push(p.ml, (void*)rn);
                        pv_push(p.ml, (void*)bx_new(neg));
                        pv_push(p.ml, (void*)src);
                    };
                };
            };
            ep_collect_constraints(p, x.a, src);
            ep_collect_constraints(p, x.b, src);
            return;
        };


        def ep_present(EPass* p, OMap* trans, byte* name) -> bool
        {
            PtrVec* kids;
            int j;
            if (ss_has(trans, name)) { return true; };
            kids = er_kids(p.reg, name);
            if (kids != (PtrVec*)0)
            {
                j = 0;
                while (j < kids.len)
                {
                    if (ss_has(trans, (byte*)kids.items[j])) { return true; };
                    j++;
                };
            };
            return false;
        };

        def ep_check_conflicts(EPass* p, Node* f) -> void
        {
            EReg* r = p.reg;
            OMap* trans;
            OMap* fes;
            OMap* done;
            byte* src;
            byte* l;
            byte* rt;
            byte* missing;
            byte* key;
            int i;
            bool lp;
            bool rp;
            bool conflict;
            if (bc_is_proto(f)) { return; };
            trans = (OMap*)om_get(p.transitive, f.text);
            if (trans == (OMap*)0) { return; };
            if (ss_len(trans) == 0) { return; };
            fes = (OMap*)om_get(r.fe, f.text);
            done = ss_new();
            i = 0;
            while (i < p.xl.len)
            {
                l = (byte*)p.xl.items[i];
                rt = (byte*)p.xl.items[i + 1];
                src = (byte*)p.xl.items[i + 2];
                i = i + 3;
                if (fes == (OMap*)0) { continue; };
                if (!es_has(fes, src)) { continue; };
                lp = ep_present(p, trans, l);
                rp = ep_present(p, trans, rt);
                if (lp & rp)
                {
                    key = join3_f(join3(g"xor\x1f\0", l, g"\x1f\0"), rt, g"\0", 1);
                    if (ss_has(done, key))
                    {
                        ffree(key);
                        continue;
                    };
                    ss_add(done, key);
                    ep_report(p, ev_new(3, l, rt, f.text, 0, 0));
                };
            };
            i = 0;
            while (i < p.ml.len)
            {
                l = (byte*)p.ml.items[i];
                rt = (byte*)p.ml.items[i + 1];
                src = (byte*)p.ml.items[i + 3];
                i = i + 4;
                if (fes == (OMap*)0) { continue; };
                if (!es_has(fes, src)) { continue; };
                lp = ep_present(p, trans, l);
                rp = ep_present(p, trans, rt);
                if (((int*)p.ml.items[i - 2])[0] != 0) { conflict = lp & rp; }
                else { conflict = lp != rp; };
                if (conflict)
                {
                    key = join3_f(join3(g"mut\x1f\0", l, g"\x1f\0"), rt, g"\0", 1);
                    if (ss_has(done, key))
                    {
                        ffree(key);
                        continue;
                    };
                    ss_add(done, key);
                    if (((int*)p.ml.items[i - 2])[0] != 0)
                    {
                        missing = join3(g"(excludes \0", rt, g" via <->)\0");
                    }
                    else
                    {
                        if (lp & !rp) { missing = rt; } else { missing = l; };
                        missing = join3(g"(requires \0", missing, g" via <->)\0");
                    };

                    pv_push(p.own, (void*)missing);
                    ep_report(p, ev_new(3, l, missing, f.text, 0, 0));
                };
            };
            i = 0;
            while (i < done.ks.len)
            {
                ffree(ss_key(done, i));
                i++;
            };
            om_free(done);
            return;
        };


        def ep_check_boundary(EPass* p, byte* fname, OMap* es, byte* bname, OMap* att) -> void
        {
            EReg* r = p.reg;
            EEntry* e;
            byte* par;
            int i = 0;
            while (i < es.ks.len)
            {
                e = (EEntry*)es.vs.items[i];
                i++;
                if (e.excl) { continue; };
                if (es_has(att, e.name))
                {
                    if (!e.atten) { ep_report(p, ev_new(2, e.name, bname, (byte*)0, 0, 0)); };
                    continue;
                };
                par = er_parent(r, e.name);
                if (par != (byte*)0)
                {
                    if (es_has(att, par))
                    {
                        if (!e.atten) { ep_report(p, ev_new(2, e.name, bname, (byte*)0, 0, 0)); };
                        continue;
                    };
                };
                ep_report(p, ev_new(1, fname, e.name, bname, 0, 0));
            };
            return;
        };

        def ep_add_bare(EPass* p, byte* key, OMap* es) -> void
        {
            PtrVec* l = (PtrVec*)om_get(p.bare, key);
            if (l == (PtrVec*)0)
            {
                l = pv_new();
                om_put(p.bare, ts_dup(key), (void*)l);
            };
            pv_push(l, (void*)es);
            return;
        };

        def ep_call_name_ok(PtrVec* calls) -> bool
        {
            int i = 0;
            while (i < calls.len)
            {
                if (((Node*)calls.items[i]).text == (byte*)0) { return false; };
                i++;
            };
            return true;
        };


        def ep_merge_visible(EReg* r, OMap* t, OMap* ce, OMap* att) -> void
        {
            byte* eff;
            int k = 0;
            while (k < ce.ks.len)
            {
                eff = ss_key(ce, k);
                k++;
                if (ss_has(att, eff)) { continue; };
                if (er_parent_in(r, att, eff)) { continue; };
                ss_add(t, eff);
            };
            return;
        };



        def ep_free(EPass* p) -> void
        {
            int i = 0;
            while (i < p.vios.len)
            {
                ffree((byte*)p.vios.items[i]);
                i++;
            };
            pv_free(p.vios);
            i = 0;
            while (i < p.own.len)
            {
                ffree((byte*)p.own.items[i]);
                i++;
            };
            pv_free(p.own);
            i = 0;
            while (i < p.transitive.vs.len)
            {
                om_free((OMap*)p.transitive.vs.items[i]);
                i++;
            };
            om_free(p.transitive);
            i = 0;
            while (i < p.calls.vs.len)
            {
                om_free((OMap*)p.calls.vs.items[i]);
                i++;
            };
            om_free(p.calls);
            i = 0;
            while (i < p.bare.ks.len)
            {
                ffree((byte*)p.bare.ks.items[i]);
                pv_free((PtrVec*)p.bare.vs.items[i]);
                i++;
            };
            om_free(p.bare);
            pv_free(p.xl);
            i = 2;
            while (i < p.ml.len)
            {
                ffree((byte*)p.ml.items[i]);
                i = i + 4;
            };
            pv_free(p.ml);
            return;
        };




        def effects_check_filtered(Node* prog, bool strict, BcOwners* owners, NameMap* on) -> int
        {
            EReg* r = er_new();
            EPass p;
            PtrVec* items = pv_new();
            PtrVec* calls;
            OMap* proto_e = om_new();
            OMap* proto_a = om_new();
            defer pv_free(items);
            defer om_free(proto_e);
            defer om_free(proto_a);
            OMap* es;
            OMap* cset;
            OMap* all_funcs;
            OMap* t;
            OMap* att;
            OMap* ce;
            OMap* ad;
            Node* it;
            Node* ann;
            Node* prot;
            Node* meth;
            EEntry* e;
            byte* nm;
            byte* bare;
            int i;
            int j;
            int k;
            int m;
            int c;
            int old;
            bool changed;
            p.reg = r;
            p.vios = pv_new();
            p.strict = strict;
            p.transitive = om_new();
            p.calls = om_new();
            p.bare = om_new();
            p.xl = pv_new();
            p.ml = pv_new();
            p.own = pv_new();
            p.failed = false;
            defer ep_free(@p);

            c = bc_count(prog, 0);
            i = 0;
            while (i < c)
            {
                ef_walk_item(items, node_child(prog, 0, i));
                i++;
            };


            i = 0;
            while (i < items.len)
            {
                it = (Node*)items.items[i];
                i++;
                if (it.kind == NodeKind.EFFECT_DEF)
                {
                    om_put(r.user, it.text, (void*)it);
                    om_del(r.cache, it.text);
                };
            };


            i = 0;
            while (i < items.len)
            {
                it = (Node*)items.items[i];
                i++;
                if (it.kind == NodeKind.FUNCTION_DEF)
                {
                    ann = it.b;
                    if (bc_is_proto(it))
                    {
                        if (ann != (Node*)0)
                        {
                            es = er_eval(r, ann.a);
                            om_put(proto_e, it.text, (void*)es);
                            om_put(r.fe, it.text, (void*)es);
                        };
                        if (it.c != (Node*)0)
                        {
                            es = er_eval(r, it.c.a);
                            om_put(proto_a, it.text, (void*)es);
                            om_put(r.ia, it.text, (void*)es);
                        };
                    }
                    else
                    {
                        if (ann != (Node*)0)
                        {
                            es = er_eval(r, ann.a);
                            om_put(r.fe, it.text, (void*)es);
                        }
                        elif (om_has(proto_e, it.text))
                        {
                            om_put(r.fe, it.text, om_get(proto_e, it.text));
                        };
                        if (it.c != (Node*)0)
                        {
                            es = er_eval(r, it.c.a);
                            om_put(r.ia, it.text, (void*)es);
                        }
                        elif (om_has(proto_a, it.text))
                        {
                            om_put(r.ia, it.text, om_get(proto_a, it.text));
                        };
                    };
                };
                if (it.kind == NodeKind.INTERFACE_DEF)
                {
                    if (it.a != (Node*)0)
                    {
                        es = er_eval(r, it.a.a);
                        om_put(r.ia, it.text, (void*)es);
                    };
                };
            };


            i = 0;
            while (i < items.len)
            {
                it = (Node*)items.items[i];
                i++;
                if (it.kind == NodeKind.FUNCTION_DEF)
                {
                    if (!bc_is_proto(it))
                    {
                        if (it.a != (Node*)0)
                        {
                            if (ef_has_asm(it.a))
                            {
                                es = (OMap*)om_get(r.fe, it.text);
                                if (es == (OMap*)0) { es = es_new(); };
                                e = ee_new(g"Unsafe.ASM\0", true);
                                e.req = true;
                                es_add(es, e);
                                e = ee_new(g"Unsafe\0", true);
                                e.req = true;
                                es_add(es, e);
                                om_put(r.fe, it.text, (void*)es);
                            };
                        };
                    };
                };
            };


            i = 0;
            while (i < r.fe.ks.len)
            {
                nm = ss_key(r.fe, i);
                es = (OMap*)r.fe.vs.items[i];
                i++;
                bare = ef_rsplit_last(nm);
                ep_add_bare(@p, bare, es);
                ep_add_bare(@p, nm, es);
                ffree(bare);
            };

            if (r.failed) { return -1; };


            i = 0;
            while (i < items.len)
            {
                it = (Node*)items.items[i];
                i++;
                if (it.kind == NodeKind.FUNCTION_DEF)
                {
                    if (!bc_is_proto(it))
                    {
                        if (it.a != (Node*)0)
                        {
                            calls = pv_new();
                            ef_collect_calls(it.a, calls);
                            if (!ep_call_name_ok(calls))
                            {
                                pv_free(calls);
                                return -1;
                            };
                            cset = (OMap*)om_get(p.calls, it.text);
                            if (cset == (OMap*)0)
                            {
                                cset = ss_new();
                                om_put(p.calls, it.text, (void*)cset);
                            };
                            j = 0;
                            while (j < calls.len)
                            {
                                ss_add(cset, ((Node*)calls.items[j]).text);
                                j++;
                            };
                            pv_free(calls);
                        };
                    };
                };
            };


            all_funcs = ss_new();
            i = 0;
            while (i < p.calls.ks.len)
            {
                ss_add(all_funcs, ss_key(p.calls, i));
                i++;
            };
            i = 0;
            while (i < r.fe.ks.len)
            {
                ss_add(all_funcs, ss_key(r.fe, i));
                i++;
            };
            i = 0;
            while (i < all_funcs.ks.len)
            {
                nm = ss_key(all_funcs, i);
                om_put(p.transitive, nm, (void*)ep_direct(@p, nm));
                i++;
            };
            changed = true;
            while (changed)
            {
                changed = false;
                i = 0;
                while (i < all_funcs.ks.len)
                {
                    nm = ss_key(all_funcs, i);
                    i++;
                    t = (OMap*)om_get(p.transitive, nm);
                    old = ss_len(t);
                    cset = (OMap*)om_get(p.calls, nm);
                    att = ep_att(@p, nm);
                    if (cset != (OMap*)0)
                    {
                        j = 0;
                        while (j < cset.ks.len)
                        {

                            ce = (OMap*)om_get(p.transitive, ss_key(cset, j));
                            if (ce != (OMap*)0) { ep_merge_visible(r, t, ce, att); }
                            else
                            {
                                ce = ep_direct(@p, ss_key(cset, j));
                                ep_merge_visible(r, t, ce, att);
                                om_free(ce);
                            };
                            j++;
                        };
                    };
                    om_free(att);
                    if (ss_len(t) != old) { changed = true; };
                };
            };

            om_free(all_funcs);


            i = 0;
            while (i < items.len)
            {
                it = (Node*)items.items[i];
                i++;
                if (it.kind == NodeKind.FUNCTION_DEF) { ep_check_caller(@p, it); };
            };


            i = 0;
            while (i < items.len)
            {
                it = (Node*)items.items[i];
                i++;
                if (it.kind == NodeKind.FUNCTION_DEF) { ep_check_pure(@p, it); };
            };


            i = 0;
            while (i < r.user.ks.len)
            {
                it = (Node*)r.user.vs.items[i];
                if (it.a != (Node*)0) { ep_collect_constraints(@p, it.a, ss_key(r.user, i)); };
                i++;
            };
            i = 0;
            while (i < items.len)
            {
                it = (Node*)items.items[i];
                i++;
                if (it.kind == NodeKind.FUNCTION_DEF) { ep_check_conflicts(@p, it); };
            };


            i = 0;
            while (i < items.len)
            {
                it = (Node*)items.items[i];
                i++;
                if (it.kind == NodeKind.INTERFACE_DEF)
                {
                    ad = (OMap*)0;
                    if (it.a != (Node*)0) { ad = er_eval(r, it.a.a); };
                    c = bc_count(it, 1);
                    j = 0;
                    while (j < c)
                    {
                        prot = node_child(it, 1, j);
                        j++;
                        m = bc_count(prot, 0);
                        k = 0;
                        while (k < m)
                        {
                            meth = node_child(prot, 0, k);
                            k++;
                            es = (OMap*)om_get(r.fe, meth.text);
                            if (es == (OMap*)0) { continue; };
                            if (ad != (OMap*)0) { ep_check_boundary(@p, meth.text, es, it.text, ad); };
                        };
                    };
                    if (ad != (OMap*)0) { es_free(ad); };
                };
            };

            if (r.failed) { return -1; };
            if (on != (NameMap*)0)
            {
                PtrVec* kept = pv_new();
                EVio* ev;
                int vi;
                while (vi < p.vios.len)
                {
                    ev = (EVio*)p.vios.items[vi];
                    vi++;
                    if (ev.kind == 0 | ev.kind == 1)
                    {
                        if (!bc_owner_on(owners, on, ev.s1))
                        {
                            ffree((byte*)ev);
                            continue;
                        };
                    };
                    pv_push(kept, (void*)ev);
                };
                pv_free(p.vios);
                p.vios = kept;
            };
            ef_print_violations(p.vios, strict);
            ef_print_summary(p.vios, strict);
            return p.vios.len;
        };

        def effects_check_program(Node* prog, bool strict) -> int
        {
            return effects_check_filtered(prog, strict, (BcOwners*)0, (NameMap*)0);
        };
    };
};


















































































using IDEKA::lexer;
using IDEKA::preprocessor;
using IDEKA::ast;
using IDEKA::parser;
using IDEKA::types;
using IDEKA::borrow;

namespace IDEKA
{
    namespace modules
    {
        struct ModInfo
        {
            Node* node;
            byte* name, file, target, oname;
            PtrVec* deps;         
            PtrVec* locked;       
            PtrVec* using_ns;     
            PtrVec* platform;     
            PtrVec* requires;     
            bool borrow_check, effect_check, dce, debug, entry;
            bool expect_build_fail;   
            bool imported;        
        };



        struct FileMap
        {
            byte* path, src;
            int srclen, n;      
            int* lmap;          
            byte** lfiles;      
        };

        struct ModUnit
        {
            PtrVec* mods;         
            PtrVec* order;        
            PtrVec* programs;     
            NameMap* files;       
            NameMap* imports;     
            ModInfo* entry;
            byte* err;            
            byte* lerr;           
            PtrVec* warnings;     
            NameMap* unbuilt;     
            byte* root_file, srcdir;
            PtrVec* fmaps;        


            int* amap;
            byte** afiles;
            byte* asrc;
            int an, asrclen;
        };





        mu_has(PtrVec* v, byte* s) -> bool
        {
            int i;
            if (v == (PtrVec*)0) { -> false; };
            while (i < v.len)
            {
                if (cstr_eq((byte*)v.items[i], s)) { -> true; };
                i++;
            };
            -> false;
        };

        mu_find(ModUnit* u, byte* name) -> ModInfo*
        {
            int i;
            ModInfo* m;
            while (i < u.mods.len)
            {
                m = (ModInfo*)u.mods.items[i];
                if (cstr_eq(m.name, name)) { -> m; };
                i++;
            };
            -> (ModInfo*)0;
        };

        mu_in_order(ModUnit* u, ModInfo* m) -> bool
        {
            int i;
            while (i < u.order.len)
            {
                if ((ModInfo*)u.order.items[i] == m) { -> true; };
                i++;
            };
            -> false;
        };

        mu_fail(ModUnit* u, byte* msg) -> byte*
        {
            u.err = msg;
            -> msg;
        };

        mu_has_modules(Node* prog) -> bool
        {
            int i;
            int c = node_count(prog, 0);
            while (i < c)
            {
                if (node_child(prog, 0, i).kind == NodeKind.MODULE_DEF) { -> true; };
                i++;
            };
            -> false;
        };


        mu_dir(byte* file) -> byte*
        {
            int i, k;
            int last = -1;
            byte* d;
            while (file[i] != 0)
            {
                if (file[i] == '/' | file[i] == '\\') { last = i; };
                i++;
            };
            d = (byte*)fmalloc((u64)(last + 2));
            k = 0;
            while (k <= last)
            {
                d[k] = file[k];
                k++;
            };
            d[k] = 0;
            -> d;
        };

        mu_exists(byte* p) -> bool
        {
            void* f = fopen(p, g"rb\0");
            if (f == (void*)0) { -> false; };
            fclose(f);
            -> true;
        };

        mu_is_abs(byte* p) -> bool
        {
            if (p[0] == '/' | p[0] == '\\') { -> true; };
            if (p[0] != 0 & p[1] == ':') { -> true; };
            -> false;
        };



        mu_resolve_path(byte* spec, byte* from_file) -> byte*
        {
            byte* cand;
            if (mu_is_abs(spec))
            {
                if (mu_exists(spec)) { -> ts_dup(spec); };
                -> (byte*)0;
            };
            cand = join3_f(mu_dir(from_file), g"\0", spec, 1);
            if (mu_exists(cand)) { -> cand; };
            ffree(cand);
            if (mu_exists(spec)) { -> ts_dup(spec); };
            -> (byte*)0;
        };


        mu_tag_entry(Node* m, byte* tag) -> Node*
        {
            int i;
            int c = node_count(m, 2);
            Node* e, found;
            while (i < c)
            {
                e = node_child(m, 2, i);
                if (e.ival != 3 & cstr_eq(e.text, tag)) { found = e; };
                i++;
            };
            -> found;
        };

        mu_defines(Node* m, byte* fn) -> bool
        {
            int i;
            int c = node_count(m, 0);
            Node* f;
            while (i < c)
            {
                f = bc_unwrap_fn(node_child(m, 0, i));
                if (f.kind == NodeKind.FUNCTION_DEF)
                {

                    if ((f.flags `& 512) == 0)
                    {
                        if (cstr_eq(f.text, fn)) { -> true; };
                    };
                };
                i++;
            };
            -> false;
        };







        mu_register(ModUnit* u, byte* path, byte* src, int srclen, int* lmap, int n, byte** lfiles) -> void
        {
            FileMap* fm = (FileMap*)fmalloc((u64)((sizeof(FileMap) + 7) / 8));
            fm.path = path;
            fm.src = src;
            fm.srclen = srclen;
            fm.n = n;
            fm.lmap = lmap;
            fm.lfiles = lfiles;
            pv_push(u.fmaps, (void*)fm);
            ->;
        };

        mu_file_map(ModUnit* u, byte* path) -> FileMap*
        {
            int i;
            FileMap* fm;
            while (i < u.fmaps.len)
            {
                fm = (FileMap*)u.fmaps.items[i];
                if (cstr_eq(fm.path, path)) { -> fm; };
                i++;
            };
            -> (FileMap*)0;
        };



        mu_parse_file(ModUnit* u, byte* path, byte* srcdir, byte** err) -> Node*
        {
            Preprocessor pp(path);
            Node* prog;
            pp.verbose = false;
            if (srcdir != (byte*)0) { pp.set_srcdir(srcdir); };
            pp.add_default_macros();
            if (!pp.process())
            {
                *err = join3_f(g"from \"\0", path, join3(g"\": preprocessor error: \0", pp.err_text(), g"\0"), 4);
                -> (Node*)0;
            };
            byte* src = pp.text_ptr();
            int len = pp.text_len();
            Lexer lx(src, len);
            if (!lx.tokenize())
            {
                *err = join3(g"from \"\0", path, g"\": lexer error\0");
                -> (Node*)0;
            };
            Parser ps(@lx);
            ps.st = st_new();
            ps.lmap = pp.map_line.arr;
            ps.lmapn = pp.map_line.len;
            ps.lfiles = pp.line_files();
            prog = ps.parse();
            if (ps.failed)
            {
                Buf perr;
                perr.__init();
                switch (ps.err_kind != ParseErr.SILENT) { case (true) { ps.render_error(@perr); println(perr.mem); } default {}; };
                perr.__exit();
                *err = join3(g"from \"\0", path, g"\": parse error\0");
                -> (Node*)0;
            };
            mu_register(u, path, src, len, pp.map_line.arr, pp.map_line.len, pp.line_files());
            -> prog;
        };

        mu_new_info(Node* m, byte* file, bool imported) -> ModInfo*
        {
            ModInfo* mi = (ModInfo*)fmalloc((u64)((sizeof(ModInfo) + 7) / 8));
            mi
            {
                .node = m;
                .name = m.text;
                .file = file;
                .target = g"executable\0";
                .oname = m.text;
                .deps = pv_new();
                .locked = pv_new();
                .using_ns = pv_new();
                .platform = pv_new();
                .requires = pv_new();
                .borrow_check = false;
                .effect_check = false;
                .dce = true;
                .debug = false;
                .expect_build_fail = false;
                .entry = false;
                .imported = imported;
            };
            m.text2 = file;
            -> mi;
        };


        mu_add(ModUnit* u, Node* m, byte* file, bool imported) -> byte*
        {
            ModInfo* old = mu_find(u, m.text);
            if (old != (ModInfo*)0)
            {
                if (!cstr_eq(old.file, file))
                {
                    -> join3_f(join3(g"module '\0", m.text, g"' is declared in both \0"), old.file, join3(g" and \0", file, g"\0"), 5);
                };
                -> (byte*)0;
            };
            pv_push(u.mods, (void*)mu_new_info(m, file, imported));
            -> (byte*)0;
        };


        mu_note_import(ModUnit* u, byte* file, Node* m) -> void
        {
            PtrVec* v = (PtrVec*)nm_get(u.imports, file);
            if (v == (PtrVec*)0)
            {
                v = pv_new();
                nm_put(u.imports, file, (void*)v);
            };
            pv_push(v, (void*)m);
            ->;
        };


        mu_import_of(ModUnit* u, byte* file, byte* name) -> Node*
        {
            int i;
            PtrVec* v = (PtrVec*)nm_get(u.imports, file);
            if (v == (PtrVec*)0) { -> (Node*)0; };
            while (i < v.len)
            {
                if (cstr_eq(((Node*)v.items[i]).text, name)) { -> (Node*)v.items[i]; };
                i++;
            };
            -> (Node*)0;
        };




        mu_load_import(ModUnit* u, byte* from_file, Node* imp) -> ModInfo*
        {
            int j;
            Node* prog, m;
            byte* path, ferr;
            bool kept;
            PtrVec* names;
            ModInfo* d;
            byte* name = imp.text;
            path = mu_resolve_path(node_child(imp, 1, 0).text, from_file);
            if (path == (byte*)0)
            {
                u.lerr = join3_f(join3(g"module \0", name, g" from \""), node_child(imp, 1, 0).text,
                               join3(g"\": file not found (looked in \0", mu_dir(from_file), g" and the working directory)\0"), 5);
                -> (ModInfo*)0;
            };
            kept = false;
            if (!nm_has(u.files, path))
            {
                ferr = (byte*)0;
                prog = mu_parse_file(u, path, u.srcdir, @ferr);
                if (prog == (Node*)0)
                {
                    ffree(path);
                    u.lerr = ferr;
                    -> (ModInfo*)0;
                };
                kept = true;
                names = pv_new();
                j = 0;
                while (j < node_count(prog, 0))
                {
                    m = node_child(prog, 0, j);
                    j++;
                    if (m.kind != NodeKind.MODULE_DEF) { continue; };
                    if (m.ival == 1)
                    {
                        mu_note_import(u, path, m);
                        continue;
                    };
                    ferr = mu_add(u, m, path, true);
                    if (ferr != (byte*)0)
                    {
                        pv_free(names);
                        u.lerr = ferr;
                        -> (ModInfo*)0;
                    };
                    pv_push(names, (void*)m.text);
                };
                nm_put(u.files, path, (void*)names);
            };
            names = (PtrVec*)nm_get(u.files, path);
            d = (ModInfo*)0;
            if (mu_has(names, name)) { d = mu_find(u, name); };
            if (d == (ModInfo*)0)
            {
                u.lerr = join3_f(join3(g"module \0", name, g" from \""), node_child(imp, 1, 0).text, g"\": the file declares no module '\0", 1);
                u.lerr = join3_f(u.lerr, name, g"'\0", 1);
            };

            if (!kept) { ffree(path); };
            -> d;
        };




        mu_lookup(ModUnit* u, ModInfo* info, byte* name) -> ModInfo*
        {
            Node* imp;
            ModInfo* d = mu_find(u, name);
            imp = mu_import_of(u, info.file, name);
            if (d != (ModInfo*)0 & imp == (Node*)0)
            {
                if (cstr_eq(d.file, info.file)) { -> d; };
            };
            if (imp == (Node*)0)
            {
                u.lerr = join3_f(join3(g"module '\0", info.name, g"': '#[requires]' names module '\0"),
                               name, g"', which is not declared in this file and has no 'module \0", 1);
                u.lerr = join3_f(u.lerr, name, g" from \"file.idk\";' import\0", 1);
                -> (ModInfo*)0;
            };
            if (d != (ModInfo*)0)
            {
                if (cstr_eq(d.file, info.file))
                {
                    u.lerr = join3_f(join3(g"module '\0", name, g"' is both declared in and imported into \0"), info.file, g"\0", 1);
                    -> (ModInfo*)0;
                };
            };
            -> mu_load_import(u, info.file, imp);
        };


        mu_visit(ModUnit* u, ModInfo* info, PtrVec* loading) -> byte*
        {
            int i;
            byte* err;
            ModInfo* dep;
            if (mu_has(loading, info.name))
            {
                byte* chain = ts_dup(g"\0");
                i = 0;
                while (i < loading.len)
                {
                    chain = join3_f(chain, (byte*)loading.items[i], g" -> \0", 1);
                    i++;
                };
                -> join3_f(g"modules depend on each other: \0", chain, info.name, 2);
            };
            if (mu_in_order(u, info)) { -> (byte*)0; };
            pv_push(loading, (void*)info.name);

            Node* rq = mu_tag_entry(info.node, g"requires\0");
            if (rq != (Node*)0)
            {
                if (rq.ival != 2)
                {
                    -> join3(g"module '\0", info.name, g"': '#[requires]' takes a list: {A, B}\0");
                };
                i = 0;
                byte* rname;
                while (i < node_count(rq, 0))
                {
                    rname = node_child(rq, 0, i).text;
                    i++;
                    if (cstr_eq(rname, info.name))
                    {
                        -> join3(g"module '\0", info.name, g"' cannot require itself\0");
                    };
                    err = (byte*)0;
                    dep = mu_lookup(u, info, rname);
                    if (dep == (ModInfo*)0) { -> u.lerr; };
                    if (!mu_has(info.deps, rname)) { pv_push(info.deps, (void*)rname); };
                    err = mu_visit(u, dep, loading);
                    if (err != (byte*)0) { -> err; };
                };
            };
            loading.len = loading.len - 1;
            pv_push(u.order, (void*)info);
            -> (byte*)0;
        };



        mu_load(Node* prog, byte* root_file, byte* select, byte* entry_fn, byte* srcdir) -> ModUnit*
        {
            ModUnit* u = (ModUnit*)fmalloc((u64)((sizeof(ModUnit) + 7) / 8));
            PtrVec* root = pv_new();
            PtrVec* marked = pv_new();
            PtrVec* loading = pv_new();
            defer pv_free(root);
            defer pv_free(marked);
            defer pv_free(loading);
            Node* m, t;
            byte* err;
            ModInfo* ei;
            int i;
            u
            {
                .mods = pv_new();
                .order = pv_new();
                .programs = pv_new();
                .files = nm_new();
                .imports = nm_new();
                .entry = (ModInfo*)0;
                .err = (byte*)0;
                .lerr = (byte*)0;
                .warnings = pv_new();
                .unbuilt = nm_new();
                .root_file = root_file;
                .srcdir = srcdir;
                .fmaps = pv_new();
                .amap = (int*)0;
                .afiles = (byte**)0;
                .asrc = (byte*)0;
                .an = 0;
                .asrclen = 0;
            };

            i = 0;
            while (i < node_count(prog, 0))
            {
                m = node_child(prog, 0, i);
                i++;
                if (m.kind == NodeKind.MODULE_DEF)
                {
                    if (m.ival == 1) { mu_note_import(u, root_file, m); }
                    else { pv_push(root, (void*)m); };
                };
            };
            i = 0;
            while (i < root.len)
            {
                m = (Node*)root.items[i];
                i++;
                err = mu_add(u, m, root_file, false);
                if (err != (byte*)0) { mu_fail(u, err); -> u; };
                t = mu_tag_entry(m, g"entrypoint\0");
                if (t != (Node*)0)
                {
                    if (t.text2 != (byte*)0)
                    {
                        if (cstr_eq(t.text2, g"this\0")) { pv_push(marked, (void*)m.text); };
                    };
                };
            };
            i = 0;
            while (i < root.len)
            {
                m = (Node*)root.items[i];
                i++;
                if (mu_has(marked, m.text) | mu_defines(m, entry_fn)) { pv_push(u.programs, (void*)m.text); };
            };

            PtrVec* rimps = (PtrVec*)nm_get(u.imports, root_file);
            ModInfo* imi;
            i = 0;
            if (rimps == (PtrVec*)0) { rimps = pv_new(); nm_put(u.imports, root_file, (void*)rimps); };
            while (i < rimps.len)
            {
                imi = mu_find(u, ((Node*)rimps.items[i]).text);
                if (imi != (ModInfo*)0) { if (!cstr_eq(imi.file, root_file)) { imi = (ModInfo*)0; }; };
                if (imi != (ModInfo*)0)
                {
                    mu_fail(u, join3_f(join3(g"module '\0", ((Node*)rimps.items[i]).text, g"' is both declared in and imported into \0"), root_file, g"\0", 1));
                    -> u;
                };
                imi = mu_load_import(u, root_file, (Node*)rimps.items[i]);
                if (imi == (ModInfo*)0) { mu_fail(u, u.lerr); -> u; };
                if (!mu_has(u.programs, imi.name)) { pv_push(u.programs, (void*)imi.name); };
                i++;
            };
            if (u.programs.len == 0)
            {
                mu_fail(u, join3_f(join3(g"no module in \0", root_file, g" defines \0"), entry_fn, g"() or sets '#[entrypoint] = this'\0", 1));
                -> u;
            };
            if (select != (byte*)0)
            {
                if (!mu_has(u.programs, select))
                {
                    mu_fail(u, join3(g"module '\0", select, g"' is not a program of this file\0"));
                    -> u;
                };
                ei = mu_find(u, select);
            }
            elif (marked.len > 0)
            {
                ei = mu_find(u, (byte*)marked.items[0]);
            }
            else
            {
                ei = mu_find(u, (byte*)u.programs.items[0]);
            };
            ei.entry = true;
            u.entry = ei;

            err = mu_visit(u, ei, loading);
            if (err != (byte*)0) { mu_fail(u, err); -> u; };
            -> u;
        };





        mu_known_tag(byte* t) -> bool
        {
            -> cstr_eq(t, g"entrypoint\0") | cstr_eq(t, g"name\0") | cstr_eq(t, g"target\0")
                 | cstr_eq(t, g"debug\0") | cstr_eq(t, g"borrow_check\0") | cstr_eq(t, g"effect_check\0")
                 | cstr_eq(t, g"dce\0") | cstr_eq(t, g"using\0") | cstr_eq(t, g"platform\0")
                 | cstr_eq(t, g"requires\0") | cstr_eq(t, g"test\0");
        };

        mu_is_bool_tag(byte* t) -> bool
        {
            -> cstr_eq(t, g"borrow_check\0") | cstr_eq(t, g"effect_check\0")
                 | cstr_eq(t, g"dce\0") | cstr_eq(t, g"debug\0");
        };

        mu_is_target(byte* t) -> bool
        {
            -> cstr_eq(t, g"bootloader\0") | cstr_eq(t, g"executable\0") | cstr_eq(t, g"compact\0")
                 | cstr_eq(t, g"library\0") | cstr_eq(t, g"driver\0");
        };

        mu_list_of(Node* e) -> PtrVec*
        {
            PtrVec* v = pv_new();
            int i;
            while (i < node_count(e, 0))
            {
                pv_push(v, (void*)node_child(e, 0, i).text);
                i++;
            };
            -> v;
        };


        mu_apply(ModInfo* mi, Node* e) -> byte*
        {
            byte* tag = e.text;
            if (mu_is_bool_tag(tag))
            {
                if (e.ival != 1) { -> join3_f(join3(g"module '\0", mi.name, g"': '#[\0"), tag, g"]' takes true or false\0", 1); };
                bool v = e.op != 0;
                if (cstr_eq(tag, g"borrow_check\0")) { mi.borrow_check = v; }
                elif (cstr_eq(tag, g"effect_check\0")) { mi.effect_check = v; }
                elif (cstr_eq(tag, g"dce\0")) { mi.dce = v; }
                else { mi.debug = v; };
                -> (byte*)0;
            };
            if (cstr_eq(tag, g"test\0"))
            {
                if (e.ival != 4) { -> join3_f(join3(g"module '\0", mi.name, g"': '#[test]' takes a block: = { #[subtag] }\0"), g"\0", g"\0", 1); };
                bool ebf = false;
                int ti2 = 0;
                Node* se;
                while (ti2 < node_count(e, 1))
                {
                    se = node_child(e, 1, ti2);
                    ti2++;
                    if (!cstr_eq(se.text, g"expect_build_fail\0"))
                    {
                        -> join3_f(join3(g"module '\0", mi.name, g"': unknown test tag '#[\0"), se.text,
                                     g"]' in '#[test]' (known: expect_build_fail)\0", 1);
                    };
                    if (se.ival != 1)
                    {
                        -> join3_f(join3(g"module '\0", mi.name, g"': '#[test]' subtag '#[\0"), se.text,
                                     g"]' takes true or false\0", 1);
                    };
                    ebf = se.op != 0;
                };
                mi.expect_build_fail = ebf;
                -> (byte*)0;
            };
            if (cstr_eq(tag, g"using\0") | cstr_eq(tag, g"platform\0") | cstr_eq(tag, g"requires\0"))
            {
                if (e.ival != 2) { -> join3_f(join3(g"module '\0", mi.name, g"': '#[\0"), tag, g"]' takes a list: {A, B}\0", 1); };
                if (cstr_eq(tag, g"using\0")) { pv_free(mi.using_ns); mi.using_ns = mu_list_of(e); }
                elif (cstr_eq(tag, g"requires\0")) { pv_free(mi.requires); mi.requires = mu_list_of(e); }
                else { pv_free(mi.platform); mi.platform = mu_list_of(e); };
                -> (byte*)0;
            };
            if (e.ival != 0 | e.text2 == (byte*)0)
            {
                -> join3_f(join3(g"module '\0", mi.name, g"': '#[\0"), tag, g"]' takes a single name\0", 1);
            };
            if (cstr_eq(tag, g"name\0")) { mi.oname = e.text2; }
            else { mi.target = e.text2; };
            -> (byte*)0;
        };

        mu_lower_eq(byte* a, byte* b) -> bool
        {
            int i;
            byte x, y;
            while (a[i] != 0 & b[i] != 0)
            {
                x = a[i];
                y = b[i];
                if (x >= 'A' & x <= 'Z') { x = (byte)(x + 32); };
                if (y >= 'A' & y <= 'Z') { y = (byte)(y + 32); };
                if (x != y) { -> false; };
                i++;
            };
            -> a[i] == 0 & b[i] == 0;
        };


        mu_resolve_settings(ModUnit* u, bool cli_borrow, bool cli_effects, byte* platform) -> byte*
        {
            int i, j, k, q;
            Node* e, oe, t;
            ModInfo* mi, ti, cur;
            byte* err, key;
            NameMap* applied = nm_new();
            PtrVec* queue = pv_new();
            PtrVec* seen = pv_new();
            defer nm_free(applied);
            defer pv_free(queue);
            defer pv_free(seen);
            bool found;

            i = 0;
            while (i < u.order.len)
            {
                mi = (ModInfo*)u.order.items[i];
                i++;
                j = 0;
                while (j < node_count(mi.node, 2))
                {
                    e = node_child(mi.node, 2, j);
                    j++;
                    if (e.ival == 3) { continue; };
                    if (!mu_known_tag(e.text))
                    {
                        -> join3_f(join3(g"module '\0", mi.name, g"': unknown build tag '#[\0"), e.text, g"]'\0", 1);
                    };
                    if (cstr_eq(e.text, g"entrypoint\0")) { continue; };
                    err = mu_apply(mi, e);
                    if (err != (byte*)0) { -> err; };
                    if ((e.flags `& 1) != 0) { pv_push(mi.locked, (void*)e.text); };
                };
                if (!mu_is_target(mi.target))
                {
                    -> join3_f(join3(g"module '\0", mi.name, g"': '#[target] = \0"), mi.target,
                                 g"' is not one of bootloader, executable, compact, library, driver\0", 1);
                };
            };


            pv_push(queue, (void*)u.entry);
            pv_push(seen, (void*)u.entry);
            q = 0;
            while (q < queue.len)
            {
                cur = (ModInfo*)queue.items[q];
                q++;
                j = 0;
                while (j < node_count(cur.node, 2))
                {
                    e = node_child(cur.node, 2, j);
                    j++;
                    if (e.ival != 3) { continue; };
                    k = 0;
                    while (k < node_count(e, 2))
                    {
                        t = node_child(e, 2, k);
                        k++;
                        ti = mu_find(u, t.text);
                        if (ti == (ModInfo*)0)
                        {
                            -> join3_f(join3(g"module '\0", cur.name, g"': '#[override for {\0"), t.text,
                                         g"}]' names a module that is not part of this build\0", 1);
                        };
                        if (!mu_has(cur.deps, t.text))
                        {
                            -> join3_f(join3(g"module '\0", cur.name, g"': cannot override module '\0"), t.text,
                                     join3_f(join3(g"' because '\0", cur.name, g"' does not use it. Add '#[requires] = {\0"),
                                           t.text, join3(g"}' to the build settings of '\0", cur.name, g"' first\0"), 5), 5);
                        };
                        i = 0;
                        while (i < node_count(e, 1))
                        {
                            oe = node_child(e, 1, i);
                            i++;
                            if (!mu_known_tag(oe.text) | cstr_eq(oe.text, g"entrypoint\0"))
                            {
                                -> join3_f(join3(g"module '\0", cur.name, g"': cannot override '#[\0"), oe.text, g"]'\0", 1);
                            };
                            key = join3(t.text, g":\0", oe.text);
                            if (mu_has(ti.locked, oe.text))
                            {
                                pv_push(u.warnings, (void*)join3_f(join3_f(join3(g"module '\0", cur.name, g"': '#[override for {\0"), t.text,
                                    join3(g"}]' sets '#[\0", oe.text, g"]', but module '\0"), 5),
                                    ti.name, g"' locked it with '!+'; the override is ignored\0", 1));
                                ffree(key);
                                continue;
                            };
                            if (nm_has(applied, key))
                            {
                                ffree(key);
                                continue;
                            };
                            err = mu_apply(ti, oe);
                            if (err != (byte*)0)
                            {
                                ffree(key);
                                -> err;
                            };
                            nm_put(applied, key, (void*)1);
                            ffree(key);
                        };
                    };
                };
                j = 0;
                while (j < cur.deps.len)
                {
                    ti = mu_find(u, (byte*)cur.deps.items[j]);
                    j++;
                    found = false;
                    k = 0;
                    while (k < seen.len)
                    {
                        if ((ModInfo*)seen.items[k] == ti) { found = true; };
                        k++;
                    };
                    if (!found)
                    {
                        pv_push(seen, (void*)ti);
                        pv_push(queue, (void*)ti);
                    };
                };
            };

            i = 0;
            byte* plist;
            while (i < u.order.len)
            {
                mi = (ModInfo*)u.order.items[i];
                i++;
                if (cli_borrow) { mi.borrow_check = true; };
                if (cli_effects) { mi.effect_check = true; };
                if (mi.platform.len > 0 & platform != (byte*)0)
                {
                    found = false;
                    k = 0;
                    while (k < mi.platform.len)
                    {
                        if (mu_lower_eq((byte*)mi.platform.items[k], platform)) { found = true; };
                        k++;
                    };
                    if (!found)
                    {
                        plist = ts_dup(g"\0");
                        k = 0;
                        while (k < mi.platform.len)
                        {
                            if (k > 0) { plist = join3_f(plist, g", \0", g"\0", 1); };
                            plist = join3_f(plist, (byte*)mi.platform.items[k], g"\0", 1);
                            k++;
                        };
                        -> join3_f(join3(g"module '\0", mi.name, g"' builds for {\0"), plist,
                                     join3(g"} but this build targets \0", platform, g"\0"), 7);
                    };
                };
            };
            -> (byte*)0;
        };






        mu_line_range(Node* n, int* mn, int* mx) -> void
        {
            int s, i, c;
            if (n == (Node*)0) { ->; };
            if (n.line > 0)
            {
                if (n.line < *mn) { *mn = n.line; };
                if (n.line > *mx) { *mx = n.line; };
            };
            mu_line_range(n.a, mn, mx);
            mu_line_range(n.b, mn, mx);
            mu_line_range(n.c, mn, mx);
            mu_line_range(n.d, mn, mx);
            mu_line_range(n.e, mn, mx);
            s = 0;
            while (s < 6)
            {
                c = node_count(n, s);
                i = 0;
                while (i < c)
                {
                    mu_line_range(node_child(n, s, i), mn, mx);
                    i++;
                };
                s++;
            };
            ->;
        };

        mu_shift_lines(Node* n, int d) -> void
        {
            int s, i, c;
            if (n == (Node*)0) { ->; };
            if (n.line > 0) { n.line = n.line + d; };
            mu_shift_lines(n.a, d);
            mu_shift_lines(n.b, d);
            mu_shift_lines(n.c, d);
            mu_shift_lines(n.d, d);
            mu_shift_lines(n.e, d);
            s = 0;
            while (s < 6)
            {
                c = node_count(n, s);
                i = 0;
                while (i < c)
                {
                    mu_shift_lines(node_child(n, s, i), d);
                    i++;
                };
                s++;
            };
            ->;
        };


        mu_mangle_ns(byte* ns) -> byte*
        {
            int i, n, k;
            byte* r;
            while (ns[n] != 0) { n++; };
            r = (byte*)fmalloc((u64)(n * 2 + 2));
            while (ns[i] != 0)
            {
                if (ns[i] == '.')
                {
                    r[k] = '_';
                    r[k + 1] = '_';
                    k = k + 2;
                    i++;
                }
                elif (ns[i] == ':' & ns[i + 1] == ':')
                {
                    r[k] = '_';
                    r[k + 1] = '_';
                    k = k + 2;
                    i = i + 2;
                }
                else
                {
                    r[k] = ns[i];
                    k++;
                    i++;
                };
            };
            r[k] = 0;
            -> r;
        };


        mu_built_defines(ModUnit* u, byte* name) -> bool
        {
            int i;
            while (i < u.order.len)
            {
                if (mu_defines(((ModInfo*)u.order.items[i]).node, name)) { -> true; };
                i++;
            };
            -> false;
        };




        mu_origin_key(FileMap* fm, Node* s) -> byte*
        {
            Buf b;
            byte* r;
            int ln = s.line;
            if (fm == (FileMap*)0) { -> (byte*)0; };
            if (ln < 1 | ln > fm.n) { -> (byte*)0; };
            b.__init();
            defer b.__exit();
            b.put_str(fm.lfiles[ln - 1]);
            b.put(58);
            b.put_int(fm.lmap[ln - 1]);
            b.put(58);
            b.put_int(s.col);
            b.put(58);
            b.put_int((int)s.kind);
            b.put(58);
            if (s.text != (byte*)0) { b.put_str(s.text); };
            b.put(0);
            r = ts_dup(b.mem);
            -> r;
        };


        mu_copy_lines(Buf* out, byte* src, int len, int first, int last) -> void
        {
            int ln = 1;
            int p = 0;
            int s0;
            while (p < len & ln < first)
            {
                if (src[p] == 10) { ln++; };
                p++;
            };
            s0 = p;
            while (p < len & ln <= last)
            {
                if (src[p] == 10)
                {
                    if (ln == last) { break; };
                    ln++;
                };
                p++;
            };
            out.put_n(src + s0, p - s0);
            ->;
        };














        mu_flatten(Node* prog, ModUnit* u, byte* entry_fn) -> void
        {
            NodeVec* nv = nv_new();
            ModInfo* mi;
            Node* s, f, us;
            int i, j, c, mn, mx, top, mtop, cend, d;
            FileMap* fm;
            FileMap* rootfm = mu_file_map(u, u.root_file);
            IntVec amap;
            PtrVec* afiles = pv_new();
            Buf asrc;
            NameMap* seen = nm_new();
            byte* key;
            defer nm_free(seen);

            amap.__init();
            asrc.__init();
            if (rootfm != (FileMap*)0) { cend = rootfm.n; };

            c = node_count(prog, 0);
            i = 0;
            while (i < c)
            {
                s = node_child(prog, 0, i);
                i++;
                if (s.kind == NodeKind.MODULE_DEF) { continue; };
                nv_push(nv, s);
                mn = 2147483647;
                mx = 0;
                mu_line_range(s, @mn, @mx);
                if (mx > top) { top = mx; };
            };
            if (cend > top) { top = cend; };

            i = 0;
            NodeVec* kept;
            while (i < u.order.len)
            {
                mi = (ModInfo*)u.order.items[i];
                i++;
                fm = mu_file_map(u, mi.file);
                kept = nv_new();
                j = 0;
                c = node_count(mi.node, 0);
                while (j < c)
                {
                    s = node_child(mi.node, 0, j);
                    j++;
                    f = bc_unwrap_fn(s);

                    if (!mi.entry)
                    {

                        if (f.kind == NodeKind.FUNCTION_DEF & cstr_eq(f.text, entry_fn) & (f.flags `& 512) == 0) { continue; };
                    };
                    key = mu_origin_key(fm, s);
                    if (key != (byte*)0)
                    {
                        if (nm_has(seen, key))
                        {
                            ffree(key);
                            continue;
                        };
                        nm_put(seen, key, (void*)1);
                        ffree(key);
                    };
                    nv_push(kept, s);
                };
                mi.node.l0 = kept;
                mn = 2147483647;
                mx = 0;
                mu_line_range(mi.node, @mn, @mx);
                if (mx == 0) { mn = top + 1; mx = top + 1; }
                elif (fm != (FileMap*)0 & mx <= fm.n)
                {

                    d = cend + 1 - mn;
                    mu_shift_lines(mi.node, d);
                    j = mn;
                    while (j <= mx)
                    {
                        amap.push(fm.lmap[j - 1]);
                        pv_push(afiles, (void*)fm.lfiles[j - 1]);
                        j++;
                    };
                    if (asrc.len > 0) { asrc.put(10); };
                    mu_copy_lines(@asrc, fm.src, fm.srclen, mn, mx);
                    cend = cend + (mx - mn + 1);
                    mx = mx + d;
                    mn = mn + d;
                    if (top < cend) { top = cend; };
                }
                elif (mn <= top)
                {
                    mu_shift_lines(mi.node, top - mn + 1);
                    mx = mx + (top - mn + 1);
                };
                mtop = mx;
                j = 0;
                while (j < mi.using_ns.len)
                {
                    us = node_new(NodeKind.USING_STATEMENT, mi.node.line, mi.node.col);
                    us.text = mu_mangle_ns((byte*)mi.using_ns.items[j]);
                    nv_push(nv, us);
                    j++;
                };
                c = node_count(mi.node, 0);
                j = 0;
                while (j < c)
                {
                    nv_push(nv, node_child(mi.node, 0, j));
                    j++;
                };
                if (mtop > top) { top = mtop; };
            };
            prog.l0 = nv;
            u.amap = amap.arr;
            u.an = amap.len;
            u.afiles = (byte**)afiles.items;
            u.asrc = asrc.mem;
            u.asrclen = asrc.len;



            i = 0;
            while (i < u.mods.len)
            {
                mi = (ModInfo*)u.mods.items[i];
                i++;
                if (mu_in_order(u, mi)) { continue; };
                c = node_count(mi.node, 0);
                j = 0;
                while (j < c)
                {
                    f = bc_unwrap_fn(node_child(mi.node, 0, j));
                    j++;
                    if (f.kind != NodeKind.FUNCTION_DEF) { continue; };
                    if (nm_has(u.unbuilt, f.text)) { continue; };
                    if (mu_built_defines(u, f.text)) { continue; };
                    nm_put(u.unbuilt, f.text, (void*)mi.name);
                };
            };
            ->;
        };





        struct ModMap
        {
            BcOwners* own;
            NameMap* on_borrow; 
            NameMap* on_effect;
        };




        mu_free(ModUnit* u) -> void
        {
            int i, k;
            ModInfo* mi;
            ModInfo* pm;
            bool seen;
            if (u == (ModUnit*)0) { ->; };
            while (i < u.mods.len)
            {
                mi = (ModInfo*)u.mods.items[i];
                if (mi.imported)
                {
                    seen = false;
                    k = 0;
                    while (k < i)
                    {
                        pm = (ModInfo*)u.mods.items[k];
                        if (pm.file == mi.file) { seen = true; };
                        k++;
                    };
                    if (!seen) { ffree(mi.file); };
                };
                pv_free(mi.deps);
                pv_free(mi.locked);
                pv_free(mi.using_ns);
                pv_free(mi.platform);
                pv_free(mi.requires);
                ffree((byte*)mi);
                i++;
            };
            i = 0;
            while (i < u.files.count)
            {
                pv_free((PtrVec*)u.files.vals[i]);
                i++;
            };
            i = 0;
            while (i < u.warnings.len)
            {
                ffree((byte*)u.warnings.items[i]);
                i++;
            };
            if (u.err != (byte*)0) { ffree(u.err); };
            i = 0;
            while (i < u.fmaps.len)
            {
                ffree((byte*)u.fmaps.items[i]);
                i++;
            };
            pv_free(u.fmaps);
            pv_free(u.mods);
            pv_free(u.order);
            pv_free(u.programs);
            pv_free(u.warnings);
            nm_free(u.files);
            i = 0;
            while (i < u.imports.count)
            {
                pv_free((PtrVec*)u.imports.vals[i]);
                i++;
            };
            nm_free(u.imports);
            nm_free(u.unbuilt);
            ffree((byte*)u);
            ->;
        };




        mu_func_map(ModUnit* u) -> ModMap*
        {
            ModMap* mm = (ModMap*)fmalloc((u64)((sizeof(ModMap) + 7) / 8));
            ModInfo* mi;
            Node* tmp;
            int i, j;
            byte* bare;
            mm.own = (BcOwners*)fmalloc((u64)((sizeof(BcOwners) + 7) / 8));
            mm.own.full = nm_new();
            mm.own.bare = nm_new();
            mm
            {
                .on_borrow = nm_new();
                .on_effect = nm_new();
            };
            CallGraph cg;
            while (i < u.order.len)
            {
                mi = (ModInfo*)u.order.items[i];
                i++;
                if (mi.borrow_check) { nm_put(mm.on_borrow, mi.name, (void*)1); };
                if (mi.effect_check) { nm_put(mm.on_effect, mi.name, (void*)1); };
                tmp = node_new(NodeKind.PROGRAM, 1, 1);
                j = 0;
                while (j < node_count(mi.node, 0))
                {
                    node_push(tmp, 0, node_child(mi.node, 0, j));
                    j++;
                };
                cg.__init();
                cg.collect(tmp);
                j = 0;
                while (j < cg.funcs.count)
                {
                    nm_put(mm.own.full, (byte*)cg.funcs.keys[j], (void*)mi.name);
                    bare = bc_last_seg((byte*)cg.funcs.keys[j]);
                    if (!nm_has(mm.own.bare, bare)) { nm_put(mm.own.bare, bare, (void*)mi.name); };
                    ffree(bare);
                    j++;
                };
                cg.__exit();

                if (tmp.l0 != (NodeVec*)0) { tmp.l0.len = 0; };
                node_free(tmp);
            };
            -> mm;
        };

        mm_free(ModMap* mm) -> void
        {
            if (mm == (ModMap*)0) { ->; };
            nm_free(mm.own.full);
            nm_free(mm.own.bare);
            ffree((byte*)mm.own);
            nm_free(mm.on_borrow);
            nm_free(mm.on_effect);
            ffree((byte*)mm);
            ->;
        };


        mu_live_modules(ModMap* mm, Node* prog) -> NameMap*
        {
            NameMap* live = nm_new();
            CallGraph cg;
            int j;
            byte* owner;
            cg.__init();
            cg.collect(prog);
            while (j < cg.funcs.count)
            {
                owner = bc_owner_of(mm.own, (byte*)cg.funcs.keys[j]);
                if (owner != (byte*)0) { nm_put(live, owner, (void*)1); };
                j++;
            };
            cg.__exit();
            -> live;
        };


        mu_dce_roots(ModUnit* u, ModMap* mm) -> PtrVec*
        {
            PtrVec* r = pv_new();
            int i;
            ModInfo* mi;
            while (i < mm.own.full.count)
            {
                mi = mu_find(u, (byte*)mm.own.full.vals[i]);
                if (mi != (ModInfo*)0)
                {
                    if (!mi.dce) { pv_push(r, mm.own.full.keys[i]); };
                };
                i++;
            };
            -> r;
        };
    };
};



