                                                -> true;
                                            }
                                            default {};
                                        };
                                    }
                                    default {};
                                };
                                this.visit_expr(n.a);
                                this.emits(62, n.text);
                                -> true;
                            }
                            default {};
                        };
                        switch (nm_has(this.bglobals, vn) | nm_has(this.oglobals, vn))
                        {
                            case (true)
                            {
                                this.visit_expr(n.a);
                                this.emits(62, n.text);
                                -> true;
                            }
                            default {};
                        };

                        ed = (Node*)nm_get(this.enums, vn);
