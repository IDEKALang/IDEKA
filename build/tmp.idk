                                                                                                                                                                                                                            default
                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                switch (this.match(g"?=", 2))
                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                    case (true) { *ttype = TokenType.TERNARY_ASSIGN; -> 2; }
                                                                                                                                                                                                                                    default
                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                        switch (this.match(g"!?", 2))
                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                            case (true) { *ttype = TokenType.NOT_NULL; -> 2; }
                                                                                                                                                                                                                                            default
