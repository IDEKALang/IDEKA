                switch (n.a.kind != NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        this.fail(n, g"fvmcodegen: range assignment target must be a simple identifier in comptime\0");
                        -> false;
                    }
                    default {};
                };
                arr = this.alloc_local(n.a.text);
                ctr = this.alloc_local(this.fresh_tmp());
                st = this.alloc_local(this.fresh_tmp());
                en = this.alloc_local(this.fresh_tmp());
                fl = this.alloc_local(this.fresh_tmp());
                this.visit_expr(n.b);
                this.emit1(51, (i64)st);
                this.visit_expr(n.c);
                this.emit1(51, (i64)en);
                this.visit_expr(n.d);
                this.emit1(51, (i64)fl);
                this.emit1(50, (i64)st);
                this.emit1(51, (i64)ctr);
                cond = this.ip();
                this.emit1(50, (i64)ctr);
                this.emit1(50, (i64)en);
                this.emit0(32);
                jend = this.emit1(40, (i64)0);
                this.emit1(50, (i64)arr);
                this.emit1(50, (i64)ctr);
                this.emit1(50, (i64)fl);
                this.emit0(70);
                this.emit1(51, (i64)arr);
                this.emit1(50, (i64)ctr);
                this.emit_push(0, (i64)1);
                this.emit0(6);
                this.emit1(51, (i64)ctr);
                this.emit1(38, (i64)cond);
                this.patch_at(jend, 40, this.ip());
                -> false;
            };

            visit_compound_assign(Node* n) -> bool
            {
                Node* t = n.a;
