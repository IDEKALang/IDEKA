                            case (true) { ->; }
                            default
                            {
                                pv_push(path, (void*)obj);
                                switch (!nm_has(this.pobjs, obj))
                                {
                                    case (true) {
                                    this.error(this.cat2(this.cat2(this.cat2(this.cat2(g"Inheritance error: '\0", obj), g"' must be fully defined before '\0"), child), g"' can inherit from it\0"));
                                    path.len--;
                                    ->;
                                }
                                    default
                                    {
                                        ob = (Node*)nm_get(this.pobjs, obj);
                                        c = node_count(ob, 2);
                                        while (i < c)
                                        {
                                            this.inh_members(node_child(ob, 2, i).text, path, outm, outo, child);
                                            i++;
                                        };
                                        i = 0;
                                        c = node_count(ob, 0);
                                        while (i < c)
                                        {
                                            m = node_child(ob, 0, i);
                                            i++;
                                            switch ((m.flags `& 32768) != 0)
                                            {
                                                case (true) {
                                                switch (m.text2 != (byte*)0)
                                                {
                                                    case (true) {
                                                    switch (cstr_eq(m.text2, child))
                                                    {
                                                        case (true) {
                                                        pv_push(outm, (void*)m);
                                                        pv_push(outo, (void*)obj);
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                            }
                                                default {
                                                pv_push(outm, (void*)m);
                                                pv_push(outo, (void*)obj);
                                            };
                                            };
                                        };
                                        path.len--;
                                        ->;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            inh_methods(byte* obj, PtrVec* path, PtrVec* outm, byte* child) -> void
            {
                Node* ob;
                Node* m;
                int i, c;
                switch (this.inh_in_path(path, obj))
                {
                    case (true) { ->; }
                    default
                    {
                        pv_push(path, (void*)obj);
                        switch (!nm_has(this.pobjs, obj))
                        {
                            case (true) {
                            path.len--;
                            ->;
                        }
                            default
                            {
                                ob = (Node*)nm_get(this.pobjs, obj);
                                c = node_count(ob, 2);
                                while (i < c)
                                {
                                    this.inh_methods(node_child(ob, 2, i).text, path, outm, child);
                                    i++;
                                };
                                i = 0;
                                c = node_count(ob, 1);
                                while (i < c)
                                {
                                    m = node_child(ob, 1, i);
                                    i++;
                                    switch (m.kind != NodeKind.FUNCTION_DEF | m.text == (byte*)0)
                                    {
                                        case (true) { continue; }
                                        default
                                        {
                                            switch (cstr_eq(m.text, g"__init\0") | cstr_eq(m.text, g"__exit\0") | cstr_eq(m.text, g"__expr\0"))
                                            {
                                                case (true) { continue; }
                                                default
                                                {
                                                    switch ((m.flags `& 32768) != 0)
                                                    {
                                                        case (true) {
                                                        switch (m.text3 != (byte*)0)
                                                        {
                                                            case (true) {
                                                            switch (cstr_eq(m.text3, child))
                                                            {
                                                                case (true) { pv_push(outm, (void*)m); }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                        default { pv_push(outm, (void*)m); };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                                path.len--;
                                ->;
                            };
                        };
                    };
                };
            };


            inh_origin(Node* m) -> Node*
            {
                int i;
                while (i < this.inh_clone.len)
                {
                    switch ((Node*)this.inh_clone.items[i] == m)
                    {
                        case (true) { -> (Node*)this.inh_orig.items[i]; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> m;
            };

            inh_clone_of(Node* m) -> Node*
            {
                Node* c = node_clone(m);
                pv_push(this.inh_clone, (void*)c);
                pv_push(this.inh_orig, (void*)this.inh_origin(m));
                -> c;
            };

            method_has_body(Node* m) -> bool
            {
                switch (m.a == (Node*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        -> node_count(m.a, 0) > 0;
                    };
                };
            };


            sig_key(Node* m, bool for_message) -> byte*
            {
                int i;
                int c = node_count(m, 0);
                Node* p;
                byte* t;
                PtrVec* parts = pv_new();
                while (i < c)
                {
                    p = node_child(m, 0, i);
                    i++;
                    switch (p.text != (byte*)0)
                    {
                        case (true) {
                        switch (cstr_eq(p.text, g"this\0"))
                        {
                            case (true) { continue; }
                            default {};
                        };
                    }
                        default {};
                    };
                    switch (p.ts == (TypeSpec*)0)
                    {
                        case (true) { t = g"\0"; }
                        default { t = this.tp_repr(p.ts); };
                    };
                    pv_push(parts, (void*)t);
                };
                this.sb.len = 0;
                this.sb.mem[0] = (byte)0;
                switch (!for_message)
                {
                    case (true) {
                    this.sb.put_str(f"{m.text}(\0");
                }
                    default {};
                };
                i = 0;
                while (i < parts.len)
                {
                    switch (i > 0)
                    {
                        case (true) {
                        switch (for_message)
                        {
                            case (true) { this.sb.put_str(g", \0"); }
                            default { this.sb.put_str(g",\0"); };
                        };
                    }
                        default {};
                    };
                    this.sb.put_str((byte*)parts.items[i]);
                    i++;
                };
                pv_free(parts);
                -> this.own_n(this.sb.mem, this.sb.len);
            };

            inh_key_has(PtrVec* keys, byte* k) -> int
            {
                int i;
                while (i < keys.len)
                {
                    switch (cstr_eq((byte*)keys.items[i], k))
                    {
                        case (true) { -> i; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> -1;
            };


            inh_source(Node* m) -> byte*
            {
                int i, j, c;
                Node* ob;
                while (i < this.pobjs.count)
                {
                    ob = (Node*)this.pobjs.vals[i];
                    i++;
                    switch (ob == (Node*)0)
                    {
                        case (true) { continue; }
                        default
                        {
                            c = node_count(ob, 1);
                            j = 0;
                            while (j < c)
                            {
                                switch (node_child(ob, 1, j) == m)
                                {
                                    case (true) { -> ob.text; }
                                    default
                                    {
                                        j++;
                                    };
                                };
                            };
                        };
                    };
                };
                -> g"?\0";
            };

            resolve_inheritance(Node* o) -> void
            {
                byte* child = o.text;
                PtrVec* path = pv_new();
                PtrVec* pm = pv_new();
                PtrVec* po = pv_new();
                PtrVec* seen_n = pv_new();
                PtrVec* seen_o = pv_new();
                PtrVec* dedup = pv_new();
                PtrVec* own_m = pv_new();
                PtrVec* own_f = pv_new();
                PtrVec* inh = pv_new();
                PtrVec* ukeys = pv_new();
                PtrVec* ucands = pv_new();
                PtrVec* okeys = pv_new();
                PtrVec* final_inh = pv_new();
                PtrVec* fkeys = pv_new();
                PtrVec* kept = pv_new();
                PtrVec* cand;
                Node* m;
                Node* x;
                byte* k;
                byte* prev;
                byte* msg;
                int i, j, c, nb, idx;
                bool dup;
                nb = node_count(o, 2);
                i = 0;
                while (i < nb & !this.failed)
                {
                    pv_free(path);
                    path = pv_new();
                    this.inh_members(node_child(o, 2, i).text, path, pm, po, child);
                    i++;
                };

                i = 0;
                while (i < pm.len & !this.failed)
                {
                    m = (Node*)pm.items[i];
                    idx = this.inh_key_has(seen_n, m.text);
                    switch (idx >= 0)
                    {
                        case (true) {
                        prev = (byte*)seen_o.items[idx];
                        switch (!cstr_eq(prev, (byte*)po.items[i]))
                        {
                            case (true) {
                            this.error(this.cat2(this.cat2(this.cat2(this.cat2(this.cat2(this.cat2(this.cat2(g"Inheritance conflict: member '\0", m.text), g"' is defined in both '\0"), prev), g"' and '\0"), (byte*)po.items[i]), g"', inherited by '\0"), this.cat2(child, g"'\0")));
                        }
                            default {};
                        };
                    }
                        default {
                        pv_push(seen_n, (void*)m.text);
                        pv_push(seen_o, po.items[i]);
                        pv_push(dedup, (void*)m);
                    };
                    };
                    i++;
                };
                c = node_count(o, 0);
                i = 0;
                while (i < c)
                {
                    pv_push(own_m, (void*)node_child(o, 0, i));
                    i++;
                };
                i = 0;
                while (i < dedup.len & !this.failed)
                {
                    m = (Node*)dedup.items[i];
                    j = 0;
                    while (j < own_m.len)
                    {
                        switch (cstr_eq(((Node*)own_m.items[j]).text, m.text))
                        {
                            case (true) {
                            this.error(this.cat2(this.cat2(this.cat2(this.cat2(g"Inheritance conflict: member '\0", m.text), g"' is defined in both a parent of '\0"), child), g"' itself\0"));
                            break;
                        }
                            default
                            {
                                j++;
                            };
                        };
                    };
                    i++;
                };

                switch (!this.failed)
                {
                    case (true) {
                    i = 0;
                    while (i < nb)
                    {
                        pv_free(path);
                        path = pv_new();
                        this.inh_methods(node_child(o, 2, i).text, path, inh, child);
                        i++;
                    };
                    i = 0;
                    while (i < inh.len)
                    {
                        m = (Node*)inh.items[i];
                        k = this.sig_key(m, false);
                        idx = this.inh_key_has(ukeys, k);
                        switch (idx < 0)
                        {
                            case (true) {
                            pv_push(ukeys, (void*)k);
                            cand = pv_new();
                            pv_push(ucands, (void*)cand);
                            idx = ukeys.len - 1;
                        }
                            default {};
                        };
                        cand = (PtrVec*)ucands.items[idx];
                        dup = false;
                        j = 0;
                        while (j < cand.len)
                        {
                            switch (this.inh_origin((Node*)cand.items[j]) == this.inh_origin(m))
                            {
                                case (true) { dup = true; }
                                default {};
                            };
                            j++;
                        };
                        switch (!dup)
                        {
                            case (true) { pv_push(cand, (void*)m); }
                            default {};
                        };
                        i++;
                    };
                    c = node_count(o, 1);
                    i = 0;
                    while (i < c)
                    {
                        pv_push(own_f, (void*)node_child(o, 1, i));
                        i++;
                    };

                    i = 0;
                    while (i < own_f.len)
                    {
                        m = (Node*)own_f.items[i];
                        i++;
                        switch (m.kind != NodeKind.FUNCTION_DEF)
                        {
                            case (true) { continue; }
                            default
                            {
                                switch ((m.flags `& 131072) != 0 | this.method_has_body(m))
                                {
                                    case (true) { pv_push(okeys, (void*)this.sig_key(m, false)); }
                                    default {};
                                };
                            };
                        };
                    };
                    i = 0;
                    while (i < okeys.len & !this.failed)
                    {
                        idx = this.inh_key_has(ukeys, (byte*)okeys.items[i]);
                        i++;
                        switch (idx < 0)
                        {
                            case (true) { continue; }
                            default
                            {
                                cand = (PtrVec*)ucands.items[idx];
                                j = 0;
                                while (j < cand.len)
                                {
                                    x = (Node*)cand.items[j];
                                    switch ((x.flags `& 262144) != 0)
                                    {
                                        case (true) {
                                        this.error(this.cat2(this.cat2(this.cat2(this.cat2(this.cat2(g"Override error: method '\0", x.text), g"(\0"), this.sig_key(x, true)), g")' is marked no-override in a parent of '\0"), this.cat2(child, g"'\0")));
                                        break;
                                    }
                                        default
                                        {
                                            j++;
                                        };
                                    };
                                };
                            };
                        };
                    };
                    i = 0;
                    while (i < ukeys.len & !this.failed)
                    {
                        idx = i;
                        i++;
                        switch (this.inh_key_has(okeys, (byte*)ukeys.items[idx]) >= 0)
                        {
                            case (true) { continue; }
                            default
                            {
                                cand = (PtrVec*)ucands.items[idx];
                                switch (cand.len)
                                {
                                    case (1)
                                    {
                                        pv_push(final_inh, cand.items[0]);
                                        pv_push(fkeys, ukeys.items[idx]);
                                    }
                                    default
                                    {
                                        x = (Node*)cand.items[0];
                                        msg = this.cat2(g"Inheritance conflict: method '\0", x.text);
                                        msg = this.cat2(this.cat2(msg, g"(\0"), this.sig_key(x, true));
                                        msg = this.cat2(this.cat2(msg, g")' has different implementations in '\0"), this.inh_source(x));
                                        msg = this.cat2(this.cat2(msg, g"' and '\0"), this.inh_source((Node*)cand.items[1]));
                                        msg = this.cat2(this.cat2(msg, g"'. Object '\0"), child);
                                        this.error(this.cat2(msg, g"' must override it.\0"));
                                    };
                                };
                            };
                        };
                    };
                }
                    default {};
                };
                switch (!this.failed)
                {
                    case (true) {

                    switch (o.l0 != (NodeVec*)0)
                    {
                        case (true) { o.l0.len = 0; }
                        default {};
                    };
                    i = 0;
                    while (i < dedup.len)
                    {
                        node_push(o, 0, node_clone((Node*)dedup.items[i]));
                        i++;
                    };
                    i = 0;
                    while (i < own_m.len)
                    {
                        node_push(o, 0, (Node*)own_m.items[i]);
                        i++;
                    };
                    switch (o.l1 != (NodeVec*)0)
                    {
                        case (true) { o.l1.len = 0; }
                        default {};
                    };
                    i = 0;
                    while (i < own_f.len)
                    {
                        m = (Node*)own_f.items[i];
                        i++;
                        switch (m.kind != NodeKind.FUNCTION_DEF)
                        {
                            case (true) {
                            node_push(o, 1, m);
                            continue;
                        }
                            default
                            {
                                switch ((m.flags `& 131072) != 0 | this.method_has_body(m) | this.inh_key_has(fkeys, this.sig_key(m, false)) < 0)
                                {
                                    case (true) {
                                    node_push(o, 1, m);
                                }
                                    default { node_free(m); };
                                };
                            };
                        };
                    };
                    i = 0;
                    while (i < final_inh.len)
                    {
                        node_push(o, 1, this.inh_clone_of((Node*)final_inh.items[i]));
                        i++;
                    };
                }
                    default {};
                };
                i = 0;
                while (i < ucands.len)
                {
                    pv_free((PtrVec*)ucands.items[i]);
                    i++;
                };
                pv_free(path);
                pv_free(pm);
                pv_free(po);
                pv_free(seen_n);
                pv_free(seen_o);
                pv_free(dedup);
                pv_free(own_m);
                pv_free(own_f);
                pv_free(inh);
                pv_free(ukeys);
                pv_free(ucands);
                pv_free(okeys);
                pv_free(final_inh);
                pv_free(fkeys);
                -> pv_free(kept);
            };


            ctor_sugar(byte* raw, Node* rhs) -> bool
            {
                Node* ob;
                Node* ini;
                COp* c;
                int i;
                switch (raw == (byte*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (!nm_has(this.oinit, raw))
                        {
                            case (true) { -> false; }
                            default
                            {
                                switch (rhs.kind == NodeKind.FUNCTION_CALL & rhs.text != (byte*)0)
                                {
                                    case (true) {
                                    while (i < this.cops.len)
                                    {
                                        c = (COp*)this.cops.items[i];
                                        i++;
                                        switch (c.kind == 0)
                                        {
                                            case (true) {
                                            switch (cstr_eq(c.func, rhs.text))
                                            {
                                                case (true) { -> false; }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                    };
                                }
                                    default {};
                                };
                                ob = (Node*)nm_get(this.oinit, raw);
                                ini = this.find_method(ob, g"__init\0");
                                switch (ini == (Node*)0)
                                {
                                    case (true) { -> false; }
                                    default
                                    {
                                        -> this.explicit_params(ini) == 1;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            object_def() -> Node* -> this.object_with_traits(this.mark(), (PtrVec*)0);


            trait_prefixed_object() -> Node*
            {
                int m = this.mark();
                PtrVec* tn = pv_new();
                while (this.expect(TokenType.IDENTIFIER))
                {
                    pv_push(tn, (void*)this.cur_value());
                    this.advance();
                    switch (this.expect(TokenType.OBJECT))
                    {
                        case (true) { break; }
                        default {};
                    };
                };
                Node* o = this.object_with_traits(m, tn);
                pv_free(tn);
                -> o;
            };


            trait_def() -> Node*
            {
                Node* t = this.mk(NodeKind.TRAIT_DEF, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> t; }
                    default
                    {
                        this.advance();
                        t.text = this.ident();
                        switch (this.failed)
                        {
                            case (true) { -> this.done(t); }
                            default
                            {
                                Node* base;
                                Node* p;
                                Node* x;
                                byte* bname;
                                int i, total;
                                bool more;
                                switch (this.expect(TokenType.ASSIGN))
                                {
                                    case (true) {

                                    this.advance();
                                    more = true;
                                    while (more & !this.failed)
                                    {
                                        bname = this.ident();
                                        switch (this.failed)
                                        {
                                            case (true) { break; }
                                            default {};
                                        };
                                        base = this.find_trait(bname);
                                        switch (base == (Node*)0)
                                        {
                                            case (true) {
                                            this.error3(this.cat2(this.cat2(g"Trait composition error: '\0", bname), g"' must be defined before it can be composed into '\0"), t.text, g"'\0");
                                            break;
                                        }
                                            default {};
                                        };
                                        i = 0;
                                        total = 0;
                                        switch (base.l0 != (NodeVec*)0)
                                        {
                                            case (true) { total = base.l0.len; }
                                            default {};
                                        };
                                        while (i < total)
                                        {
                                            x = node_clone(base.l0.items[i]);
                                            node_push(t, 0, x);
                                            i++;
                                        };
                                        more = false;
                                        switch (this.expect(TokenType.LOGICAL_AND))
                                        {
                                            case (true) {
                                            this.advance();
                                            more = true;
                                        }
                                            default {};
                                        };
                                    };
                                    switch (!this.failed)
                                    {
                                        case (true) { this.consume(TokenType.SEMICOLON); }
                                        default {};
                                    };
                                    switch (this.failed)
                                    {
                                        case (true) { -> this.done(t); }
                                        default {};
                                    };
                                    pv_push(this.trait_defs, (void*)t);
                                    -> t;
                                }
                                    default
                                    {
                                        switch (!this.consume(TokenType.LEFT_BRACE))
                                        {
                                            case (true) { -> this.done(t); }
                                            default
                                            {
                                                this.in_trait++;
                                                while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                                                {
                                                    switch (this.expect(TokenType.EOF))
                                                    {
                                                        case (true) {
                                                        this.fail_expected(TokenType.RIGHT_BRACE);
                                                        break;
                                                    }
                                                        default
                                                        {
                                                            switch (this.expect4(TokenType.INLINE, TokenType.DEF, TokenType.ASYNC, TokenType.CDECL) | this.is_calling_conv(this.cur()) | this.is_bare_function_def())
                                                            {
                                                                case (true) {
                                                                this.last_template = (byte*)0;
                                                                p = this.function_def();
                                                                switch (this.failed)
                                                                {
                                                                    case (true) { break; }
                                                                    default
                                                                    {
                                                                        switch (p == (Node*)0)
                                                                        {
                                                                            case (true) {
                                                                            switch (this.last_template == (byte*)0)
                                                                            {
                                                                                case (true) {
                                                                                this.error(g"Internal: template prototype registered no name\0");
                                                                                break;
                                                                            }
                                                                                default
                                                                                {
                                                                                    p = this.template_stub();
                                                                                    switch (this.failed)
                                                                                    {
                                                                                        case (true) { break; }
                                                                                        default {};
                                                                                    };
                                                                                };
                                                                            };
                                                                        }
                                                                            default {};
                                                                        };
                                                                        node_push(t, 0, p);
                                                                        i = 0;
                                                                        while (i < this.pending.len)
                                                                        {
                                                                            node_push(t, 0, this.pending.items[i]);
                                                                            i++;
                                                                        };
                                                                        this.pending.len = 0;
                                                                    };
                                                                };
                                                            }
                                                                default {
                                                                this.error3_exp(g"Expected 'def' inside trait '\0", t.text, g"'\0", TokenType.DEF);
                                                            };
                                                            };
                                                        };
                                                    };
                                                };
                                                this.in_trait--;
                                                switch (!this.failed)
                                                {
                                                    case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                                    default {};
                                                };
                                                switch (!this.failed)
                                                {
                                                    case (true) { this.consume(TokenType.SEMICOLON); }
                                                    default {};
                                                };
                                                switch (this.failed)
                                                {
                                                    case (true) { -> this.done(t); }
                                                    default
                                                    {
                                                        pv_push(this.trait_defs, (void*)t);
                                                        -> t;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };




            tok_symbol(int t) -> byte*
            {
                switch (t)
                {
                    case (TokenType.PLUS)          { -> g"+\0"; }
                    case (TokenType.MINUS)         { -> g"-\0"; }
                    case (TokenType.MULTIPLY)      { -> g"*\0"; }
                    case (TokenType.DIVIDE)        { -> g"/\0"; }
                    case (TokenType.MODULO)        { -> g"%\0"; }
                    case (TokenType.LESS_THAN)     { -> g"<\0"; }
                    case (TokenType.GREATER_THAN)  { -> g">\0"; }
                    case (TokenType.ASSIGN)        { -> g"=\0"; }
                    case (TokenType.LOGICAL_OR)    { -> g"|\0"; }
                    case (TokenType.LOGICAL_AND)   { -> g"&\0"; }
                    case (TokenType.BITXOR_OP)     { -> g"^\0"; }
                    case (TokenType.NOT)           { -> g"!\0"; }
                    case (TokenType.QUESTION)      { -> g"?\0"; }
                    case (TokenType.ADDRESS_OF)    { -> g"@\0"; }
                    case (TokenType.TIE)           { -> g"~\0"; }
                    case (TokenType.INCREMENT)     { -> g"++\0"; }
                    case (TokenType.DECREMENT)     { -> g"--\0"; }
                    case (TokenType.EQUAL)         { -> g"==\0"; }
                    case (TokenType.NOT_EQUAL)     { -> g"!=\0"; }
                    case (TokenType.LESS_EQUAL)    { -> g"<=\0"; }
                    case (TokenType.GREATER_EQUAL) { -> g">=\0"; }
                    case (TokenType.NAND_OP)       { -> g"!&\0"; }
                    case (TokenType.NOR_OP)        { -> g"!|\0"; }
                    case (TokenType.XOR_OP)        { -> g"^|\0"; }
                    case (TokenType.BITSHIFT_LEFT) { -> g"<<\0"; }
                    case (TokenType.BITSHIFT_RIGHT){ -> g">>\0"; }
                    case (TokenType.BITNAND_OP)    { -> g"`!&\0"; }
                    case (TokenType.BITNOR_OP)     { -> g"`!|\0"; }
                    case (TokenType.BITXNAND)      { -> g"`^|!&\0"; }
                    case (TokenType.BITXNOR)       { -> g"`^|!|\0"; }
                    case (TokenType.LEFT_PAREN)    { -> g"(\0"; }
                    case (TokenType.RIGHT_PAREN)   { -> g")\0"; }
                    case (TokenType.LEFT_BRACE)    { -> g"{\0"; }
                    case (TokenType.RIGHT_BRACE)   { -> g"}\0"; }
                    case (TokenType.LEFT_BRACKET)  { -> g"[\0"; }
                    case (TokenType.RIGHT_BRACKET) { -> g"]\0"; }
                    case (TokenType.SEMICOLON)     { -> g";\0"; }
                    case (TokenType.COLON)         { -> g":\0"; }
                    case (TokenType.COMMA)         { -> g",\0"; }
                    case (TokenType.DOT)           { -> g".\0"; }
                    case (TokenType.RETURN_ARROW)  { -> g"->\0"; }
                    case (TokenType.SCOPE)         { -> g"::\0"; }
                    case (TokenType.BACKSLASH)     { -> g"\\\0"; }
                    case (TokenType.STRINGIFY)     { -> g"$\0"; }
                    case (TokenType.TAG)           { -> g"#\0"; }
                    default                        { -> (byte*)0; };
                };
                -> (byte*)0;
            };


            char_mangle(int c) -> byte*
            {
                switch (c == '%')
                {
                    case (true) { -> g"pct\0"; }
                    default
                    {
                        switch (c == '+')
                        {
                            case (true) { -> g"plus\0"; }
                            default
                            {
                                switch (c == '-')
                                {
                                    case (true) { -> g"minus\0"; }
                                    default
                                    {
                                        switch (c == '*')
                                        {
                                            case (true) { -> g"mul\0"; }
                                            default
                                            {
                                                switch (c == '/')
                                                {
                                                    case (true) { -> g"div\0"; }
                                                    default
                                                    {
                                                        switch (c == '<')
                                                        {
                                                            case (true) { -> g"lt\0"; }
                                                            default
                                                            {
                                                                switch (c == '>')
                                                                {
                                                                    case (true) { -> g"gt\0"; }
                                                                    default
                                                                    {
                                                                        switch (c == '=')
                                                                        {
                                                                            case (true) { -> g"eq\0"; }
                                                                            default
                                                                            {
                                                                                switch (c == '&')
                                                                                {
                                                                                    case (true) { -> g"amp\0"; }
                                                                                    default
                                                                                    {
                                                                                        switch (c == '|')
                                                                                        {
                                                                                            case (true) { -> g"pipe\0"; }
                                                                                            default
                                                                                            {
                                                                                                switch (c == '^')
                                                                                                {
                                                                                                    case (true) { -> g"xor\0"; }
                                                                                                    default
                                                                                                    {
                                                                                                        switch (c == '!')
                                                                                                        {
                                                                                                            case (true) { -> g"not\0"; }
                                                                                                            default
                                                                                                            {
                                                                                                                switch (c == '?')
                                                                                                                {
                                                                                                                    case (true) { -> g"qst\0"; }
                                                                                                                    default
                                                                                                                    {
                                                                                                                        switch (c == '@')
                                                                                                                        {
                                                                                                                            case (true) { -> g"at\0"; }
                                                                                                                            default
                                                                                                                            {
                                                                                                                                switch (c == '~')
                                                                                                                                {
                                                                                                                                    case (true) { -> g"tilde\0"; }
                                                                                                                                    default
                                                                                                                                    {
                                                                                                                                        switch (c == '\\')
                                                                                                                                        {
                                                                                                                                            case (true) { -> g"bslash\0"; }
                                                                                                                                            default
                                                                                                                                            {
                                                                                                                                                switch (c == '$')
                                                                                                                                                {
                                                                                                                                                    case (true) { -> g"dol\0"; }
                                                                                                                                                    default
                                                                                                                                                    {
                                                                                                                                                        -> (byte*)0;
                                                                                                                                                    };
                                                                                                                                                };
                                                                                                                                            };
                                                                                                                                        };
                                                                                                                                    };
                                                                                                                                };
                                                                                                                            };
                                                                                                                        };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            val_at(int off) -> byte* -> this.lx.token_value(this.pos + off);


            opsym_match(OpSym* s) -> bool
            {
                int i, t;
                while (i < s.n)
                {
                    t = this.type_at(i);
                    switch (t != s.t[i])
                    {
                        case (true) { -> false; }
                        default
                        {
                            switch (t == TokenType.IDENTIFIER)
                            {
                                case (true) {
                                switch (!cstr_eq(this.val_at(i), s.v[i]))
                                {
                                    case (true) { -> false; }
                                    default {};
                                };
                            }
                                default {};
                            };
                            i++;
                        };
                    };
                };
                -> true;
            };

            opsym_same(OpSym* a, OpSym* b) -> bool
            {
                switch (a.n != b.n)
                {
                    case (true) { -> false; }
                    default
                    {
                        int i;
                        while (i < a.n)
                        {
                            switch (a.t[i] != b.t[i])
                            {
                                case (true) { -> false; }
                                default
                                {
                                    switch (a.t[i] == TokenType.IDENTIFIER)
                                    {
                                        case (true) {
                                        switch (!cstr_eq(a.v[i], b.v[i]))
                                        {
                                            case (true) { -> false; }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    i++;
                                };
                            };
                        };
                        -> true;
                    };
                };
            };

            opsym_free(OpSym* s) -> void
            {
                switch (s == (OpSym*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (s.t != (int*)0)
                        {
                            case (true) { ffree((byte*)s.t); }
                            default {};
                        };
                        switch (s.v != (byte**)0)
                        {
                            case (true) { ffree((byte*)s.v); }
                            default {};
                        };
                        -> ffree((byte*)s);
                    };
                };
            };


            op_bracket() -> OpSym*
            {
                OpSym* s = (OpSym*)fmalloc((u64)((sizeof(OpSym) + 7) / 8));
                switch (s == (OpSym*)0)
                {
                    case (true) {
                    this.fail_alloc();
                    -> s;
                }
                    default
                    {
                        s.n = 0;
                        s.t = (int*)0;
                        s.v = (byte**)0;
                        switch (!this.consume(TokenType.LEFT_BRACKET))
                        {
                            case (true) { -> s; }
                            default
                            {
                                int m = this.mark();
                                int cnt, i, tt;
                                while (!this.expect(TokenType.RIGHT_BRACKET))
                                {
                                    switch (this.expect(TokenType.EOF))
                                    {
                                        case (true) {
                                        this.fail_expected(TokenType.RIGHT_BRACKET);
                                        this.reset(m);
                                        -> s;
                                    }
                                        default
                                        {
                                            cnt++;
                                            this.advance();
                                        };
                                    };
                                };
                                this.reset(m);
                                s.t = (int*)fmalloc((u64)(cnt + 1) * (u64)((sizeof(int) + 7) / 8));
                                s.v = (byte**)fmalloc((u64)(cnt + 1) * (u64)((sizeof(byte*) + 7) / 8));
                                while (i < cnt)
                                {
                                    tt = this.cur();
                                    switch (tt == TokenType.IDENTIFIER)
                                    {
                                        case (true) {
                                        s.t[i] = tt;
                                        s.v[i] = this.cur_value();
                                    }
                                        default {
                                            switch (this.tok_symbol(tt) != (byte*)0)
                                            {
                                                case (true) {
                                        s.t[i] = tt;
                                        s.v[i] = (byte*)0;
                                    }
                                                default {
                                        this.error3_exp(g"Token '\0", this.cur_value(), g"' cannot be part of an operator symbol\0", TokenType.IDENTIFIER);
                                        -> s;
                                    };
                                            };
                                        };
                                    };
                                    this.advance();
                                    i++;
                                    s.n = i;
                                };
                                this.consume(TokenType.RIGHT_BRACKET);
                                -> s;
                            };
                        };
                    };
                };
            };


            opsym_text(OpSym* s) -> byte*
            {
                this.sb.len = 0;
                this.sb.mem[0] = (byte)0;
                int i;
                while (i < s.n)
                {
                    switch (s.t[i] == TokenType.IDENTIFIER)
                    {
                        case (true) { this.sb.put_str(s.v[i]); }
                        default { this.sb.put_str(this.tok_symbol(s.t[i])); };
                    };
                    i++;
                };
                -> this.own_n(this.sb.mem, this.sb.len);
            };

            put_hex_digit(int d) -> void
            {
                switch (d < 10)
                {
                    case (true) { this.sb.put(48 + d); }
                    default { this.sb.put(87 + d); };
                };
                ->;
            };


            mangle_into(OpSym* s) -> void
            {
                int i, j, c;
                byte* sym;
                byte* nm;
                while (i < s.n)
                {
                    switch (i > 0)
                    {
                        case (true) { this.sb.put('_'); }
                        default {};
                    };
                    switch (s.t[i] == TokenType.IDENTIFIER)
                    {
                        case (true) { this.sb.put_str(s.v[i]); }
                        default {
                        sym = this.tok_symbol(s.t[i]);
                        j = 0;
                        while (sym[j] != 0)
                        {
                            switch (j > 0)
                            {
                                case (true) { this.sb.put('_'); }
                                default {};
                            };
                            c = (int)sym[j];
                            nm = this.char_mangle(c);
                            switch (nm != (byte*)0)
                            {
                                case (true) { this.sb.put_str(nm); }
                                default {
                                this.sb.put_str(g"0x\0");
                                switch (c / 16 > 0)
                                {
                                    case (true) { this.put_hex_digit(c / 16); }
                                    default {};
                                };
                                this.put_hex_digit(c % 16);
                            };
                            };
                            j++;
                        };
                    };
                    };
                    i++;
                };
                ->;
            };


            op_func_name(OpSym* l, OpSym* r) -> byte*
            {
                this.sb.len = 0;
                this.sb.mem[0] = (byte)0;
                this.sb.put_str(g"operator__\0");
                this.mangle_into(l);
                switch (r != (OpSym*)0)
                {
                    case (true) {
                    this.sb.put_str(g"__\0");
                    this.mangle_into(r);
                }
                    default {};
                };
                -> this.own_n(this.sb.mem, this.sb.len);
            };

            kind_bit(int kind) -> int
            {
                int bit = 1;
                int k = kind;
                while (k > 0)
                {
                    bit = bit * 2;
                    k--;
                };
                -> bit;
            };



            cop_register(int kind, OpSym* left, OpSym* right, byte* func) -> void
            {
                int i;
                COp* c;
                bool same;
                while (i < this.cops.len)
                {
                    c = (COp*)this.cops.items[i];
                    switch (c.kind == kind & this.opsym_same(c.left, left))
                    {
                        case (true) {
                        same = true;
                        switch (right != (OpSym*)0)
                        {
                            case (true) {
                            switch (c.right == (OpSym*)0)
                            {
                                case (true) { same = false; }
                                default { same = this.opsym_same(c.right, right); };
                            };
                        }
                            default {};
                        };
                        switch (same)
                        {
                            case (true) {
                            c.func = func;
                            this.opsym_free(left);
                            -> this.opsym_free(right);
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    i++;
                };
                c = (COp*)fmalloc((u64)((sizeof(COp) + 7) / 8));
                c.kind = kind;
                c.left = left;
                c.right = right;
                c.func = func;
                pv_push(this.cops, (void*)c);
                this.cop_mask = this.cop_mask `| this.kind_bit(kind);
                ->;
            };


            cop_best(int kind) -> COp*
            {
                switch ((this.cop_mask `& this.kind_bit(kind)) == 0)
                {
                    case (true) { -> (COp*)0; }
                    default
                    {
                        COp* best = (COp*)0;
                        COp* c;
                        int i, bn;
                        while (i < this.cops.len)
                        {
                            c = (COp*)this.cops.items[i];
                            switch (c.kind == kind)
                            {
                                case (true) {
                                switch (c.left.n > bn)
                                {
                                    case (true) {
                                    switch (this.opsym_match(c.left))
                                    {
                                        case (true) {
                                        best = c;
                                        bn = c.left.n;
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                            i++;
                        };
                        -> best;
                    };
                };
            };


            cop_right(COp* left) -> COp*
            {
                COp* best = (COp*)0;
                COp* c;
                int i, bn;
                while (i < this.cops.len)
                {
                    c = (COp*)this.cops.items[i];
                    switch (c.kind == left.kind & c.right != (OpSym*)0)
                    {
                        case (true) {
                        switch (this.opsym_same(c.left, left.left))
                        {
                            case (true) {
                            switch (c.right.n > bn)
                            {
                                case (true) {
                                switch (this.opsym_match(c.right))
                                {
                                    case (true) {
                                    best = c;
                                    bn = c.right.n;
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    i++;
                };
                -> best;
            };


            cop_right_here() -> bool
            {
                switch ((this.cop_mask `& this.kind_bit(4)) == 0)
                {
                    case (true) { -> false; }
                    default
                    {
                        COp* c;
                        int i;
                        while (i < this.cops.len)
                        {
                            c = (COp*)this.cops.items[i];
                            switch (c.kind == 4)
                            {
                                case (true) {
                                switch (this.opsym_match(c.right))
                                {
                                    case (true) { -> true; }
                                    default {};
                                };
                            }
                                default {};
                            };
                            i++;
                        };
                        -> false;
                    };
                };
            };


            at_custom_op() -> bool
            {
                switch (this.cop_mask == 0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (this.cop_best(0) != (COp*)0)
                        {
                            case (true) { -> true; }
                            default
                            {
                                switch (this.cop_best(1) != (COp*)0)
                                {
                                    case (true) { -> true; }
                                    default
                                    {
                                        switch (this.cop_best(4) != (COp*)0)
                                        {
                                            case (true) { -> true; }
                                            default
                                            {
                                                -> this.cop_right_here();
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            op_call(byte* func, int line, int col) -> Node*
            {
                Node* c = this.mk(NodeKind.FUNCTION_CALL, line, col);
                switch (this.failed)
                {
                    case (true) { -> c; }
                    default
                    {
                        c.text = func;
                        -> c;
                    };
                };
            };

            skip_tokens(int n) -> void
            {
                int i;
                while (i < n)
                {
                    this.advance();
                    i++;
                };
                ->;
            };




            variadic_chain(COp* c, Node* first, int line, int col) -> Node*
            {
                Node* call = this.op_call(c.func, line, col);
                Node* cnt;
                Node* argc;
                Node* lead;
                Node* trail;
                Node* right;
                int count = 0;
                int nargs = 0;
                bool is_trailing = false;
                switch (this.failed)
                {
                    case (true) { -> call; }
                    default {};
                };
                cnt = this.lit(DataType.SINT, (i64)0, line, col);
                argc = this.lit(DataType.SINT, (i64)0, line, col);
                lead = this.lit(DataType.BOOL, (i64)(first == (Node*)0), line, col);
                trail = this.lit(DataType.BOOL, (i64)0, line, col);
                switch (this.failed)
                {
                    case (true) { node_free(call); -> (Node*)0; }
                    default {};
                };
                node_push(call, 0, cnt);
                node_push(call, 0, argc);
                node_push(call, 0, lead);
                node_push(call, 0, trail);
                switch (first != (Node*)0)
                {
                    case (true) { node_push(call, 0, first); nargs++; }
                    default {};
                };
                while (true)
                {
                    switch (!this.opsym_match(c.left))
                    {
                        case (true) { break; }
                        default {};
                    };
                    this.skip_tokens(c.left.n);
                    count++;
                    switch (!this.starts_operand())
                    {
                        case (true) { is_trailing = true; break; }
                        default {};
                    };
                    right = this.bin_level(9);
                    switch (this.failed)
                    {
                        case (true) { node_free(call); -> (Node*)0; }
                        default {};
                    };
                    node_push(call, 0, right);
                    nargs++;
                };
                this.set_count_literal(cnt, count);
                this.set_count_literal(argc, nargs);
                trail.ival = (i64)is_trailing;
                -> call;
            };

            custom_op_expression() -> Node*
            {
                Node* expr = (Node*)0;
                COp* lc;
                switch (this.cop_mask != 0 & this.vop_sym == (OpSym*)0)
                {
                    case (true) {

                        lc = this.cop_best(1);
                        switch (lc != (COp*)0)
                        {
                            case (true) { expr = this.variadic_chain(lc, (Node*)0, this.cur_line(), this.cur_col()); }
                            default {};
                        };
                    }
                    default {};
                };
                switch (expr == (Node*)0 & !this.failed)
                {
                    case (true) { expr = this.bin_level(9); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) { -> expr; }
                    default
                    {
                        switch (this.cop_mask == 0)
                        {
                            case (true) { -> expr; }
                            default
                            {
                                COp* c;
                                COp* rc;
                                Node* call;
                                Node* mid;
                                Node* right;
                                int line, col;
                                while (true)
                                {
                                    line = this.cur_line();
                                    col = this.cur_col();
                                    c = this.cop_best(1);
                                    switch (c != (COp*)0)
                                    {
                                        case (true) {
                                        call = this.variadic_chain(c, expr, line, col);
                                        switch (this.failed | call == (Node*)0)
                                        {
                                            case (true) { -> expr; }
                                            default {};
                                        };
                                        expr = call;
                                        continue;
                                    }
                                        default
                                        {
                                            c = this.cop_best(4);
                                            switch (c != (COp*)0)
                                            {
                                                case (true) {
                                                this.skip_tokens(c.left.n);
                                                mid = this.bin_level(9);
                                                switch (this.failed)
                                                {
                                                    case (true) { node_free(expr); -> mid; }
                                                    default {};
                                                };
                                                rc = this.cop_right(c);
                                                switch (rc == (COp*)0)
                                                {
                                                    case (true) {
                                                    node_free(expr);
                                                    node_free(mid);
                                                    this.error3(g"Expected right operator of ternary '\0", this.opsym_text(c.left), g"'\0");
                                                    -> (Node*)0;
                                                }
                                                    default {};
                                                };
                                                this.skip_tokens(rc.right.n);
                                                right = this.bin_level(9);
                                                switch (this.failed)
                                                {
                                                    case (true) { node_free(expr); node_free(mid); -> right; }
                                                    default {};
                                                };
                                                call = this.op_call(rc.func, line, col);
                                                switch (this.failed)
                                                {
                                                    case (true) { node_free(expr); node_free(mid); node_free(right); -> call; }
                                                    default {};
                                                };
                                                node_push(call, 0, expr);
                                                node_push(call, 0, mid);
                                                node_push(call, 0, right);
                                                expr = call;
                                                continue;
                                            }
                                                default
                                                {
                                                    c = this.cop_best(0);
                                                    switch (c == (COp*)0)
                                                    {
                                                        case (true) { break; }
                                                        default
                                                        {
                                                            this.skip_tokens(c.left.n);
                                                            right = this.bin_level(9);
                                                            switch (this.failed)
                                                            {
                                                                case (true) { node_free(expr); -> right; }
                                                                default
                                                                {
                                                                    call = this.op_call(c.func, line, col);
                                                                    switch (this.failed)
                                                                    {
                                                                        case (true) { node_free(expr); node_free(right); -> call; }
                                                                        default
                                                                        {
                                                                            node_push(call, 0, expr);
                                                                            node_push(call, 0, right);
                                                                            expr = call;
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                                -> expr;
                            };
                        };
                    };
                };
            };

            set_count_literal(Node* lit_node, int count) -> void
            {
                lit_node.ival = (i64)count;
                lit_node.op = DataType.SINT;
                ->;
            };


            custom_unary() -> Node*
            {
                switch (this.cop_mask == 0)
                {
                    case (true) { -> (Node*)0; }
                    default
                    {
                        int line = this.cur_line();
                        int col = this.cur_col();
                        COp* c = this.cop_best(2);
                        Node* call;
                        Node* operand;
                        COp* rc;
                        switch (c != (COp*)0)
                        {
                            case (true) {
                            this.skip_tokens(c.left.n);
                            operand = this.unary_expression();
                            switch (this.failed)
                            {
                                case (true) { -> operand; }
                                default {};
                            };
                            call = this.op_call(c.func, line, col);
                            switch (this.failed)
                            {
                                case (true) { node_free(operand); -> call; }
                                default {};
                            };
                            node_push(call, 0, operand);
                            -> call;
                        }
                            default
                            {
                                c = this.cop_best(5);
                                switch (c != (COp*)0)
                                {
                                    case (true) {
                                    this.skip_tokens(c.left.n);
                                    operand = this.unary_expression();
                                    switch (this.failed)
                                    {
                                        case (true) { -> operand; }
                                        default {};
                                    };
                                    rc = this.cop_right(c);
                                    switch (rc == (COp*)0)
                                    {
                                        case (true) {
                                        node_free(operand);
                                        this.error3(g"Expected closing operator of circumfix '\0", this.opsym_text(c.left), g"'\0");
                                        -> (Node*)0;
                                    }
                                        default {};
                                    };
                                    this.skip_tokens(rc.right.n);
                                    call = this.op_call(rc.func, line, col);
                                    switch (this.failed)
                                    {
                                        case (true) { node_free(operand); -> call; }
                                        default {};
                                    };
                                    node_push(call, 0, operand);
                                    -> call;
                                }
                                    default
                                    {
                                        -> (Node*)0;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            is_builtin_op(byte* s) -> bool
            {
                int o = 0;
                while (o <= Operator.ADDRESS_CAST)
                {
                    switch (cstr_eq(operator_text(o), s))
                    {
                        case (true) { -> true; }
                        default
                        {
                            o++;
                        };
                    };
                };
                -> false;
            };


            has_non_builtin_param(Node* f) -> bool
            {
                int i;
                TypeSpec* t;
                while (i < this.param_count(f))
                {
                    t = f.l0.items[i].ts;
                    switch (t != (TypeSpec*)0)
                    {
                        case (true) {
                        switch (t.custom_typename != (byte*)0)
                        {
                            case (true) { -> true; }
                            default
                            {
                                switch (t.base_type == DataType.STRUCT | t.base_type == DataType.OBJECT | t.base_type == DataType.DATA)
                                {
                                    case (true) { -> true; }
                                    default
                                    {
                                        switch (t.pointer_depth > 0)
                                        {
                                            case (true) { -> true; }
                                            default {};
                                        };
                                    };
                                };
                            };
                        };
                    }
                        default {};
                    };
                    i++;
                };
                -> false;
            };

            define_op_symbol(OpSym* s) -> void
            {
                switch (this.st != (IDKC_SYMTABLE*)0)
                {
                    case (true) { st_define(this.st, this.opsym_text(s), SymbolKind.OPERATOR, (TypeSpec*)0, (Node*)0); }
                    default {};
                };
                ->;
            };


            unary_binding(Node* f, byte* what) -> int
            {
                switch (!(this.expect(TokenType.TAG) & this.type_at(1) == TokenType.IDENTIFIER))
                {
                    case (true) { -> 0; }
                    default
                    {
                        switch (!cstr_eq(this.val_at(1), g"binding\0"))
                        {
                            case (true) { -> 0; }
                            default
                            {
                                switch (this.param_count(f) != 1)
                                {
                                    case (true) {
                                    this.error3(g"# binding on \0", what, g" is only valid for unary operators (exactly one parameter)\0");
                                    -> 0;
                                }
                                    default
                                    {
                                        this.advance();
                                        this.advance();
                                        switch (!this.consume(TokenType.LEFT_BRACE))
                                        {
                                            case (true) { -> 0; }
                                            default
                                            {
                                                int r = 0;
                                                switch (this.expect(TokenType.COLON))
                                                {
                                                    case (true) {
                                                    this.advance();
                                                    this.consume(TokenType.THIS);
                                                    r = 2;
                                                }
                                                    default {
                                                        switch (this.expect(TokenType.THIS))
                                                        {
                                                            case (true) {
                                                    this.advance();
                                                    this.consume(TokenType.COLON);
                                                    r = 1;
                                                }
                                                            default {
                                                    this.error(g"Unary # binding must be {:this} for postfix or {this:} for prefix\0");
                                                    -> 0;
                                                };
                                                        };
                                                    };
                                                };
                                                this.consume(TokenType.RIGHT_BRACE);
                                                -> r;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            register_operator(Node* f, OpSym* l, OpSym* r, int bind, bool variadic, bool is_template) -> void
            {
                int np = this.param_count(f);
                switch (bind == 1)
                {
                    case (true) { this.define_op_symbol(l); this.cop_register(2, l, (OpSym*)0, f.text); ->; }
                    default
                    {
                        switch (bind == 2)
                        {
                            case (true) { this.define_op_symbol(l); this.cop_register(3, l, (OpSym*)0, f.text); ->; }
                            default
                            {
                                switch (r != (OpSym*)0)
                                {
                                    case (true) {
                                    switch (np != 1 & np != 3)
                                    {
                                        case (true) {
                                        this.error(g"Two-bracket 'as operator' requires either 1 parameter (circumfix) or 3 parameters (ternary)\0");
                                        ->;
                                    }
                                        default {};
                                    };
                                    this.define_op_symbol(r);
                                    this.define_op_symbol(l);
                                    switch (np)
                                    {
                                        case (1) { this.cop_register(5, l, r, f.text); }
                                        default { this.cop_register(4, l, r, f.text); };
                                    };
                                    ->;
                                }
                                    default
                                    {
                                        switch (variadic)
                                        {
                                            case (true) {
                                            this.define_op_symbol(l);
                                            -> this.cop_register(1, l, (OpSym*)0, f.text);
                                        }
                                            default
                                            {
                                                switch (this.is_builtin_op(this.opsym_text(l)))
                                                {
                                                    case (true) {
                                                    switch (!is_template & !this.has_non_builtin_param(f))
                                                    {
                                                        case (true) {
                                                        this.error3(g"Overloading built-in operator '\0", this.opsym_text(l), g"' requires at least one parameter to be a non-builtin type\0");
                                                    }
                                                        default {};
                                                    };
                                                    this.define_op_symbol(l);
                                                    -> this.opsym_free(l);
                                                }
                                                    default
                                                    {
                                                        this.define_op_symbol(l);
                                                        -> this.cop_register(0, l, (OpSym*)0, f.text);
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            operator_def() -> Node*
            {
                NameMap* prev_act = this.active_tp;
                TemplateEntry* prev_cur = this.tmpl_cur;
                TemplateEntry* te;
                Node* f;
                this.tmpl_cur = (TemplateEntry*)0;
                f = this.operator_def_inner();
                te = this.tmpl_cur;
                this.tmpl_cur = prev_cur;
                switch (this.active_tp != prev_act)
                {
                    case (true) {
                    nm_free(this.active_tp);
                    this.active_tp = prev_act;
                }
                    default {};
                };
                switch (te != (TemplateEntry*)0)
                {
                    case (true) { te_free(te); }
                    default {};
                };
                -> f;
            };


            op_template_done(Node* f, TemplateEntry* te, byte* key) -> Node*
            {
                this.tmpl_cur = (TemplateEntry*)0;
                this.register_template(key, 3, te, f);
                -> (Node*)0;
            };

            operator_def_inner() -> Node*
            {
                Node* f = this.mk(NodeKind.FUNCTION_DEF, this.cur_line(), this.cur_col());
                TemplateEntry* te = (TemplateEntry*)0;
                byte* opkey = (byte*)0;
                switch (this.failed)
                {
                    case (true) { -> f; }
                    default
                    {
                        this.advance();
                        switch (this.expect(TokenType.LESS_THAN) & this.is_template_list())
                        {
                            case (true) {
                            te = te_new();
                            this.advance();
                            pv_push(te.params, (void*)this.own(ts_dup(this.ident())));
                            while (!this.failed & this.expect(TokenType.COMMA))
                            {
                                this.advance();
                                pv_push(te.params, (void*)this.own(ts_dup(this.ident())));
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.GREATER_THAN); }
                                default {};
                            };
                            switch (this.failed)
                            {
                                case (true) {
                                te_free(te);
                                -> this.done(f);
                            }
                                default
                                {
                                    this.tmpl_cur = te;
                                };
                            };
                        }
                            default {};
                        };
                        switch (!this.consume(TokenType.LEFT_PAREN))
                        {
                            case (true) { -> this.done(f); }
                            default
                            {
                                switch (te != (TemplateEntry*)0)
                                {
                                    case (true) { this.tp_activate(te); }
                                    default {};
                                };
                                this.parameter_list(f);
                                switch (this.failed)
                                {
                                    case (true) { -> this.done(f); }
                                    default
                                    {
                                        switch (!this.consume(TokenType.RIGHT_PAREN))
                                        {
                                            case (true) { -> this.done(f); }
                                            default
                                            {
                                                int bl = this.cur_line();
                                                int bc = this.cur_col();
                                                OpSym* l = this.op_bracket();
                                                OpSym* r = (OpSym*)0;
                                                switch (!this.failed & this.expect(TokenType.LEFT_BRACKET))
                                                {
                                                    case (true) { r = this.op_bracket(); }
                                                    default {};
                                                };
                                                bool vsent = false;
                                                int vi;
                                                while (vi < this.param_count(f))
                                                {
                                                    switch (f.l0.items[vi].ival == 1) { case (true) { vsent = true; } default {}; };
                                                    vi++;
                                                };
                                                switch (!this.failed & r == (OpSym*)0 & vsent)
                                                {
                                                    case (true)
                                                    {
                                                        switch (this.is_builtin_op(this.opsym_text(l)))
                                                        {
                                                            case (true) { this.error_at(this.cat2(this.cat2(g"Built-in operator '\0", this.opsym_text(l)), g"' cannot be variadic\0"), bl, bc); }
                                                            default {};
                                                        };
                                                    }
                                                    default {};
                                                };
                                                switch (this.failed)
                                                {
                                                    case (true) { -> this.op_abort(f, l, r); }
                                                    default
                                                    {
                                                        switch (te != (TemplateEntry*)0)
                                                        {
                                                            case (true) { opkey = this.opsym_text(l); }
                                                            default {};
                                                        };

                                                        switch (r != (OpSym*)0)
                                                        {
                                                            case (true) {
                                                            switch (this.param_count(f) != 1 & this.param_count(f) != 3)
                                                            {
                                                                case (true) {
                                                                this.error(g"Two-bracket operator requires either 1 parameter (circumfix) or 3 parameters (ternary)\0");
                                                                -> this.op_abort(f, l, r);
                                                            }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                        f.text = this.op_func_name(l, r);

                                                        switch (!this.consume(TokenType.RETURN_ARROW))
                                                        {
                                                            case (true) { -> this.op_abort(f, l, r); }
                                                            default
                                                            {
                                                                f.ts = this.type_spec();
                                                                switch (this.failed)
                                                                {
                                                                    case (true) { -> this.op_abort(f, l, r); }
                                                                    default
                                                                    {
                                                                        Node* pre;
                                                                        switch (this.expect(TokenType.COLON))
                                                                        {
                                                                            case (true) {
                                                                            this.advance();
                                                                            pre = this.mk(NodeKind.NODE_LIST, f.line, f.col);
                                                                            switch (this.failed)
                                                                            {
                                                                                case (true) { -> this.op_abort(f, l, r); }
                                                                                default
                                                                                {
                                                                                    this.contract_refs(f, pre, false);
                                                                                    switch (this.failed)
                                                                                    {
                                                                                        case (true) { node_free(pre); -> this.op_abort(f, l, r); }
                                                                                        default {};
                                                                                    };
                                                                                };
                                                                            };
                                                                        }
                                                                            default {};
                                                                        };


                                                                        bool variadic = false;
                                                                        int i;
                                                                        Node* p;
                                                                        while (i < this.param_count(f))
                                                                        {
                                                                            switch (f.l0.items[i].ival == 1)
                                                                            {
                                                                                case (true) { variadic = true; }
                                                                                default {};
                                                                            };
                                                                            i++;
                                                                        };
                                                                        this.strip_variadic(f);
                                                                        Node* cp;
                                                                        switch (variadic & r == (OpSym*)0)
                                                                        {
                                                                            case (true) {

                                                                            int hk = 3;
                                                                            while (hk >= 0)
                                                                            {
                                                                                cp = this.mk(NodeKind.PARAMETER, f.line, f.col);
                                                                                switch (this.failed)
                                                                                {
                                                                                    case (true) { node_free(pre); -> this.op_abort(f, l, r); }
                                                                                    default
                                                                                    {
                                                                                        cp.ts = typespec_new();
                                                                                        switch (hk)
                                                                                        {
                                                                                            case (0) { cp.ts.base_type = DataType.SINT; cp.text = g"__op_count\0"; }
                                                                                            case (1) { cp.ts.base_type = DataType.SINT; cp.text = g"__op_argc\0"; }
                                                                                            case (2) { cp.ts.base_type = DataType.BOOL; cp.text = g"__op_leading\0"; }
                                                                                            default { cp.ts.base_type = DataType.BOOL; cp.text = g"__op_trailing\0"; };
                                                                                        };
                                                                                        this.push_front(f, cp);
                                                                                    };
                                                                                };
                                                                                hk--;
                                                                            };
                                                                        }
                                                                            default {};
                                                                        };

                                                                        OpSym* prev_vop = this.vop_sym;
                                                                        Node* ret;
                                                                        Node* b;
                                                                        Node* post;
                                                                        int bind;
                                                                        switch (this.expect(TokenType.SEMICOLON))
                                                                        {
                                                                            case (true) {
                                                                            this.advance();
                                                                            this.mark_proto(f);
                                                                        }
                                                                            default {
                                                                                switch (this.expect(TokenType.RETURN_ARROW))
                                                                                {
                                                                                    case (true) {
                                                                            i = 0;
                                                                            while (i < this.param_count(f))
                                                                            {
                                                                                switch (f.l0.items[i].text == (byte*)0)
                                                                                {
                                                                                    case (true) {
                                                                                    this.error(g"Operator definition requires parameter names, but a parameter has no name\0");
                                                                                    node_free(pre);
                                                                                    -> this.op_abort(f, l, r);
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        i++;
                                                                                    };
                                                                                };
                                                                            };
                                                                            switch (this.st != (IDKC_SYMTABLE*)0)
                                                                            {
                                                                                case (true) {
                                                                                st_enter_scope(this.st);
                                                                                i = 0;
                                                                                while (i < this.param_count(f))
                                                                                {
                                                                                    p = f.l0.items[i];
                                                                                    this.define_var(p.text, p.ts);
                                                                                    i++;
                                                                                };
                                                                            }
                                                                                default {};
                                                                            };
                                                                            switch (variadic & r == (OpSym*)0)
                                                                            {
                                                                                case (true) { this.vop_sym = l; }
                                                                                default {};
                                                                            };
                                                                            this.advance();
                                                                            b = this.mk(NodeKind.BLOCK, this.cur_line(), this.cur_col());
                                                                            ret = this.mk(NodeKind.RETURN_STATEMENT, this.cur_line(), this.cur_col());
                                                                            switch (this.failed)
                                                                            {
                                                                                case (true) { node_free(b); node_free(ret); node_free(pre); -> this.op_abort(f, l, r); }
                                                                                default
                                                                                {
                                                                                    f.a = b;
                                                                                    node_push(b, 0, ret);
                                                                                    ret.a = this.expression();
                                                                                    this.vop_sym = prev_vop;
                                                                                    switch (this.st != (IDKC_SYMTABLE*)0)
                                                                                    {
                                                                                        case (true) { st_exit_scope(this.st); }
                                                                                        default {};
                                                                                    };
                                                                                    switch (!this.failed)
                                                                                    {
                                                                                        case (true) { this.consume(TokenType.SEMICOLON); }
                                                                                        default {};
                                                                                    };
                                                                                };
                                                                            };
                                                                        }
                                                                                    default {
                                                                            switch (variadic & r == (OpSym*)0)
                                                                            {
                                                                                case (true) { this.vop_sym = l; }
                                                                                default {};
                                                                            };
                                                                            switch (this.st != (IDKC_SYMTABLE*)0)
                                                                            {
                                                                                case (true) { st_enter_scope(this.st); }
                                                                                default {};
                                                                            };
                                                                            f.a = this.block();
                                                                            switch (this.st != (IDKC_SYMTABLE*)0)
                                                                            {
                                                                                case (true) { st_exit_scope(this.st); }
                                                                                default {};
                                                                            };
                                                                            this.vop_sym = prev_vop;
                                                                            switch (!this.failed)
                                                                            {
                                                                                case (true) {
                                                                                this.prepend_contracts(f, pre);
                                                                                post = (Node*)0;
                                                                                switch (this.expect(TokenType.COLON))
                                                                                {
                                                                                    case (true) {
                                                                                    this.advance();
                                                                                    post = this.mk(NodeKind.NODE_LIST, f.line, f.col);
                                                                                    switch (this.failed)
                                                                                    {
                                                                                        case (true) { -> this.op_abort(f, l, r); }
                                                                                        default
                                                                                        {
                                                                                            this.contract_refs(f, post, true);
                                                                                            switch (!this.failed)
                                                                                            {
                                                                                                case (true) { this.apply_post_contracts(f, post); }
                                                                                                default {};
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                }
                                                                                    default {};
                                                                                };
                                                                                switch (!this.failed)
                                                                                {
                                                                                    case (true) { this.validate_bindings(this.fn_label(f), pre, post); }
                                                                                    default {};
                                                                                };
                                                                                node_free(post);
                                                                                node_free(pre);
                                                                                pre = (Node*)0;
                                                                            }
                                                                                default {};
                                                                            };
                                                                            switch (!this.failed)
                                                                            {
                                                                                case (true) {
                                                                                bind = this.unary_binding(f, g"an operator definition\0");
                                                                                switch (!this.failed)
                                                                                {
                                                                                    case (true) { this.consume(TokenType.SEMICOLON); }
                                                                                    default {};
                                                                                };
                                                                                switch (!this.failed)
                                                                                {
                                                                                    case (true) {
                                                                                    this.register_operator(f, l, r, bind, variadic, te != (TemplateEntry*)0);
                                                                                    switch (te != (TemplateEntry*)0)
                                                                                    {
                                                                                        case (true) { -> this.op_template_done(f, te, opkey); }
                                                                                        default
                                                                                        {
                                                                                            -> f;
                                                                                        };
                                                                                    };
                                                                                }
                                                                                    default {};
                                                                                };
                                                                            }
                                                                                default {};
                                                                            };
                                                                            node_free(pre);
                                                                            -> this.op_abort(f, l, r);
                                                                        };
                                                                                };
                                                                            };
                                                                        };
                                                                        node_free(pre);
                                                                        switch (this.failed)
                                                                        {
                                                                            case (true) { -> this.op_abort(f, l, r); }
                                                                            default
                                                                            {
                                                                                switch (variadic)
                                                                                {
                                                                                    case (true) { f.flags = f.flags `| 2048; }
                                                                                    default {};
                                                                                };
                                                                                this.register_operator(f, l, r, 0, variadic, te != (TemplateEntry*)0);
                                                                                switch (te != (TemplateEntry*)0)
                                                                                {
                                                                                    case (true) { -> this.op_template_done(f, te, opkey); }
                                                                                    default
                                                                                    {
                                                                                        -> this.done(f);
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            op_abort(Node* f, OpSym* l, OpSym* r) -> Node*
            {
                this.opsym_free(l);
                this.opsym_free(r);
                -> this.done(f);
            };


            push_front(Node* f, Node* p) -> void
            {
                node_push(f, 0, p);
                int i = f.l0.len - 1;
                while (i > 0)
                {
                    f.l0.items[i] = f.l0.items[i - 1];
                    i--;
                };
                f.l0.items[0] = p;
                ->;
            };




            contract_find(byte* name) -> Node*
            {
                int i = this.contracts.len - 1;
                Node* c;
                while (i >= 0)
                {
                    c = (Node*)this.contracts.items[i];
                    switch (cstr_eq(c.text, name))
                    {
                        case (true) { -> c; }
                        default
                        {
                            i--;
                        };
                    };
                };
                -> (Node*)0;
            };

            contract_param(Node* c) -> void
            {
                Node* p = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        node_push(c, 0, p);
                        p.text = this.ident();
                        ->;
                    };
                };
            };


            contract_params(Node* c) -> void
            {
                switch (!this.expect(TokenType.LEFT_PAREN))
                {
                    case (true) { ->; }
                    default
                    {
                        this.advance();
                        switch (!this.expect(TokenType.RIGHT_PAREN))
                        {
                            case (true) {
                            this.contract_param(c);
                            while (!this.failed & this.expect(TokenType.COMMA))
                            {
                                this.advance();
                                this.contract_param(c);
                            };
                        }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.RIGHT_PAREN); }
                            default {};
                        };
                        ->;
                    };
                };
            };



            contract_def() -> Node*
            {
                Node* c = this.mk(NodeKind.CONTRACT_DEF, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> c; }
                    default
                    {
                        this.advance();
                        c.text = this.ident();
                        switch (this.failed)
                        {
                            case (true) { -> this.done(c); }
                            default
                            {
                                this.contract_params(c);
                                switch (this.failed)
                                {
                                    case (true) { -> this.done(c); }
                                    default
                                    {
                                        Node* x;
                                        switch (this.expect2(TokenType.SEMICOLON, TokenType.COMMA))
                                        {
                                            case (true) {
                                            c.a = this.mk(NodeKind.BLOCK, c.line, c.col);
                                            switch (this.failed)
                                            {
                                                case (true) { -> this.done(c); }
                                                default {};
                                            };
                                            switch (this.contract_find(c.text) == (Node*)0)
                                            {
                                                case (true) { pv_push(this.contracts, (void*)c); }
                                                default {};
                                            };
                                            while (this.expect(TokenType.COMMA))
                                            {
                                                this.advance();
                                                x = this.mk(NodeKind.CONTRACT_DEF, this.cur_line(), this.cur_col());
                                                switch (this.failed)
                                                {
                                                    case (true) { -> this.done(c); }
                                                    default {};
                                                };
                                                nv_push(this.pending, x);
                                                x.text = this.ident();
                                                switch (this.failed)
                                                {
                                                    case (true) { -> this.done(c); }
                                                    default {};
                                                };
                                                this.contract_params(x);
                                                switch (this.failed)
                                                {
                                                    case (true) { -> this.done(c); }
                                                    default {};
                                                };
                                                x.a = this.mk(NodeKind.BLOCK, x.line, x.col);
                                                switch (this.failed)
                                                {
                                                    case (true) { -> this.done(c); }
                                                    default {};
                                                };
                                                switch (this.contract_find(x.text) == (Node*)0)
                                                {
                                                    case (true) { pv_push(this.contracts, (void*)x); }
                                                    default {};
                                                };
                                            };
                                            this.consume(TokenType.SEMICOLON);
                                            -> this.done(c);
                                        }
                                            default
                                            {
                                                c.a = this.block();
                                                switch (this.failed)
                                                {
                                                    case (true) { -> this.done(c); }
                                                    default
                                                    {
                                                        switch (this.expect(TokenType.TAG) & this.type_at(1) == TokenType.IDENTIFIER)
                                                        {
                                                            case (true) {
                                                            switch (cstr_eq(this.val_at(1), g"binding\0"))
                                                            {
                                                                case (true) {
                                                                this.advance();
                                                                this.advance();
                                                                switch (this.consume(TokenType.LEFT_BRACE))
                                                                {
                                                                    case (true) {
                                                                    c.b = this.binding_spec();
                                                                    switch (!this.failed)
                                                                    {
                                                                        case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                                                        default {};
                                                                    };
                                                                }
                                                                    default {};
                                                                };
                                                            }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                        switch (!this.failed)
                                                        {
                                                            case (true) { this.consume(TokenType.SEMICOLON); }
                                                            default {};
                                                        };
                                                        switch (this.failed)
                                                        {
                                                            case (true) { -> this.done(c); }
                                                            default
                                                            {
                                                                pv_push(this.contracts, (void*)c);
                                                                -> c;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            num_text(int v) -> byte*
            {
                this.sb.len = 0;
                this.sb.mem[0] = (byte)0;
                this.sb.put_int(v);
                -> this.own_n(this.sb.mem, this.sb.len);
            };


            subst_walk(Node* n, PtrVec* from_names, PtrVec* to_names) -> void
            {
                switch (n == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        int i, s, cnt;
                        switch (n.kind == NodeKind.IDENTIFIER & n.text != (byte*)0)
                        {
                            case (true) {
                            while (i < from_names.len)
                            {
                                switch (cstr_eq((byte*)from_names.items[i], n.text))
                                {
                                    case (true) {
                                    n.text = (byte*)to_names.items[i];
                                    break;
                                }
                                    default
                                    {
                                        i++;
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        this.subst_walk(n.a, from_names, to_names);
                        this.subst_walk(n.b, from_names, to_names);
                        this.subst_walk(n.c, from_names, to_names);
                        this.subst_walk(n.d, from_names, to_names);
                        this.subst_walk(n.e, from_names, to_names);
                        while (s < 6)
                        {
                            cnt = node_count(n, s);
                            i = 0;
                            while (i < cnt)
                            {
                                this.subst_walk(node_child(n, s, i), from_names, to_names);
                                i++;
                            };
                            s++;
                        };
                        ->;
                    };
                };
            };



            parse_contract_ref() -> Node*
            {
                Node* ref = this.mk(NodeKind.NODE_LIST, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> ref; }
                    default
                    {
                        ref.text = this.ident();
                        switch (this.failed)
                        {
                            case (true) { -> this.done(ref); }
                            default
                            {
                                switch (this.expect(TokenType.LEFT_PAREN))
                                {
                                    case (true) {
                                    this.advance();
                                    ref.ival = 1;
                                    switch (!this.expect(TokenType.RIGHT_PAREN))
                                    {
                                        case (true) {
                                        this.contract_param(ref);
                                        while (!this.failed & this.expect(TokenType.COMMA))
                                        {
                                            this.advance();
                                            this.contract_param(ref);
                                        };
                                    }
                                        default {};
                                    };
                                    switch (!this.failed)
                                    {
                                        case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                -> this.done(ref);
                            };
                        };
                    };
                };
            };


            resolve_contract(Node* f, Node* ref, Node* out) -> void
            {
                Node* c = this.contract_find(ref.text);
                int cp = node_count(c, 0);
                int i, rn, argc;
                PtrVec* real = pv_new();
                PtrVec* from_names = pv_new();
                PtrVec* to_names = pv_new();
                Node* pn;
                while (i < this.param_count(f))
                {
                    pn = f.l0.items[i];
                    switch (pn.ival != 1)
                    {
                        case (true) { pv_push(real, (void*)pn.text); }
                        default {};
                    };
                    i++;
                };
                rn = real.len;
                i = 0;
                switch (cp > 0)
                {
                    case (true) {
                    switch (ref.ival == 1)
                    {
                        case (true) {
                        argc = node_count(ref, 0);
                        switch (argc != cp)
                        {
                            case (true) {
                            this.error(this.cat2(this.cat2(this.cat2(this.cat2(this.cat2(this.cat2(g"Contract '\0", ref.text), g"' expects \0"), this.num_text(cp)), g" parameter(s) but \0"), this.num_text(argc)), g" argument(s) given at attachment site\0"));
                        }
                            default {
                                switch (rn < argc)
                                {
                                    case (true) {
                            this.error(this.cat2(this.cat2(this.cat2(this.cat2(this.cat2(this.cat2(g"Contract '\0", ref.text), g"' attachment maps \0"), this.num_text(argc)), g" parameter(s) but function only has \0"), this.num_text(rn)), g"\0"));
                        }
                                    default {
                            while (i < argc)
                            {
                                switch (real.items[i] != (void*)0)
                                {
                                    case (true) {
                                    pv_push(from_names, (void*)ref.l0.items[i].text);
                                    pv_push(to_names, real.items[i]);
                                }
                                    default {};
                                };
                                i++;
                            };
                        };
                                };
                            };
                        };
                    }
                        default {
                            switch (cp != rn)
                            {
                                case (true) {
                        this.error(this.cat2(this.cat2(this.cat2(this.cat2(this.cat2(g"Contract '\0", ref.text), g"' expects \0"), this.num_text(cp)), g" parameter(s) but function has \0"), this.num_text(rn)));
                    }
                                default {
                        while (i < cp)
                        {
                            switch (real.items[i] != (void*)0)
                            {
                                case (true) {
                                pv_push(from_names, (void*)c.l0.items[i].text);
                                pv_push(to_names, real.items[i]);
                            }
                                default {};
                            };
                            i++;
                        };
                    };
                            };
                        };
                    };
                }
                    default {};
                };
                Node* s;
                Node* body = c.a;
                switch (!this.failed & body != (Node*)0)
                {
                    case (true) {
                    i = 0;
                    while (i < node_count(body, 0))
                    {
                        s = node_clone(node_child(body, 0, i));
                        this.subst_walk(s, from_names, to_names);
                        node_push(out, 0, s);
                        i++;
                    };
                }
                    default {};
                };
                pv_free(real);
                pv_free(from_names);
                -> pv_free(to_names);
            };


            contract_refs(Node* f, Node* out, bool is_post) -> void
            {
                Node* ref;
                Node* nm;
                bool more = true;
                while (more & !this.failed)
                {
                    ref = this.parse_contract_ref();
                    switch (this.failed)
                    {
                        case (true) { ->; }
                        default
                        {
                            switch (this.contract_find(ref.text) == (Node*)0)
                            {
                                case (true) {
                                switch (is_post)
                                {
                                    case (true) { this.error3(g"Undefined post-contract '\0", ref.text, g"'\0"); }
                                    default { this.error3(g"Undefined contract '\0", ref.text, g"'\0"); };
                                };
                                -> node_free(ref);
                            }
                                default
                                {
                                    this.resolve_contract(f, ref, out);
                                    nm = this.mk(NodeKind.IDENTIFIER, ref.line, ref.col);
                                    switch (!this.failed)
                                    {
                                        case (true) {
                                        nm.text = ref.text;
                                        nm.ival = -1;
                                        switch (ref.ival == 1)
                                        {
                                            case (true) { nm.ival = (i64)node_count(ref, 0); }
                                            default {};
                                        };
                                        node_push(out, 1, nm);
                                    }
                                        default {};
                                    };
                                    node_free(ref);
                                    more = false;
                                    switch (!this.failed & this.expect(TokenType.COMMA))
                                    {
                                        case (true) {
                                        this.advance();
                                        more = true;
                                    }
                                        default {};
                                    };
                                };
                            };
                        };
                    };
                };
                ->;
            };


            prepend_contracts(Node* f, Node* pre) -> void
            {
                switch (pre == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (node_count(pre, 0) > 0 & f.a != (Node*)0)
                        {
                            case (true) {
                            NodeVec* merged = nv_new();
                            int i;
                            while (i < pre.l0.len)
                            {
                                nv_push(merged, pre.l0.items[i]);
                                i++;
                            };
                            i = 0;
                            while (i < node_count(f.a, 0))
                            {
                                nv_push(merged, f.a.l0.items[i]);
                                i++;
                            };
                            pre.l0.len = 0;
                            switch (f.a.l0 != (NodeVec*)0)
                            {
                                case (true) {
                                f.a.l0.len = 0;
                                nv_free(f.a.l0);
                            }
                                default {};
                            };
                            f.a.l0 = merged;
                        }
                            default {};
                        };
                        ->;
                    };
                };
            };


            push_post_copies(NodeVec* out, Node* post) -> void
            {
                int i;
                while (i < node_count(post, 0))
                {
                    nv_push(out, node_clone(post.l0.items[i]));
                    i++;
                };
                ->;
            };


            rewrite_returns(Node* blk, TypeSpec* rt, Node* post, bool void_mode) -> void
            {
                switch (blk == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        NodeVec* old = blk.l0;
                        NodeVec* out = nv_new();
                        int i, k;
                        Node* s;
                        Node* decl;
                        Node* ret;
                        Node* id;
                        while (old != (NodeVec*)0 & i < old.len)
                        {
                            s = old.items[i];
                            i++;
                            switch (s.kind == NodeKind.RETURN_STATEMENT)
                            {
                                case (true) {
                                switch (!void_mode & s.a != (Node*)0)
                                {
                                    case (true) {
                                    decl = this.mk(NodeKind.VARIABLE_DECLARATION, s.line, s.col);
                                    ret = this.mk(NodeKind.RETURN_STATEMENT, s.line, s.col);
                                    id = this.mk(NodeKind.IDENTIFIER, s.line, s.col);
                                    switch (this.failed)
                                    {
                                        case (true) { nv_push(out, s); continue; }
                                        default {};
                                    };
                                    decl.text = g"r\0";
                                    decl.ts = typespec_copy(rt);
                                    decl.a = s.a;
                                    s.a = (Node*)0;
                                    node_free(s);
                                    id.text = g"r\0";
                                    ret.a = id;
                                    nv_push(out, decl);
                                    this.push_post_copies(out, post);
                                    nv_push(out, ret);
                                    continue;
                                }
                                    default
                                    {
                                        switch (void_mode & s.a == (Node*)0)
                                        {
                                            case (true) {
                                            this.push_post_copies(out, post);
                                            nv_push(out, s);
                                            continue;
                                        }
                                            default {};
                                        };
                                    };
                                };
                            }
                                default {};
                            };
                            switch (s.kind)
                            {
                                case (NodeKind.BLOCK) { this.rewrite_returns(s, rt, post, void_mode); }
                                case (NodeKind.IF_STATEMENT)
                                {
                                    this.rewrite_returns(s.b, rt, post, void_mode);
                                    this.rewrite_returns(s.c, rt, post, void_mode);
                                    k = 0;
                                    while (k < node_count(s, 1))
                                    {
                                        this.rewrite_returns(s.l1.items[k], rt, post, void_mode);
                                        k++;
                                    };
                                }
                                default
                                {
                                    switch (s.kind == NodeKind.WHILE_LOOP | s.kind == NodeKind.DO_LOOP | s.kind == NodeKind.DO_WHILE_LOOP | s.kind == NodeKind.FOR_IN_LOOP)
                                    {
                                        case (true) {
                                        this.rewrite_returns(s.b, rt, post, void_mode);
                                    }
                                        default {
                                        switch (s.kind)
                                        {
                                            case (NodeKind.FOR_LOOP) { this.rewrite_returns(s.d, rt, post, void_mode); }
                                            case (NodeKind.SWITCH_STATEMENT)
                                            {
                                                k = 0;
                                                while (k < node_count(s, 0))
                                                {
                                                    this.rewrite_returns(s.l0.items[k].b, rt, post, void_mode);
                                                    k++;
                                                };
                                            }
                                            case (NodeKind.TRY_BLOCK)
                                            {
                                                this.rewrite_returns(s.a, rt, post, void_mode);
                                                k = 0;
                                                while (k < node_count(s, 0))
                                                {
                                                    this.rewrite_returns(s.l0.items[k].a, rt, post, void_mode);
                                                    k++;
                                                };
                                            }
                                            default {};
                                        };
                                    };
                                    };
                                };
                            };
                            nv_push(out, s);
                        };
                        switch (old != (NodeVec*)0)
                        {
                            case (true) {
                            old.len = 0;
                            nv_free(old);
                        }
                            default {};
                        };
                        blk.l0 = out;
                        ->;
                    };
                };
            };



            apply_post_contracts(Node* f, Node* post) -> void
            {
                switch (f.a == (Node*)0 | node_count(post, 0) == 0)
                {
                    case (true) { ->; }
                    default
                    {
                        bool void_mode = f.ts != (TypeSpec*)0 & f.ts.base_type == DataType.VOID;
                        this.rewrite_returns(f.a, f.ts, post, void_mode);
                        switch (void_mode)
                        {
                            case (true) {
                            switch (f.a.l0 == (NodeVec*)0)
                            {
                                case (true) { f.a.l0 = nv_new(); }
                                default {};
                            };
                            this.push_post_copies(f.a.l0, post);
                        }
                            default {};
                        };
                        ->;
                    };
                };
            };




            comptime_block() -> Node*
            {
                Node* n = this.mk(NodeKind.COMPTIME_BLOCK, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.advance();
                        switch (this.expect(TokenType.IDENTIFIER))
                        {
                            case (true) {
                            n.text = this.cur_value();
                            this.advance();
                        }
                            default {};
                        };
                        switch (!this.consume(TokenType.LEFT_BRACE))
                        {
                            case (true) { -> this.done(n); }
                            default
                            {
                                this.in_comptime++; this.eof_msg = g"Unexpected EOF inside 'comptime' block\0"; this.statements_until_brace(n); this.eof_msg = (byte*)0; this.in_comptime--;
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                    default {};
                                };
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.SEMICOLON); }
                                    default {};
                                };
                                -> this.done(n);
                            };
                        };
                    };
                };
            };





            sub_expr(byte* text, int n) -> Node*
            {
                byte* src = this.own_n(text, n);
                Lexer* sl = (Lexer*)fmalloc((u64)((sizeof(Lexer) + 7) / 8));
                switch (sl == (Lexer*)0)
                {
                    case (true) {
                    this.fail_alloc();
                    -> (Node*)0;
                }
                    default
                    {
                        sl.__init(src, n);
                        pv_push(this.sublex, (void*)sl);
                        switch (!sl.tokenize())
                        {
                            case (true) {
                            this.error(g"Invalid expression in string interpolation\0");
                            -> (Node*)0;
                        }
                            default
                            {
                                Lexer* s_lx = this.lx;
                                Token* s_toks = this.toks;
                                int s_count = this.count;
                                int s_pos = this.pos;
                                this.lx = sl;
                                this.toks = sl.tokens;
                                this.count = sl.count;
                                this.pos = 0;
                                Node* e = this.expression();
                                this.lx = s_lx;
                                this.toks = s_toks;
                                this.count = s_count;
                                this.pos = s_pos;
                                -> e;
                            };
                        };
                    };
                };
            };


            flush_text(Node* holder, int line, int col) -> void
            {
                switch (this.sb.len == 0)
                {
                    case (true) { ->; }
                    default
                    {
                        Node* t = this.mk(NodeKind.STRING_LITERAL, line, col);
                        switch (this.failed)
                        {
                            case (true) { ->; }
                            default
                            {
                                t.text = this.own_n(this.sb.mem, this.sb.len);
                                t.ival = (i64)this.sb.len;
                                t.op = -1;
                                node_push(holder, 0, t);
                                this.sb.len = 0;
                                this.sb.mem[0] = (byte)0;
                                ->;
                            };
                        };
                    };
                };
            };

            is_space(int c) -> bool -> c == 32 | c == 9 | c == 10 | c == 13;


            f_string_node() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* n = this.mk(NodeKind.F_STRING_LITERAL, line, col);
                n.op = 1;
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        byte* v = this.cur_value();
                        int end = this.cur_value_len() - 1;
                        int i = 2;
                        int j;
                        Node* e;
                        this.advance();
                        this.sb.len = 0;
                        this.sb.mem[0] = (byte)0;
                        while (i < end)
                        {
                            switch (v[i] == '{' & i + 1 < end & v[i + 1] == '{')
                            {
                                case (true) {
                                this.sb.put('{');
                                i += 2;
                            }
                                default {
                                    switch (v[i] == '}' & i + 1 < end & v[i + 1] == '}')
                                    {
                                        case (true) {
                                this.sb.put('}');
                                i += 2;
                            }
                                        default {
                                            switch (v[i] == '{')
                                            {
                                                case (true) {
                                j = i + 1;
                                while (j < end & v[j] != '}') { j++; };
                                switch (j >= end)
                                {
                                    case (true) {
                                    this.error(g"Unclosed expression in f-string\0");
                                    -> this.done(n);
                                }
                                    default
                                    {
                                        this.flush_text(n, line, col);
                                        e = this.sub_expr(v + i + 1, j - i - 1);

                                        this.sb.len = 0;
                                        this.sb.mem[0] = (byte)0;
                                        switch (this.failed)
                                        {
                                            case (true) { -> this.done(n); }
                                            default
                                            {
                                                node_push(n, 0, e);
                                                i = j + 1;
                                            };
                                        };
                                    };
                                };
                            }
                                                default {
                                this.sb.put((int)v[i]);
                                i++;
                            };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        this.flush_text(n, line, col);
                        -> this.done(n);
                    };
                };
            };


            i_string_node() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* n = this.mk(NodeKind.F_STRING_LITERAL, line, col);
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        byte* v = this.cur_value();
                        int len = this.cur_value_len();
                        this.advance();
                        int i = 2;
                        this.sb.len = 0;
                        this.sb.mem[0] = (byte)0;
                        bool closed = false;
                        while (i < len & !closed)
                        {
                            switch (v[i] == '\\' & i + 1 < len)
                            {
                                case (true) {
                                this.sb.put((int)v[i]);
                                this.sb.put((int)v[i + 1]);
                                i += 2;
                            }
                                default {
                                    switch (v[i] == '"')
                                    {
                                        case (true) {
                                i++;
                                closed = true;
                            }
                                        default {
                                this.sb.put((int)v[i]);
                                i++;
                            };
                                    };
                                };
                            };
                        };
                        byte* tpl = this.own_n(this.sb.mem, this.sb.len);
                        int tlen = this.sb.len;
                        while (i < len & this.is_space((int)v[i])) { i++; };
                        switch (i < len & v[i] == ':')
                        {
                            case (true) {
                            i++;
                            while (i < len & this.is_space((int)v[i])) { i++; };
                        }
                            default {};
                        };
                        PtrVec* exprs = pv_new();
                        int a, b;
                        Node* e;
                        switch (i < len & v[i] == '{' & v[len - 1] == '}')
                        {
                            case (true) {
                            i++;
                            len = len - 1;
                            while (i <= len & !this.failed)
                            {
                                a = i;
                                while (a < len & v[a] != ';') { a++; };
                                b = a;
                                while (i < b & this.is_space((int)v[i])) { i++; };
                                while (b > i & this.is_space((int)v[b - 1])) { b--; };
                                switch (b > i)
                                {
                                    case (true) {
                                    e = this.sub_expr(v + i, b - i);
                                    switch (!this.failed)
                                    {
                                        case (true) { pv_push(exprs, (void*)e); }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                i = a + 1;
                            };
                        }
                            default {};
                        };
                        switch (this.failed)
                        {
                            case (true) {
                            pv_free(exprs);
                            -> this.done(n);
                        }
                            default
                            {
                                int k, used;
                                this.sb.len = 0;
                                this.sb.mem[0] = (byte)0;
                                while (k < tlen)
                                {
                                    switch (tpl[k] == '{' & k + 1 < tlen & tpl[k + 1] == '}')
                                    {
                                        case (true) {
                                        switch (used < exprs.len)
                                        {
                                            case (true) {
                                            this.flush_text(n, line, col);
                                            node_push(n, 0, (Node*)exprs.items[used]);
                                            used++;
                                        }
                                            default {};
                                        };
                                        k += 2;
                                    }
                                        default {
                                        this.sb.put((int)tpl[k]);
                                        k++;
                                    };
                                    };
                                };
                                this.flush_text(n, line, col);
                                while (used < exprs.len)
                                {
                                    node_free((Node*)exprs.items[used]);
                                    used++;
                                };
                                pv_free(exprs);
                                -> this.done(n);
                            };
                        };
                    };
                };
            };





            binding_name() -> byte*
            {
                switch (this.expect(TokenType.THIS))
                {
                    case (true) {
                    this.advance();
                    -> g"this\0";
                }
                    default
                    {
                        -> this.ident();
                    };
                };
            };

            binding_pre(Node* b) -> void
            {
                Node* x = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        node_push(b, 0, x);
                        x.text = this.binding_name();
                        ->;
                    };
                };
            };


            binding_ref(Node* b) -> void
            {
                bool ok;
                Node* x = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        node_push(b, 1, x);
                        x.ival = -1;
                        switch (this.expect(TokenType.NOT))
                        {
                            case (true) {
                            this.advance();
                            x.op = 1;
                        }
                            default {};
                        };
                        x.text = this.binding_name();
                        switch (this.failed)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch (this.expect(TokenType.LEFT_PAREN))
                                {
                                    case (true) {
                                    this.advance();
                                    switch (!this.expect(TokenType.SINT_LITERAL))
                                    {
                                        case (true) {
                                        -> this.fail_expected(TokenType.SINT_LITERAL);
                                    }
                                        default
                                        {
                                            x.ival = this.parse_int(this.cur_value(), @ok);
                                            this.advance();
                                            this.consume(TokenType.RIGHT_PAREN);
                                        };
                                    };
                                }
                                    default {};
                                };
                                ->;
                            };
                        };
                    };
                };
            };


            binding_spec() -> Node*
            {
                Node* b = this.mk(NodeKind.NODE_LIST, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> b; }
                    default
                    {
                        Node* x;
                        int cur_op;
                        switch (this.expect(TokenType.NOT))
                        {
                            case (true) {
                            this.advance();
                            x = this.mk(NodeKind.IDENTIFIER, b.line, b.col);
                            switch (this.failed)
                            {
                                case (true) { -> this.done(b); }
                                default
                                {
                                    x.text = g"!\0";
                                    node_push(b, 0, x);
                                };
                            };
                        }
                            default {
                            this.binding_pre(b);
                            while (!this.failed & this.expect(TokenType.COMMA))
                            {
                                this.advance();
                                this.binding_pre(b);
                            };
                        };
                        };
                        switch (this.failed)
                        {
                            case (true) { -> this.done(b); }
                            default
                            {
                                switch (!this.consume(TokenType.COLON))
                                {
                                    case (true) { -> this.done(b); }
                                    default
                                    {
                                        switch (this.expect(TokenType.NOT) & this.type_at(1) == TokenType.RIGHT_BRACE)
                                        {
                                            case (true) {
                                            this.advance();
                                            x = this.mk(NodeKind.IDENTIFIER, b.line, b.col);
                                            switch (this.failed)
                                            {
                                                case (true) { -> this.done(b); }
                                                default {};
                                            };
                                            x.text = g"!\0";
                                            x.ival = -1;
                                            node_push(b, 1, x);
                                            -> b;
                                        }
                                            default
                                            {
                                                this.binding_ref(b);
                                                while (!this.failed & this.expect3(TokenType.COMMA, TokenType.LOGICAL_OR, TokenType.LOGICAL_AND))
                                                {
                                                    switch (this.expect(TokenType.COMMA))
                                                    {
                                                        case (true) { cur_op = ','; }
                                                        default {
                                                            switch (this.expect(TokenType.LOGICAL_OR))
                                                            {
                                                                case (true) { cur_op = '|'; }
                                                                default { cur_op = '&'; };
                                                            };
                                                        };
                                                    };
                                                    switch (b.ival == 0)
                                                    {
                                                        case (true) { b.ival = (i64)cur_op; }
                                                        default {
                                                            switch (b.ival != (i64)cur_op)
                                                            {
                                                                case (true) {
                                                        this.error(g"Mixed operators in # binding post-side are not allowed; use the same operator throughout\0");
                                                        -> this.done(b);
                                                    }
                                                                default {};
                                                            };
                                                        };
                                                    };
                                                    this.advance();
                                                    this.binding_ref(b);
                                                };
                                                -> this.done(b);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            ref_index(Node* holder, int s, byte* name, int arity) -> int
            {
                switch (holder == (Node*)0)
                {
                    case (true) { -> -1; }
                    default
                    {
                        int i;
                        Node* x;
                        while (i < node_count(holder, s))
                        {
                            x = node_child(holder, s, i);
                            switch (cstr_eq(x.text, name))
                            {
                                case (true) {
                                switch (arity == -1 | (i64)arity == x.ival)
                                {
                                    case (true) { -> i; }
                                    default {};
                                };
                            }
                                default {};
                            };
                            i++;
                        };
                        -> -1;
                    };
                };
            };


            names_repr(Node* holder) -> byte*
            {
                byte* r = g"[\0";
                int i;
                while (i < node_count(holder, 1))
                {
                    switch (i > 0)
                    {
                        case (true) { r = this.cat2(r, g", \0"); }
                        default {};
                    };
                    r = this.cat2(this.cat2(this.cat2(r, g"'\0"), node_child(holder, 1, i).text), g"'\0");
                    i++;
                };
                -> this.cat2(r, g"]\0");
            };


            bind_err(byte* cname, byte* mid, byte* fname, byte* tail) -> void
            {
                byte* m = this.cat2(g"Contract '\0", cname);
                m = this.cat2(m, g"' binding \0");
                m = this.cat2(m, mid);
                m = this.cat2(m, g" on function '\0");
                m = this.cat2(m, fname);
                m = this.cat2(m, g"'\0");
                this.error(this.cat2(m, tail));
                ->;
            };

            quoted(byte* a, byte* b, byte* c) -> byte* -> this.cat2(this.cat2(a, b), c);



            validate_bindings(byte* fname, Node* pre, Node* post) -> void
            {
                int npre, npost;
                switch (pre != (Node*)0)
                {
                    case (true) { npre = node_count(pre, 1); }
                    default {};
                };
                switch (post != (Node*)0)
                {
                    case (true) { npost = node_count(post, 1); }
                    default {};
                };
                int total = npre + npost;
                int ci, k, i, j, last, found;
                Node* ct;
                Node* bd;
                Node* x;
                byte* cname;
                byte* rn;
                bool is_pre, is_post, matched, neg;
                int op;
                while (ci < total & !this.failed)
                {
                    switch (ci < npre)
                    {
                        case (true) { cname = node_child(pre, 1, ci).text; }
                        default { cname = node_child(post, 1, ci - npre).text; };
                    };
                    ci++;

                    k = 0;
                    found = 0;
                    while (k < ci - 1)
                    {
                        switch (k < npre)
                        {
                            case (true) { rn = node_child(pre, 1, k).text; }
                            default { rn = node_child(post, 1, k - npre).text; };
                        };
                        switch (cstr_eq(rn, cname))
                        {
                            case (true) { found = 1; }
                            default {};
                        };
                        k++;
                    };
                    switch (found == 1)
                    {
                        case (true) { continue; }
                        default
                        {
                            ct = this.contract_find(cname);
                            switch (ct == (Node*)0)
                            {
                                case (true) { continue; }
                                default
                                {
                                    bd = ct.b;
                                    switch (bd == (Node*)0)
                                    {
                                        case (true) { continue; }
                                        default
                                        {
                                            is_pre = this.ref_index(pre, 1, cname, -1) >= 0;
                                            is_post = this.ref_index(post, 1, cname, -1) >= 0;


                                            switch (cstr_eq(node_child(bd, 0, 0).text, g"!\0"))
                                            {
                                                case (true) {
                                                switch (npre > 0)
                                                {
                                                    case (true) {
                                                    -> this.bind_err(cname, g"declares no pre-contract is allowed\0", fname, this.cat2(g", but pre-contracts are present: \0", this.names_repr(pre)));
                                                }
                                                    default {};
                                                };
                                            }
                                                default {
                                                i = 0;
                                                while (i < node_count(bd, 0) & !this.failed)
                                                {
                                                    rn = node_child(bd, 0, i).text;
                                                    i++;
                                                    switch (cstr_eq(rn, g"this\0"))
                                                    {
                                                        case (true) {
                                                        switch (!is_pre)
                                                        {
                                                            case (true) { this.bind_err(cname, g"requires itself as a pre-contract\0", fname, g", but it is only used as a post-contract\0"); }
                                                            default {};
                                                        };
                                                    }
                                                        default {
                                                            switch (this.ref_index(pre, 1, rn, -1) < 0)
                                                            {
                                                                case (true) {
                                                        switch (this.ref_index(post, 1, rn, -1) >= 0)
                                                        {
                                                            case (true) {
                                                            this.bind_err(cname, this.quoted(g"requires '\0", rn, g"' as a pre-contract\0"), fname, g", but it is inverted (used as a post-contract instead)\0");
                                                        }
                                                            default {
                                                            this.bind_err(cname, this.quoted(g"requires pre-contract '\0", rn, g"'\0"), fname, g", but it is not present\0");
                                                        };
                                                        };
                                                    }
                                                                default {};
                                                            };
                                                        };
                                                    };
                                                };
                                                switch (this.failed)
                                                {
                                                    case (true) { ->; }
                                                    default {};
                                                };
                                            };
                                            };


                                            switch (node_count(bd, 1) == 0)
                                            {
                                                case (true) { continue; }
                                                default
                                                {
                                                    switch (cstr_eq(node_child(bd, 1, 0).text, g"!\0"))
                                                    {
                                                        case (true) {
                                                        switch (npost > 0)
                                                        {
                                                            case (true) {
                                                            -> this.bind_err(cname, g"declares no post-contract is allowed\0", fname, this.cat2(g", but post-contracts are present: \0", this.names_repr(post)));
                                                        }
                                                            default {};
                                                        };
                                                        continue;
                                                    }
                                                        default
                                                        {
                                                            op = (int)bd.ival;

                                                            switch (op == '&')
                                                            {
                                                                case (true) {
                                                                i = 0;
                                                                while (i < node_count(bd, 1) & !this.failed)
                                                                {
                                                                    x = node_child(bd, 1, i);
                                                                    i++;
                                                                    rn = x.text;
                                                                    switch (cstr_eq(rn, g"this\0"))
                                                                    {
                                                                        case (true) { rn = cname; }
                                                                        default {};
                                                                    };
                                                                    matched = this.ref_index(post, 1, rn, (int)x.ival) >= 0;
                                                                    neg = x.op == 1;
                                                                    switch (!neg & !matched)
                                                                    {
                                                                        case (true) {
                                                                        switch (this.ref_index(pre, 1, rn, (int)x.ival) >= 0)
                                                                        {
                                                                            case (true) {
                                                                            this.bind_err(cname, this.quoted(g"requires '\0", rn, g"' as a post-contract\0"), fname, g", but it is inverted (used as a pre-contract instead)\0");
                                                                        }
                                                                            default {
                                                                            this.bind_err(cname, this.quoted(g"requires post-contract '\0", rn, g"'\0"), fname, g"\0");
                                                                        };
                                                                        };
                                                                    }
                                                                        default {
                                                                            switch (neg & matched)
                                                                            {
                                                                                case (true) {
                                                                        this.bind_err(cname, this.quoted(g"forbids post-contract '\0", rn, g"'\0"), fname, g"\0");
                                                                    }
                                                                                default {};
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                                switch (this.failed)
                                                                {
                                                                    case (true) { ->; }
                                                                    default {};
                                                                };
                                                                continue;
                                                            }
                                                                default
                                                                {

                                                                    i = 0;
                                                                    while (i < node_count(bd, 1) & !this.failed)
                                                                    {
                                                                        x = node_child(bd, 1, i);
                                                                        i++;
                                                                        switch (x.op == 1)
                                                                        {
                                                                            case (true) {
                                                                            rn = x.text;
                                                                            switch (cstr_eq(rn, g"this\0"))
                                                                            {
                                                                                case (true) { rn = cname; }
                                                                                default {};
                                                                            };
                                                                            switch (this.ref_index(post, 1, rn, (int)x.ival) >= 0)
                                                                            {
                                                                                case (true) {
                                                                                this.bind_err(cname, this.quoted(g"forbids post-contract '\0", rn, g"'\0"), fname, g"\0");
                                                                            }
                                                                                default {};
                                                                            };
                                                                        }
                                                                            default {};
                                                                        };
                                                                    };
                                                                    switch (this.failed)
                                                                    {
                                                                        case (true) { ->; }
                                                                        default
                                                                        {
                                                                            last = -1;
                                                                            i = 0;
                                                                            while (i < node_count(bd, 1) & !this.failed)
                                                                            {
                                                                                x = node_child(bd, 1, i);
                                                                                i++;
                                                                                switch (x.op == 1)
                                                                                {
                                                                                    case (true) { continue; }
                                                                                    default
                                                                                    {
                                                                                        rn = x.text;
                                                                                        switch (cstr_eq(rn, g"this\0"))
                                                                                        {
                                                                                            case (true) { rn = cname; }
                                                                                            default {};
                                                                                        };
                                                                                        j = this.ref_index(post, 1, rn, (int)x.ival);
                                                                                        switch (j < 0)
                                                                                        {
                                                                                            case (true) {
                                                                                            switch (op == '|')
                                                                                            {
                                                                                                case (true) { continue; }
                                                                                                default {};
                                                                                            };
                                                                                            switch (this.ref_index(pre, 1, rn, (int)x.ival) >= 0)
                                                                                            {
                                                                                                case (true) {
                                                                                                this.bind_err(cname, this.quoted(g"requires '\0", rn, g"' as a post-contract\0"), fname, g", but it is inverted (used as a pre-contract instead)\0");
                                                                                            }
                                                                                                default {
                                                                                                this.bind_err(cname, this.quoted(g"requires post-contract '\0", rn, g"'\0"), fname, g"\0");
                                                                                            };
                                                                                            };
                                                                                            continue;
                                                                                        }
                                                                                            default
                                                                                            {
                                                                                                switch (j <= last)
                                                                                                {
                                                                                                    case (true) {
                                                                                                    this.bind_err(cname, this.cat2(g"requires post-contracts \0", this.required_repr(bd, cname)), fname, g" in that order\0");
                                                                                                    continue;
                                                                                                }
                                                                                                    default
                                                                                                    {
                                                                                                        last = j;
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                ->;
            };


            required_repr(Node* bd, byte* cname) -> byte*
            {
                byte* r = g"[\0";
                int i, n;
                Node* x;
                byte* nm;
                while (i < node_count(bd, 1))
                {
                    x = node_child(bd, 1, i);
                    i++;
                    switch (x.op == 1)
                    {
                        case (true) { continue; }
                        default
                        {
                            nm = x.text;
                            switch (cstr_eq(nm, g"this\0"))
                            {
                                case (true) { nm = cname; }
                                default {};
                            };
                            switch (n > 0)
                            {
                                case (true) { r = this.cat2(r, g", \0"); }
                                default {};
                            };
                            r = this.cat2(this.cat2(this.cat2(r, g"'\0"), nm), g"'\0");
                            n++;
                        };
                    };
                };
                -> this.cat2(r, g"]\0");
            };






            statement() -> Node*
            {
                int sc = -1;
                int m, c;
                bool is_asm, is_func, is_volatile;
                bool at_top = this.top_stmt;
                this.top_stmt = false;
                if (!at_top & this.is_module_def())
                {
                    this.error(g"A module can only be declared at the top level, not inside a function, namespace, or another module\0");
                    -> (Node*)0;
                };

                c = this.cur();
                switch (c)
                {
                    case (TokenType.GLOBAL)
                    {
                        sc = StorageClass.GLOBAL;
                        this.advance();
                    }
                    case (TokenType.LOCAL)
                    {
                        sc = StorageClass.LOCAL;
                        this.advance();
                    }
                    case (TokenType.HEAP)
                    {
                        sc = StorageClass.HEAP;
                        this.advance();
                    }
                    case (TokenType.STACK)
                    {
                        sc = StorageClass.STACK;
                        this.advance();
                    }
                    case (TokenType.REGISTER)
                    {
                        sc = StorageClass.REGISTER;
                        this.advance();
                    }
                    case (TokenType.SINGINIT)
                    {
                        sc = StorageClass.SINGINIT;
                        this.advance();
                    }
                    default {};
                };

                switch (sc >= 0 | this.expect2(TokenType.CONST, TokenType.VOLATILE))
                {
                    case (true) {
                    m = this.mark();
                    while (this.expect4(TokenType.CONST, TokenType.VOLATILE, TokenType.SINGINIT, TokenType.INLINE))
                    {
                        this.advance();
                    };
                    is_asm = this.expect(TokenType.ASM);
                    is_func = this.expect4(TokenType.DEF, TokenType.ASYNC, TokenType.INLINE, TokenType.NO_MANGLE)
                            | this.is_calling_conv(this.cur())
                            | this.is_bare_function_def();
                    this.reset(m);

                    switch (is_asm)
                    {
                        case (true) {
                        is_volatile = false;
                        switch (this.expect(TokenType.VOLATILE))
                        {
                            case (true) {
                            is_volatile = true;
                            this.advance();
                        }
                            default {};
                        };
                        -> this.asm_statement(is_volatile);
                    }
                        default {
                            switch (is_func)
                            {
                                case (true) {
                        -> this.function_def();
                    }
                                default {
                        switch (sc >= 0)
                        {
                            case (true) { this.pos--; }
                            default {};
                        };
                        -> this.variable_declaration_statement();
                    };
                            };
                        };
                    };
                }
                    default {};
                };

                if (this.is_module_def())
                {
                    if (!at_top)
                    {
                        this.error(g"A module can only be declared at the top level, not inside a function, namespace, or another module\0");
                        -> (Node*)0;
                    };
                    -> this.module_def();
                };

                c = this.cur();
                switch (c)
                {
                    case (TokenType.MACRO) { -> this.macro_def(); }
                    case (TokenType.USING) { -> this.using_statement(); }
                    case (TokenType.NOT)
                    {
                        this.advance();
                        switch (this.expect(TokenType.USING))
                        {
                            case (true) {
                            this.advance();
                            -> this.not_using_statement();
                        }
                            default {};
                        };
                    }
                    case (TokenType.OPERATOR) { -> this.operator_def(); }
                    case (TokenType.EXTERN) { -> this.extern_statement(); }
                    case (TokenType.EXPORT) { -> this.export_statement(); }
                    case (TokenType.CONTRACT) { -> this.contract_def(); }
                    case (TokenType.CONSTRAINT) { -> this.constra_def(); }
                    case (TokenType.EFFECT) { -> this.effect_def(); }
                    case (TokenType.ASYNC)
                    {
                        switch (this.is_async_tag_def())
                        {
                            case (true) { -> this.async_tag_def(); }
                            default
                            {
                                -> this.function_def();
                            };
                        };
                    }
                    case (TokenType.INLINE) { -> this.function_def(); }
                    case (TokenType.DEF) { -> this.function_def(); }
                    case (TokenType.NO_MANGLE) { -> this.function_def(); }
                    default
                    {
                        switch (this.is_calling_conv(c))
                        {
                            case (true) { -> this.function_def(); }
                            default {
                                switch (this.is_bare_function_def())
                                {
                                    case (true) { -> this.function_def(); }
                                    default {
                                        switch (c == TokenType.ENUM)
                                        {
                                            case (true) { -> this.enum_def(); }
                                            default {
                                                switch (this.type_at(1) == TokenType.ENUM)
                                                {
                                                    case (true) { -> this.enum_def(); }
                                                    default {
                            switch (c)
                            {
                                case (TokenType.UNION) { -> this.union_def(); }
                                case (TokenType.STRUCT)
                                {
                                    switch (this.type_at(1) == TokenType.MULTIPLY)
                                    {
                                        case (true) {
                                        -> this.variable_declaration_statement();
                                    }
                                        default
                                        {
                                            -> this.struct_def();
                                        };
                                    };
                                }
                                case (TokenType.OBJECT)
                                {
                                    switch (this.type_at(1) == TokenType.MULTIPLY)
                                    {
                                        case (true) {
                                        -> this.variable_declaration_statement();
                                    }
                                        default
                                        {
                                            -> this.object_def();
                                        };
                                    };
                                }
                                case (TokenType.TRAIT) { -> this.trait_def(); }
                                case (TokenType.INTERFACE) { -> this.interface_def(); }
                                default
                                {
                                    switch (this.is_trait_prefixed_object())
                                    {
                                        case (true) { -> this.trait_prefixed_object(); }
                                        default {
                                        switch (c)
                                        {
                                            case (TokenType.NAMESPACE) { -> this.namespace_def(); }
                                            case (TokenType.IF) { -> this.if_statement(); }
                                            case (TokenType.DO) { -> this.do_while_statement(); }
                                            case (TokenType.WHILE) { -> this.while_statement(); }
                                            case (TokenType.FOR) { -> this.for_statement(); }
                                            case (TokenType.SWITCH) { -> this.switch_statement(); }
                                            case (TokenType.TRY) { -> this.try_statement(); }
                                            case (TokenType.RETURN) { -> this.return_statement(); }
                                            case (TokenType.RETURN_ARROW) { -> this.return_arrow_ret(); }
                                            case (TokenType.BREAK) { -> this.break_statement(); }
                                            case (TokenType.CONTINUE) { -> this.continue_statement(); }
                                            case (TokenType.LABEL) { -> this.label_statement(); }
                                            case (TokenType.GOTO) { -> this.goto_statement(); }
                                            case (TokenType.JUMP) { -> this.jump_statement(); }
                                            case (TokenType.THROW) { -> this.throw_statement(); }
                                            case (TokenType.ASSERT) { -> this.assert_statement(); }
                                            case (TokenType.DEFER) { -> this.defer_statement(); }
                                            case (TokenType.ESCAPE_KW) { -> this.escape_statement(); }
                                            case (TokenType.DEPRECATE) { -> this.deprecate_statement(); }
                                            case (TokenType.NORET) { -> this.noreturn_statement(); }
                                            case (TokenType.LEFT_BRACE) { -> this.block_statement(); }
                                            default
                                            {
                                                switch (this.is_type_func_def())
                                                {
                                                    case (true) { -> this.type_func_def(); }
                                                    default {
                                                        switch (this.is_dual_assign_declaration())
                                                        {
                                                            case (true) { -> this.dual_assign_declaration(); }
                                                            default {
                                                                switch (this.is_variable_declaration())
                                                                {
                                                                    case (true) { -> this.variable_declaration_statement(); }
                                                                    default {
                                                    switch (c)
                                                    {
                                                        case (TokenType.UNSIGNED) { -> this.variable_declaration_statement(); }
                                                        case (TokenType.SIGNED) { -> this.variable_declaration_statement(); }
                                                        default
                                                        {
                                                            switch (this.expect4(TokenType.SINT, TokenType.UINT, TokenType.DATA, TokenType.CHAR)
                                                                | this.expect4(TokenType.BYTE, TokenType.FLOAT_KW, TokenType.DOUBLE_KW, TokenType.BOOL_KW)
                                                                | this.expect4(TokenType.VOID, TokenType.SLONG, TokenType.ULONG, TokenType.DICT))
                                                            {
                                                                case (true) {
                                                                -> this.variable_declaration_statement();
                                                            }
                                                                default {
                                                                switch (c)
                                                                {
                                                                    case (TokenType.DITTO) { -> this.ditto_statement(); }
                                                                    case (TokenType.SEMICOLON)
                                                                    {
                                                                        this.advance();
                                                                        -> (Node*)0;
                                                                    }
                                                                    default
                                                                    {
                                                                        switch (c == TokenType.AUTO & this.type_at(1) == TokenType.LEFT_BRACE)
                                                                        {
                                                                            case (true) {
                                                                            Node* dn = this.destructuring_assignment();
                                                                            switch (!this.failed)
                                                                            {
                                                                                case (true) { this.consume(TokenType.SEMICOLON); }
                                                                                default {};
                                                                            };
                                                                            -> dn;
                                                                        }
                                                                            default {
                                                                                switch (c == TokenType.AUTO & this.type_at(1) == TokenType.IDENTIFIER)
                                                                                {
                                                                                    case (true) {
                                                                            Node* av = this.auto_variable_declaration();
                                                                            switch (!this.failed)
                                                                            {
                                                                                case (true) { this.consume(TokenType.SEMICOLON); }
                                                                                default {};
                                                                            };
                                                                            -> av;
                                                                        }
                                                                                    default {
                                                                            switch (c)
                                                                            {
                                                                                case (TokenType.CODIFY) { -> this.codify_statement(); }
                                                                                case (TokenType.COMPTIME) { -> this.comptime_block(); }
                                                                                case (TokenType.EMITIDEKA)
                                                                                {
                                                                                    switch (this.in_comptime == 0)
                                                                                    {
                                                                                        case (true) {
                                                                                        this.error(g"'emitideka' is only valid inside a 'comptime' block\0");
                                                                                        -> (Node*)0;
                                                                                    }
                                                                                        default
                                                                                        {
                                                                                            -> this.emitideka_statement();
                                                                                        };
                                                                                    };
                                                                                }
                                                                                case (TokenType.ASM) { -> this.asm_statement(false); }
                                                                                case (TokenType.IDEKAVM)
                                                                                {
                                                                                    switch (this.in_comptime == 0)
                                                                                    {
                                                                                        case (true) {
                                                                                        this.error(g"'idkvm' is only valid inside a 'comptime' block\0");
                                                                                        -> (Node*)0;
                                                                                    }
                                                                                        default
                                                                                        {
                                                                                            -> this.idkvm_statement();
                                                                                        };
                                                                                    };
                                                                                }
                                                                                default
                                                                                {
                                                                                    switch (c == TokenType.IDENTIFIER & this.val_is(g"error\0", 5) & this.type_at(1) >= 0 & this.type_at(1) != TokenType.ASSIGN)
                                                                                    {
                                                                                        case (true) {
                                                                                        -> this.error_return_statement();
                                                                                    }
                                                                                        default {
                                                                                        -> this.expression_statement();
                                                                                    };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                            };
                                                        };
                                                    };
                                                };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                    };
                                };
                            };
                        };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };

                -> (Node*)0;
            };







            async_collect(NodeVec* stmts, PtrVec* tags, PtrVec* funcs) -> void
            {
                switch (stmts == (NodeVec*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        int i;
                        Node* s;
                        while (i < stmts.len)
                        {
                            s = stmts.items[i];
                            i++;
                            switch (s == (Node*)0)
                            {
                                case (true) { continue; }
                                default
                                {
                                    switch (s.kind)
                                    {
                                        case (NodeKind.ASYNC_TAG_DEF) { pv_push(tags, (void*)s); }
                                        case (NodeKind.FUNCTION_DEF) { pv_push(funcs, (void*)s); }
                                        case (NodeKind.FUNCTION_DEF_STATEMENT)
                                        {
                                            switch (s.a != (Node*)0)
                                            {
                                                case (true) { pv_push(funcs, (void*)s.a); }
                                                default {};
                                            };
                                        }
                                        case (NodeKind.NAMESPACE_DEF_STATEMENT)
                                        {
                                            switch (s.a != (Node*)0)
                                            {
                                                case (true) { this.async_collect_ns(s.a, tags, funcs); }
                                                default {};
                                            };
                                        }
                                        case (NodeKind.NAMESPACE_DEF) { this.async_collect_ns(s, tags, funcs); }
                                        default {};
                                    };
                                };
                            };
                        };
                        ->;
                    };
                };
            };

            async_collect_ns(Node* ns, PtrVec* tags, PtrVec* funcs) -> void
            {
                this.async_collect(ns.l0, tags, funcs);
                switch (ns.b != (Node*)0)
                {
                    case (true) { this.async_collect(ns.b.l0, tags, funcs); }
                    default {};
                };
                ->;
            };

            async_find_tag(PtrVec* tags, byte* name) -> Node*
            {
                int i;
                while (i < tags.len)
                {
                    switch (cstr_eq(((Node*)tags.items[i]).text, name))
                    {
                        case (true) { -> (Node*)tags.items[i]; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> (Node*)0;
            };


            async_is_async(PtrVec* funcs, byte* name) -> bool
            {
                int i;
                Node* f;
                while (i < funcs.len)
                {
                    f = (Node*)funcs.items[i];
                    switch (cstr_eq(f.text, name) & (f.flags `& 2097152) != 0)
                    {
                        case (true) { -> true; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> false;
            };


            async_has_func(PtrVec* funcs, byte* name) -> bool
            {
                int i;
                while (i < funcs.len)
                {
                    switch (cstr_eq(((Node*)funcs.items[i]).text, name))
                    {
                        case (true) { -> true; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> false;
            };


            async_sig_matches(Node* f, Node* t) -> bool
            {
                int n;
                switch (f.l0 != (NodeVec*)0)
                {
                    case (true) { n = f.l0.len; }
                    default {};
                };
                int m;
                switch (t.l0 != (NodeVec*)0)
                {
                    case (true) { m = t.l0.len; }
                    default {};
                };
                switch (n != m)
                {
                    case (true) { -> false; }
                    default
                    {
                        int i;
                        while (i < n)
                        {
                            switch (!typespec_equal(f.l0.items[i].ts, t.l0.items[i].ts))
                            {
                                case (true) { -> false; }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                        switch (t.ts == (TypeSpec*)0)
                        {
                            case (true) { -> true; }
                            default
                            {
                                -> typespec_equal(f.ts, t.ts);
                            };
                        };
                    };
                };
            };

            async_number_text(int n) -> byte*
            {
                byte* r = (byte*)fmalloc((u64)12);
                int i = 10;
                int v = n;
                r[11] = (byte)0;
                while (i >= 0)
                {
                    r[i] = (byte)(48 + v % 10);
                    v = v / 10;
                    i--;
                    switch (v == 0)
                    {
                        case (true) { break; }
                        default {};
                    };
                };
                this.own(r);
                -> @r[i + 1];
            };







   async_err(byte* msg, int line, int col) -> void
   {
       Buf eb;
       eb.__init();
       IDEKA::errors::render(@eb, this.diag_color, IDEKA::errors::SEV_ERROR, msg, line, col, this.lx.src, this.lx.length, this.lmap, this.lmapn, this.lfiles, -1, 0, 0, 0, (byte*)0);
       println(eb.mem);
       eb.__exit();
       this.async_errs++;
       ->;
   };

   validate_async(Node* prog) -> void
            {
                PtrVec* tags = pv_new();
                PtrVec* funcs = pv_new();
                this.async_collect(prog.l0, tags, funcs);
                int fi, ui, ti, oi;
                Node* f, use, tag, t;
                bool ok;
                while (fi < funcs.len)
                {
                    f = (Node*)funcs.items[fi];
                    fi++;
                    switch (f.l1 == (NodeVec*)0)
                    {
                        case (true) { continue; }
                        default
                        {
                            ui = 0;
                            switch (!this.async_is_async(funcs, f.text))
                            {
                                case (true) {
                                    while (ui < f.l1.len)
                           {
                               use = f.l1.items[ui];
                               this.async_err(this.cat2(this.cat2(this.cat2(this.cat2(g"'#<\0", use.text), g">' can only be applied to an async function, but '\0"), f.text), g"' is not async\0"), use.line, use.col);
                               ui++;
                           };
                           ui = f.l1.len;
                                }
                                default {};
                            };
                            while (ui < f.l1.len)
                            {
                                use = f.l1.items[ui];
                                ui++;
                                tag = this.async_find_tag(tags, use.text);
                                switch (tag == (Node*)0)
                                {
                                    case (true) {
                                        this.async_err(this.cat2(this.cat2(g"unknown async tag '\0", use.text), g"'\0"), use.line, use.col);
                                        continue;
                                    }
                                    default
                                    {
                                        switch (use.l0.len != tag.l0.len)
                                        {
                                            case (true) {
                                                this.async_err(this.cat2(this.cat2(this.cat2(this.cat2(this.cat2(g"async tag '\0", use.text), g"' takes \0"), this.async_number_text(tag.l0.len)), g" target(s), got \0"), this.async_number_text(use.l0.len)), use.line, use.col);
                                                continue;
                                            }
                                            default
                                            {
                                                ti = 0;
                                                while (ti < use.l0.len)
                                                {
                                                    t = use.l0.items[ti];
                                                    ti++;
                                                    switch (cstr_eq(t.text, g"this\0"))
                                                    {
                                                        case (true) { continue; }
                                                        default
                                                        {
                                                            switch (!this.async_has_func(funcs, t.text))
                                                            {
                                                                case (true) {
                                                                    this.async_err(this.cat2(this.cat2(g"unknown async function '\0", t.text), g"'\0"), t.line, t.col);
                                                                    continue;
                                                                }
                                                                default
                                                                {
                                                                    switch (!this.async_is_async(funcs, t.text))
                                                                    {
                                                                        case (true) {
                                                                            this.async_err(this.cat2(this.cat2(this.cat2(this.cat2(g"'\0", t.text), g"' is not async and cannot be a target of '#<\0"), use.text), g">'\0"), t.line, t.col);
                                                                            continue;
                                                                        }
                                                                        default
                                                                        {
                                                                            switch (t.ival != 0)
                                                                            {
                                                                                case (true) {
                                                                                    ok = false;
                                                                                    oi = 0;
                                                                                    while (oi < funcs.len & !ok)
                                                                                    {
                                                                                        switch (cstr_eq(((Node*)funcs.items[oi]).text, t.text))
                                                                                        {
                                                                                            case (true) { ok = this.async_sig_matches((Node*)funcs.items[oi], t); }
                                                                                            default {};
                                                                                        };
                                                                                        oi++;
                                                                                    };
                                                                                    switch (!ok)
                                                                                    {
                                                                                        case (true) {
                                                                                            this.async_err(this.cat2(this.cat2(g"no async overload matches '\0", t.text), g"(...)'\0"), t.line, t.col);
                                                                                        }
                                                                                        default {};
                                                                                    };
                                                                                }
                                                                                default {};
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                pv_free(tags);
                -> pv_free(funcs);
            };

            parse() -> Node*
            {
                Node* prog = node_new(NodeKind.PROGRAM, 1, 1);
                Node* stmt;
                int k;
                switch (prog == (Node*)0)
                {
                    case (true) {
                    this.failed = true;
                    this.err_kind = ParseErr.ALLOC;
                    -> prog;
                }
                    default
                    {
                        switch (this.failed)
                        {
                            case (true) { -> prog; }
                            default
                            {
                                this.toks = this.lx.tokens;
                                this.count = this.lx.count;
                                this.pos = 0;
                                switch (this.count == 0)
                                {
                                    case (true) {
                                    this.error(g"no tokens to parse\0");
                                    -> prog;
                                }
                                    default
                                    {
                                        while (!this.expect(TokenType.EOF))
                                        {
                                            this.top_stmt = true;
                                            stmt = this.statement();
                                            switch (this.failed)
                                            {
                                                case (true) { break; }
                                                default
                                                {
                                                    switch (stmt != (Node*)0)
                                                    {
                                                        case (true) {
                                                        node_push(prog, 0, stmt);
                                                        this.last_stmt = stmt;
                                                    }
                                                        default {};
                                                    };
                                                    k = 0;
                                                    while (k < this.pending.len)
                                                    {
                                                        node_push(prog, 0, this.pending.items[k]);
                                                        k++;
                                                    };
                                                    switch (this.pending.len > 0)
                                                    {
                                                        case (true) { this.last_stmt = this.pending.items[this.pending.len - 1]; }
                                                        default {};
                                                    };
                                                    this.pending.len = 0;
                                                };
                                            };
                                        };
                                        switch (this.failed)
                                        {
                                            case (true) { -> prog; }
                                            default
                                            {

                                                k = 0;
                                                while (k < this.tinst_s.len)
                                                {
                                                    node_push(prog, 0, (Node*)this.tinst_s.items[k]);
                                                    k++;
                                                };
                                                k = 0;
                                                while (k < this.tinst_o.len)
                                                {
                                                    node_push(prog, 0, (Node*)this.tinst_o.items[k]);
                                                    k++;
                                                };
                                                k = 0;
                                                while (k < this.tinst_f.len)
                                                {
                                                    ((Node*)this.tinst_f.items[k]).flags = ((Node*)this.tinst_f.items[k]).flags `| 1048576;
                                                    node_push(prog, 0, (Node*)this.tinst_f.items[k]);
                                                    k++;
                                                };
                                                this.tinst_s.len = 0;
                                                this.tinst_o.len = 0;
                                                this.tinst_f.len = 0;
                                                this.validate_async(prog); switch (this.async_errs > 0) { case (true) { this.failed = true; this.err_kind = ParseErr.SILENT; } default {}; }; -> prog;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
};



















































using IDEKA::ast;
using IDEKA::preprocessor;
using IDEKA::types;
using IDEKA::check;

namespace IDEKA
{
    namespace typer
    {


        enum TyKind
        {
            UNKNOWN,
            INT,
            FLOAT,
            DOUBLE,
            PTR,
            AGG,
            ARRAY,
            VOID,
            FUNC,
            DICT
        };





        match_at(byte* s, int i, byte* lit) -> bool
        {
            int j;
            while (lit[j] != 0)
            {
                switch (s[i + j] != lit[j])
                {
                    case (true) { -> false; }
                    default
                    {
                        j++;
                    };
                };
            };
            -> true;
        };


        op_part_len(byte* s, int i) -> int
        {
            switch (match_at(s, i, g"^|!&\0"))
            {
                case (true) { -> 4; }
                default
                {
                    switch (match_at(s, i, g"^|!|\0"))
                    {
                        case (true) { -> 4; }
                        default
                        {
                            switch (match_at(s, i, g"^|!\0"))
                            {
                                case (true) { -> 3; }
                                default
                                {
                                    switch (match_at(s, i, g"`!&\0"))
                                    {
                                        case (true) { -> 3; }
                                        default
                                        {
                                            switch (match_at(s, i, g"`!|\0"))
                                            {
                                                case (true) { -> 3; }
                                                default
                                                {
                                                    switch (match_at(s, i, g"`^|\0"))
                                                    {
                                                        case (true) { -> 3; }
                                                        default
                                                        {
                                                            switch (match_at(s, i, g"^|\0"))
                                                            {
                                                                case (true) { -> 2; }
                                                                default
                                                                {
                                                                    switch (match_at(s, i, g"!&\0"))
                                                                    {
                                                                        case (true) { -> 2; }
                                                                        default
                                                                        {
                                                                            switch (match_at(s, i, g"!|\0"))
                                                                            {
                                                                                case (true) { -> 2; }
                                                                                default
                                                                                {
                                                                                    switch (match_at(s, i, g"<=\0"))
                                                                                    {
                                                                                        case (true) { -> 2; }
                                                                                        default
                                                                                        {
                                                                                            switch (match_at(s, i, g">=\0"))
                                                                                            {
                                                                                                case (true) { -> 2; }
                                                                                                default
                                                                                                {
                                                                                                    switch (match_at(s, i, g"==\0"))
                                                                                                    {
                                                                                                        case (true) { -> 2; }
                                                                                                        default
                                                                                                        {
                                                                                                            switch (match_at(s, i, g"!=\0"))
                                                                                                            {
                                                                                                                case (true) { -> 2; }
                                                                                                                default
                                                                                                                {
                                                                                                                    switch (match_at(s, i, g"++\0"))
                                                                                                                    {
                                                                                                                        case (true) { -> 2; }
                                                                                                                        default
                                                                                                                        {
                                                                                                                            switch (match_at(s, i, g"--\0"))
                                                                                                                            {
                                                                                                                                case (true) { -> 2; }
                                                                                                                                default
                                                                                                                                {
                                                                                                                                    switch (match_at(s, i, g"<<\0"))
                                                                                                                                    {
                                                                                                                                        case (true) { -> 2; }
                                                                                                                                        default
                                                                                                                                        {
                                                                                                                                            switch (match_at(s, i, g">>\0"))
                                                                                                                                            {
                                                                                                                                                case (true) { -> 2; }
                                                                                                                                                default
                                                                                                                                                {
                                                                                                                                                    -> 1;
                                                                                                                                                };
                                                                                                                                            };
                                                                                                                                        };
                                                                                                                                    };
                                                                                                                                };
                                                                                                                            };
                                                                                                                        };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };

        op_char_word(byte c) -> byte*
        {
            switch (c == '+')
            {
                case (true) { -> g"plus\0"; }
                default
                {
                    switch (c == '-')
                    {
                        case (true) { -> g"minus\0"; }
                        default
                        {
                            switch (c == '*')
                            {
                                case (true) { -> g"mul\0"; }
                                default
                                {
                                    switch (c == '/')
                                    {
                                        case (true) { -> g"div\0"; }
                                        default
                                        {
                                            switch (c == '%')
                                            {
                                                case (true) { -> g"mod\0"; }
                                                default
                                                {
                                                    switch (c == '!')
                                                    {
                                                        case (true) { -> g"not\0"; }
                                                        default
                                                        {
                                                            switch (c == '^')
                                                            {
                                                                case (true) { -> g"pow\0"; }
                                                                default
                                                                {
                                                                    switch (c == '&')
                                                                    {
                                                                        case (true) { -> g"and\0"; }
                                                                        default
                                                                        {
                                                                            switch (c == '|')
                                                                            {
                                                                                case (true) { -> g"or\0"; }
                                                                                default
                                                                                {
                                                                                    switch (c == '<')
                                                                                    {
                                                                                        case (true) { -> g"lt\0"; }
                                                                                        default
                                                                                        {
                                                                                            switch (c == '>')
                                                                                            {
                                                                                                case (true) { -> g"gt\0"; }
                                                                                                default
                                                                                                {
                                                                                                    switch (c == '=')
                                                                                                    {
                                                                                                        case (true) { -> g"eq\0"; }
                                                                                                        default
                                                                                                        {
                                                                                                            switch (c == '~')
                                                                                                            {
                                                                                                                case (true) { -> g"tilde\0"; }
                                                                                                                default
                                                                                                                {
                                                                                                                    switch (c == '`')
                                                                                                                    {
                                                                                                                        case (true) { -> g"tick\0"; }
                                                                                                                        default
                                                                                                                        {
                                                                                                                            -> (byte*)0;
                                                                                                                        };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };

        hex_char(int v) -> int
        {
            switch (v < 10)
            {
                case (true) { -> 48 + v; }
                default
                {
                    -> 97 + v - 10;
                };
            };
        };


        mangle_builtin_op(Buf* out, byte* sym) -> void
        {
            int i, j, plen;
            byte* w;
            bool first_part = true;
            int c;
            while (sym[i] != 0)
            {
                plen = op_part_len(sym, i);
                switch (!first_part)
                {
                    case (true) { out.put('_'); }
                    default {};
                };
                first_part = false;
                j = 0;
                while (j < plen)
                {
                    switch (j > 0)
                    {
                        case (true) { out.put('_'); }
                        default {};
                    };
                    w = op_char_word(sym[i + j]);
                    switch (w != (byte*)0)
                    {
                        case (true) { out.put_str(w); }
                        default {
                        c = (int)sym[i + j];
                        out.put_str(g"0x\0");
                        switch (c / 16 > 0)
                        {
                            case (true) { out.put(hex_char(c / 16)); }
                            default {};
                        };
                        out.put(hex_char(c % 16));
                    };
                    };
                    j++;
                };
                i = i + plen;
            };
            ->;
        };


        enum Conv
        {
            NONE,
            EXACT,
            INT_WIDEN,
            INT_NARROW,
            INT_TO_FLOAT,
            FLOAT_TO_INT,
            FLOAT_EXT,
            FLOAT_TRUNC,
            PTR_CAST,
            PTR_TO_INT,
            INT_TO_PTR,
            ARRAY_DECAY,
            ARRAY_COPY,
            ARRAY_PACK,
            STRUCT_LOAD,
            EXPR_CALL,
            INVALID
        };


        enum Site
        {
            STORE,     
            ARG,       
            RETURN     
        };

        struct ConvRec
        {
            Node* at;
            TypeSpec* dst;
            int site;
        };

        conv_name(int c) -> byte*
        {
            switch (c)
            {
                case (Conv.EXACT)        { -> g"exact\0"; }
                case (Conv.INT_WIDEN)    { -> g"int widen\0"; }
                case (Conv.INT_NARROW)   { -> g"int narrow\0"; }
                case (Conv.INT_TO_FLOAT) { -> g"int to float\0"; }
                case (Conv.FLOAT_TO_INT) { -> g"float to int\0"; }
                case (Conv.FLOAT_EXT)    { -> g"float extend\0"; }
                case (Conv.FLOAT_TRUNC)  { -> g"float truncate\0"; }
                case (Conv.PTR_CAST)     { -> g"pointer cast\0"; }
                case (Conv.PTR_TO_INT)   { -> g"pointer to int\0"; }
                case (Conv.INT_TO_PTR)   { -> g"int to pointer\0"; }
                case (Conv.ARRAY_DECAY)  { -> g"array decay\0"; }
                case (Conv.ARRAY_COPY)   { -> g"array copy\0"; }
                case (Conv.ARRAY_PACK)   { -> g"array pack\0"; }
                case (Conv.STRUCT_LOAD)  { -> g"struct load\0"; }
                case (Conv.EXPR_CALL)    { -> g"__expr call\0"; }
                case (Conv.INVALID)      { -> g"invalid\0"; }
                default                  { -> g"none\0"; };
            };
            -> g"none\0";
        };

        site_name(int s) -> byte*
        {
            switch (s == Site.ARG)
            {
                case (true) { -> g"argument\0"; }
                default
                {
                    switch (s == Site.RETURN)
                    {
                        case (true) { -> g"return\0"; }
                        default
                        {
                            -> g"assignment\0";
                        };
                    };
                };
            };
        };

        ends_with(byte* s, byte* suf) -> bool
        {
            int ls = pp_cstrlen(s);
            int lf = pp_cstrlen(suf);
            int i;
            switch (lf > ls)
            {
                case (true) { -> false; }
                default
                {
                    while (i < lf)
                    {
                        switch (s[ls - lf + i] != suf[i])
                        {
                            case (true) { -> false; }
                            default
                            {
                                i++;
                            };
                        };
                    };
                    -> true;
                };
            };
        };


        is_expr_kind(int k) -> bool
        {
            switch (k == NodeKind.LITERAL | k == NodeKind.IDENTIFIER | k == NodeKind.ARRAY_LITERAL |
                k == NodeKind.STRING_LITERAL | k == NodeKind.BINARY_OP | k == NodeKind.IN_EXPRESSION |
                k == NodeKind.HAS_EXPRESSION | k == NodeKind.UNARY_OP | k == NodeKind.CAST_EXPRESSION |
                k == NodeKind.TYPE_CONVERT_EXPRESSION | k == NodeKind.RANGE_EXPRESSION |
                k == NodeKind.ARRAY_COMPREHENSION | k == NodeKind.F_STRING_LITERAL |
                k == NodeKind.FUNCTION_CALL | k == NodeKind.MEMBER_ACCESS | k == NodeKind.METHOD_CALL)
            {
                case (true) {
                -> true;
            }
                default
                {
                    switch (k == NodeKind.VARIADIC_ACCESS | k == NodeKind.ARRAY_ACCESS | k == NodeKind.ARRAY_SLICE |
                        k == NodeKind.BIT_SLICE | k == NodeKind.BIT_INDEX_ACCESS | k == NodeKind.POINTER_DEREF |
                        k == NodeKind.ADDRESS_OF | k == NodeKind.STRINGIFY | k == NodeKind.CODIFY |
                        k == NodeKind.ALIGN_OF | k == NodeKind.TYPE_OF | k == NodeKind.SIZE_OF |
                        k == NodeKind.ENDIAN_OF | k == NodeKind.NO_INIT | k == NodeKind.IF_EXPRESSION |
                        k == NodeKind.TERNARY_OP | k == NodeKind.NULL_COALESCE | k == NodeKind.NOT_NULL)
                    {
                        case (true) {
                        -> true;
                    }
                        default
                        {
                            switch (k == NodeKind.FUNCTION_POINTER_CALL | k == NodeKind.TIE_EXPRESSION |
                                k == NodeKind.STRUCT_INSTANCE | k == NodeKind.STRUCT_LITERAL |
                                k == NodeKind.STRUCT_FIELD_ACCESS | k == NodeKind.STRUCT_RECAST |
                                k == NodeKind.TYPE_FUNC_CALL | k == NodeKind.DICT_LITERAL_EXPR |
                                k == NodeKind.DICT_LITERAL | k == NodeKind.MACRO_CALL)
                            {
                                case (true) {
                                -> true;
                            }
                                default
                                {
                                    -> false;
                                };
                            };
                        };
                    };
                };
            };
        };



        is_untyped_kind(int k) -> bool -> k == NodeKind.NO_INIT | k == NodeKind.RANGE_EXPRESSION | k == NodeKind.ARRAY_COMPREHENSION | k == NodeKind.MACRO_CALL;




        object ExprTyper
        {
            IDKC_SYMTABLE* st;
            PtrVec* arena;      
            PtrVec* shells;     
            PtrVec* anodes;     
            PtrVec* blobs;      
            PtrVec* unk;        
            Buf mb;             
            byte* cur_obj;      
            Node* cur_fn;       
            TypeSpec* cur_ret;  
            int typed, untyped;
            bool raw;           
            int ov_line;        
            int fs_line;        
            NameMap* macro_defs; 
            bool mac_fail;      
            int mac_depth;      
            bool null_term;     
            Checker* ck;        
            NameMap* unbuilt;   
            int* convs;         
            PtrVec* bad;        

            __init(IDKC_SYMTABLE* table) -> this
            {
                this.st = table;
                this.arena = pv_new();
                this.shells = pv_new();
                this.anodes = pv_new();
                this.blobs = pv_new();
                this.unk = pv_new();
                this.mb.__init();
                this.cur_obj = (byte*)0;
                this.cur_fn = (Node*)0;
                this.cur_ret = (TypeSpec*)0;
                this.typed = 0;
                this.untyped = 0;
                this.raw = false;
                this.ov_line = 0;
                this.fs_line = 0;
                this.macro_defs = nm_new();
                this.mac_fail = false;
                this.mac_depth = 0;
                this.null_term = false;
                this.unbuilt = (NameMap*)0;
                this.ck = (Checker*)0;
                this.convs = (int*)fmalloc((u64)32 * (u64)(sizeof(int) / 8));
                int ci;
                while (ci < 32)
                {
                    this.convs[ci] = 0;
                    ci++;
                };
                this.bad = pv_new();
                -> this;
            };

            __expr() -> ExprTyper* -> this;

            __exit() -> void
            {
                int i;
                NodeVec* sh;
                while (i < this.arena.len)
                {
                    ffree((byte*)this.arena.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.shells.len)
                {
                    sh = (NodeVec*)this.shells.items[i];
                    ffree((byte*)sh.items);
                    ffree((byte*)sh);
                    i++;
                };
                i = 0;
                while (i < this.anodes.len)
                {
                    node_free((Node*)this.anodes.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.blobs.len)
                {
                    ffree((byte*)this.blobs.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.bad.len)
                {
                    ffree((byte*)this.bad.items[i]);
                    i++;
                };
                pv_free(this.bad);
                ffree((byte*)this.convs);
                pv_free(this.arena);
                pv_free(this.shells);
                pv_free(this.anodes);
                pv_free(this.blobs);
                pv_free(this.unk);
                this.mb.__exit();
                -> nm_free(this.macro_defs);
            };

            clear_mb() -> void
            {
                this.mb.len = 0;
                switch (this.mb.mem != (byte*)0)
                {
                    case (true) { this.mb.mem[0] = (byte)0; }
                    default {};
                };
                ->;
            };





            keep(TypeSpec* t) -> TypeSpec*
            {
                switch (t != (TypeSpec*)0)
                {
                    case (true) { pv_push(this.arena, (void*)t); }
                    default {};
                };
                -> t;
            };

            mk(int base, int flags, int width) -> TypeSpec*
            {
                TypeSpec* t = typespec_new();
                t.base_type = base;
                t.flags = flags;
                t.bit_width = width;
                -> this.keep(t);
            };



            mk_int(int width, bool uns) -> TypeSpec*
            {
                switch (width == 1)
                {
                    case (true) { -> this.mk(DataType.BOOL, 0, -1); }
                    default
                    {
                        switch (uns)
                        {
                            case (true) { -> this.mk(DataType.UINT, 0, width); }
                            default
                            {
                                -> this.mk(DataType.SINT, 1, width);
                            };
                        };
                    };
                };
            };

            mk_named(int base, byte* name) -> TypeSpec*
            {
                TypeSpec* t = this.mk(base, 0, -1);
                t.custom_typename = name;
                -> t;
            };

            ptr_to(TypeSpec* t) -> TypeSpec*
            {
                switch (t == (TypeSpec*)0)
                {
                    case (true) { -> t; }
                    default
                    {
                        TypeSpec* c = typespec_clone(t);
                        c.flags = c.flags `| 64;
                        c.pointer_depth = c.pointer_depth + 1;
                        -> this.keep(c);
                    };
                };
            };

            byte_ptr() -> TypeSpec*
            {
                TypeSpec* t = this.mk(DataType.BYTE, 64, -1);
                t.pointer_depth = 1;
                -> t;
            };


            size_node(int v) -> Node*
            {
                Node* s = node_new(NodeKind.LITERAL, 0, 0);
                s.op = DataType.SINT;
                s.ival = (i64)v;
                pv_push(this.anodes, (void*)s);
                -> s;
            };

            pointee_of(TypeSpec* t) -> TypeSpec*
            {
                switch (t == (TypeSpec*)0)
                {
                    case (true) { -> t; }
                    default
                    {
                        switch (t.pointer_depth <= 0)
                        {
                            case (true) { -> (TypeSpec*)0; }
                            default
                            {
                                TypeSpec* c = typespec_clone(t);
                                c.pointer_depth = c.pointer_depth - 1;
                                switch (c.pointer_depth == 0)
                                {
                                    case (true) {
                                    switch (ts_is_pointer(c))
                                    {
                                        case (true) { c.flags = c.flags - 64; }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                -> this.keep(c);
                            };
                        };
                    };
                };
            };







            resolve_alias(TypeSpec* t) -> TypeSpec*
            {
                TypeSpec* cur = t;
                TypeSpec* tgt;
                TypeSpec* c;
                IDKC_SYMENTRY* e;
                int guard;
                while (guard < 16)
                {
                    switch (cur == (TypeSpec*)0)
                    {
                        case (true) { -> cur; }
                        default
                        {
                            switch (cur.custom_typename == (byte*)0)
                            {
                                case (true) { -> cur; }
                                default
                                {
                                    e = st_lookup_type(this.st, cur.custom_typename, (byte*)0);
                                    switch (e == (IDKC_SYMENTRY*)0)
                                    {
                                        case (true) { -> cur; }
                                        default
                                        {
                                            switch (e.kind_id != SymbolKind.TYPE)
                                            {
                                                case (true) { -> cur; }
                                                default
                                                {
                                                    tgt = (TypeSpec*)e.ts;
                                                    switch (tgt == (TypeSpec*)0)
                                                    {
                                                        case (true) { -> cur; }
                                                        default
                                                        {
                                                            switch (cur.pointer_depth > 0 | ts_is_array(cur))
                                                            {
                                                                case (true) {
                                                                c = typespec_clone(tgt);
                                                                c.pointer_depth = c.pointer_depth + cur.pointer_depth;
                                                                switch (cur.pointer_depth > 0)
                                                                {
                                                                    case (true) { c.flags = c.flags `| 64; }
                                                                    default {};
                                                                };
                                                                switch (ts_is_array(cur))
                                                                {
                                                                    case (true) {
                                                                    c.flags = c.flags `| 32;
                                                                    c.array_size = cur.array_size;
                                                                    c.array_dims = cur.array_dims;
                                                                }
                                                                    default {};
                                                                };
                                                                cur = this.keep(c);
                                                            }
                                                                default { cur = tgt; };
                                                            };
                                                            guard++;
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                -> cur;
            };

            kind_of(TypeSpec* t) -> int
            {
                switch (t == (TypeSpec*)0)
                {
                    case (true) { -> TyKind.UNKNOWN; }
                    default
                    {
                        TypeSpec* a = this.resolve_alias(t);
                        IDKC_SYMENTRY* e;
                        int b;
                        switch (ts_is_array(a))
                        {
                            case (true) {
                            switch (a.array_size != (Node*)0)
                            {
                                case (true) { -> TyKind.ARRAY; }
                                default {};
                            };
                            switch (a.array_dims != (NodeVec*)0)
                            {
                                case (true) {
                                switch (a.array_dims.len > 0)
                                {
                                    case (true) {
                                    switch (a.array_dims.items[0] != (Node*)0)
                                    {
                                        case (true) { -> TyKind.ARRAY; }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                            -> TyKind.PTR;
                        }
                            default
                            {
                                switch (ts_is_pointer(a))
                                {
                                    case (true) { -> TyKind.PTR; }
                                    default
                                    {
                                        switch (a.custom_typename != (byte*)0)
                                        {
                                            case (true) {
                                            e = st_lookup_type(this.st, a.custom_typename, (byte*)0);
                                            switch (e == (IDKC_SYMENTRY*)0)
                                            {
                                                case (true) { -> TyKind.UNKNOWN; }
                                                default {};
                                            };
                                            switch (e.kind_id == SymbolKind.STRUCT | e.kind_id == SymbolKind.OBJECT |
                                                e.kind_id == SymbolKind.UNION)
                                            {
                                                case (true) {
                                                -> TyKind.AGG;
                                            }
                                                default {};
                                            };
                                            switch (e.kind_id == SymbolKind.ENUM)
                                            {
                                                case (true) { -> TyKind.INT; }
                                                default {};
                                            };
                                            -> TyKind.UNKNOWN;
                                        }
                                            default
                                            {
                                                b = a.base_type;
                                                switch (b == DataType.SINT | b == DataType.UINT | b == DataType.SLONG | b == DataType.ULONG |
                                                    b == DataType.BOOL | b == DataType.CHAR | b == DataType.BYTE | b == DataType.DATA |
                                                    b == DataType.ENUM | b == DataType.STRUCT | b == DataType.OBJECT)
                                                {
                                                    case (true) {
                                                    -> TyKind.INT;
                                                }
                                                    default
                                                    {
                                                        switch (b == DataType.FLOAT)
                                                        {
                                                            case (true) { -> TyKind.FLOAT; }
                                                            default
                                                            {
                                                                switch (b == DataType.DOUBLE)
                                                                {
                                                                    case (true) { -> TyKind.DOUBLE; }
                                                                    default
                                                                    {
                                                                        switch (b == DataType.VOID)
                                                                        {
                                                                            case (true) { -> TyKind.VOID; }
                                                                            default
                                                                            {
                                                                                switch (b == DataType.THIS)
                                                                                {
                                                                                    case (true) { -> TyKind.PTR; }
                                                                                    default
                                                                                    {
                                                                                        switch (b == DataType.FUNC_PTR)
                                                                                        {
                                                                                            case (true) { -> TyKind.FUNC; }
                                                                                            default
                                                                                            {
                                                                                                switch (b == DataType.DICT)
                                                                                                {
                                                                                                    case (true) { -> TyKind.DICT; }
                                                                                                    default
                                                                                                    {
                                                                                                        switch (b == DataType.UNION)
                                                                                                        {
                                                                                                            case (true) { -> TyKind.AGG; }
                                                                                                            default
                                                                                                            {
                                                                                                                -> TyKind.UNKNOWN;
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            width_of(TypeSpec* t) -> int
            {
                TypeSpec* a = this.resolve_alias(t);
                int b;
                switch (a == (TypeSpec*)0)
                {
                    case (true) { -> 0; }
                    default
                    {
                        switch (a.custom_typename != (byte*)0)
                        {
                            case (true) { -> 32; }
                            default
                            {
                                b = a.base_type;
                                switch (b == DataType.SINT | b == DataType.UINT)
                                {
                                    case (true) {
                                    switch (a.bit_width > 0)
                                    {
                                        case (true) { -> a.bit_width; }
                                        default {};
                                    };
                                    -> 32;
                                }
                                    default
                                    {
                                        switch (b == DataType.SLONG | b == DataType.ULONG)
                                        {
                                            case (true) { -> 64; }
                                            default
                                            {
                                                switch (b == DataType.BOOL)
                                                {
                                                    case (true) { -> 1; }
                                                    default
                                                    {
                                                        switch (b == DataType.CHAR)
                                                        {
                                                            case (true) { -> 8; }
                                                            default
                                                            {
                                                                switch (b == DataType.STRUCT | b == DataType.OBJECT)
                                                                {
                                                                    case (true) { -> 8; }
                                                                    default
                                                                    {
                                                                        switch (b == DataType.ENUM)
                                                                        {
                                                                            case (true) { -> 32; }
                                                                            default
                                                                            {
                                                                                switch (b == DataType.BYTE)
                                                                                {
                                                                                    case (true) {
                                                                                    switch (a.bit_width > 0)
                                                                                    {
                                                                                        case (true) { -> a.bit_width; }
                                                                                        default {};
                                                                                    };
                                                                                    -> 8;
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        switch (b == DataType.DATA)
                                                                                        {
                                                                                            case (true) {
                                                                                            switch (a.bit_width > 0)
                                                                                            {
                                                                                                case (true) { -> a.bit_width; }
                                                                                                default {};
                                                                                            };
                                                                                            -> 0;
                                                                                        }
                                                                                            default
                                                                                            {
                                                                                                -> 0;
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            uns_of(TypeSpec* t) -> bool
            {
                TypeSpec* a = this.resolve_alias(t);
                switch (a == (TypeSpec*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (a.custom_typename != (byte*)0)
                        {
                            case (true) { -> false; }
                            default
                            {
                                switch (a.base_type == DataType.UINT)
                                {
                                    case (true) { -> true; }
                                    default
                                    {
                                        switch (a.base_type == DataType.BYTE)
                                        {
                                            case (true) { -> true; }
                                            default
                                            {
                                                switch (a.base_type == DataType.DATA)
                                                {
                                                    case (true) { -> !ts_is_signed(a); }
                                                    default
                                                    {
                                                        -> false;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            elem_of(TypeSpec* t) -> TypeSpec*
            {
                switch (t == (TypeSpec*)0)
                {
                    case (true) { -> t; }
                    default
                    {
                        TypeSpec* a = this.resolve_alias(t);
                        TypeSpec* c;
                        NodeVec* d;
                        NodeVec* sh;
                        int i;
                        switch (ts_is_array(a))
                        {
                            case (true) {
                            c = typespec_clone(a);
