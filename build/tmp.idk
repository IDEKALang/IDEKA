            ef_put_val(FvmBuf* o, int tag, i64 d, i64 m) -> void
            {
                u64 u;
                byte[24] tmp = noinit;
                int n;
                switch (tag)
                {
                    case (6)
                    {
                        switch (d != (i64)0)
                        {
                            case (true) { o.put_str(g"true\0"); }
                            default { o.put_str(g"false\0"); };
                        };
                    }
                    case (4) { fvm_put_double(o, fvm_dv(tag, d, m)); }
                    case (5) { fvm_put_double(o, fvm_dv(tag, d, m)); }
                    case (15) { o.put_n(fvm_i2p(d), (int)m); }
                    case (3)
                    {
                        switch (d < (i64)0)
                        {
                            case (true) {
                                u = (u64)d;
                                while (u != (u64)0)
                                {
                                    tmp[n] = (byte)(48 + (int)(u % (u64)10));
                                    u = u / (u64)10;
                                    n++;
                                };
                                while (n > 0) { n--; o.put((int)tmp[n]); };
                            }
                            default { o.put_i64(d); };
                        };
                    }
                    default { o.put_i64(d); };
                };
                ->;
            };


            ef_find(FvmVars* v, byte* nm, int nl) -> int
            {
                int i = v.n - 1;
                int k;
                bool same;
                while (i >= 0)
                {
                    same = fvm_strlen(v.names[i]) == nl;
                    k = 0;
                    while (same & k < nl)
                    {
                        same = v.names[i][k] == nm[k];
                        k++;
                    };
                    switch (same) { case (true) { -> i; } default {}; };
                    i--;
                };
                -> -1;
            };


            ef_get(FvmVars* v, int bi, int* tag, i64* d, i64* m) -> void
            {
                int fi = this.nframes - 1;
                int sl;
                *tag = 0;
                *d = (i64)0;
                *m = (i64)0;
                switch (bi >= 0)
                {
                    case (true) {
                        sl = v.slots[bi];
                        switch (fi >= 0 & sl >= 0)
                        {
                            case (true) {
                                switch (sl < this.fr_nloc[fi])
                                {
                                    case (true) {
                                        sl = this.fr_base[fi] + sl;
                                        switch (this.lc_set[sl] != 0)
                                        {
                                            case (true) {
                                                *tag = this.lc_tag[sl];
                                                *d = this.lc_data[sl];
                                                *m = this.lc_meta[sl];
                                            }
                                            default {};
                                        };
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                ->;
            };


            ef_subst(FvmBuf* o, FvmVars* v, byte* nm, int nl) -> void
            {
