            op_target(byte* prop) -> void
            {
                byte* triple = this.cc_get(g"__TARGET_TRIPLE__\0");
                byte* arch;
                int k, pw;
                bool x86;
                switch (triple == (byte*)0) { case (true) { triple = fvm_host_triple(); } default {}; };
                switch (triple[0] == 0) { case (true) { triple = fvm_host_triple(); } default {}; };
                arch = fvm_arch_of(triple);
                x86 = fvm_streq(arch, g"x86_64\0") | fvm_streq(arch, g"x86\0");

                switch (fvm_starts_with(prop, g"has_\0"))
                {
                    case (true)
                    {
                        switch (x86 & fvm_cpu_has(@prop[4])) { case (true) { this.push(6, (i64)1, (i64)0); } default { this.push(6, (i64)0, (i64)0); }; };
                        ->;
                    }
                    default {};
                };
                switch (fvm_streq(prop, g"arch\0")) { case (true) { this.push_bytes(arch, fvm_strlen(arch)); ->; } default {}; };
                switch (fvm_streq(prop, g"os\0")) { case (true) { arch = fvm_os_of(triple); this.push_bytes(arch, fvm_strlen(arch)); ->; } default {}; };
                switch (fvm_streq(prop, g"abi\0")) { case (true) { arch = fvm_abi_of(triple); this.push_bytes(arch, fvm_strlen(arch)); ->; } default {}; };
                switch (fvm_streq(prop, g"ptr_width\0"))
                {
                    case (true)
                    {
                        pw = 32;
                        switch (fvm_streq(arch, g"x86_64\0") | fvm_streq(arch, g"arm64\0") | fvm_streq(arch, g"aarch64\0") | fvm_has_ci(arch, g"64\0")) { case (true) { pw = 64; } default {}; };
                        pw = this.cc_int(g"__SIZEOF_PTR__\0", pw / 8) * 8;
                        this.push(0, (i64)pw, (i64)0);
                        ->;
                    }
                    default {};
                };
                switch (fvm_streq(prop, g"endian\0"))
                {
                    case (true)
                    {
                        switch (this.cc_int(g"__BIG_ENDIAN__\0", 0) != 0) { case (true) { this.push_bytes(g"big\0", 3); } default { this.push_bytes(g"little\0", 6); }; };
                        ->;
                    }
                    default {};
                };
                switch (fvm_streq(prop, g"cache_line\0")) { case (true) { this.push(0, (i64)64, (i64)0); ->; } default {}; };
                switch (fvm_streq(prop, g"page_size\0")) { case (true) { this.push(0, (i64)fvm_page_size(), (i64)0); ->; } default {}; };

                this.push_bytes(g"\0", 0);
                ->;
            };


            ptr_field_load(i64 addr, i64 pm, byte* field) -> void
            {
