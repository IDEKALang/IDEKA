        GetProcAddress(void*, byte*) -> void*;
};










namespace IDEKA
{
    namespace fvm
    {


        fvm_op_name(int op) -> byte*
        {
            switch (op)
            {
                case (0) { -> g"PUSH\0"; }
                case (1) { -> g"POP\0"; }
                case (2) { -> g"DUP\0"; }
                case (3) { -> g"SWAP\0"; }
                case (4) { -> g"ROT\0"; }
                case (5) { -> g"OVER\0"; }
                case (6) { -> g"ADD\0"; }
                case (7) { -> g"SUB\0"; }
                case (8) { -> g"MUL\0"; }
                case (9) { -> g"DIV\0"; }
                case (10) { -> g"MOD\0"; }
                case (11) { -> g"NEG\0"; }
                case (12) { -> g"POW\0"; }
                case (13) { -> g"ABS\0"; }
                case (14) { -> g"MIN\0"; }
                case (15) { -> g"MAX\0"; }
                case (16) { -> g"CLAMP\0"; }
                case (17) { -> g"BAND\0"; }
                case (18) { -> g"BOR\0"; }
                case (19) { -> g"BXOR\0"; }
                case (20) { -> g"BNOT\0"; }
                case (21) { -> g"SHL\0"; }
                case (22) { -> g"SHR\0"; }
                case (23) { -> g"ROTL\0"; }
                case (24) { -> g"ROTR\0"; }
                case (25) { -> g"BITREV\0"; }
                case (26) { -> g"POPCOUNT\0"; }
                case (27) { -> g"CLZ\0"; }
                case (28) { -> g"CTZ\0"; }
                case (29) { -> g"CMP_EQ\0"; }
                case (30) { -> g"CMP_NE\0"; }
                case (31) { -> g"CMP_LT\0"; }
                case (32) { -> g"CMP_LE\0"; }
                case (33) { -> g"CMP_GT\0"; }
                case (34) { -> g"CMP_GE\0"; }
                case (35) { -> g"AND\0"; }
                case (36) { -> g"OR\0"; }
                case (37) { -> g"NOT\0"; }
                case (38) { -> g"JMP\0"; }
                case (39) { -> g"JIF\0"; }
                case (40) { -> g"JNF\0"; }
                case (41) { -> g"JTABLE\0"; }
                case (42) { -> g"CALL\0"; }
                case (43) { -> g"CALL_PTR\0"; }
                case (44) { -> g"RET\0"; }
                case (45) { -> g"TAIL_SELF\0"; }
                case (46) { -> g"HALT\0"; }
                case (47) { -> g"THROW\0"; }
                case (48) { -> g"TRY_BEGIN\0"; }
                case (49) { -> g"TRY_END\0"; }
                case (50) { -> g"LOCAL_GET\0"; }
                case (51) { -> g"LOCAL_SET\0"; }
                case (52) { -> g"LOCAL_DEREF\0"; }
                case (53) { -> g"LOCAL_DEREF_SET\0"; }
                case (54) { -> g"GLOBAL_GET\0"; }
                case (55) { -> g"GLOBAL_SET\0"; }
                case (56) { -> g"ALLOC\0"; }
                case (57) { -> g"FREE\0"; }
                case (58) { -> g"LOAD\0"; }
                case (59) { -> g"STORE\0"; }
                case (60) { -> g"OFFSET\0"; }
                case (61) { -> g"STRUCT_NEW\0"; }
                case (62) { -> g"STRUCT_LOAD\0"; }
                case (63) { -> g"STRUCT_STORE\0"; }
                case (64) { -> g"ENUM_NEW\0"; }
                case (65) { -> g"ENUM_LOAD\0"; }
                case (66) { -> g"ENUM_STORE\0"; }
                case (67) { -> g"ARRAY_NEW\0"; }
                case (68) { -> g"ARRAY_LEN\0"; }
                case (69) { -> g"ARRAY_LOAD\0"; }
                case (70) { -> g"ARRAY_STORE\0"; }
                case (71) { -> g"SIZEOF\0"; }
                case (72) { -> g"TYPEOF\0"; }
                case (73) { -> g"ALIGNOF\0"; }
                case (74) { -> g"ENDIANOF\0"; }
                case (75) { -> g"IO_OPEN\0"; }
                case (76) { -> g"IO_READ\0"; }
                case (77) { -> g"IO_WRITE\0"; }
                case (78) { -> g"IO_CLOSE\0"; }
                case (79) { -> g"FFI_LOAD\0"; }
                case (80) { -> g"FFI_SYM\0"; }
                case (81) { -> g"FFI_CALL\0"; }
                case (82) { -> g"FFI_FREE\0"; }
                case (83) { -> g"COMPILER_PRINT\0"; }
                case (84) { -> g"COMPILER_PRINTLN\0"; }
                case (85) { -> g"COMPILER_INPUT\0"; }
                case (86) { -> g"COMPILER_READFILE\0"; }
                case (87) { -> g"COMPILER_WRITEFILE\0"; }
                case (88) { -> g"COMPILER_FVM_DUMP\0"; }
                case (89) { -> g"COMPILER_FVM_TRACE_BEGIN\0"; }
                case (90) { -> g"COMPILER_FVM_TRACE_END\0"; }
                case (91) { -> g"COMPILER_FVM_SETBP\0"; }
                case (92) { -> g"COMPILER_IMPORT_STDLIB\0"; }
                case (93) { -> g"COMPILER_LOADLIB\0"; }
                case (94) { -> g"COMPILER_IMPORT_LOCAL\0"; }
                case (95) { -> g"COMPILER_FPM_PACKAGE\0"; }
                case (96) { -> g"COMPILER_SYMTABLE\0"; }
                case (97) { -> g"COMPILER_SYMTABLE_FILTERED\0"; }
                case (98) { -> g"COMPILER_SYMTABLE_LOOKUP\0"; }
                case (99) { -> g"COMPILER_SYMTABLE_FUNCINFO\0"; }
                case (100) { -> g"COMPILER_TARGET_GET\0"; }
                case (101) { -> g"EXTERN_DECL\0"; }
                case (102) { -> g"STR_LEN\0"; }
                case (103) { -> g"STR_CAT\0"; }
                case (104) { -> g"STR_SLICE\0"; }
                case (105) { -> g"STR_EQ\0"; }
                case (106) { -> g"STR_FIND\0"; }
                case (107) { -> g"INT_TO_STR\0"; }
                case (108) { -> g"STR_TO_INT\0"; }
                case (109) { -> g"CAST\0"; }
                case (110) { -> g"BITCAST\0"; }
                case (111) { -> g"ASSERT\0"; }
                case (112) { -> g"WARN\0"; }
                case (113) { -> g"PANIC\0"; }
                case (114) { -> g"EMIT_CONST\0"; }
                case (115) { -> g"EMIT_GLOBAL\0"; }
                case (116) { -> g"EMIT_TYPE\0"; }
                case (117) { -> g"EMITIDEKA\0"; }
                case (118) { -> g"INLINE_ASM\0"; }
                case (119) { -> g"COMPILER_FVM_BINDUMP\0"; }
                default { -> g"?\0"; };
            };
        };



        fvm_bin_shape(int op) -> int
        {
            switch (op == 38 | op == 39 | op == 40 | op == 50 | op == 51 | op == 45 | op == 115 | op == 48 | op == 43 | op == 23 | op == 24 | op == 25 | op == 27 | op == 28)
            {
                case (true) { -> 1; }
                default {};
            };
            switch (op == 71 | op == 73 | op == 74 | op == 61 | op == 62 | op == 63 | op == 64 | op == 54 | op == 55 | op == 79 | op == 80)
            {
                case (true) { -> 2; }
                default {};
            };
            switch (op == 42 | op == 67) { case (true) { -> 3; } default {}; };
            switch (op == 58 | op == 59) { case (true) { -> 4; } default {}; };
            switch (op == 109 | op == 110) { case (true) { -> 5; } default {}; };
            switch (op == 81) { case (true) { -> 6; } default {}; };
            switch (op == 101) { case (true) { -> 7; } default {}; };
            switch (op == 41) { case (true) { -> 8; } default {}; };
            switch (op == 0) { case (true) { -> 9; } default {}; };
            switch (op == 118) { case (true) { -> 10; } default {}; };
            switch (op == 117) { case (true) { -> 11; } default {}; };
            -> 0;
        };


        fvm_ttag_name(int tag) -> byte*
        {
            switch (tag)
            {
                case (0) { -> g"int\0"; }
                case (1) { -> g"uint\0"; }
                case (2) { -> g"long\0"; }
                case (3) { -> g"ulong\0"; }
                case (4) { -> g"float\0"; }
                case (5) { -> g"double\0"; }
                case (6) { -> g"bool\0"; }
                case (7) { -> g"byte\0"; }
                case (8) { -> g"char\0"; }
                case (9) { -> g"data\0"; }
                case (10) { -> g"ptr\0"; }
                case (11) { -> g"void\0"; }
                case (12) { -> g"struct\0"; }
                case (13) { -> g"enum\0"; }
                case (14) { -> g"array\0"; }
                case (15) { -> g"bytes\0"; }
                case (16) { -> g"ffi_lib\0"; }
                case (17) { -> g"ffi_sym\0"; }
                case (18) { -> g"file\0"; }
                default { -> g"?\0"; };
            };
        };



        fvm_strlen(byte* s) -> int
        {
            int n;
            while (s[n] != 0) { n++; };
            -> n;
        };

        fvm_streq(byte* a, byte* b) -> bool
        {
            int i;
            while (a[i] != 0 & b[i] != 0)
            {
                switch (a[i] != b[i])
                {
                    case (true) { -> false; }
                    default
                    {
                        i++;
                    };
                };
            };
            -> a[i] == b[i];
        };


        fvm_strcmp(byte* a, byte* b) -> int
        {
            int i;
            while (a[i] != 0 & b[i] != 0)
            {
                switch (a[i] != b[i])
                {
                    case (true) {
                        switch (a[i] < b[i])
                        {
                            case (true) { -> -1; }
                            default { -> 1; };
                        };
                    }
                    default
                    {
                        i++;
                    };
                };
            };
            switch (a[i] == b[i])
            {
                case (true) { -> 0; }
                default
                {
                    switch (a[i] < b[i])
                    {
                        case (true) { -> -1; }
                        default { -> 1; };
                    };
                };
            };
        };


        fvm_lower(int c) -> int
        {
            switch (c >= 'A' & c <= 'Z')
            {
                case (true) { -> c + 32; }
                default { -> c; };
            };
        };


        fvm_is_space(int c) -> bool
        {
            -> c == 32 | (c >= 9 & c <= 13);
        };


        fvm_eq_ci(byte* s, int n, byte* lit) -> bool
        {
            int i;
            switch (fvm_strlen(lit) != n)
            {
                case (true) { -> false; }
                default {};
            };
            while (i < n)
            {
                switch (fvm_lower((int)s[i]) != fvm_lower((int)lit[i]))
                {
                    case (true) { -> false; }
                    default
                    {
                        i++;
                    };
                };
            };
            -> true;
        };


        fvm_eq_n(byte* s, int n, byte* lit) -> bool
        {
            int i;
            switch (fvm_strlen(lit) != n)
            {
                case (true) { -> false; }
                default {};
            };
            while (i < n)
            {
                switch (s[i] != lit[i])
                {
                    case (true) { -> false; }
                    default
                    {
                        i++;
                    };
                };
            };
            -> true;
        };

        fvm_alloc(int n) -> byte*
        {
            byte* p = (byte*)fmalloc((u64)n);
            int i;
            switch (p == (byte*)0)
            {
                case (true) { -> p; }
                default {};
            };
            while (i < n)
            {
                p[i] = (byte)0;
                i++;
            };
            -> p;
        };


        fvm_grow(byte* old, int nbytes) -> byte*
        {
            u64 np;
            switch (old == (byte*)0)
            {
                case (true) { np = (u64)fmalloc((u64)nbytes); }
                default { np = frealloc((u64)old, (size_t)nbytes); };
            };
            -> (byte*)np;
        };


        fvm_dup(byte* s, int n) -> byte*
        {
            byte* p = fvm_alloc(n + 1);
            int i;
            switch (p == (byte*)0)
            {
                case (true) { -> p; }
                default {};
            };
            while (i < n)
            {
                p[i] = s[i];
                i++;
            };
            p[n] = (byte)0;
            -> p;
        };

        fvm_copy(byte* d, byte* s, int n) -> void
        {
            int k;
            while (k < n) { d[k] = s[k]; k++; };
            ->;
        };

        fvm_p2i(byte* p) -> i64 -> (i64)(u64)p;

        fvm_i2p(i64 v) -> byte* -> (byte*)(u64)v;

        fvm_is_unsigned(int tag) -> bool
        {
            switch (tag)
            {
                case (1) { -> true; }
                case (3) { -> true; }
                case (6) { -> true; }
                case (7) { -> true; }
                case (8) { -> true; }
                case (9) { -> true; }
                case (10) { -> true; }
                default { -> false; };
            };
        };

        fvm_is_intlike(int tag) -> bool
        {
            switch (tag)
            {
                case (0) { -> true; }
                case (1) { -> true; }
                case (2) { -> true; }
                case (3) { -> true; }
                case (6) { -> true; }
                case (7) { -> true; }
                case (8) { -> true; }
                case (9) { -> true; }
                case (10) { -> true; }
                case (13) { -> true; }
                default { -> false; };
            };
        };


        fvm_ttag_size(int tag) -> int
        {
            switch (tag)
            {
                case (6) { -> 1; }
                case (7) { -> 1; }
                case (8) { -> 1; }
                case (2) { -> 8; }
                case (3) { -> 8; }
                case (5) { -> 8; }
                case (10) { -> 8; }
                default { -> 4; };
            };
        };


        fvm_wrap(int tag, i64 v) -> i64
        {
            switch (tag)
            {
                case (0)
                {
                    v = v `& (i64)4294967295;
                    switch (v >= (i64)2147483648)
                    {
                        case (true) { v = v - (i64)4294967296; }
                        default {};
                    };
                    -> v;
                }
                case (1) { -> v `& (i64)4294967295; }
                case (6) { -> v `& (i64)255; }
                case (7) { -> v `& (i64)255; }
                case (8) { -> v `& (i64)255; }
                case (9) { -> v `& (i64)4294967295; }
                default { -> v; };
            };
        };


        fvm_lsr(i64 v, int n) -> i64
        {
            switch (n <= 0)
            {
                case (true) { -> v; }
                default {};
            };
            switch (n >= 64)
            {
                case (true) { -> (i64)0; }
                default {};
            };
            -> (v >> n) `& (((i64)1 << (64 - n)) - (i64)1);
        };


        fvm_starts_with(byte* s, byte* pre) -> bool
        {
            int i;
            while (pre[i] != 0)
            {
                switch (s[i] != pre[i])
                {
                    case (true) { -> false; }
                    default
                    {
                        i++;
                    };
                };
            };
            -> true;
        };


        fvm_ends_dunder(byte* key, byte* name) -> bool
        {
            int kl = fvm_strlen(key);
            int nl = fvm_strlen(name);
            int off;
            switch (kl < nl + 2)
            {
                case (true) { -> false; }
                default {};
            };
            off = kl - nl;
            switch (key[off - 1] != '_' | key[off - 2] != '_')
            {
                case (true) { -> false; }
                default {};
            };
            -> fvm_eq_n(key + off, nl, name);
        };


        fvm_find_sig(byte* key) -> int
        {
            int i;
            while (key[i] != 0)
            {
                switch (key[i] == '_' & key[i + 1] == '_' & key[i + 2] == '$')
                {
                    case (true) { -> i; }
                    default {};
                };
                i++;
            };
            -> -1;
        };


        fvm_sig_argc(byte* sig) -> int
        {
            int n = 1;
            int i;
            switch (sig[0] == 0)
            {
                case (true) { -> 0; }
                default {};
            };
            while (sig[i] != 0)
            {
                switch (sig[i] == '_')
                {
                    case (true) { n++; }
                    default {};
                };
                i++;
            };
            -> n;
        };


        fvm_parse_int(byte* s, int n, bool* ok) -> i64
        {
            i64 v = (i64)0;
            i64 base = (i64)10;
            int i = 0;
            int d;
            bool neg = false;
            bool any = false;
            *ok = true;
            switch (n > 0)
            {
                case (true) {
                    switch (s[0] == '-' | s[0] == '+')
                    {
                        case (true) {
                            neg = s[0] == '-';
                            i = 1;
                        }
                        default {};
                    };
                }
                default {};
            };
            switch (i + 1 < n)
            {
                case (true) {
                    switch (s[i] == '0')
                    {
                        case (true) {
                            switch (s[i + 1] == 'x' | s[i + 1] == 'X')
                            {
                                case (true) { base = (i64)16; i = i + 2; }
                                default {
                                    switch (s[i + 1] == 'o' | s[i + 1] == 'O')
                                    {
                                        case (true) { base = (i64)8; i = i + 2; }
                                        default {
                                            switch (s[i + 1] == 'b' | s[i + 1] == 'B')
                                            {
                                                case (true) { base = (i64)2; i = i + 2; }
                                                default {};
                                            };
                                        };
                                    };
                                };
                            };
                        }
                        default {};
                    };
                }
                default {};
            };
            while (i < n)
            {
                d = -1;
                switch (s[i] >= '0' & s[i] <= '9')
                {
                    case (true) { d = (int)s[i] - 48; }
                    default {
                        switch (s[i] >= 'a' & s[i] <= 'f')
                        {
                            case (true) { d = (int)s[i] - 87; }
                            default {
                                switch (s[i] >= 'A' & s[i] <= 'F')
                                {
                                    case (true) { d = (int)s[i] - 55; }
                                    default {};
                                };
                            };
                        };
                    };
                };
                switch (d < 0 | (i64)d >= base)
                {
                    case (true) {
                        *ok = false;
                        -> (i64)0;
                    }
                    default {};
                };
                v = v * base + (i64)d;
                any = true;
                i++;
            };
            switch (!any)
            {
                case (true) { *ok = false; }
                default {};
            };
            switch (neg)
            {
                case (true) { -> (i64)0 - v; }
                default { -> v; };
            };
        };




        object FvmBuf
        {
            byte* mem;
            int len, cap;
            bool ok;

            __init() -> this
            {
                this.len = 0;
                this.cap = 256;
                this.ok = true;
                this.mem = (byte*)fmalloc((u64)this.cap);
                switch (this.mem == (byte*)0)
                {
                    case (true) {
                        this.ok = false;
                        this.cap = 0;
                    }
                    default {
                        this.mem[0] = (byte)0;
                    };
                };
                -> this;
            };

            __expr() -> FvmBuf* -> this;

            __exit() -> void
            {
                switch (this.mem != (byte*)0)
                {
                    case (true) { ffree(this.mem); }
                    default {};
                };
                this.mem = (byte*)0;
                this.len = 0;
                this.cap = 0;
                ->;
            };

            reserve(int extra) -> bool
            {
                int need = this.len + extra + 1;
                int nc = this.cap;
                byte* np;
                switch (!this.ok)
                {
                    case (true) { -> false; }
                    default {};
                };
                switch (need <= this.cap)
                {
                    case (true) { -> true; }
                    default {};
                };
                switch (nc < 256)
                {
                    case (true) { nc = 256; }
                    default {};
                };
                while (nc < need) { nc = nc * 2; };
                np = fvm_grow(this.mem, nc);
                switch (np == (byte*)0)
                {
                    case (true) {
                        this.ok = false;
                        -> false;
                    }
                    default
                    {
                        this.mem = np;
                        this.cap = nc;
                        -> true;
                    };
                };
            };

            put(int b) -> void
            {
                switch (!this.reserve(1))
                {
                    case (true) { ->; }
                    default
                    {
                        this.mem[this.len] = (byte)b;
                        this.len++;
                        this.mem[this.len] = (byte)0;
                        ->;
                    };
                };
            };


            put_n(byte* s, int n) -> void
            {
                int i;
                switch (n <= 0)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (!this.reserve(n))
                {
                    case (true) { ->; }
                    default {};
                };
                while (i < n)
                {
                    this.mem[this.len + i] = s[i];
                    i++;
                };
                this.len = this.len + n;
                this.mem[this.len] = (byte)0;
                ->;
            };

            put_str(byte* s) -> void -> this.put_n(s, fvm_strlen(s));



            put_uv(u64 v) -> void
            {
                u64 r = v;
                while (r >= (u64)128)
                {
                    this.put((int)((r `& (u64)127) `| (u64)128));
                    r = r >> 7;
                };
                this.put((int)r);
                ->;
            };

            put_u32(int v) -> void -> this.put_uv((u64)v);

            put_iv(i64 v) -> void
            {
                switch (v < (i64)0)
                {
                    case (true) { this.put_uv((((u64)((i64)0 - (v + (i64)1))) << 1) `| (u64)1); }
                    default { this.put_uv(((u64)v) << 1); };
                };
                ->;
            };

            put_le64(i64 v) -> void
            {
                int k;
                while (k < 8)
                {
                    this.put((int)((v >> (i64)(8 * k)) `& (i64)255));
                    k++;
                };
                ->;
            };

            put_i64(i64 v) -> void
            {
                byte[24] tmp = noinit;
                int n, k;
                i64 t;
                switch (v < (i64)0)
                {
                    case (true) {
                        this.put(45);
                        t = (i64)0 - v;
                    }
                    default { t = v; };
                };
                switch (t == (i64)0)
                {
                    case (true) {
                        this.put(48);
                        ->;
                    }
                    default {};
                };
                while (t > (i64)0)
                {
                    tmp[n] = (byte)(48 + (int)(t % (i64)10));
                    t = t / (i64)10;
                    n++;
                };
                k = n;
                while (k > 0)
                {
                    k--;
                    this.put((int)tmp[k]);
                };
                ->;
            };

            put_int(int v) -> void -> this.put_i64((i64)v);

            clear() -> void
            {
                this.len = 0;
                switch (this.mem != (byte*)0)
                {
                    case (true) { this.mem[0] = (byte)0; }
                    default {};
                };
                ->;
            };
        };






        fvm_dbl_bits(double d) -> i64
        {
            double dd = d;
            i64* bp = (i64*)@dd;
            -> *bp;
        };

        fvm_bits_dbl(i64 b) -> double
        {
            i64 bb = b;
            double* dp = (double*)@bb;
            -> *dp;
        };




        fvm_isf(int tag, i64 m) -> bool
        {
            switch (tag == 4 | tag == 5)
            {
                case (true) { -> true; }
                default {};
            };
            -> fvm_is_intlike(tag) & m == (i64)1718184564;
        };

        fvm_isflt_tag(int tag) -> bool
        {
            -> tag == 4 | tag == 5;
        };


        fvm_dv(int tag, i64 d, i64 m) -> double
        {
            switch (fvm_isf(tag, m))
            {
                case (true) { -> fvm_bits_dbl(d); }
                default {};
            };
            switch (fvm_is_unsigned(tag))
            {
                case (true) { -> (double)(u64)d; }
                default {};
            };
            -> (double)d;
        };


        fvm_trunc(double v) -> i64
        {
            -> (i64)v;
        };


        fvm_cvt_i(double x, int bits) -> i64
        {
            double lim = (double)2147483648.0;
            i64 lo = (i64)-2147483648;
            switch (bits == 64)
            {
                case (true)
                {
                    lim = (double)2147483648.0 * (double)4294967296.0;
                    lo = (i64)-9223372036854775807 - (i64)1;
                }
                default {};
            };
            switch (x != x | x >= lim | x < -lim) { case (true) { -> lo; } default {}; };
            -> (i64)x;
        };


        fvm_fixed_text(FvmBuf* o, bool neg, i64 ip, i64 fp, int prec) -> void
        {
            i64 t;
            int nd;
            int z;
            switch (neg) { case (true) { o.put('-'); } default {}; };
            switch (ip == (i64)0)
            {
                case (true) { o.put('0'); }
                default { switch (ip > (i64)0) { case (true) { o.put_i64(ip); } default {}; }; };
            };
            switch (prec > 0)
            {
                case (true)
                {
                    o.put('.');
                    switch (fp == (i64)0)
                    {
                        case (true) { while (z < prec) { o.put('0'); z++; }; }
                        default
                        {
                            t = fp;
                            while (t > (i64)0) { nd++; t = t / (i64)10; };
                            while (z < prec - nd) { o.put('0'); z++; };
                            o.put_i64(fp);
                        };
                    };
                }
                default {};
            };
            ->;
        };


        fvm_float2str(FvmBuf* o, double dv) -> void
        {
            float v = (float)dv;
            bool neg = v < (float)0.0;
            float fl;
            float sc;
            float mf = (float)1000000.0;
            i64 ip;
            i64 fp;
            switch (neg) { case (true) { v = -v; } default {}; };
            switch (v == (float)0.0)
            {
                case (true) { fvm_fixed_text(o, false, (i64)0, (i64)0, 6); ->; }
                default {};
            };
            ip = fvm_cvt_i((double)v, 32);
            fl = v - (float)(int)ip;
            sc = fl * mf;
            fp = fvm_cvt_i((double)(sc + (float)0.5), 32);
            switch (fp >= (i64)1000000) { case (true) { ip = ip + (i64)1; fp = (i64)0; } default {}; };
            fvm_fixed_text(o, neg, ip, fp, 6);
            ->;
        };


        fvm_dbl2str(FvmBuf* o, double dv) -> void
        {
            double v = dv;
            bool neg = v < (double)0.0;
            double fl;
            i64 ip;
            i64 fp;
            i64 mult = (i64)100000000000000;
            switch (neg) { case (true) { v = -v; } default {}; };
            switch (v == (double)0.0)
            {
                case (true) { fvm_fixed_text(o, false, (i64)0, (i64)0, 14); ->; }
                default {};
            };
            ip = fvm_cvt_i(v, 64);
            fl = v - (double)ip;
            fp = fvm_cvt_i(fl * (double)mult + (double)0.5, 64);
            switch (fp >= mult) { case (true) { ip = ip + (i64)1; fp = (i64)0; } default {}; };
            fvm_fixed_text(o, neg, ip, fp, 14);
            ->;
        };


        fvm_f32_dbl(i64 b) -> double
        {
            i64 bb = b `& (i64)4294967295;
            float* fp = (float*)@bb;
            float f = *fp;
            -> (double)f;
        };

        fvm_dbl_f32(double d) -> i64
        {
            float f = (float)d;
            float ff = f;
            i64 r = (i64)0;
            i64* rp = @r;
            float* fp = (float*)rp;
            *fp = ff;
            -> r `& (i64)4294967295;
        };


        fvm_fmod(double a, double b) -> double
        {
            double r = a;
            double d = b;
            double t;
            bool neg = a < (double)0.0;
            switch (neg) { case (true) { r = (double)0.0 - a; } default {}; };
            switch (d < (double)0.0) { case (true) { d = (double)0.0 - d; } default {}; };
            while (r >= d)
            {
                t = d;
                while (t + t <= r) { t = t + t; };
                r = r - t;
            };
            switch (neg) { case (true) { -> (double)0.0 - r; } default {}; };
            -> r;
        };



        fvm_find_sym(byte* name) -> byte*
        {
            byte* sym;
            void* hl;


            hl = LoadLibraryA(g"msvcrt.dll\0");
            sym = (byte*)0;
            switch (hl != (void*)0) { case (true) { sym = GetProcAddress(hl, name); } default {}; };
            -> sym;




















        };



        fvm_pow(double a, double b, bool* ok) -> double
        {
            byte* sym = fvm_find_sym(g"pow\0");
            double r;
            *ok = true;
            switch (sym == (byte*)0)
            {
                case (true) {
                    *ok = false;
                    -> (double)0.0;
                }
                default {};
            };
            def{}* fp(double, double) -> double = sym;
            r = fp(a, b);
            -> r;
        };


        fvm_big_mul(u64* a, int* n, u64 m) -> void
        {
            u64 carry;
            u64 t;
            int i;
            while (i < *n)
            {
                t = a[i] * m + carry;
                a[i] = t % (u64)1000000000;
                carry = t / (u64)1000000000;
                i++;
            };
            while (carry > (u64)0)
            {
                a[*n] = carry % (u64)1000000000;
                carry = carry / (u64)1000000000;
                *n = *n + 1;
            };
            ->;
        };



        fvm_double_digits(double v, byte* out, int* decpt) -> int
        {
            u64 ub = (u64)fvm_dbl_bits(v);
            int ex = (int)((ub >> 52) `& (u64)2047);
            u64 fr = ub `& (u64)4503599627370495;
            u64 mant;
            int e2;
            int k;
            int n;
            int i;
            int nd;
            int j;
            u64 m5;
            u64 limb;
            u64* a = (u64*)fvm_alloc(8 * 128);
            byte[12] tmp = noinit;
            switch (a == (u64*)0)
            {
                case (true) { *decpt = 0; out[0] = '0'; -> 1; }
                default {};
            };
            switch (ex == 0)
            {
                case (true) { mant = fr; e2 = -1074; }
                default { mant = fr `| (u64)4503599627370496; e2 = ex - 1075; };
            };
            a[0] = mant % (u64)1000000000;
            a[1] = (mant / (u64)1000000000) % (u64)1000000000;
            a[2] = mant / (u64)1000000000000000000;
            n = 3;
            while (n > 1 & a[n - 1] == (u64)0) { n--; };
            switch (e2 > 0)
            {
                case (true)
                {
                    k = e2;
                    while (k >= 29) { fvm_big_mul(a, @n, (u64)536870912); k = k - 29; };
                    switch (k > 0) { case (true) { fvm_big_mul(a, @n, (u64)1 << k); } default {}; };
                }
                default {};
            };
            switch (e2 < 0)
            {
                case (true)
                {
                    k = 0 - e2;
                    while (k >= 13) { fvm_big_mul(a, @n, (u64)1220703125); k = k - 13; };
                    m5 = (u64)1;
                    while (k > 0) { m5 = m5 * (u64)5; k--; };
                    switch (m5 > (u64)1) { case (true) { fvm_big_mul(a, @n, m5); } default {}; };
                }
                default {};
            };

            i = n - 1;
            limb = a[i];
            j = 0;
            while (limb > (u64)0)
            {
                tmp[j] = (byte)(48 + (int)(limb % (u64)10));
                limb = limb / (u64)10;
                j++;
            };
            while (j > 0)
            {
                j--;
                out[nd] = tmp[j];
                nd++;
            };
            i--;
            while (i >= 0)
            {
                limb = a[i];
                j = 9;
                while (j > 0)
                {
                    j--;
                    tmp[j] = (byte)(48 + (int)(limb % (u64)10));
                    limb = limb / (u64)10;
                };
                j = 0;
                while (j < 9) { out[nd] = tmp[j]; nd++; j++; };
                i--;
            };
            switch (nd == 0) { case (true) { out[0] = '0'; nd = 1; } default {}; };
            out[nd] = (byte)0;
            switch (e2 < 0)
            {
                case (true) { *decpt = nd + e2; }
                default { *decpt = nd; };
            };
            ffree((byte*)a);
            -> nd;
        };




        fvm_round_digits(byte* dg, int nd, int p, byte* out, int* decpt, bool up) -> void
        {
            int i;
            bool inc;
            bool rest;
            int c;
            while (i < p)
            {
                switch (i < nd) { case (true) { out[i] = dg[i]; } default { out[i] = '0'; }; };
                i++;
            };
            out[p] = (byte)0;
            switch (nd > p)
            {
                case (true)
                {
                    i = p + 1;
                    while (i < nd) { switch (dg[i] != '0') { case (true) { rest = true; } default {}; }; i++; };
                    c = (int)dg[p];
                    switch (up)
                    {
                        case (true) { inc = c != '0' | rest; }
                        default
                        {
                            switch (c > '5' | (c == '5' & rest)) { case (true) { inc = true; } default {}; };
                            switch (c == '5' & !rest & ((int)out[p - 1] - '0') % 2 == 1) { case (true) { inc = true; } default {}; };
                        };
                    };
                }
                default {};
            };
            i = p;
            while (inc & i > 0)
            {
                i--;
                switch (out[i] == '9')
                {
                    case (true) { out[i] = '0'; }
                    default { out[i] = (byte)((int)out[i] + 1); inc = false; };
                };
            };
            switch (inc)
            {
                case (true)
                {

                    out[0] = '1';
                    *decpt = *decpt + 1;
                }
                default {};
            };
            ->;
        };



        fvm_float_syntax(byte* s, int n) -> bool
        {
            int i;
            int nd;
            int m;
            while (i < n & (s[i] == ' ' | s[i] == '\t' | s[i] == '\n' | s[i] == '\r')) { i++; };
            while (n > i & (s[n - 1] == ' ' | s[n - 1] == '\t' | s[n - 1] == '\n' | s[n - 1] == '\r')) { n--; };
            switch (i < n & (s[i] == '+' | s[i] == '-')) { case (true) { i++; } default {}; };
            m = n - i;
            switch (m == 3 | m == 8)
            {
                case (true)
                {
                    switch (fvm_eq_ci(s + i, m, g"inf\0") | fvm_eq_ci(s + i, m, g"nan\0") | fvm_eq_ci(s + i, m, g"infinity\0")) { case (true) { -> true; } default {}; };
                }
                default {};
            };
            while (i < n & s[i] >= '0' & s[i] <= '9') { i++; nd++; };
            switch (i < n & s[i] == '.')
            {
                case (true)
                {
                    i++;
                    while (i < n & s[i] >= '0' & s[i] <= '9') { i++; nd++; };
                }
                default {};
            };
            switch (nd == 0) { case (true) { -> false; } default {}; };
            switch (i < n & (s[i] == 'e' | s[i] == 'E'))
            {
                case (true)
                {
                    i++;
                    switch (i < n & (s[i] == '+' | s[i] == '-')) { case (true) { i++; } default {}; };
                    nd = 0;
                    while (i < n & s[i] >= '0' & s[i] <= '9') { i++; nd++; };
                    switch (nd == 0) { case (true) { -> false; } default {}; };
                }
                default {};
            };
            -> i == n;
        };


        fvm_parse_double(byte* s, int n, bool* ok) -> double
        {
            byte* z;
            double r;
            *ok = false;
            switch (n == 0 | !fvm_float_syntax(s, n))
            {
                case (true) { -> 0.0; }
                default {};
            };
            z = fvm_dup(s, n);
            switch (z == (byte*)0) { case (true) { -> 0.0; } default {}; };
            r = strtod(z, (byte**)0);
            ffree(z);
            *ok = true;
            -> r;
        };



        fvm_put_double(FvmBuf* o, double v) -> void
        {
            i64 bits = fvm_dbl_bits(v);
            u64 ub = (u64)bits;
            int ex = (int)((ub >> 52) `& (u64)2047);
            int decpt, dpx, ndx, p, nd, i, k, ee;
            byte[820] exact = noinit;
            byte[24] rd = noinit;
            bool pow2;
            double a = v;
            double back;
            bool neg = (ub >> 63) != (u64)0;
            bool ok;
            bool found;
            FvmBuf cb;
            FvmBuf db;
            switch (ex == 2047)
            {
                case (true)
                {
                    switch ((ub `& (u64)4503599627370495) != (u64)0)
                    {
                        case (true) { o.put_str(g"nan\0"); ->; }
                        default {};
                    };
                    switch (neg) { case (true) { o.put(45); } default {}; };
                    o.put_str(g"inf\0");
                    ->;
                }
                default {};
            };
            switch (neg) { case (true) { o.put(45); a = (double)0.0 - v; } default {}; };
            switch (ex == 0 & (ub `& (u64)4503599627370495) == (u64)0)
            {
                case (true) { o.put_str(g"0.0\0"); ->; }
                default {};
            };
            cb.__init();
            defer cb.__exit();
            db.__init();
            defer db.__exit();
            ndx = fvm_double_digits(a, exact, @dpx);
            pow2 = ex > 0 & (ub `& (u64)4503599627370495) == (u64)0;
            p = 1;
            while (p <= 17 & !found)
            {
                decpt = dpx;
                fvm_round_digits(exact, ndx, p, rd, @decpt, false);
                cb.clear();
                cb.put_str(g"0.\0");
                cb.put_str(rd);
                cb.put(101);
                switch (decpt < 0) { case (true) { cb.put(45); cb.put_int(0 - decpt); } default { cb.put_int(decpt); }; };
                back = fvm_parse_double(cb.mem, cb.len, @ok);
                switch (back == a)
                {
                    case (true) { found = true; }
                    default {};
                };
                switch (!found & pow2)
                {
                    case (true)
                    {

                        decpt = dpx;
                        fvm_round_digits(exact, ndx, p, rd, @decpt, true);
                        cb.clear();
                        cb.put_str(g"0.\0");
                        cb.put_str(rd);
                        cb.put(101);
                        switch (decpt < 0) { case (true) { cb.put(45); cb.put_int(0 - decpt); } default { cb.put_int(decpt); }; };
                        back = fvm_parse_double(cb.mem, cb.len, @ok);
                        switch (back == a) { case (true) { found = true; } default {}; };
                    }
                    default {};
                };
                switch (!found) { case (true) { p++; } default {}; };
            };
            switch (!found)
            {
                case (true)
                {
                    p = 17;
                    decpt = dpx;
                    fvm_round_digits(exact, ndx, p, rd, @decpt, false);
                }
                default {};
            };
            db.put_str(rd);
            nd = db.len;
            while (nd > 1 & db.mem[nd - 1] == '0') { nd--; };
            switch (decpt <= 0 - 4 | decpt > 16)
            {
                case (true)
                {
                    o.put((int)db.mem[0]);
                    switch (nd > 1)
                    {
                        case (true)
                        {
                            o.put(46);
                            i = 1;
                            while (i < nd) { o.put((int)db.mem[i]); i++; };
                        }
                        default {};
                    };
                    o.put(101);
                    ee = decpt - 1;
                    switch (ee < 0) { case (true) { o.put(45); ee = 0 - ee; } default { o.put(43); }; };
                    switch (ee < 10) { case (true) { o.put(48); } default {}; };
                    o.put_int(ee);
                    ->;
                }
                default {};
            };
            switch (decpt <= 0)
            {
                case (true)
                {
                    o.put_str(g"0.\0");
                    k = 0;
                    while (k < 0 - decpt) { o.put(48); k++; };
                    i = 0;
                    while (i < nd) { o.put((int)db.mem[i]); i++; };
                    ->;
                }
                default {};
            };
            switch (decpt >= nd)
            {
                case (true)
                {
                    i = 0;
                    while (i < nd) { o.put((int)db.mem[i]); i++; };
                    k = nd;
                    while (k < decpt) { o.put(48); k++; };
                    o.put_str(g".0\0");
                    ->;
                }
                default {};
            };
            i = 0;
            while (i < decpt) { o.put((int)db.mem[i]); i++; };
            o.put(46);
            while (i < nd) { o.put((int)db.mem[i]); i++; };
            ->;
        };





        object FvmStubs
        {
            byte** names;
            int* counts;
            int n, cap, total;
            bool ok;

            __init() -> this
            {
                this.n = 0;
                this.total = 0;
                this.cap = 32;
                this.ok = true;
                this.names = (byte**)fvm_alloc(this.cap * 8);
                this.counts = (int*)fvm_alloc(this.cap * 4);
                switch (this.names == (byte**)0 | this.counts == (int*)0)
                {
                    case (true) { this.ok = false; }
                    default {};
                };
                -> this;
            };

            __expr() -> FvmStubs* -> this;

            __exit() -> void
            {
                switch (this.names != (byte**)0)
                {
                    case (true) { ffree((byte*)this.names); }
                    default {};
                };
                switch (this.counts != (int*)0)
                {
                    case (true) { ffree((byte*)this.counts); }
                    default {};
                };
                this.names = (byte**)0;
                this.counts = (int*)0;
                this.n = 0;
                ->;
            };

            note(byte* what) -> void
            {
                int i;
                byte** nn;
                int* nc;
                int ncap;
                switch (!this.ok)
                {
                    case (true) { ->; }
                    default {};
                };
                this.total++;
                while (i < this.n)
                {
                    switch (fvm_streq(this.names[i], what))
                    {
                        case (true) {
                            this.counts[i] = this.counts[i] + 1;
                            ->;
                        }
                        default
                        {
                            i++;
                        };
                    };
                };
                switch (this.n >= this.cap)
                {
                    case (true) {
                        ncap = this.cap * 2;
                        nn = (byte**)fvm_grow((byte*)this.names, ncap * 8);
                        nc = (int*)fvm_grow((byte*)this.counts, ncap * 4);
                        switch (nn == (byte**)0 | nc == (int*)0)
                        {
                            case (true) {
                                this.ok = false;
                                ->;
                            }
                            default {};
                        };
                        this.names = nn;
                        this.counts = nc;
                        this.cap = ncap;
                    }
                    default {};
                };
                this.names[this.n] = what;
                this.counts[this.n] = 1;
                this.n++;
                ->;
            };


            report(byte* title) -> void
            {
                int i;
                switch (this.n == 0)
                {
                    case (true) { ->; }
                    default {};
                };
                standard::io::console::print(title);
                standard::io::console::println(g" Stub summary:\0");
                while (i < this.n)
                {
                    standard::io::console::print(g"  not ported yet: \0");
                    standard::io::console::print(this.names[i]);
                    standard::io::console::print(g" x \0");
                    standard::io::console::println(this.counts[i]);
                    i++;
                };
                standard::io::console::print(g"  stub hits total: \0");
                standard::io::console::println(this.total);
                ->;
            };
        };




        object FvmHeap
        {
            byte* mem;
            int size, bump, n, cap;
            int* ptrs;
            int* sizes;
            int* live;
            bool ok;

            __init() -> this
            {
                this.size = 16777216;
                this.bump = 65536;
                this.n = 0;
                this.cap = 64;
                this.ok = true;
                this.mem = fvm_alloc(this.size);
                this.ptrs = (int*)fvm_alloc(this.cap * 4);
                this.sizes = (int*)fvm_alloc(this.cap * 4);
                this.live = (int*)fvm_alloc(this.cap * 4);
                switch (this.mem == (byte*)0 | this.ptrs == (int*)0 | this.sizes == (int*)0 | this.live == (int*)0)
                {
                    case (true) { this.ok = false; }
                    default {};
                };
                -> this;
            };

            __expr() -> FvmHeap* -> this;

            __exit() -> void
            {
                switch (this.mem != (byte*)0)
                {
                    case (true) { ffree(this.mem); }
                    default {};
                };
                switch (this.ptrs != (int*)0)
                {
                    case (true) { ffree((byte*)this.ptrs); }
                    default {};
                };
                switch (this.sizes != (int*)0)
                {
                    case (true) { ffree((byte*)this.sizes); }
                    default {};
                };
                switch (this.live != (int*)0)
                {
                    case (true) { ffree((byte*)this.live); }
                    default {};
                };
                this.mem = (byte*)0;
                this.ptrs = (int*)0;
                this.sizes = (int*)0;
                this.live = (int*)0;
                ->;
            };


            alloc(int sz) -> int
            {
                int i, p, k, nc;
                int* a;
                int* b;
                int* c;
                switch (sz <= 0 | !this.ok)
                {
                    case (true) { -> 0; }
                    default {};
                };
                while (i < this.n)
                {
                    switch (this.live[i] == 0 & this.sizes[i] >= sz)
                    {
                        case (true) {
                            p = this.ptrs[i];
                            this.live[i] = 1;
                            this.sizes[i] = sz;
                            k = 0;
                            while (k < sz)
                            {
                                this.mem[p + k] = (byte)0;
                                k++;
                            };
                            -> p;
                        }
                        default
                        {
                            i++;
                        };
                    };
                };
                switch (this.bump + sz > this.size)
                {
                    case (true) { -> 0; }
                    default {};
                };
                switch (this.n >= this.cap)
                {
                    case (true) {
                        nc = this.cap * 2;
                        a = (int*)fvm_grow((byte*)this.ptrs, nc * 4);
                        b = (int*)fvm_grow((byte*)this.sizes, nc * 4);
                        c = (int*)fvm_grow((byte*)this.live, nc * 4);
                        switch (a == (int*)0 | b == (int*)0 | c == (int*)0)
                        {
                            case (true) {
                                this.ok = false;
                                -> 0;
                            }
                            default {};
                        };
                        this.ptrs = a;
                        this.sizes = b;
                        this.live = c;
                        this.cap = nc;
                    }
                    default {};
                };
                p = this.bump;
                this.bump = (this.bump + sz + 7) / 8 * 8;
                this.ptrs[this.n] = p;
                this.sizes[this.n] = sz;
                this.live[this.n] = 1;
                this.n++;
                -> p;
            };


            free(int p) -> bool
            {
                int i;
                while (i < this.n)
                {
                    switch (this.ptrs[i] == p & this.live[i] == 1)
                    {
                        case (true) {
                            this.live[i] = 0;
                            -> true;
                        }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> false;
            };


            in_bounds(i64 p, int sz) -> bool
            {
                switch (p < (i64)8 | p + (i64)sz > (i64)this.size)
                {
                    case (true) { -> false; }
                    default { -> true; };
                };
            };


            rd(int p, int sz) -> i64
            {
                i64 v = (i64)0;
                int k = sz - 1;
                while (k >= 0)
                {
                    v = (v << 8) `| ((i64)this.mem[p + k] `& (i64)255);
                    k--;
                };
                -> v;
            };

            wr(int p, int sz, i64 v) -> void
            {
                int k;
                i64 t = v;
                while (k < sz)
                {
                    this.mem[p + k] = (byte)(t `& (i64)255);
                    t = t >> 8;
                    k++;
                };
                ->;
            };
        };





















        struct FvmVars
        {
            byte** names;
            int* slots;
            int n;
        };


        fvm_vars_new(int n) -> FvmVars*
        {
            FvmVars* v = (FvmVars*)fvm_alloc(sizeof(FvmVars) / 8);
            switch (v == (FvmVars*)0) { case (true) { -> v; } default {}; };
            v.names = (byte**)fvm_alloc((n + 1) * 8);
            v.slots = (int*)fvm_alloc((n + 1) * 4);
            v.n = n;
            switch (v.names == (byte**)0 | v.slots == (int*)0) { case (true) { -> (FvmVars*)0; } default {}; };
            -> v;
        };


        fvm_is_bin_image(byte* image, int len) -> bool
        {
            -> len >= 4 & image[0] == 'I' & image[1] == 'D' & image[2] == 'K' & image[3] == 'B';
        };



        fvm_put_esc_line(FvmBuf* o, byte* s, int n) -> void
        {
            int k, c, hx;
            while (k < n)
            {
                c = (int)s[k];
                switch (c)
                {
                    case (92) { o.put_str(g"\\\\\0"); }
                    case (10) { o.put_str(g"\\n\0"); }
                    case (13) { o.put_str(g"\\r\0"); }
                    case (9) { o.put_str(g"\\t\0"); }
                    default
                    {
                        switch (c < 32 | c == 127)
                        {
                            case (true) {
                                o.put_str(g"\\x\0");
                                hx = c >> 4;
                                switch (hx < 10) { case (true) { o.put(48 + hx); } default { o.put(87 + hx); }; };
                                hx = c `& 15;
                                switch (hx < 10) { case (true) { o.put(48 + hx); } default { o.put(87 + hx); }; };
                            }
                            default { o.put(c); };
                        };
                    };
                };
                k++;
            };
            o.put(10);
            ->;
        };


        fvm_put_pl(FvmBuf* o, int n, byte* word) -> void
        {
            o.put_int(n);
            o.put(32);
            o.put_str(word);
            switch (n != 1) { case (true) { o.put(115); } default {}; };
            ->;
        };




        struct FvmLint
        {
            int* pa_s;          
            int* pa_o;
            byte** pp;          
            int* pl;
            byte* lp;           
            FvmBuf* cur;
            FvmBuf* out;
            byte* prefix;
            int np;
            int psn;
            int ll;
            int lu;             
            int lc;             
            int lptr;           
