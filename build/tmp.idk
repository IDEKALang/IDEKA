            t_dict(Node* n) -> TypeSpec*
            {
                TypeSpec* t;
                TypeSpec* kt;
                TypeSpec* vt;
                int cnt;
                switch (n.kind)
                {
                    case (NodeKind.DICT_LITERAL)
                    {
                        this.type_list(n, 0);
                        cnt = node_count(n, 0);
                        switch (cnt < 2)
                        {
                            case (true) { -> (TypeSpec*)0; }
                            default
                            {
                                kt = node_child(n, 0, 0).ety;
                                vt = node_child(n, 0, 1).ety;
                                cnt = cnt / 2;
                            };
                        };
                    }
                    default
                    {
                        this.type_list(n, 0);
                        this.type_list(n, 1);
                        cnt = node_count(n, 0);
                        switch (cnt < 1)
                        {
                            case (true) { -> (TypeSpec*)0; }
                            default
                            {
                                switch (node_count(n, 1) < 1)
                                {
                                    case (true) { -> (TypeSpec*)0; }
                                    default
                                    {
                                        kt = node_child(n, 0, 0).ety;
                                        vt = node_child(n, 1, 0).ety;
                                    };
                                };
                            };
                        };
                    };
                };
                t = this.mk(DataType.DICT, 0, -1);
                t.dict_key = kt;
                t.dict_value = vt;
                t.dict_capacity = cnt;
                -> t;
            };

            t_array_lit(Node* n) -> TypeSpec*
            {
                TypeSpec* el;
                TypeSpec* c;
                int cnt = node_count(n, 0);
                this.type_list(n, 0);
                switch ((n.flags `& 8) != 0)
                {
                    case (true) { -> this.string_type(n.text); }
                    default
                    {
                        el = n.ts;
                        switch (el == (TypeSpec*)0)
                        {
                            case (true) {
                            switch (cnt == 0)
                            {
                                case (true) { -> (TypeSpec*)0; }
                                default
