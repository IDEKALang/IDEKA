            split_template_closers() -> void
            {
                int i, depth, t, extra, vb, vl, j, n = this.count, prev = -1;
                while (i < n)
                {
                    t = this.tokens[i].type;
                    if (t == TokenType.LESS_THAN & prev == TokenType.IDENTIFIER) { depth++; };
                    if (t == TokenType.GREATER_THAN & depth > 0) { depth--; };
                    prev = t;
                    if (t == TokenType.BITSHIFT_RIGHT & depth >= 2)
                    {
                        this.tokens[i].numeric_char = 2;
                        depth = depth - 2;
                        extra++;
                        prev = TokenType.GREATER_THAN;
                    };
                    if (t == TokenType.SEMICOLON | t == TokenType.LEFT_PAREN | t == TokenType.RIGHT_PAREN | (depth == 0 & (t == TokenType.LEFT_BRACE | t == TokenType.RIGHT_BRACE)))
                    {
                        depth = 0;
                    };
                    i++;
                };
                if (extra == 0) { ->; };
                if (n + extra > this.cap)
                {
                    -> this.fail(LexError.ALLOC_FAILED, this.tokens[0].line, this.tokens[0].column);
                };
                vb = this.vbegin();
                this.vput('>');
                vl = this.vend(vb);
                j = n - 1 + extra;
                i = n - 1;
                while (i >= 0)
                {
                    if (this.tokens[i].numeric_char == 2)
                    {
                        this.tokens[j] = this.tokens[i];
                        this.tokens[j].type = TokenType.GREATER_THAN;
                        this.tokens[j].column = this.tokens[i].column + 1;
                        this.tokens[j].voff = vb;
                        this.tokens[j].vlen = vl;
                        this.tokens[j].numeric_char = 0;
                        this.tokens[j - 1] = this.tokens[j];
                        this.tokens[j - 1].column = this.tokens[i].column;
                        j = j - 2;
                    }
                    else
                    {
                        this.tokens[j] = this.tokens[i];
                        j--;
                    };
                    i--;
                };
                this.count = n + extra;
                ->;
            };

            tokenize() -> bool
            {
                int c, ln, col, tt, vb, vl, cnt, i, oplen, optype, cp, extra, wstart;
                int saved_pos, saved_line, saved_col;

                while (this.position < this.length)
                {
                    switch (this.err_code != 0)
                    {
                        case (true) { -> false; }
                        default
                        {
                            switch (this.skip_whitespace())
                            {
                                case (true) { continue; }
                                default
                                {
                                    c = this.cur();
                                    switch (c == -1)
                                    {
                                        case (true) { break; }
                                        default
                                        {
                                            ln = this.line;
                                            col = this.column;


                                            switch (c == 'i' & this.peek(1) == '"')
                                            {
                                                case (true) {
                                                this.adv(1);
                                                this.read_i_string();
                                                continue;
                                            }
                                                default
                                                {

                                                    switch (c == 'f' & this.peek(1) == '"')
                                                    {
                                                        case (true) {
                                                        this.adv(1);
                                                        vb = this.vbegin();
                                                        this.vput('f');
                                                        this.vput('"');
                                                        switch (!this.read_f_string_body())
                                                        {
                                                            case (true) { -> false; }
                                                            default {};
                                                        };
                                                        this.vput('"');
                                                        vl = this.vend(vb);
                                                        this.emit(TokenType.F_STRING, ln, col, vb, vl, 0);
                                                        continue;
                                                    }
                                                        default
                                                        {

                                                            switch (c == 'g' & this.peek(1) == '"')
                                                            {
                                                                case (true) {
                                                                this.adv(1);
                                                                vb = this.vbegin();
                                                                this.read_string('"');
                                                                vl = this.vend(vb);
                                                                this.emit(TokenType.G_STRING, ln, col, vb, vl, 0);
                                                                continue;
                                                            }
                                                                default
                                                                {

                                                                    switch (c == '"')
                                                                    {
                                                                        case (true) {
                                                                        vb = this.vbegin();
                                                                        this.read_string('"');
                                                                        vl = this.vend(vb);
                                                                        this.emit(TokenType.STRING_LITERAL, ln, col, vb, vl, 0);
                                                                        continue;
                                                                    }
                                                                        default
                                                                        {
                                                                            switch (c == 39)
                                                                            {
                                                                                case (true) {
                                                                                vb = this.vbegin();
                                                                                this.read_string(39);
                                                                                vl = this.vend(vb);


                                                                                cnt = 0;
                                                                                i = 0;
                                                                                while (i < vl)
                                                                                {
                                                                                    switch (!is_continuation((int)this.arena[vb + i]))
                                                                                    {
                                                                                        case (true) { cnt++; }
                                                                                        default {};
                                                                                    };
                                                                                    i++;
                                                                                };
                                                                                switch (cnt)
                                                                                {
                                                                                    case (1)
                                                                                    {
                                                                                        this.emit(TokenType.CHAR, ln, col, vb, vl, 0);
                                                                                    }
                                                                                    default
                                                                                    {
                                                                                        this.emit(TokenType.STRING_LITERAL, ln, col, vb, vl, 0);
                                                                                    };
                                                                                };
                                                                                continue;
                                                                            }
                                                                                default
                                                                                {

                                                                                    switch (c == 'a' & this.peek(1) == 's' & this.peek(2) == 'm' & this.peek(3) == '"')
                                                                                    {
                                                                                        case (true) {
                                                                                        this.adv(3);
                                                                                        this.emit_text(TokenType.ASM, ln, col, "asm", 3);
                                                                                        this.read_asm_quoted();
                                                                                        continue;
                                                                                    }
                                                                                        default
                                                                                        {

                                                                                            switch (c == 'd' & this.peek(1) == '{')
                                                                                            {
                                                                                                case (true) {
                                                                                                this.adv(2);
                                                                                                this.emit_text(TokenType.DICT_LITERAL, ln, col, "d{", 2);
                                                                                                continue;
                                                                                            }
                                                                                                default
                                                                                                {

                                                                                                    switch (is_digit(c))
                                                                                                    {
                                                                                                        case (true) {
                                                                                                        this.read_number();
                                                                                                        continue;
                                                                                                    }
                                                                                                        default
                                                                                                        {

                                                                                                            switch (is_alpha(c) | c == '_')
                                                                                                            {
                                                                                                                case (true) {
                                                                                                                tt = this.read_identifier();

                                                                                                                switch (tt == TokenType.ASM)
                                                                                                                {
                                                                                                                    case (true) {
                                                                                                                    while (this.cur() == 32 | this.cur() == 9 | this.cur() == 13 | this.cur() == 10)
                                                                                                                    {
                                                                                                                        this.adv(1);
                                                                                                                    };
                                                                                                                    switch (this.cur() == '{')
                                                                                                                    {
                                                                                                                        case (true) {
                                                                                                                        this.read_brace_block(TokenType.ASM_BLOCK);
                                                                                                                        continue;
                                                                                                                    }
                                                                                                                        default {};
                                                                                                                    };
                                                                                                                }
                                                                                                                    default {};
                                                                                                                };

                                                                                                                switch (tt == TokenType.IDEKAVM)
                                                                                                                {
                                                                                                                    case (true) {
                                                                                                                    saved_pos = this.position;
                                                                                                                    saved_line = this.line;
                                                                                                                    saved_col = this.column;
                                                                                                                    while (this.cur() == 32 | this.cur() == 9 | this.cur() == 13 | this.cur() == 10)
                                                                                                                    {
                                                                                                                        this.adv(1);
                                                                                                                    };
                                                                                                                    switch (this.cur() == '{')
                                                                                                                    {
                                                                                                                        case (true) {
                                                                                                                        this.read_brace_block(TokenType.IDEKAVM_BLOCK);
                                                                                                                        continue;
                                                                                                                    }
                                                                                                                        default {
                                                                                                                        this.position = saved_pos;
                                                                                                                        this.line = saved_line;
                                                                                                                        this.column = saved_col;

                    switch (this.err_code == 0) { case (true) { this.tokens[this.count - 1].type = TokenType.IDENTIFIER; } default {}; };
                                                                                                                    };
                                                                                                                    };
                                                                                                                }
                                                                                                                    default {};
                                                                                                                };
                                                                                                                continue;
                                                                                                            }
                                                                                                                default
                                                                                                                {

                                                                                                                    oplen = this.match_op(@optype);
                                                                                                                    switch (oplen > 0)
                                                                                                                    {
                                                                                                                        case (true) {
                                                                                                                        this.emit_text(optype, ln, col, this.src + this.position, oplen);
                                                                                                                        this.adv(oplen);
                                                                                                                        continue;
                                                                                                                    }
                                                                                                                        default
                                                                                                                        {

                                                                                                                            switch (c >= 128)
                                                                                                                            {
                                                                                                                                case (true) {
                                                                                                                                extra = 0;
                                                                                                                                cp = c;
                                                                                                                                switch (c >= 0xF0)
                                                                                                                                {
                                                                                                                                    case (true) { cp = c & 0x07; extra = 3; }
                                                                                                                                    default {
                                                                                                                                        switch (c >= 0xE0)
                                                                                                                                        {
                                                                                                                                            case (true) { cp = c & 0x0F; extra = 2; }
                                                                                                                                            default {
                                                                                                                                                switch (c >= 0xC0)
                                                                                                                                                {
                                                                                                                                                    case (true) { cp = c & 0x1F; extra = 1; }
                                                                                                                                                    default {};
                                                                                                                                                };
                                                                                                                                            };
                                                                                                                                        };
                                                                                                                                    };
                                                                                                                                };

                                                                                                                                wstart = this.position;
                                                                                                                                this.warn_count++;
                                                                                                                                switch (this.warn_count == 1)
                                                                                                                                {
                                                                                                                                    case (true) {
                                                                                                                                    this.warn_line = ln;
                                                                                                                                    this.warn_col = col;
                                                                                                                                }
                                                                                                                                    default {};
                                                                                                                                };

                                                                                                                                this.adv(1);
                                                                                                                                while (extra > 0 & is_continuation(this.cur()))
                                                                                                                                {
                                                                                                                                    cp = (cp << 6) | (this.cur() & 0x3F);
                                                                                                                                    this.adv(1);
                                                                                                                                    extra--;
                                                                                                                                };
                                                                                                                                this.fail(LexError.NON_ASCII, ln, col);
 this.err_cp = cp;
 this.err_start = wstart;
 this.err_nbytes = this.position - wstart;
                                                                                                                            }
                                                                                                                                default {
                                                                                                                                this.adv(1);
                                                                                                                            };
                                                                                                                            };
                                                                                                                        };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };

                vb = this.vbegin();
                vl = this.vend(vb);
                this.emit(TokenType.EOF, this.line, this.column, vb, vl, 0);
                this.split_template_closers();
                -> this.err_code == 0;
            };
        };
    };
};


































using standard::io::file;















namespace IDEKA
{
    namespace preprocessor
    {
        extern
        {
            def !!
                getenv(byte* name) -> byte*,
                remove(byte* path) -> int;
        };










        extern
        {
            def !!
                _access(byte* path, int mode) -> int,
                _fullpath(byte* absbuf, byte* relpath, size_t maxlen) -> byte*;
        };

        enum PPError
        {
            NONE,
            SYNTAX,
            NOT_FOUND,
            KEY,
            RECURSION,
            STOP,
            ALLOC,
            IO
        };


        struct LineList
        {
            byte* text;
            int* off;
            int* len;
            int n;
        };



        pp_cstrlen(byte* s) -> int
        {
            int n;
            while (s[n] != 0) { n++; };
            -> n;
        };

        pp_eq(byte* a, byte* b, int n) -> bool
        {
            int i;
            while (i < n)
            {
                switch (a[i] != b[i])
                {
                    case (true) { -> false; }
                    default
                    {
                        i++;
                    };
                };
            };
            -> true;
        };


        pp_at(byte* s, int n, int i) -> int
        {
            switch (i < 0)
            {
                case (true) { -> -1; }
                default
                {
                    switch (i >= n)
                    {
                        case (true) { -> -1; }
                        default
                        {
                            -> (int)s[i];
                        };
                    };
                };
            };
        };

        pp_find(byte* t, int lo, int hi, int ch) -> int
        {
            int i = lo;
            while (i < hi)
            {
                switch ((int)t[i] == ch)
                {
                    case (true) { -> i; }
                    default
                    {
                        i++;
                    };
                };
            };
            -> -1;
        };

        pp_starts(byte* t, int lo, int hi, byte* lit, int ln) -> bool
        {
            switch (hi - lo < ln)
            {
                case (true) { -> false; }
                default
                {
                    -> pp_eq(t + lo, lit, ln);
                };
            };
        };

        pp_is_alpha_us(int c) -> bool -> (c >= 'a' & c <= 'z') | (c >= 'A' & c <= 'Z') | c == '_';

        pp_is_word(int c) -> bool -> (c >= 'a' & c <= 'z') | (c >= 'A' & c <= 'Z') | (c >= '0' & c <= '9') | c == '_';


        pp_is_delim(int c) -> bool -> c == '.' | c == ',' | c == ';' | c == ':' | c == '(' | c == ')' | c == '[' | c == ']' | c == '{' | c == '}' | c == '+' | c == '-' | c == '*' | c == '/' | c == '%' | c == '=' | c == '!' | c == '<' | c == '>' | c == '|' | c == '&' | c == '^' | c == '~';



        pp_ws_fwd(byte* s, int n, int i) -> int
        {
            switch (i >= n)
            {
                case (true) { -> 0; }
                default
                {
                    int c = (int)s[i];
                    switch (c == 32 | (c >= 9 & c <= 13) | (c >= 28 & c <= 31))
                    {
                        case (true) { -> 1; }
                        default
                        {
                            switch (c < 128)
                            {
                                case (true) { -> 0; }
                                default
                                {
                                    int c1 = pp_at(s, n, i + 1);
                                    int c2 = pp_at(s, n, i + 2);
                                    switch (c == 0xC2)
                                    {
                                        case (true) {
                                        switch (c1 == 0x85 | c1 == 0xA0)
                                        {
                                            case (true) { -> 2; }
                                            default {};
                                        };
                                        -> 0;
                                    }
                                        default
                                        {
                                            switch (c == 0xE1)
                                            {
                                                case (true) {
                                                switch (c1 == 0x9A & c2 == 0x80)
                                                {
                                                    case (true) { -> 3; }
                                                    default {};
                                                };
                                                -> 0;
                                            }
                                                default
                                                {
                                                    switch (c == 0xE2)
                                                    {
                                                        case (true) {
                                                        switch (c1 == 0x80)
                                                        {
                                                            case (true) {
                                                            switch ((c2 >= 0x80 & c2 <= 0x8A) | c2 == 0xA8 | c2 == 0xA9 | c2 == 0xAF)
                                                            {
                                                                case (true) { -> 3; }
                                                                default {};
                                                            };
                                                            -> 0;
                                                        }
                                                            default {};
                                                        };
                                                        switch (c1 == 0x81 & c2 == 0x9F)
                                                        {
                                                            case (true) { -> 3; }
                                                            default {};
                                                        };
                                                        -> 0;
                                                    }
                                                        default
                                                        {
                                                            switch (c == 0xE3)
                                                            {
                                                                case (true) {
                                                                switch (c1 == 0x80 & c2 == 0x80)
                                                                {
                                                                    case (true) { -> 3; }
                                                                    default {};
                                                                };
                                                                -> 0;
                                                            }
                                                                default
                                                                {
                                                                    -> 0;
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };


        pp_ws_back(byte* s, int lo, int j) -> int
        {
            switch (j <= lo)
            {
                case (true) { -> 0; }
                default
                {
                    int c = (int)s[j - 1];
                    switch (c == 32 | (c >= 9 & c <= 13) | (c >= 28 & c <= 31))
                    {
                        case (true) { -> 1; }
                        default
                        {
                            switch (c < 128)
                            {
                                case (true) { -> 0; }
                                default
                                {
                                    int b1, b2;
                                    switch (j - 2 >= lo)
                                    {
                                        case (true) {
                                        b1 = (int)s[j - 2];
                                        switch (b1 == 0xC2 & (c == 0x85 | c == 0xA0))
                                        {
                                            case (true) { -> 2; }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    switch (j - 3 >= lo)
                                    {
                                        case (true) {
                                        b2 = (int)s[j - 3];
                                        b1 = (int)s[j - 2];
                                        switch (b2 == 0xE1 & b1 == 0x9A & c == 0x80)
                                        {
                                            case (true) { -> 3; }
                                            default
                                            {
                                                switch (b2 == 0xE2 & b1 == 0x80)
                                                {
                                                    case (true) {
                                                    switch ((c >= 0x80 & c <= 0x8A) | c == 0xA8 | c == 0xA9 | c == 0xAF)
                                                    {
                                                        case (true) { -> 3; }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (b2 == 0xE2 & b1 == 0x81 & c == 0x9F)
                                                {
                                                    case (true) { -> 3; }
                                                    default
                                                    {
                                                        switch (b2 == 0xE3 & b1 == 0x80 & c == 0x80)
                                                        {
                                                            case (true) { -> 3; }
                                                            default {};
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    }
                                        default {};
                                    };
                                    -> 0;
                                };
                            };
                        };
                    };
                };
            };
        };


        pp_trim(byte* t, int* lo, int* hi) -> void
        {
            int a = *lo;
            int b = *hi;
            int w;
            while (a < b)
            {
                w = pp_ws_fwd(t, b, a);
                switch (w == 0)
                {
                    case (true) { break; }
                    default
                    {
                        a = a + w;
                    };
                };
            };
            while (b > a)
            {
                w = pp_ws_back(t, a, b);
                switch (w == 0)
                {
                    case (true) { break; }
                    default
                    {
                        b = b - w;
                    };
                };
            };
            *lo = a;
            *hi = b;
            ->;
        };



        pp_next_tok(byte* t, int hi, int pos, int* ts, int* te) -> int
        {
            int p = pos;
            int w;
            while (p < hi)
            {
                w = pp_ws_fwd(t, hi, p);
                switch (w == 0)
                {
                    case (true) { break; }
                    default
                    {
                        p = p + w;
                    };
                };
            };
            switch (p >= hi)
            {
                case (true) { -> -1; }
                default
                {
                    *ts = p;
                    while (p < hi)
                    {
                        w = pp_ws_fwd(t, hi, p);
                        switch (w != 0)
                        {
                            case (true) { break; }
                            default
                            {
                                p++;
                            };
                        };
                    };
                    *te = p;
                    -> p;
                };
            };
        };



        pp_eol(byte* t, int n, int p, int* tl) -> int
        {
            int j = p;
            int c, c1, c2;
            while (j < n)
            {
                c = (int)t[j];
                switch (c == 10 | c == 11 | c == 12 | c == 28 | c == 29 | c == 30)
                {
                    case (true) {
                    *tl = 1;
                    -> j;
                }
                    default
                    {
                        switch (c == 13)
                        {
                            case (true) {
                            *tl = 1;
                            switch (pp_at(t, n, j + 1) == 10)
                            {
                                case (true) { *tl = 2; }
                                default {};
                            };
                            -> j;
                        }
                            default
                            {
                                switch (c == 0xC2)
                                {
                                    case (true) {
                                    switch (pp_at(t, n, j + 1) == 0x85)
                                    {
                                        case (true) {
                                        *tl = 2;
                                        -> j;
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (c == 0xE2)
                                {
                                    case (true) {
                                    c1 = pp_at(t, n, j + 1);
                                    c2 = pp_at(t, n, j + 2);
                                    switch (c1 == 0x80 & (c2 == 0xA8 | c2 == 0xA9))
                                    {
                                        case (true) {
                                        *tl = 3;
                                        -> j;
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                j++;
                            };
                        };
                    };
                };
            };
            *tl = 0;
            -> n;
        };


        pp_boundary(byte* s, int n, int pos) -> bool
        {
            bool a = false;
            bool b = false;
            switch (pos > 0)
            {
                case (true) { a = pp_is_word((int)s[pos - 1]); }
                default {};
            };
            switch (pos < n)
            {
                case (true) { b = pp_is_word((int)s[pos]); }
                default {};
            };
            -> (a & !b) | (!a & b);
        };

        pp_is_abs(byte* r, int n) -> bool
        {
            switch (n <= 0)
            {
                case (true) { -> false; }
                default {};
            };
            switch ((int)r[0] == 92)
            {
                case (true) { -> true; }
                default {};
            };


            switch (n >= 2)
            {
                case (true) {
                switch (r[1] == ':')
                {
                    case (true) { -> true; }
                    default {};
                };
            }
                default {};
            };
            -> false;
        };


        pp_parent_len(byte* p, int n) -> int
        {
            int i = n - 1;
            while (i >= 0)
            {
                switch ((int)p[i] == 92)
                {
                    case (true) { break; }
                    default
                    {
                        i--;
                    };
                };
            };
            switch (i < 0)
            {
                case (true) { -> 0; }
                default {};
            };
            switch (i == 0)
            {
                case (true) { -> 1; }
                default {};
            };


            switch (i == 2)
            {
                case (true) {
                switch (p[1] == ':')
                {
                    case (true) { -> 3; }
                    default {};
                };
            }
                default {};
            };
            -> i;
        };

        pp_exists(byte* p) -> bool
        {




            -> _access(p, 0) == 0;
        };

        pp_hash(byte* s, int n) -> u64
        {
            u64 h = (u64)5381;
            int i;
            while (i < n)
            {
                h = h * (u64)33 + (u64)s[i];
                i++;
            };
            -> h;
        };





        object Buf
        {
            byte* mem;
            int len, cap;
            bool ok;

            __init() -> this
            {
                this.len = 0;
                this.cap = 256;
                this.ok = true;
                this.mem = (byte*)fmalloc((u64)this.cap);
                switch (this.mem == (byte*)0)
                {
                    case (true) {
                    this.ok = false;
                    this.cap = 0;
                }
                    default {
                    this.mem[0] = (byte)0;
                };
                };
                -> this;
            };

            __expr() -> Buf* -> this;

            __exit() -> void
            {
                switch (this.mem != (byte*)0)
                {
                    case (true) { ffree(this.mem); }
                    default {};
                };
                this.mem = (byte*)0;
                this.len = 0;
                this.cap = 0;
                ->;
            };

            reserve(int extra) -> bool
            {
                switch (!this.ok)
                {
                    case (true) { -> false; }
                    default
                    {
                        int need = this.len + extra + 1;
                        switch (need <= this.cap)
                        {
                            case (true) { -> true; }
                            default
                            {
                                int nc = this.cap;
                                switch (nc < 256)
                                {
                                    case (true) { nc = 256; }
                                    default {};
                                };
                                while (nc < need) { nc = nc * 2; };
                                u64 np;
                                switch (this.mem == (byte*)0)
                                {
                                    case (true) {
                                    np = (u64)fmalloc((u64)nc);
                                }
                                    default {
                                    np = frealloc((u64)this.mem, (size_t)nc);
                                };
                                };
                                switch (np == (u64)0)
                                {
                                    case (true) {
                                    this.ok = false;
                                    -> false;
                                }
                                    default
                                    {
                                        this.mem = (byte*)np;
                                        this.cap = nc;
                                        -> true;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            put(int b) -> void
            {
                switch (!this.reserve(1))
                {
                    case (true) { ->; }
                    default
                    {
                        this.mem[this.len] = (byte)b;
                        this.len++;
                        this.mem[this.len] = (byte)0;
                        ->;
                    };
                };
            };


            put_n(byte* s, int n) -> void
            {
                switch (n <= 0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (!this.reserve(n))
                        {
                            case (true) { ->; }
                            default
                            {
                                int i;
                                while (i < n)
                                {
                                    this.mem[this.len + i] = s[i];
                                    i++;
                                };
                                this.len = this.len + n;
                                this.mem[this.len] = (byte)0;
                                ->;
                            };
                        };
                    };
                };
            };

            put_str(byte* s) -> void -> this.put_n(s, pp_cstrlen(s));

            put_int(int v) -> void
            {
                byte[16] tmp = noinit;
                int n, k;
                switch (v < 0)
                {
                    case (true) {
                    this.put(45);
                    v = 0 - v;
                }
                    default {};
                };
                switch (v == 0)
                {
                    case (true) {
                    -> this.put(48);
                }
                    default
                    {
                        while (v > 0)
                        {
                            tmp[n] = (byte)(48 + v % 10);
                            v = v / 10;
                            n++;
                        };
                        k = n;
                        while (k > 0)
                        {
                            k--;
                            this.put((int)tmp[k]);
                        };
                        ->;
                    };
                };
            };

            clear() -> void
            {
                this.len = 0;
                switch (this.mem != (byte*)0)
                {
                    case (true) { this.mem[0] = (byte)0; }
                    default {};
                };
                ->;
            };

            pop() -> void
            {
                switch (this.len > 0)
                {
                    case (true) {
                    this.len--;
                    this.mem[this.len] = (byte)0;
                }
                    default {};
                };
                ->;
            };


            rstrip_ws() -> void
            {
                switch (this.mem == (byte*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        int w;
                        while (this.len > 0)
                        {
                            w = pp_ws_back(this.mem, 0, this.len);
                            switch (w == 0)
                            {
                                case (true) { break; }
                                default
                                {
                                    this.len = this.len - w;
                                };
                            };
                        };
                        this.mem[this.len] = (byte)0;
                        ->;
                    };
                };
            };


            put_stripped(byte* c, int n) -> void
            {
                int i, ch, string_char;
                bool in_string = false;
                while (i < n)
                {
                    ch = (int)c[i];
                    switch (in_string)
                    {
                        case (true) {
                        this.put(ch);
                        switch (ch == 92 & i + 1 < n)
                        {
                            case (true) {
                            i++;
                            this.put((int)c[i]);
                        }
                            default {
                                switch (ch == string_char)
                                {
                                    case (true) {
                            in_string = false;
                        }
                                    default {};
                                };
                            };
                        };
                        i++;
                        continue;
                    }
                        default
                        {
                            switch (ch == 34 | ch == 39)
                            {
                                case (true) {
                                in_string = true;
                                string_char = ch;
                                this.put(ch);
                                i++;
                                continue;
                            }
                                default
                                {
                                    switch (i + 2 < n)
                                    {
                                        case (true) {
                                        switch (ch == 47 & c[i + 1] == 47 & c[i + 2] == 47)
                                        {
                                            case (true) {
                                            i = i + 3;
                                            while (i < n)
                                            {
                                                switch (i + 2 < n)
                                                {
                                                    case (true) {
                                                    switch (c[i] == 47 & c[i + 1] == 47 & c[i + 2] == 47)
                                                    {
                                                        case (true) {
                                                        i = i + 3;
                                                        break;
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (c[i] == 10)
                                                {
                                                    case (true) { this.put(10); }
                                                    default {};
                                                };
                                                i++;
                                            };
                                            continue;
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };

                                    switch (i + 1 < n)
                                    {
                                        case (true) {
                                        switch (ch == 47 & c[i + 1] == 47)
                                        {
                                            case (true) {
                                            while (i < n)
                                            {
                                                switch (c[i] == 10)
                                                {
                                                    case (true) { break; }
                                                    default
                                                    {
                                                        i++;
                                                    };
                                                };
                                            };
                                            continue;
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };

                                    this.put(ch);
                                    i++;
                                };
                            };
                        };
                    };
                };
                ->;
            };


            put_replaced_word(byte* src, int sn, byte* pat, int pn, byte* rep, int rn) -> void
            {
                int i;
                bool hit;
                while (i < sn)
                {
                    hit = false;
                    switch (i + pn <= sn)
                    {
                        case (true) {
                        switch (pp_eq(src + i, pat, pn))
                        {
                            case (true) {
                            switch (pp_boundary(src, sn, i))
                            {
                                case (true) {
                                switch (pp_boundary(src, sn, i + pn))
                                {
                                    case (true) { hit = true; }
                                    default {};
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    switch (hit)
                    {
                        case (true) {
                        this.put_n(rep, rn);
                        i = i + pn;
                    }
                        default {
                        this.put((int)src[i]);
                        i++;
                    };
                    };
                };
                ->;
            };






            load_file(byte* path) -> int
            {
                void* f = fopen(path, g"rb\0");
                switch (f == (void*)0)
                {
                    case (true) { -> -1; }
                    default
                    {
                        fseek(f, 0, SEEK_END);
                        int size = ftell(f);
                        fseek(f, 0, SEEK_SET);
                        switch (size < 0)
                        {
                            case (true) {
                            fclose(f);
                            -> -1;
                        }
                            default
                            {
                                byte* raw = (byte*)fmalloc((u64)size + (u64)1);
                                switch (raw == (byte*)0)
                                {
                                    case (true) {
                                    fclose(f);
                                    -> -1;
                                }
                                    default
                                    {
                                        int got = fread(raw, 1, size, f);
                                        fclose(f);
                                        switch (got < 0)
                                        {
                                            case (true) {
                                            ffree(raw);
                                            -> -1;
                                        }
                                            default
                                            {
                                                this.clear();
                                                int i, bad, c, need, lo, hi, k, b1;
                                                switch (got >= 3)
                                                {
                                                    case (true) {
                                                    switch (raw[0] == 0xEF & raw[1] == 0xBB & raw[2] == 0xBF)
                                                    {
                                                        case (true) { i = 3; }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };

                                                while (i < got)
                                                {
                                                    c = (int)raw[i];
                                                    switch (c < 0x80)
                                                    {
                                                        case (true) {
                                                        switch (c)
                                                        {
                                                            case (13)
                                                            {
                                                                this.put(10);
                                                                switch (pp_at(raw, got, i + 1) == 10)
                                                                {
                                                                    case (true) { i++; }
                                                                    default {};
                                                                };
                                                            }
                                                            default
                                                            {
                                                                this.put(c);
                                                            };
                                                        };
                                                        i++;
                                                        continue;
                                                    }
                                                        default
                                                        {
                                                            need = 0;
                                                            lo = 0x80;
                                                            hi = 0xBF;
                                                            switch (c >= 0xC2 & c <= 0xDF)
                                                            {
                                                                case (true) { need = 1; }
                                                                default {
                                                                    switch (c == 0xE0)
                                                                    {
                                                                        case (true) { need = 2; lo = 0xA0; }
                                                                        default {
                                                                            switch (c >= 0xE1 & c <= 0xEC)
                                                                            {
                                                                                case (true) { need = 2; }
                                                                                default {
                                                                                    switch (c == 0xED)
                                                                                    {
                                                                                        case (true) { need = 2; hi = 0x9F; }
                                                                                        default {
                                                                                            switch (c >= 0xEE & c <= 0xEF)
                                                                                            {
                                                                                                case (true) { need = 2; }
                                                                                                default {
                                                                                                    switch (c == 0xF0)
                                                                                                    {
                                                                                                        case (true) { need = 3; lo = 0x90; }
                                                                                                        default {
                                                                                                            switch (c >= 0xF1 & c <= 0xF3)
                                                                                                            {
                                                                                                                case (true) { need = 3; }
                                                                                                                default {
                                                                                                                    switch (c == 0xF4)
                                                                                                                    {
                                                                                                                        case (true) { need = 3; hi = 0x8F; }
                                                                                                                        default {};
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };

                                                            switch (need == 0)
                                                            {
                                                                case (true) {
                                                                this.put(0xEF);
                                                                this.put(0xBF);
                                                                this.put(0xBD);
                                                                bad = 1;
                                                                i++;
                                                                continue;
                                                            }
                                                                default
                                                                {
                                                                    k = 1;
                                                                    while (k <= need)
                                                                    {
                                                                        b1 = pp_at(raw, got, i + k);
                                                                        switch (b1 < lo | b1 > hi)
                                                                        {
                                                                            case (true) { break; }
                                                                            default
                                                                            {
                                                                                lo = 0x80;
                                                                                hi = 0xBF;
                                                                                k++;
                                                                            };
                                                                        };
                                                                    };

                                                                    switch (k > need)
                                                                    {
                                                                        case (true) {
                                                                        this.put_n(raw + i, need + 1);
                                                                        i = i + need + 1;
                                                                    }
                                                                        default {
                                                                        this.put(0xEF);
                                                                        this.put(0xBF);
                                                                        this.put(0xBD);
                                                                        bad = 1;
                                                                        i = i + k;
                                                                    };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };

                                                ffree(raw);
                                                -> bad;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };



        object IntVec
        {
            int* arr;
            int len, cap;
            bool ok;

            __init() -> this
            {
                this.len = 0;
                this.cap = 64;
                this.ok = true;
                this.arr = (int*)fmalloc((u64)this.cap * (u64)(sizeof(int) / 8));
                switch (this.arr == (int*)0)
                {
                    case (true) {
                    this.ok = false;
                    this.cap = 0;
                }
                    default {};
                };
                -> this;
            };

            __expr() -> IntVec* -> this;

            __exit() -> void
            {
                switch (this.arr != (int*)0)
                {
                    case (true) { ffree((byte*)this.arr); }
                    default {};
                };
                this.arr = (int*)0;
                this.len = 0;
                this.cap = 0;
                ->;
            };

            push(int v) -> void
            {
                switch (!this.ok)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (this.len >= this.cap)
                        {
                            case (true) {
                            int nc = this.cap * 2;
                            switch (nc < 64)
                            {
                                case (true) { nc = 64; }
                                default {};
                            };
                            u64 np;
                            switch (this.arr == (int*)0)
                            {
                                case (true) {
                                np = (u64)fmalloc((u64)nc * (u64)(sizeof(int) / 8));
                            }
                                default {
                                np = frealloc((u64)this.arr, (size_t)((u64)nc * (u64)(sizeof(int) / 8)));
                            };
                            };
                            switch (np == (u64)0)
                            {
                                case (true) {
                                this.ok = false;
                                ->;
                            }
                                default
                                {
                                    this.arr = (int*)np;
                                    this.cap = nc;
                                };
                            };
                        }
                            default {};
                        };
                        this.arr[this.len] = v;
                        this.len++;
                        ->;
                    };
                };
            };

            pop() -> void
            {
                switch (this.len > 0)
                {
                    case (true) { this.len--; }
                    default {};
                };
                ->;
            };

            clear() -> void
            {
                this.len = 0;
                ->;
            };
        };








        object SymTab
        {
            int* slots;
            int* ents;
            int slot_cap, ent_cap, count;
            Buf keys;
            Buf vals;
            bool ok;

            __init() -> this
            {
                this.keys.__init();
                this.vals.__init();
                this.count = 0;
                this.ok = true;
                this.slot_cap = 256;
                this.ent_cap = 64;
                this.slots = (int*)fmalloc((u64)this.slot_cap * (u64)(sizeof(int) / 8));
                this.ents = (int*)fmalloc((u64)this.ent_cap * (u64)8 * (u64)(sizeof(int) / 8));
                switch (this.slots == (int*)0 | this.ents == (int*)0)
                {
                    case (true) {
                    this.ok = false;
                    -> this;
                }
                    default
                    {
                        int z;
                        while (z < this.slot_cap)
                        {
                            this.slots[z] = 0;
                            z++;
                        };
                        -> this;
                    };
                };
            };

            __expr() -> SymTab* -> this;

            __exit() -> void
            {
                switch (this.slots != (int*)0)
                {
                    case (true) { ffree((byte*)this.slots); }
                    default {};
                };
                switch (this.ents != (int*)0)
                {
                    case (true) { ffree((byte*)this.ents); }
                    default {};
                };
                this.slots = (int*)0;
                this.ents = (int*)0;
                this.keys.__exit();
                -> this.vals.__exit();
            };


            find(byte* s, int n) -> int
            {
                switch (!this.ok)
                {
                    case (true) { -> -1; }
                    default
                    {
                        u64 h = pp_hash(s, n);
                        int idx = (int)(h % (u64)this.slot_cap);
                        int e, base, j;
                        bool same;
                        while (true)
                        {
                            e = this.slots[idx];
                            switch (e == 0)
                            {
                                case (true) { -> -1; }
                                default
                                {
                                    e = e - 1;
                                    base = e * 8;
                                    switch (this.ents[base + 1] == n)
                                    {
                                        case (true) {
                                        same = true;
                                        j = 0;
                                        while (j < n)
                                        {
                                            switch (this.keys.mem[this.ents[base] + j] != s[j])
                                            {
                                                case (true) {
                                                same = false;
                                                break;
                                            }
                                                default
                                                {
                                                    j++;
                                                };
                                            };
                                        };
                                        switch (same)
                                        {
                                            case (true) { -> e; }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    idx++;
                                    switch (idx >= this.slot_cap)
                                    {
                                        case (true) { idx = 0; }
                                        default {};
                                    };
                                };
                            };
                        };
                        -> -1;
                    };
                };
            };


            place(int e) -> void
            {
                int base = e * 8;
                u64 h = pp_hash(this.keys.mem + this.ents[base], this.ents[base + 1]);
                int idx = (int)(h % (u64)this.slot_cap);
                while (this.slots[idx] != 0)
                {
                    idx++;
                    switch (idx >= this.slot_cap)
                    {
                        case (true) { idx = 0; }
                        default {};
                    };
                };
                this.slots[idx] = e + 1;
                ->;
            };

            grow_slots() -> bool
            {
                int nc = this.slot_cap * 2;
                int* ns = (int*)fmalloc((u64)nc * (u64)(sizeof(int) / 8));
                switch (ns == (int*)0)
                {
                    case (true) {
                    this.ok = false;
                    -> false;
                }
                    default
                    {
                        int z, e;
                        while (z < nc)
                        {
                            ns[z] = 0;
                            z++;
                        };
                        ffree((byte*)this.slots);
                        this.slots = ns;
                        this.slot_cap = nc;
                        while (e < this.count)
                        {
                            this.place(e);
                            e++;
                        };
                        -> true;
                    };
                };
            };

            grow_ents() -> bool
            {
                int nc = this.ent_cap * 2;
                u64 np = frealloc((u64)this.ents, (size_t)((u64)nc * (u64)8 * (u64)(sizeof(int) / 8)));
                switch (np == (u64)0)
                {
                    case (true) {
                    this.ok = false;
                    -> false;
                }
                    default
                    {
                        this.ents = (int*)np;
                        this.ent_cap = nc;
                        -> true;
                    };
                };
            };



            intern(byte* s, int n) -> int
            {
                int e = this.find(s, n);
                switch (e >= 0)
                {
                    case (true) { -> e; }
                    default
                    {
                        switch (!this.ok)
                        {
                            case (true) { -> -1; }
                            default
                            {
                                switch (this.count + 1 > this.ent_cap)
                                {
                                    case (true) {
                                    switch (!this.grow_ents())
                                    {
                                        case (true) { -> -1; }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch ((this.count + 1) * 2 > this.slot_cap)
                                {
                                    case (true) {
                                    switch (!this.grow_slots())
                                    {
                                        case (true) { -> -1; }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                e = this.count;
                                int base = e * 8;
                                this.ents[base] = this.keys.len;
                                this.ents[base + 1] = n;
                                this.ents[base + 2] = 0;
                                this.ents[base + 3] = 0;
                                this.ents[base + 4] = 0;
                                this.ents[base + 5] = 0;
                                this.ents[base + 6] = 0;
                                this.ents[base + 7] = 0;
                                this.keys.put_n(s, n);
                                this.keys.put(0);
                                this.count++;
                                this.place(e);
                                -> e;
                            };
                        };
                    };
                };
            };

            set_val(int e, byte* v, int n) -> void
            {
                int base = e * 8;
                this.ents[base + 2] = this.vals.len;
                this.ents[base + 3] = n;
                this.vals.put_n(v, n);
                -> this.vals.put(0);
            };



            set_params(int e, byte* p, int plen, int pcount) -> void
            {
                int base = e * 8;
                this.ents[base + 4] = this.vals.len;
                this.ents[base + 5] = plen;
                this.ents[base + 6] = pcount;
                -> this.vals.put_n(p, plen);
            };

            val_ptr(int e) -> byte* -> this.vals.mem + this.ents[e * 8 + 2];

            val_len(int e) -> int -> this.ents[e * 8 + 3];

            par_ptr(int e) -> byte* -> this.vals.mem + this.ents[e * 8 + 4];

            par_count(int e) -> int -> this.ents[e * 8 + 6];
        };



        object Preprocessor
        {
            bool verbose;

            Buf pool;       
            Buf outb;       
            Buf errb;       
            Buf srcpath;
            Buf fbuf;
            Buf sc;         
            Buf ma;         
            Buf mc;         
            Buf x1;
            Buf x2;
            Buf psb;        
            Buf pb;         
            Buf tmp;
            Buf passb;
            Buf rbuf;       
            Buf jb;         
            Buf js;         
            Buf jv;         

            IntVec files;       
            IntVec lib_dirs;    
            IntVec dir_stack;   
            IntVec map_file;    
            IntVec map_line;    
            IntVec aoff;
            IntVec alen;

            SymTab processed;
            SymTab consts;
            SymTab psubs;

            int line_count, cur_file, cur_lineno, err_kind;
            byte** xpaths;      
            int xcount;
            int srcdir_off, cwd_off, root_dir_off;
            int pc_off, pc_len;
            bool pc_inv;
            byte* pathbuf;
            byte* sub_ptr;
            byte* ex_ptr;
            int sub_len, ex_len;

            __init(byte* source_file) -> this
            {
                this.pool.__init();
                this.outb.__init();
                this.errb.__init();
                this.srcpath.__init();
                this.fbuf.__init();
                this.sc.__init();
                this.ma.__init();
                this.mc.__init();
                this.x1.__init();
                this.x2.__init();
                this.psb.__init();
                this.pb.__init();
                this.tmp.__init();
                this.passb.__init();
                this.rbuf.__init();
                this.jb.__init();
                this.js.__init();
                this.jv.__init();
                this.files.__init();
                this.lib_dirs.__init();
                this.dir_stack.__init();
                this.map_file.__init();
                this.map_line.__init();
                this.aoff.__init();
                this.alen.__init();
                this.processed.__init();
                this.consts.__init();
                this.psubs.__init();

                this.verbose = false;
                this.line_count = 0;
                this.cur_file = -1;
                this.xpaths = (byte**)0;
                this.xcount = 0;
                this.cur_lineno = 0;
                this.err_kind = 0;
                this.root_dir_off = -1;
                this.srcdir_off = -1;
                this.cwd_off = -1;
                this.sub_ptr = (byte*)0;
                this.ex_ptr = (byte*)0;
                this.sub_len = 0;
                this.ex_len = 0;

                this.srcpath.put_str(source_file);
                this.pathbuf = (byte*)fmalloc((u64)4096);
                switch (this.pathbuf == (byte*)0)
                {
                    case (true) {
                    this.err_kind = PPError.ALLOC;
                    -> this;
                }
                    default
                    {
                        switch (this.realpath_into(g".\0"))
                        {
                            case (true) {
                            this.cwd_off = this.pool_add(this.rbuf.mem, this.rbuf.len);
                        }
                            default {
                            this.cwd_off = this.pool_add(g".\0", 1);
                        };
                        };
                        this.srcdir_off = this.cwd_off;
                        -> this;
                    };
                };
            };

            __expr() -> Preprocessor* -> this;

            __exit() -> void
            {
                switch (this.pathbuf != (byte*)0)
                {
                    case (true) { ffree(this.pathbuf); }
                    default {};
                };
                this.pathbuf = (byte*)0;
                this.pool.__exit();
                this.outb.__exit();
                this.errb.__exit();
                this.srcpath.__exit();
                this.fbuf.__exit();
                this.sc.__exit();
                this.ma.__exit();
                this.mc.__exit();
                this.x1.__exit();
                this.x2.__exit();
                this.psb.__exit();
                this.pb.__exit();
                this.tmp.__exit();
                this.passb.__exit();
                this.rbuf.__exit();
                this.jb.__exit();
                this.js.__exit();
                this.jv.__exit();
                this.files.__exit();
                this.lib_dirs.__exit();
                this.dir_stack.__exit();
                this.map_file.__exit();
                this.map_line.__exit();
                this.aoff.__exit();
                this.alen.__exit();
                this.processed.__exit();
                this.consts.__exit();
                -> this.psubs.__exit();
            };



            text_ptr() -> byte* -> this.outb.mem;

            text_len() -> int -> this.outb.len;

            err_text() -> byte* -> this.errb.mem;


            map_path(int i) -> byte*
            {
                int id = this.map_file.arr[i];
                if (id < 0) { -> this.xpaths[0 - id - 1]; };
                -> this.pool.mem + this.files.arr[id];
            };





            append_map(int* lines, byte** paths, int n) -> void
            {
                int i, k, id, pl, c;
                byte* p;
                byte* q;
                byte** grown;
                while (i < n)
                {
                    p = paths[i];
                    pl = pp_cstrlen(p);
                    id = 0;
                    k = this.xcount;
                    while (k > 0)
                    {
                        q = this.xpaths[k - 1];
                        if (pp_cstrlen(q) == pl)
                        {
                            if (pp_eq(q, p, pl)) { id = k; break; };
                        };
                        k--;
                    };
                    if (id == 0)
                    {
                        q = (byte*)fmalloc((u64)(pl + 1));
                        c = 0;
                        while (c < pl)
                        {
                            q[c] = p[c];
                            c++;
                        };
                        q[pl] = (byte)0;
                        grown = (byte**)fmalloc((u64)(this.xcount + 1) * (u64)8);
                        c = 0;
                        while (c < this.xcount)
                        {
                            grown[c] = this.xpaths[c];
                            c++;
                        };
                        grown[this.xcount] = q;
                        if (this.xpaths != (byte**)0) { ffree((byte*)this.xpaths); };
                        this.xpaths = grown;
                        this.xcount++;
                        id = this.xcount;
                    };
                    this.map_file.push(0 - id);
                    this.map_line.push(lines[i]);
                    this.line_count++;
                    i++;
                };
                ->;
            };


            line_files() -> byte**
            {
                int n = this.map_line.len;
                int i;
                byte** r = (byte**)fmalloc((u64)(n + 1) * (u64)8);
                while (i < n)
                {
                    r[i] = this.map_path(i);
                    i++;
                };
                -> r;
            };


            map_lineno(int i) -> int -> this.map_line.arr[i];


            file_count() -> int -> this.processed.count;



            set_srcdir(byte* dir) -> void
            {
                this.srcdir_off = this.pool_add(dir, pp_cstrlen(dir));
                ->;
            };


            define(byte* name, byte* value) -> void
            {
                int e = this.consts.intern(name, pp_cstrlen(name));
                switch (e < 0)
                {
                    case (true) { ->; }
                    default
                    {
                        -> this.consts.set_val(e, value, pp_cstrlen(value));
                    };
                };
            };




            add_default_macros() -> void
            {
                this.define(g"__IDEKA__\0", g"1\0");
                this.define(g"__IDEKA_MAJOR__\0", g"1\0");
                this.define(g"__IDEKA_MINOR__\0", g"0\0");
                this.define(g"__IDEKA_PATCH__\0", g"0\0");
                this.define(g"__IDEKA_VERSION__\0", g"1\0");
                this.define(g"__LLVM__\0", g"1\0");

                this.define(g"__ARCH_X86__\0", g"0\0");
                this.define(g"__ARCH_X86_64__\0", g"0\0");
                this.define(g"__ARCH_ARM__\0", g"0\0");
                this.define(g"__ARCH_ARM64__\0", g"0\0");
                this.define(g"__ARCH_RISCV__\0", g"0\0");

                this.define(g"__WINDOWS__\0", g"0\0");
                this.define(g"__LINUX__\0", g"0\0");
                this.define(g"__MACOS__\0", g"0\0");
                this.define(g"__POSIX__\0", g"0\0");

                this.define(g"__LITTLE_ENDIAN__\0", g"0\0");
                this.define(g"__BIG_ENDIAN__\0", g"1\0");
                this.define(g"__SIZEOF_PTR__\0", g"8\0");
                this.define(g"__SIZEOF_INT__\0", g"4\0");
                this.define(g"__SIZEOF_LONG__\0", g"8\0");
                this.define(g"__BYTE_WIDTH__\0", g"8\0");

                this.define(g"__DEBUG__\0", g"0\0");
                this.define(g"__RELEASE__\0", g"0\0");
                this.define(g"__OPTIMIZE__\0", g"0\0");













                this.define(g"__WINDOWS__\0", g"1\0");
                this.define(g"__WIN32__\0", g"1\0");




                    this.define(g"__WIN64__\0", g"1\0");











                this.define(g"__ARCH_X86_64__\0", g"1\0");
                this.define(g"__x86_64__\0", g"1\0");
                this.define(g"__amd64__\0", g"1\0");
                ->;
            };





            pool_add(byte* s, int n) -> int
            {
                int off = this.pool.len;
                this.pool.put_n(s, n);
                this.pool.put(0);
                -> off;
            };

            e_begin(int kind) -> void
            {
                this.err_kind = kind;
                this.errb.clear();
                ->;
            };


            vline(byte* a, byte* s, int n, byte* b) -> void
            {
                this.tmp.clear();
                this.tmp.put_str(a);
                this.tmp.put_n(s, n);
                this.tmp.put_str(b);
                standard::io::console::println(this.tmp.mem);
                ->;
            };


            emit(byte* s, int n, int lineno) -> void
            {
                switch (this.line_count > 0)
                {
                    case (true) { this.outb.put(10); }
                    default {};
                };
                this.outb.put_n(s, n);
                this.map_file.push(this.cur_file);
                this.map_line.push(lineno);
                this.line_count++;
                ->;
            };

            emit_blank(int lineno) -> void -> this.emit(g"\0", 0, lineno);

            alloc_ok() -> bool
            {
                switch (!this.pool.ok | !this.outb.ok | !this.errb.ok | !this.fbuf.ok | !this.sc.ok)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (!this.ma.ok | !this.mc.ok | !this.x1.ok | !this.x2.ok | !this.psb.ok)
                        {
                            case (true) { -> false; }
                            default
                            {
                                switch (!this.pb.ok | !this.tmp.ok | !this.passb.ok | !this.rbuf.ok | !this.jb.ok)
                                {
                                    case (true) { -> false; }
                                    default
                                    {
                                        switch (!this.js.ok | !this.jv.ok | !this.files.ok | !this.lib_dirs.ok | !this.dir_stack.ok)
                                        {
                                            case (true) { -> false; }
                                            default
                                            {
                                                switch (!this.map_file.ok | !this.map_line.ok | !this.aoff.ok | !this.alen.ok)
                                                {
                                                    case (true) { -> false; }
                                                    default
                                                    {
                                                        switch (!this.processed.ok | !this.consts.ok | !this.psubs.ok)
                                                        {
                                                            case (true) { -> false; }
                                                            default
                                                            {
                                                                -> true;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };





















            realpath_into(byte* p) -> bool
            {
                byte* r = _fullpath(this.pathbuf, p, (size_t)4096);
                switch (r == (byte*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        this.rbuf.clear();
                        this.rbuf.put_str(this.pathbuf);
                        -> true;
                    };
                };
            };


            join_to(byte* base, int bn, byte* rel, int rn) -> void
            {
                this.jb.clear();
                switch (pp_is_abs(rel, rn))
                {
                    case (true) {
                    -> this.jb.put_n(rel, rn);
                }
                    default
                    {
                        this.jb.put_n(base, bn);
                        switch (bn > 0)
                        {
                            case (true) {
                            switch ((int)base[bn - 1] != 92)
                            {
                                case (true) { this.jb.put(92); }
                                default {};
                            };
                        }
                            default {};
                        };
                        -> this.jb.put_n(rel, rn);
                    };
                };
            };


            try_candidate(byte* base, int bn, byte* rel, int rn) -> bool
            {
                this.join_to(base, bn, rel, rn);
                switch (!pp_exists(this.jb.mem))
                {
                    case (true) { -> false; }
                    default
                    {
                        -> this.realpath_into(this.jb.mem);
                    };
                };
            };


            resolve_local(byte* fp, int n) -> bool
            {
                byte* d;
                int k;
                switch (this.dir_stack.len > 0)
                {
                    case (true) {
                    d = this.pool.mem + this.dir_stack.arr[this.dir_stack.len - 1];
                    switch (this.try_candidate(d, pp_cstrlen(d), fp, n))
                    {
                        case (true) { -> true; }
                        default {};
                    };
                }
                    default {};
                };

                d = this.pool.mem + this.root_dir_off;
                switch (this.try_candidate(d, pp_cstrlen(d), fp, n))
                {
                    case (true) { -> true; }
                    default
                    {
                        d = this.pool.mem + this.cwd_off;
                        switch (this.try_candidate(d, pp_cstrlen(d), fp, n))
                        {
                            case (true) { -> true; }
                            default
                            {
                                while (k < this.lib_dirs.len)
                                {
                                    d = this.pool.mem + this.lib_dirs.arr[k];
                                    switch (this.try_candidate(d, pp_cstrlen(d), fp, n))
                                    {
                                        case (true) { -> true; }
                                        default
                                        {
                                            k++;
                                        };
                                    };
                                };
                                -> false;
                            };
                        };
                    };
                };
            };



            resolve_stdlib(byte* fp, int n) -> bool
            {
                byte* sd = this.pool.mem + this.srcdir_off;
                int w;
                while (w < 5)
                {
                    this.x1.clear();
                    this.x1.put_str(sd);
                    this.x1.put(92);
                    this.x1.put_str(g"src\0");
                    this.x1.put(92);
                    this.x1.put_str(g"stdlib\0");
                    switch (w > 0)
                    {
                        case (true) {
                        this.x1.put(92);
                        switch (w)
                        {
                            case (1) { this.x1.put_str(g"runtime\0"); }
                            case (2) { this.x1.put_str(g"functions\0"); }
                            case (3) { this.x1.put_str(g"builtins\0"); }
                            default { this.x1.put_str(g"utility\0"); };
                        };
                    }
                        default {};
                    };
                    switch (this.try_candidate(this.x1.mem, this.x1.len, fp, n))
                    {
                        case (true) { -> true; }
                        default
                        {
                            w++;
                        };
                    };
                };
                -> false;
            };


            resolve_default(byte* fp, int n) -> bool
            {
                switch (pp_exists(fp))
                {
                    case (true) {
                    switch (this.realpath_into(fp))
                    {
                        case (true) { -> true; }
                        default {};
                    };
                }
                    default {};
                };
                switch (this.resolve_local(fp, n))
                {
                    case (true) { -> true; }
                    default
                    {
                        -> this.resolve_stdlib(fp, n);
                    };
                };
            };



            json_ws(byte* t, int n, int p) -> int
            {
                int c = pp_at(t, n, p);
                while (c == 32 | c == 9 | c == 10 | c == 13)
                {
                    p++;
                    c = pp_at(t, n, p);
                };
                -> p;
            };

            json_hex4(byte* t, int n, int p) -> int
            {
                int v, k, c;
                while (k < 4)
                {
                    c = pp_at(t, n, p + k);
                    v = v * 16;
                    switch (c >= '0' & c <= '9')
                    {
                        case (true) { v = v + (c - 48); }
                        default {
                            switch (c >= 'A' & c <= 'F')
                            {
                                case (true) { v = v + (c - 55); }
                                default {
                                    switch (c >= 'a' & c <= 'f')
                                    {
                                        case (true) { v = v + (c - 87); }
                                        default { -> -1; };
                                    };
                                };
                            };
                        };
                    };
                    k++;
                };
                -> v;
            };



            json_string(byte* t, int n, int p) -> int
            {
                this.js.clear();
                switch (pp_at(t, n, p) != 34)
                {
                    case (true) { -> -1; }
                    default
                    {
                        p++;
                        int c, h, lo;
                        while (p < n)
                        {
                            c = (int)t[p];
                            switch (c == 34)
                            {
                                case (true) { -> p + 1; }
                                default
                                {
                                    switch (c == 92)
                                    {
                                        case (true) {
                                        p++;
                                        c = pp_at(t, n, p);
                                        switch (c)
                                        {
                                            case ('n') { this.js.put(10); }
                                            case ('t') { this.js.put(9); }
                                            case ('r') { this.js.put(13); }
                                            case ('b') { this.js.put(8); }
                                            case ('f') { this.js.put(12); }
                                            case ('u')
                                            {
                                                h = this.json_hex4(t, n, p + 1);
                                                switch (h < 0)
                                                {
                                                    case (true) { -> -1; }
                                                    default {};
                                                };
                                                p = p + 4;
                                                switch (h >= 0xD800 & h <= 0xDBFF)
                                                {
                                                    case (true) {
                                                    switch (pp_at(t, n, p + 1) == 92 & pp_at(t, n, p + 2) == 'u')
                                                    {
                                                        case (true) {
                                                        lo = this.json_hex4(t, n, p + 3);
                                                        switch (lo >= 0xDC00 & lo <= 0xDFFF)
                                                        {
                                                            case (true) {
                                                            h = 0x10000 + (h - 0xD800) * 0x400 + (lo - 0xDC00);
                                                            p = p + 6;
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (h < 0x80)
                                                {
                                                    case (true) { this.js.put(h); }
                                                    default {
                                                        switch (h < 0x800)
                                                        {
                                                            case (true) {
                                                    this.js.put(0xC0 + h / 64);
                                                    this.js.put(0x80 + h % 64);
                                                }
                                                            default {
                                                                switch (h < 0x10000)
                                                                {
                                                                    case (true) {
                                                    this.js.put(0xE0 + h / 4096);
                                                    this.js.put(0x80 + (h / 64) % 64);
                                                    this.js.put(0x80 + h % 64);
                                                }
                                                                    default {
                                                    this.js.put(0xF0 + h / 262144);
                                                    this.js.put(0x80 + (h / 4096) % 64);
                                                    this.js.put(0x80 + (h / 64) % 64);
                                                    this.js.put(0x80 + h % 64);
                                                };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            }
                                            default
                                            {
                                                switch (c < 0)
                                                {
                                                    case (true) { -> -1; }
                                                    default { this.js.put(c); };
                                                };
                                            };
                                        };
                                        p++;
                                        continue;
                                    }
                                        default
                                        {
                                            this.js.put(c);
                                            p++;
                                        };
                                    };
                                };
                            };
                        };
                        -> -1;
                    };
                };
            };


            json_skip(byte* t, int n, int p) -> int
            {
                p = this.json_ws(t, n, p);
                int c = pp_at(t, n, p);
                int depth;
                switch (c == 34)
                {
                    case (true) { -> this.json_string(t, n, p); }
                    default
                    {
                        switch (c == '{' | c == '[')
                        {
                            case (true) {
                            depth = 0;
                            while (p < n)
                            {
                                c = (int)t[p];
                                switch (c == 34)
                                {
                                    case (true) {
                                    p = this.json_string(t, n, p);
                                    switch (p < 0)
                                    {
                                        case (true) { -> -1; }
                                        default {};
                                    };
                                    continue;
                                }
                                    default {};
                                };
                                switch (c == '{' | c == '[')
                                {
                                    case (true) { depth++; }
                                    default {};
                                };
                                switch (c == '}' | c == ']')
                                {
                                    case (true) {
                                    depth--;
                                    switch (depth == 0)
                                    {
                                        case (true) { -> p + 1; }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                p++;
                            };
                            -> -1;
                        }
                            default
                            {
                                while (p < n)
                                {
                                    c = (int)t[p];
                                    switch (c == ',' | c == '}' | c == ']' | c == 32 | c == 9 | c == 10 | c == 13)
                                    {
                                        case (true) { break; }
                                        default
                                        {
                                            p++;
                                        };
                                    };
                                };
                                -> p;
                            };
                        };
                    };
                };
            };





            json_object(byte* t, int n, int p, int want_entries) -> int
            {
                int vs, nx;
                bool is_ep, is_en;
                this.jv.clear();
                this.pc_off = -1;
                p = this.json_ws(t, n, p);
                switch (pp_at(t, n, p) != '{')
                {
                    case (true) { -> 0; }
                    default
                    {
                        p++;
                        while (true)
                        {
                            p = this.json_ws(t, n, p);
                            switch (pp_at(t, n, p) == '}')
                            {
                                case (true) { -> 1; }
                                default
                                {
                                    switch (pp_at(t, n, p) == ',')
                                    {
                                        case (true) {
                                        p++;
                                        continue;
                                    }
                                        default
                                        {
                                            p = this.json_string(t, n, p);
                                            switch (p < 0)
                                            {
                                                case (true) { -> 0; }
                                                default
                                                {
                                                    is_ep = this.js.len == 10 & pp_eq(this.js.mem, g"entrypoint\0", 10);
                                                    is_en = this.js.len == 7 & pp_eq(this.js.mem, g"entries\0", 7);
                                                    p = this.json_ws(t, n, p);
                                                    switch (pp_at(t, n, p) != ':')
                                                    {
                                                        case (true) { -> 0; }
                                                        default
                                                        {
                                                            p = this.json_ws(t, n, p + 1);
                                                            vs = p;
                                                            switch (is_ep)
                                                            {
                                                                case (true) {
                                                                this.jv.clear();
                                                                switch (pp_at(t, n, p) == 34)
                                                                {
                                                                    case (true) {
                                                                    nx = this.json_string(t, n, p);
                                                                    switch (nx < 0)
                                                                    {
                                                                        case (true) { -> 0; }
                                                                        default
                                                                        {
                                                                            this.jv.put_n(this.js.mem, this.js.len);
                                                                            p = nx;
                                                                            continue;
                                                                        };
                                                                    };
                                                                }
                                                                    default {};
                                                                };
                                                            }
                                                                default {};
                                                            };
                                                            switch (is_en)
                                                            {
                                                                case (true) {
                                                                this.pc_off = vs;
                                                            }
                                                                default {};
                                                            };
                                                            p = this.json_skip(t, n, p);
                                                            switch (p < 0)
                                                            {
                                                                case (true) { -> 0; }
                                                                default {};
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        -> 0;
                    };
                };
            };


            process_package(byte* text, int name_off, int name_len) -> bool
            {
                Buf man();
                defer man.__exit();
                int pk, en_off, ok2, w;


                byte* cwd = this.pool.mem + this.cwd_off;
                this.x1.clear();
                this.x1.put_str(cwd);
                this.x1.put(92);
                this.x1.put_str(g".fpm\0");
                this.x1.put(92);
                this.x1.put_str(g"packages\0");
                w = this.x1.len;
                this.x1.put(92);
                this.x1.put_n(text + name_off, name_len);

                this.x2.clear();
                this.x2.put_n(this.x1.mem, this.x1.len);
                this.x2.put(92);
                this.x2.put(46);
                switch (!pp_exists(this.x2.mem))
                {
                    case (true) {
                    this.e_begin(PPError.NOT_FOUND);
                    this.errb.put_str(g"[PREPROCESSOR] Package '\0");
                    this.errb.put_n(text + name_off, name_len);
                    this.errb.put_str(g"' not found in \0");
                    this.errb.put_n(this.x1.mem, w);
                    -> false;
                }
                    default
                    {
                        this.x2.clear();
                        this.x2.put_n(this.x1.mem, this.x1.len);
                        this.x2.put(92);
                        this.x2.put_str(g"package.json\0");
                        switch (!pp_exists(this.x2.mem))
                        {
                            case (true) {
                            this.e_begin(PPError.NOT_FOUND);
                            this.errb.put_str(g"[PREPROCESSOR] Package '\0");
                            this.errb.put_n(text + name_off, name_len);
                            this.errb.put_str(g"' is missing package.json\0");
                            -> false;
                        }
                            default
                            {
                                ok2 = man.load_file(this.x2.mem);
                                switch (ok2 < 0)
                                {
                                    case (true) {
                                    this.e_begin(PPError.IO);
                                    this.errb.put_str(g"[PREPROCESSOR] Could not read \0");
                                    this.errb.put_n(this.x2.mem, this.x2.len);
                                    -> false;
                                }
                                    default
                                    {

                                        switch (this.json_object(man.mem, man.len, 0, 1) == 0)
                                        {
                                            case (true) {
                                            this.e_begin(PPError.KEY);
                                            this.errb.put_str(g"[PREPROCESSOR] Package '\0");
                                            this.errb.put_n(text + name_off, name_len);
                                            this.errb.put_str(g"' package.json is not a valid JSON object\0");
                                            -> false;
                                        }
                                            default
                                            {
                                                en_off = this.pc_off;
                                                switch (en_off >= 0)
                                                {
                                                    case (true) {
                                                    switch (this.json_object(man.mem, man.len, en_off, 0) == 0)
                                                    {
                                                        case (true) {
                                                        this.jv.clear();
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };

                                                switch (this.jv.len == 0)
                                                {
                                                    case (true) {
                                                    this.e_begin(PPError.KEY);
                                                    this.errb.put_str(g"[PREPROCESSOR] Package '\0");
                                                    this.errb.put_n(text + name_off, name_len);
                                                    this.errb.put_str(g"' package.json has no 'entrypoint' field\0");
                                                    -> false;
                                                }
                                                    default
                                                    {

                                                        this.join_to(this.x1.mem, this.x1.len, this.jv.mem, this.jv.len);
                                                        switch (!pp_exists(this.jb.mem))
                                                        {
                                                            case (true) {
                                                            this.e_begin(PPError.NOT_FOUND);
                                                            this.errb.put_str(g"[PREPROCESSOR] Package '\0");
                                                            this.errb.put_n(text + name_off, name_len);
                                                            this.errb.put_str(g"' entrypoint '\0");
                                                            this.errb.put_n(this.jv.mem, this.jv.len);
                                                            this.errb.put_str(g"' not found\0");
                                                            -> false;
                                                        }
                                                            default
                                                            {
                                                                switch (!this.realpath_into(this.jb.mem))
                                                                {
                                                                    case (true) {
                                                                    this.e_begin(PPError.NOT_FOUND);
                                                                    this.errb.put_str(g"[PREPROCESSOR] Package '\0");
                                                                    this.errb.put_n(text + name_off, name_len);
                                                                    this.errb.put_str(g"' entrypoint '\0");
                                                                    this.errb.put_n(this.jv.mem, this.jv.len);
                                                                    this.errb.put_str(g"' not found\0");
                                                                    -> false;
                                                                }
                                                                    default
                                                                    {
                                                                        switch (this.processed.find(this.rbuf.mem, this.rbuf.len) >= 0)
                                                                        {
                                                                            case (true) { -> true; }
                                                                            default
                                                                            {
                                                                                switch (this.verbose)
                                                                                {
                                                                                    case (true) {
                                                                                    this.tmp.clear();
                                                                                    this.tmp.put_str(g"[PREPROCESSOR] Package import: \0");
                                                                                    this.tmp.put_n(text + name_off, name_len);
                                                                                    this.tmp.put_str(g" -> \0");
                                                                                    this.tmp.put_n(this.jv.mem, this.jv.len);
                                                                                    standard::io::console::println(this.tmp.mem);
                                                                                }
                                                                                    default {};
                                                                                };


                                                                                pk = this.pool_add(this.x1.mem, this.x1.len);
                                                                                this.dir_stack.push(pk);
                                                                                this.x2.clear();
                                                                                this.x2.put_n(this.rbuf.mem, this.rbuf.len);
                                                                                switch (!this.process_file(this.x2.mem, this.x2.len, 1))
                                                                                {
                                                                                    case (true) { -> false; }
                                                                                    default
                                                                                    {
                                                                                        this.dir_stack.pop();
                                                                                        -> true;
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };





            process_file(byte* fp_in, int fp_n, int resolver) -> bool
            {
                Buf raw();
                Buf content();
                IntVec loff();
                IntVec llen();
                defer raw.__exit();
                defer content.__exit();
                defer loff.__exit();
                defer llen.__exit();
                LineList ll;

                int fp_off = this.pool.len;
                int k, c, rc, pos, e0, tl, q, lo, hi, ts, te, fid, path_off, dir_off, pl, prev_file, i;
                bool found;

                while (k < fp_n)
                {
                    c = (int)fp_in[k];
                    switch (c == 92 | c == 47)
                    {
                        case (true) { c = 92; }
                        default {};
                    };
                    this.pool.put(c);
                    k++;
                };
                this.pool.put(0);

                switch (resolver)
                {
                    case (1) { found = this.resolve_local(this.pool.mem + fp_off, fp_n); }
                    case (2) { found = this.resolve_stdlib(this.pool.mem + fp_off, fp_n); }
                    default { found = this.resolve_default(this.pool.mem + fp_off, fp_n); };
                };

                switch (!found)
                {
                    case (true) {
                    switch (resolver == 1)
                    {
                        case (true) {
                        switch (this.resolve_stdlib(this.pool.mem + fp_off, fp_n))
                        {
                            case (true) {
                            this.vline(g"[PREPROCESSOR] Could not find local import: \0", this.pool.mem + fp_off, fp_n, g"\0");
                            this.vline(g"#import \"\0", this.pool.mem + fp_off, fp_n, g"\";\0");
                            standard::io::console::println(g"--------^\0");
                            this.vline(g"#import <\0", this.pool.mem + fp_off, fp_n, g">; // try this\0");
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    this.e_begin(PPError.NOT_FOUND);
                    this.errb.put_str(g"Could not find import: \0");
                    this.errb.put_n(this.pool.mem + fp_off, fp_n);
                    -> false;
                }
                    default
                    {
                        switch (this.processed.find(this.rbuf.mem, this.rbuf.len) >= 0)
                        {
                            case (true) { -> true; }
                            default
                            {
                                this.processed.intern(this.rbuf.mem, this.rbuf.len);
                                fid = this.files.len;
                                path_off = this.pool_add(this.rbuf.mem, this.rbuf.len);
                                this.files.push(path_off);
                                pl = pp_parent_len(this.rbuf.mem, this.rbuf.len);
                                dir_off = this.pool_add(this.rbuf.mem, pl);

                                switch (this.verbose)
                                {
                                    case (true) {
                                    this.vline(g"[PREPROCESSOR] Processing: \0", this.pool.mem + fp_off, fp_n, g"\0");
                                }
                                    default {};
                                };

                                rc = raw.load_file(this.pool.mem + path_off);
                                switch (rc < 0)
                                {
                                    case (true) {
                                    this.e_begin(PPError.IO);
                                    this.errb.put_str(g"[PREPROCESSOR] Could not read file: \0");
                                    this.errb.put_str(this.pool.mem + path_off);
                                    -> false;
                                }
                                    default
                                    {
                                        switch (rc == 1)
                                        {
                                            case (true) {
                                            this.vline(g"[PREPROCESSOR] WARNING: '\0", this.pool.mem + path_off, pp_cstrlen(this.pool.mem + path_off),
                                                       g"' contains invalid UTF-8 sequences. Replacement characters (U+FFFD) have been substituted. Save the file as UTF-8 to silence this warning.\0");
                                        }
                                            default {};
                                        };

                                        content.put_stripped(raw.mem, raw.len);
                                        switch (!raw.ok | !content.ok | !this.alloc_ok())
                                        {
                                            case (true) {
                                            this.e_begin(PPError.ALLOC);
                                            this.errb.put_str(g"[PREPROCESSOR] allocation failed\0");
                                            -> false;
                                        }
                                            default
                                            {
                                                while (pos < content.len)
                                                {
                                                    e0 = pp_eol(content.mem, content.len, pos, @tl);
                                                    loff.push(pos);
                                                    llen.push(e0 - pos);
                                                    pos = e0 + tl;
                                                };
                                                ll.text = content.mem;
                                                ll.off = loff.arr;
                                                ll.len = llen.arr;
                                                ll.n = loff.len;


                                                while (q < ll.n)
                                                {
                                                    lo = ll.off[q];
                                                    hi = lo + ll.len[q];
                                                    pp_trim(content.mem, @lo, @hi);
                                                    switch (hi > lo)
                                                    {
                                                        case (true) {
                                                        switch (pp_starts(content.mem, lo, hi, g"#endif;\0", 7) & hi - lo != 7)
                                                        {
                                                            case (true) {
                                                            this.e_begin(PPError.SYNTAX);
                                                            this.errb.put_str(g"[PREPROCESSOR] #endif directive has trailing content after semicolon in \0");
                                                            this.errb.put_n(this.pool.mem + fp_off, fp_n);
                                                            this.errb.put_str(g" at line \0");
                                                            this.errb.put_int(q + 1);
                                                            -> false;
                                                        }
                                                            default {};
                                                        };
                                                        switch (pp_starts(content.mem, lo, hi, g"#import\0", 7) | pp_starts(content.mem, lo, hi, g"#package\0", 8)
                                                            | pp_starts(content.mem, lo, hi, g"#warn\0", 5) | pp_starts(content.mem, lo, hi, g"#stop\0", 5)
                                                            | pp_starts(content.mem, lo, hi, g"#def\0", 4) | pp_starts(content.mem, lo, hi, g"#dir\0", 4))
                                                        {
                                                            case (true) {
                                                            switch (content.mem[hi - 1] != 59)
                                                            {
                                                                case (true) {
                                                                pp_next_tok(content.mem, hi, lo, @ts, @te);
                                                                this.e_begin(PPError.SYNTAX);
                                                                this.errb.put_str(g"[PREPROCESSOR] \0");
                                                                this.errb.put_n(content.mem + ts, te - ts);
                                                                this.errb.put_str(g" directive missing semicolon in \0");
                                                                this.errb.put_n(this.pool.mem + fp_off, fp_n);
                                                                this.errb.put_str(g" at line \0");
                                                                this.errb.put_int(q + 1);
                                                                -> false;
                                                            }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                    q++;
                                                };

                                                prev_file = this.cur_file;
                                                this.cur_file = fid;
                                                this.dir_stack.push(dir_off);
                                                i = 0;
                                                while (i < ll.n)
                                                {
                                                    this.cur_lineno = i + 1;
                                                    i = this.process_line(@ll, i);
                                                    switch (i < 0)
                                                    {
                                                        case (true) { -> false; }
                                                        default {};
                                                    };
                                                };
                                                this.dir_stack.pop();
                                                this.cur_file = prev_file;
                                                -> true;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };




            process_line(LineList* ll, int i) -> int
            {
                byte* text = ll.text;
                int lo = ll.off[i];
                int hi = lo + ll.len[i];
                int s = lo;
                int e = hi;
                int a, b, ts, te, nx, semi, q1, q2, j, k, np, w, tcount;
                int name_off, name_len, paren_open, paren_close, body_off, body_len;
                bool more, have;
                int ent;

                pp_trim(text, @s, @e);

                switch (s >= e)
                {
                    case (true) {
                    this.emit_blank(this.cur_lineno);
                    -> i + 1;
                }
                    default
                    {

                        switch (pp_starts(text, s, e, g"#dir\0", 4))
                        {
                            case (true) {
                            switch (text[e - 1] != 59)
                            {
                                case (true) {
                                this.e_begin(PPError.SYNTAX);
                                this.errb.put_str(g"[PREPROCESSOR] #dir directive missing semicolon at line \0");
                                this.errb.put_int(i + 1);
                                -> -1;
                            }
                                default {};
                            };
                            q1 = pp_find(text, lo, hi, 34);
                            switch (q1 != -1)
                            {
                                case (true) {
                                q2 = pp_find(text, q1 + 1, hi, 34);
                                switch (q2 != -1)
                                {
                                    case (true) {
                                    this.tmp.clear();
                                    j = q1 + 1;
                                    while (j < q2)
                                    {
                                        k = (int)text[j];
                                        switch (k == 92)
                                        {
                                            case (true) { k = 47; }
                                            default {};
                                        };
                                        this.tmp.put(k);
                                        j++;
                                    };
                                    have = false;
                                    k = 0;
                                    while (k < this.lib_dirs.len)
                                    {
                                        switch (pp_cstrlen(this.pool.mem + this.lib_dirs.arr[k]) == this.tmp.len)
                                        {
                                            case (true) {
                                            switch (pp_eq(this.pool.mem + this.lib_dirs.arr[k], this.tmp.mem, this.tmp.len))
                                            {
                                                case (true) { have = true; }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        k++;
                                    };
                                    switch (!have)
                                    {
                                        case (true) {
                                        this.lib_dirs.push(this.pool_add(this.tmp.mem, this.tmp.len));
                                        switch (this.verbose)
                                        {
                                            case (true) {
                                            this.x1.clear();
                                            this.x1.put_n(this.tmp.mem, this.tmp.len);
                                            this.vline(g"[PREPROCESSOR] Added library directory: \0", this.x1.mem, this.x1.len, g"\0");
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                            this.emit_blank(this.cur_lineno);
                            -> i + 1;
                        }
                            default
                            {

                                switch (pp_starts(text, s, e, g"#psub\0", 5))
                                {
                                    case (true) {
                                    a = s + 5;
                                    b = e;
                                    pp_trim(text, @a, @b);
                                    this.psb.clear();
                                    this.psb.put_n(text + a, b - a);
                                    more = true;
                                    while (more)
                                    {
                                        more = false;
                                        switch (this.psb.len > 0)
                                        {
                                            case (true) {
                                            switch (this.psb.mem[this.psb.len - 1] == '#')
                                            {
                                                case (true) { more = true; }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        switch (!more)
                                        {
                                            case (true) { break; }
                                            default {};
                                        };
