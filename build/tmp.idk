            __init(IDKC_SYMTABLE* s) -> this
            {
                this.st = s;
                this.pst = (IDKC_SYMTABLE*)0;
                this.mod = (IRModule*)fmalloc((u64)((sizeof(IRModule) + 7) / 8));
                this.mod.__init(g"IDEKA_module\0");
                this.structs = nm_new();
                this.fwd_hit = false;
                this.rec_fn = false;
                this.retry_mode = false;
                this.ext_fns = pv_new();
                this.tf_ast = nm_new();
                this.tf_pend = pv_new();
                this.tf_drain = false;
                this.unions = nm_new();
                this.enums = nm_new();
                this.aliases = nm_new();
                this.consts = nm_new();
                this.ct_enums = pv_new();
                this.ct_pstmts = (NodeVec*)0;
                this.ct_macros = pv_new();
                this.defined = nm_new();
                this.owned = pv_new();
                this.cur_ns = ts_dup(g"\0");
                this.cur_obj = (byte*)0;
                this.ifc_call = nm_new();
                this.ifc_ret = nm_new();
                this.ifc_pass = nm_new();
                this.byte_width = 8;
                this.nerrors = 0;
                this.err_line = 0;
                this.err_col = 0;
                this.pend_col = 0;
                this.err_msg = (byte*)0;
                this.t_i1 = this.mod.t_int(1);
                this.t_i8 = this.mod.t_int(8);
                this.t_i32 = this.mod.t_int(32);
                this.t_i64 = this.mod.t_int(64);
                this.t_void = this.mod.t_void();
                this.t_float = this.mod.t_float();
                this.t_double = this.mod.t_double();
                this.t_i8p = this.mod.t_ptr(this.t_i8);
                this.al_tmp = 0;
                this.sc.__init();
                this.defers = (PtrVec*)0;
                this.asmb.__init();
                this.asmc.__init();
                this.scopes = pv_new();
                this.fn = (IRFunc*)0;
                this.fnd = (Node*)0;
                this.fret = (IRType*)0;
                this.brk = (IRBlock*)0;
                this.exc_flag = (IRValue*)0;
                this.exc_value = (IRValue*)0;
                this.exc_handler = (IRBlock*)0;
                this.cont = (IRBlock*)0;
                this.bad = false;
                this.bad_what = (byte*)0;
                this.bad_detail = (byte*)0;
                this.skip_log = pv_new();
                this.bad_line = 0;
                this.body_errs = 0;
                this.in_member = false;
                this.nra = (IRValue*)0;
                this.nrb = (IRValue*)0;
                this.lspecs = (TypeSpec**)fmalloc((u64)24 * (u64)((sizeof(TypeSpec*) + 7) / 8));
                this.keep((void*)this.lspecs);
                int li;
                while (li < 24)
                {
                    this.lspecs[li] = (TypeSpec*)0;
                    li++;
                };
                this.ucounts = nm_new();
                this.gvars = nm_new();
                this.untied = nm_new();
                this.dicts = nm_new();
                this.labels = nm_new();
                this.inited_unions = pv_new();
                this.fdefs = nm_new();
                this.nbodies = 0;
                this.nskipped = 0;
                this.cur_fd = (Node*)0;
                this.gcache = nm_new();
                this.nstr = 0;
                this.null_term = false;
                this.ct_v = (i64)0;
                this.ct_k = 0;
                this.enumvals = nm_new();
                this.enum_defs = nm_new();
                this.union_defs = nm_new();
                this.tcache = nm_new();
                this.tids = nm_new();
                this.arr_ptrs = pv_new();
                this.al_names = pv_new();
                this.al_tys = pv_new();
                this.al_specs = pv_new();
                this.al_idx = pv_new();
                this.cur_stmt = 0;
                this.si_closed = false;
                this.pp_consts = (SymTab*)0;
                this.ct_srcfile = (byte*)0;
