                case (NodeKind.BUILD_ENTRY) { return g"BUILD_ENTRY\0"; }
                case (NodeKind.PROGRAM) { return g"PROGRAM\0"; }
                default { return g"UNKNOWN\0"; };
            };
        };

        def operator_text(int o) -> byte*
        {
            switch (o)
            {
                case (Operator.ADD) { return g"+\0"; }
                case (Operator.SUB) { return g"-\0"; }
                case (Operator.INCREMENT) { return g"++\0"; }
                case (Operator.DECREMENT) { return g"--\0"; }
                case (Operator.MUL) { return g"*\0"; }
                case (Operator.DIV) { return g"/\0"; }
                case (Operator.MOD) { return g"%\0"; }
                case (Operator.NOT) { return g"!\0"; }
                case (Operator.POWER) { return g"^\0"; }
                case (Operator.AND) { return g"&\0"; }
                case (Operator.OR) { return g"|\0"; }
                case (Operator.NAND) { return g"!&\0"; }
                case (Operator.NOR) { return g"!|\0"; }
                case (Operator.XOR) { return g"^|\0"; }
                case (Operator.EQUAL) { return g"==\0"; }
                case (Operator.NOT_EQUAL) { return g"!=\0"; }
                case (Operator.LESS_THAN) { return g"<\0"; }
                case (Operator.LESS_EQUAL) { return g"<=\0"; }
                case (Operator.GREATER_THAN) { return g">\0"; }
                case (Operator.GREATER_EQUAL) { return g">=\0"; }
                case (Operator.ASSIGN) { return g"=\0"; }
                case (Operator.PLUS_ASSIGN) { return g"+=\0"; }
                case (Operator.MINUS_ASSIGN) { return g"-=\0"; }
                case (Operator.MULTIPLY_ASSIGN) { return g"*=\0"; }
                case (Operator.DIVIDE_ASSIGN) { return g"/=\0"; }
                case (Operator.MODULO_ASSIGN) { return g"%=\0"; }
                case (Operator.EXPONENT_ASSIGN) { return g"^=\0"; }
                case (Operator.BITNOT) { return g"`!\0"; }
                case (Operator.BITAND) { return g"`&\0"; }
                case (Operator.BITOR) { return g"`|\0"; }
                case (Operator.BITNAND) { return g"`!&\0"; }
                case (Operator.BITNOR) { return g"`!|\0"; }
                case (Operator.BITXOR) { return g"`^|\0"; }
                case (Operator.BITXNOT) { return g"`^|!\0"; }
                case (Operator.BITXNAND) { return g"`^|!&\0"; }
                case (Operator.BITXNOR) { return g"`^|!|\0"; }
                case (Operator.AND_ASSIGN) { return g"&=\0"; }
                case (Operator.OR_ASSIGN) { return g"|=\0"; }
                case (Operator.XOR_ASSIGN) { return g"^|=\0"; }
                case (Operator.BITAND_ASSIGN) { return g"`&=\0"; }
                case (Operator.BITOR_ASSIGN) { return g"`|=\0"; }
                case (Operator.BITNAND_ASSIGN) { return g"`!&=\0"; }
                case (Operator.BITNOR_ASSIGN) { return g"`!|=\0"; }
                case (Operator.BITXOR_ASSIGN) { return g"`^|=\0"; }
                case (Operator.BITXNOT_ASSIGN) { return g"`^|!=\0"; }
                case (Operator.BITXNAND_ASSIGN) { return g"`^|!&=\0"; }
                case (Operator.BITXNOR_ASSIGN) { return g"`^|!|=\0"; }
                case (Operator.BITSHIFT_LEFT) { return g"<<\0"; }
                case (Operator.BITSHIFT_RIGHT) { return g">>\0"; }
                case (Operator.BITSHIFT_LEFT_ASSIGN) { return g"<<=\0"; }
                case (Operator.BITSHIFT_RIGHT_ASSIGN) { return g">>=\0"; }
                case (Operator.ADDRESS_OF) { return g"@\0"; }
                case (Operator.RANGE) { return g"..\0"; }
                case (Operator.SCOPE) { return g"::\0"; }
                case (Operator.QUESTION) { return g"?\0"; }
                case (Operator.COLON) { return g":\0"; }
                case (Operator.TIE) { return g"~\0"; }
                case (Operator.LAMBDA_ARROW) { return g"<:-\0"; }
                case (Operator.RETURN_ARROW) { return g"->\0"; }
                case (Operator.CHAIN_ARROW) { return g"<-\0"; }
                case (Operator.RECURSE_ARROW) { return g"<~\0"; }
                case (Operator.NULL_COALESCE) { return g"??\0"; }
                case (Operator.NO_MANGLE) { return g"!!\0"; }
                case (Operator.FUNCTION_POINTER) { return g"{}*\0"; }
                case (Operator.ADDRESS_CAST) { return g"(@)\0"; }
                default { return g"?\0"; };
            };
        };
    };
};












































































using IDEKA::ast;
using IDEKA::preprocessor;

namespace IDEKA
{
    namespace types
    {


        def datatype_text(int t) -> byte*
        {
            switch (t)
            {
                case (DataType.SINT)     { return g"int\0"; }
                case (DataType.UINT)     { return g"uint\0"; }
                case (DataType.SLONG)    { return g"long\0"; }
                case (DataType.ULONG)    { return g"ulong\0"; }
                case (DataType.FLOAT)    { return g"float\0"; }
                case (DataType.DOUBLE)   { return g"double\0"; }
                case (DataType.CHAR)     { return g"char\0"; }
                case (DataType.BOOL)     { return g"bool\0"; }
                case (DataType.DATA)     { return g"data\0"; }
                case (DataType.BYTE)     { return g"byte\0"; }
                case (DataType.STRUCT)   { return g"struct\0"; }
                case (DataType.ENUM)     { return g"enum\0"; }
                case (DataType.UNION)    { return g"union\0"; }
                case (DataType.OBJECT)   { return g"object\0"; }
                case (DataType.VOID)     { return g"void\0"; }
                case (DataType.THIS)     { return g"this\0"; }
                case (DataType.FUNC_PTR) { return g"def{}*\0"; }
                case (DataType.DICT)     { return g"dict\0"; }
                default                  { return g"?\0"; };
            };
            return g"?\0";
        };



        def builtin_bit_width(int t) -> int
        {
            switch (t)
            {
                case (DataType.SINT)   { return 32; }
                case (DataType.UINT)   { return 32; }
                case (DataType.SLONG)  { return 64; }
                case (DataType.ULONG)  { return 64; }
                case (DataType.FLOAT)  { return 32; }
                case (DataType.DOUBLE) { return 64; }
                case (DataType.CHAR)   { return 8; }
                case (DataType.BYTE)   { return 8; }
                case (DataType.BOOL)   { return 1; }
                case (DataType.VOID)   { return 0; }
                default                { return -1; };
            };
            return -1;
        };



        def infer_int_width(i64 value, int t) -> int
        {
            if (t == DataType.SLONG | t == DataType.ULONG) { return 64; };
            if (t == DataType.SINT)
            {
                if (value >= -2147483648 & value <= 2147483647) { return 32; };
                return 64;
            };
            if (t == DataType.UINT)
            {
                if (value >= 0)
                {
                    if (value <= 4294967295) { return 32; };
                    return 64;
                };
                if (value >= -4294967296) { return 32; };
                return 64;
            };
            return 0;
        };

        def is_integer_base(int t) -> bool
        {
            return t == DataType.SINT | t == DataType.UINT | t == DataType.SLONG |
                   t == DataType.ULONG | t == DataType.CHAR | t == DataType.BYTE |
                   t == DataType.BOOL | t == DataType.DATA;
        };

        def is_float_base(int t) -> bool
        {
            return t == DataType.FLOAT | t == DataType.DOUBLE;
        };

        def is_numeric_base(int t) -> bool
        {
            return is_integer_base(t) | is_float_base(t);
        };

        def is_user_type(TypeSpec* t) -> bool
        {
            return t.custom_typename != (byte*)0;
        };

        def ts_is_pointer(TypeSpec* t) -> bool
        {
            return (t.flags `& 64) != 0;
        };

        def ts_is_array(TypeSpec* t) -> bool
        {
            return (t.flags `& 32) != 0;
        };

        def ts_is_signed(TypeSpec* t) -> bool
        {
            return (t.flags `& 1) != 0;
        };



        def typespec_bit_width(TypeSpec* t) -> int
        {
            if (t.custom_typename != (byte*)0) { return -1; };
            if (t.bit_width > 0) { return t.bit_width; };
            return builtin_bit_width(t.base_type);
        };

        def cstr_eq(byte* a, byte* b) -> bool
        {
            int i;
            if (a == (byte*)0 | b == (byte*)0) { return a == b; };
            while (a[i] == b[i])
            {
                if (a[i] == 0) { return true; };
                i++;
            };
            return false;
        };



        def typespec_equal(TypeSpec* a, TypeSpec* b) -> bool
        {
            if (a == b) { return true; };
            if (a == (TypeSpec*)0 | b == (TypeSpec*)0) { return false; };
            if (a.base_type != b.base_type) { return false; };
            if (!cstr_eq(a.custom_typename, b.custom_typename)) { return false; };
            if (a.pointer_depth != b.pointer_depth) { return false; };
            if (ts_is_pointer(a) != ts_is_pointer(b)) { return false; };
            if (ts_is_array(a) != ts_is_array(b)) { return false; };
            if (a.bit_width != b.bit_width) { return false; };
            if (ts_is_signed(a) != ts_is_signed(b)) { return false; };
            if (a.endianness != b.endianness) { return false; };
            if (a.base_type == DataType.FUNC_PTR)
            {
                if (a.fp_nparams != b.fp_nparams) { return false; };
                if (!typespec_equal(a.fp_ret, b.fp_ret)) { return false; };
                int i;
                while (i < a.fp_nparams)
                {
                    if (!typespec_equal(a.fp_params[i], b.fp_params[i])) { return false; };
                    i++;
                };
            };
            return true;
        };




        def mangle_type(Buf* out, TypeSpec* t) -> void
        {
            byte c;
            int i;
            if (t.custom_typename != (byte*)0)
            {
                i = 0;
                while (t.custom_typename[i] != 0)
                {
                    c = t.custom_typename[i];
                    if (c == ':' | c == '.') { c = '_'; };
                    out.put((int)c);
                    i++;
                };
            }
            else
            {
                out.put_str(datatype_text(t.base_type));
            };

            if (t.endianness == 0) { out.put_str(g"E0\0"); }
            else { out.put_str(g"E1\0"); };

            if (ts_is_array(t))
            {
                out.put_str(g"_arr\0");
                if (t.array_size != (Node*)0)
                {
                    if (t.array_size.kind == NodeKind.LITERAL)
                    {
                        out.put_int((int)t.array_size.ival);
                    };
                };
            };

            if (ts_is_pointer(t))
            {
                out.put_str(f"_ptr{t.pointer_depth}\0");
            };

            if (t.base_type == DataType.DATA & t.bit_width > 0)
            {
                if (ts_is_signed(t)) { out.put_str(g"_sbits\0"); }
                else { out.put_str(g"_ubits\0"); };
                out.put_int(t.bit_width);
            };
            return;
        };


        def mangle_function(Buf* out, byte* base, TypeSpec** params, int n, TypeSpec* ret) -> void
        {
            int i;
            out.put_str(f"{base}__{n}\0");
            while (i < n)
            {
                out.put_str(g"__\0");
                mangle_type(out, params[i]);
                i++;
            };
            out.put_str(g"__ret_\0");
            mangle_type(out, ret);
            return;
        };






        def join3(byte* a, byte* b, byte* c) -> byte*
        {
            int la = pp_cstrlen(a);
            int lb = pp_cstrlen(b);
            int lc = pp_cstrlen(c);
            byte* r = (byte*)fmalloc((u64)(la + lb + lc + 1));
            int i, j, k;
            while (i < la)
            {
                r[i] = a[i];
                i++;
            };
            while (j < lb)
            {
                r[la + j] = b[j];
                j++;
            };
            while (k < lc)
            {
                r[la + lb + k] = c[k];
                k++;
            };
            r[la + lb + lc] = (byte)0;
            return r;
        };


        def join3_f(byte* a, byte* b, byte* c, int mask) -> byte*
        {
            byte* r = join3(a, b, c);
            if ((mask `& 1) != 0) { ffree(a); };
            if ((mask `& 2) != 0) { ffree(b); };
            if ((mask `& 4) != 0) { ffree(c); };
            return r;
        };


        def ts_dup(byte* s) -> byte*
        {
            int n = pp_cstrlen(s);
            byte* r = (byte*)fmalloc((u64)n + (u64)1);
            int i;
            while (i < n)
            {
                r[i] = s[i];
                i++;
            };
            r[n] = (byte)0;
            return r;
        };

        def pv_new() -> PtrVec*
        {
            PtrVec* v = (PtrVec*)fmalloc((u64)(sizeof(PtrVec) / 8));
            v.len = 0;
            v.cap = 8;
            v.items = (void**)fmalloc((u64)v.cap * (u64)(sizeof(void*) / 8));
            return v;
        };

        def pv_push(PtrVec* v, void* p) -> void
        {
            if (v.len >= v.cap)
            {
                int nc = v.cap * 2;
                u64 np = frealloc((u64)v.items, (size_t)((u64)nc * (u64)(sizeof(void*) / 8)));
                v.items = (void**)np;
                v.cap = nc;
            };
            v.items[v.len] = p;
            v.len++;
            return;
        };

        def pv_insert(PtrVec* v, int at, void* p) -> void
        {
            int i;
            pv_push(v, p);
            i = v.len - 1;
            while (i > at)
            {
                v.items[i] = v.items[i - 1];
                i--;
            };
            v.items[at] = p;
            return;
        };

        def pv_free(PtrVec* v) -> void
        {
            if (v == (PtrVec*)0) { return; };
            ffree((byte*)v.items);
            ffree((byte*)v);
            return;
        };


        def sv_has(PtrVec* v, byte* s) -> bool
        {
            int i;
            while (i < v.len)
            {
                if (cstr_eq((byte*)v.items[i], s)) { return true; };
                i++;
            };
            return false;
        };


        def sv_add(PtrVec* v, byte* s) -> void
        {
            if (sv_has(v, s)) { return; };
            pv_push(v, (void*)ts_dup(s));
            return;
        };

        def sv_free(PtrVec* v) -> void
        {
            int i;
            while (i < v.len)
            {
                ffree((byte*)v.items[i]);
                i++;
            };
            pv_free(v);
            return;
        };

        def nm_hash(byte* s) -> u64
        {
            return pp_hash(s, pp_cstrlen(s));
        };

        def nm_new() -> NameMap*
        {
            NameMap* m = (NameMap*)fmalloc((u64)(sizeof(NameMap) / 8));
            m.count = 0;
            m.ent_cap = 16;
            m.slot_cap = 64;
            m.keys = (byte**)fmalloc((u64)m.ent_cap * (u64)(sizeof(byte*) / 8));
            m.vals = (void**)fmalloc((u64)m.ent_cap * (u64)(sizeof(void*) / 8));
            m.slots = (int*)fmalloc((u64)m.slot_cap * (u64)(sizeof(int) / 8));
            int z;
            while (z < m.slot_cap)
            {
                m.slots[z] = 0;
                z++;
            };
            return m;
        };

        def nm_free(NameMap* m) -> void
        {
            if (m == (NameMap*)0) { return; };
            int i;
            while (i < m.count)
            {
                ffree(m.keys[i]);
                i++;
            };
            ffree((byte*)m.keys);
            ffree((byte*)m.vals);
            ffree((byte*)m.slots);
            ffree((byte*)m);
            return;
        };


        def nm_find(NameMap* m, byte* key) -> int
        {
            int idx = (int)(nm_hash(key) % (u64)m.slot_cap);
            int e;
            while (true)
            {
                e = m.slots[idx];
                if (e == 0) { return -1; };
                e = e - 1;
                if (cstr_eq(m.keys[e], key)) { return e; };
                idx++;
                if (idx >= m.slot_cap) { idx = 0; };
            };
            return -1;
        };

        def nm_place(NameMap* m, int e) -> void
        {
            int idx = (int)(nm_hash(m.keys[e]) % (u64)m.slot_cap);
            while (m.slots[idx] != 0)
            {
                idx++;
                if (idx >= m.slot_cap) { idx = 0; };
            };
            m.slots[idx] = e + 1;
            return;
        };

        def nm_rehash(NameMap* m) -> void
        {
            int nc = m.slot_cap * 2;
            ffree((byte*)m.slots);
            m.slots = (int*)fmalloc((u64)nc * (u64)(sizeof(int) / 8));
            m.slot_cap = nc;
            int z, e;
            while (z < nc)
            {
                m.slots[z] = 0;
                z++;
            };
            while (e < m.count)
            {
                nm_place(m, e);
                e++;
            };
            return;
        };

        def nm_get(NameMap* m, byte* key) -> void*
        {
            int e = nm_find(m, key);
            if (e < 0) { return (void*)0; };
            return m.vals[e];
        };

        def nm_has(NameMap* m, byte* key) -> bool
        {
            return nm_get(m, key) != (void*)0;
        };

        def nm_put(NameMap* m, byte* key, void* v) -> void
        {
            int e = nm_find(m, key);
            if (e >= 0)
            {
                m.vals[e] = v;
                return;
            };
            if (m.count >= m.ent_cap)
            {
                int nc = m.ent_cap * 2;
                u64 nk = frealloc((u64)m.keys, (size_t)((u64)nc * (u64)(sizeof(byte*) / 8)));
                u64 nv = frealloc((u64)m.vals, (size_t)((u64)nc * (u64)(sizeof(void*) / 8)));
                m.keys = (byte**)nk;
                m.vals = (void**)nv;
                m.ent_cap = nc;
            };
            if ((m.count + 1) * 2 > m.slot_cap) { nm_rehash(m); };
            m.keys[m.count] = ts_dup(key);
            m.vals[m.count] = v;
            nm_place(m, m.count);
            m.count++;
            return;
        };


        def nm_del(NameMap* m, byte* key) -> bool
        {
            int e = nm_find(m, key);
            if (e < 0) { return false; };
            if (m.vals[e] == (void*)0) { return false; };
            m.vals[e] = (void*)0;
            return true;
        };






        def has_scope_sep(byte* s) -> bool
        {
            int i;
            while (s[i] != 0)
            {
                if (s[i] == ':' & s[i + 1] == ':') { return true; };
                i++;
            };
            return false;
        };


        def colons_to_underscores(byte* s) -> byte*
        {
            byte* r = ts_dup(s);
            int i;
            while (r[i] != 0)
            {
                if (r[i] == ':' & r[i + 1] == ':')
                {
                    r[i] = '_';
                    r[i + 1] = '_';
                    i++;
                };
                i++;
            };
            return r;
        };



        def mangle_namespace_name(byte* ns, byte* name) -> byte*
        {
            if (ns == (byte*)0) { return ts_dup(name); };
            if (ns[0] == 0) { return ts_dup(name); };
            byte* a = colons_to_underscores(ns);
            int la = pp_cstrlen(a);
            int lb = pp_cstrlen(name);
            byte* r = (byte*)fmalloc((u64)(la + lb + 3));
            int i, j;
            while (i < la)
            {
                r[i] = a[i];
                i++;
            };
            r[i] = '_';
            r[i + 1] = '_';
            i = i + 2;
            while (j < lb)
            {
                r[i + j] = name[j];
                j++;
            };
            r[i + lb] = (byte)0;
            ffree(a);
            return r;
        };


        def namespace_parent(byte* ns) -> byte*
        {
            int n = pp_cstrlen(ns);
            int i = n - 1;
            byte* r;
            int j;
            while (i > 0)
            {
                if (ns[i] == ':' & ns[i - 1] == ':')
                {
                    r = (byte*)fmalloc((u64)i);
                    while (j < i - 1)
                    {
                        r[j] = ns[j];
                        j++;
                    };
                    r[i - 1] = (byte)0;
                    return r;
                };
                i--;
            };
            byte* e = (byte*)fmalloc((u64)1);
            e[0] = (byte)0;
            return e;
        };






        def symkind_text(int k) -> byte*
        {
            switch (k)
            {
                case (SymbolKind.TYPE)      { return ts_dup(g"type\0"); }
                case (SymbolKind.VARIABLE)  { return ts_dup(g"variable\0"); }
                case (SymbolKind.FUNCTION)  { return ts_dup(g"function\0"); }
                case (SymbolKind.NAMESPACE) { return ts_dup(g"namespace\0"); }
                case (SymbolKind.OBJECT)    { return ts_dup(g"object\0"); }
                case (SymbolKind.STRUCT)    { return ts_dup(g"struct\0"); }
                case (SymbolKind.UNION)     { return ts_dup(g"union\0"); }
                case (SymbolKind.ENUM)      { return ts_dup(g"enum\0"); }
                case (SymbolKind.TRAIT)     { return ts_dup(g"trait\0"); }
                case (SymbolKind.OPERATOR)  { return ts_dup(g"operator\0"); }
                case (SymbolKind.INTERFACE) { return ts_dup(g"interface\0"); }
                default                     { return ts_dup(g"\0"); };
            };
            return ts_dup(g"\0");
        };


        def sym_mangled(IDKC_SYMENTRY* e) -> byte*
        {
            return mangle_namespace_name(e.ns, e.name);
        };


        def sym_full_name(IDKC_SYMENTRY* e) -> byte*
        {
            if (e.ns[0] == 0) { return ts_dup(e.name); };
            int la = pp_cstrlen(e.ns);
            int lb = pp_cstrlen(e.name);
            byte* r = (byte*)fmalloc((u64)(la + lb + 3));
            int i, j;
            while (i < la)
            {
                r[i] = e.ns[i];
                i++;
            };
            r[i] = ':';
            r[i + 1] = ':';
            i = i + 2;
            while (j < lb)
            {
                r[i + j] = e.name[j];
                j++;
            };
            r[i + lb] = (byte)0;
            return r;
        };


        struct Overload
        {
            byte* mangled;
            Node* func;
            TypeSpec** params;
            int nparams;
            TypeSpec* ret;
            bool deprecated;
        };


        def typespec_clone(TypeSpec* s) -> TypeSpec*
        {
            TypeSpec* t = typespec_new();
            t.base_type = s.base_type;
            t.flags = s.flags;
            t.bit_width = s.bit_width;
            t.alignment = s.alignment;
            t.endianness = s.endianness;
            t.pointer_depth = s.pointer_depth;
            t.storage_class = s.storage_class;
            t.dict_capacity = s.dict_capacity;
            t.fp_nparams = s.fp_nparams;
            t.array_size = s.array_size;
            t.array_dims = s.array_dims;
            t.array_elem = s.array_elem;
            t.dict_key = s.dict_key;
            t.dict_value = s.dict_value;
            t.fp_ret = s.fp_ret;
            t.fp_params = s.fp_params;
            t.custom_typename = s.custom_typename;
            t.calling_conv = s.calling_conv;
            return t;
        };




        def st_new() -> IDKC_SYMTABLE*
        {
            IDKC_SYMTABLE* st = (IDKC_SYMTABLE*)fmalloc((u64)(sizeof(IDKC_SYMTABLE) / 8));
            st.entries = 0;
        st.entry = (IDKC_SYMENTRY*)0;
        st.scopes = pv_new();
            st.owned = pv_new();
            st.owned_ts = pv_new();
            st.using_ns = pv_new();
            st.registered_ns = pv_new();
            st.overload_lists = pv_new();
            st.globals = nm_new();
            st.overloads = nm_new();
            st.nofunc = nm_new();
            st.current_ns = ts_dup(g"\0");
            pv_push(st.scopes, (void*)nm_new());
            return st;
        };

        def st_free(IDKC_SYMTABLE* st) -> void
        {
            int i, j;
            IDKC_SYMENTRY* e;
            PtrVec* ol;
            Overload* o;
            while (i < st.scopes.len)
            {
                nm_free((NameMap*)st.scopes.items[i]);
                i++;
            };
            i = 0;
            while (i < st.owned.len)
            {
                e = (IDKC_SYMENTRY*)st.owned.items[i];
                ffree(e.name);
                ffree(e.kind);
                ffree(e.ns);
                ffree((byte*)e);
                i++;
            };
            i = 0;
            while (i < st.owned_ts.len)
            {
                ffree((byte*)st.owned_ts.items[i]);
                i++;
            };
            i = 0;
            while (i < st.overload_lists.len)
            {
                ol = (PtrVec*)st.overload_lists.items[i];
                j = 0;
                while (j < ol.len)
                {
                    o = (Overload*)ol.items[j];
                    ffree(o.mangled);
                    ffree((byte*)o.params);
                    ffree((byte*)o);
                    j++;
                };
                pv_free(ol);
                i++;
            };
            pv_free(st.scopes);
            pv_free(st.owned);
            pv_free(st.owned_ts);
            pv_free(st.overload_lists);
            sv_free(st.using_ns);
            sv_free(st.registered_ns);
            nm_free(st.globals);
            nm_free(st.overloads);
            nm_free(st.nofunc);
            ffree(st.current_ns);
            ffree((byte*)st);
            return;
        };


        def st_scope_level(IDKC_SYMTABLE* st) -> int
        {
            return st.scopes.len - 1;
        };

        def st_is_global_scope(IDKC_SYMTABLE* st) -> bool
        {
            return st.scopes.len == 1;
        };

        def st_enter_scope(IDKC_SYMTABLE* st) -> void
        {
            pv_push(st.scopes, (void*)nm_new());
            return;
        };

        def st_exit_scope(IDKC_SYMTABLE* st) -> void
        {
            if (st.scopes.len > 1)
            {
                st.scopes.len--;
                nm_free((NameMap*)st.scopes.items[st.scopes.len]);
            };
            return;
        };

        def st_set_namespace(IDKC_SYMTABLE* st, byte* ns) -> void
        {
            ffree(st.current_ns);
            st.current_ns = ts_dup(ns);
            if (ns[0] != 0) { sv_add(st.registered_ns, ns); };
            return;
        };

        def st_add_using_namespace(IDKC_SYMTABLE* st, byte* ns) -> void
        {
            sv_add(st.using_ns, ns);
            return;
        };

        def st_remove_using_namespace(IDKC_SYMTABLE* st, byte* ns) -> void
        {
            int i;
            while (i < st.using_ns.len)
            {
                if (cstr_eq((byte*)st.using_ns.items[i], ns))
                {
                    ffree((byte*)st.using_ns.items[i]);
                    st.using_ns.items[i] = st.using_ns.items[st.using_ns.len - 1];
                    st.using_ns.len--;
                    return;
                };
                i++;
            };
            return;
        };

        def st_register_namespace(IDKC_SYMTABLE* st, byte* ns) -> void
        {
            sv_add(st.registered_ns, ns);
            return;
        };

        def st_mark_nofunc(IDKC_SYMTABLE* st, byte* type_name) -> void
        {
            nm_put(st.nofunc, type_name, (void*)st);
            return;
        };

        def st_is_nofunc(IDKC_SYMTABLE* st, byte* type_name) -> bool
        {
            return nm_has(st.nofunc, type_name);
        };



        def st_define(IDKC_SYMTABLE* st, byte* name, int kind, TypeSpec* ts, Node* node) -> IDKC_SYMENTRY*
        {
            IDKC_SYMENTRY* e = (IDKC_SYMENTRY*)fmalloc((u64)(sizeof(IDKC_SYMENTRY) / 8));
            e.kind_id = kind;
            e.kind = symkind_text(kind);
            e.flags = 0;
            e.name = ts_dup(name);
            if (st.scopes.len == 1) { e.ns = ts_dup(st.current_ns); }
            else { e.ns = ts_dup(g"\0"); };
            e.ts = (void*)ts;
            e.node = (void*)node;
            pv_push(st.owned, (void*)e);

            nm_put((NameMap*)st.scopes.items[st.scopes.len - 1], name, (void*)e);

            if (st.scopes.len == 1)
            {
                byte* m = sym_mangled(e);
                nm_put(st.globals, m, (void*)e);
                ffree(m);
                if (!nm_has(st.globals, name)) { nm_put(st.globals, name, (void*)e); };
            };
            return e;
        };



        def st_resolve_with_namespaces(IDKC_SYMTABLE* st, byte* name, byte* cur) -> IDKC_SYMENTRY*
        {
            void* r;
            byte* m;
            int i;


            if (has_scope_sep(name))
            {
                m = colons_to_underscores(name);
                r = nm_get(st.globals, m);
                ffree(m);
                if (r != (void*)0) { return (IDKC_SYMENTRY*)r; };
            };


            r = nm_get(st.globals, name);
            if (r != (void*)0) { return (IDKC_SYMENTRY*)r; };


            if (cur[0] != 0)
            {
                m = mangle_namespace_name(cur, name);
                r = nm_get(st.globals, m);
                ffree(m);
                if (r != (void*)0) { return (IDKC_SYMENTRY*)r; };


                byte* walk = ts_dup(cur);
                byte* p;
                bool more = true;
                while (more)
                {
                    more = has_scope_sep(walk);
                    p = namespace_parent(walk);
                    m = mangle_namespace_name(p, name);
                    r = nm_get(st.globals, m);
                    ffree(m);
                    ffree(walk);
                    walk = p;
                    if (r != (void*)0)
                    {
                        ffree(walk);
                        return (IDKC_SYMENTRY*)r;
                    };
                };
                ffree(walk);
            };


            while (i < st.using_ns.len)
            {
                m = mangle_namespace_name((byte*)st.using_ns.items[i], name);
                r = nm_get(st.globals, m);
                ffree(m);
                if (r != (void*)0) { return (IDKC_SYMENTRY*)r; };
                i++;
            };


            i = 0;
            while (i < st.registered_ns.len)
            {
                m = mangle_namespace_name((byte*)st.registered_ns.items[i], name);
                r = nm_get(st.globals, m);
                ffree(m);
                if (r != (void*)0) { return (IDKC_SYMENTRY*)r; };
                i++;
            };
            return (IDKC_SYMENTRY*)0;
        };


        def st_lookup_any(IDKC_SYMTABLE* st, byte* name, byte* cur) -> IDKC_SYMENTRY*
        {
            if (cur == (byte*)0) { cur = st.current_ns; };
            int i = st.scopes.len - 1;
            void* r;
            while (i >= 0)
            {
                r = nm_get((NameMap*)st.scopes.items[i], name);
                if (r != (void*)0) { return (IDKC_SYMENTRY*)r; };
                i--;
            };
            return st_resolve_with_namespaces(st, name, cur);
        };

        def st_lookup_type(IDKC_SYMTABLE* st, byte* name, byte* cur) -> IDKC_SYMENTRY*
        {
            IDKC_SYMENTRY* e = st_lookup_any(st, name, cur);
            if (e == (IDKC_SYMENTRY*)0) { return e; };
            if (e.kind_id == SymbolKind.TYPE | e.kind_id == SymbolKind.STRUCT | e.kind_id == SymbolKind.OBJECT |
                e.kind_id == SymbolKind.UNION | e.kind_id == SymbolKind.ENUM) { return e; };
            return (IDKC_SYMENTRY*)0;
        };

        def st_lookup_variable(IDKC_SYMTABLE* st, byte* name, byte* cur) -> IDKC_SYMENTRY*
        {
            IDKC_SYMENTRY* e = st_lookup_any(st, name, cur);
            if (e == (IDKC_SYMENTRY*)0) { return e; };
            if (e.kind_id == SymbolKind.VARIABLE) { return e; };
            return (IDKC_SYMENTRY*)0;
        };

        def st_lookup_function(IDKC_SYMTABLE* st, byte* name, byte* cur) -> IDKC_SYMENTRY*
        {
            IDKC_SYMENTRY* e = st_lookup_any(st, name, cur);
            if (e == (IDKC_SYMENTRY*)0) { return e; };
            if (e.kind_id == SymbolKind.FUNCTION) { return e; };
            return (IDKC_SYMENTRY*)0;
        };

        def st_get_type_spec(IDKC_SYMTABLE* st, byte* name) -> TypeSpec*
        {
            IDKC_SYMENTRY* e = st_lookup_any(st, name, (byte*)0);
            if (e == (IDKC_SYMENTRY*)0) { return (TypeSpec*)0; };
            return (TypeSpec*)e.ts;
        };


        def st_delete_variable(IDKC_SYMTABLE* st, byte* name) -> bool
        {
            return nm_del((NameMap*)st.scopes.items[st.scopes.len - 1], name);
        };



        def st_register_function_overload(IDKC_SYMTABLE* st, byte* base, byte* mangled, TypeSpec** ptypes, int n,
                                       TypeSpec* ret, Node* fn, bool deprecated) -> Overload*
        {
            PtrVec* list = (PtrVec*)nm_get(st.overloads, base);
            if (list == (PtrVec*)0)
            {
                list = pv_new();
                pv_push(st.overload_lists, (void*)list);
                nm_put(st.overloads, base, (void*)list);
            };

            Overload* o = (Overload*)fmalloc((u64)(sizeof(Overload) / 8));
            o.mangled = ts_dup(mangled);
            o.func = fn;
            o.nparams = n;
            o.ret = ret;
            o.deprecated = deprecated;
            o.params = (TypeSpec**)fmalloc((u64)(n + 1) * (u64)(sizeof(TypeSpec*) / 8));

            int i;
            TypeSpec* p;
            IDKC_SYMENTRY* al;
            TypeSpec* c;
            while (i < n)
            {
                p = ptypes[i];
                if (p.custom_typename != (byte*)0)
                {
                    al = st_lookup_type(st, p.custom_typename, (byte*)0);
                    if (al != (IDKC_SYMENTRY*)0)
                    {
                        if (al.kind_id == SymbolKind.TYPE & (TypeSpec*)al.ts != (TypeSpec*)0)
                        {
                            if (ts_is_signed((TypeSpec*)al.ts) != ts_is_signed(p))
                            {
                                c = typespec_clone(p);
                                if (ts_is_signed((TypeSpec*)al.ts)) { c.flags = c.flags `| 1; }
                                else { c.flags = c.flags - 1; };
                                pv_push(st.owned_ts, (void*)c);
                                p = c;
                            };
                        };
                    };
                };
                o.params[i] = p;
                i++;
            };
            pv_push(list, (void*)o);
            return o;
        };


        def st_overloads_of(IDKC_SYMTABLE* st, byte* base) -> PtrVec*
        {
            return (PtrVec*)nm_get(st.overloads, base);
        };
    };
};





































using IDEKA::ast;
using IDEKA::preprocessor;
using IDEKA::types;

namespace IDEKA
{
    namespace check
    {

        enum Severity
        {
            ERROR,
            WARNING
        };

        struct Diag
        {
            int severity, line, col;
            byte* msg;
        };






        bw(TypeSpec* t) -> int
        {
            switch (t == (TypeSpec*)0)
            {
                case (true) { -> 0; }
                default
                {
                    switch (t.bit_width > 0)
                    {
                        case (true) { -> t.bit_width; }
                        default
                        {
                            int w = builtin_bit_width(t.base_type);
                            switch (w < 0)
                            {
                                case (true) { -> 0; }
                                default
                                {
                                    -> w;
                                };
                            };
                        };
                    };
                };
            };
        };


        types_compatible(TypeSpec* a, TypeSpec* b) -> bool
        {
            switch (ts_is_pointer(a) != ts_is_pointer(b))
            {
                case (true) { -> false; }
                default
                {
                    switch (ts_is_pointer(a) & a.pointer_depth != b.pointer_depth)
                    {
                        case (true) { -> false; }
                        default
                        {
                            int aw, bw_;
                            switch (a.bit_width > 0)
                            {
                                case (true) { aw = a.bit_width; }
                                default {};
                            };
                            switch (b.bit_width > 0)
                            {
                                case (true) { bw_ = b.bit_width; }
                                default {};
                            };
                            switch (aw!? & bw_!? & aw != bw_)
                            {
                                case (true) { -> false; }
                                default
                                {
                                    -> true;
                                };
                            };
                        };
                    };
                };
            };
        };


        ts_matches(TypeSpec* concrete, TypeSpec* allowed) -> bool
        {
            switch (concrete.base_type == DataType.OBJECT & allowed.base_type == DataType.DATA &
                allowed.custom_typename != (byte*)0)
            {
                case (true) { -> true; }
                default
                {
                    switch (concrete.base_type != allowed.base_type)
                    {
                        case (true) { -> false; }
                        default
                        {
                            switch (ts_is_pointer(concrete) != ts_is_pointer(allowed))
                            {
                                case (true) { -> false; }
                                default
                                {
                                    switch (concrete.pointer_depth != allowed.pointer_depth)
                                    {
                                        case (true) { -> false; }
                                        default
                                        {
                                            switch (ts_is_array(concrete) != ts_is_array(allowed))
                                            {
                                                case (true) { -> false; }
                                                default
                                                {
                                                    switch (!cstr_eq(concrete.custom_typename, allowed.custom_typename))
                                                    {
                                                        case (true) { -> false; }
                                                        default
                                                        {
                                                            switch (allowed.bit_width > 0 & concrete.bit_width > 0 & concrete.bit_width != allowed.bit_width)
                                                            {
                                                                case (true) {
                                                                -> false;
                                                            }
                                                                default
                                                                {
                                                                    -> true;
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };


        collect_nodes(Node* n, PtrVec* out) -> void
        {
            switch (n == (Node*)0)
            {
                case (true) { ->; }
                default
                {
                    pv_push(out, (void*)n);
                    collect_nodes(n.a, out);
                    collect_nodes(n.b, out);
                    collect_nodes(n.c, out);
                    collect_nodes(n.d, out);
                    collect_nodes(n.e, out);
                    int s, i, cnt;
                    while (s < 6)
                    {
                        cnt = node_count(n, s);
                        i = 0;
                        while (i < cnt)
                        {
                            collect_nodes(node_child(n, s, i), out);
                            i++;
                        };
                        s++;
                    };
                    ->;
                };
            };
        };




        object Checker
        {
            IDKC_SYMTABLE* st;
            PtrVec* diags;      
            PtrVec* tmp_ts;     
            Buf mb;             
            int errors, warnings;
            int decls;          
            bool warn_implicit; 

            __init(IDKC_SYMTABLE* table) -> this
            {
                this.st = table;
                this.diags = pv_new();
                this.tmp_ts = pv_new();
                this.mb.__init();
                this.errors = 0;
                this.warnings = 0;
                this.decls = 0;
                this.warn_implicit = false;
                -> this;
            };

            __expr() -> Checker* -> this;

            __exit() -> void
            {
                int i;
                Diag* d;
                while (i < this.diags.len)
                {
                    d = (Diag*)this.diags.items[i];
                    ffree(d.msg);
                    ffree((byte*)d);
                    i++;
                };
                i = 0;
                while (i < this.tmp_ts.len)
                {
                    ffree((byte*)this.tmp_ts.items[i]);
                    i++;
                };
                pv_free(this.diags);
                pv_free(this.tmp_ts);
                -> this.mb.__exit();
            };

            clear_msg() -> void
            {
                this.mb.len = 0;
                switch (this.mb.mem != (byte*)0)
                {
                    case (true) { this.mb.mem[0] = (byte)0; }
                    default {};
                };
                ->;
            };


            emit(int severity, int line, int col) -> void
            {
                Diag* d = (Diag*)fmalloc((u64)(sizeof(Diag) / 8));
                d.severity = severity;
                d.line = line;
                d.col = col;
                d.msg = ts_dup(this.mb.mem);
                pv_push(this.diags, (void*)d);
                switch (severity)
                {
                    case (Severity.ERROR) { this.errors++; }
                    default { this.warnings++; };
                };
                ->;
            };


            put_type(TypeSpec* t) -> void
            {
                switch (t == (TypeSpec*)0)
                {
                    case (true) {
                    -> this.mb.put_str(g"?\0");
                }
                    default
                    {
                        -> mangle_type(@this.mb, t);
                    };
                };
            };


            put_type_clause(byte* lname, byte* rname, TypeSpec* l, TypeSpec* r) -> void
            {
                bool same = cstr_eq(lname, rname);
                switch (!same)
                {
                    case (true) {

                    int mark = this.mb.len;
                    this.put_type(l);
                    int la = this.mb.len - mark;
                    this.put_type(r);
                    int lb = this.mb.len - mark - la;
                    switch (la == lb)
                    {
                        case (true) {
                        same = true;
                        int k;
                        while (k < la)
                        {
                            switch (this.mb.mem[mark + k] != this.mb.mem[mark + la + k])
                            {
                                case (true) { same = false; }
                                default {};
                            };
                            k++;
                        };
                    }
                        default {};
                    };
                    this.mb.len = mark;
                    this.mb.mem[mark] = (byte)0;
                }
                    default {};
                };
                this.put_type(l);
                switch (!same)
                {
                    case (true) {
                    this.mb.put_str(g" and \0");
                    this.put_type(r);
                }
                    default {};
                };
                ->;
            };


            type_of(Node* e, NameMap* locals) -> TypeSpec*
            {
                switch (e == (Node*)0)
                {
                    case (true) { -> (TypeSpec*)0; }
                    default
                    {
                        switch (e.kind == NodeKind.CAST_EXPRESSION | e.kind == NodeKind.TYPE_CONVERT_EXPRESSION)
                        {
                            case (true) {
                            -> e.ts;
                        }
                            default
                            {
                                switch (e.kind == NodeKind.IDENTIFIER)
                                {
                                    case (true) {
                                    switch (e.text == (byte*)0)
                                    {
                                        case (true) { -> (TypeSpec*)0; }
                                        default {};
                                    };
                                    -> (TypeSpec*)nm_get(locals, e.text);
                                }
                                    default
                                    {
                                        switch (e.kind == NodeKind.LITERAL)
                                        {
                                            case (true) {
                                            TypeSpec* t = typespec_new();
                                            t.base_type = e.op;
                                            switch (e.op == DataType.SINT | e.op == DataType.SLONG | e.op == DataType.CHAR |
                                                e.op == DataType.FLOAT | e.op == DataType.DOUBLE)
                                            {
                                                case (true) {
                                                t.flags = 1;
                                            }
                                                default {};
                                            };
                                            pv_push(this.tmp_ts, (void*)t);
                                            -> t;
                                        }
                                            default
                                            {
                                                -> (TypeSpec*)0;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            collect_locals(Node* fn, PtrVec* nodes, NameMap* locals) -> void
            {
                int i, cnt;
                Node* p;
                cnt = node_count(fn, 0);
                while (i < cnt)
                {
                    p = node_child(fn, 0, i);
                    switch (p.text != (byte*)0 & p.ts != (TypeSpec*)0)
                    {
                        case (true) { nm_put(locals, p.text, (void*)p.ts); }
                        default {};
                    };
                    i++;
                };
                i = 0;
                while (i < nodes.len)
                {
                    p = (Node*)nodes.items[i];
                    switch (p.kind == NodeKind.VARIABLE_DECLARATION & p.text != (byte*)0 & p.ts != (TypeSpec*)0)
                    {
                        case (true) {
                        nm_put(locals, p.text, (void*)p.ts);
                    }
                        default {};
                    };
                    i++;
                };
                ->;
            };


            width_constrained(int w, TypeSpec* lts, TypeSpec* rts) -> bool -> w == bw(lts) | w == bw(rts);


            report_width(Node* at, byte* op, byte* lname, byte* rname, TypeSpec* lts, TypeSpec* rts,
                             bool is_trunc, bool between) -> void
            {
                this.clear_msg();
                this.mb.put_str(f"Type relation {lname} {op} {rname} violated: illegal \0");
                switch (is_trunc)
                {
                    case (true) { this.mb.put_str(g"truncation \0"); }
                    default { this.mb.put_str(g"widening \0"); };
                };
                switch (between)
                {
                    case (true) { this.mb.put_str(g"between \0"); }
                    default { this.mb.put_str(g"on \0"); };
                };
                this.put_type_clause(lname, rname, lts, rts);
                -> this.emit(Severity.ERROR, at.line, at.col);
            };


            check_width_relation(Node* fn, PtrVec* nodes, NameMap* locals, byte* op,
                                     byte* lname, byte* rname, TypeSpec* lts, TypeSpec* rts) -> void
            {
                bool between = cstr_eq(op, g"!`<=\0") | cstr_eq(op, g"!`>=\0");
                bool is_trunc = cstr_eq(op, g"!`<\0") | cstr_eq(op, g"!`<=\0");
                int i, src_w, dst_w, lw, rw, result_w, max_w, expr_w, ret_w;
                bool violated, src_match, dst_match;
                Node* n;
                TypeSpec* s;
                TypeSpec* d;
                TypeSpec* ls;
                TypeSpec* rs;

                while (i < nodes.len)
                {
                    n = (Node*)nodes.items[i];
                    i++;
                    violated = false;

                    switch (n.kind == NodeKind.CAST_EXPRESSION | n.kind == NodeKind.TYPE_CONVERT_EXPRESSION)
                    {
                        case (true) {
                        s = this.type_of(n.a, locals);
                        d = n.ts;
                        src_w = bw(s);
                        dst_w = bw(d);
                        switch (src_w == 0 | dst_w == 0)
                        {
                            case (true) { continue; }
                            default
                            {
                                                       switch (is_trunc)
                                                       {
                                                           case (true) { switch (dst_w >= src_w)
                                {
                                    case (true) { continue; }
                                    default {};
                                }; }
                                                           default { switch (dst_w <= src_w)
                                {
                                    case (true) { continue; }
                                    default {};
                                }; };
                                                       };
                                                       src_match = this.width_constrained(src_w, lts, rts);
                                                       dst_match = this.width_constrained(dst_w, lts, rts);
                                                       switch (between)
                                                       {
                                                           case (true) { violated = src_match & dst_match; }
                                                           default { violated = src_match | dst_match; };
                                                       };
                            };
                        };
                    }
                        default {
                        switch (n.kind)
                        {
                            case (NodeKind.BINARY_OP)
                            {
                                ls = this.type_of(n.a, locals);
                                rs = this.type_of(n.b, locals);
                                lw = bw(ls);
                                rw = bw(rs);
                                switch (lw == 0 | rw == 0)
                                {
                                    case (true) { continue; }
                                    default
                                    {
                                        result_w = lw;
                                        max_w = rw;
                                        switch (rw < lw)
                                        {
                                            case (true) {
                                            result_w = rw;
                                            max_w = lw;
                                        }
                                            default {};
                                        };
                                        switch (result_w == max_w)
                                        {
                                            case (true) { continue; }
                                            default
                                            {


                                                switch (!is_trunc)
                                                {
                                                    case (true) { continue; }
                                                    default
                                                    {
                                                        src_match = this.width_constrained(result_w, lts, rts);
                                                        dst_match = this.width_constrained(max_w, lts, rts);
                                                        switch (between)
                                                        {
                                                            case (true) { violated = src_match & dst_match; }
                                                            default { violated = src_match | dst_match; };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            }
                            case (NodeKind.RETURN_STATEMENT)
                            {
                                switch (n.a == (Node*)0)
                                {
                                    case (true) { continue; }
                                    default
                                    {
                                                                       s = this.type_of(n.a, locals);
                                                                       switch (s == (TypeSpec*)0 & n.a.kind == NodeKind.BINARY_OP)
                                                                       {
                                                                           case (true) {
                                                                           ls = this.type_of(n.a.a, locals);
                                                                           rs = this.type_of(n.a.b, locals);
                                                                           lw = bw(ls);
                                                                           rw = bw(rs);
                                                                           expr_w = lw;
                                                                           switch (rw > lw)
                                                                           {
                                                                               case (true) { expr_w = rw; }
                                                                               default {};
                                                                           };
                                                                           switch (lw == 0 | rw == 0)
                                                                           {
                                                                               case (true) { expr_w = 0; }
                                                                               default {};
                                                                           };
                                                                       }
                                                                           default { expr_w = bw(s); };
                                                                       };
                                                                       ret_w = bw(fn.ts);
                                                                       switch (ret_w == 0 | expr_w == 0)
                                                                       {
                                                                           case (true) { continue; }
                                                                           default
                                                                           {
                                                                                                              switch (is_trunc)
                                                                                                              {
                                                                                                                  case (true) { switch (expr_w <= ret_w)
                                                                               {
                                                                                   case (true) { continue; }
                                                                                   default {};
                                                                               }; }
                                                                                                                  default { switch (expr_w >= ret_w)
                                                                               {
                                                                                   case (true) { continue; }
                                                                                   default {};
                                                                               }; };
                                                                                                              };
                                                                                                              src_match = this.width_constrained(expr_w, lts, rts);
                                                                                                              dst_match = this.width_constrained(ret_w, lts, rts);
                                                                                                              switch (between)
                                                                                                              {
                                                                                                                  case (true) { violated = src_match & dst_match; }
                                                                                                                  default { violated = src_match | dst_match; };
                                                                                                              };
                                                                           };
                                                                       };
                                    };
                                };
                            }
                            default {};
                        };
                    };
                    };

                    switch (violated)
                    {
                        case (true) { this.report_width(n, op, lname, rname, lts, rts, is_trunc, between); }
                        default {};
                    };
                };
                ->;
            };



            check_no_address(Node* tmpl, PtrVec* nodes, byte* lname, byte* rname,
                                 TypeSpec* lts, TypeSpec* rts) -> void
            {
                NameMap* vars = nm_new();
                int i, cnt;
                Node* n;
                cnt = node_count(tmpl, 0);
                while (i < cnt)
                {
                    n = node_child(tmpl, 0, i);
                    switch (n.text != (byte*)0 & n.ts != (TypeSpec*)0)
                    {
                        case (true) {
                        switch (cstr_eq(n.ts.custom_typename, lname) | cstr_eq(n.ts.custom_typename, rname))
                        {
                            case (true) {
                            nm_put(vars, n.text, (void*)n);
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    i++;
                };
                i = 0;
                while (i < nodes.len)
                {
                    n = (Node*)nodes.items[i];
                    switch (n.kind == NodeKind.VARIABLE_DECLARATION & n.text != (byte*)0 & n.ts != (TypeSpec*)0)
                    {
                        case (true) {
                        switch (cstr_eq(n.ts.custom_typename, lname) | cstr_eq(n.ts.custom_typename, rname))
                        {
                            case (true) {
                            nm_put(vars, n.text, (void*)n);
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    i++;
                };
                i = 0;
                while (i < nodes.len)
                {
                    n = (Node*)nodes.items[i];
                    i++;
                    switch (n.kind != NodeKind.ADDRESS_OF)
                    {
                        case (true) { continue; }
                        default
                        {
                            switch (n.a == (Node*)0)
                            {
                                case (true) { continue; }
                                default
                                {
                                    switch (n.a.kind != NodeKind.IDENTIFIER)
                                    {
                                        case (true) { continue; }
                                        default
                                        {
                                            switch (n.a.text == (byte*)0)
                                            {
                                                case (true) { continue; }
                                                default
                                                {
                                                    switch (!nm_has(vars, n.a.text))
                                                    {
                                                        case (true) { continue; }
                                                        default
                                                        {
                                                            this.clear_msg();
                                                            this.mb.put_str(f"Type relation {lname} !@ {rname} violated: cannot take address of \0");
                                                            this.put_type_clause(lname, rname, lts, rts);
                                                            this.emit(Severity.ERROR, n.line, n.col);
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                -> nm_free(vars);
            };



            check_allowed(byte* fname, byte* pname, TypeSpec* concrete, TypeSpec** allowed, int n,
                              byte* allowed_text, int line, int col) -> bool
            {
                int i;
                switch (concrete == (TypeSpec*)0)
                {
                    case (true) { -> true; }
                    default
                    {
                        while (i < n)
                        {
                            switch (ts_matches(concrete, allowed[i]))
                            {
                                case (true) { -> true; }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                        this.clear_msg();
                        this.mb.put_str(f"Template parameter '{pname}' of '{fname}' was instantiated with type '\0");
                        this.put_type(concrete);
                        this.mb.put_str(f"', which does not satisfy the constraint [{allowed_text}]\0");
                        this.emit(Severity.ERROR, line, col);
                        -> false;
                    };
                };
            };







            check_relations(PtrVec* pnames, TypeSpec** args, int n, NodeVec* relations,
                                Node* tmpl, Node* concrete) -> int
            {
                int before = this.errors;
                switch (relations == (NodeVec*)0)
                {
                    case (true) { -> 0; }
                    default
                    {
                        PtrVec* tnodes = pv_new();
                        PtrVec* cnodes = pv_new();
                        NameMap* locals = nm_new();
                        collect_nodes(tmpl, tnodes);
                        switch (concrete != (Node*)0)
                        {
                            case (true) {
                            collect_nodes(concrete, cnodes);
                            this.collect_locals(concrete, cnodes, locals);
                        }
                            default {};
                        };

                        int r, a, b, k;
                        Node* rel;
                        byte* op;
                        byte* lname;
                        byte* rname;
                        TypeSpec* lts;
                        TypeSpec* rts;
                        int nl, nr;
                        while (r < relations.len)
                        {
                            rel = relations.items[r];
                            r++;
                            op = rel.text;
                            nl = node_count(rel, 0);
                            nr = node_count(rel, 1);
                            a = 0;
                            while (a < nl)
                            {
                                lname = node_child(rel, 0, a).text;
                                b = 0;
                                while (b < nr)
                                {
                                    rname = node_child(rel, 1, b).text;
                                    lts = (TypeSpec*)0;
                                    rts = (TypeSpec*)0;
                                    k = 0;
                                    while (k < n)
                                    {
                                        switch (cstr_eq((byte*)pnames.items[k], lname))
                                        {
                                            case (true) { lts = args[k]; }
                                            default {};
                                        };
                                        switch (cstr_eq((byte*)pnames.items[k], rname))
                                        {
                                            case (true) { rts = args[k]; }
                                            default {};
                                        };
                                        k++;
                                    };
                                    b++;
                                    switch (lts == (TypeSpec*)0 | rts == (TypeSpec*)0)
                                    {
                                        case (true) { continue; }
                                        default
                                        {
                                            switch (cstr_eq(op, g"~=\0"))
                                            {
                                                case (true) {
                                                switch (!types_compatible(lts, rts))
                                                {
                                                    case (true) {
                                                    this.clear_msg();
                                                    this.mb.put_str(f"Relation constraint '{lname} ~= {rname}' violated: '\0");
                                                    this.put_type(lts);
                                                    this.mb.put_str(g"' and '\0");
                                                    this.put_type(rts);
                                                    this.mb.put_str(g"' are not compatible (pointer mismatch or width mismatch)\0");
                                                    this.emit(Severity.ERROR, rel.line, rel.col);
                                                }
                                                    default {};
                                                };
                                            }
                                                default {
                                                    switch (cstr_eq(op, g"!~=\0"))
                                                    {
                                                        case (true) {
                                                switch (types_compatible(lts, rts))
                                                {
                                                    case (true) {
                                                    this.clear_msg();
                                                    this.mb.put_str(f"Relation constraint '{lname} !~= {rname}' violated: '\0");
                                                    this.put_type(lts);
                                                    this.mb.put_str(g"' and '\0");
                                                    this.put_type(rts);
                                                    this.mb.put_str(g"' must be incompatible but are compatible\0");
                                                    this.emit(Severity.ERROR, rel.line, rel.col);
                                                }
                                                    default {};
                                                };
                                            }
                                                        default {
                                                            switch (cstr_eq(op, g"!@\0"))
                                                            {
                                                                case (true) {
                                                this.check_no_address(tmpl, tnodes, lname, rname, lts, rts);
                                            }
                                                                default {
                                                                    switch (cstr_eq(op, g"!`<\0") | cstr_eq(op, g"!`<=\0") |
                                                  cstr_eq(op, g"!`>\0") | cstr_eq(op, g"!`>=\0"))
                                                                    {
                                                                        case (true) {
                                                switch (concrete != (Node*)0)
                                                {
                                                    case (true) {
                                                    this.check_width_relation(concrete, cnodes, locals, op, lname, rname, lts, rts);
                                                }
                                                    default {};
                                                };
                                            }
                                                                        default {};
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                                a++;
                            };
                        };

                        nm_free(locals);
                        pv_free(tnodes);
                        pv_free(cnodes);
                        -> this.errors - before;
                    };
                };
            };







            seg_of(byte* name) -> byte*
            {
                int i;
                int cut;
                while (name[i]!?)
                {
                    switch (name[i] == '_' & name[i + 1] == '_') { case (true) { cut = i + 2; } default {}; };
                    i++;
                };
                -> name + cut;
            };



            global_var_dup(byte* name) -> bool
            {
                NameMap* g = this.st.globals;
                byte* m = mangle_namespace_name(this.st.current_ns, name);
                byte* seg = this.seg_of(m);
                IDKC_SYMENTRY* e;
                int i;
                bool hit;
                while (i < g.count & !hit)
                {
                    e = (IDKC_SYMENTRY*)g.vals[i];
                    switch (e != (IDKC_SYMENTRY*)0)
                    {
                        case (true) {
                        switch (e.kind_id == SymbolKind.VARIABLE & cstr_eq(this.seg_of(g.keys[i]), seg)) { case (true) { hit = true; } default {}; };
                    }
                        default {};
                    };
                    i++;
                };
                ffree(m);
                -> hit;
            };

            declare_node(Node* n, byte* ns) -> void
            {
                switch (n == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        int k = n.kind;
                        switch (k == NodeKind.FUNCTION_DEF_STATEMENT | k == NodeKind.STRUCT_DEF_STATEMENT |
                            k == NodeKind.OBJECT_DEF_STATEMENT | k == NodeKind.ENUM_DEF_STATEMENT | k == NodeKind.UNION_DEF_STATEMENT |
                            k == NodeKind.NAMESPACE_DEF_STATEMENT)
                        {
                            case (true) {
                            -> this.declare_node(n.a, ns);
                        }
                            default
                            {
                                switch (k == NodeKind.EXTERN_BLOCK | k == NodeKind.EXPORT_BLOCK)
                                {
                                    case (true) {
                                    int bi;
                                    int bc = node_count(n, 0);
                                    while (bi < bc)
                                    {
                                        this.declare_node(node_child(n, 0, bi), ns);
                                        bi++;
                                    };
                                    ->;
                                }
                                    default
                                    {

                                        switch (n.text == (byte*)0)
                                        {
                                            case (true) { ->; }
                                            default
                                            {
                                                switch (k)
                                                {
                                                    case (NodeKind.FUNCTION_DEF)
                                                    {
                                                        st_define(this.st, n.text, SymbolKind.FUNCTION, n.ts, n);
                                                        switch ((n.flags `& 524288) == 0)
                                                        {
                                                            case (true) {
                                                            byte* fkey = mangle_namespace_name(ns, n.text);
                                                            this.reg_overload(fkey, n);
                                                            ffree(fkey);
                                                        }
                                                            default {};
                                                        };
                                                        this.decls++;
                                                    }
                                                    case (NodeKind.TYPE_FUNC_DEF)
                                                    {
                                                        switch (n.text2 != (byte*)0)
                                                        {
                                                            case (true) {
                                                            byte* tmid = join3(g"__typefunc__\0", n.text, g"__\0");
                                                            byte* tkey = join3(tmid, n.text2, g"\0");
                                                            this.reg_overload(tkey, n);
                                                            ffree(tmid);
                                                            ffree(tkey);
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                    case (NodeKind.TYPE_DECLARATION)
                                                    {
                                                        st_define(this.st, n.text, SymbolKind.TYPE, n.ts, n);
                                                        this.decls++;
                                                    }
                                                    case (NodeKind.UNION_DEF)
                                                    {
                                                        st_define(this.st, n.text, SymbolKind.UNION, (TypeSpec*)0, n);
                                                        this.decls++;
                                                    }
                                                    case (NodeKind.FUNCTION_POINTER_DECLARATION)
                                                    {
                                                        st_define(this.st, n.text, SymbolKind.VARIABLE, n.ts, n);
                                                        this.decls++;
                                                    }
                                                    case (NodeKind.STRUCT_DEF)
                                                    {
                                                        st_define(this.st, n.text, SymbolKind.STRUCT, (TypeSpec*)0, n);
                                                        int si;
                                                        int sc = node_count(n, 3);
                                                        while (si < sc)
                                                        {
                                                            this.declare_node(node_child(n, 3, si), ns);
                                                            si++;
                                                        };
                                                        this.decls++;
                                                    }
                                                    case (NodeKind.OBJECT_DEF)
                                                    {
                                                        st_define(this.st, n.text, SymbolKind.OBJECT, (TypeSpec*)0, n);
                                                        switch (n.d == (Node*)0)
                                                        {
                                                            case (true) {
                                                            byte* okey = mangle_namespace_name(ns, n.text);
                                                            int mi;
                                                            int mc = node_count(n, 1);
                                                            Node* meth;
                                                            byte* mkey;
                                                            while (mi < mc)
                                                            {
                                                                meth = node_child(n, 1, mi);
                                                                switch (meth.text != (byte*)0 & (meth.flags `& 524288) == 0)
                                                                {
                                                                    case (true) {
                                                                    mkey = join3(okey, g".\0", meth.text);
                                                                    this.reg_overload(mkey, meth);
                                                                    ffree(mkey);
                                                                }
                                                                    default {};
                                                                };
                                                                mi++;
                                                            };
                                                            ffree(okey);
                                                            mi = 0;
                                                            mc = node_count(n, 3);
                                                            while (mi < mc)
                                                            {
                                                                this.declare_node(node_child(n, 3, mi), ns);
                                                                mi++;
                                                            };
                                                            mi = 0;
                                                            mc = node_count(n, 4);
                                                            while (mi < mc)
                                                            {
                                                                this.declare_node(node_child(n, 4, mi), ns);
                                                                mi++;
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                        this.decls++;
                                                    }
                                                    case (NodeKind.ENUM_DEF)
                                                    {
                                                        st_define(this.st, n.text, SymbolKind.ENUM, n.ts, n);
                                                        this.decls++;
                                                    }
                                                    case (NodeKind.VARIABLE_DECLARATION)
                                                    {
                                                        switch (n.text != (byte*)0 & !(this.st.scopes.len == 1 & this.global_var_dup(n.text)))
                                                        {
                                                            case (true) {
                                                            st_define(this.st, n.text, SymbolKind.VARIABLE, n.ts, n);
                                                            this.decls++;
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                    case (NodeKind.NAMESPACE_DEF)
                                                    {
                                                        byte* prev = ts_dup(this.st.current_ns);
                                                        byte* full;
                                                        switch (prev[0] == 0)
                                                        {
                                                            case (true) { full = ts_dup(n.text); }
                                                            default {
                                                            int la = pp_cstrlen(prev);
                                                            int lb = pp_cstrlen(n.text);
                                                            full = (byte*)fmalloc((u64)(la + lb + 3));
                                                            int i, j;
                                                            while (i < la)
                                                            {
                                                                full[i] = prev[i];
                                                                i++;
                                                            };
                                                            full[i] = ':';
                                                            full[i + 1] = ':';
                                                            while (j < lb)
                                                            {
                                                                full[i + 2 + j] = n.text[j];
                                                                j++;
                                                            };
                                                            full[i + 2 + lb] = (byte)0;
                                                        };
                                                        };
                                                        st_define(this.st, n.text, SymbolKind.NAMESPACE, (TypeSpec*)0, n);
                                                        st_set_namespace(this.st, full);
                                                        int s, c, e, w;
                                                        Node* lst;
                                                        while (s < 6)
                                                        {
                                                            c = node_count(n, s);
                                                            e = 0;
                                                            while (e < c)
                                                            {
                                                                this.declare_node(node_child(n, s, e), full);
                                                                e++;
                                                            };
                                                            s++;
                                                        };
                                                        w = 0;
                                                        while (w < 2)
                                                        {
                                                            switch (w)
                                                            {
                                                                case (0) { lst = n.a; }
                                                                default { lst = n.b; };
                                                            };
                                                            switch (lst != (Node*)0)
                                                            {
                                                                case (true) {
                                                                c = node_count(lst, 0);
                                                                e = 0;
                                                                while (e < c)
                                                                {
                                                                    this.declare_node(node_child(lst, 0, e), full);
                                                                    e++;
                                                                };
                                                            }
                                                                default {};
                                                            };
                                                            w++;
                                                        };
                                                        st_set_namespace(this.st, prev);
                                                        ffree(prev);
                                                        ffree(full);
                                                    }
                                                    default {};
                                                };
                                                ->;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            reg_overload(byte* key, Node* fn) -> void
            {
                int i;
                int cnt = node_count(fn, 0);
                Node* p;
                TypeSpec** ps = (TypeSpec**)fmalloc((u64)(cnt + 1) * (u64)(sizeof(TypeSpec*) / 8));
                while (i < cnt)
                {
                    p = node_child(fn, 0, i);
                    switch (p.ts == (TypeSpec*)0)
                    {
                        case (true) {
                        -> ffree((byte*)ps);
                    }
                        default
                        {
                            ps[i] = p.ts;
                            i++;
                        };
                    };
                };
                switch (fn.ts == (TypeSpec*)0)
                {
                    case (true) {
                    -> ffree((byte*)ps);
                }
                    default
                    {
                        this.clear_msg();
                        mangle_function(@this.mb, key, ps, cnt, fn.ts);
                        st_register_function_overload(this.st, key, this.mb.mem, ps, cnt, fn.ts, fn,
                                                      (fn.flags `& 16384)!?);
                        -> ffree((byte*)ps);
                    };
                };
            };


            declare_program(Node* prog) -> int
            {
                int i;
                int cnt = node_count(prog, 0);
                while (i < cnt)
                {
                    this.declare_node(node_child(prog, 0, i), g"\0");
                    i++;
                };
                -> this.decls;
            };


            print_diags(byte* path) -> void
            {
                int i;
                Diag* d;
                while (i < this.diags.len)
                {
                    d = (Diag*)this.diags.items[i];
                    print(path);
                    print(g":\0");
                    print(d.line);
                    print(g":\0");
                    print(d.col);
                    switch (d.severity)
                    {
                        case (Severity.ERROR) { print(g": error: \0"); }
                        default { print(g": warning: \0"); };
                    };
                    println(d.msg);
                    i++;
                };
                ->;
            };
        };
    };
};



using standard::io::console;
using IDEKA::lexer;
using IDEKA::ast;
using IDEKA::preprocessor;
using IDEKA::errors;
using IDEKA::types;
using IDEKA::check;





namespace IDEKA
{
    namespace parser
    {
        enum Feat
        {
            FUNCTION_DEF,
            ENUM_DEF,
            MACRO_DEF,
            UNION_DEF,
            STRUCT_DEF,
            TRAIT_DEF,
            EFFECT_DEF,
            INTERFACE_DEF,
            OBJECT_DEF,
            TRAIT_PREFIXED_OBJECT,
            NAMESPACE_DEF,
            USING_STATEMENT,
            NOT_USING_STATEMENT,
            DEPRECATE_STATEMENT,
            EXTERN_STATEMENT,
            EXPORT_STATEMENT,
            CONTRACT_DEF,
            CONSTRA_DEF,
            OPERATOR_DEF,
            TYPE_FUNC_DEF,
            VARIABLE_DECLARATION,
            VARIABLE_DECLARATION_STATEMENT,
            DUAL_ASSIGN_DECLARATION,
            AUTO_VARIABLE_DECLARATION,
            DESTRUCTURING_ASSIGNMENT,
            BLOCK_STATEMENT,
            ASM_STATEMENT,
            IDEKAVM_STATEMENT,
            COMPTIME_BLOCK,
            EMITIDEKA_STATEMENT,
            IF_STATEMENT,
            WHILE_STATEMENT,
            DO_WHILE_STATEMENT,
            FOR_STATEMENT,
            SWITCH_STATEMENT,
            TRY_STATEMENT,
            RETURN_STATEMENT,
            RETURN_ARROW_RET,
            ERROR_RETURN_STATEMENT,
            BREAK_STATEMENT,
            CONTINUE_STATEMENT,
            LABEL_STATEMENT,
            GOTO_STATEMENT,
            JUMP_STATEMENT,
            THROW_STATEMENT,
            ASSERT_STATEMENT,
            DEFER_STATEMENT,
            ESCAPE_STATEMENT,
            NORETURN_STATEMENT,
            DITTO_STATEMENT,
            CODIFY_STATEMENT,
            EXPRESSION_STATEMENT,
            FSTRING_EXPR,
            ISTRING_EXPR,
            CODIFY_EXPR,
            TEMPLATE_FUNCTION,
            FUNCTION_CONTRACT,
            TEMPLATE_STRUCT,
            TEMPLATE_OBJECT,
            AS_OPERATOR,
            TEMPLATE_OPERATOR,
            CONTRACT_BINDING,
            COUNT
        };

        feature_name(int f) -> byte*
        {
            switch (f)
            {
                case (Feat.FUNCTION_DEF) { -> g"Function Definition\0"; }
                case (Feat.ENUM_DEF) { -> g"Enum Definition\0"; }
                case (Feat.MACRO_DEF) { -> g"Macro Definition\0"; }
                case (Feat.UNION_DEF) { -> g"Union Definition\0"; }
                case (Feat.STRUCT_DEF) { -> g"Struct Definition\0"; }
                case (Feat.TRAIT_DEF) { -> g"Trait Definition\0"; }
                case (Feat.EFFECT_DEF) { -> g"Effect Definition\0"; }
                case (Feat.INTERFACE_DEF) { -> g"Interface Definition\0"; }
                case (Feat.OBJECT_DEF) { -> g"Object Definition\0"; }
                case (Feat.TRAIT_PREFIXED_OBJECT) { -> g"Trait Prefixed Object Definition\0"; }
                case (Feat.NAMESPACE_DEF) { -> g"Namespace Definition\0"; }
                case (Feat.USING_STATEMENT) { -> g"Using Statement\0"; }
                case (Feat.NOT_USING_STATEMENT) { -> g"Not Using Statement\0"; }
                case (Feat.DEPRECATE_STATEMENT) { -> g"Deprecate Statement\0"; }
                case (Feat.EXTERN_STATEMENT) { -> g"Extern Block\0"; }
                case (Feat.EXPORT_STATEMENT) { -> g"Export Block\0"; }
                case (Feat.CONTRACT_DEF) { -> g"Contract Definition\0"; }
                case (Feat.CONSTRA_DEF) { -> g"Constraint Definition\0"; }
                case (Feat.OPERATOR_DEF) { -> g"Operator Definition\0"; }
                case (Feat.TYPE_FUNC_DEF) { -> g"Type Function Definition\0"; }
                case (Feat.VARIABLE_DECLARATION) { -> g"Variable Declaration\0"; }
                case (Feat.VARIABLE_DECLARATION_STATEMENT) { -> g"Variable Declaration Statement\0"; }
                case (Feat.DUAL_ASSIGN_DECLARATION) { -> g"Dual Assign Declaration\0"; }
                case (Feat.AUTO_VARIABLE_DECLARATION) { -> g"Auto Variable Declaration\0"; }
                case (Feat.DESTRUCTURING_ASSIGNMENT) { -> g"Destructuring Assignment\0"; }
                case (Feat.BLOCK_STATEMENT) { -> g"Block Statement\0"; }
                case (Feat.ASM_STATEMENT) { -> g"Inline Assembly\0"; }
                case (Feat.IDEKAVM_STATEMENT) { -> g"IDEKAVM Block\0"; }
                case (Feat.COMPTIME_BLOCK) { -> g"Comptime Block\0"; }
                case (Feat.EMITIDEKA_STATEMENT) { -> g"EmitIDEKA\0"; }
                case (Feat.IF_STATEMENT) { -> g"If Statement\0"; }
                case (Feat.WHILE_STATEMENT) { -> g"While Loop\0"; }
                case (Feat.DO_WHILE_STATEMENT) { -> g"Do Loop\0"; }
                case (Feat.FOR_STATEMENT) { -> g"For Loop\0"; }
                case (Feat.SWITCH_STATEMENT) { -> g"Switch Statement\0"; }
                case (Feat.TRY_STATEMENT) { -> g"Try Block\0"; }
                case (Feat.RETURN_STATEMENT) { -> g"Return Statement\0"; }
                case (Feat.RETURN_ARROW_RET) { -> g"Return Arrow Statement\0"; }
                case (Feat.ERROR_RETURN_STATEMENT) { -> g"Error Return Statement\0"; }
                case (Feat.BREAK_STATEMENT) { -> g"Break Statement\0"; }
                case (Feat.CONTINUE_STATEMENT) { -> g"Continue Statement\0"; }
                case (Feat.LABEL_STATEMENT) { -> g"Label Statement\0"; }
                case (Feat.GOTO_STATEMENT) { -> g"Goto Statement\0"; }
                case (Feat.JUMP_STATEMENT) { -> g"Jump Statement\0"; }
                case (Feat.THROW_STATEMENT) { -> g"Throw Statement\0"; }
                case (Feat.ASSERT_STATEMENT) { -> g"Assert Statement\0"; }
                case (Feat.DEFER_STATEMENT) { -> g"Defer Statement\0"; }
                case (Feat.ESCAPE_STATEMENT) { -> g"Escape Statement\0"; }
                case (Feat.NORETURN_STATEMENT) { -> g"Noreturn Statement\0"; }
                case (Feat.DITTO_STATEMENT) { -> g"Ditto Statement\0"; }
                case (Feat.CODIFY_STATEMENT) { -> g"Codify Statement\0"; }
                case (Feat.EXPRESSION_STATEMENT) { -> g"Expression Statement\0"; }
                case (Feat.FSTRING_EXPR) { -> g"f-string Expression\0"; }
                case (Feat.ISTRING_EXPR) { -> g"i-string Expression\0"; }
                case (Feat.CODIFY_EXPR) { -> g"Codify Expression\0"; }
                case (Feat.TEMPLATE_FUNCTION) { -> g"Template Function\0"; }
                case (Feat.FUNCTION_CONTRACT) { -> g"Function Contract\0"; }
                case (Feat.TEMPLATE_STRUCT) { -> g"Template Struct\0"; }
                case (Feat.TEMPLATE_OBJECT) { -> g"Template Object\0"; }
                case (Feat.AS_OPERATOR) { -> g"Operator Binding (as operator)\0"; }
                case (Feat.TEMPLATE_OPERATOR) { -> g"Template Operator\0"; }
                case (Feat.CONTRACT_BINDING) { -> g"Contract Binding Spec\0"; }
                default { -> g"Unknown Feature\0"; };
            };
        };


        enum ParseErr
        {
            NONE,
            MESSAGE,
            EXPECTED,
            ALLOC,
            SILENT      
        };

        ps_bytes_eq(byte* a, byte* b, int n) -> bool
        {
            int i;
            while (i < n)
            {
                switch (a[i] != b[i])
                {
                    case (true) { -> false; }
                    default
                    {
                        i++;
                    };
                };
            };
            -> true;
        };







        dump_pad(int depth) -> void
        {
            int i;
            while (i < depth)
            {
                print(g"  \0");
                i++;
            };
            ->;
        };


        dump_ts(TypeSpec* t) -> void
        {
            switch (t.custom_typename != (byte*)0)
            {
                case (true) {
                print(t.custom_typename);
            }
                default {
                print(datatype_text(t.base_type));
            };
            };
            switch ((t.flags `& 1) != 0)
            {
                case (true) { print(g",signed\0"); }
                default {};
            };
            switch ((t.flags `& 2) != 0)
            {
                case (true) { print(g",const\0"); }
                default {};
            };
            switch ((t.flags `& 4) != 0)
            {
                case (true) { print(g",volatile\0"); }
                default {};
            };
            switch ((t.flags `& 8) != 0)
            {
                case (true) { print(g",tied\0"); }
                default {};
            };
            switch ((t.flags `& 16) != 0)
            {
                case (true) { print(g",local\0"); }
                default {};
            };
            switch ((t.flags `& 256) != 0)
            {
                case (true) { print(g",nofunc\0"); }
                default {};
            };
            switch (t.bit_width >= 0)
            {
                case (true) { print(g",w\0"); print(t.bit_width); }
                default {};
            };
            switch (t.alignment >= 0)
            {
                case (true) { print(g",a\0"); print(t.alignment); }
                default {};
            };
            switch (t.endianness != 1)
            {
                case (true) { print(g",e\0"); print(t.endianness); }
                default {};
            };
            switch (t.storage_class >= 0)
            {
                case (true) { print(g",sc\0"); print(t.storage_class); }
                default {};
            };
            switch ((t.flags `& 64) != 0)
            {
                case (true) { print(g",ptr\0"); print(t.pointer_depth); }
                default {};
            };
            switch ((t.flags `& 32) != 0)
            {
                case (true) {
                print(g",arr\0");
                switch (t.array_dims != (NodeVec*)0)
                {
                    case (true) { print(t.array_dims.len); }
                    default {};
                };
            }
                default {};
            };
            switch (t.base_type == DataType.DICT)
            {
                case (true) {
                print(g"{\0");
                dump_ts(t.dict_key);
                print(g":\0");
                dump_ts(t.dict_value);
                print(g"}\0");
            }
                default {};
            };
            ->;
        };

        dump_quoted(byte* s) -> void
        {
            print(g"\"\0");
            print(s);
            -> print(g"\"\0");
        };


        dump_tag(int slot, int idx) -> void
        {
            switch (slot < 0)
            {
                case (true) { ->; }
                default
                {
                    switch (slot)
                    {
                        case (0) { print(g"a: \0"); }
                        case (1) { print(g"b: \0"); }
                        case (2) { print(g"c: \0"); }
                        case (3) { print(g"d: \0"); }
                        case (4) { print(g"e: \0"); }
                        default
                        {
                            print(g"l\0");
                            print(slot - 10);
                            print(g"[\0");
                            print(idx);
                            print(g"]: \0");
                        };
                    };
                    ->;
                };
            };
        };

        dump_node(Node* n, int depth, int slot, int idx) -> void
        {
            dump_pad(depth);
            dump_tag(slot, idx);
            switch (n == (Node*)0)
            {
                case (true) {
                -> println(g"null\0");
            }
                default
                {
                    print(node_kind_name(n.kind));
                    int k = n.kind;
                    switch (k == NodeKind.BINARY_OP | k == NodeKind.UNARY_OP)
                    {
                        case (true) {
                        print(g" op=\0");
                        print(operator_text(n.op));
                    }
                        default {
                        switch (k)
                        {
                            case (NodeKind.LITERAL)
                            {
                                print(g" op=\0");
                                print(datatype_text(n.op));
                                switch (n.op != DataType.FLOAT & n.op != DataType.DOUBLE & n.op != DataType.CHAR)
                                {
                                    case (true) {
                                    print(g" val=\0");
                                    print(n.ival);
                                }
                                    default {};
                                };
                                switch (n.op == DataType.CHAR & n.text != (byte*)0)
                                {
                                    case (true) {
                                    print(g" text=\0");
                                    dump_quoted(n.text);
                                }
                                    default {};
                                };
                            }
                            case (NodeKind.COMPOUND_ASSIGNMENT)
                            {
                                print(g" op=\0");
                                print(token_name(n.op));
                            }
                            default {};
                        };
                    };
                    };
                    switch (k != NodeKind.LITERAL)
                    {
                        case (true) {
                        switch (n.text != (byte*)0)
                        {
                            case (true) {
                            print(g" text=\0");
                            dump_quoted(n.text);
                        }
                            default {};
                        };
                        switch (n.text2 != (byte*)0)
                        {
                            case (true) {
                            print(g" text2=\0");
                            dump_quoted(n.text2);
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    switch ((n.flags `& (1 `| 2)) != 0)
                    {
                        case (true) {
                        print(g" flags=\0");
                        print(n.flags `& (1 `| 2));
                    }
                        default {};
                    };
                    switch (n.ts != (TypeSpec*)0)
                    {
                        case (true) {
                        print(g" ts=\0");
                        dump_ts(n.ts);
                    }
                        default {};
                    };
                    println(g"\0");
                    switch (n.a != (Node*)0)
                    {
                        case (true) { dump_node(n.a, depth + 1, 0, 0); }
                        default {};
                    };
                    switch (n.b != (Node*)0)
                    {
                        case (true) { dump_node(n.b, depth + 1, 1, 0); }
                        default {};
                    };
                    switch (n.c != (Node*)0)
                    {
                        case (true) { dump_node(n.c, depth + 1, 2, 0); }
                        default {};
                    };
                    switch (n.d != (Node*)0)
                    {
                        case (true) { dump_node(n.d, depth + 1, 3, 0); }
                        default {};
                    };
                    switch (n.e != (Node*)0)
                    {
                        case (true) { dump_node(n.e, depth + 1, 4, 0); }
                        default {};
                    };
                    int s, i, cnt;
                    while (s < 6)
                    {
                        cnt = node_count(n, s);
                        i = 0;
                        while (i < cnt)
                        {
                            dump_node(node_child(n, s, i), depth + 1, 10 + s, i);
                            i++;
                        };
                        s++;
                    };
                    ->;
                };
            };
        };

        struct OpSym
        {
            int n;
            int* t;
            byte** v;
        };

        struct COp
        {
            int kind;
            OpSym* left;
            OpSym* right;
            byte* func;
        };


        struct TemplateEntry
        {
            int kind;               
            PtrVec* params;         
            PtrVec* cparam;         
            PtrVec* cts;            
            PtrVec* ctext;          
            PtrVec* dparam;         
            PtrVec* dts;            
            Node* node;             
            Node* rels;             
            NameMap* no_default;    
            NameMap* emitted;       
        };

        te_new() -> TemplateEntry*
        {
            TemplateEntry* e = (TemplateEntry*)fmalloc((u64)((sizeof(TemplateEntry) + 7) / 8));
            e.kind = 0;
            e.params = pv_new();
            e.cparam = pv_new();
            e.cts = pv_new();
            e.ctext = pv_new();
            e.dparam = pv_new();
            e.dts = pv_new();
            e.node = (Node*)0;
            e.rels = node_new(NodeKind.CONSTRA_DEF, 0, 0);
            e.no_default = nm_new();
            e.emitted = nm_new();
            -> e;
        };

        te_free(TemplateEntry* e) -> void
        {
            int i;
            switch (e == (TemplateEntry*)0)
            {
                case (true) { ->; }
                default
                {
                    while (i < e.cts.len)
                    {
                        typespec_free((TypeSpec*)e.cts.items[i]);
                        i++;
                    };
                    i = 0;
                    while (i < e.dts.len)
                    {
                        typespec_free((TypeSpec*)e.dts.items[i]);
                        i++;
                    };
                    pv_free(e.params);
                    pv_free(e.cparam);
                    pv_free(e.cts);
                    pv_free(e.ctext);
                    pv_free(e.dparam);
                    pv_free(e.dts);
                    node_free(e.node);
                    node_free(e.rels);
                    nm_free(e.no_default);
                    nm_free(e.emitted);
                    -> ffree((byte*)e);
                };
            };
        };

        object Parser
        {
            Lexer* lx;
            Token* toks;
            int count, pos;
            int* feat_hits;
            int stub_total, stub_features;
            int err_kind, err_expected, err_got, err_line, err_col;
            int err_prev_line, err_got_len;
            int* lmap;              
            byte** lfiles;          
            int lmapn;
            bool diag_color;
            byte* err_msg;
            byte* eof_msg;          
            int function_depth, loop_depth, in_comptime, in_trait, in_fn_stringify, async_errs;
            bool in_for_init;       
            bool failed, verbose;
            Node* last_stmt;
            bool top_stmt;          
            NodeVec* pending;       
            NodeVec* block_out;     
            NodeVec* root_inits;    
            PtrVec* strs;           
            Buf sb;                 
            IDKC_SYMTABLE* st;        
            int default_byte_width; 
            Node* last_call;        
            PtrVec* cops;           
            int cop_mask;           
            OpSym* vop_sym;         
            PtrVec* contracts;      
            PtrVec* sublex;         
            byte* last_template;    
            PtrVec* trait_defs;     
            byte* ns_path;          
            NameMap* cstrs;         
            PtrVec* subparsers;     
            NameMap* constras;      
            NameMap* templates;     
            PtrVec* tentries;       
            NameMap* pobjs;         
            NameMap* oinit;         
            PtrVec* inh_clone;      
            PtrVec* inh_orig;
            NameMap* tobj_fwd;      
            NameMap* active_tp;     
            TemplateEntry* tmpl_cur; 
            PtrVec* tinst_s;        
            PtrVec* tinst_o;        
            PtrVec* tinst_f;        
            PtrVec* pend_dict;      
            PtrVec* tmp_ts;         
            Checker* chk; 
            NameMap* macros;        

            __init(Lexer* lexer) -> this
            {
                int z;
                this.lx = lexer;
                this.toks = (Token*)0;
                this.count = 0;
                this.pos = 0;
                this.stub_total = 0;
                this.stub_features = 0;
                this.err_kind = ParseErr.NONE;
                this.err_expected = 0;
                this.err_got = 0;
                this.err_line = 0;
                this.err_col = 0;
                this.err_prev_line = 0;
                this.err_got_len = 0;
                this.lmap = (int*)0;
                this.lfiles = (byte**)0;
                this.lmapn = 0;
                this.diag_color = IDEKA::errors::DIAG_COLOR_ON;
                this.err_msg = (byte*)0;
                this.function_depth = 0;
                this.loop_depth = 0;
                this.in_for_init = false;
                this.in_comptime = 0;
                this.in_trait = 0;
                this.in_fn_stringify = 0;
                this.eof_msg = (byte*)0;
                this.async_errs = 0;
                this.failed = false;
                this.verbose = false;
                this.last_stmt = (Node*)0;
                this.pending = nv_new();
                this.top_stmt = false;
                this.block_out = (NodeVec*)0;
                this.root_inits = (NodeVec*)0;
                this.strs = pv_new();
                this.sb.__init();
                this.st = (IDKC_SYMTABLE*)0;
                this.default_byte_width = 8;
                this.last_call = (Node*)0;
                this.ns_path = (byte*)0;
                this.last_template = (byte*)0;
                this.trait_defs = pv_new();
                this.cops = pv_new();
                this.cop_mask = 0;
                this.vop_sym = (OpSym*)0;
                this.contracts = pv_new();
                this.sublex = pv_new();
                this.cstrs = nm_new();
                this.subparsers = pv_new();
                this.macros = nm_new();
                this.constras = nm_new();
                this.templates = nm_new();
                this.tentries = pv_new();
                this.active_tp = nm_new();
                this.tobj_fwd = nm_new();
                this.pobjs = nm_new();
                this.oinit = nm_new();
                this.inh_clone = pv_new();
                this.inh_orig = pv_new();
                this.tmpl_cur = (TemplateEntry*)0;
                this.tinst_s = pv_new();
                this.tinst_o = pv_new();
                this.tinst_f = pv_new();
                this.pend_dict = pv_new();
                this.tmp_ts = pv_new();
                this.chk = (Checker*)0;
                this.feat_hits = (int*)fmalloc((u64)Feat.COUNT * (u64)((sizeof(int) + 7) / 8));
                switch (this.feat_hits == (int*)0)
                {
                    case (true) {
                    this.failed = true;
                    this.err_kind = ParseErr.ALLOC;
                    -> this;
                }
                    default
                    {
                        while (z < Feat.COUNT)
                        {
                            this.feat_hits[z] = 0;
                            z++;
                        };
                        -> this;
                    };
                };
            };

            __expr() -> Parser* -> this;

            __exit() -> void
            {
                switch (this.feat_hits != (int*)0)
                {
                    case (true) { ffree((byte*)this.feat_hits); }
                    default {};
                };
                this.feat_hits = (int*)0;
                nv_free(this.pending);
                this.pending = (NodeVec*)0;
                int si;
                while (si < this.strs.len)
                {
                    ffree((byte*)this.strs.items[si]);
                    si++;
                };
                pv_free(this.strs);
                pv_free(this.trait_defs);
                int ci;
                COp* cc;
                while (ci < this.cops.len)
                {
                    cc = (COp*)this.cops.items[ci];
                    this.opsym_free(cc.left);
                    this.opsym_free(cc.right);
                    ffree((byte*)cc);
                    ci++;
                };
                pv_free(this.cops);
                pv_free(this.contracts);
                int li;
                Lexer* sl;
                while (li < this.sublex.len)
                {
                    sl = (Lexer*)this.sublex.items[li];
                    sl.__exit();
                    ffree((byte*)sl);
                    li++;
                };
                pv_free(this.sublex);
                int pi;
                Parser* sp;
                while (pi < this.subparsers.len)
                {
                    sp = (Parser*)this.subparsers.items[pi];
                    switch (sp.st != (IDKC_SYMTABLE*)0)
                    {
                        case (true) { st_free(sp.st); }
                        default {};
                    };
                    sp.__exit();
                    ffree((byte*)sp);
                    pi++;
                };
                pv_free(this.subparsers);
                nm_free(this.cstrs);
                nm_free(this.macros);
                nm_free(this.constras);
                nm_free(this.templates);
                nm_free(this.active_tp);
                nm_free(this.tobj_fwd);
                nm_free(this.pobjs);
                nm_free(this.oinit);
                pv_free(this.inh_clone);
                pv_free(this.inh_orig);
                pi = 0;
                while (pi < this.tentries.len)
                {
                    te_free((TemplateEntry*)this.tentries.items[pi]);
                    pi++;
                };
                pv_free(this.tentries);
                pi = 0;
                while (pi < this.tinst_s.len)
                {
                    node_free((Node*)this.tinst_s.items[pi]);
                    pi++;
                };
                pi = 0;
                while (pi < this.tinst_o.len)
                {
                    node_free((Node*)this.tinst_o.items[pi]);
                    pi++;
                };
                pi = 0;
                while (pi < this.tinst_f.len)
                {
                    node_free((Node*)this.tinst_f.items[pi]);
                    pi++;
                };
                pv_free(this.tinst_s);
                pv_free(this.tinst_o);
                pv_free(this.tinst_f);
                pi = 0;
                while (pi < this.tmp_ts.len)
                {
                    typespec_free((TypeSpec*)this.tmp_ts.items[pi]);
                    pi++;
                };
                pv_free(this.tmp_ts);
                switch (this.chk != (Checker*)0)
                {
                    case (true) {
                    this.chk.__exit();
                    ffree((byte*)this.chk);
                }
                    default {};
                };
                -> this.sb.__exit();
            };



            cur() -> int -> this.toks[this.pos].type;

            cur_line() -> int -> this.toks[this.pos].line;

            cur_col() -> int -> this.toks[this.pos].column;


            cur_value() -> byte* -> this.lx.token_value(this.pos);

            cur_value_len() -> int -> this.toks[this.pos].vlen;


            val_is(byte* lit, int n) -> bool
            {
                switch (this.cur_value_len() != n)
                {
                    case (true) { -> false; }
                    default
                    {
                        -> ps_bytes_eq(this.cur_value(), lit, n);
                    };
                };
            };


            type_at(int off) -> int
            {
                int p = this.pos + off;
                switch (p < 0)
                {
                    case (true) { -> -1; }
                    default
                    {
                        switch (p >= this.count)
                        {
                            case (true) { -> -1; }
                            default
                            {
                                -> this.toks[p].type;
                            };
                        };
                    };
                };
            };

            advance() -> void
            {
                switch (this.pos < this.count - 1)
                {
                    case (true) { this.pos++; }
                    default {};
                };
                ->;
            };

            expect(int a) -> bool -> this.cur() == a;

            expect2(int a, int b) -> bool
            {
                int c = this.cur();
                -> c == a | c == b;
            };

            expect3(int a, int b, int d) -> bool
            {
                int c = this.cur();
                -> c == a | c == b | c == d;
            };

            expect4(int a, int b, int d, int e) -> bool
            {
                int c = this.cur();
                -> c == a | c == b | c == d | c == e;
            };


            mark() -> int -> this.pos;

            reset(int m) -> void
            {
                this.pos = m;
                ->;
            };

            is_calling_conv(int t) -> bool -> t == TokenType.CDECL | t == TokenType.STDCALL | t == TokenType.FASTCALL | t == TokenType.THISCALL | t == TokenType.VECTORCALL;


            is_base_type_token() -> bool -> this.expect4(TokenType.SINT, TokenType.UINT, TokenType.FLOAT_KW, TokenType.DOUBLE_KW) | this.expect4(TokenType.CHAR, TokenType.BOOL_KW, TokenType.BYTE, TokenType.DATA) | this.expect4(TokenType.VOID, TokenType.SLONG, TokenType.ULONG, TokenType.STRUCT) | this.expect3(TokenType.OBJECT, TokenType.IDENTIFIER, TokenType.DICT);




            error(byte* msg) -> void
            {
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        this.failed = true;
                        this.err_kind = ParseErr.MESSAGE;
                        this.err_msg = msg;
                        this.err_line = this.cur_line();
                        this.err_col = this.cur_col();
                        this.err_prev_line = 0;
                        this.err_got_len = 0;
                        ->;
                    };
                };
            };



            fail_expected_msg2(byte* msg, int t, bool use_prev) -> void
            {
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        this.failed = true;
                        this.err_kind = ParseErr.EXPECTED;
                        this.err_expected = t;
                        this.err_got = this.cur();
                        this.err_line = this.cur_line();
                        this.err_col = this.cur_col();
                        this.err_got_len = this.toks[this.pos].vlen;
                        this.err_prev_line = 0;
                        switch (use_prev & this.pos > 0)
                        {
                            case (true) { this.err_prev_line = this.toks[this.pos - 1].line; }
                            default {};
                        };
                        this.err_msg = msg;
                        ->;
                    };
                };
            };

            fail_expected_msg(byte* msg, int t) -> void -> this.fail_expected_msg2(msg, t, true);


            error_exp(byte* msg, int t) -> void -> this.fail_expected_msg2(msg, t, false);


            fail_expected(int t) -> void
            {
                byte* es = IDEKA::errors::sym_of(t);
                byte* gs = IDEKA::errors::sym_of(this.cur());
                byte* gv = this.cur_value();
                switch (es == (byte*)0) { case (true) { es = token_name(t); } default {}; };
                switch (gs == (byte*)0) { case (true) { gs = token_name(this.cur()); } default {}; };
                switch (gv[0] != 0 & !cstr_eq(gv, gs)) { case (true) { gs = gv; } default {}; };
                -> this.fail_expected_msg(this.cat2(this.cat2(this.cat2(g"Unexpected \0", gs), g", expected \0"), es), t);
            };


            consume_msg(int t, byte* msg) -> bool
            {
                switch (!this.expect(t))
                {
                    case (true) {
                    this.fail_expected_msg(msg, t);
                    -> false;
                }
                    default
                    {
                        this.advance();
                        -> true;
                    };
                };
            };


            consume(int t) -> bool
            {
                switch (!this.expect(t))
                {
                    case (true) {
                    this.fail_expected(t);
                    -> false;
                }
                    default
                    {
                        this.advance();
                        -> true;
                    };
                };
            };

            error_text() -> byte*
            {
                switch (this.err_kind == ParseErr.MESSAGE | this.err_kind == ParseErr.EXPECTED)
                {
                    case (true) { -> this.err_msg; }
                    default
                    {
                        switch (this.err_kind == ParseErr.ALLOC)
                        {
                            case (true) { -> g"parser allocation failed\0"; }
                            default
                            {
                                -> g"parse error\0";
                            };
                        };
                    };
                };
            };


            render_error(Buf* out) -> void
            {
                int exp = -1;
                switch (this.err_kind == ParseErr.EXPECTED)
                {
                    case (true) { exp = this.err_expected; }
                    default {};
                };
                -> IDEKA::errors::render(out, this.diag_color, IDEKA::errors::SEV_ERROR, this.error_text(), this.err_line, this.err_col, this.lx.src, this.lx.length, this.lmap, this.lmapn, this.lfiles, exp, this.err_got, this.err_got_len, this.err_prev_line, (byte*)0);
            };


            synchronize() -> void
            {
                this.advance();
                while (!this.expect(TokenType.EOF))
                {
                    switch (this.pos > 0)
                    {
                        case (true) {
                        switch (this.toks[this.pos - 1].type == TokenType.SEMICOLON)
                        {
                            case (true) { ->; }
                            default {};
                        };
                    }
                        default {};
                    };
                    switch (this.expect4(TokenType.DEF, TokenType.STRUCT, TokenType.OBJECT, TokenType.NAMESPACE))
                    {
                        case (true) { ->; }
                        default
                        {
                            switch (this.expect4(TokenType.IF, TokenType.WHILE, TokenType.FOR, TokenType.RETURN))
                            {
                                case (true) { ->; }
                                default
                                {
                                    this.advance();
                                };
                            };
                        };
                    };
                };
                ->;
            };








            skip_construct() -> int
            {
                int depth, t, prev, angle, commas;
                bool in_init = false;
                prev = -1;
                while (true)
                {
                    t = this.cur();
                    switch (t == TokenType.EOF)
                    {
                        case (true) { -> commas; }
                        default
                        {
                            switch (t == TokenType.LEFT_PAREN | t == TokenType.LEFT_BRACKET | t == TokenType.LEFT_BRACE)
                            {
                                case (true) {
                                depth++;
                            }
                                default {
                                    switch (t == TokenType.RIGHT_PAREN | t == TokenType.RIGHT_BRACKET | t == TokenType.RIGHT_BRACE)
                                    {
                                        case (true) {
                                depth--;
                            }
                                        default {
                                            switch (depth == 0)
                                            {
                                                case (true) {
                                switch (t == TokenType.SEMICOLON)
                                {
                                    case (true) {
                                    this.advance();
                                    -> commas;
                                }
                                    default {
                                        switch (t == TokenType.ASSIGN | t == TokenType.ADDRESS_ASSIGN)
                                        {
                                            case (true) {
                                    in_init = true;
                                }
                                            default {
                                                switch (t == TokenType.LESS_THAN & prev == TokenType.IDENTIFIER & !in_init)
                                                {
                                                    case (true) {
                                    angle++;
                                }
                                                    default {
                                                        switch (t == TokenType.GREATER_THAN & angle > 0)
                                                        {
                                                            case (true) {
                                    angle--;
                                }
                                                            default {
                                                                switch (t == TokenType.BITSHIFT_RIGHT & angle > 1)
                                                                {
                                                                    case (true) {
                                    angle = angle - 2;
                                }
                                                                    default {
                                                                        switch (t == TokenType.COMMA & angle == 0)
                                                                        {
                                                                            case (true) {
                                    commas++;
                                    in_init = false;
                                }
                                                                            default {};
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            }
                                                default {};
                                            };
                                        };
                                    };
                                };
                            };
                            prev = t;
                            this.advance();
                            switch (depth < 0)
                            {
                                case (true) { -> commas; }
                                default {};
                            };
                        };
                    };
                };
                -> commas;
            };


            is_list_feature(int feat) -> bool -> feat == Feat.USING_STATEMENT | feat == Feat.CONTRACT_DEF | feat == Feat.VARIABLE_DECLARATION | feat == Feat.VARIABLE_DECLARATION_STATEMENT;


            stub(int feat, int kind) -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* n = node_new(kind, line, col);
                switch (n == (Node*)0)
                {
                    case (true) {
                    this.failed = true;
                    this.err_kind = ParseErr.ALLOC;
                    -> n;
                }
                    default
                    {
                        n.flags = 65536;

                        this.stub_total++;
                        switch (this.feat_hits[feat] == 0)
                        {
                            case (true) { this.stub_features++; }
                            default {};
                        };
                        this.feat_hits[feat] = this.feat_hits[feat] + 1;

                        switch (this.verbose)
                        {
                            case (true) {
                            print(g"[BootstrapParser] \0");
                            print(feature_name(feat));
                            print(g" not implemented (line \0");
                            print(line);
                            print(g", col \0");
                            print(col);
                            println(g")\0");
                        }
                            default {
                                switch (this.feat_hits[feat] == 1)
                                {
                                    case (true) {
                            print(g"[BootstrapParser] \0");
                            print(feature_name(feat));
                            println(g" not implemented\0");
                        }
                                    default {};
                                };
                            };
                        };

                        int extra = this.skip_construct();
                        Node* x;
                        switch (this.is_list_feature(feat))
                        {
                            case (true) {
                            while (extra > 0)
                            {
                                x = node_new(kind, line, col);
                                switch (x == (Node*)0)
                                {
                                    case (true) { break; }
                                    default
                                    {
                                        x.flags = 65536;
                                        nv_push(this.pending, x);
                                        extra--;
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        -> n;
                    };
                };
            };


            report() -> void
            {
                int f;
                switch (this.stub_total == 0)
                {
                    case (true) { ->; }
                    default
                    {
                        println(g"[BootstrapParser] Stub summary:\0");
                        while (f < Feat.COUNT)
                        {
                            switch (this.feat_hits[f] != 0)
                            {
                                case (true) {
                                print(g"  \0");
                                print(feature_name(f));
                                print(g" : \0");
                                println(this.feat_hits[f]);
                            }
                                default {};
                            };
                            f++;
                        };
                        print(g"[BootstrapParser] \0");
                        print(this.stub_total);
                        print(g" construct(s) skipped across \0");
                        print(this.stub_features);
                        -> println(g" feature(s)\0");
                    };
                };
            };




            is_bare_function_def() -> bool
            {
                int m = this.mark();
                int depth, tdepth;
                bool r;

                if (this.expect(TokenType.FUNCTION_POINTER))
                {
                    this.advance();
                    r = this.expect(TokenType.IDENTIFIER);
                    this.reset(m);
                    return r;
                };
                if (this.expect(TokenType.NO_MANGLE)) { this.advance(); };
                if (!this.expect(TokenType.IDENTIFIER))
                {
                    this.reset(m);
                    return false;
                };
                this.advance();
                if (this.expect(TokenType.LESS_THAN))
                {

                    while (!this.expect(TokenType.EOF))
                    {
                        if (this.expect(TokenType.LESS_THAN)) { tdepth++; };
                        if (this.expect(TokenType.GREATER_THAN)) { tdepth--; };
                        if (this.expect(TokenType.BITSHIFT_RIGHT)) { tdepth = tdepth - 2; };
                        if (this.expect3(TokenType.SEMICOLON, TokenType.LEFT_PAREN, TokenType.RIGHT_PAREN))
                        {
                            this.reset(m);
                            return false;
                        };
                        this.advance();
                        if (tdepth <= 0) { break; };
                    };
                    if (tdepth != 0)
                    {
                        this.reset(m);
                        return false;
                    };
                };
                if (this.expect(TokenType.LEFT_PAREN))
                {
                    this.advance();
                    depth = 1;
                    while (depth > 0 & !this.expect(TokenType.EOF))
                    {
                        if (this.expect(TokenType.LEFT_PAREN)) { depth++; };
                        if (this.expect(TokenType.RIGHT_PAREN))
                        {
                            depth--;
                            if (depth == 0) { break; };
                        };
                        this.advance();
                    };
                    if (this.expect(TokenType.RIGHT_PAREN))
                    {
                        this.advance();
                        r = this.expect(TokenType.RETURN_ARROW);
                    };
                };
                this.reset(m);
                return r;
            };


            is_trait_prefixed_object() -> bool
            {
                int off = 1;
                int t;
                switch (!this.expect(TokenType.IDENTIFIER))
                {
                    case (true) { -> false; }
                    default
                    {
                        while (true)
                        {
                            t = this.type_at(off);
                            switch (t < 0)
                            {
                                case (true) { -> false; }
                                default
                                {
                                    switch (t == TokenType.OBJECT)
                                    {
                                        case (true) { -> true; }
                                        default
                                        {
                                            switch (t != TokenType.IDENTIFIER)
                                            {
                                                case (true) { -> false; }
                                                default
                                                {
                                                    off++;
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        -> false;
                    };
                };
            };


            skip_template_args() -> void
            {
                int depth = 1;
                this.advance();
                while (depth > 0 & !this.expect(TokenType.EOF))
                {
                    switch (this.expect(TokenType.LESS_THAN))
                    {
                        case (true) {
                        depth++;
                    }
                        default {
                            switch (this.expect(TokenType.GREATER_THAN))
                            {
                                case (true) {
                        depth--;
                        switch (depth == 0)
                        {
                            case (true) { break; }
                            default {};
                        };
                    }
                                default {};
                            };
                        };
                    };
                    this.advance();
                };
                switch (this.expect(TokenType.GREATER_THAN))
                {
                    case (true) { this.advance(); }
                    default {};
                };
                ->;
            };


            skip_brackets() -> void
            {
                int depth = 1;
                this.advance();
                while (depth > 0 & !this.expect(TokenType.EOF))
                {
                    switch (this.expect(TokenType.LEFT_BRACKET))
                    {
                        case (true) {
                        depth++;
                    }
                        default {
                            switch (this.expect(TokenType.RIGHT_BRACKET))
                            {
                                case (true) {
                        depth--;
                        switch (depth == 0)
                        {
                            case (true) { break; }
                            default {};
                        };
                    }
                                default {};
                            };
                        };
                    };
                    this.advance();
                };
                switch (this.expect(TokenType.RIGHT_BRACKET))
                {
                    case (true) { this.advance(); }
                    default {};
                };
                ->;
            };

            is_variable_declaration() -> bool
            {
                int m = this.mark();
                bool r = false;
                bool done = false;

                switch (this.expect(TokenType.CONST))
                {
                    case (true) { this.advance(); }
                    default {};
                };
                switch (this.expect(TokenType.VOLATILE))
                {
                    case (true) { this.advance(); }
                    default {};
                };
                switch (this.expect2(TokenType.SIGNED, TokenType.UNSIGNED))
                {
                    case (true) { this.advance(); }
                    default {};
                };
                switch (this.expect(TokenType.TIE))
                {
                    case (true) { this.advance(); }
                    default {};
                };

                switch (!this.is_base_type_token())
                {
                    case (true) {
                    this.reset(m);
                    -> false;
                }
                    default
                    {
                        this.advance();

                        while (this.expect(TokenType.SCOPE))
                        {
                            this.advance();
                            switch (this.expect(TokenType.IDENTIFIER))
                            {
                                case (true) {
                                this.advance();
                            }
                                default {
                                break;
                            };
                            };
                        };

                        switch (this.expect(TokenType.LESS_THAN))
                        {
                            case (true) { this.skip_template_args(); }
                            default {};
                        };

                        switch (this.expect(TokenType.LEFT_BRACE))
                        {
                            case (true) {
                            this.advance();
                            switch (this.expect(TokenType.SINT_LITERAL))
                            {
                                case (true) { this.advance(); }
                                default {};
                            };
                            switch (this.expect(TokenType.COLON))
                            {
                                case (true) {
                                this.advance();
                                switch (this.expect(TokenType.SINT_LITERAL))
                                {
                                    case (true) { this.advance(); }
                                    default {};
                                };
                            }
                                default {
                                    switch (this.expect(TokenType.SCOPE))
                                    {
                                        case (true) {
                                this.advance();
                                switch (this.expect(TokenType.SINT_LITERAL))
                                {
                                    case (true) { this.advance(); }
                                    default {};
                                };
                            }
                                        default {};
                                    };
                                };
                            };
                            switch (this.expect(TokenType.RIGHT_BRACE))
                            {
                                case (true) { this.advance(); }
                                default {};
                            };
                        }
                            default {};
                        };

                        while (this.expect(TokenType.MULTIPLY)) { this.advance(); };

                        while (this.expect(TokenType.LEFT_BRACKET))
                        {
                            this.skip_brackets();
                        };

                        while (this.expect(TokenType.MULTIPLY)) { this.advance(); };

                        switch (this.expect(TokenType.AS))
                        {
                            case (true) {
                            this.advance();
                            switch (this.expect(TokenType.VOID))
                            {
                                case (true) {
                                r = false;
                            }
                                default {
                                r = this.expect(TokenType.IDENTIFIER);
                            };
                            };
                            done = true;
                        }
                            default {};
                        };

                        switch (!done)
                        {
                            case (true) {
                            switch (this.expect(TokenType.IDENTIFIER))
                            {
                                case (true) {
                                this.advance();
                                r = this.expect4(TokenType.ASSIGN, TokenType.SEMICOLON, TokenType.LEFT_PAREN, TokenType.LEFT_BRACE)
                                  | this.expect4(TokenType.COMMA, TokenType.LEFT_BRACKET, TokenType.FROM, TokenType.ADDRESS_ASSIGN);
                            }
                                default {};
                            };
                        }
                            default {};
                        };

                        this.reset(m);
                        -> r;
                    };
                };
            };


            is_dual_assign_declaration() -> bool
            {
                int m = this.mark();
                bool r = false;

                switch (this.expect(TokenType.CONST))
                {
                    case (true) { this.advance(); }
                    default {};
                };
                switch (this.expect(TokenType.VOLATILE))
                {
                    case (true) { this.advance(); }
                    default {};
                };
                switch (this.expect2(TokenType.SIGNED, TokenType.UNSIGNED))
                {
                    case (true) { this.advance(); }
                    default {};
                };

                switch (!this.is_base_type_token())
                {
                    case (true) {
                    this.reset(m);
                    -> false;
                }
                    default
                    {
                        this.advance();

                        while (this.expect(TokenType.SCOPE))
                        {
                            this.advance();
                            switch (this.expect(TokenType.IDENTIFIER))
                            {
                                case (true) {
                                this.advance();
                            }
                                default {
                                break;
                            };
                            };
                        };

                        switch (this.expect(TokenType.LESS_THAN))
                        {
                            case (true) { this.skip_template_args(); }
                            default {};
                        };

                        switch (this.expect(TokenType.LEFT_BRACE))
                        {
                            case (true) {
                            this.advance();
                            switch (this.expect(TokenType.SINT_LITERAL))
                            {
                                case (true) { this.advance(); }
                                default {};
                            };
                            switch (this.expect2(TokenType.COLON, TokenType.SCOPE))
                            {
                                case (true) {
                                this.advance();
                                switch (this.expect(TokenType.SINT_LITERAL))
                                {
                                    case (true) { this.advance(); }
                                    default {};
                                };
                            }
                                default {};
                            };
                            switch (this.expect(TokenType.RIGHT_BRACE))
                            {
                                case (true) { this.advance(); }
                                default {};
                            };
                        }
                            default {};
                        };

                        while (this.expect(TokenType.MULTIPLY)) { this.advance(); };

                        while (this.expect(TokenType.LEFT_BRACKET))
                        {
                            this.skip_brackets();
                        };

                        r = this.expect(TokenType.XOR_OP);
                        this.reset(m);
                        -> r;
                    };
                };
            };


            is_type_func_receiver(int t) -> bool -> t == TokenType.BYTE | t == TokenType.SINT | t == TokenType.UINT | t == TokenType.SLONG | t == TokenType.ULONG | t == TokenType.FLOAT_KW | t == TokenType.DOUBLE_KW | t == TokenType.BOOL_KW | t == TokenType.TRUE | t == TokenType.FALSE | t == TokenType.SINT_LITERAL | t == TokenType.UINT_LITERAL | t == TokenType.SLONG_LITERAL | t == TokenType.ULONG_LITERAL | t == TokenType.FLOAT | t == TokenType.DOUBLE | t == TokenType.CHAR | t == TokenType.STRING_LITERAL | t == TokenType.F_STRING | t == TokenType.I_STRING;


            is_type_func_def() -> bool
            {
                int m = this.mark();
                int depth, depth_t;
                int t;
                bool r = false;
                bool ok = true;

                switch (this.expect(TokenType.TIE))
                {
                    case (true) { this.advance(); }
                    default {};
                };
                t = this.cur();
                switch (this.is_type_func_receiver(t))
                {
                    case (true) {
                    this.advance();
                }
                    default {
                        switch (t == TokenType.IDENTIFIER)
                        {
                            case (true) {
                    this.advance();
                }
                            default {
                    this.reset(m);
                    -> false;
                };
                        };
                    };
                };

                while (this.expect(TokenType.MULTIPLY)) { this.advance(); };

                switch (this.expect(TokenType.LEFT_BRACKET))
                {
                    case (true) {
                    this.advance();
                    switch (!this.expect(TokenType.RIGHT_BRACKET))
                    {
                        case (true) { ok = false; }
                        default {};
                    };
                    switch (ok)
                    {
                        case (true) { this.advance(); }
                        default {};
                    };
                }
                    default {};
                };

                switch (ok)
                {
                    case (true) {
                    switch (!this.expect(TokenType.DOT))
                    {
                        case (true) { ok = false; }
                        default {};
                    };
                }
                    default {};
                };
                switch (ok)
                {
                    case (true) {
                    this.advance();
                    switch (!this.expect4(TokenType.IDENTIFIER, TokenType.STRING_LITERAL, TokenType.F_STRING, TokenType.I_STRING))
                    {
                        case (true) { ok = false; }
                        default {};
                    };
                }
                    default {};
                };
                switch (ok)
                {
                    case (true) {
                    this.advance();
                    switch (this.expect2(TokenType.LESS_THAN, TokenType.RECURSE_ARROW))
                    {
                        case (true) {
                        this.advance();
                        depth_t = 1;
                        while (depth_t > 0 & !this.expect(TokenType.EOF))
                        {
                            switch (this.expect2(TokenType.LESS_THAN, TokenType.RECURSE_ARROW))
                            {
                                case (true) {
                                depth_t++;
                            }
                                default {
                                    switch (this.expect(TokenType.GREATER_THAN))
                                    {
                                        case (true) {
                                depth_t--;
                                switch (depth_t == 0)
                                {
                                    case (true) { break; }
                                    default {};
                                };
                            }
                                        default {};
                                    };
                                };
                            };
                            this.advance();
                        };
                        switch (!this.expect(TokenType.GREATER_THAN))
                        {
                            case (true) {
                            ok = false;
                        }
                            default {
                            this.advance();
                        };
                        };
                    }
                        default {};
                    };
                }
                    default {};
                };
                switch (ok)
                {
                    case (true) {
                    switch (!this.expect(TokenType.LEFT_PAREN))
                    {
                        case (true) { ok = false; }
                        default {};
                    };
                }
                    default {};
                };
                switch (ok)
                {
                    case (true) {
                    this.advance();
                    depth = 1;
                    while (depth > 0 & !this.expect(TokenType.EOF))
                    {
                        switch (this.expect(TokenType.LEFT_PAREN))
                        {
                            case (true) {
                            depth++;
                        }
                            default {
                                switch (this.expect(TokenType.RIGHT_PAREN))
                                {
                                    case (true) {
                            depth--;
                            switch (depth == 0)
                            {
                                case (true) { break; }
                                default {};
                            };
                        }
                                    default {};
                                };
                            };
                        };
                        this.advance();
                    };
                    switch (!this.expect(TokenType.RIGHT_PAREN))
                    {
                        case (true) { ok = false; }
                        default {};
                    };
                }
                    default {};
                };
                switch (ok)
                {
                    case (true) {
                    this.advance();
                    r = this.expect(TokenType.RETURN_ARROW);
                }
                    default {};
                };

                this.reset(m);
                -> r;
            };






            macro_def() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* s = this.mk(NodeKind.MACRO_DEF_STATEMENT, line, col);
                switch (this.failed)
                {
                    case (true) { -> s; }
                    default
                    {
                        Node* d = this.mk(NodeKind.MACRO_DEF, line, col);
                        switch (this.failed)
                        {
                            case (true) {
                            node_free(s);
                            -> d;
                        }
                            default
                            {
                                s.a = d;
                                Node* p;
                                bool more;
                                this.advance();
                                d.text = this.ident();
                                switch (this.failed)
                                {
                                    case (true) { -> this.done(s); }
                                    default
                                    {
                                        switch (!this.consume(TokenType.LEFT_PAREN))
                                        {
                                            case (true) { -> this.done(s); }
                                            default
                                            {
                                                switch (!this.expect(TokenType.RIGHT_PAREN))
                                                {
                                                    case (true) {
                                                    more = true;
                                                    while (more & !this.failed)
                                                    {
                                                        p = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                                                        switch (this.failed)
                                                        {
                                                            case (true) { break; }
                                                            default
                                                            {
                                                                node_push(d, 0, p);
                                                                p.text = this.ident();
                                                                switch (this.failed)
                                                                {
                                                                    case (true) { break; }
                                                                    default
                                                                    {
                                                                        more = this.expect(TokenType.COMMA);
                                                                        switch (more)
                                                                        {
                                                                            case (true) { this.advance(); }
                                                                            default {};
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (!this.failed)
                                                {
                                                    case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                                    default {};
                                                };
                                                switch (this.failed)
                                                {
                                                    case (true) { -> this.done(s); }
                                                    default
                                                    {
                                                        nm_put(this.macros, d.text, (void*)this.macros);
                                                        switch (!this.consume(TokenType.LEFT_BRACE))
                                                        {
                                                            case (true) { -> this.done(s); }
                                                            default
                                                            {
                                                                d.a = this.expression();
                                                                switch (this.failed)
                                                                {
                                                                    case (true) { -> this.done(s); }
                                                                    default
                                                                    {
                                                                        switch (this.expect(TokenType.SEMICOLON))
                                                                        {
                                                                            case (true) { this.advance(); }
                                                                            default {};
                                                                        };
                                                                        switch (!this.consume(TokenType.RIGHT_BRACE))
                                                                        {
                                                                            case (true) { -> this.done(s); }
                                                                            default
                                                                            {
                                                                                this.consume(TokenType.SEMICOLON);
                                                                                -> this.done(s);
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            effect_def() -> Node*
            {
                Node* n = this.mk(NodeKind.EFFECT_DEF, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        byte* sub;
                        this.advance();
                        byte* name = this.ident();
                        switch (this.failed)
                        {
                            case (true) { -> this.done(n); }
                            default
                            {
                                while (this.expect(TokenType.DOT))
                                {
                                    this.advance();
                                    sub = this.ident();
                                    switch (this.failed)
                                    {
                                        case (true) { break; }
                                        default
                                        {
                                            name = this.cat2(this.cat2(name, g".\0"), sub);
                                        };
                                    };
                                };
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.LEFT_BRACE); }
                                    default {};
                                };
                                switch (!this.failed)
                                {
                                    case (true) { n.a = this.effect_expr(); }
                                    default {};
                                };
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                    default {};
                                };
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.SEMICOLON); }
                                    default {};
                                };
                                n.text = name;
                                -> this.done(n);
                            };
                        };
                    };
                };
            };


            interface_error(byte* head, byte* name, byte* tail) -> void
            {
                this.sb.len = 0;
                this.sb.put_str(head);
                switch (name != (byte*)0)
                {
                    case (true) {
                    this.sb.put_str(f"{name}' must have a trait constraint (e.g. {name}{tail}\0");
                }
                    default {
                    this.sb.put_str(tail);
                };
                };
                this.sb.put_str(f" [{this.cur_line()}:{this.cur_col()}]\0");
                this.error(this.own_n(this.sb.mem, this.sb.len));
                ->;
            };



            interface_protos(Node* holder) -> void
            {
                int pl, pc;
                Node* f;
                Node* prm;
                bool more;
                switch (!this.consume(TokenType.LEFT_BRACE))
                {
                    case (true) { ->; }
                    default
                    {
                        while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                        {
                            pl = this.cur_line();
                            pc = this.cur_col();
                            f = this.mk(NodeKind.FUNCTION_DEF, pl, pc);
                            switch (this.failed)
                            {
                                case (true) { ->; }
                                default
                                {
                                    node_push(holder, 0, f);
                                    f.text = this.ident();
                                    switch (!this.failed)
                                    {
                                        case (true) { this.consume(TokenType.LEFT_PAREN); }
                                        default {};
                                    };
                                    switch (!this.failed & !this.expect(TokenType.RIGHT_PAREN))
                                    {
                                        case (true) {
                                        more = true;
                                        while (more & !this.failed)
                                        {
                                            prm = this.mk(NodeKind.PARAMETER, pl, pc);
                                            switch (this.failed)
                                            {
                                                case (true) { break; }
                                                default
                                                {
                                                    node_push(f, 0, prm);
                                                    prm.ts = this.type_spec();
                                                    switch (this.failed)
                                                    {
                                                        case (true) { break; }
                                                        default
                                                        {
                                                            prm.text = this.ident();
                                                            switch (this.failed)
                                                            {
                                                                case (true) { break; }
                                                                default
                                                                {
                                                                    more = this.expect(TokenType.COMMA);
                                                                    switch (more)
                                                                    {
                                                                        case (true) { this.advance(); }
                                                                        default {};
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    }
                                        default {};
                                    };
                                    switch (!this.failed)
                                    {
                                        case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                        default {};
                                    };
                                    switch (!this.failed)
                                    {
                                        case (true) { this.consume(TokenType.RETURN_ARROW); }
                                        default {};
                                    };
                                    switch (!this.failed)
                                    {
                                        case (true) { f.ts = this.type_spec(); }
                                        default {};
                                    };
                                    switch (this.failed)
                                    {
                                        case (true) { ->; }
                                        default
                                        {
                                            this.mark_proto(f);
                                            switch (this.failed)
                                            {
                                                case (true) { ->; }
                                                default
                                                {
                                                    switch (this.expect(TokenType.COMMA))
                                                    {
                                                        case (true) { this.advance(); }
                                                        default { break; };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.RIGHT_BRACE); }
                            default {};
                        };
                        ->;
                    };
                };
            };






            interface_def() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* n = this.mk(NodeKind.INTERFACE_DEF, line, col);
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        Node* p;
                        Node* pr;
                        byte* first;
                        bool more;
                        this.advance();
                        n.text = this.ident();
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.LEFT_PAREN); }
                            default {};
                        };
                        switch (!this.failed & !this.expect(TokenType.RIGHT_PAREN))
                        {
                            case (true) {
                            more = true;
                            while (more & !this.failed)
                            {
                                p = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                                switch (this.failed)
                                {
                                    case (true) { break; }
                                    default
                                    {
                                        node_push(n, 0, p);
                                        p.text = this.ident();
                                        switch (this.failed)
                                        {
                                            case (true) { break; }
                                            default
                                            {
                                                switch (!this.expect(TokenType.COLON))
                                                {
                                                    case (true) {
                                                    this.interface_error(g"Interface parameter '\0", p.text, g": SomeTrait)\0");
                                                    break;
                                                }
                                                    default
                                                    {
                                                        this.advance();
                                                        p.text2 = this.ident();
                                                        switch (this.failed)
                                                        {
                                                            case (true) { break; }
                                                            default
                                                            {
                                                                more = this.expect(TokenType.COMMA);
                                                                switch (more)
                                                                {
                                                                    case (true) { this.advance(); }
                                                                    default {};
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.RIGHT_PAREN); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.LEFT_BRACE); }
                            default {};
                        };
                        while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                        {
                            pr = this.mk(NodeKind.INTERFACE_PROTOCOL, line, col);
                            switch (this.failed)
                            {
                                case (true) { break; }
                                default
                                {
                                    node_push(n, 1, pr);
                                    first = this.ident();
                                    switch (this.failed)
                                    {
                                        case (true) { break; }
                                        default
                                        {
                                            switch (this.expect(TokenType.COLON))
                                            {
                                                case (true) {
                                                this.advance();
                                                pr.text = first;
                                                pr.text2 = this.ident();
                                                pr.op = ProtocolKind.CALL_ON;
                                            }
                                                default {
                                                    switch (this.expect(TokenType.LEFT_PAREN))
                                                    {
                                                        case (true) {
                                                this.advance();
                                                pr.text = this.ident();
                                                switch (!this.failed)
                                                {
                                                    case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                                    default {};
                                                };
                                                pr.text2 = first;
                                                pr.op = ProtocolKind.PASS_INTO;
                                            }
                                                        default {
                                                            switch (this.expect(TokenType.RETURN_ARROW))
                                                            {
                                                                case (true) {
                                                this.advance();
                                                pr.text = first;
                                                pr.text2 = this.ident();
                                                pr.op = ProtocolKind.RETURN_TO;
                                            }
                                                                default {
                                                this.interface_error(g"Expected ':', '(' or '->' in interface protocol block\0", (byte*)0, g"\0");
                                                break;
                                            };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                            switch (this.failed)
                                            {
                                                case (true) { break; }
                                                default
                                                {
                                                    this.interface_protos(pr);
                                                    switch (!this.failed)
                                                    {
                                                        case (true) { this.consume(TokenType.SEMICOLON); }
                                                        default {};
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.RIGHT_BRACE); }
                            default {};
                        };
                        while (!this.failed & this.expect(TokenType.TAG))
                        {
                            this.advance();
                            switch (this.expect(TokenType.EFFECT))
                            {
                                case (true) {
                                node_free(n.b);
                                n.b = this.effect_annotation(NodeKind.EFFECT_ANNOTATION);
                            }
                                default {
                                    switch (this.expect(TokenType.IDENTIFIER) & this.val_is(g"attenuate\0", 9))
                                    {
                                        case (true) {
                                node_free(n.a);
                                n.a = this.effect_annotation(NodeKind.ATTENUATE_ANNOTATION);
                            }
                                        default {
                                this.error(g"Expected 'effect' or 'attenuate' after '#' in interface definition\0");
                            };
                                    };
                                };
                            };
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        -> this.done(n);
                    };
                };
            };



            deprecate_statement() -> Node*
            {
                Node* n = this.mk(NodeKind.DEPRECATE_STATEMENT, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.advance();
                        byte* path = this.ident();
                        byte* part;
                        while (!this.failed & this.expect(TokenType.SCOPE))
                        {
                            this.advance();
                            part = this.ident();
                            switch (this.failed)
                            {
                                case (true) { break; }
                                default
                                {
                                    path = this.cat2(this.cat2(path, g"::\0"), part);
                                };
                            };
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        n.text = path;
                        -> this.done(n);
                    };
                };
            };




            tp_active(byte* name) -> bool
            {
                switch (this.active_tp == (NameMap*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        -> nm_has(this.active_tp, name);
                    };
                };
            };




            tp_mentions(byte* s) -> bool
            {
                int i, st, n = pp_cstrlen(s);
                byte c;
                bool r = false;
                if (this.active_tp == (NameMap*)0) { -> false; };
                while (i < n & !r)
                {
                    c = s[i];
                    if ((c >= 'A' & c <= 'Z') | (c >= 'a' & c <= 'z') | c == '_')
                    {
                        st = i;
                        while (i < n & ((s[i] >= 'A' & s[i] <= 'Z') | (s[i] >= 'a' & s[i] <= 'z') | s[i] == '_' | (s[i] >= '0' & s[i] <= '9'))) { i++; };
                        r = this.tp_active(this.own_n(s + st, i - st));
                    }
                    else { i++; };
                };
                -> r;
            };

            tp_activate(TemplateEntry* e) -> void
            {
                NameMap* a = nm_new();
                int i;
                while (i < e.params.len)
                {
                    nm_put(a, (byte*)e.params.items[i], (void*)a);
                    i++;
                };
                this.active_tp = a;
                ->;
            };


            tp_id(bool cg) -> byte*
            {
                switch (cg & this.expect(TokenType.CODIFY))
                {
                    case (true) { -> this.consume_codify(); }
                    default
                    {
                        -> this.ident();
                    };
                };
            };


            tp_idlist(bool cg) -> PtrVec*
            {
                PtrVec* v = pv_new();
                pv_push(v, (void*)this.tp_id(cg));
                while (!this.failed & this.expect(TokenType.LOGICAL_AND))
                {
                    this.advance();
                    pv_push(v, (void*)this.tp_id(cg));
                };
                -> v;
            };


            tp_repr(TypeSpec* t) -> byte*
            {
                int i;
                this.sb.len = 0;
                switch (t.custom_typename != (byte*)0)
                {
                    case (true) { this.sb.put_str(t.custom_typename); }
                    default { this.sb.put_str(datatype_text(t.base_type)); };
                };
                switch (ts_is_pointer(t))
                {
                    case (true) {
                    while (i < t.pointer_depth)
                    {
                        this.sb.put('*');
                        i++;
                    };
                }
                    default {};
                };
                switch (ts_is_array(t))
                {
                    case (true) { this.sb.put_str(g"[]\0"); }
                    default {};
                };
                -> this.own_n(this.sb.mem, this.sb.len);
            };


            tp_map_name(PtrVec* fnames, PtrVec* to, byte* n) -> byte*
            {
                int i = fnames.len;
                switch (to.len < i)
                {
                    case (true) { i = to.len; }
                    default {};
                };
                while (i > 0)
                {
                    i--;
                    switch (cstr_eq((byte*)fnames.items[i], n))
                    {
                        case (true) { -> (byte*)to.items[i]; }
                        default {};
                    };
                };
                -> n;
            };


            tp_copy_rels(TemplateEntry* e, Node* cs, PtrVec* to) -> void
            {
                PtrVec* fnames = pv_new();
                PtrVec* lhs;
                PtrVec* rhs;
                Node* rel;
                int i, k, n;
                while (i < node_count(cs, 0))
                {
                    pv_push(fnames, (void*)node_child(cs, 0, i).text);
                    i++;
                };
                i = 0;
                n = node_count(cs, 1);
                while (i < n & !this.failed)
                {
                    rel = node_child(cs, 1, i);
                    lhs = pv_new();
                    rhs = pv_new();
                    k = 0;
                    while (k < node_count(rel, 0))
                    {
                        pv_push(lhs, (void*)this.tp_map_name(fnames, to, node_child(rel, 0, k).text));
                        k++;
                    };
                    k = 0;
                    while (k < node_count(rel, 1))
                    {
                        pv_push(rhs, (void*)this.tp_map_name(fnames, to, node_child(rel, 1, k).text));
                        k++;
                    };
                    this.cs_emit(e.rels, lhs, rel.text, rhs, rel.line, rel.col);
                    pv_free(lhs);
                    pv_free(rhs);
                    i++;
                };
                -> pv_free(fnames);
            };

            tp_has_param(TemplateEntry* e, byte* n) -> bool
            {
                int i;
                while (i < e.params.len)
                {
                    switch (cstr_eq((byte*)e.params.items[i], n))
                    {
                        case (true) { -> true; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> false;
            };


            tp_cs_entry(TemplateEntry* e, bool cg) -> void
            {
                int m = this.mark();
                int line = this.cur_line();
                int col = this.cur_col();
                bool codify = false;
                byte* name;
                Node* csd;
                PtrVec* args;
                PtrVec* lhs;
                PtrVec* rhs;
                byte* op;
                int i;
                switch (cg & this.expect(TokenType.CODIFY))
                {
                    case (true) {
                    name = this.consume_codify();
                    codify = true;
                }
                    default {
                    name = this.ident();
                };
                };
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (!codify & this.expect(TokenType.LEFT_PAREN))
                        {
                            case (true) {
                            switch (!nm_has(this.constras, name))
                            {
                                case (true) {
                                this.sb.len = 0;
                                this.sb.put_str(f"Unknown named constraint set '{name}'\0");
                                -> this.cs_error_at(m);
                            }
                                default {};
                            };
                            csd = (Node*)nm_get(this.constras, name);
                            this.advance();
                            args = pv_new();
                            switch (!this.expect(TokenType.RIGHT_PAREN))
                            {
                                case (true) {
                                pv_push(args, (void*)this.ident());
                                while (!this.failed & this.expect(TokenType.COMMA))
                                {
                                    this.advance();
                                    pv_push(args, (void*)this.ident());
                                };
                            }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                default {};
                            };
                            switch (this.failed)
                            {
                                case (true) {
                                -> pv_free(args);
                            }
                                default {};
                            };
                            switch (args.len != node_count(csd, 0))
                            {
                                case (true) {
                                this.sb.len = 0;
                                this.sb.put_str(f"Named constraint set '{name}' expects {node_count(csd, 0)} argument(s), got {args.len}\0");
                                this.cs_error_at(m);
                                -> pv_free(args);
                            }
                                default {};
                            };
                            i = 0;
                            while (i < args.len)
                            {
                                switch (!this.tp_has_param(e, (byte*)args.items[i]))
                                {
                                    case (true) {
                                    this.sb.len = 0;
                                    this.sb.put('\'');
                                    this.sb.put_str((byte*)args.items[i]);
                                    this.sb.put_str(g"' is not a template parameter; valid parameters are: \0");
                                    this.tp_put_params(e);
                                    this.error(this.own_n(this.sb.mem, this.sb.len));
                                    -> pv_free(args);
                                }
                                    default {};
                                };
                                i++;
                            };
                            this.tp_copy_rels(e, csd, args);
                            -> pv_free(args);
                        }
                            default
                            {
                                switch (!codify & nm_has(this.constras, name) & !(this.expect(TokenType.LOGICAL_AND) | this.is_relop()))
                                {
                                    case (true) {
                                    csd = (Node*)nm_get(this.constras, name);
                                    switch (e.params.len != node_count(csd, 0))
                                    {
                                        case (true) {
                                        this.sb.len = 0;
                                        this.sb.put_str(f"Named constraint set '{name}' has {node_count(csd, 0)} parameter(s) but the template has {e.params.len} parameter(s); use explicit arguments: '{name}(...)'\0");
                                        -> this.cs_error_at(m);
                                    }
                                        default {};
                                    };
                                    -> this.tp_copy_rels(e, csd, e.params);
                                }
                                    default
                                    {
                                        lhs = pv_new();
                                        pv_push(lhs, (void*)name);
                                        while (!this.failed & this.expect(TokenType.LOGICAL_AND))
                                        {
                                            this.advance();
                                            pv_push(lhs, (void*)this.tp_id(cg));
                                        };
                                        switch (!this.failed)
                                        {
                                            case (true) {
                                            op = this.consume_relop();
                                            switch (!this.failed)
                                            {
                                                case (true) {
                                                rhs = this.tp_idlist(cg);
                                                switch (!this.failed)
                                                {
                                                    case (true) { this.cs_emit(e.rels, lhs, op, rhs, line, col); }
                                                    default {};
                                                };
                                                pv_free(rhs);
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        -> pv_free(lhs);
                                    };
                                };
                            };
                        };
                    };
                };
            };


            tp_put_params(TemplateEntry* e) -> void
            {
                int i;
                while (i < e.params.len)
                {
                    switch (i > 0)
                    {
                        case (true) { this.sb.put_str(g", \0"); }
                        default {};
                    };
                    this.sb.put_str((byte*)e.params.items[i]);
                    i++;
                };
                ->;
            };


            tp_constraint_set(TemplateEntry* e, bool cg) -> void
            {
                this.consume(TokenType.COLON);
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.LEFT_BRACE); }
                    default {};
                };
                switch (!this.failed)
                {
                    case (true) { this.tp_cs_entry(e, cg); }
                    default {};
                };
                while (!this.failed & this.expect(TokenType.COMMA))
                {
                    this.advance();
                    this.tp_cs_entry(e, cg);
                };
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.RIGHT_BRACE); }
                    default {};
                };
                ->;
            };


            tp_param_entry(TemplateEntry* e, byte* name) -> void
            {
                pv_push(e.params, (void*)name);
                switch (!this.expect(TokenType.COLON))
                {
                    case (true) { ->; }
                    default
                    {
                        this.advance();
                        bool saw_default = false;
                        bool is_def, more;
                        int dm = -1;
                        TypeSpec* ts;
                        TypeSpec* dts = (TypeSpec*)0;
                        byte* src;
                        more = true;
                        while (more & !this.failed)
                        {
                            is_def = this.expect(TokenType.PLUS);
                            switch (is_def)
                            {
                                case (true) {
                                switch (dm < 0)
                                {
                                    case (true) { dm = this.mark(); }
                                    default {};
                                };
                                this.advance();
                                saw_default = true;
                            }
                                default {};
                            };
                            src = (byte*)0;
                            switch (this.expect(TokenType.STRING_LITERAL))
                            {
                                case (true) { src = g"\"\"\0"; }
                                default {};
                            };
                            ts = this.type_spec();
                            switch (this.failed)
                            {
                                case (true) {
                                switch (ts != (TypeSpec*)0)
                                {
                                    case (true) { typespec_free(ts); }
                                    default {};
                                };
                                ->;
                            }
                                default
                                {
                                    switch (src == (byte*)0)
                                    {
                                        case (true) { src = this.tp_repr(ts); }
                                        default {};
                                    };
                                    pv_push(e.cparam, (void*)name);
                                    pv_push(e.cts, (void*)ts);
                                    pv_push(e.ctext, (void*)src);
                                    switch (is_def)
                                    {
                                        case (true) { dts = ts; }
                                        default {};
                                    };
                                    more = this.expect(TokenType.LOGICAL_OR);
                                    switch (more)
                                    {
                                        case (true) { this.advance(); }
                                        default {};
                                    };
                                };
                            };
                        };
                        switch (this.failed | !saw_default)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch (nm_has(e.no_default, name))
                                {
                                    case (true) {
                                    this.reset(dm);
                                    this.sb.len = 0;
                                    this.sb.put_str(f"Template parameter '{name}' is marked '!+' (no default) but a default type was supplied with '+'\0");
                                    this.error(this.own_n(this.sb.mem, this.sb.len));
                                    ->;
                                }
                                    default
                                    {
                                        pv_push(e.dparam, (void*)name);
                                        -> pv_push(e.dts, (void*)typespec_copy(dts));
                                    };
                                };
                            };
                        };
                    };
                };
            };


            tp_rel_misplaced(byte* id, bool first) -> void
            {
                this.sb.len = 0;
                this.sb.put_str(g"Relational template constraints must be wrapped in a constraint set\0");
                switch (first)
                {
                    case (true) { this.sb.put_str(g" as :{T ~= U}. Did you mean :{\0"); }
                    default { this.sb.put_str(g": :{T ~= U}. Did you mean :{\0"); };
                };
                this.sb.put_str(id);
                this.sb.put_str(g" ~= ...}, or did you intend a type constraint \0");
                this.sb.put_str(f"{id}: ?\0");
                this.error(this.own_n(this.sb.mem, this.sb.len));
                ->;
            };


            tp_entry(TemplateEntry* e, bool cg, bool first) -> void
            {
                bool nd = false;
                byte* id;
                switch (this.expect(TokenType.COLON))
                {
                    case (true) {
                    -> this.tp_constraint_set(e, cg);
                }
                    default
                    {
                        switch (this.expect(TokenType.NOT))
                        {
                            case (true) {
                            this.advance();
                            this.consume(TokenType.PLUS);
                            nd = true;
                        }
                            default {};
                        };
                        switch (this.failed)
                        {
                            case (true) { ->; }
                            default
                            {
                                id = this.tp_id(cg);
                                switch (this.failed)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        switch (nd)
                                        {
                                            case (true) { nm_put(e.no_default, id, (void*)e); }
                                            default {};
                                        };
                                        switch (this.expect(TokenType.LOGICAL_AND) | this.is_relop())
                                        {
                                            case (true) {
                                            -> this.tp_rel_misplaced(id, first);
                                        }
                                            default
                                            {
                                                -> this.tp_param_entry(e, id);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            template_params(bool cg) -> TemplateEntry*
            {
                TemplateEntry* e = te_new();
                this.advance();
                this.tp_entry(e, cg, true);
                while (!this.failed & this.expect(TokenType.COMMA))
                {
                    this.advance();
                    this.tp_entry(e, cg, false);
                };
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.GREATER_THAN); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) {
                    te_free(e);
                    -> (TemplateEntry*)0;
                }
                    default
                    {
                        -> e;
                    };
                };
            };

            template_lookup(byte* name) -> TemplateEntry*
            {
                switch (name == (byte*)0)
                {
                    case (true) { -> (TemplateEntry*)0; }
                    default
                    {
                        switch (!nm_has(this.templates, name))
                        {
                            case (true) { -> (TemplateEntry*)0; }
                            default
                            {
                                -> (TemplateEntry*)nm_get(this.templates, name);
                            };
                        };
                    };
                };
            };

            template_alias(byte* alias, byte* original) -> void
            {
                switch (!nm_has(this.templates, original))
                {
                    case (true) { ->; }
                    default
                    {
                        -> nm_put(this.templates, this.own(ts_dup(alias)), nm_get(this.templates, original));
                    };
                };
            };



            register_template(byte* name, int kind, TemplateEntry* e, Node* node) -> void
            {
                TemplateEntry* ex = this.template_lookup(name);
                PtrVec* tv;
                Node* tn;
                NameMap* tm;
                bool same;
                switch (ex != (TemplateEntry*)0)
                {
                    case (true) { same = ex.kind == kind; }
                    default {};
                };
                switch (same)
                {
                    case (true) {
                    tv = ex.params; ex.params = e.params; e.params = tv;
                    tn = ex.node; ex.node = node; node_free(tn);
                    switch (e.cparam.len > 0)
                    {
                        case (true) {
                        tv = ex.cparam; ex.cparam = e.cparam; e.cparam = tv;
                        tv = ex.cts; ex.cts = e.cts; e.cts = tv;
                        tv = ex.ctext; ex.ctext = e.ctext; e.ctext = tv;
                    }
                        default {};
                    };
                    switch (node_count(e.rels, 1) > 0)
                    {
                        case (true) {
                        tn = ex.rels; ex.rels = e.rels; e.rels = tn;
                    }
                        default {};
                    };
                    switch (e.dparam.len > 0)
                    {
                        case (true) {
                        tv = ex.dparam; ex.dparam = e.dparam; e.dparam = tv;
                        tv = ex.dts; ex.dts = e.dts; e.dts = tv;
                    }
                        default {};
                    };
                    switch (e.no_default.count > 0)
                    {
                        case (true) {
                        tm = ex.no_default; ex.no_default = e.no_default; e.no_default = tm;
                    }
                        default {};
                    };
                    -> te_free(e);
                }
                    default
                    {
                        e.kind = kind;
                        e.node = node;
                        nm_put(this.templates, this.own(ts_dup(name)), (void*)e);
                        -> pv_push(this.tentries, (void*)e);
                    };
                };
            };




            error_at(byte* msg, int line, int col) -> void
            {
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        this.failed = true;
                        this.err_kind = ParseErr.MESSAGE;
                        this.err_msg = msg;
                        this.err_line = line;
                        this.err_col = col;
                        ->;
                    };
                };
            };


            chk_get() -> Checker*
            {
                switch (this.chk == (Checker*)0)
                {
                    case (true) {
                    this.chk = (Checker*)fmalloc((u64)((sizeof(Checker) + 7) / 8));
                    this.chk.__init(this.st);
                }
                    default {};
                };
                -> this.chk;
            };


            chk_fail(int first) -> void
            {
                Diag* d = (Diag*)this.chk.diags.items[first];
                -> this.error_at(this.own(ts_dup(d.msg)), d.line, d.col);
            };


            ts_mangle(TypeSpec* t) -> byte*
            {
                TypeSpec* inner;
                byte* s;
                switch (t.custom_typename != (byte*)0)
                {
                    case (true) { -> t.custom_typename; }
                    default
                    {
                        switch (ts_is_pointer(t))
                        {
                            case (true) {
                            inner = typespec_new();
                            inner.base_type = t.base_type;
                            inner.bit_width = t.bit_width;
                            inner.flags = 1;
                            s = this.ts_mangle(inner);
                            typespec_free(inner);
                            -> this.cat2(g"ptr_\0", s);
                        }
                            default
                            {
                                switch (t.base_type == DataType.DATA & t.bit_width > 0)
                                {
                                    case (true) {
                                    this.sb.len = 0;
                                    this.sb.put_str(g"data_\0");
                                    switch (ts_is_signed(t))
                                    {
                                        case (true) { this.sb.put('i'); }
                                        default { this.sb.put('u'); };
                                    };
                                    this.sb.put_int(t.bit_width);
                                    -> this.own_n(this.sb.mem, this.sb.len);
                                }
                                    default
                                    {
                                        -> datatype_text(t.base_type);
                                    };
                                };
                            };
                        };
                    };
                };
            };


            tmp_type() -> TypeSpec*
            {
                TypeSpec* t = typespec_new();
                pv_push(this.tmp_ts, (void*)t);
                -> t;
            };


            tp_mapping(TemplateEntry* te, PtrVec* names, PtrVec* specs) -> NameMap*
            {
                NameMap* m = nm_new();
                int i, k;
                TypeSpec* r;
                byte* tn;
                while (i < te.params.len & i < names.len)
                {
                    tn = (byte*)names.items[i];
                    r = (TypeSpec*)0;
                    switch (specs != (PtrVec*)0)
                    {
                        case (true) {
                        switch (i < specs.len)
                        {
                            case (true) { r = (TypeSpec*)specs.items[i]; }
                            default {};
                        };
                    }
                        default {};
                    };
                    switch (r == (TypeSpec*)0 & this.st != (IDKC_SYMTABLE*)0)
                    {
                        case (true) { r = st_get_type_spec(this.st, tn); }
                        default {};
                    };
                    k = 0;
                    while (r == (TypeSpec*)0 & k < 18)
                    {
                        switch (cstr_eq(datatype_text(k), tn))
                        {
                            case (true) {
                            r = this.tmp_type();
                            r.base_type = k;
                            switch (k == DataType.SINT | k == DataType.CHAR)
                            {
                                case (true) { r.flags = 1; }
                                default {};
                            };
                        }
                            default {};
                        };
                        k++;
                    };
                    switch (r == (TypeSpec*)0)
                    {
                        case (true) {
                        r = this.tmp_type();
                        r.base_type = DataType.DATA;
                        r.custom_typename = tn;
                    }
                        default {};
                    };
                    nm_put(m, (byte*)te.params.items[i], (void*)r);
                    i++;
                };
                -> m;
            };



            subst_ts(TypeSpec* t, NameMap* map) -> TypeSpec*
            {
                TypeSpec* r;
                switch (t == (TypeSpec*)0)
                {
                    case (true) { -> t; }
                    default
                    {
                        switch (t.base_type == DataType.DICT)
                        {
                            case (true) {
                            t.dict_key = this.subst_ts(t.dict_key, map);
                            t.dict_value = this.subst_ts(t.dict_value, map);
                            -> t;
                        }
                            default
                            {
                                switch (t.custom_typename == (byte*)0)
                                {
                                    case (true) { -> t; }
                                    default
                                    {
                                        switch (!nm_has(map, t.custom_typename))
                                        {
                                            case (true) {
                                            t.custom_typename = this.subst_deferred_type(t.custom_typename, map);
                                            -> t;
                                        }
                                            default
                                            {
                                                r = typespec_copy((TypeSpec*)nm_get(map, t.custom_typename));
                                                switch (ts_is_pointer(t))
                                                {
                                                    case (true) {
                                                    r.flags = r.flags `| 64;
                                                    r.pointer_depth = r.pointer_depth + t.pointer_depth;
                                                }
                                                    default {};
                                                };
                                                switch (ts_is_array(t))
                                                {
                                                    case (true) {
                                                    r.flags = r.flags `| 32;
                                                    r.array_dims = nv_clone(t.array_dims);
                                                    switch (r.array_dims != (NodeVec*)0)
                                                    {
                                                        case (true) {
                                                        switch (r.array_dims.len > 0)
                                                        {
                                                            case (true) { r.array_size = r.array_dims.items[0]; }
                                                            default {};
                                                        };
                                                    }
                                                        default {
                                                        r.array_size = node_clone(t.array_size);
                                                    };
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch ((t.flags `& 2) != 0)
                                                {
                                                    case (true) { r.flags = r.flags `| 2; }
                                                    default {};
                                                };
                                                switch ((t.flags `& 4) != 0)
                                                {
                                                    case (true) { r.flags = r.flags `| 4; }
                                                    default {};
                                                };
                                                typespec_free(t);
                                                -> r;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            tp_split_deferred(byte* s, PtrVec* out) -> int
            {
                int i, lt, start, e, depth;
                int n = pp_cstrlen(s);
                lt = -1;
                while (i < n & lt < 0)
                {
                    switch (s[i] == '<')
                    {
                        case (true) { lt = i; }
                        default {};
                    };
                    i++;
                };
                switch (lt < 0)
                {
                    case (true) { -> -1; }
                    default
                    {
                        switch (s[n - 1] != '>')
                        {
                            case (true) { -> -1; }
                            default
                            {
                                start = lt + 1;
                                i = start;
                                while (i <= n - 1)
                                {
                                    switch (s[i] == '<') { case (true) { depth++; } default {}; };
                                    switch (s[i] == '>' & i < n - 1) { case (true) { depth--; } default {}; };
                                    switch (i == n - 1 | (s[i] == ',' & depth == 0))
                                    {
                                        case (true) {
                                        e = i;
                                        while (start < e & s[start] == ' ') { start++; };
                                        while (e > start & s[e - 1] == ' ') { e--; };
                                        pv_push(out, (void*)this.own_n(s + start, e - start));
                                        start = i + 1;
                                    }
                                        default {};
                                    };
                                    i++;
                                };
                                -> lt;
                            };
                        };
                    };
                };
            };


            subst_deferred_call(Node* n, NameMap* map) -> void
            {
                PtrVec* raw = pv_new();
                PtrVec* names = pv_new();
                PtrVec* specs = pv_new();
                int lt = this.tp_split_deferred(n.text, raw);
                int i;
                bool any = false;
                byte* base;
                TemplateEntry* fe;
                TypeSpec* c;
                byte* a;
                switch (lt > 0)
                {
                    case (true) {
                    base = this.own_n(n.text, lt);
                    fe = this.template_lookup(base);
                    while (i < raw.len)
                    {
                        switch (nm_has(map, (byte*)raw.items[i]))
                        {
                            case (true) { any = true; }
                            default {};
                        };
                        i++;
                    };
                    switch (fe != (TemplateEntry*)0 & any & fe.kind == 0)
                    {
                        case (true) {
                        i = 0;
                        while (i < raw.len)
                        {
                            a = (byte*)raw.items[i];
                            switch (nm_has(map, a))
                            {
                                case (true) {
                                c = (TypeSpec*)nm_get(map, a);
                                pv_push(names, (void*)this.ts_mangle(c));
                                pv_push(specs, (void*)c);
                            }
                                default {
                                c = this.tmp_type();
                                c.base_type = DataType.DATA;
                                c.custom_typename = a;
                                pv_push(names, (void*)a);
                                pv_push(specs, (void*)c);
                            };
                            };
                            i++;
                        };
                        n.text = this.resolve_template_call(base, names, specs, (PtrVec*)0);
                    }
                        default {};
                    };
                }
                    default {};
                };
                pv_free(raw);
                pv_free(names);
                -> pv_free(specs);
            };


            subst_node(Node* n, NameMap* map) -> void
            {
                int s, i, c;
                switch (n == (Node*)0 | this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        n.ts = this.subst_ts(n.ts, map);
                        n.ts2 = this.subst_ts(n.ts2, map);
                        switch (n.kind == NodeKind.SIZE_OF | n.kind == NodeKind.ALIGN_OF | n.kind == NodeKind.ENDIAN_OF)
                        {
                            case (true) {
                            switch (n.a != (Node*)0 & n.ts == (TypeSpec*)0)
                            {
                                case (true) {
                                switch (n.a.kind == NodeKind.IDENTIFIER)
                                {
                                    case (true) {
                                    switch (nm_has(map, n.a.text))
                                    {
                                        case (true) {
                                        n.ts = typespec_copy((TypeSpec*)nm_get(map, n.a.text));
                                        node_free(n.a);
                                        n.a = (Node*)0;
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                        switch (n.kind == NodeKind.FUNCTION_CALL & n.text != (byte*)0)
                        {
                            case (true) {
                            this.subst_deferred_call(n, map);
                        }
                            default {};
                        };
                        this.subst_node(n.a, map);
                        this.subst_node(n.b, map);
                        this.subst_node(n.c, map);
                        this.subst_node(n.d, map);
                        this.subst_node(n.e, map);
                        s = 0;
                        while (s < 6)
                        {
                            c = node_count(n, s);
                            i = 0;
                            while (i < c)
                            {
                                this.subst_node(node_child(n, s, i), map);
                                i++;
                            };
                            s++;
                        };
                        ->;
                    };
                };
            };



            tp_constraint_entry(byte* fname, TemplateEntry* te, bool want_rels) -> TemplateEntry*
            {
                int i, ln, lk, k;
                bool found;
                bool suffix;
                TemplateEntry* ce;
                byte* key;
                switch (want_rels)
                {
                    case (true) { found = node_count(te.rels, 1) > 0; }
                    default { found = te.cparam.len > 0; };
                };
                switch (found)
                {
                    case (true) { -> te; }
                    default
                    {
                        ln = pp_cstrlen(fname);
                        while (i < this.templates.count)
                        {
                            key = this.templates.keys[i];
                            ce = (TemplateEntry*)this.templates.vals[i];
                            i++;
                            switch (key == (byte*)0 | ce == (TemplateEntry*)0)
                            {
                                case (true) { continue; }
                                default
                                {
                                    lk = pp_cstrlen(key);
                                    suffix = cstr_eq(fname, key);
                                    switch (!suffix & ln > lk + 2)
                                    {
                                        case (true) {
                                        suffix = true;
                                        k = 0;
                                        while (k < lk)
                                        {
                                            switch (fname[ln - lk + k] != key[k])
                                            {
                                                case (true) { suffix = false; }
                                                default {};
                                            };
                                            k++;
                                        };
                                        switch (fname[ln - lk - 1] != '_' | fname[ln - lk - 2] != '_')
                                        {
                                            case (true) { suffix = false; }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    switch (!suffix)
                                    {
                                        case (true) { continue; }
                                        default
                                        {
                                            switch (want_rels)
                                            {
                                                case (true) { found = node_count(ce.rels, 1) > 0; }
                                                default { found = ce.cparam.len > 0; };
                                            };
                                            switch (found)
                                            {
                                                case (true) { -> ce; }
                                                default {};
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        -> te;
                    };
                };
            };



            reject_object_args(byte* owner, PtrVec* names, PtrVec* specs) -> void
            {
                int i;
                byte* cn;
                TypeSpec* ts;
                while (i < names.len & !this.failed)
                {
                    cn = (byte*)names.items[i];
                    ts = (TypeSpec*)0;
                    switch (specs != (PtrVec*)0)
                    {
                        case (true) {
                        switch (i < specs.len)
                        {
                            case (true) { ts = (TypeSpec*)specs.items[i]; }
                            default {};
                        };
                    }
                        default {};
                    };
                    switch (ts != (TypeSpec*)0)
                    {
                        case (true) {
                        switch (ts_is_pointer(ts))
                        {
                            case (true) { cn = (byte*)0; }
                            default
                            {
                                switch (ts.custom_typename != (byte*)0)
                                {
                                    case (true) { cn = ts.custom_typename; }
                                    default {};
                                };
                            };
                        };
                    }
                        default {};
                    };
                    switch (cn != (byte*)0)
                    {
                        case (true) {
                        switch (nm_has(this.pobjs, cn))
                        {
                            case (true) {
                            this.sb.len = 0;
                            this.sb.mem[0] = (byte)0;
                            this.sb.put_str(f"Template '{owner}' cannot be instantiated with object type '{cn}'; templates do not accept objects\0");
                            this.error(this.own_n(this.sb.mem, this.sb.len));
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    i++;
                };
                return;
            };


            tp_check_allowed(byte* fname, TemplateEntry* ce, TemplateEntry* te, PtrVec* specs, PtrVec* poss) -> void
            {
                int i, j, cnt, line, col, first;
                byte* pname;
                TypeSpec** allowed;
                TypeSpec* concrete;
                Node* at;
                Checker* k;
                while (i < te.params.len & !this.failed)
                {
                    pname = (byte*)te.params.items[i];
                    cnt = 0;
                    j = 0;
                    while (j < ce.cparam.len)
                    {
                        switch (cstr_eq((byte*)ce.cparam.items[j], pname))
                        {
                            case (true) { cnt++; }
                            default {};
                        };
                        j++;
                    };
                    concrete = (TypeSpec*)0;
                    switch (specs != (PtrVec*)0)
                    {
                        case (true) {
                        switch (i < specs.len)
                        {
                            case (true) { concrete = (TypeSpec*)specs.items[i]; }
                            default {};
                        };
                    }
                        default {};
                    };
                    switch (cnt > 0 & concrete != (TypeSpec*)0)
                    {
                        case (true) {
                        allowed = (TypeSpec**)fmalloc((u64)cnt * (u64)((sizeof(TypeSpec*) + 7) / 8));
                        this.sb.len = 0;
                        cnt = 0;
                        j = 0;
                        while (j < ce.cparam.len)
                        {
                            switch (cstr_eq((byte*)ce.cparam.items[j], pname))
                            {
                                case (true) {
                                allowed[cnt] = (TypeSpec*)ce.cts.items[j];
                                switch (cnt > 0)
                                {
                                    case (true) { this.sb.put_str(g" | \0"); }
                                    default {};
                                };
                                this.sb.put_str((byte*)ce.ctext.items[j]);
                                cnt++;
                            }
                                default {};
                            };
                            j++;
                        };
                        line = this.cur_line();
                        col = this.cur_col();
                        switch (poss != (PtrVec*)0)
                        {
                            case (true) {
                            switch (i < poss.len)
                            {
                                case (true) {
                                at = (Node*)poss.items[i];
                                switch (at != (Node*)0)
                                {
                                    case (true) {
                                    line = at.line;
                                    col = at.col;
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                        k = this.chk_get();
                        first = k.diags.len;
                        switch (!k.check_allowed(fname, pname, concrete, allowed, cnt, this.own_n(this.sb.mem, this.sb.len), line, col))
                        {
                            case (true) {
                            this.chk_fail(first);
                        }
                            default {};
                        };
                        ffree((byte*)allowed);
                    }
                        default {};
                    };
                    i++;
                };
                ->;
            };




            resolve_template_call(byte* fname, PtrVec* names, PtrVec* specs, PtrVec* poss) -> byte*
            {
                TemplateEntry* te = this.template_lookup(fname);
                TemplateEntry* ce;
                NameMap* map;
                Node* concrete;
                TypeSpec** argv;
                byte* mangled;
                int i, first;
                Checker* k;
                switch (te == (TemplateEntry*)0)
                {
                    case (true) {
                    this.error(this.cat2(this.cat2(g"Unknown template function '\0", fname), g"'\0"));
                    -> fname;
                }
                    default
                    {
                        switch (te.kind != 0)
                        {
                            case (true) {
                            this.error(this.cat2(this.cat2(g"Unknown template function '\0", fname), g"'\0"));
                            -> fname;
                        }
                            default
                            {
                                switch (names.len != te.params.len)
                                {
                                    case (true) {
                                    this.sb.len = 0;
                                    this.sb.put_str(f"Template function '{fname}' expects {te.params.len} type argument(s), got {names.len}\0");
                                    this.error(this.own_n(this.sb.mem, this.sb.len));
                                    -> fname;
                                }
                                    default
                                    {
                                        this.reject_object_args(fname, names, specs);
                                        ce = this.tp_constraint_entry(fname, te, false);
                                        this.tp_check_allowed(fname, ce, te, specs, poss);
                                        switch (this.failed)
                                        {
                                            case (true) { -> fname; }
                                            default
                                            {
                                                this.sb.len = 0;
                                                this.sb.put_str(f"{fname}__tmpl__\0");
                                                i = 0;
                                                while (i < names.len)
                                                {
                                                    switch (i > 0)
                                                    {
                                                        case (true) { this.sb.put_str(g"__\0"); }
                                                        default {};
                                                    };
                                                    this.sb.put_str((byte*)names.items[i]);
                                                    i++;
                                                };
                                                mangled = this.own_n(this.sb.mem, this.sb.len);
                                                switch (nm_has(te.emitted, mangled))
                                                {
                                                    case (true) { -> fname; }
                                                    default
                                                    {
                                                        nm_put(te.emitted, mangled, (void*)te);

                                                        map = this.tp_mapping(te, names, specs);
                                                        concrete = node_clone(te.node);
                                                        this.subst_node(concrete, map);
                                                        switch (this.failed)
                                                        {
                                                            case (true) {
                                                            nm_free(map);
                                                            node_free(concrete);
                                                            -> fname;
                                                        }
                                                            default
                                                            {
                                                                this.patch_dict_caps(concrete);

                                                                ce = this.tp_constraint_entry(fname, te, true);
                                                                switch (node_count(ce.rels, 1) > 0)
                                                                {
                                                                    case (true) {
                                                                    argv = (TypeSpec**)fmalloc((u64)te.params.len * (u64)((sizeof(TypeSpec*) + 7) / 8));
                                                                    i = 0;
                                                                    while (i < te.params.len)
                                                                    {
                                                                        argv[i] = (TypeSpec*)nm_get(map, (byte*)te.params.items[i]);
                                                                        i++;
                                                                    };
                                                                    k = this.chk_get();
                                                                    first = k.diags.len;
                                                                    switch (k.check_relations(te.params, argv, te.params.len, ce.rels.l1, te.node, concrete) > 0)
                                                                    {
                                                                        case (true) {
                                                                        this.chk_fail(first);
                                                                    }
                                                                        default {};
                                                                    };
                                                                    ffree((byte*)argv);
                                                                }
                                                                    default {};
                                                                };
                                                                nm_free(map);
                                                                switch (this.failed)
                                                                {
                                                                    case (true) {
                                                                    node_free(concrete);
                                                                    -> fname;
                                                                }
                                                                    default
                                                                    {
                                                                        concrete.text = fname;
                                                                        switch ((concrete.flags `& 1024) != 0)
                                                                        {
                                                                            case (true) { concrete.flags = concrete.flags - 1024; }
                                                                            default {};
                                                                        };
                                                                        pv_push(this.tinst_f, (void*)concrete);
                                                                        -> fname;
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            infer_operand_type(Node* e) -> TypeSpec*
            {
                TypeSpec* inner;
                TypeSpec* r;
                switch (e.kind == NodeKind.CAST_EXPRESSION)
                {
                    case (true) { -> e.ts; }
                    default {};
                };
                switch (e.kind == NodeKind.ADDRESS_OF)
                {
                    case (true) {
                        inner = this.infer_operand_type(e.a);
                        switch (inner == (TypeSpec*)0)
                        {
                            case (true) { -> (TypeSpec*)0; }
                            default {};
                        };
                        r = typespec_copy(inner);
                        r.flags = r.flags `| 64;
                        r.pointer_depth = inner.pointer_depth + 1;
                        pv_push(this.tmp_ts, (void*)r);
                        -> r;
                    }
                    default {};
                };
                -> this.infer_arg_type(e);
            };



            try_template_op(Node* n) -> void
            {
                byte* key = operator_text(n.op);
                TemplateEntry* te = this.template_lookup(key);
                TypeSpec* lts;
                TypeSpec* rts;
                switch (te == (TemplateEntry*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (te.kind != 3)
                        {
                            case (true) { ->; }
                            default
                            {
                                lts = this.infer_operand_type(n.a);
                                switch (lts == (TypeSpec*)0)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        rts = this.infer_operand_type(n.b);
                                        switch (rts == (TypeSpec*)0)
                                        {
                                            case (true) { ->; }
                                            default
                                            {
                                                -> this.resolve_template_operator(key, te, lts, rts);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            op_infer_param(TemplateEntry* te, NameMap* inferred, TypeSpec* decl, TypeSpec* c) -> void
            {
                PtrVec* raw;
                TypeSpec* r;
                TypeSpec* res;
                byte* dn = decl.custom_typename;
                byte* cn;
                byte* base;
                byte* rem;
                byte* pname;
                int lt, bl, k, dd, cd;
                bool pre;
                switch (dn == (byte*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (this.tp_has_param(te, dn))
                        {
                            case (true) {
                            r = c;
                            switch (ts_is_pointer(c) & ts_is_pointer(decl))
                            {
                                case (true) {
                                r = typespec_copy(c);
                                pv_push(this.tmp_ts, (void*)r);
                                cd = c.pointer_depth;
                                switch (cd == 0)
                                {
                                    case (true) { cd = 1; }
                                    default {};
                                };
                                dd = decl.pointer_depth;
                                switch (dd == 0)
                                {
                                    case (true) { dd = 1; }
                                    default {};
                                };
                                r.pointer_depth = cd - dd;
                                switch (r.pointer_depth < 0)
                                {
                                    case (true) { r.pointer_depth = 0; }
                                    default {};
                                };
                                switch (r.pointer_depth == 0 & (r.flags `& 64) != 0)
                                {
                                    case (true) { r.flags = r.flags - 64; }
                                    default {};
                                };
                            }
                                default {};
                            };
                            switch (!nm_has(inferred, dn))
                            {
                                case (true) { nm_put(inferred, dn, (void*)r); }
                                default {};
                            };
                            ->;
                        }
                            default
                            {
                                raw = pv_new();
                                lt = this.tp_split_deferred(dn, raw);
                                switch (lt > 0)
                                {
                                    case (true) {
                                    base = this.own_n(dn, lt);
                                    cn = c.custom_typename;
                                    bl = pp_cstrlen(base);
                                    pre = false;
                                    switch (cn != (byte*)0)
                                    {
                                        case (true) {
                                        pre = pp_cstrlen(cn) > bl + 2;
                                        k = 0;
                                        while (pre & k < bl)
                                        {
                                            switch (cn[k] != base[k])
                                            {
                                                case (true) { pre = false; }
                                                default {};
                                            };
                                            k++;
                                        };
                                        switch (pre)
                                        {
                                            case (true) {
                                            switch (cn[bl] != '_' | cn[bl + 1] != '_')
                                            {
                                                case (true) { pre = false; }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    switch (pre & raw.len == 1)
                                    {
                                        case (true) {
                                        pname = (byte*)raw.items[0];
                                        switch (this.tp_has_param(te, pname) & !nm_has(inferred, pname))
                                        {
                                            case (true) {
                                            rem = cn + bl + 2;
                                            res = (TypeSpec*)0;
                                            switch (this.st != (IDKC_SYMTABLE*)0)
                                            {
                                                case (true) { res = st_get_type_spec(this.st, rem); }
                                                default {};
                                            };
                                            k = 0;
                                            while (res == (TypeSpec*)0 & k < 18)
                                            {
                                                switch (cstr_eq(datatype_text(k), rem))
                                                {
                                                    case (true) {
                                                    res = this.tmp_type();
                                                    res.base_type = k;
                                                }
                                                    default {};
                                                };
                                                k++;
                                            };
                                            switch (res == (TypeSpec*)0)
                                            {
                                                case (true) {
                                                res = this.tmp_type();
                                                res.base_type = DataType.DATA;
                                                res.custom_typename = rem;
                                            }
                                                default {};
                                            };
                                            nm_put(inferred, pname, (void*)res);
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                -> pv_free(raw);
                            };
                        };
                    };
                };
            };

            op_is_non_builtin(TypeSpec* t) -> bool
            {
                switch (t.custom_typename != (byte*)0)
                {
                    case (true) { -> true; }
                    default
                    {
                        switch (t.base_type == DataType.STRUCT | t.base_type == DataType.OBJECT)
                        {
                            case (true) { -> true; }
                            default
                            {
                                -> ts_is_pointer(t);
                            };
                        };
                    };
                };
            };

            resolve_template_operator(byte* key, TemplateEntry* te, TypeSpec* lts, TypeSpec* rts) -> void
            {
                Node* f = te.node;
                PtrVec* names;
                PtrVec* specs;
                NameMap* inferred;
                NameMap* map;
                Node* concrete;
                TypeSpec* c;
                byte* mangled;
                int i;
                switch (f == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (node_count(f, 0) != 2)
                        {
                            case (true) { ->; }
                            default
                            {
                                specs = pv_new();
                                names = pv_new();
                                switch (te.params.len != 2)
                                {
                                    case (true) {
                                    inferred = nm_new();
                                    i = 0;
                                    while (i < 2)
                                    {
                                        c = lts;
                                        switch (i == 1)
                                        {
                                            case (true) { c = rts; }
                                            default {};
                                        };
                                        switch (node_child(f, 0, i).ts != (TypeSpec*)0)
                                        {
                                            case (true) { this.op_infer_param(te, inferred, node_child(f, 0, i).ts, c); }
                                            default {};
                                        };
                                        i++;
                                    };
                                    i = 0;
                                    while (i < te.params.len)
                                    {
                                        switch (!nm_has(inferred, (byte*)te.params.items[i]))
                                        {
                                            case (true) {
                                            nm_free(inferred);
                                            pv_free(specs);
                                            -> pv_free(names);
                                        }
                                            default
                                            {
                                                pv_push(specs, nm_get(inferred, (byte*)te.params.items[i]));
                                                i++;
                                            };
                                        };
                                    };
                                    nm_free(inferred);
                                }
                                    default {
                                    pv_push(specs, (void*)lts);
                                    pv_push(specs, (void*)rts);
                                };
                                };
                                switch (!this.op_is_non_builtin(lts) & !this.op_is_non_builtin(rts))
                                {
                                    case (true) {
                                    pv_free(specs);
                                    -> pv_free(names);
                                }
                                    default
                                    {
                                        this.sb.len = 0;
                                        this.sb.mem[0] = (byte)0;
                                        this.sb.put_str(f"{f.text}__tmpl__\0");
                                        i = 0;
                                        while (i < specs.len)
                                        {
                                            switch (i > 0)
                                            {
                                                case (true) { this.sb.put_str(g"__\0"); }
                                                default {};
                                            };
                                            this.sb.put_str(this.ts_mangle((TypeSpec*)specs.items[i]));
                                            i++;
                                        };
                                        mangled = this.own_n(this.sb.mem, this.sb.len);
                                        i = 0;
                                        while (i < specs.len)
                                        {
                                            pv_push(names, (void*)this.ts_mangle((TypeSpec*)specs.items[i]));
                                            i++;
                                        };
                                        switch (nm_has(te.emitted, mangled))
                                        {
                                            case (true) {
                                            pv_free(specs);
                                            -> pv_free(names);
                                        }
                                            default
                                            {
                                                nm_put(te.emitted, mangled, (void*)te);
                                                map = this.tp_mapping(te, names, specs);
                                                pv_free(specs);
                                                pv_free(names);
                                                concrete = node_clone(f);
                                                this.subst_node(concrete, map);
                                                nm_free(map);
                                                switch (this.failed)
                                                {
                                                    case (true) {
                                                    -> node_free(concrete);
                                                }
                                                    default
                                                    {
                                                        switch ((concrete.flags `& 1024) != 0)
                                                        {
                                                            case (true) { concrete.flags = concrete.flags - 1024; }
                                                            default {};
                                                        };
                                                        -> pv_push(this.tinst_f, (void*)concrete);
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            infer_arg_type(Node* arg) -> TypeSpec*
            {
                TypeSpec* t;
                int dt;
                switch (arg.kind == NodeKind.IDENTIFIER)
                {
                    case (true) {
                    switch (this.st == (IDKC_SYMTABLE*)0)
                    {
                        case (true) { -> (TypeSpec*)0; }
                        default {};
                    };
                    -> st_get_type_spec(this.st, arg.text);
                }
                    default
                    {
                        switch (arg.kind == NodeKind.LITERAL)
                        {
                            case (true) {
                            dt = arg.op;
                            switch (dt == DataType.SINT | dt == DataType.UINT | dt == DataType.SLONG | dt == DataType.ULONG |
                                dt == DataType.FLOAT | dt == DataType.DOUBLE | dt == DataType.CHAR | dt == DataType.BOOL |
                                dt == DataType.BYTE)
                            {
                                case (true) {
                                t = this.tmp_type();
                                t.base_type = dt;
                                switch (dt == DataType.SINT | dt == DataType.SLONG | dt == DataType.CHAR)
                                {
                                    case (true) { t.flags = 1; }
                                    default {};
                                };
                                -> t;
                            }
                                default {};
                            };
                            -> (TypeSpec*)0;
                        }
                            default
                            {
                                switch (arg.kind == NodeKind.STRING_LITERAL)
                                {
                                    case (true) {
                                    t = this.tmp_type();
                                    t.base_type = DataType.BYTE;
                                    t.flags = 1 `| 64;
                                    t.bit_width = 8;
                                    t.pointer_depth = 1;
                                    -> t;
                                }
                                    default
                                    {
                                        -> (TypeSpec*)0;
                                    };
                                };
                            };
                        };
                    };
                };
            };




            tp_type_by_name(byte* carg) -> TypeSpec*
            {
                TypeSpec* r = (TypeSpec*)0;
                int k;
                switch (this.st != (IDKC_SYMTABLE*)0)
                {
                    case (true) { r = st_get_type_spec(this.st, carg); }
                    default {};
                };
                while (r == (TypeSpec*)0 & k < 18)
                {
                    switch (cstr_eq(datatype_text(k), carg))
                    {
                        case (true) {
                        r = this.tmp_type();
                        r.base_type = k;
                        switch (k == DataType.SINT | k == DataType.CHAR)
                        {
                            case (true) { r.flags = 1; }
                            default {};
                        };
                    }
                        default {};
                    };
                    k++;
                };
                switch (r == (TypeSpec*)0)
                {
                    case (true) {
                    r = this.tmp_type();
                    r.base_type = DataType.DATA;
                    r.custom_typename = carg;
                }
                    default {};
                };
                -> r;
            };

            has_lt(byte* s) -> bool
            {
                int i, n = pp_cstrlen(s);
                while (i < n) { if (s[i] == '<') { -> true; }; i++; };
                -> false;
            };




            match_pat_args(PtrVec* pat, int ai, byte* rest, int rl, int start, TemplateEntry* te, PtrVec* bv) -> bool
            {
                int end, e = start, saved = bv.len;
                bool ok = false, last = ai == pat.len - 1, more = true;
                if (ai == pat.len) { -> start == rl + 1; };
                while (!ok & more)
                {
                    end = rl;
                    if (!last)
                    {

                        while (e < rl & !(e > start & e + 1 < rl & rest[e] == '_' & rest[e - 1] != '_' & rest[e + 1] != '_')) { e++; };
                        if (e >= rl) { more = false; };
                        end = e;
                        e++;
                    };
                    if (more & end > start)
                    {
                        if (this.match_pat((byte*)pat.items[ai], this.own_n(rest + start, end - start), te, bv) & this.match_pat_args(pat, ai + 1, rest, rl, end + 1, te, bv))
                        {
                            ok = true;
                        }
                        else { bv.len = saved; };
                    };
                    if (last) { more = false; };
                };
                -> ok;
            };




            match_pat(byte* pat, byte* conc, TemplateEntry* te, PtrVec* bv) -> bool
            {
                PtrVec* raw;
                byte* base;
                int lt, bl, i, saved = bv.len;
                bool ok = true, seen;
                if (this.tp_has_param(te, pat))
                {
                    i = 0;
                    while (i < bv.len) { if (cstr_eq((byte*)bv.items[i], pat)) { seen = true; }; i = i + 2; };
                    if (!seen) { pv_push(bv, (void*)pat); pv_push(bv, (void*)conc); };
                    -> true;
                };
                raw = pv_new();
                lt = this.tp_split_deferred(pat, raw);
                if (lt <= 0)
                {
                    pv_free(raw);
                    -> cstr_eq(pat, conc);
                };
                base = this.own_n(pat, lt);
                bl = pp_cstrlen(conc);
                i = 0;
                while (i < lt) { if (i >= bl) { ok = false; break; }; if (conc[i] != base[i]) { ok = false; }; i++; };
                if (ok & (bl < lt + 3 | conc[lt] != '_' | conc[lt + 1] != '_')) { ok = false; };
                if (ok) { ok = this.match_pat_args(raw, 0, conc + lt + 2, bl - lt - 2, 0, te, bv); };
                if (!ok) { bv.len = saved; };
                pv_free(raw);
                -> ok;
            };


            infer_nested_param(TemplateEntry* te, byte* pt, Node* arg, NameMap* out) -> void
            {
                TypeSpec* at;
                PtrVec* bv;
                int i;
                if (arg.kind != NodeKind.IDENTIFIER | this.st == (IDKC_SYMTABLE*)0) { ->; };
                at = st_get_type_spec(this.st, arg.text);
                if (at == (TypeSpec*)0) { ->; };
                if (at.custom_typename == (byte*)0) { ->; };
                bv = pv_new();
                if (this.match_pat(pt, at.custom_typename, te, bv))
                {
                    while (i < bv.len)
                    {
                        if (!nm_has(out, (byte*)bv.items[i]))
                        {
                            nm_put(out, (byte*)bv.items[i], (void*)this.tp_type_by_name((byte*)bv.items[i + 1]));
                        };
                        i = i + 2;
                    };
                };
                -> pv_free(bv);
            };


            infer_struct_param(TemplateEntry* te, PtrVec* raw, Node* arg, NameMap* out) -> void
            {
                TypeSpec* at;
                byte* ctn;
                byte* key;
                TemplateEntry* ce;
                PtrVec* cargs;
                int i, j, kl, cl, st0, pos;
                bool match;
                switch (arg.kind != NodeKind.IDENTIFIER)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (this.st == (IDKC_SYMTABLE*)0)
                        {
                            case (true) { ->; }
                            default
                            {
                                at = st_get_type_spec(this.st, arg.text);
                                switch (at == (TypeSpec*)0)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        ctn = at.custom_typename;
                                        switch (ctn == (byte*)0)
                                        {
                                            case (true) { ->; }
                                            default
                                            {
                                                cl = pp_cstrlen(ctn);
                                                while (i < this.templates.count)
                                                {
                                                    key = this.templates.keys[i];
                                                    ce = (TemplateEntry*)this.templates.vals[i];
                                                    i++;
                                                    switch (key == (byte*)0 | ce == (TemplateEntry*)0)
                                                    {
                                                        case (true) { continue; }
                                                        default
                                                        {
                                                            switch (ce.kind != 1 & ce.kind != 2)
                                                            {
                                                                case (true) { continue; }
                                                                default
                                                                {
                                                                    kl = pp_cstrlen(key);
                                                                    match = cstr_eq(ctn, key);
                                                                    switch (!match & cl > kl + 2)
                                                                    {
                                                                        case (true) {
                                                                        match = true;
                                                                        j = 0;
                                                                        while (j < kl)
                                                                        {
                                                                            switch (ctn[j] != key[j])
                                                                            {
                                                                                case (true) { match = false; }
                                                                                default {};
                                                                            };
                                                                            j++;
                                                                        };
                                                                        switch (ctn[kl] != '_' | ctn[kl + 1] != '_')
                                                                        {
                                                                            case (true) { match = false; }
                                                                            default {};
                                                                        };
                                                                    }
                                                                        default {};
                                                                    };
                                                                    switch (!match)
                                                                    {
                                                                        case (true) { continue; }
                                                                        default
                                                                        {

                                                                            cargs = pv_new();
                                                                            switch (cl > kl + 2)
                                                                            {
                                                                                case (true) {
                                                                                st0 = kl + 2;
                                                                                j = st0;
                                                                                while (j <= cl)
                                                                                {
                                                                                    switch (j == cl)
                                                                                    {
                                                                                        case (true) {
                                                                                        pv_push(cargs, (void*)this.own_n(ctn + st0, j - st0));
                                                                                    }
                                                                                        default {
                                                                                            switch (ctn[j] == '_' & j + 1 < cl)
                                                                                            {
                                                                                                case (true) {
                                                                                        switch (ctn[j + 1] == '_')
                                                                                        {
                                                                                            case (true) {
                                                                                            pv_push(cargs, (void*)this.own_n(ctn + st0, j - st0));
                                                                                            st0 = j + 2;
                                                                                            j++;
                                                                                        }
                                                                                            default {};
                                                                                        };
                                                                                    }
                                                                                                default {};
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                    j++;
                                                                                };
                                                                            }
                                                                                default {};
                                                                            };
                                                                            pos = 0;
                                                                            while (pos < raw.len)
                                                                            {
                                                                                switch (this.tp_has_param(te, (byte*)raw.items[pos]) & pos < cargs.len)
                                                                                {
                                                                                    case (true) {
                                                                                    switch (!nm_has(out, (byte*)raw.items[pos]))
                                                                                    {
                                                                                        case (true) {
                                                                                        nm_put(out, (byte*)raw.items[pos], (void*)this.tp_type_by_name((byte*)cargs.items[pos]));
                                                                                    }
                                                                                        default {};
                                                                                    };
                                                                                }
                                                                                    default {};
                                                                                };
                                                                                pos++;
                                                                            };
                                                                            -> pv_free(cargs);
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                                ->;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };




            patch_dict_caps(Node* concrete) -> void
            {
                int p = 0;
                Node* param;
                TypeSpec* at;
                TypeSpec* nt;
                int j;
                while (p < node_count(concrete, 0))
                {
                    param = node_child(concrete, 0, p);
                    switch (param.ts != (TypeSpec*)0 & p < this.pend_dict.len)
                    {
                        case (true) {
                        at = (TypeSpec*)this.pend_dict.items[p];
                        switch (param.ts.base_type == DataType.DICT & param.ts.dict_capacity <= 0 & at != (TypeSpec*)0)
                        {
                            case (true) {
                            switch (at.dict_capacity > 0)
                            {
                                case (true) {
                                nt = typespec_copy(param.ts);
                                nt.dict_capacity = at.dict_capacity;
                                param.ts = nt;
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    p++;
                };
                switch (concrete.ts != (TypeSpec*)0)
                {
                    case (true) {
                    switch (concrete.ts.base_type == DataType.DICT & concrete.ts.dict_capacity <= 0)
                    {
                        case (true) {
                        j = 0;
                        while (j < this.pend_dict.len)
                        {
                            at = (TypeSpec*)this.pend_dict.items[j];
                            switch (at != (TypeSpec*)0)
                            {
                                case (true) {
                                switch (at.dict_capacity > 0)
                                {
                                    case (true) {
                                    nt = typespec_copy(concrete.ts);
                                    nt.dict_capacity = at.dict_capacity;
                                    concrete.ts = nt;
                                    ->;
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                            j++;
                        };
                    }
                        default {};
                    };
                }
                    default {};
                };
            };

            infer_template_params(TemplateEntry* te, Node* holder, bool skip_first, NameMap* out) -> void
            {
                int i, first, nargs, j;
                bool nested;
                Node* dp;
                Node* arg;
                byte* pt;
                byte* kp;
                byte* vp;
                TypeSpec* t;
                TypeSpec* at;
                PtrVec* raw;
                Node* decl = te.node;
                this.pend_dict.len = 0;
                nargs = node_count(holder, 0);
                first = 0;
                switch (skip_first)
                {
                    case (true) { first = 1; }
                    default {};
                };
                i = first;
                while (i < node_count(decl, 0))
                {
                    switch (i - first >= nargs)
                    {
                        case (true) { break; }
                        default
                        {
                            dp = node_child(decl, 0, i);
                            i++;
                            switch (dp.ts == (TypeSpec*)0)
                            {
                                case (true) { continue; }
                                default
                                {
                                    arg = node_child(holder, 0, i - 1 - first);
                                    switch (dp.ts.base_type == DataType.DICT)
                                    {
                                        case (true) {
                                        at = (TypeSpec*)0;
                                        while (this.pend_dict.len <= i - 1 - first) { pv_push(this.pend_dict, (void*)0); };
                                        switch (arg.kind == NodeKind.IDENTIFIER & this.st != (IDKC_SYMTABLE*)0)
                                        {
                                            case (true) { at = st_get_type_spec(this.st, arg.text); }
                                            default {};
                                        };
                                        switch (at != (TypeSpec*)0)
                                        {
                                            case (true) {
                                            switch (at.base_type == DataType.DICT)
                                            {
                                                case (true) {
                                                this.pend_dict.items[i - 1 - first] = (void*)at;
                                                kp = (byte*)0;
                                                vp = (byte*)0;
                                                switch (dp.ts.dict_key != (TypeSpec*)0)
                                                {
                                                    case (true) { kp = dp.ts.dict_key.custom_typename; }
                                                    default {};
                                                };
                                                switch (dp.ts.dict_value != (TypeSpec*)0)
                                                {
                                                    case (true) { vp = dp.ts.dict_value.custom_typename; }
                                                    default {};
                                                };
                                                switch (kp != (byte*)0)
                                                {
                                                    case (true) {
                                                    switch (this.tp_has_param(te, kp) & !nm_has(out, kp))
                                                    {
                                                        case (true) { nm_put(out, kp, (void*)at.dict_key); }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (vp != (byte*)0)
                                                {
                                                    case (true) {
                                                    switch (this.tp_has_param(te, vp) & !nm_has(out, vp))
                                                    {
                                                        case (true) { nm_put(out, vp, (void*)at.dict_value); }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        continue;
                                    }
                                        default
                                        {
                                            pt = dp.ts.custom_typename;
                                            switch (pt == (byte*)0)
                                            {
                                                case (true) { continue; }
                                                default
                                                {
                                                    switch (arg.kind == NodeKind.ADDRESS_OF)
                                                    {
                                                        case (true) {
                                                        switch (arg.a != (Node*)0)
                                                        {
                                                            case (true) {
                                                            switch (arg.a.kind == NodeKind.IDENTIFIER)
                                                            {
                                                                case (true) { arg = arg.a; }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                    raw = pv_new();
                                                    switch (this.tp_split_deferred(pt, raw) > 0)
                                                    {
                                                        case (true) {
                                                        nested = false;
                                                        j = 0;
                                                        while (j < raw.len) { if (this.has_lt((byte*)raw.items[j])) { nested = true; }; j++; };
                                                        if (nested) { this.infer_nested_param(te, pt, arg, out); }
                                                        else { this.infer_struct_param(te, raw, arg, out); };
                                                        pv_free(raw);
                                                        continue;
                                                    }
                                                        default
                                                        {
                                                            pv_free(raw);
                                                            switch (!this.tp_has_param(te, pt))
                                                            {
                                                                case (true) { continue; }
                                                                default
                                                                {
                                                                    t = this.infer_arg_type(arg);
                                                                    switch (t != (TypeSpec*)0)
                                                                    {
                                                                        case (true) { nm_put(out, pt, (void*)t); }
                                                                        default {};
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                ->;
            };


            deferred_name(byte* fname, PtrVec* names) -> byte*
            {
                int i;
                this.sb.len = 0;
                this.sb.put_str(f"{fname}<\0");
                while (i < names.len)
                {
                    switch (i > 0)
                    {
                        case (true) { this.sb.put(','); }
                        default {};
                    };
                    this.sb.put_str((byte*)names.items[i]);
                    i++;
                };
                this.sb.put('>');
                -> this.own_n(this.sb.mem, this.sb.len);
            };

            tp_free_specs(PtrVec* specs) -> void
            {
                int i;
                while (i < specs.len)
                {
                    typespec_free((TypeSpec*)specs.items[i]);
                    i++;
                };
                -> pv_free(specs);
            };


            template_call_explicit(Node* expr, TemplateEntry* te) -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                PtrVec* names = pv_new();
                PtrVec* specs = pv_new();
                Node* holder = this.mk(NodeKind.NODE_LIST, line, col);
                Node* n;
                TypeSpec* ts;
                bool more = true;
                bool deferred = false;
                int i;
                this.advance();
                while (more & !this.failed)
                {
                    ts = this.type_spec();
                    switch (this.failed)
                    {
                        case (true) {
                        typespec_free(ts);
                        break;
                    }
                        default
                        {
                            pv_push(names, (void*)this.ts_mangle(ts));
                            pv_push(specs, (void*)ts);
                            more = this.expect(TokenType.COMMA);
                            switch (more)
                            {
                                case (true) { this.advance(); }
                                default {};
                            };
                        };
                    };
                };
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.GREATER_THAN); }
                    default {};
                };
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.LEFT_PAREN); }
                    default {};
                };
                switch (!this.failed & !this.expect(TokenType.RIGHT_PAREN))
                {
                    case (true) { this.argument_list(holder, expr.text); }
                    default {};
                };
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.RIGHT_PAREN); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) {
                    this.tp_free_specs(specs);
                    pv_free(names);
                    node_free(holder);
                    -> expr;
                }
                    default
                    {
                        while (i < names.len)
                        {
                            switch (this.tp_mentions((byte*)names.items[i]))
                            {
                                case (true) { deferred = true; }
                                default {};
                            };
                            i++;
                        };
                        n = this.mk(NodeKind.FUNCTION_CALL, line, col);
                        switch (this.failed)
                        {
                            case (true) {
                            this.tp_free_specs(specs);
                            pv_free(names);
                            node_free(holder);
                            -> expr;
                        }
                            default
                            {
                                this.take_args(n, holder);
                                switch (deferred)
                                {
                                    case (true) { n.text = this.deferred_name(expr.text, names); }
                                    default { n.text = this.resolve_template_call(expr.text, names, specs, (PtrVec*)0); };
                                };
                                this.tp_free_specs(specs);
                                pv_free(names);
                                node_free(expr);
                                -> n;
                            };
                        };
                    };
                };
            };


            template_call_implicit(Node* expr, TemplateEntry* te) -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col() + 1;
                Node* holder = this.mk(NodeKind.NODE_LIST, line, col);
                Node* n;
                Node* dp;
                NameMap* inferred = nm_new();
                PtrVec* names = pv_new();
                PtrVec* specs = pv_new();
                PtrVec* poss = pv_new();
                PtrVec* unresolved = pv_new();
                int i, j, got;
                bool all_active, abstract;
                byte* p;
                TypeSpec* t;
                this.advance();
                switch (!this.failed & !this.expect(TokenType.RIGHT_PAREN))
                {
                    case (true) { this.argument_list(holder, expr.text); }
                    default {};
                };
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.RIGHT_PAREN); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) {
                    nm_free(inferred);
                    pv_free(names);
                    pv_free(specs);
                    pv_free(poss);
                    pv_free(unresolved);
                    node_free(holder);
                    -> expr;
                }
                    default
                    {
                        this.infer_template_params(te, holder, false, inferred);


                        i = 0;
                        while (i < te.params.len)
                        {
                            pv_push(poss, (void*)0);
                            i++;
                        };
                        i = 0;
                        while (i < node_count(te.node, 0) & i < node_count(holder, 0))
                        {
                            dp = node_child(te.node, 0, i);
                            switch (dp.ts != (TypeSpec*)0)
                            {
                                case (true) {
                                switch (dp.ts.custom_typename != (byte*)0)
                                {
                                    case (true) {
                                    j = 0;
                                    while (j < te.params.len)
                                    {
                                        switch (cstr_eq((byte*)te.params.items[j], dp.ts.custom_typename) & poss.items[j] == (void*)0)
                                        {
                                            case (true) {
                                            poss.items[j] = (void*)node_child(holder, 0, i);
                                        }
                                            default {};
                                        };
                                        j++;
                                    };
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                            i++;
                        };


                        i = 0;
                        while (i < te.dparam.len)
                        {
                            p = (byte*)te.dparam.items[i];
                            switch (!nm_has(inferred, p))
                            {
                                case (true) { nm_put(inferred, p, te.dts.items[i]); }
                                default {};
                            };
                            i++;
                        };
                        i = 0;
                        while (i < te.no_default.count)
                        {
                            p = te.no_default.keys[i];
                            i++;
                            switch (p == (byte*)0)
                            {
                                case (true) { continue; }
                                default
                                {
                                    switch (!nm_has(inferred, p))
                                    {
                                        case (true) {
                                        this.sb.len = 0;
                                        this.sb.put_str(f"Template parameter '{p}' of '{expr.text}' has no default and could not be inferred - it must be supplied explicitly\0");
                                        this.error_at(this.own_n(this.sb.mem, this.sb.len), line, col);
                                        break;
                                    }
                                        default {};
                                    };
                                };
                            };
                        };

                        n = (Node*)0;
                        switch (!this.failed)
                        {
                            case (true) {
                            got = 0;
                            i = 0;
                            while (i < te.params.len)
                            {
                                switch (nm_has(inferred, (byte*)te.params.items[i]))
                                {
                                    case (true) { got++; }
                                    default { pv_push(unresolved, te.params.items[i]); };
                                };
                                i++;
                            };
                            n = this.mk(NodeKind.FUNCTION_CALL, line, col);
                        }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) {
                            this.take_args(n, holder);
                            holder = (Node*)0;
                            n.text = expr.text;
                            switch (got == te.params.len)
                            {
                                case (true) {
                                abstract = false;
                                i = 0;
                                while (i < te.params.len)
                                {
                                    t = (TypeSpec*)nm_get(inferred, (byte*)te.params.items[i]);
                                    pv_push(specs, (void*)t);
                                    p = this.ts_mangle(t);
                                    pv_push(names, (void*)p);
                                    switch (this.tp_has_param(te, p))
                                    {
                                        case (true) { abstract = true; }
                                        default {};
                                    };
                                    i++;
                                };
                                switch (!abstract)
                                {
                                    case (true) { n.text = this.resolve_template_call(expr.text, names, specs, poss); }
                                    default {};
                                };
                            }
                                default {
                                all_active = unresolved.len > 0;
                                i = 0;
                                while (i < unresolved.len)
                                {
                                    switch (!this.tp_active((byte*)unresolved.items[i]))
                                    {
                                        case (true) { all_active = false; }
                                        default {};
                                    };
                                    i++;
                                };
                                switch (all_active)
                                {
                                    case (true) {
                                    i = 0;
                                    while (i < te.params.len)
                                    {
                                        p = (byte*)te.params.items[i];
                                        switch (nm_has(inferred, p))
                                        {
                                            case (true) { pv_push(names, (void*)this.ts_mangle((TypeSpec*)nm_get(inferred, p))); }
                                            default { pv_push(names, (void*)p); };
                                        };
                                        i++;
                                    };
                                    n.text = this.deferred_name(expr.text, names);
                                }
                                    default {};
                                };
                            };
                            };
                        }
                            default {};
                        };
                        nm_free(inferred);
                        pv_free(names);
                        pv_free(specs);
                        pv_free(poss);
                        pv_free(unresolved);
                        switch (holder != (Node*)0)
                        {
                            case (true) { node_free(holder); }
                            default {};
                        };
                        switch (this.failed)
                        {
                            case (true) {
                            node_free(n);
                            -> expr;
                        }
                            default
                            {
                                node_free(expr);
                                -> n;
                            };
                        };
                    };
                };
            };



            typefunc_key(Node* expr, byte* member) -> byte*
            {
                Node* id = (Node*)0;
                bool tied = false;
                TypeSpec* rt;
                byte* rn;
                byte* cand;
                byte* un;
                int pd, i;
                switch (this.st == (IDKC_SYMTABLE*)0)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        switch (expr.kind)
                        {
                            case (NodeKind.IDENTIFIER) { id = expr; }
                            case (NodeKind.TIE_EXPRESSION)
                            {
                                switch (expr.a != (Node*)0)
                                {
                                    case (true) {
                                    switch (expr.a.kind == NodeKind.IDENTIFIER)
                                    {
                                        case (true) {
                                        id = expr.a;
                                        tied = true;
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                            }
                            default
                            {
                                switch (expr.kind == NodeKind.STRING_LITERAL | expr.kind == NodeKind.F_STRING_LITERAL)
                                {
                                    case (true) {
                                    cand = this.cat2(g"__typefunc__string__\0", member);
                                    switch (this.template_lookup(cand) != (TemplateEntry*)0)
                                    {
                                        case (true) { -> cand; }
                                        default
                                        {
                                            -> (byte*)0;
                                        };
                                    };
                                }
                                    default {};
                                };
                            };
                        };
                        switch (id == (Node*)0)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                rt = st_get_type_spec(this.st, id.text);
                                switch (rt == (TypeSpec*)0)
                                {
                                    case (true) { -> (byte*)0; }
                                    default
                                    {
                                        pd = rt.pointer_depth;
                                        switch (rt.custom_typename != (byte*)0)
                                        {
                                            case (true) { rn = rt.custom_typename; }
                                            default {
                                                switch (pd > 0 & rt.base_type == DataType.BYTE)
                                                {
                                                    case (true) { rn = g"string\0"; }
                                                    default {
                                                        switch (pd > 0)
                                                        {
                                                            case (true) {
                                            rn = datatype_text(rt.base_type);
                                            while (i < pd)
                                            {
                                                rn = this.cat2(rn, g"_ptr\0");
                                                i++;
                                            };
                                        }
                                                            default { rn = datatype_text(rt.base_type); };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                        switch ((rt.flags `& 8) != 0)
                                        {
                                            case (true) { tied = true; }
                                            default {};
                                        };
                                        switch (tied)
                                        {
                                            case (true) { cand = this.cat2(this.cat2(this.cat2(g"__typefunc__tied_\0", rn), g"__\0"), member); }
                                            default { cand = this.cat2(this.cat2(this.cat2(g"__typefunc__\0", rn), g"__\0"), member); };
                                        };
                                        switch (this.template_lookup(cand) != (TemplateEntry*)0)
                                        {
                                            case (true) { -> cand; }
                                            default
                                            {
                                                switch (tied)
                                                {
                                                    case (true) {
                                                    un = this.cat2(this.cat2(this.cat2(g"__typefunc__\0", rn), g"__\0"), member);
                                                    switch (this.template_lookup(un) != (TemplateEntry*)0)
                                                    {
                                                        case (true) { -> un; }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                -> (byte*)0;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            template_method_explicit(Node* recv, byte* key, bool as_typefunc) -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                PtrVec* names = pv_new();
                PtrVec* specs = pv_new();
                Node* holder = this.mk(NodeKind.NODE_LIST, line, col);
                Node* n;
                TypeSpec* ts;
                bool more = true;
                this.advance();
                while (more & !this.failed)
                {
                    ts = this.type_spec();
                    switch (this.failed)
                    {
                        case (true) {
                        typespec_free(ts);
                        break;
                    }
                        default
                        {
                            pv_push(names, (void*)this.ts_mangle(ts));
                            pv_push(specs, (void*)ts);
                            more = this.expect(TokenType.COMMA);
                            switch (more)
                            {
                                case (true) { this.advance(); }
                                default {};
                            };
                        };
                    };
                };
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.GREATER_THAN); }
                    default {};
                };
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.LEFT_PAREN); }
                    default {};
                };
                switch (!this.failed & !this.expect(TokenType.RIGHT_PAREN))
                {
                    case (true) { this.argument_list(holder, (byte*)0); }
                    default {};
                };
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.RIGHT_PAREN); }
                    default {};
                };
                n = (Node*)0;
                switch (!this.failed)
                {
                    case (true) { n = this.mk(NodeKind.FUNCTION_CALL, line, col); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) {
                    this.tp_free_specs(specs);
                    pv_free(names);
                    node_free(holder);
                    -> recv;
                }
                    default
                    {
                        this.take_args(n, holder);
                        n.text = this.resolve_template_call(key, names, specs, (PtrVec*)0);
                        this.tp_free_specs(specs);
                        pv_free(names);
                        switch (as_typefunc)
                        {
                            case (true) { this.push_front(n, recv); }
                            default { node_free(recv); };
                        };
                        -> n;
                    };
                };
            };



            typefunc_call_implicit(Node* ma, Node* holder, int line, int col) -> Node*
            {
                TemplateEntry* te = this.template_lookup(ma.text2);
                NameMap* inferred;
                PtrVec* names;
                PtrVec* specs;
                Node* n = (Node*)0;
                TypeSpec* t;
                int i;
                bool all = true;
                switch (te == (TemplateEntry*)0)
                {
                    case (true) { -> n; }
                    default
                    {
                        inferred = nm_new();
                        this.infer_template_params(te, holder, true, inferred);
                        this.pend_dict.len = 0;
                        i = 0;
                        while (i < te.params.len)
                        {
                            switch (!nm_has(inferred, (byte*)te.params.items[i]))
                            {
                                case (true) { all = false; }
                                default {};
                            };
                            i++;
                        };
                        switch (all)
                        {
                            case (true) {
                            names = pv_new();
                            specs = pv_new();
                            i = 0;
                            while (i < te.params.len)
                            {
                                t = (TypeSpec*)nm_get(inferred, (byte*)te.params.items[i]);
                                pv_push(specs, (void*)t);
                                pv_push(names, (void*)this.ts_mangle(t));
                                i++;
                            };
                            n = this.mk(NodeKind.FUNCTION_CALL, line, col);
                            switch (!this.failed)
                            {
                                case (true) {
                                n.text = this.resolve_template_call(ma.text2, names, specs, (PtrVec*)0);
                            }
                                default {};
                            };
                            pv_free(names);
                            pv_free(specs);
                        }
                            default {};
                        };
                        nm_free(inferred);
                        -> n;
                    };
                };
            };

            template_call(Node* expr) -> Node*
            {
                TemplateEntry* te;
                switch (expr.kind != NodeKind.IDENTIFIER)
                {
                    case (true) { -> expr; }
                    default
                    {
                        te = this.template_lookup(expr.text);
                        switch (te == (TemplateEntry*)0)
                        {
                            case (true) { -> expr; }
                            default
                            {
                                switch (te.kind != 0)
                                {
                                    case (true) { -> expr; }
                                    default
                                    {
                                        switch (this.expect(TokenType.LESS_THAN))
                                        {
                                            case (true) { -> this.template_call_explicit(expr, te); }
                                            default
                                            {
                                                switch (this.expect(TokenType.LEFT_PAREN))
                                                {
                                                    case (true) { -> this.template_call_implicit(expr, te); }
                                                    default
                                                    {
                                                        -> expr;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };




            is_relop() -> bool
            {
                int t0 = this.cur();
                int t1 = this.type_at(1);
                int t2 = this.type_at(2);
                switch (t0 == TokenType.TIE)
                {
                    case (true) { -> t1 == TokenType.ASSIGN; }
                    default
                    {
                        switch (t0 != TokenType.NOT)
                        {
                            case (true) { -> false; }
                            default
                            {
                                switch (t1 == TokenType.TIE)
                                {
                                    case (true) { -> t2 == TokenType.ASSIGN; }
                                    default
                                    {
                                        switch (t1 == TokenType.ADDRESS_OF)
                                        {
                                            case (true) { -> true; }
                                            default
                                            {
                                                switch (t1 == TokenType.MINUS_ASSIGN)
                                                {
                                                    case (true) { -> true; }
                                                    default
                                                    {
                                                        switch (t1 == TokenType.BACKTICK)
                                                        {
                                                            case (true) {
                                                            -> t2 == TokenType.LESS_THAN | t2 == TokenType.LESS_EQUAL |
                                                                   t2 == TokenType.GREATER_THAN | t2 == TokenType.GREATER_EQUAL;
                                                        }
                                                            default
                                                            {
                                                                -> false;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            consume_relop() -> byte*
            {
                switch (this.expect(TokenType.TIE))
                {
                    case (true) {
                    this.advance();
                    this.consume(TokenType.ASSIGN);
                    -> g"~=\0";
                }
                    default
                    {
                        this.consume(TokenType.NOT);
                        switch (this.expect(TokenType.TIE))
                        {
                            case (true) {
                            this.advance();
                            this.consume(TokenType.ASSIGN);
                            -> g"!~=\0";
                        }
                            default
                            {
                                switch (this.expect(TokenType.ADDRESS_OF))
                                {
                                    case (true) { this.advance(); -> g"!@\0"; }
                                    default
                                    {
                                        switch (this.expect(TokenType.MINUS_ASSIGN))
                                        {
                                            case (true) { this.advance(); -> g"!-=\0"; }
                                            default
                                            {
                                                this.consume(TokenType.BACKTICK);
                                                switch (this.expect(TokenType.LESS_EQUAL))
                                                {
                                                    case (true) { this.advance(); -> g"!`<=\0"; }
                                                    default
                                                    {
                                                        switch (this.expect(TokenType.LESS_THAN))
                                                        {
                                                            case (true) { this.advance(); -> g"!`<\0"; }
                                                            default
                                                            {
                                                                switch (this.expect(TokenType.GREATER_EQUAL))
                                                                {
                                                                    case (true) { this.advance(); -> g"!`>=\0"; }
                                                                    default
                                                                    {
                                                                        switch (this.expect(TokenType.GREATER_THAN))
                                                                        {
                                                                            case (true) { this.advance(); -> g"!`>\0"; }
                                                                            default
                                                                            {
                                                                                this.error_exp(g"Unknown constraint operator after '!`'\0", TokenType.GREATER_THAN);
                                                                                -> (byte*)0;
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            cs_emit(Node* d, PtrVec* lhs, byte* op, PtrVec* rhs, int line, int col) -> void
            {
                Node* rel = this.mk(NodeKind.CONSTRA_RELATION, line, col);
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        node_push(d, 1, rel);
                        rel.text = op;
                        Node* id;
                        int i;
                        while (i < lhs.len)
                        {
                            id = this.mk(NodeKind.IDENTIFIER, line, col);
                            switch (this.failed)
                            {
                                case (true) { ->; }
                                default
                                {
                                    id.text = (byte*)lhs.items[i];
                                    node_push(rel, 0, id);
                                    i++;
                                };
                            };
                        };
                        i = 0;
                        while (i < rhs.len)
                        {
                            id = this.mk(NodeKind.IDENTIFIER, line, col);
                            switch (this.failed)
                            {
                                case (true) { ->; }
                                default
                                {
                                    id.text = (byte*)rhs.items[i];
                                    node_push(rel, 1, id);
                                    i++;
                                };
                            };
                        };
                        ->;
                    };
                };
            };



            cs_element(Node* d, PtrVec* out) -> void
            {
                PtrVec* ns;
                PtrVec* rhs;
                byte* op;
                int line, col, i;
                PtrVec* res;
                switch (!this.expect(TokenType.LEFT_BRACKET))
                {
                    case (true) {
                    -> pv_push(out, (void*)this.ident());
                }
                    default
                    {
                        line = this.cur_line();
                        col = this.cur_col();
                        this.advance();
                        ns = pv_new();
                        pv_push(ns, (void*)this.ident());
                        while (!this.failed & this.expect(TokenType.LOGICAL_AND) & this.type_at(1) == TokenType.IDENTIFIER)
                        {
                            this.advance();
                            pv_push(ns, (void*)this.ident());
                        };
                        res = ns;
                        switch (!this.failed & this.is_relop())
                        {
                            case (true) {
                            op = this.consume_relop();
                            rhs = pv_new();
                            pv_push(rhs, (void*)this.ident());
                            while (!this.failed & this.expect(TokenType.LOGICAL_AND) & this.type_at(1) == TokenType.IDENTIFIER)
                            {
                                this.advance();
                                pv_push(rhs, (void*)this.ident());
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.cs_emit(d, ns, op, rhs, line, col); }
                                default {};
                            };
                            res = rhs;
                        }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.RIGHT_BRACKET); }
                            default {};
                        };
                        while (i < res.len)
                        {
                            pv_push(out, res.items[i]);
                            i++;
                        };
                        switch (res != ns)
                        {
                            case (true) { pv_free(res); }
                            default {};
                        };
                        -> pv_free(ns);
                    };
                };
            };


            cs_idlist(Node* d, PtrVec* out) -> void
            {
                int t1;
                this.cs_element(d, out);
                while (!this.failed & this.expect(TokenType.LOGICAL_AND))
                {
                    t1 = this.type_at(1);
                    switch (t1 != TokenType.IDENTIFIER & t1 != TokenType.LEFT_BRACKET)
                    {
                        case (true) { break; }
                        default
                        {
                            this.advance();
                            this.cs_element(d, out);
                        };
                    };
                };
                ->;
            };


            cs_rel_expr(Node* d) -> void
            {
                PtrVec* lhs = pv_new();
                PtrVec* rhs;
                byte* op;
                int line = this.cur_line();
                int col = this.cur_col();
                this.cs_idlist(d, lhs);
                while (!this.failed & this.is_relop())
                {
                    op = this.consume_relop();
                    rhs = pv_new();
                    this.cs_idlist(d, rhs);
                    switch (!this.failed)
                    {
                        case (true) { this.cs_emit(d, lhs, op, rhs, line, col); }
                        default {};
                    };
                    pv_free(lhs);
                    lhs = rhs;
                };
                -> pv_free(lhs);
            };

            cs_less(byte* a, byte* b) -> bool
            {
                int i;
                while (a[i] != (byte)0 & a[i] == b[i]) { i++; };
                -> a[i] < b[i];
            };


            cs_same_set(Node* x, int lx, Node* y, int ly) -> bool
            {
                int i, j;
                bool hit;
                int nx = node_count(x, lx);
                int ny = node_count(y, ly);
                while (i < nx)
                {
                    hit = false;
                    j = 0;
                    while (j < ny & !hit)
                    {
                        switch (cstr_eq(node_child(x, lx, i).text, node_child(y, ly, j).text))
                        {
                            case (true) { hit = true; }
                            default {};
                        };
                        j++;
                    };
                    switch (!hit)
                    {
                        case (true) { -> false; }
                        default
                        {
                            i++;
                        };
                    };
                };
                i = 0;
                while (i < ny)
                {
                    hit = false;
                    j = 0;
                    while (j < nx & !hit)
                    {
                        switch (cstr_eq(node_child(y, ly, i).text, node_child(x, lx, j).text))
                        {
                            case (true) { hit = true; }
                            default {};
                        };
                        j++;
                    };
                    switch (!hit)
                    {
                        case (true) { -> false; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> true;
            };


            cs_put_sorted(Node* rel, int l) -> void
            {
                int n = node_count(rel, l);
                PtrVec* v = pv_new();
                int i, j;
                byte* t;
                while (i < n)
                {
                    pv_push(v, (void*)node_child(rel, l, i).text);
                    i++;
                };
                i = 1;
                while (i < v.len)
                {
                    j = i;
                    while (j > 0 & this.cs_less((byte*)v.items[j], (byte*)v.items[j - 1]))
                    {
                        t = (byte*)v.items[j];
                        v.items[j] = v.items[j - 1];
                        v.items[j - 1] = (void*)t;
                        j--;
                    };
                    i++;
                };
                i = 0;
                while (i < v.len)
                {
                    switch (i > 0)
                    {
                        case (true) { this.sb.put_str(g" & \0"); }
                        default {};
                    };
                    this.sb.put_str((byte*)v.items[i]);
                    i++;
                };
                -> pv_free(v);
            };


            cs_mutex(byte* op) -> byte*
            {
                switch (cstr_eq(op, g"~=\0"))
                {
                    case (true) { -> g"!~=\0"; }
                    default
                    {
                        switch (cstr_eq(op, g"!~=\0"))
                        {
                            case (true) { -> g"~=\0"; }
                            default
                            {
                                switch (cstr_eq(op, g"!`<=\0"))
                                {
                                    case (true) { -> g"!`>=\0"; }
                                    default
                                    {
                                        switch (cstr_eq(op, g"!`>=\0"))
                                        {
                                            case (true) { -> g"!`<=\0"; }
                                            default
                                            {
                                                -> (byte*)0;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            cs_error_at(int m) -> void
            {
                this.reset(m);
                this.error(this.own_n(this.sb.mem, this.sb.len));
                ->;
            };


            constra_merge(Node* d, int m0, PtrVec* rename) -> void
            {
                PtrVec* srcs = pv_new();
                int m, i, j, k, base, nrel, rn;
                byte* sname;
                byte* mapped;
                byte* mx;
                Node* src;
                Node* rel;
                Node* nrelnode;
                Node* id;
                Node* prev;
                PtrVec* finals = pv_new();
                bool more = true;
                while (more & !this.failed)
                {
                    m = this.mark();
                    sname = this.ident();
                    switch (this.failed)
                    {
                        case (true) { break; }
                        default
                        {
                            switch (!nm_has(this.constras, sname))
                            {
                                case (true) {
                                this.reset(m);
                                this.sb.len = 0;
                                this.sb.put_str(f"Unknown constraint set '{sname}' in constra merge\0");
                                this.cs_error_at(m);
                                break;
                            }
                                default
                                {
                                    pv_push(srcs, nm_get(this.constras, sname));
                                    more = this.expect(TokenType.PLUS);
                                    switch (more)
                                    {
                                        case (true) { this.advance(); }
                                        default {};
                                    };
                                };
                            };
                        };
                    };
                };
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.SEMICOLON); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) {
                    pv_free(srcs);
                    -> pv_free(finals);
                }
                    default
                    {
                        src = (Node*)srcs.items[0];
                        base = node_count(src, 0);
                        i = 1;
                        while (i < srcs.len & !this.failed)
                        {
                            prev = (Node*)srcs.items[i];
                            switch (node_count(prev, 0) != base)
                            {
                                case (true) {
                                this.sb.len = 0;
                                this.sb.put_str(f"Cannot merge constraint sets of different arity: '{src.text}' has {base} parameter(s) but '{prev.text}' has {node_count(prev, 0)}\0");
                                this.cs_error_at(m0);
                            }
                                default {};
                            };
                            i++;
                        };
                        switch (!this.failed & rename != (PtrVec*)0)
                        {
                            case (true) {
                            switch (rename.len != base)
                            {
                                case (true) {
                                this.sb.len = 0;
                                this.sb.put_str(f"Rename parameter list has {rename.len} name(s) but merged constraint sets have arity {base}\0");
                                this.cs_error_at(m0);
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                        switch (this.failed)
                        {
                            case (true) {
                            pv_free(srcs);
                            -> pv_free(finals);
                        }
                            default
                            {
                                i = 0;
                                while (i < base)
                                {
                                    switch (rename != (PtrVec*)0)
                                    {
                                        case (true) { pv_push(finals, rename.items[i]); }
                                        default { pv_push(finals, (void*)node_child(src, 0, i).text); };
                                    };
                                    id = this.mk(NodeKind.IDENTIFIER, d.line, d.col);
                                    switch (this.failed)
                                    {
                                        case (true) { break; }
                                        default
                                        {
                                            id.text = (byte*)finals.items[i];
                                            node_push(d, 0, id);
                                            i++;
                                        };
                                    };
                                };

                                i = 0;
                                while (i < srcs.len & !this.failed)
                                {
                                    src = (Node*)srcs.items[i];
                                    nrel = node_count(src, 1);
                                    j = 0;
                                    while (j < nrel & !this.failed)
                                    {
                                        rel = node_child(src, 1, j);
                                        nrelnode = this.mk(NodeKind.CONSTRA_RELATION, rel.line, rel.col);
                                        switch (this.failed)
                                        {
                                            case (true) { break; }
                                            default
                                            {
                                                node_push(d, 1, nrelnode);
                                                nrelnode.text = rel.text;
                                                rn = 0;
                                                while (rn < 2)
                                                {
                                                    k = 0;
                                                    while (k < node_count(rel, rn) & !this.failed)
                                                    {
                                                        mapped = node_child(rel, rn, k).text;
                                                        base = node_count(src, 0) - 1;
                                                        while (base >= 0)
                                                        {
                                                            switch (cstr_eq(node_child(src, 0, base).text, mapped))
                                                            {
                                                                case (true) {
                                                                mapped = (byte*)finals.items[base];
                                                                break;
                                                            }
                                                                default
                                                                {
                                                                    base--;
                                                                };
                                                            };
                                                        };
                                                        id = this.mk(NodeKind.IDENTIFIER, rel.line, rel.col);
                                                        switch (this.failed)
                                                        {
                                                            case (true) { break; }
                                                            default
                                                            {
                                                                id.text = mapped;
                                                                node_push(nrelnode, rn, id);
                                                                k++;
                                                            };
                                                        };
                                                    };
                                                    rn++;
                                                };
                                                j++;
                                            };
                                        };
                                    };
                                    i++;
                                };

                                nrel = node_count(d, 1);
                                i = 0;
                                while (i < nrel & !this.failed)
                                {
                                    rel = node_child(d, 1, i);
                                    mx = this.cs_mutex(rel.text);
                                    j = 0;
                                    while (mx != (byte*)0 & j < i & !this.failed)
                                    {
                                        prev = node_child(d, 1, j);
                                        switch (cstr_eq(prev.text, mx) &
                                            this.cs_same_set(prev, 0, rel, 0) & this.cs_same_set(prev, 1, rel, 1))
                                        {
                                            case (true) {
                                            this.sb.len = 0;
                                            this.sb.put_str(f"Conflicting constraints in merge '{d.text}': '\0");
                                            this.cs_put_sorted(rel, 0);
                                            this.sb.put_str(f" {mx} \0");
                                            this.cs_put_sorted(rel, 1);
                                            this.sb.put_str(g"' and '\0");
                                            this.cs_put_sorted(rel, 0);
                                            this.sb.put_str(f" {rel.text} \0");
                                            this.cs_put_sorted(rel, 1);
                                            this.sb.put_str(g"' cannot be true simultaneously\0");
                                            this.cs_error_at(m0);
                                        }
                                            default {};
                                        };
                                        j++;
                                    };
                                    i++;
                                };
                                pv_free(srcs);
                                -> pv_free(finals);
                            };
                        };
                    };
                };
            };


            constra_def() -> Node*
            {
                int m0 = this.mark();
                Node* d = this.mk(NodeKind.CONSTRA_DEF, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> d; }
                    default
                    {
                        Node* id;
                        PtrVec* rename;
                        int m;
                        bool more;
                        this.advance();
                        d.text = this.ident();
                        switch (!this.failed & this.expect(TokenType.LEFT_PAREN))
                        {
                            case (true) {
                            m = this.mark();
                            this.advance();
                            rename = pv_new();
                            switch (!this.expect(TokenType.RIGHT_PAREN))
                            {
                                case (true) {
                                more = true;
                                while (more & !this.failed)
                                {
                                    pv_push(rename, (void*)this.ident());
                                    more = this.expect(TokenType.COMMA);
                                    switch (more)
                                    {
                                        case (true) { this.advance(); }
                                        default {};
                                    };
                                };
                            }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                default {};
                            };
                            switch (!this.failed & !this.expect(TokenType.ASSIGN))
                            {
                                case (true) {
                                pv_free(rename);
                                rename = (PtrVec*)0;
                                this.reset(m);
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                        switch (!this.failed & this.expect(TokenType.ASSIGN))
                        {
                            case (true) {
                            this.advance();
                            this.constra_merge(d, m0, rename);
                            switch (rename != (PtrVec*)0)
                            {
                                case (true) { pv_free(rename); }
                                default {};
                            };
                            switch (this.failed)
                            {
                                case (true) { -> this.done(d); }
                                default {};
                            };
                            nm_put(this.constras, d.text, (void*)d);
                            -> d;
                        }
                            default
                            {
                                switch (rename != (PtrVec*)0)
                                {
                                    case (true) { pv_free(rename); }
                                    default {};
                                };
                                switch (!this.failed & this.expect(TokenType.LEFT_PAREN))
                                {
                                    case (true) {
                                    this.advance();
                                    switch (!this.expect(TokenType.RIGHT_PAREN))
                                    {
                                        case (true) {
                                        more = true;
                                        while (more & !this.failed)
                                        {
                                            id = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                                            switch (this.failed)
                                            {
                                                case (true) { break; }
                                                default
                                                {
                                                    node_push(d, 0, id);
                                                    id.text = this.ident();
                                                    more = this.expect(TokenType.COMMA);
                                                    switch (more)
                                                    {
                                                        case (true) { this.advance(); }
                                                        default {};
                                                    };
                                                };
                                            };
                                        };
                                    }
                                        default {};
                                    };
                                    switch (!this.failed)
                                    {
                                        case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.LEFT_BRACE); }
                                    default {};
                                };
                                switch (!this.failed)
                                {
                                    case (true) { this.cs_rel_expr(d); }
                                    default {};
                                };
                                while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                                {
                                    switch (this.expect(TokenType.COMMA))
                                    {
                                        case (true) { this.advance(); }
                                        default {};
                                    };
                                    this.cs_rel_expr(d);
                                };
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                    default {};
                                };
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.SEMICOLON); }
                                    default {};
                                };
                                switch (this.failed)
                                {
                                    case (true) { -> this.done(d); }
                                    default
                                    {
                                        nm_put(this.constras, d.text, (void*)d);
                                        -> d;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            tf_receiver_name() -> byte*
            {
                int t = this.cur();
                switch (t == TokenType.BYTE)
                {
                    case (true) { -> g"byte\0"; }
                    default
                    {
                        switch (t == TokenType.SINT | t == TokenType.SINT_LITERAL)
                        {
                            case (true) { -> g"int\0"; }
                            default
                            {
                                switch (t == TokenType.UINT | t == TokenType.UINT_LITERAL)
                                {
                                    case (true) { -> g"uint\0"; }
                                    default
                                    {
                                        switch (t == TokenType.SLONG | t == TokenType.SLONG_LITERAL)
                                        {
                                            case (true) { -> g"long\0"; }
                                            default
                                            {
                                                switch (t == TokenType.ULONG | t == TokenType.ULONG_LITERAL)
                                                {
                                                    case (true) { -> g"ulong\0"; }
                                                    default
                                                    {
                                                        switch (t == TokenType.FLOAT_KW | t == TokenType.FLOAT)
                                                        {
                                                            case (true) { -> g"float\0"; }
                                                            default
                                                            {
                                                                switch (t == TokenType.DOUBLE_KW | t == TokenType.DOUBLE)
                                                                {
                                                                    case (true) { -> g"double\0"; }
                                                                    default
                                                                    {
                                                                        switch (t == TokenType.BOOL_KW | t == TokenType.TRUE | t == TokenType.FALSE)
                                                                        {
                                                                            case (true) { -> g"bool\0"; }
                                                                            default
                                                                            {
                                                                                switch (t == TokenType.STRING_LITERAL | t == TokenType.F_STRING | t == TokenType.I_STRING)
                                                                                {
                                                                                    case (true) { -> g"string\0"; }
                                                                                    default
                                                                                    {
                                                                                        switch (t == TokenType.CHAR)
                                                                                        {
                                                                                            case (true) { -> g"char\0"; }
                                                                                            default
                                                                                            {
                                                                                                switch (t == TokenType.IDENTIFIER)
                                                                                                {
                                                                                                    case (true) { -> this.cur_value(); }
                                                                                                    default
                                                                                                    {
                                                                                                        -> (byte*)0;
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            tf_receiver_ts(byte* tn, int depth, bool is_array) -> TypeSpec*
            {
                TypeSpec* t = typespec_new();
                int base = -1;
                switch (cstr_eq(tn, g"string\0") | (cstr_eq(tn, g"byte\0") & depth >= 1))
                {
                    case (true) {
                    switch (depth < 1)
                    {
                        case (true) { depth = 1; }
                        default {};
                    };
                    t.base_type = DataType.BYTE;
                    t.pointer_depth = depth;
                    t.flags = t.flags `| 64;
                    -> t;
                }
                    default
                    {
                        switch (cstr_eq(tn, g"byte\0"))
                        {
                            case (true) { base = DataType.BYTE; }
                            default {
                                switch (cstr_eq(tn, g"int\0"))
                                {
                                    case (true) { base = DataType.SINT; }
                                    default {
                                        switch (cstr_eq(tn, g"uint\0"))
                                        {
                                            case (true) { base = DataType.UINT; }
                                            default {
                                                switch (cstr_eq(tn, g"long\0"))
                                                {
                                                    case (true) { base = DataType.SLONG; }
                                                    default {
                                                        switch (cstr_eq(tn, g"ulong\0"))
                                                        {
                                                            case (true) { base = DataType.ULONG; }
                                                            default {
                                                                switch (cstr_eq(tn, g"float\0"))
                                                                {
                                                                    case (true) { base = DataType.FLOAT; }
                                                                    default {
                                                                        switch (cstr_eq(tn, g"double\0"))
                                                                        {
                                                                            case (true) { base = DataType.DOUBLE; }
                                                                            default {
                                                                                switch (cstr_eq(tn, g"bool\0"))
                                                                                {
                                                                                    case (true) { base = DataType.BOOL; }
                                                                                    default {
                                                                                        switch (cstr_eq(tn, g"char\0"))
                                                                                        {
                                                                                            case (true) { base = DataType.CHAR; }
                                                                                            default {};
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        switch (base < 0)
                        {
                            case (true) {
                            t.base_type = DataType.DATA;
                            t.custom_typename = tn;
                        }
                            default {
                            t.base_type = base;
                        };
                        };
                        switch (is_array)
                        {
                            case (true) { t.flags = t.flags `| 32; }
                            default {
                                switch (depth > 0)
                                {
                                    case (true) {
                            t.pointer_depth = depth;
                            t.flags = t.flags `| 64;
                        }
                                    default {};
                                };
                            };
                        };
                        -> t;
                    };
                };
            };


            type_func_def() -> Node*
            {
                NameMap* prev_act = this.active_tp;
                TemplateEntry* prev_cur = this.tmpl_cur;
                this.tmpl_cur = (TemplateEntry*)0;
                Node* d = this.type_func_def_inner();
                TemplateEntry* te = this.tmpl_cur;
                this.tmpl_cur = prev_cur;
                switch (this.active_tp != prev_act)
                {
                    case (true) {
                    nm_free(this.active_tp);
                    this.active_tp = prev_act;
                }
                    default {};
                };
                switch (te == (TemplateEntry*)0)
                {
                    case (true) { -> d; }
                    default
                    {
                        switch (this.failed | d == (Node*)0)
                        {
                            case (true) {
                            te_free(te);
                            -> d;
                        }
                            default
                            {
                                this.tf_to_function(d);
                                this.last_template = d.text;
                                this.register_template(d.text, 0, te, d);
                                -> (Node*)0;
                            };
                        };
                    };
                };
            };



            tf_to_function(Node* d) -> void
            {
                PtrVec* tmp = pv_new();
                Node* p0 = this.mk(NodeKind.PARAMETER, d.line, d.col);
                int i, n;
                switch (this.failed)
                {
                    case (true) { -> pv_free(tmp); }
                    default
                    {
                        p0.text = g"_\0";
                        p0.ts = d.ts2;
                        d.ts2 = (TypeSpec*)0;
                        n = node_count(d, 0);
                        while (i < n)
                        {
                            pv_push(tmp, (void*)node_child(d, 0, i));
                            i++;
                        };
                        switch (n > 0)
                        {
                            case (true) { d.l0.len = 0; }
                            default {};
                        };
                        node_push(d, 0, p0);
                        i = 0;
                        while (i < n)
                        {
                            node_push(d, 0, (Node*)tmp.items[i]);
                            i++;
                        };
                        pv_free(tmp);
                        d.text = this.cat2(this.cat2(this.cat2(g"__typefunc__\0", d.text), g"__\0"), d.text2);
                        d.text2 = (byte*)0;
                        d.kind = NodeKind.FUNCTION_DEF;
                        ->;
                    };
                };
            };

            type_func_def_inner() -> Node*
            {
                Node* d = this.mk(NodeKind.TYPE_FUNC_DEF, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> d; }
                    default
                    {
                        bool tied = false;
                        bool is_array = false;
                        int depth = 0;
                        byte* tn;
                        byte* eff;
                        int k;
                        TypeSpec* rts;
                        Node* fl;
                        switch (this.expect(TokenType.TIE))
                        {
                            case (true) { tied = true; this.advance(); }
                            default {};
                        };
                        tn = this.tf_receiver_name();
                        switch (tn == (byte*)0)
                        {
                            case (true) {
                            this.error_exp(g"Expected a type keyword, literal, or struct name as type function receiver\0", TokenType.IDENTIFIER);
                            -> this.done(d);
                        }
                            default
                            {
                                switch (this.st != (IDKC_SYMTABLE*)0)
                                {
                                    case (true) {
                                    switch (st_is_nofunc(this.st, tn))
                                    {
                                        case (true) {
                                        this.error(this.cat2(this.cat2(g"Type \0", tn), g" is non-functional (declared with data!) and cannot have type functions defined on it\0"));
                                        -> this.done(d);
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                this.advance();
                                while (this.expect(TokenType.MULTIPLY)) { depth++; this.advance(); };
                                switch (this.expect(TokenType.LEFT_BRACKET))
                                {
                                    case (true) {
                                    this.advance();
                                    this.consume(TokenType.RIGHT_BRACKET);
                                    is_array = true;
                                }
                                    default {};
                                };
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.DOT); }
                                    default {};
                                };
                                switch (this.failed)
                                {
                                    case (true) { -> this.done(d); }
                                    default
                                    {
                                        switch (this.expect2(TokenType.F_STRING, TokenType.I_STRING))
                                        {
                                            case (true) {
                                            fl = this.fstr_node();
                                            switch (this.failed)
                                            {
                                                case (true) { -> this.done(d); }
                                                default
                                                {
                                                    d.text2 = this.fstr_resolve(fl);
                                                    node_free(fl);
                                                    switch (d.text2 == (byte*)0)
                                                    {
                                                        case (true) {
                                                        this.error(g"The type function name could not be resolved at parse time\0");
                                                        -> this.done(d);
                                                    }
                                                        default {};
                                                    };
                                                };
                                            };
                                        }
                                            default {
                                                switch (this.expect(TokenType.STRING_LITERAL))
                                                {
                                                    case (true) {
                                            d.text2 = this.cur_value();
                                            this.advance();
                                        }
                                                    default {
                                            d.text2 = this.ident();
                                        };
                                                };
                                            };
                                        };
                                        switch (this.failed)
                                        {
                                            case (true) { -> this.done(d); }
                                            default
                                            {
                                                switch (this.expect(TokenType.RECURSE_ARROW))
                                                {
                                                    case (true) {

                                                    this.fail_expected(TokenType.LEFT_PAREN);
                                                    this.err_got = TokenType.LESS_THAN;
                                                    -> this.done(d);
                                                }
                                                    default
                                                    {
                                                        switch (this.expect(TokenType.LESS_THAN))
                                                        {
                                                            case (true) {
                                                            this.tmpl_cur = this.template_params(true);
                                                            switch (this.failed)
                                                            {
                                                                case (true) { -> this.done(d); }
                                                                default
                                                                {
                                                                    this.tp_activate(this.tmpl_cur);
                                                                };
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                        this.consume(TokenType.LEFT_PAREN);
                                                        switch (!this.failed & !this.expect(TokenType.RIGHT_PAREN))
                                                        {
                                                            case (true) { this.parameter_list(d); }
                                                            default {};
                                                        };
                                                        switch (!this.failed)
                                                        {
                                                            case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                                            default {};
                                                        };
                                                        switch (!this.failed)
                                                        {
                                                            case (true) { this.consume(TokenType.RETURN_ARROW); }
                                                            default {};
                                                        };
                                                        switch (!this.failed)
                                                        {
                                                            case (true) { d.ts = this.type_spec(); }
                                                            default {};
                                                        };
                                                        switch (this.failed)
                                                        {
                                                            case (true) { -> this.done(d); }
                                                            default
                                                            {
                                                                rts = this.tf_receiver_ts(tn, depth, is_array);
                                                                switch (tied)
                                                                {
                                                                    case (true) { rts.flags = rts.flags `| 8; }
                                                                    default {};
                                                                };
                                                                d.ts2 = rts;

                                                                eff = tn;
                                                                switch (depth > 0 & cstr_eq(tn, g"byte\0"))
                                                                {
                                                                    case (true) { eff = g"string\0"; }
                                                                    default {
                                                                        switch (depth > 0)
                                                                        {
                                                                            case (true) {
                                                                    k = 0;
                                                                    while (k < depth) { eff = this.cat2(eff, g"_ptr\0"); k++; };
                                                                }
                                                                            default {
                                                                                switch (is_array)
                                                                                {
                                                                                    case (true) { eff = this.cat2(tn, g"_arr\0"); }
                                                                                    default {};
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                                switch (tied)
                                                                {
                                                                    case (true) { eff = this.cat2(g"tied_\0", eff); }
                                                                    default {};
                                                                };
                                                                d.text = eff;
                                                                switch (this.expect(TokenType.SEMICOLON))
                                                                {
                                                                    case (true) {
                                                                    this.advance();
                                                                    d.flags = 512;
                                                                    d.a = this.mk(NodeKind.BLOCK, d.line, d.col);
                                                                    -> this.done(d);
                                                                }
                                                                    default
                                                                    {
                                                                        d.a = this.block();
                                                                        switch (!this.failed)
                                                                        {
                                                                            case (true) { this.consume(TokenType.SEMICOLON); }
                                                                            default {};
                                                                        };
                                                                        -> this.done(d);
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            token_source() -> void
            {
                int tt = this.cur();
                byte* v = this.cur_value();
                int n = this.cur_value_len();
                int i;
                int b;
                switch (tt == TokenType.STRING_LITERAL | tt == TokenType.G_STRING)
                {
                    case (true) {
                    switch (tt == TokenType.G_STRING)
                    {
                        case (true) { this.sb.put('g'); }
                        default {};
                    };
                    this.sb.put('"');
                    while (i < n)
                    {
                        b = (int)v[i];
                        switch (b == 92 | b == '"')
                        {
                            case (true) { this.sb.put(92); }
                            default {};
                        };
                        this.sb.put(b);
                        i++;
                    };
                    -> this.sb.put('"');
                }
                    default
                    {
                        switch (tt == TokenType.CHAR)
                        {
                            case (true) {
                            switch (this.toks[this.pos].numeric_char != 0)
                            {
                                case (true) {
                                this.sb.put_n(v, n);
                                -> this.sb.put('c');
                            }
                                default {};
                            };
                            this.sb.put(39);
                            while (i < n)
                            {
                                b = (int)v[i];
                                switch (b == 92 | b == 39)
                                {
                                    case (true) { this.sb.put(92); }
                                    default {};
                                };
                                this.sb.put(b);
                                i++;
                            };
                            -> this.sb.put(39);
                        }
                            default
                            {
                                switch (tt == TokenType.BYTE_LITERAL)
                                {
                                    case (true) {
                                    this.sb.put_n(v, n);
                                    -> this.sb.put('b');
                                }
                                    default
                                    {
                                        -> this.sb.put_n(v, n);
                                    };
                                };
                            };
                        };
                    };
                };
            };


            ef_begin(bool glue) -> void
            {
                switch (this.sb.len > 0 & !glue)
                {
                    case (true) { this.sb.put(' '); }
                    default {};
                };
                ->;
            };





            emitideka_statement() -> Node*
            {
                Node* n = this.mk(NodeKind.EMIT_IDEKA, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.advance();
                        switch (!this.consume(TokenType.LEFT_BRACE))
                        {
                            case (true) { -> this.done(n); }
                            default
                            {
                                this.sb.len = 0;
                                this.sb.mem[0] = (byte)0;
                                int depth = 1;
                                int c;
                                bool glue = false;
                                bool stop = false;
                                while (depth > 0 & !stop & !this.failed)
                                {
                                    c = this.cur();
                                    switch (c == TokenType.EOF)
                                    {
                                        case (true) {
                                        this.error(g"Unexpected EOF inside 'emitideka' block\0");
                                        break;
                                    }
                                        default
                                        {
                                            switch (c == TokenType.TAG)
                                            {
                                                case (true) {
                                                switch (this.type_at(1) == TokenType.RIGHT_BRACE & this.type_at(2) == TokenType.SEMICOLON)
                                                {
                                                    case (true) {
                                                    this.advance();
                                                    this.ef_begin(glue);
                                                    this.sb.put('}');
                                                    this.advance();
                                                    this.ef_begin(false);
                                                    this.sb.put(';');
                                                    this.advance();
                                                    glue = false;
                                                    continue;
                                                }
                                                    default {};
                                                };
                                                this.ef_begin(glue);
                                                this.token_source();
                                                glue = false;
                                                this.advance();
                                                continue;
                                            }
                                                default
                                                {
                                                    switch (c)
                                                    {
                                                        case (TokenType.LEFT_BRACE)
                                                        {
                                                            depth++;
                                                            this.ef_begin(glue);
                                                            this.sb.put('{');
                                                            glue = false;
                                                        }
                                                        case (TokenType.RIGHT_BRACE)
                                                        {
                                                            switch (this.type_at(1) == TokenType.TAG)
                                                            {
                                                                case (true) {
                                                                this.advance();
                                                                this.advance();
                                                                stop = true;
                                                            }
                                                                default {
                                                                depth--;
                                                                switch (depth > 0)
                                                                {
                                                                    case (true) {
                                                                    this.ef_begin(glue);
                                                                    this.sb.put('}');
                                                                    glue = false;
                                                                }
                                                                    default {
                                                                    this.advance();
                                                                    stop = true;
                                                                };
                                                                };
                                                            };
                                                            };
                                                        }
                                                        default
                                                        {
                                                            this.ef_begin(glue);
                                                            this.token_source();
                                                            glue = (c == TokenType.CODIFY);
                                                        };
                                                    };
                                                    switch (!stop)
                                                    {
                                                        case (true) { this.advance(); }
                                                        default {};
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.SEMICOLON); }
                                    default {};
                                };
                                n.text = this.own_n(this.sb.mem, this.sb.len);
                                -> this.done(n);
                            };
                        };
                    };
                };
            };





            note_comptime_string(byte* name, TypeSpec* ts, Node* init) -> void
            {
                switch (init == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (init.kind != NodeKind.STRING_LITERAL)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch ((ts.flags `& 64) == 0)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        switch (ts.base_type != DataType.BYTE)
                                        {
                                            case (true) { ->; }
                                            default
                                            {
                                                -> nm_put(this.cstrs, name, (void*)init.text);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            codify_unknown(byte* name) -> void -> this.error3(g"~$: '\0", name, g"' is not a compile-time-known byte* string literal. Only variables declared as 'byte* name = \"...\";' are supported.\0");




            codify_text_of(bool strict) -> byte*
            {
                Node* fl;
                Node* p;
                byte* val;
                int k, cnt;
                switch (this.expect(TokenType.F_STRING))
                {
                    case (true) { fl = this.f_string_node(); }
                    default { fl = this.i_string_node(); };
                };
                switch (this.failed)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        this.sb.len = 0;
                        this.sb.mem[0] = (byte)0;
                        cnt = node_count(fl, 0);
                        while (k < cnt & !this.failed)
                        {
                            p = node_child(fl, 0, k);
                            switch (p.kind)
                            {
                                case (NodeKind.STRING_LITERAL)
                                {
                                    this.sb.put_str(p.text);
                                }
                                case (NodeKind.IDENTIFIER)
                                {
                                    val = (byte*)nm_get(this.cstrs, p.text);
                                    switch (val != (byte*)0)
                                    {
                                        case (true) { this.sb.put_str(val); }
                                        default {
                                            switch (strict)
                                            {
                                                case (true) { this.codify_unknown(p.text); }
                                                default { this.sb.put_str(p.text); };
                                            };
                                        };
                                    };
                                }
                                default
                                {
                                    this.error(g"~$: an interpolated expression must be an identifier\0");
                                };
                            };
                            k++;
                        };
                        node_free(fl);
                        switch (this.failed)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                -> this.own_n(this.sb.mem, this.sb.len);
                            };
                        };
                    };
                };
            };



            consume_codify() -> byte*
            {
                this.advance();
                switch (this.expect2(TokenType.F_STRING, TokenType.I_STRING))
                {
                    case (true) { -> this.codify_text_of(false); }
                    default
                    {
                        byte* name = this.ident();
                        switch (this.failed)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                byte* val = (byte*)nm_get(this.cstrs, name);
                                switch (val != (byte*)0)
                                {
                                    case (true) { -> val; }
                                    default
                                    {
                                        -> name;
                                    };
                                };
                            };
                        };
                    };
                };
            };



            splice_source(byte* src) -> Node*
            {
                int n = pp_cstrlen(src);
                byte* text = this.own_n(src, n);
                Lexer* sl = (Lexer*)fmalloc((u64)((sizeof(Lexer) + 7) / 8));
                switch (sl == (Lexer*)0)
                {
                    case (true) {
                    this.fail_alloc();
                    -> (Node*)0;
                }
                    default
                    {
                        sl.__init(text, n);
                        pv_push(this.sublex, (void*)sl);
                        switch (!sl.tokenize())
                        {
                            case (true) {
                            this.error(IDEKA::lexer::error_message(sl.err_code));
                            -> (Node*)0;
                        }
                            default
                            {
                                Parser* sp = (Parser*)fmalloc((u64)((sizeof(Parser) + 7) / 8));
                                switch (sp == (Parser*)0)
                                {
                                    case (true) {
                                    this.fail_alloc();
                                    -> (Node*)0;
                                }
                                    default
                                    {
                                        sp.__init(sl);
                                        pv_push(this.subparsers, (void*)sp);
                                        sp.st = st_new();
                                        sp.default_byte_width = this.default_byte_width;
                                        sp.verbose = this.verbose;
                                        sp.toks = sl.tokens;
                                        sp.count = sl.count;
                                        sp.pos = 0;

                                        Node* first = (Node*)0;
                                        Node* stmt;
                                        int k, f;
                                        while (!sp.failed & !sp.expect(TokenType.EOF))
                                        {
                                            stmt = sp.statement();
                                            switch (sp.failed)
                                            {
                                                case (true) { break; }
                                                default
                                                {
                                                    switch (stmt != (Node*)0)
                                                    {
                                                        case (true) {
                                                        switch (first == (Node*)0)
                                                        {
                                                            case (true) { first = stmt; }
                                                            default { nv_push(this.pending, stmt); };
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                    k = 0;
                                                    while (k < sp.pending.len)
                                                    {
                                                        switch (first == (Node*)0)
                                                        {
                                                            case (true) { first = (Node*)sp.pending.items[k]; }
                                                            default { nv_push(this.pending, sp.pending.items[k]); };
                                                        };
                                                        k++;
                                                    };
                                                    sp.pending.len = 0;
                                                };
                                            };
                                        };


                                        while (f < Feat.COUNT)
                                        {
                                            switch (sp.feat_hits[f] != 0)
                                            {
                                                case (true) {
                                                switch (this.feat_hits[f] == 0)
                                                {
                                                    case (true) { this.stub_features++; }
                                                    default {};
                                                };
                                                this.feat_hits[f] = this.feat_hits[f] + sp.feat_hits[f];
                                            }
                                                default {};
                                            };
                                            f++;
                                        };
                                        this.stub_total = this.stub_total + sp.stub_total;

                                        switch (sp.failed)
                                        {
                                            case (true) {
                                            node_free(first);
                                            this.failed = true;
                                            this.err_kind = sp.err_kind;
                                            this.err_expected = sp.err_expected;
                                            this.err_got = sp.err_got;
                                            this.err_line = sp.err_line;
                                            this.err_col = sp.err_col;
                                            this.err_prev_line = sp.err_prev_line;
                                            this.err_got_len = sp.err_got_len;
                                            this.err_msg = sp.err_msg;
                                            -> (Node*)0;
                                        }
                                            default
                                            {
                                                -> first;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            codify_statement() -> Node*
            {
                byte* src = (byte*)0;
                byte* name;
                this.advance();
                switch (this.expect(TokenType.STRING_LITERAL))
                {
                    case (true) {
                    src = this.cur_value();
                    this.advance();
                }
                    default {
                        switch (this.expect2(TokenType.F_STRING, TokenType.I_STRING))
                        {
                            case (true) {
                    src = this.codify_text_of(true);
                }
                            default {
                                switch (this.expect(TokenType.IDENTIFIER))
                                {
                                    case (true) {
                    name = this.cur_value();
                    this.advance();
                    src = (byte*)nm_get(this.cstrs, name);
                    switch (src == (byte*)0)
                    {
                        case (true) { this.codify_unknown(name); }
                        default {};
                    };
                }
                                    default {
                    this.error_exp(g"~$: expected identifier, string literal, f-string, or i-string after codify operator\0", TokenType.IDENTIFIER);
                };
                                };
                            };
                        };
                    };
                };
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.SEMICOLON); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) { -> (Node*)0; }
                    default
                    {
                        -> this.splice_source(src);
                    };
                };
            };




            own(byte* s) -> byte*
            {
                pv_push(this.strs, (void*)s);
                -> s;
            };


            own_n(byte* s, int n) -> byte*
            {
                byte* r = (byte*)fmalloc((u64)n + (u64)1);
                int i;
                while (i < n)
                {
                    r[i] = s[i];
                    i++;
                };
                r[n] = (byte)0;
                -> this.own(r);
            };



            int_str(int v) -> byte*
            {
                byte* r = (byte*)fmalloc((u64)24);
                byte* tmp = (byte*)fmalloc((u64)24);
                int n = 0;
                int o = 0;
                int u = v;
                switch (u == 0) { case (true) { tmp[0] = '0'; n = 1; } default {}; };
                while (u > 0)
                {
                    tmp[n] = (byte)(48 + (u % 10));
                    n++;
                    u = u / 10;
                };
                while (n > 0)
                {
                    n--;
                    r[o] = tmp[n];
                    o++;
                };
                r[o] = (byte)0;
                ffree(tmp);
                -> r;
            };


            int_commas(int v) -> byte*
            {
                byte* r = (byte*)fmalloc((u64)40);
                byte* tmp = (byte*)fmalloc((u64)24);
                int n = 0;
                int k = 0;
                int o = 0;
                int u = v;
                switch (u == 0) { case (true) { tmp[0] = '0'; n = 1; } default {}; };
                while (u > 0)
                {
                    tmp[n] = (byte)(48 + (u % 10));
                    n++;
                    u = u / 10;
                };
                k = n;
                while (k > 0)
                {
                    k--;
                    r[o] = tmp[k];
                    o++;
                    switch (k > 0 & k % 3 == 0) { case (true) { r[o] = ','; o++; } default {}; };
                };
                r[o] = (byte)0;
                ffree(tmp);
                -> r;
            };

            cat2(byte* a, byte* b) -> byte*
            {
                int la = pp_cstrlen(a);
                int lb = pp_cstrlen(b);
                byte* r = (byte*)fmalloc((u64)(la + lb + 1));
                int i, j;
                while (i < la)
                {
                    r[i] = a[i];
                    i++;
                };
                while (j < lb)
                {
                    r[la + j] = b[j];
                    j++;
                };
                r[la + lb] = (byte)0;
                -> this.own(r);
            };

            fail_alloc() -> void
            {
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        this.failed = true;
                        this.err_kind = ParseErr.ALLOC;
                        ->;
                    };
                };
            };


            mk(int kind, int line, int col) -> Node*
            {
                Node* n = node_new(kind, line, col);
                switch (n == (Node*)0)
                {
                    case (true) { this.fail_alloc(); }
                    default {};
                };
                -> n;
            };


            clear_error() -> void
            {
                this.failed = false;
                this.err_kind = ParseErr.NONE;
                this.err_msg = (byte*)0;
                ->;
            };


            note_feat(int feat) -> void
            {
                this.stub_total++;
                switch (this.feat_hits[feat] == 0)
                {
                    case (true) { this.stub_features++; }
                    default {};
                };
                this.feat_hits[feat] = this.feat_hits[feat] + 1;
                switch (this.verbose)
                {
                    case (true) {
                    print(g"[BootstrapParser] \0");
                    print(feature_name(feat));
                    print(g" not implemented (line \0");
                    print(this.cur_line());
                    print(g", col \0");
                    print(this.cur_col());
                    println(g")\0");
                }
                    default {
                        switch (this.feat_hits[feat] == 1)
                        {
                            case (true) {
                    print(g"[BootstrapParser] \0");
                    print(feature_name(feat));
                    println(g" not implemented\0");
                }
                            default {};
                        };
                    };
                };
                ->;
            };


            error_unexpected() -> void -> this.error(this.cat2(g"Unexpected token: \0", token_name(this.cur())));



            parse_int(byte* s, bool* ok) -> i64
            {
                i64 v = 0;
                i64 base = 10;
                int i = 0;
                int d;
                int c;
                bool any = false;
                switch (s[0] == '0' & (s[1] == 'x' | s[1] == 'X'))
                {
                    case (true) { base = 16; i = 2; }
                    default {
                        switch (s[0] == '0' & (s[1] == 'b' | s[1] == 'B'))
                        {
                            case (true) { base = 2; i = 2; }
                            default {
                                switch (s[0] == '0' & (s[1] == 'o' | s[1] == 'O'))
                                {
                                    case (true) { base = 8; i = 2; }
                                    default {
                                        switch (s[0] == '0' & s[1] == 'd')
                                        {
                                            case (true) { base = 32; i = 2; }
                                            default {};
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                while (s[i] != 0)
                {
                    c = (int)s[i];
                    i++;
                    switch (c == '_')
                    {
                        case (true) { continue; }
                        default
                        {
                            d = -1;
                            switch (c >= '0' & c <= '9')
                            {
                                case (true) { d = c - '0'; }
                                default {
                                    switch (c >= 'a' & c <= 'z')
                                    {
                                        case (true) { d = c - 'a' + 10; }
                                        default {
                                            switch (c >= 'A' & c <= 'Z')
                                            {
                                                case (true) { d = c - 'A' + 10; }
                                                default {};
                                            };
                                        };
                                    };
                                };
                            };
                            switch (d < 0 | (i64)d >= base)
                            {
                                case (true) { break; }
                                default
                                {
                                    v = v * base + (i64)d;
                                    any = true;
                                };
                            };
                        };
                    };
                };

                switch (base == 32 & i == 2)
                {
                    case (true) { any = true; }
                    default {};
                };
                *ok = any;
                -> v;
            };




            bg_trim(u64* a, int* n) -> void
            {
                int k = *n;
                while (k > 0)
                {
                    switch (a[k - 1] != (u64)0)
                    {
                        case (true) { break; }
                        default
                        {
                            k--;
                        };
                    };
                };
                *n = k;
                ->;
            };

            bg_mul_small(u64* a, int* n, u64 m) -> void
            {
                u64 carry = (u64)0;
                u64 t;
                int i = 0;
                int k = *n;
                while (i < k)
                {
                    t = a[i] * m + carry;
                    a[i] = t `& (u64)4294967295;
                    carry = t >> (u64)32;
                    i++;
                };
                while (carry != (u64)0)
                {
                    a[k] = carry `& (u64)4294967295;
                    carry = carry >> (u64)32;
                    k++;
                };
                *n = k;
                ->;
            };

            bg_add_small(u64* a, int* n, u64 v) -> void
            {
                u64 carry = v;
                u64 t;
                int i = 0;
                int k = *n;
                while (carry != (u64)0)
                {
                    switch (i >= k)
                    {
                        case (true) {
                        a[i] = (u64)0;
                        k++;
                    }
                        default {};
                    };
                    t = a[i] + carry;
                    a[i] = t `& (u64)4294967295;
                    carry = t >> (u64)32;
                    i++;
                };
                *n = k;
                ->;
            };

            bg_shl(u64* a, int* n, int sh) -> void
            {
                int ls = sh / 32;
                int bs = sh % 32;
                int old = *n;
                int i;
                u64 v;
                switch (old == 0)
                {
                    case (true) { ->; }
                    default
                    {
                        i = old;
                        while (i <= old + ls)
                        {
                            a[i] = (u64)0;
                            i++;
                        };
                        i = old - 1;
                        while (i >= 0)
                        {
                            v = a[i] << (u64)bs;
                            a[i + ls + 1] = a[i + ls + 1] `| (v >> (u64)32);
                            a[i + ls] = v `& (u64)4294967295;
                            i--;
                        };
                        i = 0;
                        while (i < ls)
                        {
                            a[i] = (u64)0;
                            i++;
                        };
                        *n = old + ls + 1;
                        -> this.bg_trim(a, n);
                    };
                };
            };

            bg_div_small(u64* a, int* n, u64 d) -> u64
            {
                u64 rem = (u64)0;
                u64 cur;
                int i = *n - 1;
                while (i >= 0)
                {
                    cur = (rem << (u64)32) `| a[i];
                    a[i] = cur / d;
                    rem = cur % d;
                    i--;
                };
                this.bg_trim(a, n);
                -> rem;
            };

            bg_bitlen(u64* a, int n) -> int
            {
                int b = 0;
                u64 top;
                switch (n == 0)
                {
                    case (true) { -> 0; }
                    default
                    {
                        top = a[n - 1];
                        while (top != (u64)0)
                        {
                            b++;
                            top = top >> (u64)1;
                        };
                        -> (n - 1) * 32 + b;
                    };
                };
            };

            bg_bit(u64* a, int n, int pos) -> u64
            {
                int li = pos / 32;
                switch (pos < 0 | li >= n)
                {
                    case (true) { -> (u64)0; }
                    default
                    {
                        -> (a[li] >> (u64)(pos % 32)) `& (u64)1;
                    };
                };
            };

            bg_low_set(u64* a, int n, int pos) -> bool
            {
                int li = pos / 32;
                int i = 0;
                switch (pos <= 0)
                {
                    case (true) { -> false; }
                    default
                    {
                        while (i < li & i < n)
                        {
                            switch (a[i] != (u64)0)
                            {
                                case (true) { -> true; }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                        switch (li < n)
                        {
                            case (true) {
                            switch ((a[li] `& (((u64)1 << (u64)(pos % 32)) - (u64)1)) != (u64)0)
                            {
                                case (true) { -> true; }
                                default {};
                            };
                        }
                            default {};
                        };
                        -> false;
                    };
                };
            };


            parse_double(byte* s) -> double
            {
                u64* a = (u64*)fmalloc((u64)(8 * 160));
                int n = 0;
                int i = 0;
                int c;
                bool frac = false;
                bool exneg = false;
                int fdig = 0;
                int ex = 0;
                int e10;
                int k;
                int sh = 0;
                int bl;
                int r;
                int eb;
                int b;
                bool sticky = false;
                bool rbit;
                u64 mant = (u64)0;
                double v;
                while (s[i] != 0)
                {
                    c = (int)s[i];
                    switch (c >= '0' & c <= '9')
                    {
                        case (true) {
                        switch (n < 100)
                        {
                            case (true) {
                            this.bg_mul_small(a, @n, (u64)10);
                            this.bg_add_small(a, @n, (u64)(c - '0'));
                            switch (frac)
                            {
                                case (true) { fdig++; }
                                default {};
                            };
                        }
                            default {
                                switch (!frac)
                                {
                                    case (true) { ex = ex + 1; }
                                    default {};
                                };
                            };
                        };
                    }
                        default {
                            switch (c == '.')
                            {
                                case (true) { frac = true; }
                                default {
                                    switch (c == 'e' | c == 'E')
                                    {
                                        case (true) {
                        i++;
                        switch (s[i] == '-')
                        {
                            case (true) { exneg = true; i++; }
                            default {
                                switch (s[i] == '+')
                                {
                                    case (true) { i++; }
                                    default {};
                                };
                            };
                        };
                        k = 0;
                        while (s[i] >= '0' & s[i] <= '9')
                        {
                            switch (k < 100000)
                            {
                                case (true) { k = k * 10 + ((int)s[i] - '0'); }
                                default {};
                            };
                            i++;
                        };
                        switch (exneg)
                        {
                            case (true) { ex = ex - k; }
                            default { ex = ex + k; };
                        };
                        break;
                    }
                                        default {
                                            switch (c != '_')
                                            {
                                                case (true) { break; }
                                                default {};
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                    i++;
                };

                e10 = ex - fdig;
                switch (n == 0)
                {
                    case (true) {
                    ffree((void*)a);
                    -> 0.0;
                }
                    default
                    {
                        switch (e10 > 400)
                        {
                            case (true) { e10 = 400; }
                            default {};
                        };
                        switch (e10 < -400)
                        {
                            case (true) { e10 = -400; }
                            default {};
                        };
                        switch (e10 >= 0)
                        {
                            case (true) {
                            k = e10;
                            while (k >= 9)
                            {
                                this.bg_mul_small(a, @n, (u64)1000000000);
                                k = k - 9;
                            };
                            while (k > 0)
                            {
                                this.bg_mul_small(a, @n, (u64)10);
                                k--;
                            };
                        }
                            default {
                            k = 0 - e10;
                            bl = this.bg_bitlen(a, n);
                            sh = 66 + (k * 3322) / 1000 + 1 - bl;
                            switch (sh < 0)
                            {
                                case (true) { sh = 0; }
                                default {};
                            };
                            this.bg_shl(a, @n, sh);
                            while (k >= 9)
                            {
                                switch (this.bg_div_small(a, @n, (u64)1000000000) != (u64)0)
                                {
                                    case (true) { sticky = true; }
                                    default {};
                                };
                                k = k - 9;
                            };
                            c = 1;
                            while (k > 0)
                            {
                                c = c * 10;
                                k--;
                            };
                            switch (c > 1)
                            {
                                case (true) {
                                switch (this.bg_div_small(a, @n, (u64)c) != (u64)0)
                                {
                                    case (true) { sticky = true; }
                                    default {};
                                };
                            }
                                default {};
                            };
                        };
                        };
                        bl = this.bg_bitlen(a, n);
                        r = bl - 53;
                        switch (r < 0)
                        {
                            case (true) { r = 0; }
                            default {};
                        };
                        b = bl - 1;
                        while (b >= r)
                        {
                            mant = (mant << (u64)1) `| this.bg_bit(a, n, b);
                            b--;
                        };
                        switch (r > 0)
                        {
                            case (true) {
                            rbit = this.bg_bit(a, n, r - 1) != (u64)0;
                            switch (this.bg_low_set(a, n, r - 1))
                            {
                                case (true) { sticky = true; }
                                default {};
                            };
                            switch (rbit)
                            {
                                case (true) {
                                switch (sticky | (mant `& (u64)1) != (u64)0)
                                {
                                    case (true) { mant = mant + (u64)1; }
                                    default {};
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                        v = (double)mant;
                        eb = r - sh;
                        while (eb > 0)
                        {
                            v = v * 2.0;
                            eb--;
                        };
                        while (eb < 0)
                        {
                            v = v * 0.5;
                            eb++;
                        };
                        ffree((void*)a);
                        -> v;
                    };
                };
            };




            tp_unqual(byte* s) -> byte*
            {
                int i;
                int n = pp_cstrlen(s);
                this.sb.len = 0;
                this.sb.mem[0] = (byte)0;
                while (i < n)
                {
                    switch (s[i] == ':' & i + 1 < n)
                    {
                        case (true) {
                        switch (s[i + 1] == ':')
                        {
                            case (true) {
                            this.sb.put_str(g"__\0");
                            i = i + 2;
                            continue;
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    this.sb.put(s[i]);
                    i++;
                };
                -> this.own_n(this.sb.mem, this.sb.len);
            };


            tmpl_type_key(byte* name) -> byte*
            {
                TemplateEntry* e = this.template_lookup(name);
                byte* q;
                switch (e != (TemplateEntry*)0)
                {
                    case (true) {
                    switch (e.kind == 1 | e.kind == 2)
                    {
                        case (true) { -> name; }
                        default {};
                    };
                }
                    default {};
                };
                switch (nm_has(this.tobj_fwd, name))
                {
                    case (true) { -> name; }
                    default
                    {
                        q = this.tp_unqual(name);
                        e = this.template_lookup(q);
                        switch (e != (TemplateEntry*)0)
                        {
                            case (true) {
                            switch (e.kind == 1 | e.kind == 2)
                            {
                                case (true) { -> q; }
                                default {};
                            };
                        }
                            default {};
                        };
                        switch (nm_has(this.tobj_fwd, q))
                        {
                            case (true) { -> q; }
                            default
                            {
                                -> (byte*)0;
                            };
                        };
                    };
                };
            };



            template_type_use(TypeSpec* t, byte* key) -> void
            {
                PtrVec* names = pv_new();
                PtrVec* specs = pv_new();
                TypeSpec* a;
                bool postpone = false;
                int i;
                this.advance();
                a = this.type_spec();
                pv_push(specs, (void*)a);
                switch (!this.failed)
                {
                    case (true) { pv_push(names, (void*)this.type_mangle_str(a)); }
                    default {};
                };
                while (!this.failed & this.expect(TokenType.COMMA))
                {
                    this.advance();
                    a = this.type_spec();
                    pv_push(specs, (void*)a);
                    switch (!this.failed)
                    {
                        case (true) { pv_push(names, (void*)this.type_mangle_str(a)); }
                        default {};
                    };
                };
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.GREATER_THAN); }
                    default {};
                };
                switch (!this.failed)
                {
                    case (true) {
                    while (i < names.len)
                    {
                        switch (this.tp_mentions((byte*)names.items[i]))
                        {
                            case (true) { postpone = true; }
                            default {};
                        };
                        i++;
                    };
                    switch (postpone)
                    {
                        case (true) {
                        t.custom_typename = this.deferred_name(key, names);
                    }
                        default {
                        t.custom_typename = this.resolve_template_type(key, names, specs);
                    };
                    };
                }
                    default {};
                };
                i = 0;
                while (i < specs.len)
                {
                    typespec_free((TypeSpec*)specs.items[i]);
                    i++;
                };
                pv_free(names);
                -> pv_free(specs);
            };



            resolve_template_type(byte* key, PtrVec* names, PtrVec* specs) -> byte*
            {
                TemplateEntry* te = this.template_lookup(key);
                NameMap* map;
                Node* concrete;
                byte* mangled;
                byte* what;
                int i;
                switch (te == (TemplateEntry*)0)
                {
                    case (true) { what = g"struct\0"; }
                    default {
                        switch (te.kind == 1)
                        {
                            case (true) { what = g"struct\0"; }
                            default { what = g"object\0"; };
                        };
                    };
                };
                switch (te == (TemplateEntry*)0)
                {
                    case (true) {
                    this.error(this.cat2(this.cat2(g"Unknown template struct '\0", key), g"'\0"));
                    -> key;
                }
                    default
                    {
                        switch (te.kind != 1 & te.kind != 2)
                        {
                            case (true) {
                            this.error(this.cat2(this.cat2(g"Unknown template struct '\0", key), g"'\0"));
                            -> key;
                        }
                            default
                            {
                                switch (names.len != te.params.len)
                                {
                                    case (true) {
                                    this.sb.len = 0;
                                    this.sb.put_str(f"Template {what} '{key}' expects {te.params.len} type argument(s), got {names.len}\0");
                                    this.error(this.own_n(this.sb.mem, this.sb.len));
                                    -> key;
                                }
                                    default
                                    {
                                        this.reject_object_args(key, names, specs);
                                        this.sb.len = 0;
                                        this.sb.mem[0] = (byte)0;
                                        this.sb.put_str(f"{key}__\0");
                                        while (i < names.len)
                                        {
                                            switch (i > 0)
                                            {
                                                case (true) { this.sb.put_str(g"_\0"); }
                                                default {};
                                            };
                                            this.sb.put_str((byte*)names.items[i]);
                                            i++;
                                        };
                                        mangled = this.own_n(this.sb.mem, this.sb.len);
                                        switch (nm_has(te.emitted, mangled))
                                        {
                                            case (true) { -> mangled; }
                                            default
                                            {
                                                nm_put(te.emitted, mangled, (void*)te);
                                                map = this.tp_mapping(te, names, specs);
                                                concrete = node_clone(te.node);
                                                this.subst_node(concrete, map);
                                                nm_free(map);
                                                switch (this.failed)
                                                {
                                                    case (true) {
                                                    node_free(concrete);
                                                    -> mangled;
                                                }
                                                    default
                                                    {
                                                        concrete.text = mangled;
                                                        switch (te.kind)
                                                        {
                                                            case (1)
                                                            {
                                                                switch (concrete.l4 != (NodeVec*)0)
                                                                {
                                                                    case (true) { concrete.l4.len = 0; }
                                                                    default {};
                                                                };
                                                                pv_push(this.tinst_s, (void*)concrete);
                                                            }
                                                            default
                                                            {
                                                                switch (concrete.d != (Node*)0)
                                                                {
                                                                    case (true) {
                                                                    node_free(concrete.d);
                                                                    concrete.d = (Node*)0;
                                                                }
                                                                    default {};
                                                                };
                                                                pv_push(this.tinst_o, (void*)concrete);
                                                                nm_put(this.pobjs, mangled, (void*)concrete);
                                                                switch (nm_has(this.oinit, key))
                                                                {
                                                                    case (true) { nm_put(this.oinit, mangled, (void*)concrete); }
                                                                    default {};
                                                                };
                                                            };
                                                        };
                                                        -> mangled;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };




            deferred_uses(byte* s, NameMap* map) -> bool
            {
                PtrVec* raw;
                int lt, i;
                bool r = false;
                switch (nm_has(map, s)) { case (true) { -> true; } default
                    {
                        raw = pv_new();
                        lt = this.tp_split_deferred(s, raw);
                        while (lt > 0 & i < raw.len & !r)
                        {
                            r = this.deferred_uses((byte*)raw.items[i], map);
                            i++;
                        };
                        pv_free(raw);
                        -> r;
                    }; };
            };

            subst_deferred_type(byte* s, NameMap* map) -> byte*
            {
                PtrVec* raw = pv_new();
                PtrVec* names = pv_new();
                PtrVec* specs = pv_new();
                int lt = this.tp_split_deferred(s, raw);
                int i;
                bool any = false;
                byte* base;
                byte* r = s;
                TemplateEntry* te;
                TypeSpec* c;
                byte* a;
                switch (lt > 0)
                {
                    case (true) {
                    base = this.own_n(s, lt);
                    te = this.template_lookup(base);
                    while (i < raw.len)
                    {
                        switch (this.deferred_uses((byte*)raw.items[i], map))
                        {
                            case (true) { any = true; }
                            default {};
                        };
                        i++;
                    };
                    switch (te != (TemplateEntry*)0 & any)
                    {
                        case (true) {
                        switch (te.kind == 1 | te.kind == 2)
                        {
                            case (true) {
                            i = 0;
                            while (i < raw.len)
                            {
                                a = (byte*)raw.items[i];
                                switch (nm_has(map, a))
                                {
                                    case (true) {
                                    c = (TypeSpec*)nm_get(map, a);
                                    pv_push(names, (void*)this.ts_mangle(c));
                                    pv_push(specs, (void*)c);
                                }
                                    default {
                                    c = this.tmp_type();
                                    c.base_type = DataType.DATA;
                                    a = this.subst_deferred_type(a, map);
                                    c.custom_typename = a;
                                    pv_push(names, (void*)a);
                                    pv_push(specs, (void*)c);
                                };
                                };
                                i++;
                            };
                            r = this.resolve_template_type(base, names, specs);
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                }
                    default {};
                };
                pv_free(raw);
                pv_free(names);
                pv_free(specs);
                -> r;
            };

            type_mangle_str(TypeSpec* t) -> byte*
            {
                this.sb.len = 0;
                this.sb.mem[0] = (byte)0;
                switch (t.custom_typename != (byte*)0)
                {
                    case (true) { -> t.custom_typename; }
                    default
                    {
                        switch ((t.flags `& 64) != 0)
                        {
                            case (true) { this.sb.put_str(g"ptr_\0"); }
                            default {};
                        };
                        switch (t.base_type == DataType.DATA & t.bit_width > 0)
                        {
                            case (true) {
                            this.sb.put_str(g"data_\0");
                            switch ((t.flags `& 64) == 0 & (t.flags `& 1) != 0)
                            {
                                case (true) { this.sb.put_str(g"i\0"); }
                                default { this.sb.put_str(g"u\0"); };
                            };
                            this.sb.put_int(t.bit_width);
                        }
                            default {
                            this.sb.put_str(datatype_text(t.base_type));
                        };
                        };
                        -> this.own_n(this.sb.mem, this.sb.len);
                    };
                };
            };




            is_type_keyword() -> bool -> this.expect4(TokenType.SINT, TokenType.UINT, TokenType.FLOAT_KW, TokenType.DOUBLE_KW) | this.expect4(TokenType.SLONG, TokenType.ULONG, TokenType.CHAR, TokenType.BOOL_KW) | this.expect4(TokenType.BYTE, TokenType.DATA, TokenType.VOID, TokenType.THIS) | this.expect4(TokenType.STRUCT, TokenType.OBJECT, TokenType.DICT, TokenType.IDENTIFIER);





            base_type(TypeSpec* t) -> int
            {
                int c = this.cur();
                switch (c == TokenType.SINT)
                {
                    case (true) { t.base_type = DataType.SINT; this.advance(); -> 1; }
                    default
                    {
                        switch (c == TokenType.UINT)
                        {
                            case (true) { t.base_type = DataType.UINT; this.advance(); -> 1; }
                            default
                            {
                                switch (c == TokenType.FLOAT_KW)
                                {
                                    case (true) { t.base_type = DataType.FLOAT; this.advance(); -> 1; }
                                    default
                                    {
                                        switch (c == TokenType.DOUBLE_KW)
                                        {
                                            case (true) { t.base_type = DataType.DOUBLE; this.advance(); -> 1; }
                                            default
                                            {
                                                switch (c == TokenType.SLONG)
                                                {
                                                    case (true) { t.base_type = DataType.SLONG; this.advance(); -> 1; }
                                                    default
                                                    {
                                                        switch (c == TokenType.ULONG)
                                                        {
                                                            case (true) { t.base_type = DataType.ULONG; this.advance(); -> 1; }
                                                            default
                                                            {
                                                                switch (c == TokenType.CHAR)
                                                                {
                                                                    case (true) { t.base_type = DataType.CHAR; this.advance(); -> 1; }
                                                                    default
                                                                    {
                                                                        switch (c == TokenType.BOOL_KW)
                                                                        {
                                                                            case (true) { t.base_type = DataType.BOOL; this.advance(); -> 1; }
                                                                            default
                                                                            {
                                                                                switch (c == TokenType.BYTE)
                                                                                {
                                                                                    case (true) { t.base_type = DataType.BYTE; this.advance(); -> 1; }
                                                                                    default
                                                                                    {
                                                                                        switch (c == TokenType.DATA)
                                                                                        {
                                                                                            case (true) { t.base_type = DataType.DATA; this.advance(); -> 1; }
                                                                                            default
                                                                                            {
                                                                                                switch (c == TokenType.VOID)
                                                                                                {
                                                                                                    case (true) { t.base_type = DataType.VOID; this.advance(); -> 1; }
                                                                                                    default
                                                                                                    {
                                                                                                        switch (c == TokenType.THIS)
                                                                                                        {
                                                                                                            case (true) { t.base_type = DataType.THIS; this.advance(); -> 1; }
                                                                                                            default
                                                                                                            {
                                                                                                                switch (c == TokenType.STRUCT)
                                                                                                                {
                                                                                                                    case (true) { t.base_type = DataType.STRUCT; this.advance(); -> 1; }
                                                                                                                    default
                                                                                                                    {
                                                                                                                        switch (c == TokenType.OBJECT)
                                                                                                                        {
                                                                                                                            case (true) { t.base_type = DataType.OBJECT; this.advance(); -> 1; }
                                                                                                                            default
                                                                                                                            {
                                                                                                                                switch (c == TokenType.DICT)
                                                                                                                                {
                                                                                                                                    case (true) {
                                                                                                                                    this.advance();
                                                                                                                                    t.base_type = DataType.DICT;
                                                                                                                                    switch (!this.consume(TokenType.LEFT_BRACE))
                                                                                                                                    {
                                                                                                                                        case (true) { -> 0; }
                                                                                                                                        default {};
                                                                                                                                    };
                                                                                                                                    t.dict_key = this.type_spec();
                                                                                                                                    switch (this.failed)
                                                                                                                                    {
                                                                                                                                        case (true) { -> 0; }
                                                                                                                                        default {};
                                                                                                                                    };
                                                                                                                                    switch (!this.consume(TokenType.COLON))
                                                                                                                                    {
                                                                                                                                        case (true) { -> 0; }
                                                                                                                                        default {};
                                                                                                                                    };
                                                                                                                                    t.dict_value = this.type_spec();
                                                                                                                                    switch (this.failed)
                                                                                                                                    {
                                                                                                                                        case (true) { -> 0; }
                                                                                                                                        default {};
                                                                                                                                    };
                                                                                                                                    switch (!this.consume(TokenType.RIGHT_BRACE))
                                                                                                                                    {
                                                                                                                                        case (true) { -> 0; }
                                                                                                                                        default {};
                                                                                                                                    };
                                                                                                                                    -> 3;
                                                                                                                                }
                                                                                                                                    default
                                                                                                                                    {
                                                                                                                                        switch (c == TokenType.STRING_LITERAL & this.cur_value_len() == 0)
                                                                                                                                        {
                                                                                                                                            case (true) {
                                                                                                                                            this.advance();
                                                                                                                                            t.base_type = DataType.BYTE;
                                                                                                                                            -> 4;
                                                                                                                                        }
                                                                                                                                            default
                                                                                                                                            {
                                                                                                                                                switch (c == TokenType.IDENTIFIER)
                                                                                                                                                {
                                                                                                                                                    case (true) {
                                                                                                                                                    byte* name = this.cur_value();
                                                                                                                                                    this.advance();
                                                                                                                                                    while (this.expect(TokenType.SCOPE))
                                                                                                                                                    {
                                                                                                                                                        this.advance();
                                                                                                                                                        switch (this.expect(TokenType.IDENTIFIER))
                                                                                                                                                        {
                                                                                                                                                            case (true) {
                                                                                                                                                            name = this.cat2(this.cat2(name, g"::\0"), this.cur_value());
                                                                                                                                                            this.advance();
                                                                                                                                                        }
                                                                                                                                                            default { break; };
                                                                                                                                                        };
                                                                                                                                                    };
                                                                                                                                                    t.base_type = DataType.DATA;
                                                                                                                                                    t.custom_typename = name;
                                                                                                                                                    -> 2;
                                                                                                                                                }
                                                                                                                                                    default
                                                                                                                                                    {
                                                                                                                                                        switch (c == TokenType.CODIFY)
                                                                                                                                                        {
                                                                                                                                                            case (true) {

                                                                                                                                                            byte* resolved = this.consume_codify();
                                                                                                                                                            switch (this.failed)
                                                                                                                                                            {
                                                                                                                                                                case (true) { -> 0; }
                                                                                                                                                                default {};
                                                                                                                                                            };
                                                                                                                                                            int bt = this.codify_builtin(resolved);
                                                                                                                                                            switch (bt >= 0)
                                                                                                                                                            {
                                                                                                                                                                case (true) {
                                                                                                                                                                t.base_type = bt;
                                                                                                                                                                -> 1;
                                                                                                                                                            }
                                                                                                                                                                default {};
                                                                                                                                                            };
                                                                                                                                                            t.base_type = DataType.DATA;
                                                                                                                                                            t.custom_typename = resolved;
                                                                                                                                                            -> 2;
                                                                                                                                                        }
                                                                                                                                                            default
                                                                                                                                                            {
                                                                                                                                                                this.error_exp(g"Expected type specifier\0", TokenType.IDENTIFIER);
                                                                                                                                                                -> 0;
                                                                                                                                                            };
                                                                                                                                                        };
                                                                                                                                                    };
                                                                                                                                                };
                                                                                                                                            };
                                                                                                                                        };
                                                                                                                                    };
                                                                                                                                };
                                                                                                                            };
                                                                                                                        };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            codify_builtin(byte* s) -> int
            {
                switch (cstr_eq(s, g"byte\0"))
                {
                    case (true) { -> DataType.BYTE; }
                    default
                    {
                        switch (cstr_eq(s, g"int\0"))
                        {
                            case (true) { -> DataType.SINT; }
                            default
                            {
                                switch (cstr_eq(s, g"uint\0"))
                                {
                                    case (true) { -> DataType.UINT; }
                                    default
                                    {
                                        switch (cstr_eq(s, g"long\0"))
                                        {
                                            case (true) { -> DataType.SLONG; }
                                            default
                                            {
                                                switch (cstr_eq(s, g"ulong\0"))
                                                {
                                                    case (true) { -> DataType.ULONG; }
                                                    default
                                                    {
                                                        switch (cstr_eq(s, g"float\0"))
                                                        {
                                                            case (true) { -> DataType.FLOAT; }
                                                            default
                                                            {
                                                                switch (cstr_eq(s, g"double\0"))
                                                                {
                                                                    case (true) { -> DataType.DOUBLE; }
                                                                    default
                                                                    {
                                                                        switch (cstr_eq(s, g"bool\0"))
                                                                        {
                                                                            case (true) { -> DataType.BOOL; }
                                                                            default
                                                                            {
                                                                                switch (cstr_eq(s, g"char\0"))
                                                                                {
                                                                                    case (true) { -> DataType.CHAR; }
                                                                                    default
                                                                                    {
                                                                                        switch (cstr_eq(s, g"void\0"))
                                                                                        {
                                                                                            case (true) { -> DataType.VOID; }
                                                                                            default
                                                                                            {
                                                                                                -> -1;
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            copy_scalar_type(TypeSpec* d, TypeSpec* s) -> void
            {
                d.base_type = s.base_type;
                d.flags = s.flags `& (1 `| 2 `| 4 `| 8 `| 16 `|
                                      64 `| 128 `| 256);
                d.bit_width = s.bit_width;
                d.alignment = s.alignment;
                d.endianness = s.endianness;
                d.pointer_depth = s.pointer_depth;
                d.storage_class = s.storage_class;
                d.custom_typename = s.custom_typename;
                ->;
            };




            type_spec() -> TypeSpec*
            {
                TypeSpec* t = typespec_new();
                switch (t == (TypeSpec*)0)
                {
                    case (true) {
                    this.fail_alloc();
                    -> t;
                }
                    default
                    {
                        int sc = -1;
                        bool singinit_seen = false;
                        bool sign_explicit = false;
                        bool is_signed = false;

                        switch (this.expect(TokenType.SINGINIT))
                        {
                            case (true) {
                            singinit_seen = true;
                            sc = StorageClass.SINGINIT;
                            this.advance();
                        }
                            default {};
                        };
                        switch (this.expect(TokenType.GLOBAL))
                        {
                            case (true) { sc = StorageClass.GLOBAL; this.advance(); }
                            default {
                                switch (this.expect(TokenType.LOCAL))
                                {
                                    case (true) {
                            t.flags = t.flags `| 16;
                            sc = StorageClass.LOCAL;
                            this.advance();
                        }
                                    default {
                                        switch (this.expect(TokenType.HEAP))
                                        {
                                            case (true) { sc = StorageClass.HEAP; this.advance(); }
                                            default {
                                                switch (this.expect(TokenType.STACK))
                                                {
                                                    case (true) { sc = StorageClass.STACK; this.advance(); }
                                                    default {
                                                        switch (this.expect(TokenType.REGISTER))
                                                        {
                                                            case (true) { sc = StorageClass.REGISTER; this.advance(); }
                                                            default {};
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };

                        switch (!singinit_seen & this.expect(TokenType.SINGINIT))
                        {
                            case (true) {
                            singinit_seen = true;
                            this.advance();
                        }
                            default {};
                        };
                        switch (this.expect(TokenType.CONST))
                        {
                            case (true) { t.flags = t.flags `| 2; this.advance(); }
                            default {};
                        };
                        switch (this.expect(TokenType.VOLATILE))
                        {
                            case (true) { t.flags = t.flags `| 4; this.advance(); }
                            default {};
                        };
                        switch (this.expect(TokenType.SIGNED))
                        {
                            case (true) {
                            is_signed = true;
                            sign_explicit = true;
                            this.advance();
                        }
                            default {
                                switch (this.expect(TokenType.UNSIGNED))
                                {
                                    case (true) {
                            sign_explicit = true;
                            this.advance();
                        }
                                    default {};
                                };
                            };
                        };
                        switch (this.expect(TokenType.TIE))
                        {
                            case (true) { t.flags = t.flags `| 8; this.advance(); }
                            default {};
                        };
                        switch (is_signed)
                        {
                            case (true) { t.flags = t.flags `| 1; }
                            default {};
                        };
                        t.storage_class = sc;

                        int kind = this.base_type(t);
                        switch (kind == 0)
                        {
                            case (true) { -> t; }
                            default
                            {
                                int depth = 0;
                                switch (kind == 3)
                                {
                                    case (true) {
                                    while (this.expect(TokenType.MULTIPLY))
                                    {
                                        depth++;
                                        this.advance();
                                    };
                                    t.flags = t.flags `& (2 `| 4);
                                    switch (depth > 0)
                                    {
                                        case (true) { t.flags = t.flags `| 64; }
                                        default {};
                                    };
                                    t.pointer_depth = depth;
                                    -> t;
                                }
                                    default
                                    {
                                        switch (kind == 4)
                                        {
                                            case (true) {
                                            t.flags = (t.flags `& (2 `| 4)) `| 64;
                                            t.pointer_depth = 1;
                                            -> t;
                                        }
                                            default
                                            {


                                                byte* tkey = (byte*)0;
                                                switch (kind == 2 & this.expect(TokenType.LESS_THAN))
                                                {
                                                    case (true) { tkey = this.tmpl_type_key(t.custom_typename); }
                                                    default {};
                                                };
                                                switch (tkey != (byte*)0)
                                                {
                                                    case (true) {
                                                    this.template_type_use(t, tkey);
                                                    switch (this.failed)
                                                    {
                                                        case (true) { -> t; }
                                                        default {};
                                                    };
                                                }
                                                    default {
                                                        switch (kind == 2 & this.expect(TokenType.LESS_THAN))
                                                        {
                                                            case (true) {
                                                    int m = this.mark();
                                                    this.advance();
                                                    PtrVec* names = pv_new();
                                                    TypeSpec* a = this.type_spec();
                                                    bool good = !this.failed;
                                                    switch (good)
                                                    {
                                                        case (true) {
                                                        pv_push(names, (void*)this.type_mangle_str(a));
                                                        typespec_free(a);
                                                        while (this.expect(TokenType.COMMA) & good)
                                                        {
                                                            this.advance();
                                                            a = this.type_spec();
                                                            switch (this.failed)
                                                            {
                                                                case (true) { good = false; }
                                                                default {
                                                                pv_push(names, (void*)this.type_mangle_str(a));
                                                                typespec_free(a);
                                                            };
                                                            };
                                                        };
                                                        switch (good & !this.expect(TokenType.GREATER_THAN))
                                                        {
                                                            case (true) { good = false; }
                                                            default {};
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                    switch (good)
                                                    {
                                                        case (true) {
                                                        this.advance();
                                                        this.sb.len = 0;
                                                        this.sb.mem[0] = (byte)0;
                                                        this.sb.put_str(f"{t.custom_typename}<\0");
                                                        int i;
                                                        while (i < names.len)
                                                        {
                                                            switch (i > 0)
                                                            {
                                                                case (true) { this.sb.put_str(g",\0"); }
                                                                default {};
                                                            };
                                                            this.sb.put_str((byte*)names.items[i]);
                                                            i++;
                                                        };
                                                        this.sb.put_str(g">\0");
                                                        t.custom_typename = this.own_n(this.sb.mem, this.sb.len);
                                                    }
                                                        default {
                                                        this.clear_error();
                                                        this.reset(m);
                                                    };
                                                    };
                                                    pv_free(names);
                                                }
                                                            default {};
                                                        };
                                                    };
                                                };


                                                bool nofunc = false;
                                                switch (t.base_type == DataType.DATA & t.custom_typename == (byte*)0)
                                                {
                                                    case (true) {
                                                    switch (this.expect(TokenType.NOT))
                                                    {
                                                        case (true) {
                                                        nofunc = true;
                                                        this.advance();
                                                    }
                                                        default {};
                                                    };
                                                    switch (this.expect(TokenType.LEFT_BRACE))
                                                    {
                                                        case (true) {
                                                        this.advance();
                                                        bool ok;
                                                        switch (!this.expect(TokenType.SINT_LITERAL))
                                                        {
                                                            case (true) {
                                                            this.fail_expected(TokenType.SINT_LITERAL);
                                                            -> t;
                                                        }
                                                            default
                                                            {
                                                                t.bit_width = (int)this.parse_int(this.cur_value(), @ok);
                                                                this.advance();
                                                                switch (this.expect(TokenType.COLON))
                                                                {
                                                                    case (true) {
                                                                    this.advance();
                                                                    switch (!this.expect(TokenType.SINT_LITERAL))
                                                                    {
                                                                        case (true) {
                                                                        this.fail_expected(TokenType.SINT_LITERAL);
                                                                        -> t;
                                                                    }
                                                                        default
                                                                        {
                                                                            t.alignment = (int)this.parse_int(this.cur_value(), @ok);
                                                                            this.advance();
                                                                            switch (this.expect(TokenType.COLON))
                                                                            {
                                                                                case (true) {
                                                                                this.advance();
                                                                                switch (!this.expect(TokenType.SINT_LITERAL))
                                                                                {
                                                                                    case (true) {
                                                                                    this.fail_expected(TokenType.SINT_LITERAL);
                                                                                    -> t;
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        t.endianness = (int)this.parse_int(this.cur_value(), @ok);
                                                                                        this.advance();
                                                                                    };
                                                                                };
                                                                            }
                                                                                default {};
                                                                            };
                                                                        };
                                                                    };
                                                                }
                                                                    default {
                                                                        switch (this.expect(TokenType.SCOPE))
                                                                        {
                                                                            case (true) {
                                                                    this.advance();
                                                                    t.alignment = t.bit_width;
                                                                    switch (!this.expect(TokenType.SINT_LITERAL))
                                                                    {
                                                                        case (true) {
                                                                        this.fail_expected(TokenType.SINT_LITERAL);
                                                                        -> t;
                                                                    }
                                                                        default
                                                                        {
                                                                            t.endianness = (int)this.parse_int(this.cur_value(), @ok);
                                                                            this.advance();
                                                                        };
                                                                    };
                                                                }
                                                                            default {};
                                                                        };
                                                                    };
                                                                };
                                                                switch (!this.consume(TokenType.RIGHT_BRACE))
                                                                {
                                                                    case (true) { -> t; }
                                                                    default {};
                                                                };
                                                            };
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };

                                                int pdepth = 0;
                                                while (this.expect(TokenType.MULTIPLY))
                                                {
                                                    pdepth++;
                                                    this.advance();
                                                };

                                                NodeVec* dims = (NodeVec*)0;
                                                Node* dim;
                                                while (this.expect(TokenType.LEFT_BRACKET))
                                                {
                                                    this.advance();
                                                    switch (dims == (NodeVec*)0)
                                                    {
                                                        case (true) { dims = nv_new(); }
                                                        default {};
                                                    };
                                                    switch (!this.expect(TokenType.RIGHT_BRACKET))
                                                    {
                                                        case (true) {
                                                        dim = this.expression();
                                                        switch (this.failed)
                                                        {
                                                            case (true) { -> t; }
                                                            default
                                                            {
                                                                nv_push(dims, dim);
                                                            };
                                                        };
                                                    }
                                                        default { nv_push(dims, (Node*)0); };
                                                    };
                                                    switch (!this.consume(TokenType.RIGHT_BRACKET))
                                                    {
                                                        case (true) { -> t; }
                                                        default {};
                                                    };
                                                };
                                                while (this.expect(TokenType.MULTIPLY))
                                                {
                                                    pdepth++;
                                                    this.advance();
                                                };
                                                bool is_array = dims != (NodeVec*)0;


                                                switch (t.custom_typename != (byte*)0 & this.st != (IDKC_SYMTABLE*)0)
                                                {
                                                    case (true) {
                                                    TypeSpec* rs = st_get_type_spec(this.st, t.custom_typename);
                                                    switch (rs != (TypeSpec*)0)
                                                    {
                                                        case (true) {
                                                        switch (rs.base_type != DataType.DICT & rs.base_type != DataType.FUNC_PTR)
                                                        {
                                                            case (true) {
                                                            bool alias_arr = (rs.flags `& 32) != 0;
                                                            int keep_sc = t.storage_class;
                                                            int keep_flags = t.flags;
                                                            this.copy_scalar_type(t, rs);
                                                            t.flags = t.flags `| (keep_flags `& (8 `| 2 `| 4));
                                                            switch (keep_sc != -1)
                                                            {
                                                                case (true) {
                                                                t.storage_class = keep_sc;
                                                                switch (keep_sc == StorageClass.LOCAL)
                                                                {
                                                                    case (true) { t.flags = t.flags `| 16; }
                                                                    default {
                                                                        switch ((t.flags `& 16) != 0)
                                                                        {
                                                                            case (true) { t.flags = t.flags - 16; }
                                                                            default {};
                                                                        };
                                                                    };
                                                                };
                                                            }
                                                                default {};
                                                            };
                                                            switch (sign_explicit)
                                                            {
                                                                case (true) {
                                                                switch (is_signed)
                                                                {
                                                                    case (true) { t.flags = t.flags `| 1; }
                                                                    default {
                                                                        switch ((t.flags `& 1) != 0)
                                                                        {
                                                                            case (true) { t.flags = t.flags - 1; }
                                                                            default {};
                                                                        };
                                                                    };
                                                                };
                                                            }
                                                                default {};
                                                            };
                                                            switch (alias_arr)
                                                            {
                                                                case (true) {

                                                                NodeVec* nd = nv_new();
                                                                int di;
                                                                switch (is_array)
                                                                {
                                                                    case (true) {
                                                                    while (di < dims.len)
                                                                    {
                                                                        nv_push(nd, dims.items[di]);
                                                                        di++;
                                                                    };
                                                                    dims.len = 0;
                                                                    nv_free(dims);
                                                                }
                                                                    default {};
                                                                };
                                                                switch (rs.array_dims != (NodeVec*)0)
                                                                {
                                                                    case (true) {
                                                                    di = 0;
                                                                    while (di < rs.array_dims.len)
                                                                    {
                                                                        nv_push(nd, node_clone(rs.array_dims.items[di]));
                                                                        di++;
                                                                    };
                                                                }
                                                                    default {};
                                                                };
                                                                t.flags = t.flags `| 32;
                                                                t.array_dims = nd;
                                                                switch (nd.len > 0)
                                                                {
                                                                    case (true) { t.array_size = nd.items[0]; }
                                                                    default {};
                                                                };
                                                                switch (rs.array_elem != (TypeSpec*)0)
                                                                {
                                                                    case (true) { t.array_elem = typespec_copy(rs.array_elem); }
                                                                    default {
                                                                    TypeSpec* ael = typespec_new();
                                                                    this.copy_scalar_type(ael, t);
                                                                    ael.flags = ael.flags `& (1 `| 2 `| 4);
                                                                    ael.pointer_depth = 0;
                                                                    t.array_elem = ael;
                                                                };
                                                                };
                                                            }
                                                                default {
                                                                    switch (is_array)
                                                                    {
                                                                        case (true) {
                                                                t.flags = t.flags `| 32;
                                                                t.array_dims = dims;
                                                                t.array_size = dims.items[0];
                                                                TypeSpec* el = typespec_new();
                                                                this.copy_scalar_type(el, t);
                                                                el.flags = el.flags `& (1 `| 2 `| 4);
                                                                el.pointer_depth = 0;
                                                                t.array_elem = el;
                                                            }
                                                                        default {};
                                                                    };
                                                                };
                                                            };
                                                            switch (pdepth > 0)
                                                            {
                                                                case (true) {
                                                                t.flags = t.flags `| 64;
                                                                t.pointer_depth = t.pointer_depth + pdepth;
                                                            }
                                                                default {};
                                                            };
                                                            -> t;
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };

                                                switch (t.base_type == DataType.BYTE & t.bit_width < 0)
                                                {
                                                    case (true) {
                                                    t.bit_width = this.default_byte_width;
                                                    switch (t.alignment < 0)
                                                    {
                                                        case (true) { t.alignment = t.bit_width; }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (nofunc)
                                                {
                                                    case (true) { t.flags = t.flags `| 256; }
                                                    default {};
                                                };
                                                switch (is_array)
                                                {
                                                    case (true) {
                                                    t.flags = t.flags `| 32;
                                                    t.array_dims = dims;
                                                    t.array_size = dims.items[0];
                                                    TypeSpec* e = typespec_new();
                                                    e.base_type = t.base_type;
                                                    e.flags = t.flags `& (1 `| 2 `| 4);
                                                    e.bit_width = t.bit_width;
                                                    e.alignment = t.alignment;
                                                    e.endianness = t.endianness;
                                                    e.storage_class = t.storage_class;
                                                    e.custom_typename = t.custom_typename;
                                                    t.array_elem = e;
                                                }
                                                    default {};
                                                };
                                                switch (pdepth > 0)
                                                {
                                                    case (true) {
                                                    t.flags = t.flags `| 64;
                                                    t.pointer_depth = pdepth;
                                                }
                                                    default {};
                                                };
                                                -> t;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };




            starts_operand() -> bool -> this.expect4(TokenType.IDENTIFIER, TokenType.SINT_LITERAL, TokenType.UINT_LITERAL, TokenType.SLONG_LITERAL) | this.expect4(TokenType.ULONG_LITERAL, TokenType.FLOAT, TokenType.DOUBLE, TokenType.CHAR) | this.expect4(TokenType.STRING_LITERAL, TokenType.F_STRING, TokenType.G_STRING, TokenType.I_STRING) | this.expect4(TokenType.TRUE, TokenType.FALSE, TokenType.VOID, TokenType.THIS) | this.expect4(TokenType.NO_INIT, TokenType.LEFT_PAREN, TokenType.LEFT_BRACKET, TokenType.ELLIPSIS);

            error_missing_operator() -> void -> this.error(this.cat2(this.cat2(g"Unexpected '\0", this.cur_value()), g"' in expression - missing operator before this token?\0"));


            expression() -> Node* -> this.assignment_expression();

            is_compound_assign() -> bool -> this.expect4(TokenType.PLUS_ASSIGN, TokenType.MINUS_ASSIGN, TokenType.MULTIPLY_ASSIGN, TokenType.DIVIDE_ASSIGN) | this.expect4(TokenType.MODULO_ASSIGN, TokenType.EXPONENT_ASSIGN, TokenType.XOR_ASSIGN, TokenType.BITXOR_ASSIGN) | this.expect4(TokenType.BITXNOR_ASSIGN, TokenType.BITSHIFT_LEFT_ASSIGN, TokenType.BITSHIFT_RIGHT_ASSIGN, TokenType.BITAND_ASSIGN) | this.expect4(TokenType.BITOR_ASSIGN, TokenType.BITNAND_ASSIGN, TokenType.BITNOR_ASSIGN, TokenType.OR_ASSIGN) | this.expect(TokenType.AND_ASSIGN);


            assignment_expression() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* expr = this.ternary_expression();
                switch (this.failed)
                {
                    case (true) { -> expr; }
                    default
                    {
                        Node* n;
                        Node* value;
                        switch (this.expect(TokenType.ASSIGN))
                        {
                            case (true) {
                            this.advance();
                            switch (this.expect(TokenType.DITTO))
                            {
                                case (true) {
                                this.advance();
                                Node* prev = this.last_stmt;
                                switch (prev == (Node*)0)
                                {
                                    case (true) {
                                    this.error(g"Ditto in assignment: no preceding statement to repeat\0");
                                    -> expr;
                                }
                                    default {};
                                };
                                Node* inner = prev;
                                switch (prev.kind == NodeKind.EXPRESSION_STATEMENT)
                                {
                                    case (true) { inner = prev.a; }
                                    default {};
                                };
                                switch (inner == (Node*)0)
                                {
                                    case (true) {
                                    this.error(g"Ditto in assignment: preceding statement is not an assignment\0");
                                    -> expr;
                                }
                                    default {};
                                };
                                switch (inner.kind != NodeKind.ASSIGNMENT)
                                {
                                    case (true) {
                                    this.error(g"Ditto in assignment: preceding statement is not an assignment\0");
                                    -> expr;
                                }
                                    default {};
                                };
                                value = node_clone(inner.b);
                            }
                                default {
                                value = this.assignment_expression();
                                switch (this.failed)
                                {
                                    case (true) { -> expr; }
                                    default {};
                                };
                            };
                            };
                            n = this.mk(NodeKind.ASSIGNMENT, line, col);
                            switch (this.failed)
                            {
                                case (true) { -> expr; }
                                default {};
                            };
                            n.a = expr;
                            n.b = value;
                            -> n;
                        }
                            default
                            {
                                switch (this.is_compound_assign())
                                {
                                    case (true) {
                                    int optok = this.cur();
                                    this.advance();
                                    value = this.assignment_expression();
                                    switch (this.failed)
                                    {
                                        case (true) { -> expr; }
                                        default {};
                                    };
                                    n = this.mk(NodeKind.COMPOUND_ASSIGNMENT, line, col);
                                    switch (this.failed)
                                    {
                                        case (true) { -> expr; }
                                        default {};
                                    };
                                    n.op = optok;
                                    n.a = expr;
                                    n.b = value;
                                    -> n;
                                }
                                    default
                                    {
                                        switch (this.expect(TokenType.ADDRESS_ASSIGN))
                                        {
                                            case (true) {
                                            int al = this.cur_line();
                                            int ac = this.cur_col();
                                            this.advance();
                                            Node* rhs = this.assignment_expression();
                                            switch (this.failed)
                                            {
                                                case (true) { -> expr; }
                                                default {};
                                            };
                                            Node* addr = this.mk(NodeKind.ADDRESS_OF, al, ac);
                                            switch (this.failed)
                                            {
                                                case (true) { -> expr; }
                                                default {};
                                            };
                                            addr.a = rhs;
                                            n = this.mk(NodeKind.ASSIGNMENT, line, col);
                                            switch (this.failed)
                                            {
                                                case (true) { -> expr; }
                                                default {};
                                            };
                                            n.a = expr;
                                            n.b = addr;
                                            -> n;
                                        }
                                            default
                                            {
                                                switch (this.expect(TokenType.TERNARY_ASSIGN))
                                                {
                                                    case (true) {
                                                    this.advance();
                                                    value = this.assignment_expression();
                                                    switch (this.failed)
                                                    {
                                                        case (true) { -> expr; }
                                                        default {};
                                                    };
                                                    n = this.mk(NodeKind.TERNARY_ASSIGN, line, col);
                                                    switch (this.failed)
                                                    {
                                                        case (true) { -> expr; }
                                                        default {};
                                                    };
                                                    n.a = expr;
                                                    n.b = value;
                                                    -> n;
                                                }
                                                    default
                                                    {
                                                        -> expr;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            ternary_expression() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* expr = this.null_coalesce_expression();
                switch (this.failed)
                {
                    case (true) { -> expr; }
                    default
                    {
                        switch (this.expect(TokenType.QUESTION))
                        {
                            case (true) {
                            this.advance();
                            Node* t = this.expression();
                            switch (this.failed)
                            {
                                case (true) { -> expr; }
                                default {};
                            };
                            switch (!this.consume_msg(TokenType.COLON, g"Expected ':' in ternary expression\0")) { case (true) { -> expr; } default {}; }; Node* f = this.ternary_expression();
                            switch (this.failed)
                            {
                                case (true) { -> expr; }
                                default {};
                            };
                            Node* n = this.mk(NodeKind.TERNARY_OP, line, col);
                            switch (this.failed)
                            {
                                case (true) { -> expr; }
                                default {};
                            };
                            n.a = expr;
                            n.b = t;
                            n.c = f;
                            -> n;
                        }
                            default
                            {
                                -> expr;
                            };
                        };
                    };
                };
            };


            null_coalesce_expression() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* expr = this.bin_level(0);
                switch (this.failed)
                {
                    case (true) { -> expr; }
                    default
                    {
                        switch (this.expect(TokenType.NULL_COALESCE))
                        {
                            case (true) {
                            this.advance();
                            Node* r = this.null_coalesce_expression();
                            switch (this.failed)
                            {
                                case (true) { -> expr; }
                                default {};
                            };
                            Node* n = this.mk(NodeKind.NULL_COALESCE, line, col);
                            switch (this.failed)
                            {
                                case (true) { -> expr; }
                                default {};
                            };
                            n.a = expr;
                            n.b = r;
                            -> n;
                        }
                            default
                            {
                                -> expr;
                            };
                        };
                    };
                };
            };




            bin_match(int lv) -> int
            {
                int c = this.cur();
                switch (lv == 9 & this.cop_mask != 0)
                {
                    case (true) {
                    switch (this.cop_right_here())
                    {
                        case (true) { -> -1; }
                        default {};
                    };
                }
                    default {};
                };
                switch (lv)
                {
                    case (0) { switch (c == TokenType.LOGICAL_OR | c == TokenType.OR)
 {
     case (true) { -> Operator.OR; }
     default {};
 }; }
                    case (1) { switch (c == TokenType.LOGICAL_AND | c == TokenType.AND)
 {
     case (true) { -> Operator.AND; }
     default {};
 }; }
                    case (2) { switch (c == TokenType.XOR_OP | c == TokenType.XOR)
 {
     case (true) { -> Operator.XOR; }
     default {};
 }; }
                    case (3)
                    {
                        switch (c == TokenType.BITOR_OP)
                        {
                            case (true) { -> Operator.BITOR; }
                            default
                            {
                                switch (c == TokenType.BITNOR_OP)
                                {
                                    case (true) { -> Operator.BITNOR; }
                                    default {};
                                };
                            };
                        };
                    }
                    case (4)
                    {
                        switch (c == TokenType.BITXOR_OP)
                        {
                            case (true) { -> Operator.BITXOR; }
                            default
                            {
                                switch (c == TokenType.BITXNOR)
                                {
                                    case (true) { -> Operator.BITXNOR; }
                                    default {};
                                };
                            };
                        };
                    }
                    case (5)
                    {
                        switch (c == TokenType.BITAND_OP)
                        {
                            case (true) { -> Operator.BITAND; }
                            default
                            {
                                switch (c == TokenType.BITNAND_OP)
                                {
                                    case (true) { -> Operator.BITNAND; }
                                    default {};
                                };
                            };
                        };
                    }
                    case (6)
                    {
                        switch (c == TokenType.LESS_THAN)
                        {
                            case (true) { -> Operator.LESS_THAN; }
                            default
                            {
                                switch (c == TokenType.LESS_EQUAL)
                                {
                                    case (true) { -> Operator.LESS_EQUAL; }
                                    default
                                    {
                                        switch (c == TokenType.GREATER_THAN)
                                        {
                                            case (true) { -> Operator.GREATER_THAN; }
                                            default
                                            {
                                                switch (c == TokenType.GREATER_EQUAL)
                                                {
                                                    case (true) { -> Operator.GREATER_EQUAL; }
                                                    default {};
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    }
                    case (7)
                    {
                        switch (c == TokenType.BITSHIFT_LEFT)
                        {
                            case (true) { -> Operator.BITSHIFT_LEFT; }
                            default
                            {
                                switch (c == TokenType.BITSHIFT_RIGHT)
                                {
                                    case (true) { -> Operator.BITSHIFT_RIGHT; }
                                    default {};
                                };
                            };
                        };
                    }
                    case (8)
                    {
                        switch (c == TokenType.PLUS)
                        {
                            case (true) { -> Operator.ADD; }
                            default
                            {
                                switch (c == TokenType.MINUS)
                                {
                                    case (true) { -> Operator.SUB; }
                                    default {};
                                };
                            };
                        };
                    }
                    case (9)
                    {
                        switch (c == TokenType.MULTIPLY)
                        {
                            case (true) { -> Operator.MUL; }
                            default
                            {
                                switch (c == TokenType.DIVIDE)
                                {
                                    case (true) { -> Operator.DIV; }
                                    default
                                    {
                                        switch (c == TokenType.MODULO)
                                        {
                                            case (true) { -> Operator.MOD; }
                                            default
                                            {
                                                switch (c == TokenType.EXPONENT)
                                                {
                                                    case (true) { -> Operator.POWER; }
                                                    default {};
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    }
                    default {};
                };
                -> -1;
            };


            bin_next(int lv) -> Node*
            {
                switch (lv < 5)
                {
                    case (true) { -> this.bin_level(lv + 1); }
                    default
                    {
                        switch (lv == 5)
                        {
                            case (true) { -> this.equality_expression(); }
                            default
                            {
                                switch (lv == 6)
                                {
                                    case (true) { -> this.bin_level(7); }
                                    default
                                    {
                                        switch (lv == 7)
                                        {
                                            case (true) { -> this.range_expression(); }
                                            default
                                            {
                                                switch (lv == 8)
                                                {
                                                    case (true) { -> this.custom_op_expression(); }
                                                    default
                                                    {
                                                        -> this.cast_expression();
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            bin_level(int lv) -> Node*
            {
                Node* expr = this.bin_next(lv);
                switch (this.failed)
                {
                    case (true) { -> expr; }
                    default
                    {
                        int op = this.bin_match(lv);
                        Node* right;
                        Node* n;
                        int line, col;
                        while (op >= 0)
                        {
                            line = this.cur_line();
                            col = this.cur_col();
                            this.advance();
                            right = this.bin_next(lv);
                            switch (this.failed)
                            {
                                case (true) { -> expr; }
                                default
                                {
                                    n = this.mk(NodeKind.BINARY_OP, line, col);
                                    switch (this.failed)
                                    {
                                        case (true) { -> expr; }
                                        default
                                        {
                                            n.op = op;
                                            n.a = expr;
                                            n.b = right;
                                            expr = n;
                                            this.try_template_op(n);
                                            switch (this.failed)
                                            {
                                                case (true) { -> expr; }
                                                default
                                                {
                                                    op = this.bin_match(lv);
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        switch (lv >= 8 & this.starts_operand() & !this.at_custom_op())
                        {
                            case (true) {
                            this.error_missing_operator();
                        }
                            default {};
                        };
                        -> expr;
                    };
                };
            };


            equality_expression() -> Node*
            {
                Node* expr = this.chain_expression();
                switch (this.failed)
                {
                    case (true) { -> expr; }
                    default
                    {
                        Node* n;
                        Node* r;
                        int line, col, c;
                        while (true)
                        {
                            line = this.cur_line();
                            col = this.cur_col();
                            c = this.cur();
                            switch (c == TokenType.NOT & this.type_at(1) == TokenType.IN)
                            {
                                case (true) {
                                this.advance();
                                this.advance();
                                r = this.chain_expression();
                                switch (this.failed)
                                {
                                    case (true) { -> expr; }
                                    default {};
                                };
                                n = this.mk(NodeKind.IN_EXPRESSION, line, col);
                                switch (this.failed)
                                {
                                    case (true) { -> expr; }
                                    default {};
                                };
                                n.flags = 2;
                                n.a = expr;
                                n.b = r;
                                expr = n;
                                continue;
                            }
                                default
                                {
                                    switch (c)
                                    {
                                        case (TokenType.IN)
                                        {
                                            this.advance();
                                            r = this.chain_expression();
                                            switch (this.failed)
                                            {
                                                case (true) { -> expr; }
                                                default
                                                {
                                                    n = this.mk(NodeKind.IN_EXPRESSION, line, col);
                                                    switch (this.failed)
                                                    {
                                                        case (true) { -> expr; }
                                                        default
                                                        {
                                                            n.a = expr;
                                                            n.b = r;
                                                            expr = n;
                                                        };
                                                    };
                                                };
                                            };
                                        }
                                        case (TokenType.HAS)
                                        {
                                            this.advance();
                                            switch (!this.expect(TokenType.IDENTIFIER))
                                            {
                                                case (true) {
                                                this.error(g"Expected trait name after 'has'\0");
                                                -> expr;
                                            }
                                                default
                                                {
                                                    n = this.mk(NodeKind.HAS_EXPRESSION, line, col);
                                                    switch (this.failed)
                                                    {
                                                        case (true) { -> expr; }
                                                        default
                                                        {
                                                            n.text = this.cur_value();
                                                            this.advance();
                                                            n.a = expr;
                                                            expr = n;
                                                        };
                                                    };
                                                };
                                            };
                                        }
                                        default
                                        {
                                            switch (c == TokenType.IS | c == TokenType.EQUAL | c == TokenType.NOT_EQUAL)
                                            {
                                                case (true) {
                                                this.advance();
                                                r = this.chain_expression();
                                                switch (this.failed)
                                                {
                                                    case (true) { -> expr; }
                                                    default
                                                    {
                                                        n = this.mk(NodeKind.BINARY_OP, line, col);
                                                        switch (this.failed)
                                                        {
                                                            case (true) { -> expr; }
                                                            default
                                                            {
                                                                switch (c)
                                                                {
                                                                    case (TokenType.NOT_EQUAL) { n.op = Operator.NOT_EQUAL; }
                                                                    default { n.op = Operator.EQUAL; };
                                                                };
                                                                n.a = expr;
                                                                n.b = r;
                                                                expr = n;
                                                                this.try_template_op(n);
                                                                switch (this.failed)
                                                                {
                                                                    case (true) { -> expr; }
                                                                    default {};
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            }
                                                default { break; };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        -> expr;
                    };
                };
            };


            chain_expression() -> Node*
            {
                Node* expr = this.bin_level(6);
                switch (this.failed)
                {
                    case (true) { -> expr; }
                    default
                    {
                        switch (this.expect(TokenType.CHAIN_ARROW))
                        {
                            case (true) {
                            this.advance();
                            Node* right = this.chain_expression();
                            switch (this.failed)
                            {
                                case (true) { -> expr; }
                                default {};
                            };
                            switch (expr.kind != NodeKind.FUNCTION_CALL)
                            {
                                case (true) {
                                this.error(g"Chain arrow requires function call on left side\0");
                                -> expr;
                            }
                                default {};
                            };
                            NodeVec* args = node_list(expr, 0);
                            nv_push(args, right);
                            int i = args.len - 1;
                            while (i > 0)
                            {
                                args.items[i] = args.items[i - 1];
                                i--;
                            };
                            args.items[0] = right;
                            -> expr;
                        }
                            default
                            {
                                -> expr;
                            };
                        };
                    };
                };
            };


            range_expression() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* expr = this.bin_level(8);
                switch (this.failed)
                {
                    case (true) { -> expr; }
                    default
                    {
                        switch (this.expect(TokenType.RANGE))
                        {
                            case (true) {
                            this.advance();
                            Node* end = this.bin_level(8);
                            switch (this.failed)
                            {
                                case (true) { -> expr; }
                                default {};
                            };
                            Node* n = this.mk(NodeKind.RANGE_EXPRESSION, line, col);
                            switch (this.failed)
                            {
                                case (true) { -> expr; }
                                default {};
                            };
                            n.a = expr;
                            n.b = end;
                            -> n;
                        }
                            default
                            {
                                -> expr;
                            };
                        };
                    };
                };
            };


            try_cast() -> Node*
            {
                int m = this.mark();
                int line = this.cur_line();
                int col = this.cur_col();
                this.advance();
                TypeSpec* ts = this.type_spec();
                switch (!this.failed & this.expect(TokenType.RIGHT_PAREN))
                {
                    case (true) {
                    this.advance();
                    Node* inner = this.cast_expression();
                    switch (!this.failed)
                    {
                        case (true) {
                        Node* n = this.mk(NodeKind.CAST_EXPRESSION, line, col);
                        switch (this.failed)
                        {
                            case (true) { -> (Node*)0; }
                            default
                            {
                                n.ts = ts;
                                n.a = inner;
                                -> n;
                            };
                        };
                    }
                        default {};
                    };
                }
                    default {};
                };
                typespec_free(ts);
                this.clear_error();
                this.reset(m);
                -> (Node*)0;
            };


            cast_expression() -> Node*
            {
                switch (this.expect(TokenType.LEFT_PAREN))
                {
                    case (true) {
                    Node* c = this.try_cast();
                    switch (c != (Node*)0)
                    {
                        case (true) { -> c; }
                        default
                        {
                            switch (this.failed)
                            {
                                case (true) { -> c; }
                                default {};
                            };
                        };
                    };
                }
                    default {};
                };
                -> this.unary_expression();
            };

            unary_node(int op, int line, int col, Node* operand) -> Node*
            {
                switch (this.failed)
                {
                    case (true) { -> operand; }
                    default
                    {
                        Node* n = this.mk(NodeKind.UNARY_OP, line, col);
                        switch (this.failed)
                        {
                            case (true) { -> operand; }
                            default
                            {
                                n.op = op;
                                n.a = operand;
                                -> n;
                            };
                        };
                    };
                };
            };

            unary_expression() -> Node*
            {
                int c = this.cur();
                int line = this.cur_line();
                int col = this.cur_col();
                Node* operand;
                Node* n;
                int op = -1;
                bool via_cast = false;

                switch (c)
                {
                    case (TokenType.IS) { op = Operator.EQUAL; }
                    case (TokenType.NOT) { op = Operator.NOT; }
                    case (TokenType.BITNOT_OP) { op = Operator.BITNOT; }
                    case (TokenType.BITXNOT) { op = Operator.BITXNOT; }
                    case (TokenType.BITXNAND) { op = Operator.BITXNAND; }
                    case (TokenType.BITXNOR) { op = Operator.BITXNOR; }
                    case (TokenType.INCREMENT) { op = Operator.INCREMENT; }
                    case (TokenType.DECREMENT) { op = Operator.DECREMENT; }
                    case (TokenType.MINUS) { op = Operator.SUB; via_cast = true; }
                    case (TokenType.PLUS) { op = Operator.ADD; via_cast = true; }
                    default {};
                };

                switch (op >= 0)
                {
                    case (true) {
                    this.advance();
                    switch (via_cast)
                    {
                        case (true) { operand = this.cast_expression(); }
                        default { operand = this.unary_expression(); };
                    };
                    -> this.unary_node(op, line, col, operand);
                }
                    default
                    {
                        switch (c == TokenType.MULTIPLY)
                        {
                            case (true) {
                            this.advance();
                            operand = this.cast_expression();
                            switch (this.failed)
                            {
                                case (true) { -> operand; }
                                default {};
                            };
                            n = this.mk(NodeKind.POINTER_DEREF, line, col);
                            switch (this.failed)
                            {
                                case (true) { -> operand; }
                                default {};
                            };
                            n.a = operand;
                            -> n;
                        }
                            default
                            {
                                switch (c == TokenType.ADDRESS_OF)
                                {
                                    case (true) {
                                    this.advance();
                                    operand = this.unary_expression();
                                    switch (this.failed)
                                    {
                                        case (true) { -> operand; }
                                        default {};
                                    };
                                    n = this.mk(NodeKind.ADDRESS_OF, line, col);
                                    switch (this.failed)
                                    {
                                        case (true) { -> operand; }
                                        default {};
                                    };
                                    n.a = operand;
                                    -> n;
                                }
                                    default
                                    {
                                        switch (c == TokenType.ADDRESS_CAST)
                                        {
                                            case (true) {
                                            this.advance();
                                            operand = this.unary_expression();
                                            switch (this.failed)
                                            {
                                                case (true) { -> operand; }
                                                default {};
                                            };
                                            n = this.mk(NodeKind.CAST_EXPRESSION, line, col);
                                            switch (this.failed)
                                            {
                                                case (true) { -> operand; }
                                                default {};
                                            };
                                            TypeSpec* vp = typespec_new();
                                            vp.base_type = DataType.VOID;
                                            vp.flags = 64;
                                            vp.pointer_depth = 1;
                                            n.ts = vp;
                                            n.a = operand;
                                            -> n;
                                        }
                                            default
                                            {
                                                Node* cu = this.custom_unary();
                                                switch (cu != (Node*)0 | this.failed)
                                                {
                                                    case (true) { -> cu; }
                                                    default
                                                    {
                                                        -> this.postfix_expression();
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            argument_list(Node* holder, byte* callee) -> void
            {
                Node* a;
                int pos;
                Node* prev;
                while (true)
                {
                    switch (callee != (byte*)0 & this.expect(TokenType.DITTO))
                    {
                        case (true) {
                        prev = this.last_call;
                        switch (prev == (Node*)0)
                        {
                            case (true) {
                            this.error(g"Ditto in argument list: previous statement is not a function call\0");
                            ->;
                        }
                            default
                            {
                                switch (prev.text != (byte*)0)
                                {
                                    case (true) {
                                    switch (!cstr_eq(prev.text, callee))
                                    {
                                        case (true) {
                                        this.error(g"Ditto in argument list: previous call was to a different function\0");
                                        ->;
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (pos >= node_count(prev, 0))
                                {
                                    case (true) {
                                    this.error(g"Ditto in argument list: argument position is out of range\0");
                                    ->;
                                }
                                    default
                                    {
                                        this.advance();
                                        a = node_clone(node_child(prev, 0, pos));
                                    };
                                };
                            };
                        };
                    }
                        default {
                        a = this.expression();
                        switch (this.failed)
                        {
                            case (true) { ->; }
                            default {};
                        };
                    };
                    };
                    node_push(holder, 0, a);
                    pos++;
                    switch (!this.expect(TokenType.COMMA))
                    {
                        case (true) { break; }
                        default
                        {
                            this.advance();
                        };
                    };
                };
                ->;
            };


            take_args(Node* call, Node* holder) -> void
            {
                call.l0 = holder.l0;
                holder.l0 = (NodeVec*)0;
                -> node_free(holder);
            };


            postfix_expression() -> Node*
            {
                int tl = 0;
                int tc = 0;
                bool tied = false;
                switch (this.expect(TokenType.TIE))
                {
                    case (true) {
                    tied = true;
                    tl = this.cur_line();
                    tc = this.cur_col();
                    this.advance();
                }
                    default {};
                };
                Node* expr = this.primary_expression();
                switch (this.failed)
                {
                    case (true) { -> expr; }
                    default
                    {
                        Node* n;
                        switch (tied)
                        {
                            case (true) {
                            n = this.mk(NodeKind.TIE_EXPRESSION, tl, tc);
                            switch (this.failed)
                            {
                                case (true) { -> expr; }
                                default
                                {
                                    n.a = expr;
                                    expr = n;
                                };
                            };
                        }
                            default {};
                        };


                        expr = this.template_call(expr);
                        switch (this.failed)
                        {
                            case (true) { -> expr; }
                            default
                            {
                                -> this.postfix_from(expr);
                            };
                        };
                    };
                };
            };



            postfix_from(Node* expr) -> Node*
            {
                Node* n;
                COp* pc;
                int line, col;
                Node* idx;
                Node* end;
                Node* holder;
                Node* fill;
                bool rvalform = false;
                byte* callee;
                byte* member;
                int pop;
                TypeSpec* target;
                Node* src;
                Node* cond;
                Node* els;
                byte* tkey;
                byte* qkey;
                Node* fsn;
                while (true)
                {
                    line = this.cur_line();
                    col = this.cur_col();
                    switch (this.expect(TokenType.LEFT_BRACKET))
                    {
                        case (true) {
                        this.advance();
                        switch (this.expect(TokenType.BACKTICK))
                        {
                            case (true) {
                            this.advance();
                            idx = this.expression();
                            switch (this.failed)
                            {
                                case (true) { -> expr; }
                                default {};
                            };
                            switch (!this.consume(TokenType.RIGHT_BRACKET))
                            {
                                case (true) { -> expr; }
                                default {};
                            };
                            n = this.mk(NodeKind.BIT_INDEX_ACCESS, line, col);
                            switch (this.failed)
                            {
                                case (true) { -> expr; }
                                default {};
                            };
                            n.a = expr;
                            n.b = idx;
                            expr = n;
                            continue;
                        }
                            default
                            {
                                idx = this.expression();
                                switch (this.failed)
                                {
                                    case (true) { -> expr; }
                                    default
                                    {
                                        switch (this.expect(TokenType.BITSLICE))
                                        {
                                            case (true) {
                                            this.advance();
                                            end = this.expression();
                                            switch (this.failed)
                                            {
                                                case (true) { -> expr; }
                                                default
                                                {
                                                    switch (!this.consume(TokenType.RIGHT_BRACKET))
                                                    {
                                                        case (true) { -> expr; }
                                                        default
                                                        {
                                                            n = this.mk(NodeKind.BIT_SLICE, line, col);
                                                            switch (this.failed)
                                                            {
                                                                case (true) { -> expr; }
                                                                default
                                                                {
                                                                    n.a = expr;
                                                                    n.b = idx;
                                                                    n.c = end;
                                                                    expr = n;
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        }
                                            default {
                                                switch (this.expect(TokenType.COLON))
                                                {
                                                    case (true) {
                                            this.advance();
                                            end = this.expression();
                                            switch (this.failed)
                                            {
                                                case (true) { -> expr; }
                                                default
                                                {
                                                    switch (!this.consume(TokenType.RIGHT_BRACKET))
                                                    {
                                                        case (true) { -> expr; }
                                                        default
                                                        {
                                                            n = this.mk(NodeKind.ARRAY_SLICE, line, col);
                                                            switch (this.failed)
                                                            {
                                                                case (true) { -> expr; }
                                                                default
                                                                {
                                                                    n.a = expr;
                                                                    n.b = idx;
                                                                    n.c = end;
                                                                    expr = n;
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        }
                                                    default {
                                            switch (!this.consume(TokenType.RIGHT_BRACKET))
                                            {
                                                case (true) { -> expr; }
                                                default
                                                {
                                                    switch (idx.kind == NodeKind.RANGE_EXPRESSION & this.expect(TokenType.ASSIGN))
                                                    {
                                                        case (true) {
                                                        this.advance();
                                                        rvalform = !this.expect(TokenType.LEFT_BRACE);
                                                        switch (rvalform)
                                                        {
                                                            case (true) {}
                                                            default { this.advance(); };
                                                        };
                                                        fill = this.expression();
                                                        switch (this.failed)
                                                        {
                                                            case (true) { -> expr; }
                                                            default {};
                                                        };
                                                        switch (rvalform)
                                                        {
                                                            case (true) {}
                                                            default
                                                            {
                                                                switch (!this.consume_msg(TokenType.RIGHT_BRACE, g"Expected '}' after fill value in range assignment\0")) { case (true) { -> expr; } default {}; }; }; }; n = this.mk(NodeKind.RANGE_ASSIGNMENT, line, col);
                                                        switch (this.failed)
                                                        {
                                                            case (true) { -> expr; }
                                                            default {};
                                                        };
                                                        n.a = expr;
                                                        n.b = idx.a;
                                                        n.c = idx.b;
                                                        n.d = fill;
                                                        switch (rvalform)
                                                        {
                                                            case (true) { n.ival = (i64)1; }
                                                            default {};
                                                        };
                                                        idx.a = (Node*)0;
                                                        idx.b = (Node*)0;
                                                        node_free(idx);
                                                        expr = n;
                                                        break;
                                                    }
                                                        default
                                                        {
                                                            n = this.mk(NodeKind.ARRAY_ACCESS, line, col);
                                                            switch (this.failed)
                                                            {
                                                                case (true) { -> expr; }
                                                                default
                                                                {
                                                                    n.a = expr;
                                                                    n.b = idx;
                                                                    expr = n;
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    }
                        default {
                            switch (this.expect(TokenType.LEFT_PAREN))
                            {
                                case (true) {
                        this.advance();
                        holder = this.mk(NodeKind.NODE_LIST, line, col);
                        switch (this.failed)
                        {
                            case (true) { -> expr; }
                            default
                            {
                                callee = (byte*)0;
                                switch (expr.kind == NodeKind.IDENTIFIER)
                                {
                                    case (true) { callee = expr.text; }
                                    default {};
                                };
                                switch (!this.expect(TokenType.RIGHT_PAREN))
                                {
                                    case (true) {
                                    this.argument_list(holder, callee);
                                    switch (this.failed)
                                    {
                                        case (true) { -> expr; }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (!this.consume(TokenType.RIGHT_PAREN))
                                {
                                    case (true) { -> expr; }
                                    default
                                    {
                                        switch (expr.kind)
                                        {
                                            case (NodeKind.IDENTIFIER)
                                            {

                                                switch (nm_has(this.macros, expr.text))
                                                {
                                                    case (true) { n = this.mk(NodeKind.MACRO_CALL, line, col); }
                                                    default { n = this.mk(NodeKind.FUNCTION_CALL, line, col); };
                                                };
                                                switch (this.failed)
                                                {
                                                    case (true) { -> expr; }
                                                    default
                                                    {
                                                        n.text = expr.text;
                                                        this.take_args(n, holder);
                                                    };
                                                };
                                            }
                                            case (NodeKind.STRING_LITERAL)
                                            {
                                                n = this.mk(NodeKind.FUNCTION_CALL, line, col);
                                                switch (this.failed)
                                                {
                                                    case (true) { -> expr; }
                                                    default
                                                    {
                                                        n.text = expr.text;
                                                        this.take_args(n, holder);
                                                    };
                                                };
                                            }
                                            default
                                            {
                                                switch (expr.kind == NodeKind.F_STRING_LITERAL | expr.kind == NodeKind.STRINGIFY)
                                                {
                                                    case (true) {
                                                    n = this.mk(NodeKind.FUNCTION_CALL, line, col);
                                                    switch (this.failed)
                                                    {
                                                        case (true) { -> expr; }
                                                        default
                                                        {
                                                            n.a = expr;
                                                            expr = (Node*)0;
                                                            this.take_args(n, holder);
                                                        };
                                                    };
                                                }
                                                    default {
                                                        switch (expr.kind == NodeKind.MEMBER_ACCESS)
                                                        {
                                                            case (true) {
                                                    n = (Node*)0;
                                                    switch (expr.text2 != (byte*)0)
                                                    {
                                                        case (true) { n = this.typefunc_call_implicit(expr, holder, line, col); }
                                                        default {};
                                                    };
                                                    switch (this.failed)
                                                    {
                                                        case (true) { -> expr; }
                                                        default
                                                        {
                                                            switch (n != (Node*)0)
                                                            {
                                                                case (true) {
                                                                this.take_args(n, holder);
                                                                this.push_front(n, expr.a);
                                                                expr.a = (Node*)0;
                                                            }
                                                                default {
                                                                n = this.mk(NodeKind.METHOD_CALL, line, col);
                                                                switch (this.failed)
                                                                {
                                                                    case (true) { -> expr; }
                                                                    default
                                                                    {
                                                                        n.a = expr.a;
                                                                        n.text = expr.text;
                                                                        expr.a = (Node*)0;
                                                                        this.take_args(n, holder);
                                                                    };
                                                                };
                                                            };
                                                            };
                                                        };
                                                    };
                                                }
                                                            default {
                                                    this.error(g"Cannot call function on complex expression\0");
                                                    -> expr;
                                                };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                        switch (expr != (Node*)0)
                                        {
                                            case (true) { node_free(expr); }
                                            default {};
                                        };
                                        expr = n;
                                    };
                                };
                            };
                        };
                    }
                                default {
                                    switch (this.expect(TokenType.DOT))
                                    {
                                        case (true) {
                        this.advance();
                        member = (byte*)0;
                        switch (this.expect(TokenType.F_STRING) | this.expect(TokenType.I_STRING))
                        {
                            case (true) {
                            fsn = this.fstr_node();
                            switch (this.failed)
                            {
                                case (true) { -> expr; }
                                default
                                {
                                    member = this.fstr_resolve(fsn);
                                    node_free(fsn);
                                    switch (member == (byte*)0)
                                    {
                                        case (true) {
                                        this.error(g"The member name could not be resolved at parse time\0");
                                        -> expr;
                                    }
                                        default {};
                                    };
                                };
                            };
                        }
                            default {
                                switch (this.expect(TokenType.STRING_LITERAL))
                                {
                                    case (true) {
                            member = this.cur_value();
                            this.advance();
                        }
                                    default {
                                        switch (this.expect(TokenType.TAG))
                                        {
                                            case (true) {
                            this.advance();
                            member = g"#\0";
                        }
                                            default {
                            switch (!this.expect(TokenType.IDENTIFIER))
                            {
                                case (true) {
                                this.fail_expected(TokenType.IDENTIFIER);
                                -> expr;
                            }
                                default
                                {
                                    member = this.cur_value();
                                    this.advance();
                                };
                            };
                        };
                                        };
                                    };
                                };
                            };
                        };
                        tkey = this.typefunc_key(expr, member);
                        switch (this.expect(TokenType.LESS_THAN))
                        {
                            case (true) {
                            qkey = (byte*)0;
                            switch (expr.kind == NodeKind.IDENTIFIER)
                            {
                                case (true) {
                                qkey = this.cat2(this.cat2(expr.text, g".\0"), member);
                                switch (this.template_lookup(qkey) == (TemplateEntry*)0)
                                {
                                    case (true) { qkey = (byte*)0; }
                                    default {};
                                };
                            }
                                default {};
                            };
                            switch (qkey != (byte*)0)
                            {
                                case (true) {
                                expr = this.template_method_explicit(expr, qkey, false);
                                switch (this.failed)
                                {
                                    case (true) { -> expr; }
                                    default {};
                                };
                                continue;
                            }
                                default
                                {
                                    switch (tkey != (byte*)0)
                                    {
                                        case (true) {
                                        expr = this.template_method_explicit(expr, tkey, true);
                                        switch (this.failed)
                                        {
                                            case (true) { -> expr; }
                                            default
                                            {
                                                continue;
                                            };
                                        };
                                    }
                                        default {};
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        n = this.mk(NodeKind.MEMBER_ACCESS, line, col);
                        switch (this.failed)
                        {
                            case (true) { -> expr; }
                            default
                            {
                                n.a = expr;
                                n.text = member;
                                switch (tkey != (byte*)0 & this.expect(TokenType.LEFT_PAREN))
                                {
                                    case (true) { n.text2 = tkey; }
                                    default {};
                                };
                                expr = n;
                            };
                        };
                    }
                                        default {
                                            switch (this.expect(TokenType.INCREMENT) | this.expect(TokenType.DECREMENT))
                                            {
                                                case (true) {

                        switch (this.cop_best(0) != (COp*)0)
                        {
                            case (true) { -> expr; }
                            default
                            {
                                pop = Operator.INCREMENT;
                                switch (this.expect(TokenType.DECREMENT))
                                {
                                    case (true) { pop = Operator.DECREMENT; }
                                    default {};
                                };
                                this.advance();
                                n = this.unary_node(pop, line, col, expr);
                                switch (this.failed)
                                {
                                    case (true) { -> expr; }
                                    default
                                    {
                                        n.flags = 1;
                                        expr = n;
                                    };
                                };
                            };
                        };
                    }
                                                default {
                                                    switch (this.expect(TokenType.NOT_NULL))
                                                    {
                                                        case (true) {
                        this.advance();
                        n = this.mk(NodeKind.NOT_NULL, line, col);
                        switch (this.failed)
                        {
                            case (true) { -> expr; }
                            default
                            {
                                n.a = expr;
                                expr = n;
                            };
                        };
                    }
                                                        default {
                                                            switch (this.expect(TokenType.AS))
                                                            {
                                                                case (true) {
                        this.advance();
                        target = this.type_spec();
                        switch (this.failed)
                        {
                            case (true) { -> expr; }
                            default
                            {
                                switch (target.custom_typename != (byte*)0)
                                {
                                    case (true) {
                                    n = this.mk(NodeKind.STRUCT_RECAST, line, col);
                                    switch (this.failed)
                                    {
                                        case (true) { -> expr; }
                                        default
                                        {
                                            n.text = target.custom_typename;
                                            n.a = expr;
                                            typespec_free(target);
                                        };
                                    };
                                }
                                    default {
                                    n = this.mk(NodeKind.CAST_EXPRESSION, line, col);
                                    switch (this.failed)
                                    {
                                        case (true) { -> expr; }
                                        default
                                        {
                                            n.ts = target;
                                            n.a = expr;
                                        };
                                    };
                                };
                                };
                                expr = n;
                            };
                        };
                    }
                                                                default {
                                                                    switch (this.expect(TokenType.FROM))
                                                                    {
                                                                        case (true) {
                        this.advance();
                        src = this.postfix_expression();
                        switch (this.failed)
                        {
                            case (true) { -> expr; }
                            default
                            {
                                switch (expr.kind != NodeKind.IDENTIFIER)
                                {
                                    case (true) {
                                    this.error_exp(g"Expected struct type name before 'from' keyword\0", TokenType.IDENTIFIER);
                                    -> expr;
                                }
                                    default
                                    {
                                        n = this.mk(NodeKind.STRUCT_RECAST, line, col);
                                        switch (this.failed)
                                        {
                                            case (true) { -> expr; }
                                            default
                                            {
                                                n.text = expr.text;
                                                n.a = src;
                                                node_free(expr);
                                                expr = n;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    }
                                                                        default {
                                                                            switch (this.expect(TokenType.IF))
                                                                            {
                                                                                case (true) {
                        this.advance(); switch (!this.consume_msg(TokenType.LEFT_PAREN, g"Expected '(' after 'if' in if-expression\0")) { case (true) { -> expr; }
                            default
                            {
                                cond = this.expression(); switch (this.failed) { case (true) { -> expr; } default { switch (!this.consume_msg(TokenType.RIGHT_PAREN, g"Expected ')' after condition in if-expression\0"))
                                        {
                                            case (true) { -> expr; }
                                            default
                                            {
                                                els = (Node*)0;
                                                switch (this.expect(TokenType.ELSE))
                                                {
                                                    case (true) {
                                                    this.advance();
                                                    els = this.postfix_expression();
                                                    switch (this.failed)
                                                    {
                                                        case (true) { -> expr; }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                n = this.mk(NodeKind.IF_EXPRESSION, line, col);
                                                switch (this.failed)
                                                {
                                                    case (true) { -> expr; }
                                                    default
                                                    {
                                                        n.a = expr;
                                                        n.b = cond;
                                                        n.c = els;
                                                        expr = n;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    }
                                                                                default {
                        pc = this.cop_best(3);
                        switch (pc == (COp*)0)
                        {
                            case (true) { break; }
                            default
                            {
                                n = this.op_call(pc.func, this.cur_line(), this.cur_col());
                                switch (this.failed)
                                {
                                    case (true) { -> expr; }
                                    default
                                    {
                                        this.skip_tokens(pc.left.n);
                                        node_push(n, 0, expr);
                                        expr = n;
                                    };
                                };
                            };
                        };
                    };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                -> expr;
            };


            lit(int dt, i64 v, int line, int col) -> Node*
            {
                Node* n = this.mk(NodeKind.LITERAL, line, col);
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        n.op = dt;
                        n.ival = v;
                        -> n;
                    };
                };
            };


            int_literal(int dt) -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                bool ok;
                i64 v = this.parse_int(this.cur_value(), @ok);
                switch (!ok)
                {
                    case (true) {
                    this.error(g"Invalid integer literal\0");
                    -> (Node*)0;
                }
                    default
                    {
                        Node* n = this.lit(dt, v, line, col);
                        switch (this.failed)
                        {
                            case (true) { -> n; }
                            default
                            {
                                n.text = this.cur_value();
                                this.advance();
                                -> n;
                            };
                        };
                    };
                };
            };

            is_type_start_kw() -> bool -> this.expect4(TokenType.SINT, TokenType.FLOAT_KW, TokenType.DOUBLE_KW, TokenType.CHAR) | this.expect4(TokenType.BOOL_KW, TokenType.DATA, TokenType.VOID, TokenType.SLONG) | this.expect4(TokenType.ULONG, TokenType.CONST, TokenType.VOLATILE, TokenType.SIGNED) | this.expect(TokenType.UNSIGNED);




            type_or_expr(int kind, int line, int col, bool type_first) -> Node*
            {
                Node* n = this.mk(kind, line, col);
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        int m = this.mark();
                        int pass;
                        bool as_type;
                        TypeSpec* ts;
                        Node* e;
                        while (pass < 2)
                        {
                            as_type = type_first;
                            switch (pass == 1)
                            {
                                case (true) { as_type = !type_first; }
                                default {};
                            };
                            switch (as_type)
                            {
                                case (true) {
                                ts = this.type_spec();
                                switch (!this.failed & this.expect(TokenType.RIGHT_PAREN))
                                {
                                    case (true) {
                                    this.advance();
                                    n.ts = ts;
                                    -> n;
                                }
                                    default
                                    {
                                        switch (!this.failed)
                                        {
                                            case (true) { this.fail_expected(TokenType.RIGHT_PAREN); }
                                            default {};
                                        };
                                        typespec_free(ts);
                                    };
                                };
                            }
                                default {
                                e = this.expression();
                                switch (!this.failed & this.expect(TokenType.RIGHT_PAREN))
                                {
                                    case (true) {
                                    this.advance();
                                    n.a = e;
                                    -> n;
                                }
                                    default
                                    {
                                        switch (!this.failed)
                                        {
                                            case (true) { this.fail_expected(TokenType.RIGHT_PAREN); }
                                            default {};
                                        };
                                        node_free(e);
                                    };
                                };
                            };
                            };
                            switch (pass == 0)
                            {
                                case (true) {
                                this.clear_error();
                                this.reset(m);
                            }
                                default {};
                            };
                            pass++;
                        };
                        -> n;
                    };
                };
            };


            type_query(int kind, int kw) -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                this.advance(); switch (kind == NodeKind.ENDIAN_OF) { case (true) { this.consume_msg(TokenType.LEFT_PAREN, g"Expected '(' after endianof\0"); } default { this.consume(TokenType.LEFT_PAREN); }; }; switch (this.failed) { case (true) { -> (Node*)0; } default { bool type_first;
                        switch (kind)
                        {
                            case (NodeKind.ALIGN_OF) { type_first = true; }
                            case (NodeKind.ENDIAN_OF)
                            {
                                type_first = this.is_type_start_kw() | this.expect(TokenType.IDENTIFIER);
                            }
                            default { type_first = this.is_type_start_kw(); };
                        };
                        -> this.type_or_expr(kind, line, col, type_first);
                    };
                };
            };

            array_literal() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                this.advance();
                Node* n;
                switch (this.expect(TokenType.RIGHT_BRACKET))
                {
                    case (true) {
                    this.advance();
                    -> this.mk(NodeKind.ARRAY_LITERAL, line, col);
                }
                    default
                    {
                        Node* first = this.expression();
                        switch (this.failed)
                        {
                            case (true) { -> first; }
                            default
                            {
                                switch (this.expect(TokenType.FOR))
                                {
                                    case (true) {
                                    this.advance();
                                    switch (!this.consume(TokenType.LEFT_PAREN))
                                    {
                                        case (true) { -> first; }
                                        default {};
                                    };
                                    TypeSpec* vt = this.type_spec();
                                    switch (this.failed)
                                    {
                                        case (true) { -> first; }
                                        default {};
                                    };
                                    switch (!this.expect(TokenType.IDENTIFIER))
                                    {
                                        case (true) {
                                        this.fail_expected(TokenType.IDENTIFIER);
                                        -> first;
                                    }
                                        default {};
                                    };
                                    byte* vname = this.cur_value();
                                    this.advance();
                                    switch (!this.consume(TokenType.IN))
                                    {
                                        case (true) { -> first; }
                                        default {};
                                    };
                                    Node* iter = this.expression();
                                    switch (this.failed)
                                    {
                                        case (true) { -> first; }
                                        default {};
                                    };
                                    switch (!this.consume(TokenType.RIGHT_PAREN))
                                    {
                                        case (true) { -> first; }
                                        default {};
                                    };
                                    switch (!this.consume(TokenType.RIGHT_BRACKET))
                                    {
                                        case (true) { -> first; }
                                        default {};
                                    };
                                    n = this.mk(NodeKind.ARRAY_COMPREHENSION, line, col);
                                    switch (this.failed)
                                    {
                                        case (true) { -> first; }
                                        default {};
                                    };
                                    n.a = first;
                                    n.text = vname;
                                    n.ts = vt;
                                    n.b = iter;
                                    -> n;
                                }
                                    default
                                    {
                                        n = this.mk(NodeKind.ARRAY_LITERAL, line, col);
                                        switch (this.failed)
                                        {
                                            case (true) { -> first; }
                                            default
                                            {
                                                node_push(n, 0, first);
                                                Node* e;
                                                while (this.expect(TokenType.COMMA))
                                                {
                                                    this.advance();
                                                    e = this.expression();
                                                    switch (this.failed)
                                                    {
                                                        case (true) { -> n; }
                                                        default
                                                        {
                                                            node_push(n, 0, e);
                                                        };
                                                    };
                                                };
                                                switch (!this.consume(TokenType.RIGHT_BRACKET))
                                                {
                                                    case (true) { -> n; }
                                                    default
                                                    {
                                                        -> n;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            struct_literal() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                this.advance();
                Node* n = this.mk(NodeKind.STRUCT_LITERAL, line, col);
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        Node* nm;
                        Node* v;
                        switch (!this.expect(TokenType.RIGHT_BRACE))
                        {
                            case (true) {
                            switch (this.expect(TokenType.IDENTIFIER) & this.type_at(1) == TokenType.ASSIGN)
                            {
                                case (true) {
                                while (true)
                                {
                                    switch (!this.expect(TokenType.IDENTIFIER))
                                    {
                                        case (true) {
                                        this.fail_expected(TokenType.IDENTIFIER);
                                        -> n;
                                    }
                                        default
                                        {
                                            nm = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                                            switch (this.failed)
                                            {
                                                case (true) { -> n; }
                                                default
                                                {
                                                    nm.text = this.cur_value();
                                                    this.advance();
                                                    switch (!this.consume(TokenType.ASSIGN))
                                                    {
                                                        case (true) { -> n; }
                                                        default
                                                        {
                                                            v = this.expression();
                                                            switch (this.failed)
                                                            {
                                                                case (true) { -> n; }
                                                                default
                                                                {
                                                                    node_push(n, 0, nm);
                                                                    node_push(n, 1, v);
                                                                    switch (!this.expect(TokenType.COMMA))
                                                                    {
                                                                        case (true) { break; }
                                                                        default
                                                                        {
                                                                            this.advance();
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            }
                                default {
                                while (true)
                                {
                                    v = this.expression();
                                    switch (this.failed)
                                    {
                                        case (true) { -> n; }
                                        default
                                        {
                                            node_push(n, 2, v);
                                            switch (!this.expect(TokenType.COMMA))
                                            {
                                                case (true) { break; }
                                                default
                                                {
                                                    this.advance();
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                            };
                        }
                            default {};
                        };
                        this.consume(TokenType.RIGHT_BRACE);
                        -> n;
                    };
                };
            };


            dict_literal() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                this.advance();
                Node* n = this.mk(NodeKind.DICT_LITERAL_EXPR, line, col);
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        Node* k;
                        Node* v;
                        while (!this.expect(TokenType.RIGHT_BRACE))
                        {
                            switch (this.expect(TokenType.EOF))
                            {
                                case (true) {
                                this.fail_expected(TokenType.RIGHT_BRACE);
                                -> n;
                            }
                                default
                                {
                                    k = this.expression();
                                    switch (this.failed)
                                    {
                                        case (true) { -> n; }
                                        default
                                        {
                                            switch (!this.consume(TokenType.COLON))
                                            {
                                                case (true) { -> n; }
                                                default
                                                {
                                                    v = this.expression();
                                                    switch (this.failed)
                                                    {
                                                        case (true) { -> n; }
                                                        default
                                                        {
                                                            node_push(n, 0, k);
                                                            node_push(n, 1, v);
                                                            switch (this.expect(TokenType.COMMA))
                                                            {
                                                                case (true) { this.advance(); }
                                                                default {};
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        this.consume(TokenType.RIGHT_BRACE);
                        -> n;
                    };
                };
            };


            scoped_identifier() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                byte* name = this.cur_value();
                this.advance();
                while (this.expect(TokenType.SCOPE))
                {
                    this.advance();
                    switch (!this.expect(TokenType.IDENTIFIER))
                    {
                        case (true) {
                        this.fail_expected(TokenType.IDENTIFIER);
                        -> (Node*)0;
                    }
                        default
                        {
                            name = this.cat2(this.cat2(name, g"__\0"), this.cur_value());
                            this.advance();
                        };
                    };
                };
                Node* n = this.mk(NodeKind.IDENTIFIER, line, col);
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        n.text = name;
                        -> n;
                    };
                };
            };


            stringify_expr() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                int nx = this.type_at(1);
                int svpos = this.pos;
                Node* sn;

                switch (this.vop_sym != (OpSym*)0)
                {
                    case (true) {
                        this.advance();
                        switch (this.opsym_match(this.vop_sym))
                        {
                            case (true) {
                                sn = this.mk(NodeKind.STRING_LITERAL, line, col);
                                switch (this.failed)
                                {
                                    case (true) { -> sn; }
                                    default {};
                                };

                                byte* ot = g"\0";
                                int oi = 0;
                                while (oi < this.vop_sym.n)
                                {
                                    switch (this.vop_sym.t[oi] == TokenType.IDENTIFIER)
                                    {
                                        case (true) { ot = this.cat2(ot, this.vop_sym.v[oi]); }
                                        default { ot = this.cat2(ot, this.tok_symbol(this.vop_sym.t[oi])); };
                                    };
                                    oi++;
                                };
                                sn.text = ot;
                                sn.op = -1;
                                this.skip_tokens(this.vop_sym.n);
                                -> sn;
                            }
                            default { this.pos = svpos; };
                        };
                    }
                    default {};
                };
                bool valid = nx == TokenType.IDENTIFIER | nx == TokenType.CODIFY | nx == TokenType.DOT | nx == TokenType.TAG |
                             nx == TokenType.SINT | nx == TokenType.UINT | nx == TokenType.SLONG | nx == TokenType.ULONG |
                             nx == TokenType.FLOAT_KW | nx == TokenType.DOUBLE_KW | nx == TokenType.BOOL_KW | nx == TokenType.BYTE;
                switch (!valid) { case (true) { this.advance(); switch (this.in_fn_stringify != 0) { case (true) { this.error_exp(g"Expected identifier after '$' in function name\0", TokenType.IDENTIFIER); } default { this.error_exp(g"Expected identifier after '$'\0", TokenType.IDENTIFIER); }; }; -> (Node*)0; }
                    default
                    {
                        this.advance();
                        Node* n;
                        switch (this.expect(TokenType.CODIFY))
                        {
                            case (true) {

                            byte* resolved = this.consume_codify();
                            switch (this.failed)
                            {
                                case (true) { -> (Node*)0; }
                                default {};
                            };
                            n = this.mk(NodeKind.STRING_LITERAL, line, col);
                            switch (this.failed)
                            {
                                case (true) { -> n; }
                                default {};
                            };
                            n.text = resolved;
                            n.op = -1;
                            -> n;
                        }
                            default
                            {
                                byte* kw = (byte*)0;
                                int c = this.cur();
                                switch (c)
                                {
                                    case (TokenType.SINT) { kw = g"int\0"; }
                                    case (TokenType.UINT) { kw = g"uint\0"; }
                                    case (TokenType.SLONG) { kw = g"long\0"; }
                                    case (TokenType.ULONG) { kw = g"ulong\0"; }
                                    case (TokenType.FLOAT_KW) { kw = g"float\0"; }
                                    case (TokenType.DOUBLE_KW) { kw = g"double\0"; }
                                    case (TokenType.BOOL_KW) { kw = g"bool\0"; }
                                    case (TokenType.BYTE) { kw = g"byte\0"; }
                                    default {};
                                };
                                switch (kw != (byte*)0)
                                {
                                    case (true) {
                                    this.advance();
                                    n = this.mk(NodeKind.STRING_LITERAL, line, col);
                                    switch (this.failed)
                                    {
                                        case (true) { -> n; }
                                        default {};
                                    };
                                    n.text = kw;
                                    n.op = -1;
                                    -> n;
                                }
                                    default
                                    {
                                        switch (!this.expect(TokenType.IDENTIFIER))
                                        {
                                            case (true) {
                                            this.error(g"Expected identifier after '$'\0");
                                            -> (Node*)0;
                                        }
                                            default
                                            {
                                                n = this.mk(NodeKind.STRINGIFY, line, col);
                                                switch (this.failed)
                                                {
                                                    case (true) { -> n; }
                                                    default
                                                    {
                                                        n.text = this.cur_value();
                                                        this.advance();
                                                        switch (this.expect(TokenType.DOT))
                                                        {
                                                            case (true) {
                                                            this.advance();
                                                            switch (this.expect(TokenType.IDENTIFIER))
                                                            {
                                                                case (true) {
                                                                n.text2 = this.cur_value();
                                                                this.advance();
                                                            }
                                                                default {
                                                                    switch (this.expect(TokenType.TAG))
                                                                    {
                                                                        case (true) {
                                                                this.advance();
                                                                n.text2 = g"#\0";
                                                            }
                                                                        default {
                                                                switch (this.in_fn_stringify != 0) { case (true) { this.error_exp(g"Expected member name after '.' in stringify function name\0", TokenType.IDENTIFIER); } default { this.error_exp(g"Expected member name after '.' in stringify expression\0", TokenType.IDENTIFIER); }; };
                                                                -> n;
                                                            };
                                                                    };
                                                                };
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                        -> n;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            primary_expression() -> Node*
            {
                int c = this.cur();
                int line = this.cur_line();
                int col = this.cur_col();
                Node* n;
                bool ok;

                switch (this.vop_sym != (OpSym*)0)
                {
                    case (true) {
                    switch (this.opsym_match(this.vop_sym))
                    {
                        case (true) {
                        n = this.mk(NodeKind.IDENTIFIER, line, col);
                        switch (this.failed)
                        {
                            case (true) { -> n; }
                            default
                            {
                                n.text = g"__op_count\0";
                                this.skip_tokens(this.vop_sym.n);

                                switch (this.cur() == TokenType.DOT & this.type_at(1) == TokenType.IDENTIFIER)
                                {
                                    case (true) {
                                        this.advance();
                                        switch (this.val_is(g"is_leading\0", 10))
                                        {
                                            case (true) { n.text = g"__op_leading\0"; this.advance(); }
                                            default
                                            {
                                                switch (this.val_is(g"is_trailing\0", 11))
                                                {
                                                    case (true) { n.text = g"__op_trailing\0"; this.advance(); }
                                                    default { this.pos = this.pos - 1; };
                                                };
                                            };
                                        };
                                    }
                                    default {};
                                };
                                -> n;
                            };
                        };
                    }
                        default {};
                    };
                }
                    default {};
                };
                switch (c == TokenType.IDENTIFIER)
                {
                    case (true) { -> this.scoped_identifier(); }
                    default
                    {
                        switch (c == TokenType.SINT_LITERAL)
                        {
                            case (true) { -> this.int_literal(DataType.SINT); }
                            default
                            {
                                switch (c == TokenType.UINT_LITERAL)
                                {
                                    case (true) { -> this.int_literal(DataType.UINT); }
                                    default
                                    {
                                        switch (c == TokenType.SLONG_LITERAL)
                                        {
                                            case (true) { -> this.int_literal(DataType.SLONG); }
                                            default
                                            {
                                                switch (c == TokenType.ULONG_LITERAL)
                                                {
                                                    case (true) { -> this.int_literal(DataType.ULONG); }
                                                    default
                                                    {
                                                        switch (c == TokenType.BYTE_LITERAL)
                                                        {
                                                            case (true) { -> this.int_literal(DataType.BYTE); }
                                                            default
                                                            {
                                                                switch (c == TokenType.FLOAT | c == TokenType.DOUBLE)
                                                                {
                                                                    case (true) {
                                                                    n = this.mk(NodeKind.LITERAL, line, col);
                                                                    switch (this.failed)
                                                                    {
                                                                        case (true) { -> n; }
                                                                        default {};
                                                                    };
                                                                    switch (c)
                                                                    {
                                                                        case (TokenType.FLOAT) { n.op = DataType.FLOAT; }
                                                                        default { n.op = DataType.DOUBLE; };
                                                                    };
                                                                    n.fval = this.parse_double(this.cur_value());
                                                                    n.text = this.cur_value();
                                                                    this.advance();
                                                                    -> n;
                                                                }
                                                                    default
                                                                    {
                                                                        switch (c == TokenType.CHAR)
                                                                        {
                                                                            case (true) {
                                                                            n = this.mk(NodeKind.LITERAL, line, col);
                                                                            switch (this.failed)
                                                                            {
                                                                                case (true) { -> n; }
                                                                                default {};
                                                                            };
                                                                            n.op = DataType.CHAR;
                                                                            n.text = this.cur_value();
                                                                            switch (this.toks[this.pos].numeric_char != 0)
                                                                            {
                                                                                case (true) { n.ival = this.parse_int(this.cur_value(), @ok); }
                                                                                default {
                                                                                byte* cv = this.cur_value();
                                                                                n.ival = (i64)cv[0];
                                                                            };
                                                                            };
                                                                            this.advance();
                                                                            -> n;
                                                                        }
                                                                            default
                                                                            {
                                                                                switch (c == TokenType.STRING_LITERAL | c == TokenType.G_STRING)
                                                                                {
                                                                                    case (true) {
                                                                                    n = this.mk(NodeKind.STRING_LITERAL, line, col);
                                                                                    switch (this.failed)
                                                                                    {
                                                                                        case (true) { -> n; }
                                                                                        default {};
                                                                                    };
                                                                                    n.text = this.cur_value();
                                                                                    n.ival = (i64)this.cur_value_len();
                                                                                    n.op = -1;
                                                                                    switch (c == TokenType.G_STRING)
                                                                                    {
                                                                                        case (true) { n.op = StorageClass.GLOBAL; }
                                                                                        default {};
                                                                                    };
                                                                                    this.advance();
                                                                                    -> n;
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        switch (c == TokenType.F_STRING)
                                                                                        {
                                                                                            case (true) { -> this.f_string_node(); }
                                                                                            default
                                                                                            {
                                                                                                switch (c == TokenType.I_STRING)
                                                                                                {
                                                                                                    case (true) { -> this.i_string_node(); }
                                                                                                    default
                                                                                                    {
                                                                                                        switch (c == TokenType.TRUE)
                                                                                                        {
                                                                                                            case (true) { this.advance(); -> this.lit(DataType.BOOL, 1, line, col); }
                                                                                                            default
                                                                                                            {
                                                                                                                switch (c == TokenType.FALSE)
                                                                                                                {
                                                                                                                    case (true) { this.advance(); -> this.lit(DataType.BOOL, 0, line, col); }
                                                                                                                    default
                                                                                                                    {
                                                                                                                        switch (c == TokenType.VOID)
                                                                                                                        {
                                                                                                                            case (true) { this.advance(); -> this.lit(DataType.VOID, 0, line, col); }
                                                                                                                            default
                                                                                                                            {
                                                                                                                                switch (c == TokenType.THIS)
                                                                                                                                {
                                                                                                                                    case (true) {
                                                                                                                                    n = this.mk(NodeKind.IDENTIFIER, line, col);
                                                                                                                                    switch (this.failed)
                                                                                                                                    {
                                                                                                                                        case (true) { -> n; }
                                                                                                                                        default {};
                                                                                                                                    };
                                                                                                                                    n.text = g"this\0";
                                                                                                                                    this.advance();
                                                                                                                                    -> n;
                                                                                                                                }
                                                                                                                                    default
                                                                                                                                    {
                                                                                                                                        switch (c == TokenType.NO_INIT)
                                                                                                                                        {
                                                                                                                                            case (true) {
                                                                                                                                            this.advance();
                                                                                                                                            -> this.mk(NodeKind.NO_INIT, line, col);
                                                                                                                                        }
                                                                                                                                            default
                                                                                                                                            {
                                                                                                                                                switch (c == TokenType.LEFT_PAREN)
                                                                                                                                                {
                                                                                                                                                    case (true) {
                                                                                                                                                    this.advance();
                                                                                                                                                    n = this.expression();
                                                                                                                                                    switch (this.failed)
                                                                                                                                                    {
                                                                                                                                                        case (true) { -> n; }
                                                                                                                                                        default {};
                                                                                                                                                    };
                                                                                                                                                    this.consume(TokenType.RIGHT_PAREN);
                                                                                                                                                    -> n;
                                                                                                                                                }
                                                                                                                                                    default
                                                                                                                                                    {
                                                                                                                                                        switch (c == TokenType.LEFT_BRACKET)
                                                                                                                                                        {
                                                                                                                                                            case (true) { -> this.array_literal(); }
                                                                                                                                                            default
                                                                                                                                                            {
                                                                                                                                                                switch (c == TokenType.ELLIPSIS)
                                                                                                                                                                {
                                                                                                                                                                    case (true) {
                                                                                                                                                                    this.advance();
                                                                                                                                                                    switch (this.cur() != TokenType.LEFT_BRACKET)
                                                                                                                                                                    {
                                                                                                                                                                        case (true) {

                                                                                                                                                                            switch (this.vop_sym == (OpSym*)0)
                                                                                                                                                                            {
                                                                                                                                                                                case (true) {
                                                                                                                                                                                    this.error(g"Bare '...' (argument count) is only available inside a variadic operator body\0");
                                                                                                                                                                                    -> (Node*)0;
                                                                                                                                                                                }
                                                                                                                                                                                default {};
                                                                                                                                                                            };
                                                                                                                                                                            n = this.mk(NodeKind.IDENTIFIER, line, col);
                                                                                                                                                                            switch (this.failed)
                                                                                                                                                                            {
                                                                                                                                                                                case (true) { -> n; }
                                                                                                                                                                                default {};
                                                                                                                                                                            };
                                                                                                                                                                            n.text = g"__op_argc\0";
                                                                                                                                                                            -> n;
                                                                                                                                                                        }
                                                                                                                                                                        default {};
                                                                                                                                                                    };
                                                                                                                                                                                                                                                                                                                                        switch (!this.consume(TokenType.LEFT_BRACKET))
                                                                                                                                                                    {
                                                                                                                                                                        case (true) { -> (Node*)0; }
                                                                                                                                                                        default {};
                                                                                                                                                                    };
                                                                                                                                                                    Node* ix = this.expression();
                                                                                                                                                                    switch (this.failed)
                                                                                                                                                                    {
                                                                                                                                                                        case (true) { -> ix; }
                                                                                                                                                                        default {};
                                                                                                                                                                    };
                                                                                                                                                                    switch (!this.consume(TokenType.RIGHT_BRACKET))
                                                                                                                                                                    {
                                                                                                                                                                        case (true) { -> ix; }
                                                                                                                                                                        default {};
                                                                                                                                                                    };
                                                                                                                                                                    n = this.mk(NodeKind.VARIADIC_ACCESS, line, col);
                                                                                                                                                                    switch (this.failed)
                                                                                                                                                                    {
                                                                                                                                                                        case (true) { -> ix; }
                                                                                                                                                                        default {};
                                                                                                                                                                    };
                                                                                                                                                                    n.a = ix;
                                                                                                                                                                    -> n;
                                                                                                                                                                }
                                                                                                                                                                    default
                                                                                                                                                                    {
                                                                                                                                                                        switch (c == TokenType.DICT_LITERAL)
                                                                                                                                                                        {
                                                                                                                                                                            case (true) { -> this.dict_literal(); }
                                                                                                                                                                            default
                                                                                                                                                                            {
                                                                                                                                                                                switch (c == TokenType.LEFT_BRACE)
                                                                                                                                                                                {
                                                                                                                                                                                    case (true) { -> this.struct_literal(); }
                                                                                                                                                                                    default
                                                                                                                                                                                    {
                                                                                                                                                                                        switch (c == TokenType.SIZEOF)
                                                                                                                                                                                        {
                                                                                                                                                                                            case (true) { -> this.type_query(NodeKind.SIZE_OF, c); }
                                                                                                                                                                                            default
                                                                                                                                                                                            {
                                                                                                                                                                                                switch (c == TokenType.ALIGNOF)
                                                                                                                                                                                                {
                                                                                                                                                                                                    case (true) { -> this.type_query(NodeKind.ALIGN_OF, c); }
                                                                                                                                                                                                    default
                                                                                                                                                                                                    {
                                                                                                                                                                                                        switch (c == TokenType.ENDIANOF)
                                                                                                                                                                                                        {
                                                                                                                                                                                                            case (true) { -> this.type_query(NodeKind.ENDIAN_OF, c); }
                                                                                                                                                                                                            default
                                                                                                                                                                                                            {
                                                                                                                                                                                                                switch (c == TokenType.TYPEOF)
                                                                                                                                                                                                                {
                                                                                                                                                                                                                    case (true) { -> this.type_query(NodeKind.TYPE_OF, c); }
                                                                                                                                                                                                                    default
                                                                                                                                                                                                                    {
                                                                                                                                                                                                                        switch (c == TokenType.STRUCT | c == TokenType.OBJECT)
                                                                                                                                                                                                                        {
                                                                                                                                                                                                                            case (true) {
                                                                                                                                                                                                                            this.advance();
                                                                                                                                                                                                                            switch (c)
                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                case (TokenType.STRUCT)
                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                    n = this.lit(DataType.STRUCT, 0, line, col);
                                                                                                                                                                                                                                    switch (!this.failed)
                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                        case (true) { n.text = g"struct\0"; }
                                                                                                                                                                                                                                        default {};
                                                                                                                                                                                                                                    };
                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                default
                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                    n = this.lit(DataType.OBJECT, 0, line, col);
                                                                                                                                                                                                                                    switch (!this.failed)
                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                        case (true) { n.text = g"object\0"; }
                                                                                                                                                                                                                                        default {};
                                                                                                                                                                                                                                    };
                                                                                                                                                                                                                                };
                                                                                                                                                                                                                            };
                                                                                                                                                                                                                            -> n;
                                                                                                                                                                                                                        }
                                                                                                                                                                                                                            default
                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                switch (c == TokenType.STRINGIFY)
                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                    case (true) { -> this.stringify_expr(); }
                                                                                                                                                                                                                                    default
                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                        switch (c == TokenType.CODIFY)
                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                            case (true) {

                                                                                                                                                                                                                                            this.advance();
                                                                                                                                                                                                                                            switch (this.expect(TokenType.F_STRING))
                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                case (true) {
                                                                                                                                                                                                                                                n = this.f_string_node();
                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                default {
                                                                                                                                                                                                                                                    switch (this.expect(TokenType.I_STRING))
                                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                                        case (true) {
                                                                                                                                                                                                                                                n = this.i_string_node();
                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                        default {
                                                                                                                                                                                                                                                byte* cname = this.ident();
                                                                                                                                                                                                                                                switch (this.failed)
                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                    case (true) { -> (Node*)0; }
                                                                                                                                                                                                                                                    default {};
                                                                                                                                                                                                                                                };
                                                                                                                                                                                                                                                byte* cval = (byte*)nm_get(this.cstrs, cname);
                                                                                                                                                                                                                                                switch (cval == (byte*)0)
                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                    case (true) { cval = cname; }
                                                                                                                                                                                                                                                    default {};
                                                                                                                                                                                                                                                };
                                                                                                                                                                                                                                                n = this.mk(NodeKind.STRING_LITERAL, line, col);
                                                                                                                                                                                                                                                switch (this.failed)
                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                    case (true) { -> n; }
                                                                                                                                                                                                                                                    default {};
                                                                                                                                                                                                                                                };
                                                                                                                                                                                                                                                n.text = cval;
                                                                                                                                                                                                                                                n.op = -1;
                                                                                                                                                                                                                                            };
                                                                                                                                                                                                                                                    };
                                                                                                                                                                                                                                                };
                                                                                                                                                                                                                                            };
                                                                                                                                                                                                                                            switch (this.failed)
                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                case (true) { -> (Node*)0; }
                                                                                                                                                                                                                                                default {};
                                                                                                                                                                                                                                            };
                                                                                                                                                                                                                                            n.line = line;
                                                                                                                                                                                                                                            n.col = col;
                                                                                                                                                                                                                                            -> n;
                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                            default
                                                                                                                                                                                                                                            {

                                                                                                                                                                                                                                                int dt = -1;
                                                                                                                                                                                                                                                switch (c)
                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                    case (TokenType.SINT) { dt = DataType.SINT; }
                                                                                                                                                                                                                                                    case (TokenType.UINT) { dt = DataType.UINT; }
                                                                                                                                                                                                                                                    case (TokenType.FLOAT_KW) { dt = DataType.FLOAT; }
                                                                                                                                                                                                                                                    case (TokenType.DOUBLE_KW) { dt = DataType.DOUBLE; }
                                                                                                                                                                                                                                                    case (TokenType.BYTE) { dt = DataType.BYTE; }
                                                                                                                                                                                                                                                    case (TokenType.BOOL_KW) { dt = DataType.BOOL; }
                                                                                                                                                                                                                                                    case (TokenType.SLONG) { dt = DataType.SLONG; }
                                                                                                                                                                                                                                                    case (TokenType.ULONG) { dt = DataType.ULONG; }
                                                                                                                                                                                                                                                    default {};
                                                                                                                                                                                                                                                };
                                                                                                                                                                                                                                                switch (dt >= 0)
                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                    case (true) {
                                                                                                                                                                                                                                                    this.advance();
                                                                                                                                                                                                                                                    switch (this.expect(TokenType.LEFT_PAREN))
                                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                                        case (true) {
                                                                                                                                                                                                                                                        this.advance();
                                                                                                                                                                                                                                                        Node* inner = this.expression();
                                                                                                                                                                                                                                                        switch (this.failed)
                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                            case (true) { -> inner; }
                                                                                                                                                                                                                                                            default {};
                                                                                                                                                                                                                                                        };
                                                                                                                                                                                                                                                        switch (!this.consume(TokenType.RIGHT_PAREN))
                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                            case (true) { -> inner; }
                                                                                                                                                                                                                                                            default {};
                                                                                                                                                                                                                                                        };
                                                                                                                                                                                                                                                        n = this.mk(NodeKind.TYPE_CONVERT_EXPRESSION, line, col);
                                                                                                                                                                                                                                                        switch (this.failed)
                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                            case (true) { -> inner; }
                                                                                                                                                                                                                                                            default {};
                                                                                                                                                                                                                                                        };
                                                                                                                                                                                                                                                        TypeSpec* tt = typespec_new();
                                                                                                                                                                                                                                                        tt.base_type = dt;
                                                                                                                                                                                                                                                        n.ts = tt;
                                                                                                                                                                                                                                                        n.a = inner;
                                                                                                                                                                                                                                                        -> n;
                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                        default {};
                                                                                                                                                                                                                                                    };
                                                                                                                                                                                                                                                    this.pos = this.pos - 1;
                                                                                                                                                                                                                                                    this.error_unexpected();
                                                                                                                                                                                                                                                    -> (Node*)0;
                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                    default
                                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                                        this.error_unexpected();
                                                                                                                                                                                                                                                        -> (Node*)0;
                                                                                                                                                                                                                                                    };
                                                                                                                                                                                                                                                };
                                                                                                                                                                                                                                            };
                                                                                                                                                                                                                                        };
                                                                                                                                                                                                                                    };
                                                                                                                                                                                                                                };
                                                                                                                                                                                                                            };
                                                                                                                                                                                                                        };
                                                                                                                                                                                                                    };
                                                                                                                                                                                                                };
                                                                                                                                                                                                            };
                                                                                                                                                                                                        };
                                                                                                                                                                                                    };
                                                                                                                                                                                                };
                                                                                                                                                                                            };
                                                                                                                                                                                        };
                                                                                                                                                                                    };
                                                                                                                                                                                };
                                                                                                                                                                            };
                                                                                                                                                                        };
                                                                                                                                                                    };
                                                                                                                                                                };
                                                                                                                                                            };
                                                                                                                                                        };
                                                                                                                                                    };
                                                                                                                                                };
                                                                                                                                            };
                                                                                                                                        };
                                                                                                                                    };
                                                                                                                                };
                                                                                                                            };
                                                                                                                        };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };




            assign_stmt(Node* lvalue, Node* value, int line, int col) -> Node*
            {
                Node* a = this.mk(NodeKind.ASSIGNMENT, line, col);
                switch (this.failed)
                {
                    case (true) { -> a; }
                    default
                    {
                        a.a = lvalue;
                        a.b = value;
                        Node* s = this.mk(NodeKind.EXPRESSION_STATEMENT, line, col);
                        switch (this.failed)
                        {
                            case (true) { -> s; }
                            default
                            {
                                s.a = a;
                                -> s;
                            };
                        };
                    };
                };
            };


            array_assign_block(Node* base) -> void
            {
                switch (!this.consume(TokenType.LEFT_BRACE))
                {
                    case (true) { ->; }
                    default
                    {
                        int line, col;
                        Node* ix;
                        Node* rv;
                        Node* acc;
                        while (!this.expect(TokenType.RIGHT_BRACE))
                        {
                            switch (!this.expect(TokenType.LEFT_BRACKET))
                            {
                                case (true) {
                                this.error_exp(g"only index-assignment items '[idx] = val;' are legal inside an array-assign block; expected '[' or '}'\0", TokenType.LEFT_BRACKET);
                                ->;
                            }
                                default
                                {
                                    line = this.cur_line();
                                    col = this.cur_col();
                                    this.advance();
                                    ix = this.expression();
                                    switch (this.failed)
                                    {
                                        case (true) { ->; }
                                        default
                                        {
                                            switch (!this.consume(TokenType.RIGHT_BRACKET))
                                            {
                                                case (true) { ->; }
                                                default
                                                {
                                                    acc = this.mk(NodeKind.ARRAY_ACCESS, line, col);
                                                    switch (this.failed)
                                                    {
                                                        case (true) { ->; }
                                                        default
                                                        {
                                                            acc.a = node_clone(base);
                                                            acc.b = ix;
                                                            switch (!this.consume(TokenType.ASSIGN))
                                                            {
                                                                case (true) { ->; }
                                                                default
                                                                {
                                                                    rv = this.expression();
                                                                    switch (this.failed)
                                                                    {
                                                                        case (true) { ->; }
                                                                        default
                                                                        {
                                                                            switch (!this.consume(TokenType.SEMICOLON))
                                                                            {
                                                                                case (true) { ->; }
                                                                                default
                                                                                {
                                                                                    nv_push(this.block_out, this.assign_stmt(acc, rv, line, col));
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        this.consume(TokenType.RIGHT_BRACE);
                        ->;
                    };
                };
            };


            member_assign_block(Node* base) -> void
            {
                switch (!this.consume(TokenType.LEFT_BRACE))
                {
                    case (true) { ->; }
                    default
                    {
                        int line, col;
                        Node* mem;
                        Node* lv;
                        Node* rv;
                        Node* es;
                        while (!this.expect(TokenType.RIGHT_BRACE))
                        {
                            switch (!this.expect(TokenType.DOT))
                            {
                                case (true) {
                                this.error_exp(g"declarations and non-member statements are illegal inside a member-assign block; expected '.' or '}'\0", TokenType.DOT);
                                ->;
                            }
                                default
                                {
                                    line = this.cur_line();
                                    col = this.cur_col();
                                    this.advance();
                                    switch (!this.expect(TokenType.IDENTIFIER))
                                    {
                                        case (true) {
                                        -> this.fail_expected(TokenType.IDENTIFIER);
                                    }
                                        default
                                        {
                                            mem = this.mk(NodeKind.MEMBER_ACCESS, line, col);
                                            switch (this.failed)
                                            {
                                                case (true) { ->; }
                                                default
                                                {
                                                    mem.a = node_clone(base);
                                                    mem.text = this.cur_value();
                                                    this.advance();
                                                    switch (this.expect(TokenType.LEFT_BRACE))
                                                    {
                                                        case (true) {
                                                        switch (this.type_at(1) == TokenType.LEFT_BRACKET)
                                                        {
                                                            case (true) { this.array_assign_block(mem); }
                                                            default { this.member_assign_block(mem); };
                                                        };
                                                        switch (this.failed)
                                                        {
                                                            case (true) { ->; }
                                                            default
                                                            {
                                                                switch (!this.consume(TokenType.SEMICOLON))
                                                                {
                                                                    case (true) { ->; }
                                                                    default
                                                                    {
                                                                        node_free(mem);
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    }
                                                        default {

                                                        lv = this.postfix_from(mem);
                                                        switch (this.failed)
                                                        {
                                                            case (true) { ->; }
                                                            default
                                                            {
                                                                switch (this.expect(TokenType.LEFT_BRACE))
                                                                {
                                                                    case (true) {
                                                                    switch (lv.kind != NodeKind.ARRAY_ACCESS & this.type_at(1) == TokenType.LEFT_BRACKET)
                                                                    {
                                                                        case (true) { this.array_assign_block(lv); }
                                                                        default { this.member_assign_block(lv); };
                                                                    };
                                                                    switch (this.failed)
                                                                    {
                                                                        case (true) { ->; }
                                                                        default
                                                                        {
                                                                            switch (!this.consume(TokenType.SEMICOLON))
                                                                            {
                                                                                case (true) { ->; }
                                                                                default
                                                                                {
                                                                                    node_free(lv);
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                }
                                                                    default {
                                                                        switch (this.expect(TokenType.ASSIGN))
                                                                        {
                                                                            case (true) {
                                                                    this.advance();
                                                                    rv = this.expression();
                                                                    switch (this.failed)
                                                                    {
                                                                        case (true) { ->; }
                                                                        default
                                                                        {
                                                                            switch (!this.consume(TokenType.SEMICOLON))
                                                                            {
                                                                                case (true) { ->; }
                                                                                default
                                                                                {
                                                                                    nv_push(this.block_out, this.assign_stmt(lv, rv, line, col));
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                }
                                                                            default {

                                                                    switch (!this.consume(TokenType.SEMICOLON))
                                                                    {
                                                                        case (true) { ->; }
                                                                        default
                                                                        {
                                                                            es = this.mk(NodeKind.EXPRESSION_STATEMENT, line, col);
                                                                            switch (this.failed)
                                                                            {
                                                                                case (true) { ->; }
                                                                                default
                                                                                {
                                                                                    es.a = lv;
                                                                                    nv_push(this.block_out, es);
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        this.consume(TokenType.RIGHT_BRACE);
                        ->;
                    };
                };
            };


            expression_statement() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* expr = this.expression();
                switch (this.failed)
                {
                    case (true) { -> expr; }
                    default
                    {
                        int k = expr.kind;
                        Node* s;
                        switch (this.expect(TokenType.LEFT_BRACE) &
                            (k == NodeKind.IDENTIFIER | k == NodeKind.ARRAY_ACCESS | k == NodeKind.MEMBER_ACCESS))
                        {
                            case (true) {
                            this.block_out = nv_new();
                            switch (this.type_at(1) == TokenType.LEFT_BRACKET)
                            {
                                case (true) { this.array_assign_block(expr); }
                                default { this.member_assign_block(expr); };
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.SEMICOLON); }
                                default {};
                            };
                            this.last_call = (Node*)0;
                            NodeVec* out = this.block_out;
                            this.block_out = (NodeVec*)0;
                            node_free(expr);
                            switch (this.failed)
                            {
                                case (true) {
                                nv_free(out);
                                -> (Node*)0;
                            }
                                default {};
                            };
                            switch (out.len == 0)
                            {
                                case (true) {
                                nv_free(out);
                                -> (Node*)0;
                            }
                                default {};
                            };
                            s = out.items[0];
                            int j = 1;
                            while (j < out.len)
                            {
                                nv_push(this.pending, out.items[j]);
                                j++;
                            };
                            out.len = 0;
                            nv_free(out);
                            -> s;
                        }
                            default
                            {
                                switch (!this.consume(TokenType.SEMICOLON))
                                {
                                    case (true) { -> expr; }
                                    default
                                    {
                                        s = this.mk(NodeKind.EXPRESSION_STATEMENT, line, col);
                                        switch (this.failed)
                                        {
                                            case (true) { -> s; }
                                            default
                                            {
                                                s.a = expr;
                                                switch (k)
                                                {
                                                    case (NodeKind.FUNCTION_CALL) { this.last_call = expr; }
                                                    default { this.last_call = (Node*)0; };
                                                };
                                                -> s;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            ident() -> byte*
            {
                switch (!this.expect(TokenType.IDENTIFIER))
                {
                    case (true) {
                    this.fail_expected(TokenType.IDENTIFIER);
                    -> (byte*)0;
                }
                    default
                    {
                        byte* v = this.cur_value();
                        this.advance();
                        -> v;
                    };
                };
            };


            ident_msg(byte* msg) -> byte*
            {
                switch (!this.expect(TokenType.IDENTIFIER))
                {
                    case (true) {
                    this.fail_expected_msg(msg, TokenType.IDENTIFIER);
                    -> (byte*)0;
                }
                    default
                    {
                        byte* v = this.cur_value();
                        this.advance();
                        -> v;
                    };
                };
            };

            define_var(byte* name, TypeSpec* ts) -> void
            {
                switch (this.st != (IDKC_SYMTABLE*)0)
                {
                    case (true) {
                    st_define(this.st, name, SymbolKind.VARIABLE, ts, (Node*)0);
                }
                    default {};
                };
                ->;
            };

            define_type(byte* name, TypeSpec* ts) -> void
            {
                switch (this.st != (IDKC_SYMTABLE*)0)
                {
                    case (true) {
                    st_define(this.st, name, SymbolKind.TYPE, ts, (Node*)0);
                    switch ((ts.flags `& 256) != 0)
                    {
                        case (true) { st_mark_nofunc(this.st, name); }
                        default {};
                    };
                }
                    default {};
                };
                ->;
            };


            warn_here(byte* msg) -> void
            {
                Buf wb;
                wb.__init();
                defer wb.__exit();
                Buf mb;
                mb.__init();
                defer mb.__exit();
                mb.put_str(g"Warning: \0");
                mb.put_str(msg);
                IDEKA::errors::render(@wb, this.diag_color, IDEKA::errors::SEV_WARNING, mb.mem, this.cur_line(), this.cur_col(), this.lx.src, this.lx.length, this.lmap, this.lmapn, this.lfiles, -1, 0, 0, 0, (byte*)0);
                -> println(wb.mem);
            };


            decl_loop_warning() -> void
            {
                switch (this.loop_depth > 0 & !this.in_for_init)
                {
                    case (true) {
                    bool sing = this.expect(TokenType.SINGINIT) | this.type_at(1) == TokenType.SINGINIT;
                    switch (!sing)
                    {
                        case (true) {
                        this.warn_here(g"variable declaration inside a loop body - this will continually allocate new slots on the stack each iteration.\0");
                    }
                        default {};
                    };
                }
                    default {};
                };
                ->;
            };


            literal_type_from(Node* init, TypeSpec* ts) -> void
            {
                switch (init == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (init.kind == NodeKind.STRUCT_LITERAL & init.text == (byte*)0 & ts.custom_typename != (byte*)0)
                        {
                            case (true) {
                            init.text = ts.custom_typename;
                        }
                            default {};
                        };
                        ->;
                    };
                };
            };


            decl_abort(TypeSpec* ts, PtrVec* inits, NodeVec* out) -> Node*
            {
                int i;
                switch (ts != (TypeSpec*)0)
                {
                    case (true) { typespec_free(ts); }
                    default {};
                };
                switch (inits != (PtrVec*)0)
                {
                    case (true) {
                    while (i < inits.len)
                    {
                        switch (inits.items[i] != (void*)0)
                        {
                            case (true) { node_free((Node*)inits.items[i]); }
                            default {};
                        };
                        i++;
                    };
                    pv_free(inits);
                }
                    default {};
                };
                switch (out != (NodeVec*)0)
                {
                    case (true) {
                    i = 0;
                    while (i < out.len)
                    {
                        node_free(out.items[i]);
                        i++;
                    };
                    nv_free(out);
                }
                    default {};
                };
                -> (Node*)0;
            };


            decl_flatten(NodeVec* out) -> Node*
            {
                Node* first = (Node*)0;
                switch (out.len > 0)
                {
                    case (true) { first = out.items[0]; }
                    default {};
                };
                int j = 1;
                while (j < out.len)
                {
                    nv_push(this.pending, out.items[j]);
                    j++;
                };
                out.len = 0;
                nv_free(out);
                -> first;
            };


            var_decl_node(byte* name, TypeSpec* ts, Node* init, int line, int col, bool first) -> Node*
            {
                Node* d = this.mk(NodeKind.VARIABLE_DECLARATION, line, col);
                switch (this.failed)
                {
                    case (true) { -> d; }
                    default
                    {
                        d.text = name;
                        switch (first)
                        {
                            case (true) { d.ts = ts; }
                            default { d.ts = typespec_copy(ts); };
                        };
                        d.a = init;
                        switch (ts.storage_class == StorageClass.GLOBAL)
                        {
                            case (true) { d.flags = 4; }
                            default {};
                        };
                        -> d;
                    };
                };
            };

            type_decl_node(byte* name, TypeSpec* ts, Node* init, int line, int col, bool first) -> Node*
            {
                Node* d = this.mk(NodeKind.TYPE_DECLARATION, line, col);
                switch (this.failed)
                {
                    case (true) { -> d; }
                    default
                    {
                        d.text = name;
                        switch (first)
                        {
                            case (true) { d.ts = ts; }
                            default { d.ts = typespec_copy(ts); };
                        };
                        d.a = init;
                        -> d;
                    };
                };
            };


            dict_text(TypeSpec* t) -> byte*
            {
                switch (t == (TypeSpec*)0)
                {
                    case (true) { -> g"unknown\0"; }
                    default
                    {
                        this.sb.len = 0;
                        this.sb.mem[0] = (byte)0;
                        switch (t.custom_typename != (byte*)0)
                        {
                            case (true) { this.sb.put_str(t.custom_typename); }
                            default { this.sb.put_str(datatype_text(t.base_type)); };
                        };
                        int i;
                        while (i < t.pointer_depth)
                        {
                            this.sb.put_str(g"*\0");
                            i++;
                        };
                        -> this.own_n(this.sb.mem, this.sb.len);
                    };
                };
            };

            dict_sig(TypeSpec* t) -> byte*
            {
                byte* s = this.cat2(g"dict{\0", this.dict_text(t.dict_key));
                s = this.cat2(s, g":\0");
                s = this.cat2(s, this.dict_text(t.dict_value));
                -> this.cat2(s, g"}\0");
            };

            dict_same(TypeSpec* a, TypeSpec* b) -> bool
            {
                switch (!cstr_eq(this.dict_text(a.dict_key), this.dict_text(b.dict_key)))
                {
                    case (true) { -> false; }
                    default
                    {
                        -> cstr_eq(this.dict_text(a.dict_value), this.dict_text(b.dict_value));
                    };
                };
            };


            check_dict_init(TypeSpec* ts, Node* init) -> void
            {
                switch (this.st == (IDKC_SYMTABLE*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        PtrVec* ops = pv_new();
                        PtrVec* todo = pv_new();
                        pv_push(todo, (void*)init);
                        Node* e;
                        byte* nm;
                        IDKC_SYMENTRY* ent;
                        TypeSpec* et;
                        while (todo.len > 0)
                        {
                            todo.len--;
                            e = (Node*)todo.items[todo.len];
                            switch (e == (Node*)0)
                            {
                                case (true) { continue; }
                                default
                                {
                                    nm = (byte*)0;
                                    switch (e.kind == NodeKind.BINARY_OP)
                                    {
                                        case (true) {
                                        pv_push(todo, (void*)e.a);
                                        pv_push(todo, (void*)e.b);
                                    }
                                        default {
                                            switch (e.kind == NodeKind.IDENTIFIER | e.kind == NodeKind.FUNCTION_CALL | e.kind == NodeKind.STRINGIFY)
                                            {
                                                case (true) {
                                        nm = e.text;
                                    }
                                                default {};
                                            };
                                        };
                                    };
                                    switch (nm != (byte*)0)
                                    {
                                        case (true) {
                                        ent = st_lookup_variable(this.st, nm, (byte*)0);
                                        switch (ent != (IDKC_SYMENTRY*)0)
                                        {
                                            case (true) {
                                            et = (TypeSpec*)ent.ts;
                                            switch (et != (TypeSpec*)0)
                                            {
                                                case (true) {
                                                switch (et.base_type == DataType.DICT)
                                                {
                                                    case (true) { pv_push(ops, (void*)et); }
                                                    default {};
                                                };
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                };
                            };
                        };
                        int i = 1;
                        TypeSpec* ref;
                        TypeSpec* ots;
                        switch (ops.len > 1)
                        {
                            case (true) {
                            ref = (TypeSpec*)ops.items[0];
                            while (i < ops.len)
                            {
                                ots = (TypeSpec*)ops.items[i];
                                switch (!this.dict_same(ots, ref))
                                {
                                    case (true) {
                                    this.error(this.cat2(this.cat2(this.cat2(g"Dict operands are incompatible: \0", this.dict_sig(ref)),
                                                                   g" cannot be combined with \0"), this.dict_sig(ots)));
                                    pv_free(ops);
                                    -> pv_free(todo);
                                }
                                    default
                                    {
                                        i++;
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        switch (ops.len > 0)
                        {
                            case (true) {
                            ref = (TypeSpec*)ops.items[0];
                            switch (!this.dict_same(ts, ref))
                            {
                                case (true) {
                                this.error(this.cat2(this.cat2(this.cat2(g"Dict type mismatch: declared \0", this.dict_sig(ts)),
                                                               g" is incompatible with \0"), this.dict_sig(ref)));
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                        pv_free(ops);
                        -> pv_free(todo);
                    };
                };
            };





            variable_declaration() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                this.decl_loop_warning();
                byte* raw = (byte*)0;
                switch (this.expect(TokenType.IDENTIFIER))
                {
                    case (true) { raw = this.cur_value(); }
                    default {};
                };
                TypeSpec* ts = this.type_spec();
                switch (this.failed)
                {
                    case (true) { -> this.decl_abort(ts, (PtrVec*)0, (NodeVec*)0); }
                    default
                    {
                        NodeVec* out = nv_new();
                        Node* init;
                        Node* d;
                        byte* name;


                        switch (this.expect(TokenType.AS))
                        {
                            case (true) {
                            this.advance();
                            name = this.ident();
                            switch (this.failed)
                            {
                                case (true) { -> this.decl_abort(ts, (PtrVec*)0, out); }
                                default {};
                            };
                            this.define_type(name, ts);
                            init = (Node*)0;
                            switch (this.expect(TokenType.ASSIGN))
                            {
                                case (true) {
                                this.advance();
                                init = this.expression();
                                switch (this.failed)
                                {
                                    case (true) { -> this.decl_abort(ts, (PtrVec*)0, out); }
                                    default {};
                                };
                                switch (init.kind == NodeKind.STRUCT_LITERAL & init.text == (byte*)0 & ts.custom_typename == (byte*)0)
                                {
                                    case (true) {
                                    node_free(init);
                                    this.error(g"Struct literal initialization requires a custom type\0");
                                    -> this.decl_abort(ts, (PtrVec*)0, out);
                                }
                                    default {};
                                };
                                this.literal_type_from(init, ts);
                            }
                                default {};
                            };
                            d = this.type_decl_node(name, ts, init, line, col, true);
                            switch (this.failed)
                            {
                                case (true) { -> this.decl_abort((TypeSpec*)0, (PtrVec*)0, out); }
                                default {};
                            };
                            nv_push(out, d);
                            while (this.expect(TokenType.COMMA))
                            {
                                this.advance();
                                name = this.ident();
                                switch (this.failed)
                                {
                                    case (true) { -> this.decl_abort((TypeSpec*)0, (PtrVec*)0, out); }
                                    default {};
                                };
                                this.define_type(name, ts);
                                init = (Node*)0;
                                switch (this.expect(TokenType.ASSIGN))
                                {
                                    case (true) {
                                    this.advance();
                                    init = this.expression();
                                    switch (this.failed)
                                    {
                                        case (true) { -> this.decl_abort((TypeSpec*)0, (PtrVec*)0, out); }
                                        default {};
                                    };
                                    switch (init.kind == NodeKind.STRUCT_LITERAL & init.text == (byte*)0 & ts.custom_typename == (byte*)0)
                                    {
                                        case (true) {
                                        node_free(init);
                                        this.error(g"Struct literal initialization requires a custom type\0");
                                        -> this.decl_abort((TypeSpec*)0, (PtrVec*)0, out);
                                    }
                                        default {};
                                    };
                                    this.literal_type_from(init, ts);
                                }
                                    default {};
                                };
                                d = this.type_decl_node(name, ts, init, line, col, false);
                                switch (this.failed)
                                {
                                    case (true) { -> this.decl_abort((TypeSpec*)0, (PtrVec*)0, out); }
                                    default {};
                                };
                                nv_push(out, d);
                            };
                            -> this.decl_flatten(out);
                        }
                            default
                            {

                                nv_free(out);
                                out = (NodeVec*)0;
                                name = this.ident();
                                switch (this.failed)
                                {
                                    case (true) { -> this.decl_abort(ts, (PtrVec*)0, (NodeVec*)0); }
                                    default
                                    {
                                        this.define_var(name, ts);

                                        Node* call;
                                        Node* holder;
                                        switch (this.expect(TokenType.LEFT_PAREN))
                                        {
                                            case (true) {
                                            this.advance();
                                            holder = this.mk(NodeKind.NODE_LIST, line, col);
                                            switch (this.failed)
                                            {
                                                case (true) { -> this.decl_abort(ts, (PtrVec*)0, (NodeVec*)0); }
                                                default {};
                                            };
                                            switch (!this.expect(TokenType.RIGHT_PAREN))
                                            {
                                                case (true) { this.argument_list(holder, (byte*)0); }
                                                default {};
                                            };
                                            switch (!this.failed)
                                            {
                                                case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                                default {};
                                            };
                                            switch (this.failed)
                                            {
                                                case (true) {
                                                node_free(holder);
                                                -> this.decl_abort(ts, (PtrVec*)0, (NodeVec*)0);
                                            }
                                                default {};
                                            };
                                            call = this.mk(NodeKind.FUNCTION_CALL, line, col);
                                            switch (this.failed)
                                            {
                                                case (true) {
                                                node_free(holder);
                                                -> this.decl_abort(ts, (PtrVec*)0, (NodeVec*)0);
                                            }
                                                default {};
                                            };
                                            switch (ts.custom_typename != (byte*)0)
                                            {
                                                case (true) { call.text = this.cat2(ts.custom_typename, g".__init\0"); }
                                                default {
                                                    switch (raw != (byte*)0)
                                                    {
                                                        case (true) { call.text = this.cat2(raw, g".__init\0"); }
                                                        default { call.text = this.cat2(datatype_text(ts.base_type), g"__init\0"); };
                                                    };
                                                };
                                            };
                                            this.take_args(call, holder);
                                            -> this.var_decl_node(name, ts, call, line, col, true);
                                        }
                                            default
                                            {
                                                PtrVec* names = pv_new();
                                                PtrVec* inits = pv_new();
                                                pv_push(names, (void*)name);

                                                Node* rhs;
                                                Node* src;
                                                int al;
                                                int ac;

                                                switch (this.expect(TokenType.ADDRESS_ASSIGN))
                                                {
                                                    case (true) {
                                                    al = this.cur_line();
                                                    ac = this.cur_col();
                                                    this.advance();
                                                    rhs = this.expression();
                                                    switch (this.failed)
                                                    {
                                                        case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                        default
                                                        {
                                                            d = this.mk(NodeKind.ADDRESS_OF, al, ac);
                                                            switch (this.failed)
                                                            {
                                                                case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                                default
                                                                {
                                                                    d.a = rhs;
                                                                    pv_push(inits, (void*)d);
                                                                };
                                                            };
                                                        };
                                                    };
                                                }
                                                    default {
                                                        switch (this.expect(TokenType.FROM))
                                                        {
                                                            case (true) {
                                                    this.advance();
                                                    src = this.expression();
                                                    switch (this.failed)
                                                    {
                                                        case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                        default
                                                        {
                                                            this.literal_type_from(src, ts);
                                                            switch (ts.custom_typename != (byte*)0)
                                                            {
                                                                case (true) {
                                                                d = this.mk(NodeKind.STRUCT_RECAST, line, col);
                                                                switch (this.failed)
                                                                {
                                                                    case (true) { node_free(src); pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                                    default
                                                                    {
                                                                        d.text = ts.custom_typename;
                                                                        d.a = src;

                                                                        switch (this.expect(TokenType.NOT))
                                                                        {
                                                                            case (true) {
                                                                            this.advance();
                                                                            d.ival = 1;
                                                                        }
                                                                            default {};
                                                                        };
                                                                    };
                                                                };
                                                            }
                                                                default {
                                                                d = this.mk(NodeKind.CAST_EXPRESSION, line, col);
                                                                switch (this.failed)
                                                                {
                                                                    case (true) { node_free(src); pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                                    default
                                                                    {
                                                                        d.ts = typespec_copy(ts);
                                                                        d.a = src;
                                                                        d.ival = 1;     
                                                                    };
                                                                };
                                                            };
                                                            };
                                                            pv_push(inits, (void*)d);
                                                        };
                                                    };
                                                }
                                                            default {
                                                                switch (this.expect(TokenType.ASSIGN))
                                                                {
                                                                    case (true) {
                                                    this.advance();
                                                    rhs = this.expression();
                                                    switch (this.failed)
                                                    {
                                                        case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                        default
                                                        {
                                                            switch (ts.base_type == DataType.DICT)
                                                            {
                                                                case (true) {
                                                                this.check_dict_init(ts, rhs);
                                                                switch (this.failed)
                                                                {
                                                                    case (true) {
                                                                    node_free(rhs);
                                                                    pv_free(names);
                                                                    -> this.decl_abort(ts, inits, (NodeVec*)0);
                                                                }
                                                                    default {};
                                                                };
                                                            }
                                                                default {};
                                                            };
                                                            switch (this.ctor_sugar(raw, rhs))
                                                            {
                                                                case (true) {
                                                                call = this.mk(NodeKind.FUNCTION_CALL, line, col);
                                                                switch (this.failed)
                                                                {
                                                                    case (true) {
                                                                    node_free(rhs);
                                                                    pv_free(names);
                                                                    -> this.decl_abort(ts, inits, (NodeVec*)0);
                                                                }
                                                                    default {};
                                                                };
                                                                call.text = this.cat2(raw, g".__init\0");
                                                                node_push(call, 0, rhs);
                                                                pv_free(names);
                                                                pv_free(inits);
                                                                -> this.var_decl_node(name, ts, call, line, col, true);
                                                            }
                                                                default
                                                                {
                                                                    this.note_comptime_string(name, ts, rhs);
                                                                    pv_push(inits, (void*)rhs);
                                                                };
                                                            };
                                                        };
                                                    };
                                                }
                                                                    default {
                                                                        switch (this.expect(TokenType.LEFT_BRACE))
                                                                        {
                                                                            case (true) {
                                                    switch (ts.base_type != DataType.DICT)
                                                    {
                                                        case (true) {
                                                        this.fail_expected_msg(g"Expected ASSIGN, got LEFT_BRACE\0", TokenType.ASSIGN);
                                                        pv_free(names);
                                                        -> this.decl_abort(ts, inits, (NodeVec*)0);
                                                    }
                                                        default
                                                        {

                                                            this.advance();
                                                            d = this.mk(NodeKind.DICT_LITERAL, line, col);
                                                            switch (this.failed)
                                                            {
                                                                case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                                default
                                                                {
                                                                    while (!this.expect(TokenType.RIGHT_BRACE) & !this.expect(TokenType.EOF) & !this.failed)
                                                                    {
                                                                        rhs = this.expression();
                                                                        switch (this.failed)
                                                                        {
                                                                            case (true) { break; }
                                                                            default
                                                                            {
                                                                                node_push(d, 0, rhs);
                                                                                switch (!this.consume(TokenType.COLON))
                                                                                {
                                                                                    case (true) { break; }
                                                                                    default
                                                                                    {
                                                                                        rhs = this.expression();
                                                                                        switch (this.failed)
                                                                                        {
                                                                                            case (true) { break; }
                                                                                            default
                                                                                            {
                                                                                                node_push(d, 0, rhs);
                                                                                                switch (this.expect(TokenType.COMMA))
                                                                                                {
                                                                                                    case (true) { this.advance(); }
                                                                                                    default {};
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                    switch (!this.failed)
                                                                    {
                                                                        case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                                                        default {};
                                                                    };
                                                                    switch (this.failed)
                                                                    {
                                                                        case (true) {
                                                                        node_free(d);
                                                                        pv_free(names);
                                                                        -> this.decl_abort(ts, inits, (NodeVec*)0);
                                                                    }
                                                                        default
                                                                        {
                                                                            ts.dict_capacity = node_count(d, 0) / 2;
                                                                            pv_push(inits, (void*)d);
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                }
                                                                            default {
                                                    pv_push(inits, (void*)0);
                                                };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };

                                                int i, n;
                                                Node* prev;

                                                switch (this.expect(TokenType.COMMA) & inits.items[0] == (void*)0)
                                                {
                                                    case (true) {
                                                    while (this.expect(TokenType.COMMA))
                                                    {
                                                        this.advance();
                                                        name = this.ident();
                                                        switch (this.failed)
                                                        {
                                                            case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                            default
                                                            {
                                                                this.define_var(name, ts);
                                                                pv_push(names, (void*)name);
                                                                switch (this.expect(TokenType.ADDRESS_ASSIGN))
                                                                {
                                                                    case (true) {
                                                                    al = this.cur_line();
                                                                    ac = this.cur_col();
                                                                    this.advance();
                                                                    rhs = this.expression();
                                                                    switch (this.failed)
                                                                    {
                                                                        case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                                        default
                                                                        {
                                                                            d = this.mk(NodeKind.ADDRESS_OF, al, ac);
                                                                            switch (this.failed)
                                                                            {
                                                                                case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                                                default
                                                                                {
                                                                                    d.a = rhs;
                                                                                    pv_push(inits, (void*)d);
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                }
                                                                    default {
                                                                        switch (this.expect(TokenType.ASSIGN))
                                                                        {
                                                                            case (true) {
                                                                    this.advance();
                                                                    switch (this.expect(TokenType.DITTO))
                                                                    {
                                                                        case (true) {
                                                                        prev = (Node*)inits.items[inits.len - 1];
                                                                        switch (prev == (Node*)0)
                                                                        {
                                                                            case (true) {
                                                                            this.error(g"Ditto operator '#\"' used before any initializer to repeat\0");
                                                                            pv_free(names);
                                                                            -> this.decl_abort(ts, inits, (NodeVec*)0);
                                                                        }
                                                                            default
                                                                            {
                                                                                this.advance();
                                                                                pv_push(inits, (void*)node_clone(prev));
                                                                            };
                                                                        };
                                                                    }
                                                                        default {
                                                                        rhs = this.expression();
                                                                        switch (this.failed)
                                                                        {
                                                                            case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                                            default
                                                                            {
                                                                                this.note_comptime_string(name, ts, rhs);
                                                                                pv_push(inits, (void*)rhs);
                                                                            };
                                                                        };
                                                                    };
                                                                    };
                                                                }
                                                                            default {
                                                                    pv_push(inits, (void*)0);
                                                                };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };


                                                    bool all_null = true;
                                                    i = 0;
                                                    while (i < inits.len)
                                                    {
                                                        switch (inits.items[i] != (void*)0)
                                                        {
                                                            case (true) { all_null = false; }
                                                            default {};
                                                        };
                                                        i++;
                                                    };
                                                    switch (all_null)
                                                    {
                                                        case (true) {
                                                        inits.len = 0;
                                                        switch (this.expect(TokenType.FROM))
                                                        {
                                                            case (true) {
                                                            this.advance();
                                                            src = this.expression();
                                                            switch (this.failed)
                                                            {
                                                                case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                                default
                                                                {
                                                                    i = 0;
                                                                    while (i < names.len)
                                                                    {
                                                                        d = this.mk(NodeKind.ARRAY_ACCESS, line, col);
                                                                        switch (this.failed)
                                                                        {
                                                                            case (true) { node_free(src); pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                                            default
                                                                            {
                                                                                switch (i)
                                                                                {
                                                                                    case (0) { d.a = src; }
                                                                                    default { d.a = node_clone(src); };
                                                                                };
                                                                                d.b = this.lit(DataType.SINT, (i64)i, line, col);
                                                                                pv_push(inits, (void*)d);
                                                                                i++;
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        }
                                                            default {
                                                                switch (this.expect(TokenType.ASSIGN))
                                                                {
                                                                    case (true) {
                                                            this.advance();
                                                            i = 0;
                                                            while (i < names.len)
                                                            {
                                                                rhs = this.expression();
                                                                switch (this.failed)
                                                                {
                                                                    case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                                    default
                                                                    {
                                                                        pv_push(inits, (void*)rhs);
                                                                        switch (this.expect(TokenType.COMMA))
                                                                        {
                                                                            case (true) { this.advance(); }
                                                                            default { break; };
                                                                        };
                                                                        i++;
                                                                    };
                                                                };
                                                            };
                                                        }
                                                                    default {};
                                                                };
                                                            };
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {
                                                        switch (this.expect(TokenType.COMMA))
                                                        {
                                                            case (true) {

                                                    while (this.expect(TokenType.COMMA))
                                                    {
                                                        this.advance();
                                                        name = this.ident();
                                                        switch (this.failed)
                                                        {
                                                            case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                            default
                                                            {
                                                                this.define_var(name, ts);
                                                                pv_push(names, (void*)name);
                                                                switch (this.expect(TokenType.ADDRESS_ASSIGN))
                                                                {
                                                                    case (true) {
                                                                    al = this.cur_line();
                                                                    ac = this.cur_col();
                                                                    this.advance();
                                                                    rhs = this.expression();
                                                                    switch (this.failed)
                                                                    {
                                                                        case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                                        default
                                                                        {
                                                                            d = this.mk(NodeKind.ADDRESS_OF, al, ac);
                                                                            switch (this.failed)
                                                                            {
                                                                                case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                                                default
                                                                                {
                                                                                    d.a = rhs;
                                                                                    pv_push(inits, (void*)d);
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                }
                                                                    default {
                                                                        switch (this.expect(TokenType.ASSIGN))
                                                                        {
                                                                            case (true) {
                                                                    this.advance();
                                                                    switch (this.expect(TokenType.DITTO))
                                                                    {
                                                                        case (true) {
                                                                        this.advance();
                                                                        prev = (Node*)inits.items[inits.len - 1];
                                                                        switch (prev == (Node*)0)
                                                                        {
                                                                            case (true) { pv_push(inits, (void*)0); }
                                                                            default { pv_push(inits, (void*)node_clone(prev)); };
                                                                        };
                                                                    }
                                                                        default {
                                                                        rhs = this.expression();
                                                                        switch (this.failed)
                                                                        {
                                                                            case (true) { pv_free(names); -> this.decl_abort(ts, inits, (NodeVec*)0); }
                                                                            default
                                                                            {
                                                                                pv_push(inits, (void*)rhs);
                                                                            };
                                                                        };
                                                                    };
                                                                    };
                                                                }
                                                                            default {
                                                                    pv_push(inits, (void*)0);
                                                                };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                }
                                                            default {};
                                                        };
                                                    };
                                                };


                                                out = nv_new();

                                                PtrVec* fin = pv_new();
                                                int pad = names.len - inits.len;
                                                i = 0;
                                                while (i < pad)
                                                {
                                                    pv_push(fin, (void*)0);
                                                    i++;
                                                };
                                                i = 0;
                                                while (i < inits.len)
                                                {
                                                    pv_push(fin, inits.items[i]);
                                                    i++;
                                                };
                                                pv_free(inits);

                                                n = names.len;
                                                i = 0;
                                                while (i < n)
                                                {
                                                    init = (Node*)0;
                                                    switch (i < fin.len)
                                                    {
                                                        case (true) { init = (Node*)fin.items[i]; }
                                                        default {};
                                                    };
                                                    this.literal_type_from(init, ts);
                                                    d = this.var_decl_node((byte*)names.items[i], ts, init, line, col, i == 0);
                                                    switch (this.failed)
                                                    {
                                                        case (true) {
                                                        pv_free(names);
                                                        pv_free(fin);
                                                        switch (i == 0)
                                                        {
                                                            case (true) { -> this.decl_abort(ts, (PtrVec*)0, out); }
                                                            default {};
                                                        };
                                                        -> this.decl_abort((TypeSpec*)0, (PtrVec*)0, out);
                                                    }
                                                        default
                                                        {
                                                            nv_push(out, d);
                                                            i++;
                                                        };
                                                    };
                                                };
                                                pv_free(names);
                                                pv_free(fin);
                                                -> this.decl_flatten(out);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            variable_declaration_statement() -> Node*
            {
                Node* d = this.variable_declaration();
                switch (this.failed)
                {
                    case (true) { -> d; }
                    default
                    {
                        this.consume(TokenType.SEMICOLON);
                        -> d;
                    };
                };
            };


            dual_assign_declaration() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                TypeSpec* ok_ts = this.type_spec();
                switch (this.failed)
                {
                    case (true) { typespec_free(ok_ts); -> (Node*)0; }
                    default
                    {
                        switch (!this.consume_msg(TokenType.XOR_OP, g"Expected '^|' in dual-assign declaration\0")) { case (true) { typespec_free(ok_ts); -> (Node*)0; }
                            default
                            {
                                TypeSpec* err_ts = this.type_spec();
                                switch (this.failed)
                                {
                                    case (true) { typespec_free(ok_ts); typespec_free(err_ts); -> (Node*)0; }
                                    default
                                    {
                                        byte* ok_name = this.ident_msg(g"Expected success variable name\0");
                                        byte* err_name = (byte*)0;
                                        Node* call;
                                        switch (!this.failed)
                                        {
                                            case (true) {
                                            switch (this.consume_msg(TokenType.COMMA, g"Expected ',' between variable names in dual-assign declaration\0")) { case (true) { err_name = this.ident_msg(g"Expected error variable name\0"); }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        switch (!this.failed)
                                        {
                                            case (true) { this.consume_msg(TokenType.ASSIGN, g"Expected '=' in dual-assign declaration\0"); } default {}; }; switch (!this.failed) { case (true) { call = this.expression();
                                            switch (!this.failed)
                                            {
                                                case (true) { this.consume(TokenType.SEMICOLON); }
                                                default {};
                                            };
                                            switch (this.failed)
                                            {
                                                case (true) {
                                                node_free(call);
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        switch (this.failed)
                                        {
                                            case (true) {
                                            typespec_free(ok_ts);
                                            typespec_free(err_ts);
                                            -> (Node*)0;
                                        }
                                            default
                                            {
                                                this.define_var(ok_name, ok_ts);
                                                this.define_var(err_name, err_ts);
                                                Node* n = this.mk(NodeKind.DUAL_ASSIGN_DECLARATION, line, col);
                                                switch (this.failed)
                                                {
                                                    case (true) {
                                                    typespec_free(ok_ts);
                                                    typespec_free(err_ts);
                                                    node_free(call);
                                                    -> n;
                                                }
                                                    default
                                                    {
                                                        n.ts = ok_ts;
                                                        n.ts2 = err_ts;
                                                        n.text = ok_name;
                                                        n.text2 = err_name;
                                                        n.a = call;
                                                        -> n;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            auto_variable_declaration() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                this.consume(TokenType.AUTO);
                byte* name = (byte*)0;
                Node* init = (Node*)0;
                switch (!this.failed)
                {
                    case (true) { name = this.ident(); }
                    default {};
                };
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.ASSIGN); }
                    default {};
                };
                switch (!this.failed)
                {
                    case (true) { init = this.expression(); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) {
                    node_free(init);
                    -> (Node*)0;
                }
                    default
                    {
                        TypeSpec* ts = typespec_new();
                        switch (ts == (TypeSpec*)0)
                        {
                            case (true) { node_free(init); this.fail_alloc(); -> (Node*)0; }
                            default
                            {
                                ts.base_type = DataType.VOID;
                                ts.storage_class = StorageClass.AUTO;
                                this.define_var(name, ts);
                                Node* d = this.mk(NodeKind.VARIABLE_DECLARATION, line, col);
                                switch (this.failed)
                                {
                                    case (true) {
                                    typespec_free(ts);
                                    node_free(init);
                                    -> d;
                                }
                                    default
                                    {
                                        d.text = name;
                                        d.ts = ts;
                                        d.a = init;
                                        -> d;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            destructuring_assignment() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                this.consume(TokenType.AUTO);
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.LEFT_BRACE); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) { -> (Node*)0; }
                    default
                    {
                        Node* n = this.mk(NodeKind.DESTRUCTURING_ASSIGNMENT, line, col);
                        switch (this.failed)
                        {
                            case (true) { -> n; }
                            default
                            {
                                Node* v;
                                byte* name;
                                TypeSpec* ts;
                                int vl, vc;
                                while (!this.expect(TokenType.RIGHT_BRACE) & !this.expect(TokenType.EOF) & !this.failed)
                                {
                                    switch (this.expect(TokenType.IDENTIFIER))
                                    {
                                        case (true) {
                                        vl = this.cur_line();
                                        vc = this.cur_col();
                                        name = this.cur_value();
                                        this.advance();
                                        switch (this.expect(TokenType.AS))
                                        {
                                            case (true) {
                                            this.advance();
                                            ts = this.type_spec();
                                            switch (this.failed)
                                            {
                                                case (true) { typespec_free(ts); break; }
                                                default
                                                {
                                                    v = this.mk(NodeKind.VARIABLE_DECLARATION, vl, vc);
                                                    switch (this.failed)
                                                    {
                                                        case (true) { typespec_free(ts); break; }
                                                        default
                                                        {
                                                            v.text = name;
                                                            v.ts = ts;
                                                            n.flags = n.flags `| 128;
                                                        };
                                                    };
                                                };
                                            };
                                        }
                                            default {
                                            v = this.mk(NodeKind.IDENTIFIER, vl, vc);
                                            switch (this.failed)
                                            {
                                                case (true) { break; }
                                                default
                                                {
                                                    v.text = name;
                                                };
                                            };
                                        };
                                        };
                                        node_push(n, 0, v);
                                    }
                                        default {};
                                    };
                                    switch (!this.expect(TokenType.RIGHT_BRACE))
                                    {
                                        case (true) {
                                        switch (!this.consume(TokenType.COMMA))
                                        {
                                            case (true) { break; }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                };
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                    default {};
                                };
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.ASSIGN); }
                                    default {};
                                };
                                switch (!this.failed)
                                {
                                    case (true) {
                                    n.a = this.expression();
                                }
                                    default {};
                                };
                                switch (!this.failed)
                                {
                                    case (true) {
                                    switch (this.expect(TokenType.FROM))
                                    {
                                        case (true) {
                                        this.advance();
                                        vl = this.cur_line();
                                        vc = this.cur_col();
                                        name = this.ident();
                                        switch (!this.failed)
                                        {
                                            case (true) {
                                            v = this.mk(NodeKind.IDENTIFIER, vl, vc);
                                            switch (!this.failed)
                                            {
                                                case (true) {
                                                v.text = name;
                                                n.b = v;
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (this.failed)
                                {
                                    case (true) {
                                    node_free(n);
                                    -> (Node*)0;
                                }
                                    default
                                    {
                                        -> n;
                                    };
                                };
                            };
                        };
                    };
                };
            };




            done(Node* n) -> Node*
            {
                switch (this.failed)
                {
                    case (true) {
                    node_free(n);
                    -> (Node*)0;
                }
                    default
                    {
                        -> n;
                    };
                };
            };


            drain_pending(Node* container, int slot) -> void
            {
                int k;
                while (k < this.pending.len)
                {
                    node_push(container, slot, this.pending.items[k]);
                    this.last_stmt = this.pending.items[k];
                    k++;
                };
                this.pending.len = 0;
                ->;
            };


            statements_until_brace(Node* holder) -> void { Node* s; byte* em = this.eof_msg; this.eof_msg = (byte*)0;
                while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                {
                    switch (this.expect(TokenType.EOF))
                    {
                        case (true) {
                        switch (em != (byte*)0) { case (true) { -> this.error(em); } default { -> this.error_unexpected(); }; };
                    }
                        default
                        {
                            s = this.statement();
                            switch (this.failed)
                            {
                                case (true) { ->; }
                                default
                                {
                                    switch (s != (Node*)0)
                                    {
                                        case (true) {
                                        node_push(holder, 0, s);
                                        this.last_stmt = s;
                                    }
                                        default {};
                                    };
                                    this.drain_pending(holder, 0);
                                };
                            };
                        };
                    };
                };
                ->;
            };


            block() -> Node*
            {
                Node* b = this.mk(NodeKind.BLOCK, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> b; }
                    default
                    {
                        this.consume(TokenType.LEFT_BRACE);
                        switch (!this.failed)
                        {
                            case (true) { this.statements_until_brace(b); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.RIGHT_BRACE); }
                            default {};
                        };
                        -> this.done(b);
                    };
                };
            };


            loop_block() -> Node*
            {
                this.loop_depth++;
                Node* b = this.block();
                this.loop_depth--;
                -> b;
            };


            block_statement() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* body = this.block();
                switch (this.failed)
                {
                    case (true) { -> (Node*)0; }
                    default
                    {
                        Node* n;

                        switch (this.expect(TokenType.IF))
                        {
                            case (true) {
                            this.advance();
                            n = this.mk(NodeKind.IF_STATEMENT, line, col);
                            switch (this.failed)
                            {
                                case (true) { node_free(body); -> n; }
                                default {};
                            };
                            n.b = body; this.consume_msg(TokenType.LEFT_PAREN, g"Expected '(' after 'if' in block-if statement\0");
                            switch (!this.failed)
                            {
                                case (true) { n.a = this.expression(); }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume_msg(TokenType.RIGHT_PAREN, g"Expected ')' after condition in block-if statement\0"); } default {}; }; switch (!this.failed & this.expect(TokenType.ELSE))
                            {
                                case (true) {
                                this.advance();
                                n.c = this.block();
                            }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.SEMICOLON); }
                                default {};
                            };
                            -> this.done(n);
                        }
                            default
                            {
                                switch (this.expect(TokenType.LEFT_BRACE))
                                {
                                    case (true) {
                                    node_free(body);
                                    this.error_exp(g"Unexpected block after block statement. Did you mean '{ ... } if (cond);'?\0", TokenType.LEFT_BRACE);
                                    -> (Node*)0;
                                }
                                    default
                                    {
                                        switch (!this.consume(TokenType.SEMICOLON))
                                        {
                                            case (true) {
                                            node_free(body);
                                            -> (Node*)0;
                                        }
                                            default
                                            {
                                                -> body;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            block_or_single_stmt() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                switch (this.expect(TokenType.LEFT_BRACE))
                {
                    case (true) { -> this.block(); }
                    default
                    {
                        Node* b = this.mk(NodeKind.BLOCK, line, col);
                        switch (this.failed)
                        {
                            case (true) { -> b; }
                            default
                            {
                                Node* s;
                                switch (this.expect(TokenType.RETURN_ARROW))
                                {
                                    case (true) {
                                    this.advance();
                                    s = this.mk(NodeKind.RETURN_STATEMENT, line, col);
                                }
                                    default {
                                    s = this.mk(NodeKind.EXPRESSION_STATEMENT, line, col);
                                };
                                };
                                switch (this.failed)
                                {
                                    case (true) { node_free(b); -> s; }
                                    default
                                    {
                                        node_push(b, 0, s);
                                        s.a = this.expression();
                                        -> this.done(b);
                                    };
                                };
                            };
                        };
                    };
                };
            };


            if_statement() -> Node*
            {
                Node* n = this.mk(NodeKind.IF_STATEMENT, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.consume(TokenType.IF);
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.LEFT_PAREN); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { n.a = this.expression(); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.RIGHT_PAREN); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { n.b = this.block_or_single_stmt(); }
                            default {};
                        };

                        Node* c;
                        while (!this.failed & (this.expect(TokenType.ELIF) |
                               (this.expect(TokenType.ELSE) & this.type_at(1) == TokenType.IF)))
                        {
                            switch (this.expect(TokenType.ELIF))
                            {
                                case (true) { this.advance(); }
                                default {
                                this.advance();
                                this.advance();
                            };
                            };
                            this.consume(TokenType.LEFT_PAREN);
                            switch (this.failed)
                            {
                                case (true) { break; }
                                default
                                {
                                    c = this.expression();
                                    switch (this.failed)
                                    {
                                        case (true) { node_free(c); break; }
                                        default
                                        {
                                            node_push(n, 0, c);
                                            this.consume(TokenType.RIGHT_PAREN);
                                            switch (this.failed)
                                            {
                                                case (true) { break; }
                                                default
                                                {
                                                    c = this.block_or_single_stmt();
                                                    switch (this.failed)
                                                    {
                                                        case (true) { node_free(c); break; }
                                                        default
                                                        {
                                                            node_push(n, 1, c);
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };

                        switch (!this.failed & this.expect(TokenType.ELSE))
                        {
                            case (true) {
                            this.advance();
                            n.c = this.block_or_single_stmt();
                        }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        -> this.done(n);
                    };
                };
            };


            while_statement() -> Node*
            {
                Node* n = this.mk(NodeKind.WHILE_LOOP, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.consume(TokenType.WHILE);
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.LEFT_PAREN); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { n.a = this.expression(); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.RIGHT_PAREN); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { n.b = this.loop_block(); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        -> this.done(n);
                    };
                };
            };


            do_while_statement() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                this.consume(TokenType.DO);
                switch (this.failed)
                {
                    case (true) { -> (Node*)0; }
                    default
                    {
                        Node* body = this.loop_block();
                        switch (this.failed)
                        {
                            case (true) { -> (Node*)0; }
                            default
                            {
                                Node* n;
                                switch (this.expect(TokenType.WHILE))
                                {
                                    case (true) {
                                    this.advance();
                                    n = this.mk(NodeKind.DO_WHILE_LOOP, line, col);
                                    switch (this.failed)
                                    {
                                        case (true) { node_free(body); -> n; }
                                        default {};
                                    };
                                    n.b = body;
                                    this.consume(TokenType.LEFT_PAREN);
                                    switch (!this.failed)
                                    {
                                        case (true) { n.a = this.expression(); }
                                        default {};
                                    };
                                    switch (!this.failed)
                                    {
                                        case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                        default {};
                                    };
                                    switch (!this.failed)
                                    {
                                        case (true) { this.consume(TokenType.SEMICOLON); }
                                        default {};
                                    };
                                    -> this.done(n);
                                }
                                    default
                                    {
                                        switch (this.expect(TokenType.SEMICOLON))
                                        {
                                            case (true) {
                                            this.advance();
                                            n = this.mk(NodeKind.DO_LOOP, line, col);
                                            switch (this.failed)
                                            {
                                                case (true) { node_free(body); -> n; }
                                                default {};
                                            };
                                            n.b = body;
                                            -> n;
                                        }
                                            default
                                            {
                                                node_free(body);
                                                this.error_exp(g"Expected 'while' or ';' after do block\0", TokenType.SEMICOLON);
                                                -> (Node*)0;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            is_for_in_plain(bool* destructure) -> bool
            {
                int m = this.mark();
                bool r = false;
                *destructure = false;
                switch (this.expect(TokenType.IDENTIFIER))
                {
                    case (true) {
                    this.advance();
                    while (this.expect(TokenType.COMMA))
                    {
                        this.advance();
                        switch (this.expect(TokenType.IDENTIFIER))
                        {
                            case (true) { this.advance(); }
                            default { break; };
                        };
                    };
                    switch (this.expect(TokenType.IN))
                    {
                        case (true) { r = true; }
                        default {};
                    };
                }
                    default {
                        switch (this.expect(TokenType.AUTO))
                        {
                            case (true) {
                    this.advance();
                    switch (this.expect(TokenType.LEFT_BRACE))
                    {
                        case (true) {
                        this.advance();
                        switch (this.expect(TokenType.IDENTIFIER))
                        {
                            case (true) {
                            this.advance();
                            while (this.expect(TokenType.COMMA))
                            {
                                this.advance();
                                switch (this.expect(TokenType.IDENTIFIER))
                                {
                                    case (true) { this.advance(); }
                                    default { break; };
                                };
                            };
                            switch (this.expect(TokenType.RIGHT_BRACE))
                            {
                                case (true) {
                                this.advance();
                                switch (this.expect(TokenType.IN))
                                {
                                    case (true) {
                                    r = true;
                                    *destructure = true;
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                    }
                        default {
                            switch (this.expect(TokenType.IDENTIFIER))
                            {
                                case (true) {
                        this.advance();
                        switch (this.expect(TokenType.IN))
                        {
                            case (true) {
                            r = true;
                            *destructure = true;
                        }
                            default {};
                        };
                    }
                                default {};
                            };
                        };
                    };
                }
                            default {};
                        };
                    };
                };
                this.reset(m);
                -> r;
            };



            is_for_in(bool* destructure, bool* bit) -> bool
            {
                *bit = false;
                bool r = false;
                switch (this.expect(TokenType.BACKTICK))
                {
                    case (true) {
                        int m = this.mark();
                        this.advance();
                        switch (this.expect(TokenType.IDENTIFIER))
                        {
                            case (true) {
                                this.advance();
                                switch (this.expect(TokenType.IN))
                                {
                                    case (true) { r = true; *bit = true; *destructure = false; }
                                    default {};
                                };
                            }
                            default {};
                        };
                        this.reset(m);
                    }
                    default { r = this.is_for_in_plain(destructure); };
                };
                -> r;
            };


            loop_variable(Node* n) -> void
            {
                int line = this.cur_line();
                int col = this.cur_col();
                byte* name = this.ident();
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        Node* v = this.mk(NodeKind.IDENTIFIER, line, col);
                        switch (this.failed)
                        {
                            case (true) { ->; }
                            default
                            {
                                v.text = name;
                                node_push(n, 0, v);
                                ->;
                            };
                        };
                    };
                };
            };


            for_statement() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                this.consume(TokenType.FOR);
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.LEFT_PAREN); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) { -> (Node*)0; }
                    default
                    {
                        bool destructure;
                        bool bititer;
                        Node* n;
                        switch (this.is_for_in(@destructure, @bititer))
                        {
                            case (true) {
                            n = this.mk(NodeKind.FOR_IN_LOOP, line, col);
                            switch (this.failed)
                            {
                                case (true) { -> n; }
                                default {};
                            };
                            switch (bititer)
                            {
                                case (true) {
                                n.flags = 4194304;
                                this.consume(TokenType.BACKTICK);
                                switch (!this.failed)
                                {
                                    case (true) { this.loop_variable(n); }
                                    default {};
                                };
                            }
                                default {
                            switch (destructure)
                            {
                                case (true) {
                                n.flags = 16;
                                this.consume(TokenType.AUTO);
                                switch (!this.failed & this.expect(TokenType.LEFT_BRACE))
                                {
                                    case (true) {
                                    this.advance();
                                    this.loop_variable(n);
                                    while (!this.failed & this.expect(TokenType.COMMA))
                                    {
                                        this.advance();
                                        this.loop_variable(n);
                                    };
                                    switch (!this.failed)
                                    {
                                        case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                        default {};
                                    };
                                }
                                    default {
                                        switch (!this.failed)
                                        {
                                            case (true) {
                                    this.loop_variable(n);
                                }
                                            default {};
                                        };
                                    };
                                };
                            }
                                default {
                                this.loop_variable(n);
                                while (!this.failed & this.expect(TokenType.COMMA))
                                {
                                    this.advance();
                                    this.loop_variable(n);
                                };
                            };
                            };
                            };
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.IN); }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { n.a = this.expression(); }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { n.b = this.loop_block(); }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.SEMICOLON); }
                                default {};
                            };
                            -> this.done(n);
                        }
                            default
                            {

                                n = this.mk(NodeKind.FOR_LOOP, line, col);
                                switch (this.failed)
                                {
                                    case (true) { -> n; }
                                    default
                                    {
                                        Node* s;
                                        int sl, sc;
                                        switch (!this.expect(TokenType.SEMICOLON))
                                        {
                                            case (true) {
                                            switch (this.is_variable_declaration())
                                            {
                                                case (true) {
                                                this.in_for_init = true;
                                                s = this.variable_declaration();
                                                this.in_for_init = false;
                                                switch (!this.failed)
                                                {
                                                    case (true) {
                                                    switch (this.pending.len > 0)
                                                    {
                                                        case (true) {

                                                        Node* wrap = this.mk(NodeKind.BLOCK, line, col);
                                                        switch (!this.failed)
                                                        {
                                                            case (true) {
                                                            node_push(wrap, 0, s);
                                                            this.drain_pending(wrap, 0);
                                                            n.a = wrap;
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                        default {
                                                        n.a = s;
                                                    };
                                                    };
                                                }
                                                    default {};
                                                };
                                            }
                                                default {
                                                sl = this.cur_line();
                                                sc = this.cur_col();
                                                s = this.mk(NodeKind.EXPRESSION_STATEMENT, sl, sc);
                                                switch (!this.failed)
                                                {
                                                    case (true) {
                                                    s.a = this.expression();
                                                    n.a = s;
                                                }
                                                    default {};
                                                };
                                            };
                                            };
                                        }
                                            default {};
                                        };
                                        switch (!this.failed)
                                        {
                                            case (true) { this.consume(TokenType.SEMICOLON); }
                                            default {};
                                        };
                                        switch (!this.failed & !this.expect(TokenType.SEMICOLON))
                                        {
                                            case (true) { n.b = this.expression(); }
                                            default {};
                                        };
                                        switch (!this.failed)
                                        {
                                            case (true) { this.consume(TokenType.SEMICOLON); }
                                            default {};
                                        };
                                        switch (!this.failed & !this.expect(TokenType.RIGHT_PAREN))
                                        {
                                            case (true) {
                                            sl = this.cur_line();
                                            sc = this.cur_col();
                                            s = this.mk(NodeKind.EXPRESSION_STATEMENT, sl, sc);
                                            switch (!this.failed)
                                            {
                                                case (true) {
                                                s.a = this.expression();
                                                n.c = s;
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        switch (!this.failed)
                                        {
                                            case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                            default {};
                                        };
                                        switch (!this.failed)
                                        {
                                            case (true) { n.d = this.loop_block(); }
                                            default {};
                                        };
                                        switch (!this.failed)
                                        {
                                            case (true) { this.consume(TokenType.SEMICOLON); }
                                            default {};
                                        };
                                        -> this.done(n);
                                    };
                                };
                            };
                        };
                    };
                };
            };


            switch_case() -> Node*
            {
                Node* n = this.mk(NodeKind.CASE, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        switch (this.expect(TokenType.CASE))
                        {
                            case (true) {
                            this.advance();
                            this.consume(TokenType.LEFT_PAREN);
                            switch (!this.failed)
                            {
                                case (true) { n.a = this.expression(); }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { n.b = this.block(); }
                                default {};
                            };
                        }
                            default {
                                switch (this.expect(TokenType.DEFAULT))
                                {
                                    case (true) {
                            this.advance();
                            n.b = this.block();
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.SEMICOLON); }
                                default {};
                            };
                        }
                                    default {
                            this.error_exp(g"Expected 'case' or 'default'\0", TokenType.IDENTIFIER);
                        };
                                };
                            };
                        };
                        -> this.done(n);
                    };
                };
            };


            switch_statement() -> Node*
            {
                int start = this.mark();
                Node* n = this.mk(NodeKind.SWITCH_STATEMENT, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.consume(TokenType.SWITCH);
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.LEFT_PAREN); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { n.a = this.expression(); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.RIGHT_PAREN); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.LEFT_BRACE); }
                            default {};
                        };
                        Node* c;
                        while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                        {
                            switch (this.expect(TokenType.EOF))
                            {
                                case (true) {
                                this.error_exp(g"Expected 'case' or 'default'\0", TokenType.IDENTIFIER); break; } default { c = this.switch_case();
                                    switch (this.failed)
                                    {
                                        case (true) { break; }
                                        default
                                        {
                                            node_push(n, 0, c);
                                        };
                                    };
                                };
                            };
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.RIGHT_BRACE); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        switch (this.failed)
                        {
                            case (true) { -> this.done(n); }
                            default
                            {

                                bool tagged = false;
                                switch (n.a != (Node*)0)
                                {
                                    case (true) {
                                    switch (n.a.kind == NodeKind.MEMBER_ACCESS & n.a.text != (byte*)0)
                                    {
                                        case (true) {
                                        tagged = n.a.text[0] == '#' & n.a.text[1] == 0;
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (!tagged)
                                {
                                    case (true) {
                                    bool has_default = false;
                                    Node* cs;
                                    int i;
                                    int cnt = node_count(n, 0);
                                    while (i < cnt)
                                    {
                                        cs = node_child(n, 0, i);
                                        switch (cs.a == (Node*)0)
                                        {
                                            case (true) { has_default = true; }
                                            default {};
                                        };
                                        i++;
                                    };
                                    switch (!has_default)
                                    {
                                        case (true) {
                                        int here = this.mark();
                                        this.reset(start);
                                        this.error_exp(g"Switch statement requires a default case\0", TokenType.DEFAULT);
                                        this.reset(here);
                                        -> this.done(n);
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                -> n;
                            };
                        };
                    };
                };
            };


            try_statement() -> Node*
            {
                Node* n = this.mk(NodeKind.TRY_BLOCK, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.consume(TokenType.TRY);
                        switch (!this.failed)
                        {
                            case (true) { n.a = this.block(); }
                            default {};
                        };
                        Node* c;
                        while (!this.failed & this.expect(TokenType.CATCH))
                        {
                            c = this.mk(NodeKind.CATCH_CLAUSE, this.cur_line(), this.cur_col());
                            switch (this.failed)
                            {
                                case (true) { break; }
                                default
                                {
                                    node_push(n, 0, c);
                                    this.advance();
                                    this.consume(TokenType.LEFT_PAREN);
                                    switch (this.failed)
                                    {
                                        case (true) { break; }
                                        default
                                        {
                                            switch (this.expect(TokenType.RIGHT_PAREN))
                                            {
                                                case (true) {
                                                this.advance();
                                                c.a = this.block();
                                            }
                                                default {
                                                switch (this.expect(TokenType.AUTO))
                                                {
                                                    case (true) { this.advance(); }
                                                    default { c.ts = this.type_spec(); };
                                                };
                                                switch (this.failed)
                                                {
                                                    case (true) { break; }
                                                    default
                                                    {
                                                        c.text = this.ident();
                                                        switch (!this.failed)
                                                        {
                                                            case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                                            default {};
                                                        };
                                                        switch (!this.failed)
                                                        {
                                                            case (true) { c.a = this.block(); }
                                                            default {};
                                                        };
                                                    };
                                                };
                                            };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        -> this.done(n);
                    };
                };
            };


            return_node(int tok) -> Node*
            {
                Node* n = this.mk(NodeKind.RETURN_STATEMENT, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.consume(tok);
                        switch (!this.failed & !this.expect(TokenType.SEMICOLON))
                        {
                            case (true) { n.a = this.expression(); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        -> this.done(n);
                    };
                };
            };

            return_statement() -> Node* -> this.return_node(TokenType.RETURN);

            return_arrow_ret() -> Node* -> this.return_node(TokenType.RETURN_ARROW);


            error_return_statement() -> Node*
            {
                Node* n = this.mk(NodeKind.ERROR_RETURN_STATEMENT, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.advance();
                        switch (this.expect(TokenType.RETURN_ARROW) | this.expect(TokenType.RETURN))
                        {
                            case (true) {
                            this.advance();
                            n.a = this.expression();
                        }
                            default {
                                switch (!this.expect(TokenType.SEMICOLON))
                                {
                                    case (true) {
                            n.a = this.expression();
                        }
                                    default {};
                                };
                            };
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        -> this.done(n);
                    };
                };
            };


            break_statement() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                this.consume(TokenType.BREAK);
                switch (this.failed)
                {
                    case (true) { -> (Node*)0; }
                    default
                    {
                        int kind = NodeKind.BREAK_STATEMENT;
                        switch (this.expect(TokenType.SWITCH))
                        {
                            case (true) {
                            kind = NodeKind.BREAK_SWITCH_STATEMENT;
                            this.advance();
                        }
                            default {};
                        };
                        switch (!this.consume(TokenType.SEMICOLON))
                        {
                            case (true) { -> (Node*)0; }
                            default
                            {
                                -> this.mk(kind, line, col);
                            };
                        };
                    };
                };
            };


            continue_statement() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                this.consume(TokenType.CONTINUE);
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.SEMICOLON); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) { -> (Node*)0; }
                    default
                    {
                        -> this.mk(NodeKind.CONTINUE_STATEMENT, line, col);
                    };
                };
            };


            noreturn_statement() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                this.consume(TokenType.NORET);
                switch (!this.failed)
                {
                    case (true) { this.consume(TokenType.SEMICOLON); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) { -> (Node*)0; }
                    default
                    {
                        -> this.mk(NodeKind.NORETURN_STATEMENT, line, col);
                    };
                };
            };


            label_statement() -> Node*
            {
                Node* n = this.mk(NodeKind.LABEL_STATEMENT, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.consume(TokenType.LABEL);
                        switch (!this.failed & this.loop_depth > 0)
                        {
                            case (true) {
                            this.error(g"'label' is not permitted inside a loop body\0");
                        }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { n.text = this.ident(); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.COLON); }
                            default {};
                        };
                        -> this.done(n);
                    };
                };
            };


            goto_statement() -> Node*
            {
                Node* n = this.mk(NodeKind.GOTO_STATEMENT, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.consume(TokenType.GOTO);
                        switch (!this.failed)
                        {
                            case (true) { n.text = this.ident(); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        -> this.done(n);
                    };
                };
            };


            keyword_expr_statement(int tok, int kind) -> Node*
            {
                Node* n = this.mk(kind, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.consume(tok);
                        switch (!this.failed)
                        {
                            case (true) { n.a = this.expression(); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        -> this.done(n);
                    };
                };
            };

            jump_statement() -> Node* -> this.keyword_expr_statement(TokenType.JUMP, NodeKind.JUMP_STATEMENT);

            escape_statement() -> Node* -> this.keyword_expr_statement(TokenType.ESCAPE_KW, NodeKind.ESCAPE_STATEMENT);


            throw_statement() -> Node*
            {
                Node* n = this.mk(NodeKind.THROW_STATEMENT, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.consume(TokenType.THROW);
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.LEFT_PAREN); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { n.a = this.expression(); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.RIGHT_PAREN); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        -> this.done(n);
                    };
                };
            };


            assert_statement() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* n = this.mk(NodeKind.ASSERT_STATEMENT, line, col);
                Node* msg;
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.consume(TokenType.ASSERT);
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.LEFT_PAREN); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { n.a = this.expression(); }
                            default {};
                        };
                        switch (!this.failed & this.expect(TokenType.COMMA))
                        {
                            case (true) {
                            this.advance();
                            switch (this.expect(TokenType.F_STRING) | this.expect(TokenType.I_STRING))
                            {
                                case (true) {

                                n.b = this.primary_expression();
                            }
                                default {
                                    switch (this.expect(TokenType.STRING_LITERAL))
                                    {
                                        case (true) {
                                msg = this.mk(NodeKind.STRING_LITERAL, this.cur_line(), this.cur_col());
                                switch (!this.failed)
                                {
                                    case (true) {
                                    msg.text = this.cur_value();
                                    n.b = msg;
                                    this.advance();
                                }
                                    default {};
                                };
                            }
                                        default {
                                this.fail_expected(TokenType.STRING_LITERAL);
                            };
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.RIGHT_PAREN); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        -> this.done(n);
                    };
                };
            };


            defer_statement() -> Node*
            {
                Node* n = this.mk(NodeKind.DEFER_STATEMENT, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.consume(TokenType.DEFER);
                        switch (!this.failed & this.expect(TokenType.LEFT_BRACE))
                        {
                            case (true) {
                            this.advance();
                            n.flags = 32;
                            this.statements_until_brace(n);
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                default {};
                            };
                        }
                            default {
                                switch (!this.failed)
                                {
                                    case (true) {
                            n.a = this.expression();
                        }
                                    default {};
                                };
                            };
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        -> this.done(n);
                    };
                };
            };


            idkvm_statement() -> Node*
            {
                Node* n = this.mk(NodeKind.IDEKAVM_BLOCK, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.consume(TokenType.IDEKAVM);
                        switch (!this.failed & this.expect(TokenType.IDEKAVM_BLOCK))
                        {
                            case (true) {
                            n.text = this.cur_value();
                            this.advance();
                        }
                            default {
                                switch (!this.failed)
                                {
                                    case (true) {
                            this.fail_expected(TokenType.IDEKAVM_BLOCK);
                        }
                                    default {};
                                };
                            };
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        -> this.done(n);
                    };
                };
            };


            ditto_statement() -> Node*
            {
                this.advance();
                switch (!this.consume(TokenType.SEMICOLON))
                {
                    case (true) { -> (Node*)0; }
                    default
                    {
                        switch (this.last_stmt == (Node*)0)
                        {
                            case (true) {
                            this.error(g"Ditto operator '#\"' used as a statement before any preceding statement to repeat\0");
                            -> (Node*)0;
                        }
                            default
                            {
                                Node* d = node_clone(this.last_stmt);
                                switch (d == (Node*)0)
                                {
                                    case (true) {
                                    this.fail_alloc();
                                    -> d;
                                }
                                    default
                                    {
                                        this.last_stmt = d;
                                        -> d;
                                    };
                                };
                            };
                        };
                    };
                };
            };




            asm_operands() -> byte*
            {
                this.sb.len = 0;
                this.sb.mem[0] = (byte)0;
                int count, depth, start;
                while (!this.expect2(TokenType.COLON, TokenType.SEMICOLON))
                {
                    switch (this.expect(TokenType.EOF))
                    {
                        case (true) {
                        this.fail_expected(TokenType.SEMICOLON);
                        -> (byte*)0;
                    }
                        default
                        {
                            switch (this.expect(TokenType.STRING_LITERAL))
                            {
                                case (true) {
                                start = this.sb.len;
                                switch (count > 0)
                                {
                                    case (true) { this.sb.put(',' ); }
                                    default {};
                                };
                                this.sb.put('"');
                                this.sb.put_n(this.cur_value(), this.cur_value_len());
                                this.sb.put('"');
                                this.advance();
                                switch (this.expect(TokenType.LEFT_PAREN))
                                {
                                    case (true) {
                                    this.advance();
                                    this.sb.put('(');
                                    depth = 1;
                                    while (depth > 0 & !this.expect(TokenType.EOF))
                                    {
                                        switch (this.expect(TokenType.LEFT_PAREN))
                                        {
                                            case (true) { depth++; }
                                            default {
                                                switch (this.expect(TokenType.RIGHT_PAREN))
                                                {
                                                    case (true) { depth--; }
                                                    default {};
                                                };
                                            };
                                        };
                                        switch (depth > 0)
                                        {
                                            case (true) { this.sb.put_n(this.cur_value(), this.cur_value_len()); }
                                            default {};
                                        };
                                        this.advance();
                                    };
                                    this.sb.put(')');
                                    count++;
                                }
                                    default {
                                    this.sb.len = start;
                                };
                                };
                                switch (this.expect(TokenType.COMMA))
                                {
                                    case (true) { this.advance(); }
                                    default {};
                                };
                            }
                                default {
                                this.advance();
                            };
                            };
                        };
                    };
                };
                -> this.own_n(this.sb.mem, this.sb.len);
            };


            asm_clobbers() -> byte*
            {
                this.sb.len = 0;
                this.sb.mem[0] = (byte)0;
                int count;
                while (!this.expect(TokenType.SEMICOLON))
                {
                    switch (this.expect(TokenType.EOF))
                    {
                        case (true) {
                        this.fail_expected(TokenType.SEMICOLON);
                        -> (byte*)0;
                    }
                        default
                        {
                            switch (this.expect(TokenType.STRING_LITERAL))
                            {
                                case (true) {
                                switch (count > 0)
                                {
                                    case (true) { this.sb.put(','); }
                                    default {};
                                };
                                this.sb.put('"');
                                this.sb.put_n(this.cur_value(), this.cur_value_len());
                                this.sb.put('"');
                                count++;
                                this.advance();
                                switch (this.expect(TokenType.COMMA))
                                {
                                    case (true) { this.advance(); }
                                    default {};
                                };
                            }
                                default {
                                this.advance();
                            };
                            };
                        };
                    };
                };
                -> this.own_n(this.sb.mem, this.sb.len);
            };



            asm_statement(bool is_volatile) -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* n = this.mk(NodeKind.EXPRESSION_STATEMENT, line, col);
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        Node* a = this.mk(NodeKind.INLINE_ASM, line, col);
                        switch (this.failed)
                        {
                            case (true) { node_free(n); -> a; }
                            default
                            {
                                n.a = a;
                                switch (!is_volatile & this.expect(TokenType.VOLATILE))
                                {
                                    case (true) {
                                    is_volatile = true;
                                    this.advance();
                                }
                                    default {};
                                };
                                switch (is_volatile)
                                {
                                    case (true) { a.flags = 64; }
                                    default {};
                                };
                                switch (!this.consume(TokenType.ASM))
                                {
                                    case (true) { -> this.done(n); }
                                    default
                                    {
                                        switch (!this.expect(TokenType.ASM_BLOCK))
                                        {
                                            case (true) {
                                            this.fail_expected(TokenType.ASM_BLOCK);
                                            -> this.done(n);
                                        }
                                            default
                                            {
                                                a.text = this.cur_value();
                                                this.advance();

                                                byte* outs = g"\0";
                                                byte* ins = g"\0";
                                                byte* clob = g"\0";
                                                switch (!this.expect(TokenType.SEMICOLON))
                                                {
                                                    case (true) {
                                                    switch (this.expect(TokenType.COLON))
                                                    {
                                                        case (true) {
                                                        this.advance();
                                                        outs = this.asm_operands();
                                                    }
                                                        default {};
                                                    };
                                                    switch (!this.failed & this.expect(TokenType.COLON))
                                                    {
                                                        case (true) {
                                                        this.advance();
                                                        ins = this.asm_operands();
                                                    }
                                                        default {};
                                                    };
                                                    switch (!this.failed & this.expect(TokenType.COLON))
                                                    {
                                                        case (true) {
                                                        this.advance();
                                                        clob = this.asm_clobbers();
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (this.failed)
                                                {
                                                    case (true) { -> this.done(n); }
                                                    default
                                                    {
                                                        switch (!this.consume(TokenType.SEMICOLON))
                                                        {
                                                            case (true) { -> this.done(n); }
                                                            default
                                                            {
                                                                byte* cons = g"\0";
                                                                switch (outs[0] != 0 | ins[0] != 0 | clob[0] != 0)
                                                                {
                                                                    case (true) {
                                                                    cons = outs;
                                                                    switch (ins[0] != 0 | clob[0] != 0)
                                                                    {
                                                                        case (true) {
                                                                        cons = this.cat2(this.cat2(cons, g":\0"), ins);
                                                                        switch (clob[0] != 0)
                                                                        {
                                                                            case (true) { cons = this.cat2(this.cat2(cons, g":\0"), clob); }
                                                                            default {};
                                                                        };
                                                                    }
                                                                        default {};
                                                                    };
                                                                }
                                                                    default {};
                                                                };
                                                                a.text2 = cons;
                                                                -> n;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };




            cc_text(int t) -> byte*
            {
                switch (t == TokenType.CDECL)
                {
                    case (true) { -> g"cdecl\0"; }
                    default
                    {
                        switch (t == TokenType.STDCALL)
                        {
                            case (true) { -> g"stdcall\0"; }
                            default
                            {
                                switch (t == TokenType.FASTCALL)
                                {
                                    case (true) { -> g"fastcall\0"; }
                                    default
                                    {
                                        switch (t == TokenType.THISCALL)
                                        {
                                            case (true) { -> g"thiscall\0"; }
                                            default
                                            {
                                                -> g"vectorcall\0";
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            fn_label(Node* f) -> byte*
            {
                switch (f.text != (byte*)0)
                {
                    case (true) { -> f.text; }
                    default
                    {
                        -> g"$\0";
                    };
                };
            };



            effect_bin(byte* op, Node* l, Node* r, int line, int col) -> Node*
            {
                Node* n = this.mk(NodeKind.EFFECT_EXPR, line, col);
                switch (this.failed)
                {
                    case (true) {
                    node_free(l);
                    node_free(r);
                    -> n;
                }
                    default
                    {
                        n.text = op;
                        n.a = l;
                        n.b = r;
                        -> n;
                    };
                };
            };


            effect_prefix(byte* op, int skip, int line, int col) -> Node*
            {
                int i;
                while (i < skip)
                {
                    this.advance();
                    i++;
                };
                Node* n = this.mk(NodeKind.EFFECT_EXPR, line, col);
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        n.text = op;
                        n.a = this.effect_unary();
                        -> this.done(n);
                    };
                };
            };

            effect_primary() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* n;
                Node* e;
                byte* name;
                byte* sub;

                switch (this.expect(TokenType.LEFT_PAREN))
                {
                    case (true) {
                    this.advance();
                    e = this.effect_expr();
                    switch (this.failed)
                    {
                        case (true) { -> e; }
                        default {};
                    };
                    switch (!this.consume(TokenType.RIGHT_PAREN))
                    {
                        case (true) {
                        node_free(e);
                        -> (Node*)0;
                    }
                        default {};
                    };
                    -> e;
                }
                    default
                    {
                        switch (this.expect(TokenType.LEFT_BRACKET))
                        {
                            case (true) {
                            this.advance();
                            e = this.effect_expr();
                            switch (this.failed)
                            {
                                case (true) { -> e; }
                                default {};
                            };
                            switch (!this.consume(TokenType.RIGHT_BRACKET))
                            {
                                case (true) {
                                node_free(e);
                                -> (Node*)0;
                            }
                                default {};
                            };
                            -> e;
                        }
                            default
                            {
                                switch (this.expect(TokenType.MULTIPLY))
                                {
                                    case (true) {
                                    this.advance();
                                    switch (!this.consume(TokenType.DOT))
                                    {
                                        case (true) { -> (Node*)0; }
                                        default {};
                                    };
                                    switch (!this.expect(TokenType.MULTIPLY))
                                    {
                                        case (true) {
                                        this.error(g"Expected '*' after '*.' in wildcard effect expression\0");
                                        -> (Node*)0;
                                    }
                                        default {};
                                    };
                                    this.advance();
                                    n = this.mk(NodeKind.EFFECT_NAME, line, col);
                                    switch (this.failed)
                                    {
                                        case (true) { -> n; }
                                        default {};
                                    };
                                    n.text = g"*.*\0";
                                    -> n;
                                }
                                    default
                                    {
                                        switch (this.expect2(TokenType.IDENTIFIER, TokenType.EFFECT))
                                        {
                                            case (true) {
                                            name = this.cur_value();
                                            this.advance();
                                            while (this.expect(TokenType.DOT))
                                            {
                                                this.advance();
                                                switch (this.expect(TokenType.MULTIPLY))
                                                {
                                                    case (true) {
                                                    this.advance();
                                                    name = this.cat2(name, g".*\0");
                                                    break;
                                                }
                                                    default {};
                                                };
                                                switch (!this.expect(TokenType.IDENTIFIER))
                                                {
                                                    case (true) {
                                                    this.error(g"Expected identifier or '*' after '.' in effect name\0");
                                                    -> (Node*)0;
                                                }
                                                    default {};
                                                };
                                                sub = this.cur_value();
                                                this.advance();
                                                name = this.cat2(this.cat2(name, g".\0"), sub);
                                            };
                                            n = this.mk(NodeKind.EFFECT_NAME, line, col);
                                            switch (this.failed)
                                            {
                                                case (true) { -> n; }
                                                default {};
                                            };
                                            n.text = name;
                                            -> n;
                                        }
                                            default
                                            {
                                                this.error(g"Expected effect expression (identifier, unary operator, or grouped expression)\0");
                                                -> (Node*)0;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            effect_unary() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                switch (this.expect(TokenType.NOT) & this.type_at(1) == TokenType.ADDRESS_OF)
                {
                    case (true) {
                    -> this.effect_prefix(g"!@\0", 2, line, col);
                }
                    default
                    {
                        switch (this.expect(TokenType.NOT))
                        {
                            case (true) { -> this.effect_prefix(g"!\0", 1, line, col); }
                            default
                            {
                                switch (this.expect(TokenType.MULTIPLY) & this.type_at(1) != TokenType.DOT)
                                {
                                    case (true) {
                                    -> this.effect_prefix(g"*\0", 1, line, col);
                                }
                                    default
                                    {
                                        switch (this.expect(TokenType.TIE))
                                        {
                                            case (true) { -> this.effect_prefix(g"~\0", 1, line, col); }
                                            default
                                            {
                                                switch (this.expect(TokenType.QUESTION))
                                                {
                                                    case (true) { -> this.effect_prefix(g"?\0", 1, line, col); }
                                                    default
                                                    {
                                                        switch (this.expect(TokenType.ADDRESS_OF))
                                                        {
                                                            case (true) { -> this.effect_prefix(g"@\0", 1, line, col); }
                                                            default
                                                            {
                                                                switch (this.expect(TokenType.ELLIPSIS))
                                                                {
                                                                    case (true) { -> this.effect_prefix(g"...\0", 1, line, col); }
                                                                    default
                                                                    {
                                                                        switch (this.expect(TokenType.RANGE))
                                                                        {
                                                                            case (true) { -> this.effect_prefix(g"..\0", 1, line, col); }
                                                                            default
                                                                            {
                                                                                switch (this.expect(TokenType.EXPONENT) & this.type_at(1) != TokenType.LOGICAL_OR)
                                                                                {
                                                                                    case (true) {
                                                                                    -> this.effect_prefix(g"^suppress\0", 1, line, col);
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        switch (this.expect(TokenType.LESS_THAN) & this.type_at(1) == TokenType.MULTIPLY)
                                                                                        {
                                                                                            case (true) {
                                                                                            -> this.effect_prefix(g"<*\0", 2, line, col);
                                                                                        }
                                                                                            default
                                                                                            {
                                                                                                -> this.effect_primary();
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            effect_mutual() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* left = this.effect_unary();
                Node* right;
                while (!this.failed & this.expect(TokenType.CHAIN_ARROW) & this.type_at(1) == TokenType.GREATER_THAN)
                {
                    this.advance();
                    this.advance();
                    right = this.effect_unary();
                    left = this.effect_bin(g"<->\0", left, right, line, col);
                };
                -> left;
            };

            effect_xor() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* left = this.effect_mutual();
                Node* right;
                while (!this.failed & this.expect(TokenType.XOR_OP))
                {
                    this.advance();
                    right = this.effect_mutual();
                    left = this.effect_bin(g"^|\0", left, right, line, col);
                };
                -> left;
            };

            effect_implies() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* left = this.effect_xor();
                Node* right;
                while (!this.failed & this.expect(TokenType.RETURN_ARROW))
                {
                    this.advance();
                    right = this.effect_xor();
                    left = this.effect_bin(g"->\0", left, right, line, col);
                };
                -> left;
            };

            effect_priority() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* left = this.effect_implies();
                Node* right;
                while (!this.failed & this.expect(TokenType.GREATER_THAN))
                {
                    this.advance();
                    right = this.effect_implies();
                    left = this.effect_bin(g">\0", left, right, line, col);
                };
                -> left;
            };

            effect_and() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* left = this.effect_priority();
                Node* right;
                while (!this.failed & this.expect(TokenType.LOGICAL_AND))
                {
                    this.advance();
                    right = this.effect_priority();
                    left = this.effect_bin(g"&\0", left, right, line, col);
                };
                -> left;
            };


            effect_expr() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* left = this.effect_and();
                Node* right;
                while (!this.failed & this.expect(TokenType.LOGICAL_OR))
                {
                    this.advance();
                    right = this.effect_and();
                    left = this.effect_bin(g"|\0", left, right, line, col);
                };
                -> left;
            };


            effect_annotation(int kind) -> Node*
            {
                Node* n = this.mk(kind, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.advance();
                        switch (!this.consume(TokenType.LEFT_BRACE))
                        {
                            case (true) {
                            node_free(n);
                            -> (Node*)0;
                        }
                            default
                            {
                                n.a = this.effect_expr();
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                    default {};
                                };
                                -> this.done(n);
                            };
                        };
                    };
                };
            };


            fn_tags(Node* f) -> void
            {
                while (!this.failed & this.expect(TokenType.TAG))
                {
                    this.advance();
                    switch (this.expect(TokenType.DEPRECATE))
                    {
                        case (true) {
                        this.advance();
                        f.flags = f.flags `| 16384;
                    }
                        default {
                            switch (this.expect(TokenType.EFFECT))
                            {
                                case (true) {
                        node_free(f.b);
                        f.b = this.effect_annotation(NodeKind.EFFECT_ANNOTATION);
                    }
                                default {
                                    switch (this.expect(TokenType.IDENTIFIER) & this.val_is(g"attenuate\0", 9))
                                    {
                                        case (true) {
                        node_free(f.c);
                        f.c = this.effect_annotation(NodeKind.ATTENUATE_ANNOTATION);
                    }
                                        default {
                                            switch (this.expect(TokenType.LESS_THAN))
                                            {
                                                case (true) { this.async_use(f); }
                                                default { this.error(g"Expected 'deprecate', 'effect', 'attenuate' or '<Tag>' after '#'\0"); };
                                            };
                    };
                                    };
                                };
                            };
                        };
                    };
                };
                ->;
            };





            is_module_def() -> bool
            {
                if (this.cur() != TokenType.IDENTIFIER) { -> false; };
                if (!this.val_is(g"module\0", 6)) { -> false; };
                -> this.type_at(1) == TokenType.IDENTIFIER & (this.type_at(2) == TokenType.LEFT_BRACE | this.type_at(2) == TokenType.SEMICOLON | this.type_at(2) == TokenType.FROM);
            };






            module_def() -> Node*
            {
                Node* m = this.mk(NodeKind.MODULE_DEF, this.cur_line(), this.cur_col());
                if (this.failed) { -> m; };
                this.advance();
                m.text = this.ident();
                if (this.expect(TokenType.FROM))
                {
                    Node* f0 = this.mk(NodeKind.STRING_LITERAL, this.cur_line(), this.cur_col());
                    this.advance();
                    if (!this.expect(TokenType.STRING_LITERAL))
                    {
                        this.fail_expected(TokenType.STRING_LITERAL);
                        -> m;
                    };
                    f0.text = this.cur_value();
                    this.advance();
                    m.ival = 1;
                    node_push(m, 1, f0);
                    this.consume(TokenType.SEMICOLON);
                    -> m;
                };
                if (this.expect(TokenType.SEMICOLON))
                {
                    this.error(this.cat2(this.cat2(g"module '\0", m.text), g"' has no body: expected '{' after the module name, or 'from \"file.idk\";' to import it\0"));
                    -> m;
                };
                this.consume(TokenType.LEFT_BRACE);
                Node* s;
                int k;
                while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                {
                    if (this.expect(TokenType.EOF))
                    {
                        this.error(this.cat2(this.cat2(g"Unterminated module '\0", m.text), g"'\0"));
                        break;
                    };
                    if (this.expect(TokenType.FROM))
                    {
                        this.error(g"'from' is not allowed inside a module body: declare 'module Name from \"file.idk\";' before the module and list Name in '#[requires]'\0");
                        break;
                    };
                    s = this.statement();
                    if (this.failed) { break; };
                    if (s != (Node*)0) { node_push(m, 0, s); };
                    k = 0;
                    while (k < this.pending.len)
                    {
                        node_push(m, 0, this.pending.items[k]);
                        k++;
                    };
                    this.pending.len = 0;
                };
                this.consume(TokenType.RIGHT_BRACE);
                if (!this.failed & this.expect(TokenType.TAG) & this.type_at(1) == TokenType.IDENTIFIER)
                {
                    this.advance();
                    if (this.val_is(g"build\0", 5))
                    {
                        this.advance();
                        this.build_block(m, 2, false);
                    }
                    else
                    {
                        this.error(g"Expected 'build' after '#' following a module body\0");
                    };
                };
                this.consume(TokenType.SEMICOLON);
                -> m;
            };


            build_block(Node* owner, int li, bool test) -> void
            {
                this.consume(TokenType.LEFT_BRACE);
                while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                {
                    this.build_entry(owner, li, test);
                    if (this.failed) { break; };
                    if (this.expect(TokenType.COMMA))
                    {
                        this.advance();
                    }
                    else
                    {
                        if (!this.expect(TokenType.RIGHT_BRACE))
                        {
                            this.error(g"Expected ',' or '}' after a build entry\0");
                        };
                    };
                };
                this.consume(TokenType.RIGHT_BRACE);
                ->;
            };




            build_entry(Node* owner, int li, bool test) -> void
            {
                Node* e = this.mk(NodeKind.BUILD_ENTRY, this.cur_line(), this.cur_col());
                if (this.failed) { ->; };
                node_push(owner, li, e);
                bool locked;
                if (this.expect(TokenType.NOT))
                {
                    if (this.type_at(1) != TokenType.PLUS)
                    {
                        this.error(g"Expected '+' after '!' in a build entry ('!+' locks the setting)\0");
                        ->;
                    };
                    this.advance();
                    this.advance();
                    locked = true;
                    e.flags = e.flags | 1;
                };
                this.consume(TokenType.TAG);
                this.consume(TokenType.LEFT_BRACKET);
                if (this.failed) { ->; };
                e.text = this.cur_value();
                bool is_override = this.val_is(g"override\0", 8);
                bool is_test = !test & this.val_is(g"test\0", 4);
                this.advance();
                Node* n;
                if (is_override)
                {
                    this.consume(TokenType.FOR);
                    if (this.expect(TokenType.LEFT_BRACE))
                    {
                        this.advance();
                        while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                        {
                            n = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                            n.text = this.cur_value();
                            node_push(e, 2, n);
                            this.advance();
                            if (this.expect(TokenType.COMMA)) { this.advance(); };
                        };
                        this.consume(TokenType.RIGHT_BRACE);
                    }
                    else
                    {
                        n = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                        n.text = this.ident();
                        node_push(e, 2, n);
                    };
                };
                this.consume(TokenType.RIGHT_BRACKET);
                if (test & !this.failed & !this.expect(TokenType.ASSIGN))
                {

                    e.ival = 1;
                    e.op = 1;
                    ->;
                };
                this.consume(TokenType.ASSIGN);
                if (this.failed) { ->; };
                if (is_test)
                {
                    e.ival = 4;
                    -> this.build_block(e, 1, true);
                };
                if (is_override)
                {
                    if (locked)
                    {
                        this.error(g"An override cannot be locked\0");
                        ->;
                    };
                    e.ival = 3;
                    -> this.build_block(e, 1, false);
                };
                if (this.expect(TokenType.LEFT_BRACE))
                {
                    e.ival = 2;
                    this.advance();
                    while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                    {
                        n = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                        n.text = this.cur_value();
                        node_push(e, 0, n);
                        this.advance();
                        if (this.expect(TokenType.COMMA)) { this.advance(); };
                    };
                    this.consume(TokenType.RIGHT_BRACE);
                    ->;
                };
                if (this.expect(TokenType.TRUE))
                {
                    e
                    {
                        .ival = 1;
                        .op = 1;
                    };
                    -> this.advance();
                };
                if (this.expect(TokenType.FALSE))
                {
                    e
                    {
                        .ival = 1;
                        .op = 0;
                    };
                    -> this.advance();
                };
                e.text2 = this.cur_value();
                -> this.advance();
            };




            is_async_tag_def() -> bool
            {
                switch (this.type_at(1) != TokenType.IDENTIFIER | this.type_at(2) != TokenType.LEFT_PAREN)
                {
                    case (true) { -> false; }
                    default
                    {
                        int i = 3;
                        int t;
                        bool scanning = true;
                        while (scanning)
                        {
                            t = this.type_at(i);
                            switch (t == TokenType.RIGHT_PAREN)
                            {
                                case (true) { scanning = false; }
                                default {
                                    switch (t != TokenType.IDENTIFIER)
                                    {
                                        case (true) { -> false; }
                                        default
                                        {
                                            i++;
                                            t = this.type_at(i);
                                            switch (t == TokenType.COMMA)
                                            {
                                                case (true) { i++; }
                                                default {
                                                    switch (t != TokenType.RIGHT_PAREN)
                                                    {
                                                        case (true) { -> false; }
                                                        default {};
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        -> this.type_at(i + 1) == TokenType.LEFT_BRACE;
                    };
                };
            };


            async_rel_op() -> byte*
            {
                switch (this.cur())
                {
                    case (TokenType.TAG) { -> g"#\0"; }
                    case (TokenType.GREATER_THAN) { -> g">\0"; }
                    case (TokenType.TIE) { -> g"~\0"; }
                    case (TokenType.NOT) { -> g"!\0"; }
                    default
                    {
                        -> (byte*)0;
                    };
                };
            };


            async_has_name(NodeVec* v, byte* name) -> bool
            {
                int i = 0;
                while (v != (NodeVec*)0 & i < v.len)
                {
                    switch (cstr_eq(v.items[i].text, name))
                    {
                        case (true) { -> true; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> false;
            };




            async_tag_def() -> Node*
            {
                Node* d = this.mk(NodeKind.ASYNC_TAG_DEF, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> d; }
                    default
                    {
                        this.advance();
                        d.text = this.ident();
                        switch (this.failed)
                        {
                            case (true) { -> this.done(d); }
                            default
                            {
                                this.consume(TokenType.LEFT_PAREN);
                                Node* p;
                                bool more = !this.failed;
                                while (more)
                                {
                                    p = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                                    switch (this.failed)
                                    {
                                        case (true) { -> this.done(d); }
                                        default
                                        {
                                            node_push(d, 0, p);
                                            p.text = this.ident();
                                            switch (this.failed)
                                            {
                                                case (true) { -> this.done(d); }
                                                default
                                                {
                                                    more = this.expect(TokenType.COMMA);
                                                    switch (more)
                                                    {
                                                        case (true) { this.advance(); }
                                                        default {};
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                                this.consume(TokenType.RIGHT_PAREN);
                                switch (this.failed)
                                {
                                    case (true) { -> this.done(d); }
                                    default
                                    {
                                        int a = 0;
                                        int b;
                                        while (a < d.l0.len)
                                        {
                                            b = a + 1;
                                            while (b < d.l0.len)
                                            {
                                                switch (cstr_eq(d.l0.items[a].text, d.l0.items[b].text))
                                                {
                                                    case (true) {
                                                        this.error(this.cat2(this.cat2(g"async tag '\0", d.text), g"' has duplicate parameter names\0"));
                                                        -> this.done(d);
                                                    }
                                                    default
                                                    {
                                                        b++;
                                                    };
                                                };
                                            };
                                            a++;
                                        };
                                        this.consume(TokenType.LEFT_BRACE);
                                        Node* r;
                                        Node* o;
                                        byte* op;
                                        while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                                        {
                                            r = this.mk(NodeKind.ASYNC_RELATION, this.cur_line(), this.cur_col());
                                            switch (this.failed)
                                            {
                                                case (true) { -> this.done(d); }
                                                default
                                                {
                                                    node_push(d, 1, r);
                                                    o = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                                                    switch (this.failed)
                                                    {
                                                        case (true) { -> this.done(d); }
                                                        default
                                                        {
                                                            node_push(r, 0, o);
                                                            o.text = this.ident();
                                                            switch (this.failed)
                                                            {
                                                                case (true) { -> this.done(d); }
                                                                default
                                                                {
                                                                    op = this.async_rel_op();
                                                                    while (op != (byte*)0)
                                                                    {
                                                                        o = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                                                                        switch (this.failed)
                                                                        {
                                                                            case (true) { -> this.done(d); }
                                                                            default
                                                                            {
                                                                                o.text = op;
                                                                                node_push(r, 1, o);
                                                                                this.advance();
                                                                                o = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                                                                                switch (this.failed)
                                                                                {
                                                                                    case (true) { -> this.done(d); }
                                                                                    default
                                                                                    {
                                                                                        node_push(r, 0, o);
                                                                                        o.text = this.ident();
                                                                                        switch (this.failed)
                                                                                        {
                                                                                            case (true) { -> this.done(d); }
                                                                                            default
                                                                                            {
                                                                                                op = this.async_rel_op();
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                    switch (r.l1 == (NodeVec*)0)
                                                                    {
                                                                        case (true) {
                                                                            this.error(this.cat2(this.cat2(g"Expected a relation operator ('#', '>', '~' or '!') in async tag '\0", d.text), g"'\0"));
                                                                            -> this.done(d);
                                                                        }
                                                                        default
                                                                        {
                                                                            a = 0;
                                                                            while (a < r.l0.len)
                                                                            {
                                                                                switch (!this.async_has_name(d.l0, r.l0.items[a].text))
                                                                                {
                                                                                    case (true) {
                                                                                        this.error(this.cat2(this.cat2(this.cat2(this.cat2(g"'\0", r.l0.items[a].text), g"' is not a parameter of async tag '\0"), d.text), g"'\0"));
                                                                                        -> this.done(d);
                                                                                    }
                                                                                    default
                                                                                    {
                                                                                        a++;
                                                                                    };
                                                                                };
                                                                            };
                                                                            this.consume(TokenType.SEMICOLON);
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                        this.consume(TokenType.RIGHT_BRACE);
                                        this.consume(TokenType.SEMICOLON);
                                        -> this.done(d);
                                    };
                                };
                            };
                        };
                    };
                };
            };


            async_use(Node* f) -> void
            {
                Node* u = this.mk(NodeKind.ASYNC_TAG_USE, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        node_push(f, 1, u);
                        this.consume(TokenType.LESS_THAN);
                        u.text = this.ident();
                        this.consume(TokenType.GREATER_THAN);
                        this.consume(TokenType.LEFT_PAREN);
                        this.async_target(u);
                        while (!this.failed & this.expect(TokenType.COMMA))
                        {
                            this.advance();
                            this.async_target(u);
                        };
                        this.consume(TokenType.RIGHT_PAREN);
                        ->;
                    };
                };
            };


            async_target(Node* u) -> void
            {
                Node* t = this.mk(NodeKind.ASYNC_TARGET, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        node_push(u, 0, t);
                        switch (this.expect(TokenType.THIS))
                        {
                            case (true) {
                                t.text = g"this\0";
                                this.advance();
                            }
                            default { t.text = this.ident(); };
                        };
                        switch (!this.failed & this.expect(TokenType.LEFT_PAREN))
                        {
                            case (true) {
                                this.advance();
                                t.ival = 1;
                                Node* p;
                                while (!this.failed & !this.expect(TokenType.RIGHT_PAREN))
                                {
                                    p = this.mk(NodeKind.PARAMETER, this.cur_line(), this.cur_col());
                                    switch (this.failed)
                                    {
                                        case (true) { ->; }
                                        default
                                        {
                                            node_push(t, 0, p);
                                            p.ts = this.type_spec();
                                            switch (!this.failed & this.expect(TokenType.COMMA))
                                            {
                                                case (true) { this.advance(); }
                                                default {};
                                            };
                                        };
                                    };
                                };
                                this.consume(TokenType.RIGHT_PAREN);
                                switch (!this.failed & this.expect(TokenType.RETURN_ARROW))
                                {
                                    case (true) {
                                        this.advance();
                                        t.ts = this.type_spec();
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                        ->;
                    };
                };
            };





            parameter(Node* f) -> void
            {
                Node* p = this.mk(NodeKind.PARAMETER, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        node_push(f, 0, p);
                        switch (this.expect(TokenType.ELLIPSIS))
                        {
                            case (true) {
                            this.advance();
                            p.ival = 1;
                            ->;
                        }
                            default
                            {
                                p.ts = this.type_spec();
                                switch (this.failed)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        switch (this.expect(TokenType.IDENTIFIER))
                                        {
                                            case (true) {
                                            p.text = this.cur_value();
                                            this.advance();
                                            switch (this.expect(TokenType.ASSIGN))
                                            {
                                                case (true) {
                                                this.advance();
                                                p.a = this.expression();
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        ->;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            parameter_list(Node* f) -> void
            {
                this.parameter(f);
                while (!this.failed & this.expect(TokenType.COMMA))
                {
                    this.advance();
                    this.parameter(f);
                };
                ->;
            };


            strip_variadic(Node* f) -> void
            {
                switch (f.l0 == (NodeVec*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        int i, j;
                        Node* p;
                        while (i < f.l0.len)
                        {
                            p = f.l0.items[i];
                            switch (p.ival)
                            {
                                case (1)
                                {
                                    node_free(p);
                                    f.flags = f.flags `| 2048;
                                }
                                default
                                {
                                    f.l0.items[j] = p;
                                    j++;
                                };
                            };
                            i++;
                        };
                        f.l0.len = j;
                        ->;
                    };
                };
            };

            param_count(Node* f) -> int
            {
                switch (f.l0 == (NodeVec*)0)
                {
                    case (true) { -> 0; }
                    default
                    {
                        -> f.l0.len;
                    };
                };
            };




            function_pointer_type(byte* conv) -> TypeSpec*
            {
                TypeSpec* t = typespec_new();
                switch (t == (TypeSpec*)0)
                {
                    case (true) {
                    this.fail_alloc();
                    -> t;
                }
                    default
                    {
                        t.base_type = DataType.FUNC_PTR;
                        t.calling_conv = conv;
                        PtrVec* tmp = pv_new();
                        TypeSpec* p;
                        int i;
                        switch (this.consume(TokenType.LEFT_PAREN))
                        {
                            case (true) {
                            switch (!this.expect(TokenType.RIGHT_PAREN))
                            {
                                case (true) {
                                p = this.type_spec();
                                pv_push(tmp, (void*)p);
                                while (!this.failed & this.expect(TokenType.COMMA))
                                {
                                    this.advance();
                                    p = this.type_spec();
                                    pv_push(tmp, (void*)p);
                                };
                            }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.RETURN_ARROW); }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { t.fp_ret = this.type_spec(); }
                                default {};
                            };
                        }
                            default {};
                        };
                        switch (tmp.len > 0)
                        {
                            case (true) {
                            t.fp_params = (TypeSpec**)fmalloc((u64)(tmp.len + 1) * (u64)((sizeof(TypeSpec*) + 7) / 8));
                            while (i < tmp.len)
                            {
                                t.fp_params[i] = (TypeSpec*)tmp.items[i];
                                i++;
                            };
                            t.fp_nparams = tmp.len;
                        }
                            default {};
                        };
                        pv_free(tmp);
                        -> t;
                    };
                };
            };


            fp_one(byte* conv) -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* n = this.mk(NodeKind.FUNCTION_POINTER_DECLARATION, line, col);
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        Node* addr;
                        Node* e;
                        Node* m;
                        n.text = this.ident();
                        switch (this.failed)
                        {
                            case (true) { -> this.done(n); }
                            default
                            {
                                n.ts = this.function_pointer_type(conv);
                                switch (this.failed)
                                {
                                    case (true) { -> this.done(n); }
                                    default
                                    {
                                        switch (this.expect(TokenType.ASSIGN))
                                        {
                                            case (true) {
                                            this.advance();
                                            switch (this.expect(TokenType.ADDRESS_OF))
                                            {
                                                case (true) {
                                                addr = this.mk(NodeKind.ADDRESS_OF, this.cur_line(), this.cur_col());
                                                switch (this.failed)
                                                {
                                                    case (true) { -> this.done(n); }
                                                    default
                                                    {
                                                        n.a = addr;
                                                        this.advance();
                                                        e = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                                                        switch (this.failed)
                                                        {
                                                            case (true) { -> this.done(n); }
                                                            default
                                                            {
                                                                addr.a = e;
                                                                switch (this.expect(TokenType.STRING_LITERAL))
                                                                {
                                                                    case (true) {
                                                                    e.text = this.cur_value();
                                                                    this.advance();
                                                                }
                                                                    default {
                                                                    e.text = this.ident();
                                                                };
                                                                };
                                                                while (!this.failed & this.expect(TokenType.DOT))
                                                                {
                                                                    this.advance();
                                                                    m = this.mk(NodeKind.MEMBER_ACCESS, this.cur_line(), this.cur_col());
                                                                    switch (this.failed)
                                                                    {
                                                                        case (true) { -> this.done(n); }
                                                                        default
                                                                        {
                                                                            m.a = e;
                                                                            addr.a = m;
                                                                            e = m;
                                                                            e.text = this.ident();
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            }
                                                default {
                                                n.a = this.expression();
                                            };
                                            };
                                        }
                                            default {};
                                        };
                                        -> this.done(n);
                                    };
                                };
                            };
                        };
                    };
                };
            };


            function_pointer_declaration(byte* conv) -> Node*
            {
                switch (this.loop_depth > 0 & !this.in_for_init)
                {
                    case (true) {
                    this.warn_here(g"pointer declaration inside a loop body, this will continually allocate new slots on the stack each iteration.\0");
                }
                    default {};
                };
                Node* first = this.fp_one(conv);
                switch (this.failed)
                {
                    case (true) { -> first; }
                    default
                    {
                        Node* x;
                        while (this.expect(TokenType.COMMA))
                        {
                            this.advance();
                            x = this.fp_one(conv);
                            switch (this.failed)
                            {
                                case (true) {
                                node_free(first);
                                -> x;
                            }
                                default
                                {
                                    nv_push(this.pending, x);
                                };
                            };
                        };
                        switch (!this.consume(TokenType.SEMICOLON))
                        {
                            case (true) {
                            node_free(first);
                            -> (Node*)0;
                        }
                            default
                            {
                                -> first;
                            };
                        };
                    };
                };
            };






            skip_unsupported(int m, int feat, Node* partial, int kind, bool keep) -> Node*
            {
                int line = partial.line;
                int col = partial.col;
                node_free(partial);
                this.pending.len = 0;
                this.reset(m);
                this.last_stmt = (Node*)0;
                this.last_call = (Node*)0;
                this.note_feat(feat);
                this.skip_construct();
                switch (!keep)
                {
                    case (true) { -> (Node*)0; }
                    default
                    {
                        Node* stub_node = this.mk(kind, line, col);
                        switch (this.failed)
                        {
                            case (true) { -> stub_node; }
                            default
                            {
                                stub_node.flags = 65536;
                                -> stub_node;
                            };
                        };
                    };
                };
            };

            func_unsupported(int m, int feat, Node* partial) -> Node* -> this.skip_unsupported(m, feat, partial, NodeKind.FUNCTION_DEF, feat != Feat.TEMPLATE_FUNCTION);


            mark_proto(Node* f) -> void
            {
                f.flags = f.flags `| 512;
                f.a = this.mk(NodeKind.BLOCK, f.line, f.col);
                ->;
            };


            fstr_node() -> Node*
            {
                switch (this.expect(TokenType.F_STRING))
                {
                    case (true) { -> this.f_string_node(); }
                    default
                    {
                        -> this.i_string_node();
                    };
                };
            };



            fstr_resolve(Node* fl) -> byte*
            {
                Node* p;
                byte* val;
                int k, cnt;
                this.sb.len = 0;
                this.sb.mem[0] = (byte)0;
                cnt = node_count(fl, 0);
                while (k < cnt)
                {
                    p = node_child(fl, 0, k);
                    k++;
                    switch (p.kind)
                    {
                        case (NodeKind.STRING_LITERAL)
                        {
                            this.sb.put_str(p.text);
                        }
                        case (NodeKind.IDENTIFIER)
                        {
                            val = (byte*)nm_get(this.cstrs, p.text);
                            switch (val == (byte*)0)
                            {
                                case (true) { -> (byte*)0; }
                                default
                                {
                                    this.sb.put_str(val);
                                };
                            };
                        }
                        default { -> (byte*)0; };
                    };
                };
                -> this.own_n(this.sb.mem, this.sb.len);
            };


            fn_name(Node* f) -> void
            {
                Node* fs;
                switch (this.expect(TokenType.STRING_LITERAL))
                {
                    case (true) {
                    f.text = this.cur_value();
                    this.advance();
                }
                    default {
                        switch (this.expect2(TokenType.F_STRING, TokenType.I_STRING))
                        {
                            case (true) {
                    fs = this.fstr_node();
                    switch (!this.failed)
                    {
                        case (true) {
                        f.text = this.fstr_resolve(fs);
                        switch (f.text == (byte*)0)
                        {
                            case (true) { f.d = fs; }
                            default { node_free(fs); };
                        };
                    }
                        default {};
                    };
                }
                            default {
                                switch (this.expect(TokenType.STRINGIFY))
                                {
                                    case (true) { this.in_fn_stringify = 1; f.d = this.stringify_expr(); this.in_fn_stringify = 0; }
                                    default {
                                        switch (this.expect(TokenType.IDENTIFIER))
                                        {
                                            case (true) {
                    f.text = this.cur_value();
                    this.advance();
                }
                                            default {
                    this.error_exp(g"Expected function name (identifier or string literal)\0", TokenType.IDENTIFIER);
                };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                ->;
            };


            fn_return(Node* f, bool is_cdecl) -> void
            {
                f.ts = this.type_spec();
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (this.expect(TokenType.XOR_OP))
                        {
                            case (true) {
                            switch (is_cdecl)
                            {
                                case (true) {
                                this.error(this.cat2(this.cat2(g"Function '\0", this.fn_label(f)), g"' declared with 'cdecl' cannot have a dual return type: a C ABI function can only return a single value\0"));
                                ->;
                            }
                                default
                                {
                                    this.advance();
                                    f.ts2 = this.type_spec();
                                };
                            };
                        }
                            default {};
                        };
                        ->;
                    };
                };
            };



            begin_body(Node* f) -> bool
            {
                int i;
                Node* p;
                while (i < this.param_count(f))
                {
                    switch (f.l0.items[i].text == (byte*)0)
                    {
                        case (true) {
                        this.error(g"Function definition requires parameter names, but a parameter has no name\0");
                        -> false;
                    }
                        default
                        {
                            i++;
                        };
                    };
                };
                switch (this.function_depth > 0)
                {
                    case (true) {
                    this.error(this.cat2(this.cat2(g"Illegal nested function definition '\0", this.fn_label(f)), g"': function definitions are not allowed inside another function body\0"));
                    -> false;
                }
                    default
                    {
                        switch (this.st != (IDKC_SYMTABLE*)0)
                        {
                            case (true) {
                            st_enter_scope(this.st);
                            i = 0;
                            while (i < this.param_count(f))
                            {
                                p = f.l0.items[i];
                                this.define_var(p.text, p.ts);
                                i++;
                            };
                        }
                            default {};
                        };
                        -> true;
                    };
                };
            };

            end_body() -> void
            {
                switch (this.st != (IDKC_SYMTABLE*)0)
                {
                    case (true) { st_exit_scope(this.st); }
                    default {};
                };
                ->;
            };


            proto_scope_end(Node* p, TemplateEntry* pte, NameMap* prev_act) -> Node*
            {
                switch (pte != (TemplateEntry*)0)
                {
                    case (true) {
                    nm_free(this.active_tp);
                    this.active_tp = prev_act;
                    te_free(pte);
                }
                    default {};
                };
                -> this.done(p);
            };


            fn_extra_proto(int m, int base_flags, byte* conv, bool is_cdecl) -> Node*
            {
                Node* p = this.mk(NodeKind.FUNCTION_DEF, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> p; }
                    default
                    {
                        p.flags = base_flags;
                        p.text2 = conv;
                        this.fn_name(p);
                        switch (this.failed)
                        {
                            case (true) { -> this.done(p); }
                            default
                            {
                                NameMap* prev_act = this.active_tp;
                                TemplateEntry* pte = (TemplateEntry*)0;
                                switch (this.expect(TokenType.LESS_THAN) & this.is_template_list())
                                {
                                    case (true) {
                                    pte = te_new();
                                    this.advance();
                                    pv_push(pte.params, (void*)this.own(ts_dup(this.ident())));
                                    while (!this.failed & this.expect(TokenType.COMMA))
                                    {
                                        this.advance();
                                        pv_push(pte.params, (void*)this.own(ts_dup(this.ident())));
                                    };
                                    switch (!this.failed)
                                    {
                                        case (true) { this.consume(TokenType.GREATER_THAN); }
                                        default {};
                                    };
                                    switch (this.failed)
                                    {
                                        case (true) {
                                        te_free(pte);
                                        -> this.done(p);
                                    }
                                        default
                                        {
                                            this.tp_activate(pte);
                                            p.flags = p.flags `| 524288;
                                        };
                                    };
                                }
                                    default {};
                                };
                                switch (!this.consume(TokenType.LEFT_PAREN))
                                {
                                    case (true) { -> this.proto_scope_end(p, pte, prev_act); }
                                    default
                                    {
                                        switch (!this.expect(TokenType.RIGHT_PAREN))
                                        {
                                            case (true) { this.parameter_list(p); }
                                            default {};
                                        };
                                        switch (!this.failed)
                                        {
                                            case (true) { this.consume(TokenType.RIGHT_PAREN); }
                                            default {};
                                        };
                                        switch (!this.failed)
                                        {
                                            case (true) { this.consume(TokenType.RETURN_ARROW); }
                                            default {};
                                        };
                                        switch (!this.failed)
                                        {
                                            case (true) { this.fn_return(p, is_cdecl); }
                                            default {};
                                        };
                                        switch (pte != (TemplateEntry*)0)
                                        {
                                            case (true) {
                                            nm_free(this.active_tp);
                                            this.active_tp = prev_act;
                                            te_free(pte);
                                        }
                                            default {};
                                        };
                                        switch (!this.failed)
                                        {
                                            case (true) { this.fn_tags(p); }
                                            default {};
                                        };
                                        switch (this.failed)
                                        {
                                            case (true) { -> this.done(p); }
                                            default
                                            {
                                                this.strip_variadic(p);
                                                this.mark_proto(p);
                                                -> this.done(p);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };







            function_def() -> Node*
            {
                NameMap* prev_act = this.active_tp;
                TemplateEntry* prev_cur = this.tmpl_cur;
                this.tmpl_cur = (TemplateEntry*)0;
                Node* f = this.function_def_inner();
                TemplateEntry* te = this.tmpl_cur;
                this.tmpl_cur = prev_cur;
                switch (this.active_tp != prev_act)
                {
                    case (true) {
                    nm_free(this.active_tp);
                    this.active_tp = prev_act;
                }
                    default {};
                };
                switch (te == (TemplateEntry*)0)
                {
                    case (true) { -> f; }
                    default
                    {
                        switch (this.failed | f == (Node*)0)
                        {
                            case (true) {
                            te_free(te);
                            -> f;
                        }
                            default
                            {
                                switch (f.text == (byte*)0)
                                {
                                    case (true) { f.text = g"\0"; }
                                    default {};
                                };
                                this.last_template = f.text;
                                switch (this.in_comptime > 0)
                                {
                                    case (true) {
                                    this.register_template(f.text, 0, te, node_clone(f));
                                    -> f;
                                }
                                    default
                                    {
                                        this.register_template(f.text, 0, te, f);
                                        -> (Node*)0;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            function_def_inner() -> Node*
            {
                int m = this.mark();
                int line = this.cur_line();
                int col = this.cur_col();
                int flags = 0;
                byte* conv = (byte*)0;
                bool is_cdecl = false;

                switch (this.expect(TokenType.CONST))
                {
                    case (true) { flags = flags `| 256; this.advance(); }
                    default {};
                };
                switch (this.expect(TokenType.VOLATILE))
                {
                    case (true) { flags = flags `| 64; this.advance(); }
                    default {};
                };
                switch (this.expect(TokenType.INLINE))
                {
                    case (true) { flags = flags `| 8192; this.advance(); }
                    default {};
                };

                bool is_async = this.expect(TokenType.ASYNC);
                switch (is_async)
                {
                    case (true) {
                        flags = flags `| 2097152;
                        this.advance();
                    }
                    default {};
                };

                switch (!is_async & this.is_calling_conv(this.cur()))
                {
                    case (true) {
                    conv = this.cc_text(this.cur());
                    is_cdecl = this.expect(TokenType.CDECL);
                    this.advance();
                }
                    default {
                        switch (!is_async & this.expect(TokenType.DEF))
                        {
                            case (true) {
                    this.advance();
                }
                            default {};
                        };
                    };
                };

                switch (this.expect(TokenType.FUNCTION_POINTER))
                {
                    case (true) {
                    this.advance();
                    -> this.function_pointer_declaration(conv);
                }
                    default
                    {
                        switch (is_cdecl)
                        {
                            case (true) { flags = flags `| 1024; }
                            default {};
                        };
                        switch (this.expect(TokenType.NO_MANGLE))
                        {
                            case (true) {
                            flags = flags `| 1024;
                            this.advance();
                        }
                            default {};
                        };

                        Node* f = this.mk(NodeKind.FUNCTION_DEF, line, col);
                        switch (this.failed)
                        {
                            case (true) { -> f; }
                            default
                            {
                                f.flags = flags;
                                f.text2 = conv;

                                this.fn_name(f);
                                switch (this.failed)
                                {
                                    case (true) { -> this.done(f); }
                                    default
                                    {
                                        switch (this.expect(TokenType.LESS_THAN))
                                        {
                                            case (true) {
                                            this.tmpl_cur = this.template_params(false);
                                            switch (this.failed)
                                            {
                                                case (true) { -> this.done(f); }
                                                default
                                                {
                                                    this.tp_activate(this.tmpl_cur);
                                                };
                                            };
                                        }
                                            default {};
                                        };

                                        switch (!this.consume(TokenType.LEFT_PAREN))
                                        {
                                            case (true) { -> this.done(f); }
                                            default
                                            {
                                                switch (!this.expect(TokenType.RIGHT_PAREN))
                                                {
                                                    case (true) { this.parameter_list(f); }
                                                    default {};
                                                };
                                                switch (this.failed)
                                                {
                                                    case (true) { -> this.done(f); }
                                                    default
                                                    {
                                                        switch (!this.consume(TokenType.RIGHT_PAREN))
                                                        {
                                                            case (true) { -> this.done(f); }
                                                            default
                                                            {
                                                                switch (this.expect(TokenType.RECURSE_ARROW))
                                                                {
                                                                    case (true) {
                                                                    f.flags = f.flags `| 4096;
                                                                    this.advance();
                                                                }
                                                                    default {
                                                                        switch (!this.consume(TokenType.RETURN_ARROW))
                                                                        {
                                                                            case (true) {
                                                                    -> this.done(f);
                                                                }
                                                                            default {};
                                                                        };
                                                                    };
                                                                };
                                                                this.fn_return(f, is_cdecl);
                                                                switch (this.failed)
                                                                {
                                                                    case (true) { -> this.done(f); }
                                                                    default
                                                                    {

                                                                        switch (this.expect2(TokenType.TAG, TokenType.COMMA))
                                                                        {
                                                                            case (true) {
                                                                            this.fn_tags(f);
                                                                            switch (this.failed)
                                                                            {
                                                                                case (true) { -> this.done(f); }
                                                                                default
                                                                                {
                                                                                    switch (this.expect(TokenType.COMMA))
                                                                                    {
                                                                                        case (true) {
                                                                                        this.strip_variadic(f);
                                                                                        this.mark_proto(f);
                                                                                        Node* extra;
                                                                                        int pflags = (flags `| 512);
                                                                                        while (this.expect(TokenType.COMMA))
                                                                                        {
                                                                                            this.advance();
                                                                                            extra = this.fn_extra_proto(m, pflags, conv, is_cdecl);
                                                                                            switch (this.failed)
                                                                                            {
                                                                                                case (true) { -> this.done(f); }
                                                                                                default
                                                                                                {
                                                                                                    switch (extra == (Node*)0)
                                                                                                    {
                                                                                                        case (true) {
                                                                                                        node_free(f);
                                                                                                        -> (Node*)0;
                                                                                                    }
                                                                                                        default
                                                                                                        {
                                                                                                            nv_push(this.pending, extra);
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                        switch (!this.consume(TokenType.SEMICOLON))
                                                                                        {
                                                                                            case (true) { -> this.done(f); }
                                                                                            default
                                                                                            {
                                                                                                -> f;
                                                                                            };
                                                                                        };
                                                                                    }
                                                                                        default {};
                                                                                    };
                                                                                };
                                                                            };
                                                                        }
                                                                            default {};
                                                                        };

                                                                        Node* pre = (Node*)0;
                                                                        Node* post;
                                                                        OpSym* as_l = (OpSym*)0;
                                                                        OpSym* as_r = (OpSym*)0;
                                                                        int as_bind;
                                                                        switch (this.expect(TokenType.COLON))
                                                                        {
                                                                            case (true) {
                                                                            this.advance();
                                                                            pre = this.mk(NodeKind.NODE_LIST, line, col);
                                                                            switch (this.failed)
                                                                            {
                                                                                case (true) { -> this.done(f); }
                                                                                default
                                                                                {
                                                                                    this.contract_refs(f, pre, false);
                                                                                    f.ival = (i64)node_count(pre, 1);
                                                                                    switch (this.failed)
                                                                                    {
                                                                                        case (true) { node_free(pre); -> this.done(f); }
                                                                                        default {};
                                                                                    };
                                                                                };
                                                                            };
                                                                        }
                                                                            default {};
                                                                        };

                                                                        this.strip_variadic(f);

                                                                        switch ((f.flags `& 4096) != 0)
                                                                        {
                                                                            case (true) {
                                                                            bool void_form = this.param_count(f) == 0 & f.ts.base_type == DataType.VOID;
                                                                            bool single_form;
                                                                            switch (this.param_count(f) == 1)
                                                                            {
                                                                                case (true) { single_form = typespec_equal(f.l0.items[0].ts, f.ts); }
                                                                                default {};
                                                                            };
                                                                            switch (!void_form & !single_form)
                                                                            {
                                                                                case (true) {
                                                                                switch (this.param_count(f) == 0)
                                                                                {
                                                                                    case (true) {
                                                                                    this.error(this.cat2(this.cat2(g"Recursive function '\0", this.fn_label(f)), g"' with no parameters must return void\0"));
                                                                                }
                                                                                    default {
                                                                                        switch (this.param_count(f) == 1)
                                                                                        {
                                                                                            case (true) {
                                                                                    this.error(this.cat2(this.cat2(g"Recursive function '\0", this.fn_label(f)), g"': return type must match parameter type\0"));
                                                                                }
                                                                                            default {
                                                                                    this.error(this.cat2(this.cat2(g"Recursive function '\0", this.fn_label(f)), g"' declared with '<~' must have exactly one parameter, or no parameters with void return\0"));
                                                                                };
                                                                                        };
                                                                                    };
                                                                                };
                                                                                node_free(pre);
                                                                                -> this.done(f);
                                                                            }
                                                                                default {};
                                                                            };
                                                                        }
                                                                            default {};
                                                                        };

                                                                        switch (this.expect(TokenType.AS))
                                                                        {
                                                                            case (true) {
                                                                            this.advance();
                                                                            switch (!this.consume(TokenType.OPERATOR))
                                                                            {
                                                                                case (true) { node_free(pre); -> this.done(f); }
                                                                                default
                                                                                {
                                                                                    as_l = this.op_bracket();
                                                                                    switch (!this.failed & this.expect(TokenType.LEFT_BRACKET))
                                                                                    {
                                                                                        case (true) { as_r = this.op_bracket(); }
                                                                                        default {};
                                                                                    };
                                                                                    switch (!this.failed & as_r == (OpSym*)0)
                                                                                    {
                                                                                        case (true) {
                                                                                        switch (this.param_count(f) == 1)
                                                                                        {
                                                                                            case (true) { as_bind = this.unary_binding(f, g"an 'as operator' binding\0"); }
                                                                                            default {};
                                                                                        };
                                                                                    }
                                                                                        default {};
                                                                                    };
                                                                                    switch (this.failed)
                                                                                    {
                                                                                        case (true) {
                                                                                        node_free(pre);
                                                                                        this.opsym_free(as_l);
                                                                                        this.opsym_free(as_r);
                                                                                        -> this.done(f);
                                                                                    }
                                                                                        default {};
                                                                                    };
                                                                                };
                                                                            };
                                                                        }
                                                                            default {};
                                                                        };

                                                                        Node* ret;
                                                                        Node* b;
                                                                        switch (this.expect2(TokenType.TAG, TokenType.SEMICOLON))
                                                                        {
                                                                            case (true) {
                                                                            this.fn_tags(f);
                                                                            switch (this.failed)
                                                                            {
                                                                                case (true) { -> this.done(f); }
                                                                                default {};
                                                                            };
                                                                            switch (this.expect(TokenType.SEMICOLON))
                                                                            {
                                                                                case (true) {
                                                                                this.advance();
                                                                                this.mark_proto(f);
                                                                            }
                                                                                default {};
                                                                            };
                                                                            node_free(pre);
                                                                            switch (!this.failed & as_l != (OpSym*)0)
                                                                            {
                                                                                case (true) { this.register_operator(f, as_l, as_r, as_bind, false, false); }
                                                                                default {};
                                                                            };
                                                                            -> this.done(f);
                                                                        }
                                                                            default
                                                                            {
                                                                                switch (this.expect(TokenType.RETURN_ARROW))
                                                                                {
                                                                                    case (true) {

                                                                                    switch (!this.begin_body(f))
                                                                                    {
                                                                                        case (true) { -> this.done(f); }
                                                                                        default {};
                                                                                    };
                                                                                    this.advance();
                                                                                    b = this.mk(NodeKind.BLOCK, this.cur_line(), this.cur_col());
                                                                                    switch (this.failed)
                                                                                    {
                                                                                        case (true) { this.end_body(); -> this.done(f); }
                                                                                        default {};
                                                                                    };
                                                                                    f.a = b;
                                                                                    ret = this.mk(NodeKind.RETURN_STATEMENT, this.cur_line(), this.cur_col());
                                                                                    switch (this.failed)
                                                                                    {
                                                                                        case (true) { this.end_body(); -> this.done(f); }
                                                                                        default {};
                                                                                    };
                                                                                    node_push(b, 0, ret);
                                                                                    this.function_depth++;

                                                                                    if (!this.expect(TokenType.SEMICOLON)) { ret.a = this.expression(); };
                                                                                    this.function_depth--;
                                                                                    this.end_body();
                                                                                    switch (!this.failed)
                                                                                    {
                                                                                        case (true) { this.consume(TokenType.SEMICOLON); }
                                                                                        default {};
                                                                                    };
                                                                                    node_free(pre);
                                                                                    switch (!this.failed & as_l != (OpSym*)0)
                                                                                    {
                                                                                        case (true) { this.register_operator(f, as_l, as_r, as_bind, false, false); }
                                                                                        default {};
                                                                                    };
                                                                                    -> this.done(f);
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        switch (this.in_trait != 0 & !this.expect(TokenType.LEFT_BRACE))
                                                                                        {
                                                                                            case (true) {
                                                                                            this.fail_expected_msg(this.cat2(g"Expected SEMICOLON, got \0", token_name(this.cur())), TokenType.SEMICOLON);
                                                                                            -> this.done(f);
                                                                                        }
                                                                                            default
                                                                                            {
                                                                                                switch (!this.begin_body(f))
                                                                                                {
                                                                                                    case (true) { -> this.done(f); }
                                                                                                    default
                                                                                                    {
                                                                                                        this.function_depth++;
                                                                                                        f.a = this.block();
                                                                                                        this.function_depth--;
                                                                                                        this.end_body();
                                                                                                        switch (this.failed)
                                                                                                        {
                                                                                                            case (true) { node_free(pre); -> this.done(f); }
                                                                                                            default
                                                                                                            {
                                                                                                                this.prepend_contracts(f, pre);

                                                                                                                post = (Node*)0;
                                                                                                                switch (this.expect(TokenType.COLON))
                                                                                                                {
                                                                                                                    case (true) {
                                                                                                                    this.advance();
                                                                                                                    post = this.mk(NodeKind.NODE_LIST, line, col);
                                                                                                                    switch (this.failed)
                                                                                                                    {
                                                                                                                        case (true) { node_free(pre); -> this.done(f); }
                                                                                                                        default
                                                                                                                        {
                                                                                                                            this.contract_refs(f, post, true);
                                                                                                                            f.op = node_count(post, 1);
                                                                                                                            switch (!this.failed)
                                                                                                                            {
                                                                                                                                case (true) { this.apply_post_contracts(f, post); }
                                                                                                                                default {};
                                                                                                                            };
                                                                                                                        };
                                                                                                                    };
                                                                                                                }
                                                                                                                    default {};
                                                                                                                };
                                                                                                                switch (!this.failed)
                                                                                                                {
                                                                                                                    case (true) { this.validate_bindings(this.fn_label(f), pre, post); }
                                                                                                                    default {};
                                                                                                                };
                                                                                                                node_free(post);
                                                                                                                node_free(pre);
                                                                                                                switch (this.failed)
                                                                                                                {
                                                                                                                    case (true) { -> this.done(f); }
                                                                                                                    default
                                                                                                                    {
                                                                                                                        this.fn_tags(f);
                                                                                                                        switch (!this.failed)
                                                                                                                        {
                                                                                                                            case (true) { this.consume(TokenType.SEMICOLON); }
                                                                                                                            default {};
                                                                                                                        };
                                                                                                                        switch (!this.failed & as_l != (OpSym*)0)
                                                                                                                        {
                                                                                                                            case (true) { this.register_operator(f, as_l, as_r, as_bind, false, false); }
                                                                                                                            default {};
                                                                                                                        };
                                                                                                                        -> this.done(f);
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };




            add_func(Node* holder, Node* f, bool want_proto) -> void
            {
                node_push(holder, 0, f);
                switch (f.kind != NodeKind.FUNCTION_DEF)
                {
                    case (true) { ->; }
                    default
                    {
                        bool is_proto = (f.flags `& 512) != 0;
                        switch (want_proto & !is_proto)
                        {
                            case (true) {
                            this.error(g"Extern functions must be prototypes (declarations only, no body)\0");
                        }
                            default {
                                switch (!want_proto & is_proto)
                                {
                                    case (true) {
                            this.error(g"'export' requires a full definition, not a prototype\0");
                        }
                                    default {};
                                };
                            };
                        };
                        ->;
                    };
                };
            };


            collect_funcs(Node* holder, bool want_proto) -> void
            {
                Node* f = this.function_def();
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        int k;
                        switch (f != (Node*)0)
                        {
                            case (true) { this.add_func(holder, f, want_proto); }
                            default {};
                        };
                        while (!this.failed & k < this.pending.len)
                        {
                            this.add_func(holder, this.pending.items[k], want_proto);
                            k++;
                        };
                        this.pending.len = 0;
                        ->;
                    };
                };
            };


            extern_item(Node* holder) -> void
            {
                switch (this.expect(TokenType.DEF) | this.is_calling_conv(this.cur()))
                {
                    case (true) {
                    -> this.collect_funcs(holder, true);
                }
                    default
                    {
                        Node* v = this.mk(NodeKind.VARIABLE_DECLARATION, this.cur_line(), this.cur_col());
                        switch (this.failed)
                        {
                            case (true) { ->; }
                            default
                            {
                                node_push(holder, 0, v);
                                v.ts = this.type_spec();
                                switch (this.failed)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        v.text = this.ident();
                                        switch (this.failed)
                                        {
                                            case (true) { ->; }
                                            default
                                            {
                                                switch (this.expect2(TokenType.ASSIGN, TokenType.ADDRESS_ASSIGN))
                                                {
                                                    case (true) {
                                                    this.error(g"Extern variable declarations cannot have an initializer\0");
                                                    ->;
                                                }
                                                    default
                                                    {
                                                        this.consume(TokenType.SEMICOLON);
                                                        ->;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            extern_statement() -> Node*
            {
                Node* n = this.mk(NodeKind.EXTERN_BLOCK, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.advance();
                        switch (this.expect(TokenType.LEFT_BRACE))
                        {
                            case (true) {
                            this.advance();
                            while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                            {
                                switch (this.expect(TokenType.EOF))
                                {
                                    case (true) {
                                    this.fail_expected(TokenType.RIGHT_BRACE);
                                    break;
                                }
                                    default
                                    {
                                        this.extern_item(n);
                                    };
                                };
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.SEMICOLON); }
                                default {};
                            };
                        }
                            default {
                            this.extern_item(n);
                        };
                        };
                        -> this.done(n);
                    };
                };
            };


            export_statement() -> Node*
            {
                Node* n = this.mk(NodeKind.EXPORT_BLOCK, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.advance();
                        switch (this.expect(TokenType.LEFT_BRACE))
                        {
                            case (true) {
                            this.advance();
                            while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                            {
                                switch (this.expect(TokenType.EOF))
                                {
                                    case (true) {
                                    this.fail_expected(TokenType.RIGHT_BRACE);
                                    break;
                                }
                                    default
                                    {
                                        switch (this.expect(TokenType.DEF) | this.is_calling_conv(this.cur()))
                                        {
                                            case (true) {
                                            this.collect_funcs(n, false);
                                        }
                                            default {
                                            this.fail_expected(TokenType.DEF);
                                        };
                                        };
                                    };
                                };
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                default {};
                            };
                            switch (!this.failed)
                            {
                                case (true) { this.consume(TokenType.SEMICOLON); }
                                default {};
                            };
                        }
                            default {
                                switch (this.expect(TokenType.DEF) | this.is_calling_conv(this.cur()))
                                {
                                    case (true) {
                            this.collect_funcs(n, false);
                        }
                                    default {
                            this.fail_expected(TokenType.LEFT_BRACE);
                        };
                                };
                            };
                        };
                        -> this.done(n);
                    };
                };
            };




            namespace_path() -> byte* { byte* path = this.ident(); byte* part;
                switch (this.failed)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        while (this.expect(TokenType.SCOPE))
                        {
                            this.advance(); part = this.ident(); switch (this.failed) { case (true) { -> (byte*)0; } default { path = this.cat2(this.cat2(path, g"__\0"), part); }; };
                        };
                        -> path;
                    };
                };
            };


            using_list(int kind) -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* first = this.mk(kind, line, col);
                switch (this.failed)
                {
                    case (true) { -> first; }
                    default
                    {
                        first.text = this.namespace_path();
                        switch (this.failed)
                        {
                            case (true) { -> this.done(first); }
                            default
                            {
                                Node* x;
                                while (this.expect(TokenType.COMMA))
                                {
                                    this.advance();
                                    x = this.mk(kind, line, col);
                                    switch (this.failed)
                                    {
                                        case (true) { -> this.done(first); }
                                        default
                                        {
                                            nv_push(this.pending, x);
                                            x.text = this.namespace_path();
                                            switch (this.failed)
                                            {
                                                case (true) { -> this.done(first); }
                                                default {};
                                            };
                                        };
                                    };
                                };
                                switch (!this.consume(TokenType.SEMICOLON))
                                {
                                    case (true) { -> this.done(first); }
                                    default
                                    {
                                        -> first;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            using_statement() -> Node*
            {
                this.advance();
                -> this.using_list(NodeKind.USING_STATEMENT);
            };


            not_using_statement() -> Node* -> this.using_list(NodeKind.NOT_USING_STATEMENT);


            is_template_list() -> bool
            {
                int m = this.mark();
                bool r = false;
                this.advance();
                switch (this.expect(TokenType.IDENTIFIER))
                {
                    case (true) {
                    this.advance();
                    while (this.expect(TokenType.COMMA))
                    {
                        this.advance();
                        switch (!this.expect(TokenType.IDENTIFIER))
                        {
                            case (true) { break; }
                            default
                            {
                                this.advance();
                            };
                        };
                    };
                    r = this.expect(TokenType.GREATER_THAN);
                }
                    default {};
                };
                this.reset(m);
                -> r;
            };



            struct_base_ref(Node* holder, int slot) -> bool
            {
                Node* r = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> false; }
                    default
                    {
                        node_push(holder, slot, r);
                        byte* name = this.ident();
                        switch (this.failed)
                        {
                            case (true) { -> false; }
                            default
                            {
                                byte* arg;
                                bool generic = false;
                                switch (this.expect(TokenType.LESS_THAN) & this.is_template_list())
                                {
                                    case (true) {
                                    generic = true;
                                    this.advance();
                                    arg = this.ident();
                                    this.sd_param_add(holder, arg);
                                    name = this.cat2(this.cat2(name, g"<\0"), arg);
                                    while (!this.failed & this.expect(TokenType.COMMA))
                                    {
                                        this.advance();
                                        arg = this.ident();
                                        this.sd_param_add(holder, arg);
                                        name = this.cat2(this.cat2(name, g",\0"), arg);
                                    };
                                    switch (!this.failed)
                                    {
                                        case (true) { this.consume(TokenType.GREATER_THAN); }
                                        default {};
                                    };
                                    name = this.cat2(name, g">\0");
                                }
                                    default {};
                                };
                                r.text = name;
                                -> generic;
                            };
                        };
                    };
                };
            };


            sd_param_add(Node* h, byte* s) -> void
            {
                int i;
                int c;
                Node* x;
                switch (this.failed | s == (byte*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        c = node_count(h, 4);
                        while (i < c)
                        {
                            switch (cstr_eq(node_child(h, 4, i).text, s))
                            {
                                case (true) { ->; }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                        x = this.mk(NodeKind.IDENTIFIER, h.line, h.col);
                        switch (this.failed)
                        {
                            case (true) { ->; }
                            default
                            {
                                x.text = s;
                                node_push(h, 4, x);
                                ->;
                            };
                        };
                    };
                };
            };


            struct_base_list(Node* holder, int slot) -> bool
            {
                bool generic = this.struct_base_ref(holder, slot);
                while (!this.failed & this.expect(TokenType.COMMA))
                {
                    this.advance();
                    switch (this.struct_base_ref(holder, slot))
                    {
                        case (true) { generic = true; }
                        default {};
                    };
                };
                -> generic;
            };



            struct_member(Node* owner, bool is_private) -> void
            {
                int line = this.cur_line();
                int col = this.cur_col();
                TypeSpec* ts = this.type_spec();
                switch (this.failed)
                {
                    case (true) {
                    -> typespec_free(ts);
                }
                    default
                    {
                        int base = 0;
                        switch (owner.l0 != (NodeVec*)0)
                        {
                            case (true) { base = owner.l0.len; }
                            default {};
                        };
                        int cnt = 0;
                        Node* mem;
                        Node* e;
                        int k;
                        bool more = true;
                        while (more)
                        {
                            mem = this.mk(NodeKind.STRUCT_MEMBER, line, col);
                            switch (this.failed)
                            {
                                case (true) {
                                switch (cnt == 0)
                                {
                                    case (true) { typespec_free(ts); }
                                    default {};
                                };
                                ->;
                            }
                                default
                                {
                                    node_push(owner, 0, mem);
                                    switch (cnt)
                                    {
                                        case (0) { mem.ts = ts; }
                                        default { mem.ts = typespec_copy(ts); };
                                    };
                                    switch (is_private)
                                    {
                                        case (true) { mem.flags = 32768; }
                                        default {};
                                    };
                                    mem.text = this.ident();
                                    switch (this.failed)
                                    {
                                        case (true) { ->; }
                                        default
                                        {
                                            cnt++;
                                            more = false;
                                            switch (this.expect(TokenType.COMMA) & this.type_at(1) == TokenType.IDENTIFIER)
                                            {
                                                case (true) {
                                                this.advance();
                                                more = true;
                                            }
                                                default {};
                                            };
                                        };
                                    };
                                };
                            };
                        };

                        switch (this.expect(TokenType.ASSIGN))
                        {
                            case (true) {
                            this.advance();
                            more = true;
                            while (more)
                            {
                                e = this.expression();
                                switch (this.failed)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        switch (k < cnt)
                                        {
                                            case (true) { owner.l0.items[base + k].a = e; }
                                            default { node_free(e); };
                                        };
                                        k++;
                                        more = false;
                                        switch (this.expect(TokenType.COMMA))
                                        {
                                            case (true) {
                                            this.advance();
                                            more = true;
                                        }
                                            default {};
                                        };
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        this.consume(TokenType.SEMICOLON);
                        ->;
                    };
                };
            };


            nested_struct(Node* owner) -> void
            {
                Node* s = this.struct_def();
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        int k;
                        switch (s != (Node*)0)
                        {
                            case (true) { node_push(owner, 3, s); }
                            default {};
                        };
                        while (k < this.pending.len)
                        {
                            node_push(owner, 3, this.pending.items[k]);
                            k++;
                        };
                        this.pending.len = 0;
                        ->;
                    };
                };
            };


            struct_section(Node* owner, bool is_private) -> void
            {
                this.advance();
                switch (!this.consume(TokenType.LEFT_BRACE))
                {
                    case (true) { ->; }
                    default
                    {
                        while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                        {
                            switch (this.expect(TokenType.EOF))
                            {
                                case (true) {
                                -> this.fail_expected(TokenType.RIGHT_BRACE);
                            }
                                default
                                {
                                    switch (this.expect(TokenType.STRUCT))
                                    {
                                        case (true) {
                                        this.nested_struct(owner);
                                        switch (!this.failed)
                                        {
                                            case (true) { this.consume(TokenType.SEMICOLON); }
                                            default {};
                                        };
                                    }
                                        default {
                                        this.struct_member(owner, is_private);
                                    };
                                    };
                                };
                            };
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.RIGHT_BRACE); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) { this.consume(TokenType.SEMICOLON); }
                            default {};
                        };
                        ->;
                    };
                };
            };





            struct_def() -> Node*
            {
                Node* n = this.mk(NodeKind.STRUCT_DEF, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        n.op = -1;
                        this.advance();
                        n.text = this.ident();
                        switch (this.failed)
                        {
                            case (true) { -> this.done(n); }
                            default
                            {
                                switch (this.expect(TokenType.LESS_THAN) & this.is_template_list())
                                {
                                    case (true) {
                                    this.advance();
                                    this.sd_param_add(n, this.ident());
                                    while (!this.failed & this.expect(TokenType.COMMA))
                                    {
                                        this.advance();
                                        this.sd_param_add(n, this.ident());
                                    };
                                    switch (!this.failed)
                                    {
                                        case (true) { this.consume(TokenType.GREATER_THAN); }
                                        default {};
                                    };
                                    switch (this.failed)
                                    {
                                        case (true) { -> this.done(n); }
                                        default {};
                                    };
                                }
                                    default {};
                                };

                                PtrVec* names = pv_new();
                                while (this.expect(TokenType.COMMA))
                                {
                                    this.advance();
                                    pv_push(names, (void*)this.ident());
                                    switch (this.failed)
                                    {
                                        case (true) { pv_free(names); -> this.done(n); }
                                        default {};
                                    };
                                };

                                switch (this.expect(TokenType.COLON))
                                {
                                    case (true) {
                                    this.advance();
                                    this.struct_base_list(n, 1);
                                    switch (!this.failed & this.expect(TokenType.COLON))
                                    {
                                        case (true) {
                                        this.advance();
                                        this.struct_base_list(n, 2);
                                    }
                                        default {};
                                    };
                                    switch (this.failed)
                                    {
                                        case (true) { pv_free(names); -> this.done(n); }
                                        default
                                        {
                                            switch (this.expect(TokenType.SEMICOLON))
                                            {
                                                case (true) {
                                                this.advance();
                                                pv_free(names);
                                                -> n;
                                            }
                                                default {};
                                            };
                                        };
                                    };
                                }
                                    default {};
                                };

                                int line = n.line;
                                int col = n.col;
                                Node* x;
                                int k;
                                bool has_base = false;
                                switch (n.l1 != (NodeVec*)0)
                                {
                                    case (true) { has_base = n.l1.len > 0; }
                                    default {};
                                };
                                switch (this.expect(TokenType.SEMICOLON) & !has_base)
                                {
                                    case (true) {
                                    this.advance();
                                    switch (n.l4 != (NodeVec*)0)
                                    {
                                        case (true) { n.l4.len = 0; }
                                        default {};
                                    };
                                    while (k < names.len)
                                    {
                                        x = this.mk(NodeKind.STRUCT_DEF, line, col);
                                        switch (this.failed)
                                        {
                                            case (true) { pv_free(names); -> this.done(n); }
                                            default {};
                                        };
                                        x.op = -1;
                                        x.text = (byte*)names.items[k];
                                        nv_push(this.pending, x);
                                        k++;
                                    };
                                    pv_free(names);
                                    -> n;
                                }
                                    default
                                    {
                                        switch (names.len > 0)
                                        {
                                            case (true) {
                                            pv_free(names);
                                            this.error(g"Comma-separated names are only allowed for prototypes (forward declarations)\0");
                                            -> this.done(n);
                                        }
                                            default
                                            {
                                                pv_free(names);

                                                switch (!this.consume(TokenType.LEFT_BRACE))
                                                {
                                                    case (true) { -> this.done(n); }
                                                    default
                                                    {
                                                        Node* cb;
                                                        while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                                                        {
                                                            switch (this.expect(TokenType.EOF))
                                                            {
                                                                case (true) {
                                                                this.fail_expected(TokenType.RIGHT_BRACE);
                                                                break;
                                                            }
                                                                default
                                                                {
                                                                    switch (this.expect(TokenType.PUBLIC))
                                                                    {
                                                                        case (true) { this.struct_section(n, false); }
                                                                        default {
                                                                            switch (this.expect(TokenType.PRIVATE))
                                                                            {
                                                                                case (true) { this.struct_section(n, true); }
                                                                                default {
                                                                                    switch (this.expect(TokenType.STRUCT))
                                                                                    {
                                                                                        case (true) { this.nested_struct(n); }
                                                                                        default {
                                                                                            switch (this.expect(TokenType.COMPTIME))
                                                                                            {
                                                                                                case (true) {
                                                                        cb = this.comptime_block();
                                                                        switch (this.failed)
                                                                        {
                                                                            case (true) { break; }
                                                                            default
                                                                            {
                                                                                switch (n.l0 != (NodeVec*)0)
                                                                                {
                                                                                    case (true) { cb.ival = n.l0.len; }
                                                                                    default {};
                                                                                };
                                                                                node_push(n, 5, cb);
                                                                            };
                                                                        };
                                                                    }
                                                                                                default { this.struct_member(n, false); };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                        switch (this.failed)
                                                        {
                                                            case (true) { -> this.done(n); }
                                                            default
                                                            {
                                                                this.consume(TokenType.RIGHT_BRACE);

                                                                switch (!this.failed & this.expect(TokenType.COLON))
                                                                {
                                                                    case (true) {
                                                                    this.advance();
                                                                    this.struct_base_list(n, 2);
                                                                }
                                                                    default {};
                                                                };
                                                                switch (!this.failed)
                                                                {
                                                                    case (true) { this.consume(TokenType.SEMICOLON); }
                                                                    default {};
                                                                };
                                                                switch (this.failed)
                                                                {
                                                                    case (true) { -> this.done(n); }
                                                                    default
                                                                    {
                                                                        switch (node_count(n, 4) > 0)
                                                                        {
                                                                            case (true) {
                                                                            TemplateEntry* te = te_new();
                                                                            int ti;
                                                                            int tc = node_count(n, 4);
                                                                            while (ti < tc)
                                                                            {
                                                                                pv_push(te.params, (void*)this.own(ts_dup(node_child(n, 4, ti).text)));
                                                                                ti++;
                                                                            };
                                                                            this.last_template = n.text;
                                                                            switch (this.in_comptime > 0)
                                                                            {
                                                                                case (true) {
                                                                                this.register_template(n.text, 1, te, node_clone(n));
                                                                                -> n;
                                                                            }
                                                                                default {};
                                                                            };
                                                                            this.register_template(n.text, 1, te, n);
                                                                            -> (Node*)0;
                                                                        }
                                                                            default
                                                                            {
                                                                                -> n;
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };




            ns_list(Node* ns, int which) -> Node*
            {
                Node* l;
                switch (which)
                {
                    case (0) { l = ns.a; }
                    case (1) { l = ns.b; }
                    default { l = ns.c; };
                };
                switch (l != (Node*)0)
                {
                    case (true) { -> l; }
                    default
                    {
                        l = this.mk(NodeKind.NODE_LIST, ns.line, ns.col);
                        switch (this.failed)
                        {
                            case (true) { -> l; }
                            default
                            {
                                switch (which)
                                {
                                    case (0) { ns.a = l; }
                                    case (1) { ns.b = l; }
                                    default { ns.c = l; };
                                };
                                -> l;
                            };
                        };
                    };
                };
            };


            ns_slot(Node* x) -> int
            {
                int k = x.kind;
                switch (k == NodeKind.FUNCTION_DEF)
                {
                    case (true) { -> 0; }
                    default
                    {
                        switch (k == NodeKind.STRUCT_DEF)
                        {
                            case (true) { -> 1; }
                            default
                            {
                                switch (k == NodeKind.OBJECT_DEF | k == NodeKind.TRAIT_DEF | k == NodeKind.INTERFACE_DEF)
                                {
                                    case (true) { -> 2; }
                                    default
                                    {
                                        switch (k == NodeKind.ENUM_DEF | k == NodeKind.ENUM_DEF_STATEMENT)
                                        {
                                            case (true) { -> 3; }
                                            default
                                            {
                                                switch (k == NodeKind.UNION_DEF | k == NodeKind.UNION_DEF_STATEMENT)
                                                {
                                                    case (true) { -> 4; }
                                                    default
                                                    {
                                                        switch (k == NodeKind.EXTERN_BLOCK)
                                                        {
                                                            case (true) { -> 5; }
                                                            default
                                                            {
                                                                -> -1;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            define_in_namespace(byte* name, int kind, TypeSpec* ts) -> void
            {
                switch (this.st == (IDKC_SYMTABLE*)0 | name == (byte*)0 | this.ns_path == (byte*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        st_define(this.st, this.cat2(this.cat2(this.ns_path, g"__\0"), name), kind, ts, (Node*)0);
                        switch (kind != SymbolKind.VARIABLE)
                        {
                            case (true) { st_define(this.st, name, kind, ts, (Node*)0); }
                            default {};
                        };
                        ->;
                    };
                };
            };


            unwrap_def(Node* x) -> Node*
            {
                switch (x.kind != NodeKind.ENUM_DEF_STATEMENT & x.kind != NodeKind.UNION_DEF_STATEMENT)
                {
                    case (true) { -> x; }
                    default
                    {
                        switch (x.a == (Node*)0)
                        {
                            case (true) { -> x; }
                            default
                            {
                                Node* d = x.a;
                                x.a = (Node*)0;
                                node_free(x);
                                -> d;
                            };
                        };
                    };
                };
            };


            ns_add(Node* ns, Node* x0) -> void
            {
                Node* x = this.unwrap_def(x0);
                int slot = this.ns_slot(x);
                Node* l;
                switch (slot >= 0)
                {
                    case (true) { node_push(ns, slot, x); }
                    default {
                    l = this.ns_list(ns, 0);
                    switch (this.failed)
                    {
                        case (true) { ->; }
                        default
                        {
                            node_push(l, 0, x);
                        };
                    };
                };
                };
                switch ((x.flags `& 65536) != 0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (x.kind)
                        {
                            case (NodeKind.FUNCTION_DEF) { this.define_in_namespace(x.text, SymbolKind.FUNCTION, (TypeSpec*)0); }
                            case (NodeKind.STRUCT_DEF) { this.define_in_namespace(x.text, SymbolKind.TYPE, (TypeSpec*)0); }
                            case (NodeKind.ENUM_DEF) { this.define_in_namespace(x.text, SymbolKind.ENUM, (TypeSpec*)0); }
                            case (NodeKind.UNION_DEF) { this.define_in_namespace(x.text, SymbolKind.UNION, (TypeSpec*)0); }
                            case (NodeKind.VARIABLE_DECLARATION) { this.define_in_namespace(x.text, SymbolKind.VARIABLE, x.ts); }
                            default {};
                        };
                        ->;
                    };
                };
            };


            ns_add_all(Node* ns, Node* x) -> void
            {
                int k;
                switch (x != (Node*)0)
                {
                    case (true) { this.ns_add(ns, x); }
                    default {};
                };
                while (!this.failed & k < this.pending.len)
                {
                    this.ns_add(ns, this.pending.items[k]);
                    k++;
                };
                this.pending.len = 0;
                ->;
            };


            move_items(NodeVec* src, Node* dst, int slot) -> void
            {
                switch (src == (NodeVec*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        int i;
                        while (i < src.len)
                        {
                            node_push(dst, slot, src.items[i]);
                            i++;
                        };
                        src.len = 0;
                        ->;
                    };
                };
            };


            ns_nest(Node* ns, Node* x) -> void
            {
                switch (x == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        Node* lst = this.ns_list(ns, 1);
                        switch (this.failed)
                        {
                            case (true) { -> node_free(x); }
                            default
                            {
                                Node* ex;
                                Node* dl;
                                int i, s;
                                int total;
                                switch (lst.l0 != (NodeVec*)0)
                                {
                                    case (true) { total = lst.l0.len; }
                                    default {};
                                };
                                while (i < total)
                                {
                                    ex = lst.l0.items[i];
                                    switch (ex.text != (byte*)0 & x.text != (byte*)0)
                                    {
                                        case (true) {
                                        switch (cstr_eq(ex.text, x.text))
                                        {
                                            case (true) {
                                            s = 0;
                                            while (s < 5)
                                            {
                                                switch (s)
                                                {
                                                    case (0) { this.move_items(x.l0, ex, 0); }
                                                    case (1) { this.move_items(x.l1, ex, 1); }
                                                    case (2) { this.move_items(x.l2, ex, 2); }
                                                    case (3) { this.move_items(x.l3, ex, 3); }
                                                    default { this.move_items(x.l4, ex, 4); };
                                                };
                                                s++;
                                            };
                                            s = 0;
                                            while (s < 3)
                                            {
                                                switch (s)
                                                {
                                                    case (0) { dl = x.a; }
                                                    case (1) { dl = x.b; }
                                                    default { dl = x.c; };
                                                };
                                                switch (dl != (Node*)0)
                                                {
                                                    case (true) {
                                                    this.move_items(dl.l0, this.ns_list(ex, s), 0);
                                                }
                                                    default {};
                                                };
                                                s++;
                                            };
                                            -> node_free(x);
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    i++;
                                };
                                node_push(lst, 0, x);
                                ->;
                            };
                        };
                    };
                };
            };



            ns_tmpl_alias(Node* x) -> void
            {
                byte* bare = this.last_template;
                switch (x != (Node*)0 | bare == (byte*)0 | this.ns_path == (byte*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        this.template_alias(this.cat2(this.cat2(this.ns_path, g"__\0"), bare), bare);
                        -> this.template_alias(this.cat2(this.cat2(this.ns_path, g"::\0"), bare), bare);
                    };
                };
            };

            ns_item(Node* ns) -> void
            {
                int c = this.cur();
                Node* x;
                switch (c == TokenType.GLOBAL | c == TokenType.LOCAL | c == TokenType.HEAP | c == TokenType.STACK |
                    c == TokenType.REGISTER | c == TokenType.SINGINIT | c == TokenType.CONST | c == TokenType.VOLATILE)
                {
                    case (true) {
                    x = this.variable_declaration();
                    switch (this.failed)
                    {
                        case (true) { ->; }
                        default
                        {
                            this.ns_add_all(ns, x);
                            this.consume(TokenType.SEMICOLON);
                        };
                    };
                }
                    default {
                        switch (this.expect3(TokenType.INLINE, TokenType.DEF, TokenType.NO_MANGLE) | this.is_calling_conv(c) | this.is_bare_function_def())
                        {
                            case (true) {
                    this.last_template = (byte*)0;
                    x = this.function_def();
                    switch (this.failed)
                    {
                        case (true) { ->; }
                        default
                        {
                            this.ns_tmpl_alias(x);
                            this.ns_add_all(ns, x);
                        };
                    };
                }
                            default {
                    switch (c)
                    {
                        case (TokenType.STRUCT)
                        {
                            x = this.struct_def();
                            switch (this.failed)
                            {
                                case (true) { ->; }
                                default
                                {
                                    this.ns_tmpl_alias(x);
                                    this.ns_add_all(ns, x);
                                };
                            };
                        }
                        case (TokenType.OBJECT)
                        {
                            x = this.object_def();
                            switch (this.failed)
                            {
                                case (true) { ->; }
                                default
                                {
                                    this.ns_tmpl_alias(x);
                                    this.ns_add_all(ns, x);
                                };
                            };
                        }
                        case (TokenType.TRAIT)
                        {
                            x = this.trait_def();
                            switch (this.failed)
                            {
                                case (true) { ->; }
                                default
                                {
                                    this.ns_add_all(ns, x);
                                };
                            };
                        }
                        case (TokenType.INTERFACE)
                        {
                            x = this.interface_def();
                            switch (this.failed)
                            {
                                case (true) { ->; }
                                default
                                {
                                    this.ns_add_all(ns, x);
                                };
                            };
                        }
                        default
                        {
                            switch (this.is_trait_prefixed_object())
                            {
                                case (true) {
                                x = this.trait_prefixed_object();
                                switch (this.failed)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        this.ns_tmpl_alias(x);
                                        this.ns_add_all(ns, x);
                                    };
                                };
                            }
                                default {
                                    switch (c == TokenType.ENUM | this.type_at(1) == TokenType.ENUM)
                                    {
                                        case (true) {
                                x = this.enum_def();
                                switch (this.failed)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        this.ns_add_all(ns, x);
                                    };
                                };
                            }
                                        default {
                                switch (c)
                                {
                                    case (TokenType.UNION)
                                    {
                                        x = this.union_def();
                                        switch (this.failed)
                                        {
                                            case (true) { ->; }
                                            default
                                            {
                                                this.ns_add_all(ns, x);
                                            };
                                        };
                                    }
                                    case (TokenType.OPERATOR)
                                    {
                                        x = this.operator_def();
                                        switch (this.failed)
                                        {
                                            case (true) { ->; }
                                            default
                                            {
                                                this.ns_add_all(ns, x);
                                            };
                                        };
                                    }
                                    case (TokenType.EXTERN)
                                    {
                                        x = this.extern_statement();
                                        switch (this.failed)
                                        {
                                            case (true) { ->; }
                                            default
                                            {
                                                this.ns_add_all(ns, x);
                                            };
                                        };
                                    }
                                    case (TokenType.NAMESPACE)
                                    {
                                        x = this.namespace_def();
                                        switch (this.failed)
                                        {
                                            case (true) { ->; }
                                            default
                                            {
                                                this.ns_nest(ns, x);
                                            };
                                        };
                                    }
                                    case (TokenType.IF)
                                    {
                                        x = this.if_statement();
                                        node_free(x);
                                    }
                                    default
                                    {
                                        switch (this.is_variable_declaration())
                                        {
                                            case (true) {
                                            x = this.variable_declaration();
                                            switch (this.failed)
                                            {
                                                case (true) { ->; }
                                                default
                                                {
                                                    this.ns_add_all(ns, x);
                                                    this.consume(TokenType.SEMICOLON);
                                                };
                                            };
                                        }
                                            default {
                                            this.error_exp(g"Expected function, struct, object, namespace, enum, union, or variable declaration\0", TokenType.DEF);
                                        };
                                        };
                                    };
                                };
                            };
                                    };
                                };
                            };
                        };
                    };
                };
                        };
                    };
                };
                ->;
            };


            namespace_def() -> Node*
            {
                Node* n = this.mk(NodeKind.NAMESPACE_DEF, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> n; }
                    default
                    {
                        this.advance();
                        n.text = this.ident();
                        switch (this.failed)
                        {
                            case (true) { -> this.done(n); }
                            default
                            {
                                byte* saved = this.ns_path;
                                switch (saved == (byte*)0)
                                {
                                    case (true) { this.ns_path = n.text; }
                                    default { this.ns_path = this.cat2(this.cat2(saved, g"__\0"), n.text); };
                                };

                                Node* l;
                                Node* b;
                                switch (this.expect(TokenType.COLON))
                                {
                                    case (true) {
                                    this.advance();
                                    l = this.ns_list(n, 2);
                                    bool more = !this.failed;
                                    while (more)
                                    {
                                        b = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                                        switch (this.failed)
                                        {
                                            case (true) { break; }
                                            default
                                            {
                                                node_push(l, 0, b);
                                                b.text = this.ident();
                                                switch (this.failed)
                                                {
                                                    case (true) { break; }
                                                    default
                                                    {
                                                        more = false;
                                                        switch (this.expect(TokenType.COMMA))
                                                        {
                                                            case (true) {
                                                            this.advance();
                                                            more = true;
                                                        }
                                                            default {};
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                }
                                    default {};
                                };

                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.LEFT_BRACE); }
                                    default {};
                                };
                                while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                                {
                                    if (this.is_module_def())
                                    {
                                        this.error(g"A module can only be declared at the top level, not inside a function, namespace, or another module\0");
                                        break;
                                    };
                                    switch (this.expect(TokenType.EOF))
                                    {
                                        case (true) {
                                        this.fail_expected(TokenType.RIGHT_BRACE);
                                        break;
                                    }
                                        default
                                        {
                                            this.ns_item(n);
                                        };
                                    };
                                };
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                    default {};
                                };
                                switch (!this.failed)
                                {
                                    case (true) { this.consume(TokenType.SEMICOLON); }
                                    default {};
                                };
                                this.ns_path = saved;
                                -> this.done(n);
                            };
                        };
                    };
                };
            };




            enum_node(byte* name, TypeSpec* ts, int line, int col) -> Node*
            {
                Node* s = this.mk(NodeKind.ENUM_DEF_STATEMENT, line, col);
                switch (this.failed)
                {
                    case (true) { -> s; }
                    default
                    {
                        Node* d = this.mk(NodeKind.ENUM_DEF, line, col);
                        switch (this.failed)
                        {
                            case (true) { node_free(s); -> d; }
                            default
                            {
                                s.a = d;
                                d.text = name;
                                switch (ts != (TypeSpec*)0)
                                {
                                    case (true) { d.ts = typespec_copy(ts); }
                                    default {};
                                };
                                -> s;
                            };
                        };
                    };
                };
            };




            enum_def() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* s = this.mk(NodeKind.ENUM_DEF_STATEMENT, line, col);
                switch (this.failed)
                {
                    case (true) { -> s; }
                    default
                    {
                        Node* d = this.mk(NodeKind.ENUM_DEF, line, col);
                        switch (this.failed)
                        {
                            case (true) { node_free(s); -> d; }
                            default
                            {
                                s.a = d;

                                switch (!this.expect(TokenType.ENUM))
                                {
                                    case (true) { d.ts = this.type_spec(); }
                                    default {};
                                };
                                switch (this.failed)
                                {
                                    case (true) { -> this.done(s); }
                                    default
                                    {
                                        switch (!this.consume(TokenType.ENUM)) { case (true) { -> this.done(s); } default { d.text = this.ident_msg(this.cat2(this.cat2(this.cat2(this.cat2(g"Expected: enumurated list name after enum keyword at Line \0", this.int_commas(this.cur_line())), g":\0"), this.int_str(this.cur_col())), g" in build\\tmp.idk\0"));
                                                switch (this.failed)
                                                {
                                                    case (true) { -> this.done(s); }
                                                    default
                                                    {
                                                        PtrVec* names = pv_new();
                                                        while (this.expect(TokenType.COMMA))
                                                        {
                                                            this.advance();
                                                            pv_push(names, (void*)this.ident());
                                                            switch (this.failed)
                                                            {
                                                                case (true) {
                                                                pv_free(names);
                                                                -> this.done(s);
                                                            }
                                                                default {};
                                                            };
                                                        };

                                                        Node* x;
                                                        int k;
                                                        switch (this.expect(TokenType.SEMICOLON))
                                                        {
                                                            case (true) {
                                                            this.advance();
                                                            while (k < names.len)
                                                            {
                                                                x = this.enum_node((byte*)names.items[k], d.ts, line, col);
                                                                switch (this.failed)
                                                                {
                                                                    case (true) {
                                                                    pv_free(names);
                                                                    -> this.done(s);
                                                                }
                                                                    default {};
                                                                };
                                                                nv_push(this.pending, x);
                                                                k++;
                                                            };
                                                            pv_free(names);
                                                            -> s;
                                                        }
                                                            default
                                                            {
                                                                switch (names.len > 0)
                                                                {
                                                                    case (true) {
                                                                    pv_free(names);
                                                                    this.error(g"Comma-separated names are only allowed for prototypes (forward declarations)\0");
                                                                    -> this.done(s);
                                                                }
                                                                    default
                                                                    {
                                                                        pv_free(names);

                                                                        switch (!this.consume(TokenType.LEFT_BRACE))
                                                                        {
                                                                            case (true) { -> this.done(s); }
                                                                            default
                                                                            {
                                                                                i64 current = 0;
                                                                                bool ok;
                                                                                Node* item;
                                                                                while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                                                                                {
                                                                                    switch (this.expect(TokenType.EOF))
                                                                                    {
                                                                                        case (true) {
                                                                                        this.fail_expected(TokenType.RIGHT_BRACE);
                                                                                        break;
                                                                                    }
                                                                                        default
                                                                                        {
                                                                                            item = this.mk(NodeKind.IDENTIFIER, this.cur_line(), this.cur_col());
                                                                                            switch (this.failed)
                                                                                            {
                                                                                                case (true) { break; }
                                                                                                default
                                                                                                {
                                                                                                    node_push(d, 0, item);
                                                                                                    item.text = this.ident();
                                                                                                    switch (this.failed)
                                                                                                    {
                                                                                                        case (true) { break; }
                                                                                                        default
                                                                                                        {
                                                                                                            switch (this.expect(TokenType.ASSIGN))
                                                                                                            {
                                                                                                                case (true) {
                                                                                                                this.advance();
                                                                                                                switch (!this.expect(TokenType.SINT_LITERAL))
                                                                                                                {
                                                                                                                    case (true) {
                                                                                                                    this.fail_expected(TokenType.SINT_LITERAL);
                                                                                                                    break;
                                                                                                                }
                                                                                                                    default
                                                                                                                    {
                                                                                                                        ok = true;
                                                                                                                        current = this.parse_int(this.cur_value(), @ok);
                                                                                                                        this.advance();
                                                                                                                    };
                                                                                                                };
                                                                                                            }
                                                                                                                default {};
                                                                                                            };
                                                                                                            item.ival = current;
                                                                                                            current++;
                                                                                                            switch (this.expect(TokenType.COMMA))
                                                                                                            {
                                                                                                                case (true) { this.advance(); }
                                                                                                                default {
                                                                                                                    switch (!this.expect(TokenType.RIGHT_BRACE))
                                                                                                                    {
                                                                                                                        case (true) {
                                                                                                                this.error_exp(g"Expected ',' or '}' in enum definition\0", TokenType.COMMA);
                                                                                                            }
                                                                                                                        default {};
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                                switch (!this.failed)
                                                                                {
                                                                                    case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                                                                    default {};
                                                                                };
                                                                                switch (!this.failed)
                                                                                {
                                                                                    case (true) { this.consume(TokenType.SEMICOLON); }
                                                                                    default {};
                                                                                };
                                                                                -> this.done(s);
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            union_member(Node* d) -> void
            {
                Node* m = this.mk(NodeKind.UNION_MEMBER, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        node_push(d, 0, m);
                        m.ts = this.type_spec();
                        switch (this.failed)
                        {
                            case (true) { ->; }
                            default
                            {
                                m.text = this.ident();
                                switch (this.failed)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        switch (this.expect(TokenType.ASSIGN))
                                        {
                                            case (true) {
                                            this.advance();
                                            m.a = this.expression();
                                            switch (this.failed)
                                            {
                                                case (true) { ->; }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        this.consume(TokenType.SEMICOLON);
                                        ->;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            union_def() -> Node*
            {
                int line = this.cur_line();
                int col = this.cur_col();
                Node* s = this.mk(NodeKind.UNION_DEF_STATEMENT, line, col);
                switch (this.failed)
                {
                    case (true) { -> s; }
                    default
                    {
                        Node* d = this.mk(NodeKind.UNION_DEF, line, col);
                        switch (this.failed)
                        {
                            case (true) { node_free(s); -> d; }
                            default
                            {
                                s.a = d;
                                this.advance();
                                d.text = this.ident();
                                switch (this.failed)
                                {
                                    case (true) { -> this.done(s); }
                                    default
                                    {
                                        switch (this.expect(TokenType.SEMICOLON))
                                        {
                                            case (true) {
                                            this.advance();
                                            -> s;
                                        }
                                            default
                                            {
                                                switch (!this.consume(TokenType.LEFT_BRACE))
                                                {
                                                    case (true) { -> this.done(s); }
                                                    default
                                                    {
                                                        while (!this.failed & !this.expect(TokenType.RIGHT_BRACE))
                                                        {
                                                            switch (this.expect(TokenType.EOF))
                                                            {
                                                                case (true) {
                                                                this.fail_expected(TokenType.RIGHT_BRACE);
                                                                break;
                                                            }
                                                                default
                                                                {
                                                                    this.union_member(d);
                                                                };
                                                            };
                                                        };
                                                        switch (!this.failed)
                                                        {
                                                            case (true) { this.consume(TokenType.RIGHT_BRACE); }
                                                            default {};
                                                        };
                                                        switch (!this.failed & this.expect(TokenType.TAG))
                                                        {
                                                            case (true) {
                                                            this.advance();
                                                            d.text2 = this.ident();
                                                        }
                                                            default {};
                                                        };
                                                        switch (!this.failed)
                                                        {
                                                            case (true) { this.consume(TokenType.SEMICOLON); }
                                                            default {};
                                                        };
                                                        -> this.done(s);
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            error3(byte* a, byte* b, byte* c) -> void -> this.error(this.cat2(this.cat2(a, b), c));

            error3_exp(byte* a, byte* b, byte* c, int t) -> void -> this.error_exp(this.cat2(this.cat2(a, b), c), t);


            find_trait(byte* name) -> Node*
            {
                int i;
                Node* t;
                while (i < this.trait_defs.len)
                {
                    t = (Node*)this.trait_defs.items[i];
                    switch (cstr_eq(t.text, name))
                    {
                        case (true) { -> t; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> (Node*)0;
            };


            find_method(Node* o, byte* name) -> Node*
            {
                switch (o.l1 == (NodeVec*)0)
                {
                    case (true) { -> (Node*)0; }
                    default
                    {
                        int i;
                        Node* m;
                        while (i < o.l1.len)
                        {
                            m = o.l1.items[i];
                            switch (m.kind == NodeKind.FUNCTION_DEF & m.text != (byte*)0)
                            {
                                case (true) {
                                switch (cstr_eq(m.text, name))
                                {
                                    case (true) { -> m; }
                                    default {};
                                };
                            }
                                default {};
                            };
                            i++;
                        };
                        -> (Node*)0;
                    };
                };
            };


            explicit_params(Node* f) -> int
            {
                int n, i;
                Node* p;
                while (i < this.param_count(f))
                {
                    p = f.l0.items[i];
                    switch (p.text == (byte*)0)
                    {
                        case (true) { n++; }
                        default {
                            switch (!cstr_eq(p.text, g"this\0"))
                            {
                                case (true) { n++; }
                                default {};
                            };
                        };
                    };
                    i++;
                };
                -> n;
            };

            method_start(int off) -> bool
            {
                int t = this.type_at(off);
                -> t == TokenType.INLINE | t == TokenType.DEF | t == TokenType.ASYNC | this.is_calling_conv(t);
            };


            template_stub() -> Node*
            {
                Node* s = this.mk(NodeKind.FUNCTION_DEF, this.cur_line(), this.cur_col());
                switch (this.failed)
                {
                    case (true) { -> s; }
                    default
                    {
                        s.text = this.last_template;
                        TemplateEntry* te = this.template_lookup(this.last_template);
                        switch (te != (TemplateEntry*)0)
                        {
                            case (true) {
                            switch (te.node != (Node*)0)
                            {
                                case (true) {
                                switch (te.node.ts != (TypeSpec*)0)
                                {
                                    case (true) { s.ts = typespec_copy(te.node.ts); }
                                    default {};
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                        this.mark_proto(s);
                        s.flags = s.flags `| 524288;
                        -> s;
                    };
                };
            };

            add_method(Node* o, Node* m, bool is_private, byte* friend_name, int ovr) -> void
            {
                switch (is_private)
                {
                    case (true) { m.flags = m.flags `| 32768; }
                    default {};
                };
                m.flags = m.flags `| ovr;
                switch (friend_name != (byte*)0)
                {
                    case (true) { m.text3 = friend_name; }
                    default {};
                };
                node_push(o, 1, m);
                ->;
            };


            collect_method(Node* o, bool is_private, byte* friend_name, int ovr) -> void
            {
                this.last_template = (byte*)0;
                Node* m = this.function_def();
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        int k;
                        switch (m == (Node*)0)
                        {
                            case (true) {
                            switch (this.last_template == (byte*)0)
                            {
                                case (true) {
                                this.error(g"Internal: template method registered no name\0");
                                ->;
                            }
                                default
                                {
                                    switch (o.text != (byte*)0)
                                    {
                                        case (true) {
                                        this.template_alias(this.cat2(this.cat2(o.text, g".\0"), this.last_template), this.last_template);
                                    }
                                        default {};
                                    };
                                    m = this.template_stub();
                                    switch (this.failed)
                                    {
                                        case (true) { ->; }
                                        default {};
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        this.add_method(o, m, is_private, friend_name, ovr);
                        while (k < this.pending.len)
                        {
                            this.add_method(o, this.pending.items[k], is_private, friend_name, ovr);
                            k++;
                        };
                        this.pending.len = 0;
                        ->;
                    };
                };
            };


            nested_push(Node* o, int slot, Node* x, bool is_private) -> void
            {
                int k;
                switch (x != (Node*)0)
                {
                    case (true) {
                    switch (is_private)
                    {
                        case (true) { x.flags = x.flags `| 32768; }
                        default {};
                    };
                    node_push(o, slot, x);
                }
                    default {};
                };
                while (k < this.pending.len)
                {
                    x = this.pending.items[k];
                    switch (is_private)
                    {
                        case (true) { x.flags = x.flags `| 32768; }
                        default {};
                    };
                    node_push(o, slot, x);
                    k++;
                };
                this.pending.len = 0;
                ->;
            };


            field_members(Node* o, bool is_private, byte* friend_name) -> void
            {
                Node* v = this.variable_declaration();
                switch (this.failed)
                {
                    case (true) { ->; }
                    default
                    {
                        int k;
                        switch (v != (Node*)0)
                        {
                            case (true) {
                            v.kind = NodeKind.STRUCT_MEMBER;
                            v.flags = 0;
                            switch (is_private)
                            {
                                case (true) { v.flags = 32768; }
                                default {};
                            };
                            v.text2 = friend_name;
                            node_push(o, 0, v);
                        }
                            default {};
                        };
                        while (k < this.pending.len)
                        {
                            v = this.pending.items[k];
                            v.kind = NodeKind.STRUCT_MEMBER;
                            v.flags = 0;
                            switch (is_private)
                            {
                                case (true) { v.flags = 32768; }
                                default {};
                            };
                            v.text2 = friend_name;
                            node_push(o, 0, v);
                            k++;
                        };
                        this.pending.len = 0;
                        this.consume(TokenType.SEMICOLON);
                        ->;
                    };
                };
            };


            object_member(Node* o, bool is_private, byte* friend_name) -> void
            {



                if (this.expect2(TokenType.IDENTIFIER, TokenType.THIS) & this.type_at(1) == TokenType.LEFT_BRACE)
                {
                    int bl = this.cur_line();
                    int bc = this.cur_col();
                    Node* base = this.mk(NodeKind.IDENTIFIER, bl, bc);
                    if (this.failed) { return; };
                    base.text = g"this\0";
                    if (this.expect(TokenType.IDENTIFIER))
                    {
                        Node* mem = this.mk(NodeKind.MEMBER_ACCESS, bl, bc);
                        if (this.failed) { return; };
                        mem.a = base;
