        fvm_lz_compress(byte* d, int n, FvmBuf* out) -> bool
        {
            int* head = (int*)fvm_alloc(4096 * 4);
            int* prev = (int*)fvm_alloc((n + 1) * 4);
            byte[16] grp = noinit;
            int i, k, c, h, e, best, boff, maxl, tried, ctl, nbit, gl;
            switch (head == (int*)0 | prev == (int*)0)
            {
                case (true) {
                    switch (head != (int*)0) { case (true) { ffree((byte*)head); } default {}; };
                    switch (prev != (int*)0) { case (true) { ffree((byte*)prev); } default {}; };
                    -> false;
                }
                default {};
            };
            i = 0;
            while (i < 4096) { head[i] = -1; i++; };
            i = 0;
            while (i < n) { prev[i] = -1; i++; };
            i = 0;
            while (i < n)
            {
                best = 0;
                boff = 0;
                switch (i + 2 < n)
                {
                    case (true) {
                        c = head[fvm_lz_hash((int)d[i], (int)d[i + 1], (int)d[i + 2])];
                        maxl = 18;
                        switch (n - i < maxl) { case (true) { maxl = n - i; } default {}; };
                        tried = 0;
                        while (c >= 0 & tried < 64 & i - c <= 4096)
                        {
                            k = 0;
                            while (k < maxl & d[c + k] == d[i + k]) { k++; };
                            switch (k > best)
                            {
                                case (true) {
                                    best = k;
                                    boff = i - c;
                                }
                                default {};
                            };
                            switch (best == maxl)
                            {
                                case (true) { c = -1; }
                                default
                                {
                                    c = prev[c];
                                    tried++;
                                };
                            };
                        };
                    }
                    default {};
                };
                switch (best >= 3)
                {
                    case (true) {
                        ctl = ctl `| (1 << nbit);
                        grp[gl] = (byte)((boff - 1) `& 255);
                        grp[gl + 1] = (byte)((((boff - 1) >> 8) << 4) `| (best - 3));
                        gl = gl + 2;
                        k = 0;
                        while (k < best)
                        {
                            e = i + k;
                            switch (e + 2 < n)
                            {
                                case (true) {
                                    h = fvm_lz_hash((int)d[e], (int)d[e + 1], (int)d[e + 2]);
                                    prev[e] = head[h];
                                    head[h] = e;
                                }
                                default {};
                            };
                            k++;
                        };
                        i = i + best;
                    }
                    default
                    {
                        grp[gl] = d[i];
                        gl++;
                        switch (i + 2 < n)
                        {
                            case (true) {
                                h = fvm_lz_hash((int)d[i], (int)d[i + 1], (int)d[i + 2]);
                                prev[i] = head[h];
                                head[h] = i;
                            }
                            default {};
                        };
                        i++;
                    };
                };
                nbit++;
                switch (nbit == 8)
                {
                    case (true) {
                        out.put(ctl);
                        out.put_n(grp, gl);
                        ctl = 0;
                        nbit = 0;
                        gl = 0;
                    }
                    default {};
                };
            };
            switch (nbit > 0)
            {
                case (true) {
                    out.put(ctl);
                    out.put_n(grp, gl);
                }
                default {};
            };
            ffree((byte*)head);
            ffree((byte*)prev);
            -> out.ok;
        };



        fvm_lz_decompress(byte* c, int cl, int raw_len, int* err) -> byte*
        {
            byte* out = fvm_alloc(raw_len + 1);
            int p, o, ctl, bit, off, n, k;
            *err = 0;
            switch (out == (byte*)0) { case (true) { *err = 3; -> out; } default {}; };
            while (o < raw_len)
            {
                switch (p >= cl) { case (true) { *err = 1; ffree(out); -> (byte*)0; } default {}; };
                ctl = (int)c[p];
                p++;
                bit = 0;
                while (bit < 8 & o < raw_len)
                {
                    switch (((ctl >> bit) `& 1) != 0)
                    {
                        case (true) {
                            switch (p + 2 > cl) { case (true) { *err = 1; ffree(out); -> (byte*)0; } default {}; };
                            off = ((int)c[p] `| (((int)c[p + 1] >> 4) << 8)) + 1;
                            n = ((int)c[p + 1] `& 15) + 3;
                            p = p + 2;
                            switch (off > o | o + n > raw_len) { case (true) { *err = 2; ffree(out); -> (byte*)0; } default {}; };
                            k = 0;
                            while (k < n)
                            {
                                out[o] = out[o - off];
                                o++;
                                k++;
                            };
                        }
                        default
                        {
                            switch (p >= cl) { case (true) { *err = 1; ffree(out); -> (byte*)0; } default {}; };
                            out[o] = c[p];
                            o++;
                            p++;
                        };
                    };
                    bit++;
                };
            };
            out[raw_len] = (byte)0;
            -> out;
        };



        fvm_put_emitideka(FvmBuf* o, byte* s, FvmVars* vars) -> void
        {
            int k = 0;
            int i = 0;
            o.put_str(g" \"\0");
            while (s[k] != 0)
            {
                switch (s[k])
                {
                    case (92) { o.put_str(g"\\\\\0"); }
                    case (34) { o.put_str(g"\\\"\0"); }
                    case (10) { o.put_str(g"\\n\0"); }
