                                    name_off = a;
                                    name_len = paren_open;
                                    pp_trim(this.psb.mem, @name_off, @name_len);
                                    paren_close = pp_find(this.psb.mem, paren_open, b, 41);
                                    switch (paren_close == -1)
                                    {
