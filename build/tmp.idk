            t_unary(Node* n) -> TypeSpec*
            {
                TypeSpec* ot = this.type_of(n.a);
                int op = n.op;
                switch (op == Operator.NOT)
                {
                    case (true) {
                    switch (this.kind_of(ot) == TyKind.PTR)
                    {
                        case (true) { -> this.mk(DataType.BOOL, 0, -1); }
                        default {};
