        def str2i32(byte* str) -> int
        {
            int result, i, digit;
            int sign = 1;
            byte c;
            while (str[i] == 32 | str[i] == 9 | str[i] == 10 | str[i] == 13)
            {
                i++;
            };
            if (str[i] == 45)  
            {
                sign = -1;
                i++;
            }
            elif (str[i] == 43)  
            {
                i++;
            };
            while (str[i] != 0)
            {
                c = str[i];
                if (c >= 48 & c <= 57)
                {
                    digit = (int)(c - 48);
                    result = result * 10 + digit;
                }
                else
                {
                    break;
                };
                i++;
            };
            return result * sign;
        };



