                                        b = a + ll.len[i];
                                        pp_trim(text, @a, @b);
                                        this.psb.put_n(text + a, b - a);
                                    };


                                    a = 0;
                                    b = this.psb.len;
                                    pp_trim(this.psb.mem, @a, @b);
                                    paren_open = pp_find(this.psb.mem, a, b, 40);
                                    switch (paren_open == -1)
