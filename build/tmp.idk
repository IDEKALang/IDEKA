            __expr() -> CodeGen* -> this;

            __exit() -> void
            {
                int i;
                while (i < this.owned.len)
                {
                    ffree((byte*)this.owned.items[i]);
                    i++;
                };
                this.ct_exit();
                this.skip_exit();
                pv_free(this.owned);
                pv_free(this.ext_fns);
                nm_free(this.tf_ast);
                pv_free(this.tf_pend);
                nm_free(this.structs);
                nm_free(this.ifc_call);
                nm_free(this.ifc_ret);
                nm_free(this.ifc_pass);
                nm_free(this.unions);
                nm_free(this.enums);
                nm_free(this.aliases);
                nm_free(this.consts);
