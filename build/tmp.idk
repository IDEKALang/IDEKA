            t_index(Node* n) -> TypeSpec*
            {
                TypeSpec* at = this.type_of(n.a);
                TypeSpec* a;
                int k;
                this.type_of(n.b);
                switch (at == (TypeSpec*)0)
                {
                    case (true) { -> (TypeSpec*)0; }
