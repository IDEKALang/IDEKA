                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (lt == (IRType*)0)
                                                {
                                                    case (true) { lt = this.lower(ts, true, n.line); }
                                                    default {};
                                                };
                                                switch (lt == (IRType*)0)
                                                {
                                                    case (true) { ->; }
                                                    default
                                                    {
                                                        m = mangle_namespace_name(ns, n.text);
                                                        switch (this.global_dup(m))
                                                        {
                                                            case (true) {
                                                            -> ffree(m);
                                                        }
                                                            default
