            op_struct_load(byte* field) -> void
            {
                i64* b;
                int li, k;
                this.pop_val();
                switch (this.failed) { case (true) { ->; } default {}; };
                switch (this.pt != 12)
                {
                    case (true)
                    {
                        switch (this.pt == 10)
