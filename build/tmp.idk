                                    case (true)
                                    {
                                        b.__init();
                                        b.put_str(tn);
                                        b.put('.');
                                        b.put_str(n.text);
                                        b.put(0);
                                        mk = this.keep(b.mem);
                                        b.__exit();
                                        isobj = this.lay.find(tn) >= 0 | this.fn_known(mk);
