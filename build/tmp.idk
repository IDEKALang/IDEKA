namespace standard
{
    namespace system
    {
        namespace cpu
        {



            global singinit ulong g_l2_bytes;
            global singinit bool  g_ermsb,
                                  g_cpuid_run = false;

            def cpuid_query() -> void
            {
                switch (g_cpuid_run) { case (1) { return; } default {}; };

                ulong eax, ebx, ecx, edx;


                volatile asm
                {
                    movq $$7,  %rax
                    xorq %rcx, %rcx
                    cpuid
                    movq %rax, $0
                    movq %rbx, $1
                    movq %rcx, $2
                    movq %rdx, $3
                } : "=r"(eax), "=r"(ebx), "=r"(ecx), "=r"(edx) :
                  : "rax","rbx","rcx","rdx","memory";

                g_ermsb = (bool)((ebx >> 9) `& 1ul);


                volatile asm
                {
                    movq $$0x80000006, %rax
                    cpuid
                    movq %rcx, $0
                } : "=r"(ecx) :
                  : "rax","rbx","rcx","rdx","memory";

                g_l2_bytes = ((ecx >> 16) `& 0xFFFFul) << 10;


                switch (g_l2_bytes == 0ul)
                {
                    case (1) { g_l2_bytes = 262144ul; } 
                    default  {};
                };

                g_cpuid_run = true;
            };




































































































































            def l2_bytes() -> ulong
            {
                cpuid_query();
                return g_l2_bytes;
            };

            def ermsb() -> bool
            {
                cpuid_query();
                return g_ermsb;
            };
        };

        namespace Windows
        {
        };
    };
};


















extern
{

