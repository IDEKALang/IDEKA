                };
            };


            mac_mask(int k, bool subst) -> int
            {
                switch (k == NodeKind.BINARY_OP | k == NodeKind.NULL_COALESCE | k == NodeKind.ARRAY_ACCESS) { case (true) { -> 3; } default
                    {
                        switch (k == NodeKind.TERNARY_OP | k == NodeKind.IF_EXPRESSION) { case (true) { -> 7; } default
                            {
                                switch (k == NodeKind.UNARY_OP | k == NodeKind.NOT_NULL | k == NodeKind.CAST_EXPRESSION |
                                    k == NodeKind.TYPE_CONVERT_EXPRESSION | k == NodeKind.MEMBER_ACCESS) { case (true) { -> 1; } default
                                    {
                                        switch (k == NodeKind.FUNCTION_CALL) { case (true) { -> 8; } default
                                            {
                                                switch (!subst) { case (true) { -> 0; } default
                                                    {
                                                        switch (k == NodeKind.MACRO_CALL | k == NodeKind.ARRAY_LITERAL) { case (true) { -> 8; } default
                                                            {
                                                                switch (k == NodeKind.RANGE_EXPRESSION | k == NodeKind.ARRAY_COMPREHENSION) { case (true) { -> 7; } default
                                                                    {
                                                                        switch (k == NodeKind.METHOD_CALL) { case (true) { -> 9; } default
                                                                            {
                                                                                switch (k == NodeKind.ADDRESS_OF | k == NodeKind.POINTER_DEREF) { case (true) { -> 1; } default
                                                                                    {
                                                                                        -> 0;
                                                                                    }; };
                                                                            }; };
                                                                    }; };
                                                            }; };
                                                    }; };
                                            }; };
                                    }; };
                            }; };
                    }; };
            };


            mac_selfref(Node* b, byte* name) -> bool
            {
                int k;
                int m;
                int i;
                int cnt;
                switch (b == (Node*)0) { case (true) { -> false; } default
                    {
                        k = b.kind;
                        switch (k == NodeKind.MACRO_CALL)
                        {
                            case (true) {
                            switch (cstr_eq(b.text, name)) { case (true) { -> true; } default {}; };
                            cnt = node_count(b, 0);
                            while (i < cnt)
                            {
                                switch (this.mac_selfref(node_child(b, 0, i), name)) { case (true) { -> true; } default {}; };
                                i++;
                            };
                            -> false;
                        }
                            default
                            {
                                m = this.mac_mask(k, false);
                                switch ((m & 1) != 0) { case (true) { switch (this.mac_selfref(b.a, name)) { case (true) { -> true; } default {}; }; } default {}; };
                                switch ((m & 2) != 0) { case (true) { switch (this.mac_selfref(b.b, name)) { case (true) { -> true; } default {}; }; } default {}; };
                                switch ((m & 4) != 0) { case (true) { switch (this.mac_selfref(b.c, name)) { case (true) { -> true; } default {}; }; } default {}; };
                                switch ((m & 8) != 0)
                                {
                                    case (true) {
                                    cnt = node_count(b, 0);
                                    while (i < cnt)
                                    {
                                        switch (this.mac_selfref(node_child(b, 0, i), name)) { case (true) { -> true; } default
                                            {
                                                i++;
                                            }; };
                                    };
                                }
                                    default {};
                                };
                                -> false;
                            };
                        };
                    }; };
            };


            mac_subst(Node* b, NameMap* sm) -> Node*
            {
                int k;
                int m;
                int i;
                int cnt;
                Node* arg;
                Node* r;
                switch (b == (Node*)0) { case (true) { -> (Node*)0; } default
                    {
                        k = b.kind;
                        switch (k == NodeKind.STRINGIFY)
                        {
                            case (true) {
                            arg = (Node*)nm_get(sm, b.text);
                            switch (arg == (Node*)0) { case (true) { -> b; } default {}; };

                            switch (arg.kind != NodeKind.IDENTIFIER) { case (true) { this.mac_fail = true; -> b; } default {}; };
                            r = node_clone(b);
                            r.text = arg.text;
                            -> r;
                        }
                            default
                            {
                                switch (k == NodeKind.IDENTIFIER)
                                {
                                    case (true) {
                                    arg = (Node*)nm_get(sm, b.text);
                                    switch (arg == (Node*)0) { case (true) { -> b; } default {}; };
                                    -> node_clone(arg);
                                }
                                    default
                                    {
                                        switch (k == NodeKind.F_STRING_LITERAL)
                                        {
                                            case (true) {
                                            cnt = node_count(b, 0);
                                            while (i < cnt)
                                            {
                                                arg = node_child(b, 0, i);
                                                switch (arg.kind != NodeKind.STRING_LITERAL) { case (true) { b.l0.items[i] = this.mac_subst(arg, sm); } default {}; };
                                                i++;
                                            };
                                            -> b;
                                        }
                                            default
                                            {
                                                m = this.mac_mask(k, true);
                                                switch ((m & 1) != 0) { case (true) { b.a = this.mac_subst(b.a, sm); } default {}; };
                                                switch ((m & 2) != 0) { case (true) { b.b = this.mac_subst(b.b, sm); } default {}; };
                                                switch ((m & 4) != 0) { case (true) { b.c = this.mac_subst(b.c, sm); } default {}; };
                                                switch ((m & 8) != 0)
                                                {
                                                    case (true) {
                                                    cnt = node_count(b, 0);
                                                    while (i < cnt)
                                                    {
                                                        b.l0.items[i] = this.mac_subst(node_child(b, 0, i), sm);
                                                        i++;
                                                    };
                                                }
                                                    default {};
                                                };
                                                -> b;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    }; };
            };


            macro_expand(Node* n) -> void
            {
                Node* d;
                Node* body;
                NameMap* sm;
                int i;
                int cnt;
                n.a = (Node*)0;
                d = (Node*)nm_get(this.macro_defs, n.text);
                switch (d == (Node*)0) { case (true) { ->; } default
                    {
                        cnt = node_count(d, 0);
                        switch (cnt != node_count(n, 0)) { case (true) { ->; } default
                            {
                                switch (this.mac_selfref(d.a, n.text) | this.mac_depth >= 64) { case (true) { ->; } default
                                    {
                                        sm = nm_new();
                                        while (i < cnt)
                                        {
                                            nm_put(sm, node_child(d, 0, i).text, (void*)node_child(n, 0, i));
                                            i++;
                                        };
                                        this.mac_fail = false;
                                        body = this.mac_subst(node_clone(d.a), sm);
                                        nm_free(sm);
                                        switch (this.mac_fail) { case (true) { ->; } default
                                            {
                                                this.mac_depth++;
                                                this.type_of(body);
                                                this.mac_depth--;
                                                n.a = body;
                                                ->;
                                            }; };
                                    }; };
                            }; };
                    }; };
            };







            has_expr(TypeSpec* t) -> bool
            {
                TypeSpec* p = t;
                IDKC_SYMENTRY* e;
                switch (t == (TypeSpec*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (this.kind_of(t) == TyKind.PTR)
                        {
                            case (true) { p = this.elem_of(t); }
                            default {};
                        };
                        e = this.type_entry(p);
                        switch (e == (IDKC_SYMENTRY*)0)
                        {
                            case (true) { -> false; }
                            default
                            {
                                switch (e.kind_id != SymbolKind.OBJECT)
                                {
                                    case (true) { -> false; }
                                    default
                                    {
                                        -> this.find_method0((Node*)e.node, g"__expr\0") != (Node*)0;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            classify(TypeSpec* dst, TypeSpec* src, int site, Node* sn) -> int
            {
                int kd = this.kind_of(dst);
                int ks = this.kind_of(src);
                int wd, ws;
                TypeSpec* ed;
                TypeSpec* es;
                int ld, ls;
                switch (kd == TyKind.UNKNOWN | ks == TyKind.UNKNOWN)
                {
                    case (true) { -> Conv.NONE; }
                    default
                    {
                        switch (kd == TyKind.VOID | ks == TyKind.VOID)
                        {
                            case (true) { -> Conv.NONE; }
                            default
                            {
                                switch (kd == TyKind.FUNC | ks == TyKind.FUNC)
                                {
                                    case (true) { -> Conv.NONE; }
                                    default
                                    {
                                        switch (kd == TyKind.DICT | ks == TyKind.DICT)
                                        {
                                            case (true) { -> Conv.NONE; }
                                            default
                                            {
                                                switch (site == Site.ARG)
                                                {
                                                    case (true) {
                                                    switch (!this.arg_matches(dst, src))
                                                    {
                                                        case (true) {
                                                        switch (this.has_expr(src))
                                                        {
                                                            case (true) {
                                                            switch (kd != TyKind.AGG | ks != TyKind.AGG)
                                                            {
                                                                case (true) { -> Conv.EXPR_CALL; }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };

                                                switch (kd == TyKind.INT)
                                                {
                                                    case (true) {
                                                    switch (ks == TyKind.INT)
                                                    {
                                                        case (true) {
                                                        wd = this.width_of(dst);
                                                        ws = this.width_of(src);
                                                        switch (wd == ws)
                                                        {
                                                            case (true) { -> Conv.EXACT; }
                                                            default {};
                                                        };
                                                        switch (ws < wd)
                                                        {
                                                            case (true) { -> Conv.INT_WIDEN; }
                                                            default {};
                                                        };
                                                        -> Conv.INT_NARROW;
                                                    }
                                                        default {};
                                                    };
                                                    switch (ks == TyKind.FLOAT | ks == TyKind.DOUBLE)
                                                    {
                                                        case (true) {
                                                        switch (site == Site.ARG)
                                                        {
                                                            case (true) { -> Conv.INVALID; }
                                                            default {};
                                                        };
                                                        -> Conv.FLOAT_TO_INT;
                                                    }
                                                        default {};
                                                    };
                                                    switch (ks == TyKind.PTR)
                                                    {
                                                        case (true) {
                                                        switch (site == Site.STORE)
                                                        {
                                                            case (true) { -> Conv.PTR_TO_INT; }
                                                            default {};
                                                        };
                                                        -> Conv.INVALID;
                                                    }
                                                        default {};
                                                    };
                                                    switch (ks == TyKind.ARRAY)
                                                    {
                                                        case (true) {
                                                        switch (site == Site.STORE)
                                                        {
                                                            case (true) { -> Conv.ARRAY_PACK; }
                                                            default {};
                                                        };
                                                        -> Conv.INVALID;
                                                    }
                                                        default {};
                                                    };
                                                    -> Conv.INVALID;
                                                }
                                                    default
                                                    {
                                                        switch (kd == TyKind.FLOAT | kd == TyKind.DOUBLE)
                                                        {
                                                            case (true) {
                                                            switch (ks == TyKind.INT)
                                                            {
                                                                case (true) {
                                                                switch (site == Site.ARG)
                                                                {
                                                                    case (true) { -> Conv.INVALID; }
                                                                    default {};
                                                                };
                                                                -> Conv.INT_TO_FLOAT;
                                                            }
                                                                default {};
                                                            };
                                                            switch (ks == TyKind.FLOAT | ks == TyKind.DOUBLE)
                                                            {
                                                                case (true) {
                                                                switch (kd == ks)
                                                                {
                                                                    case (true) { -> Conv.EXACT; }
                                                                    default {};
                                                                };
                                                                switch (kd == TyKind.DOUBLE)
                                                                {
                                                                    case (true) { -> Conv.FLOAT_EXT; }
                                                                    default {};
                                                                };
                                                                -> Conv.FLOAT_TRUNC;
                                                            }
                                                                default {};
                                                            };
                                                            -> Conv.INVALID;
                                                        }
                                                            default
                                                            {
                                                                switch (kd == TyKind.PTR)
                                                                {
                                                                    case (true) {
                                                                    switch (ks == TyKind.PTR)
                                                                    {
                                                                        case (true) {
                                                                        switch (this.ptr_same(dst, src))
                                                                        {
                                                                            case (true) { -> Conv.EXACT; }
                                                                            default {};
                                                                        };
                                                                        -> Conv.PTR_CAST;
                                                                    }
                                                                        default {};
                                                                    };
                                                                    switch (ks == TyKind.ARRAY)
                                                                    {
                                                                        case (true) { -> Conv.ARRAY_DECAY; }
                                                                        default {};
                                                                    };
                                                                    switch (ks == TyKind.INT)
                                                                    {
                                                                        case (true) {
                                                                        switch (site == Site.STORE)
                                                                        {
                                                                            case (true) { -> Conv.INT_TO_PTR; }
                                                                            default {};
                                                                        };
                                                                        -> Conv.INVALID;
                                                                    }
                                                                        default {};
                                                                    };
                                                                    -> Conv.INVALID;
                                                                }
                                                                    default
                                                                    {
                                                                        switch (kd == TyKind.ARRAY)
                                                                        {
                                                                            case (true) {
                                                                            switch (ks == TyKind.ARRAY)
                                                                            {
                                                                                case (true) {
                                                                                switch (this.ty_same(dst, src))
                                                                                {
                                                                                    case (true) { -> Conv.EXACT; }
                                                                                    default {};
                                                                                };
                                                                                ed = this.elem_of(dst);
                                                                                es = this.elem_of(src);
                                                                                ld = this.array_len(dst);
                                                                                ls = this.array_len(src);
                                                                                switch (site == Site.STORE)
                                                                                {
                                                                                    case (true) {
                                                                                    switch (this.ty_same(ed, es))
                                                                                    {
                                                                                        case (true) {
                                                                                        switch (ld < 0 | ls < 0)
                                                                                        {
                                                                                            case (true) { -> Conv.ARRAY_COPY; }
                                                                                            default {};
                                                                                        };
                                                                                        switch (ls <= ld)
                                                                                        {
                                                                                            case (true) { -> Conv.ARRAY_COPY; }
                                                                                            default {};
                                                                                        };
                                                                                    }
                                                                                        default {};
                                                                                    };
                                                                                    -> Conv.INVALID;
                                                                                }
                                                                                    default {};
                                                                                };
                                                                                switch (site == Site.RETURN)
                                                                                {
                                                                                    case (true) {
                                                                                    switch (this.kind_of(ed) == TyKind.INT & this.kind_of(es) == TyKind.INT)
                                                                                    {
                                                                                        case (true) {
                                                                                        switch (ld >= 0 & ls >= 0)
                                                                                        {
                                                                                            case (true) {
                                                                                            switch (ld * this.width_of(ed) == ls * this.width_of(es))
                                                                                            {
                                                                                                case (true) { -> Conv.ARRAY_COPY; }
                                                                                                default {};
                                                                                            };
                                                                                        }
                                                                                            default {};
                                                                                        };
                                                                                    }
                                                                                        default {};
                                                                                    };
                                                                                }
                                                                                    default {};
                                                                                };
                                                                                -> Conv.INVALID;
                                                                            }
                                                                                default {};
                                                                            };
                                                                            switch (ks == TyKind.PTR)
                                                                            {
                                                                                case (true) {
                                                                                switch (sn != (Node*)0)
                                                                                {
                                                                                    case (true) {
                                                                                    switch (sn.kind == NodeKind.CAST_EXPRESSION)
                                                                                    {
                                                                                        case (true) { -> Conv.ARRAY_COPY; }
                                                                                        default {};
                                                                                    };
                                                                                }
                                                                                    default {};
                                                                                };
                                                                            }
                                                                                default {};
                                                                            };
                                                                            -> Conv.INVALID;
                                                                        }
                                                                            default
                                                                            {
                                                                                switch (kd == TyKind.AGG)
                                                                                {
                                                                                    case (true) {
                                                                                    switch (ks == TyKind.AGG)
                                                                                    {
                                                                                        case (true) {
                                                                                        switch (this.agg_same(dst, src))
                                                                                        {
                                                                                            case (true) { -> Conv.EXACT; }
                                                                                            default {};
                                                                                        };
                                                                                        -> Conv.INVALID;
                                                                                    }
                                                                                        default {};
                                                                                    };
                                                                                    switch (ks == TyKind.PTR)
                                                                                    {
                                                                                        case (true) {
                                                                                        switch (this.resolve_alias(src).pointer_depth == 1)
                                                                                        {
                                                                                            case (true) {
                                                                                            switch (this.agg_same(dst, this.elem_of(src)))
                                                                                            {
                                                                                                case (true) { -> Conv.STRUCT_LOAD; }
                                                                                                default {};
                                                                                            };
                                                                                        }
                                                                                            default {};
                                                                                        };
                                                                                    }
                                                                                        default {};
                                                                                    };
                                                                                    -> Conv.INVALID;
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        -> Conv.NONE;
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            conv_check(TypeSpec* dst, Node* sn, int site) -> void
            {
                int c;
                ConvRec* r;
                switch (dst == (TypeSpec*)0 | sn == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        TypeSpec* sty = sn.ety;
                        switch (site == Site.ARG & sn.kind == NodeKind.IDENTIFIER)
                        {
                            case (true) { sty = this.arg_type(sn); }
                            default {};
                        };
                        switch (sty == (TypeSpec*)0)
                        {
                            case (true) { ->; }
                            default
                            {
                                c = this.classify(dst, sty, site, sn);
                                switch (c == Conv.NONE)
                                {
                                    case (true) { ->; }
                                    default
                                    {
                                        this.convs[c] = this.convs[c] + 1;
                                        switch (c == Conv.INVALID)
                                        {
                                            case (true) {
                                            r = (ConvRec*)fmalloc((u64)(sizeof(ConvRec) / 8));
                                            r.at = sn;
                                            r.dst = dst;
                                            r.site = site;
                                            pv_push(this.bad, (void*)r);
                                        }
                                            default {};
                                        };
                                        ->;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            conv_args(Overload* o, NodeVec* args) -> void
            {
                int j;
                int argc = 0;
                switch (o == (Overload*)0 | args == (NodeVec*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        argc = args.len;
                        while (j < argc & j < o.nparams)
                        {
                            this.conv_check(o.params[j], args.items[j], Site.ARG);
                            j++;
                        };
                        ->;
                    };
                };
            };


            init_converts(Node* decl, TypeSpec* ts) -> bool
            {
                Node* a = decl.a;
                int k;
                switch (a == (Node*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        k = a.kind;
                        switch (k == NodeKind.NO_INIT | k == NodeKind.ARRAY_LITERAL | k == NodeKind.STRING_LITERAL |
                            k == NodeKind.ARRAY_COMPREHENSION | k == NodeKind.STRUCT_RECAST)
                        {
                            case (true) {
                            -> false;
                        }
                            default
                            {
                                switch (k == NodeKind.FUNCTION_CALL)
                                {
                                    case (true) {
                                    switch (a.text != (byte*)0)
                                    {
                                        case (true) {
                                        switch (ends_with(a.text, g".__init\0"))
                                        {
                                            case (true) { -> false; }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (ts.storage_class == StorageClass.HEAP | ts.storage_class == StorageClass.SINGINIT)
                                {
                                    case (true) { -> false; }
                                    default
                                    {
                                        switch (ts_is_array(ts) & k == NodeKind.IDENTIFIER)
                                        {
                                            case (true) { -> false; }
                                            default
                                            {
                                                -> true;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            print_conv(byte* path, bool verbose) -> void
            {
                int c = 1;
                int i;
                ConvRec* r;
                while (c < 17)
                {
                    switch (this.convs[c] != 0)
                    {
                        case (true) {
                        print(g"  \0");
                        print(conv_name(c));
                        print(g": \0");
                        println(this.convs[c]);
                    }
                        default {};
                    };
                    c++;
                };
                switch (!verbose)
                {
                    case (true) { ->; }
                    default
                    {
                        while (i < this.bad.len)
                        {
                            switch (i >= 60)
                            {
                                case (true) { break; }
                                default
                                {
                                    r = (ConvRec*)this.bad.items[i];
                                    print(path);
                                    print(g":\0");
                                    print(r.at.line);
                                    print(g":\0");
                                    print(r.at.col);
                                    print(g": invalid \0");
                                    print(site_name(r.site));
                                    print(g" conversion \0");
                                    this.clear_mb();
                                    mangle_type(@this.mb, r.at.ety);
                                    print(this.mb.mem);
                                    print(g" to \0");
                                    this.clear_mb();
                                    mangle_type(@this.mb, r.dst);
                                    println(this.mb.mem);
                                    i++;
                                };
                            };
                        };
                        ->;
                    };
                };
            };





            def_var(byte* name, TypeSpec* ts, Node* decl) -> void
            {
                switch (st_is_global_scope(this.st))
                {
                    case (true) { ->; }
                    default
                    {
                        st_define(this.st, name, SymbolKind.VARIABLE, ts, decl);
                        ->;
                    };
                };
            };


            infer_decl(TypeSpec* ts, Node* init) -> TypeSpec*
            {
                TypeSpec* c;
                int cnt = -1;
                switch (ts == (TypeSpec*)0)
                {
                    case (true) { -> ts; }
                    default
                    {
                        switch (init == (Node*)0)
                        {
                            case (true) { -> ts; }
                            default
                            {
                                switch (!ts_is_array(ts))
                                {
                                    case (true) { -> ts; }
                                    default
                                    {
                                        switch (ts.array_size != (Node*)0)
                                        {
                                            case (true) { -> ts; }
                                            default
                                            {

                                                switch (ts.array_dims != (NodeVec*)0)
                                                {
                                                    case (true) {
                                                    switch (ts.array_dims.len > 0)
                                                    {
                                                        case (true) {
                                                        switch (ts.array_dims.items[0] != (Node*)0) { case (true) { -> ts; } default {}; };
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (init.kind)
                                                {
                                                    case (NodeKind.ARRAY_LITERAL)
                                                    {
                                                        switch ((init.flags `& 8) != 0)
                                                        {
                                                            case (true) {
                                                            switch (init.ety != (TypeSpec*)0)
                                                            {
                                                                case (true) { cnt = this.array_len(init.ety); }
                                                                default {};
                                                            };
                                                        }
                                                            default { cnt = node_count(init, 0); };
                                                        };
                                                    }
                                                    case (NodeKind.STRING_LITERAL)
                                                    {
                                                        switch (init.ety != (TypeSpec*)0)
                                                        {
                                                            case (true) { cnt = this.array_len(init.ety); }
                                                            default {};
                                                        };
                                                    }
                                                    default {};
                                                };
                                                switch (cnt < 0)
                                                {
                                                    case (true) { -> ts; }
                                                    default
                                                    {
                                                        c = typespec_clone(ts);
                                                        c.array_size = this.size_node(cnt);
                                                        -> this.keep(c);
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            walk_list(Node* n, int slot) -> void
            {
                int i;
                int cnt = node_count(n, slot);
                while (i < cnt)
                {
                    this.walk(node_child(n, slot, i));
                    i++;
                };
                ->;
            };

            walk_children(Node* n) -> void
            {
                int s;
                this.walk(n.a);
                this.walk(n.b);
                this.walk(n.c);
                this.walk(n.d);
                this.walk(n.e);
                while (s < 6)
                {
                    this.walk_list(n, s);
                    s++;
                };
                ->;
            };

            walk_function(Node* fn) -> void
            {
                Node* prev_fn = this.cur_fn;
                TypeSpec* prev_ret = this.cur_ret;
                Node* p;
                int i;
                int cnt = node_count(fn, 0);
                switch ((fn.flags `& 524288) != 0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (fn.a == (Node*)0)
                        {
                            case (true) { ->; }
                            default
                            {
                                st_enter_scope(this.st);
                                this.cur_fn = fn;
                                this.cur_ret = fn.ts;
                                while (i < cnt)
                                {
                                    p = node_child(fn, 0, i);
                                    switch (p.text != (byte*)0)
                                    {
                                        case (true) { this.def_var(p.text, p.ts, p); }
                                        default {};
                                    };
                                    i++;
                                };
                                this.walk(fn.a);
                                this.cur_fn = prev_fn;
                                this.cur_ret = prev_ret;
                                -> st_exit_scope(this.st);
                            };
                        };
                    };
                };
            };

            walk_type_func(Node* tf) -> void
            {
                Node* prev_fn = this.cur_fn;
                TypeSpec* prev_ret = this.cur_ret;
                Node* p;
                int i;
                int cnt = node_count(tf, 0);
                switch (tf.a == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        st_enter_scope(this.st);
                        this.cur_fn = tf;
                        this.cur_ret = tf.ts;
                        this.def_var(g"_\0", tf.ts2, tf);
                        while (i < cnt)
                        {
                            p = node_child(tf, 0, i);
                            switch (p.text != (byte*)0)
                            {
                                case (true) { this.def_var(p.text, p.ts, p); }
                                default {};
                            };
                            i++;
                        };
                        this.walk(tf.a);
                        this.cur_fn = prev_fn;
                        this.cur_ret = prev_ret;
                        -> st_exit_scope(this.st);
                    };
                };
            };


            walk_aggregate(Node* d) -> void
            {
                byte* prev_obj = this.cur_obj;
                Node* m;
                int i, cnt;
                switch (d.kind == NodeKind.OBJECT_DEF)
                {
                    case (true) {
                    switch (d.d != (Node*)0)
                    {
                        case (true) { ->; }
                        default
                        {
                            switch (d.text != (byte*)0)
                            {
                                case (true) { this.cur_obj = d.text; }
                                default {};
                            };
                        };
                    };
                }
                    default {};
                };
                switch (d.kind == NodeKind.STRUCT_DEF)
                {
                    case (true) {
                    switch (node_count(d, 4) > 0)
                    {
                        case (true) { ->; }
                        default {};
                    };
                }
                    default {};
                };
                cnt = node_count(d, 0);
                while (i < cnt)
                {
                    m = node_child(d, 0, i);
                    switch (m.a != (Node*)0)
                    {
                        case (true) { this.type_of(m.a); }
                        default {};
                    };
                    i++;
                };
                switch (d.kind == NodeKind.OBJECT_DEF)
                {
                    case (true) {
                    cnt = node_count(d, 1);
                    i = 0;
                    while (i < cnt)
                    {
                        this.walk(node_child(d, 1, i));
                        i++;
                    };
                }
                    default {};
                };
                cnt = node_count(d, 3);
                i = 0;
                while (i < cnt)
                {
                    this.walk(node_child(d, 3, i));
                    i++;
                };
                cnt = node_count(d, 4);
                i = 0;
                switch (d.kind == NodeKind.OBJECT_DEF)
                {
                    case (true) {
                    while (i < cnt)
                    {
                        this.walk(node_child(d, 4, i));
                        i++;
                    };
                }
                    default {};
                };
                this.cur_obj = prev_obj;
                ->;
            };

            walk_namespace(Node* ns) -> void
            {
                byte* prev = ts_dup(this.st.current_ns);
                byte* full;
                int s, c, e, w;
                Node* lst;
                switch (ns.text == (byte*)0)
                {
                    case (true) {
                    -> ffree(prev);
                }
                    default
                    {
                        switch (prev[0] == 0)
                        {
                            case (true) { full = ts_dup(ns.text); }
                            default { full = join3(prev, g"::\0", ns.text); };
                        };
                        st_set_namespace(this.st, full);
                        while (s < 6)
                        {
                            c = node_count(ns, s);
                            e = 0;
                            while (e < c)
                            {
                                this.walk(node_child(ns, s, e));
                                e++;
                            };
                            s++;
                        };
                        while (w < 2)
                        {
                            switch (w)
                            {
                                case (0) { lst = ns.a; }
                                default { lst = ns.b; };
                            };
                            switch (lst != (Node*)0)
                            {
                                case (true) {
                                c = node_count(lst, 0);
                                e = 0;
                                while (e < c)
                                {
                                    this.walk(node_child(lst, 0, e));
                                    e++;
                                };
                            }
                                default {};
                            };
                            w++;
                        };
                        st_set_namespace(this.st, prev);
                        ffree(prev);
                        -> ffree(full);
                    };
                };
            };

            walk_var_decl(Node* n) -> void
            {
                TypeSpec* it = (TypeSpec*)0;
                TypeSpec* ts = n.ts;
                bool chk = false;
                switch (n.a != (Node*)0)
                {
                    case (true) { it = this.type_of(n.a); }
                    default {};
                };
                switch (ts != (TypeSpec*)0)
                {
                    case (true) {
                    switch (ts.storage_class == StorageClass.AUTO & ts.base_type == DataType.VOID)
                    {
                        case (true) { ts = it; }
                        default {
                        ts = this.infer_decl(ts, n.a);
                        chk = true;
                    };
                    };
                }
                    default {};
                };
                switch (chk & !st_is_global_scope(this.st))
                {
                    case (true) {
                    switch (this.init_converts(n, ts))
                    {
                        case (true) { this.conv_check(ts, n.a, Site.STORE); }
                        default {};
                    };
                }
                    default {};
                };
                switch (n.text != (byte*)0)
                {
                    case (true) { this.def_var(n.text, ts, n); }
                    default {};
                };
                n.ety = ts;
                ->;
            };

            walk_destructure(Node* n) -> void
            {
                TypeSpec* src = this.type_of(n.a);
                IDKC_SYMENTRY* e = this.type_entry(src);
                Node* dn = (Node*)0;
                Node* v;
                Node* m;
                TypeSpec* vt;
                int i;
                int cnt = node_count(n, 0);
                switch (e != (IDKC_SYMENTRY*)0)
                {
                    case (true) { dn = (Node*)e.node; }
                    default {};
                };
                while (i < cnt)
                {
                    v = node_child(n, 0, i);
                    vt = (TypeSpec*)0;
                    switch (v.kind == NodeKind.VARIABLE_DECLARATION)
                    {
                        case (true) { vt = v.ts; }
                        default {
                            switch (dn != (Node*)0)
                            {
                                case (true) {
                        switch (i < node_count(dn, 0))
                        {
                            case (true) {
                            m = node_child(dn, 0, i);
                            vt = m.ts;
                        }
                            default {};
                        };
                    }
                                default {};
                            };
                        };
                    };
                    switch (v.text != (byte*)0)
                    {
                        case (true) { this.def_var(v.text, vt, v); }
                        default {};
                    };
                    i++;
                };
                ->;
            };

            walk_for_in(Node* n) -> void
            {
                TypeSpec* it;
                TypeSpec* et;
                TypeSpec* vt;
                IDKC_SYMENTRY* e;
                Node* dn;
                Node* v;
                Node* m;
                int i;
                int cnt = node_count(n, 0);
                st_enter_scope(this.st);
                it = this.type_of(n.a);
                et = this.elem_of(it);
                dn = (Node*)0;
                switch ((n.flags `& 16) != 0)
                {
                    case (true) {
                    e = this.type_entry(et);
                    switch (e != (IDKC_SYMENTRY*)0)
                    {
                        case (true) { dn = (Node*)e.node; }
                        default {};
                    };
                }
                    default {};
                };
                while (i < cnt)
                {
                    v = node_child(n, 0, i);
                    vt = et;
                    switch ((n.flags `& 16) != 0)
                    {
                        case (true) {
                        vt = (TypeSpec*)0;
                        switch (dn != (Node*)0)
                        {
                            case (true) {
                            switch (i < node_count(dn, 0))
                            {
                                case (true) {
                                m = node_child(dn, 0, i);
                                vt = m.ts;
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                    }
                        default {
                            switch (i > 0)
                            {
                                case (true) { vt = (TypeSpec*)0; }
                                default {};
                            };
                        };
                    };
                    switch (v.text != (byte*)0)
                    {
                        case (true) { this.def_var(v.text, vt, v); }
                        default {};
                    };
                    i++;
                };
                this.walk(n.b);
                -> st_exit_scope(this.st);
            };

            walk_try(Node* n) -> void
            {
                Node* cc;
                int i;
                int cnt = node_count(n, 0);
                this.walk(n.a);
                while (i < cnt)
                {
                    cc = node_child(n, 0, i);
                    st_enter_scope(this.st);
                    switch (cc.text != (byte*)0)
                    {
                        case (true) { this.def_var(cc.text, cc.ts, cc); }
                        default {};
                    };
                    this.walk(cc.a);
                    st_exit_scope(this.st);
                    i++;
                };
                ->;
            };

            walk(Node* n) -> void
            {
                switch (n == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        int k = n.kind;
                        switch (is_expr_kind(k))
                        {
                            case (true) {
                            this.type_of(n);
                            ->;
                        }
                            default
                            {
                                switch (k == NodeKind.BLOCK)
                                {
                                    case (true) {
                                    st_enter_scope(this.st);
                                    this.walk_list(n, 0);
                                    -> st_exit_scope(this.st);
                                }
                                    default
                                    {
                                        switch (k == NodeKind.VARIABLE_DECLARATION)
                                        {
                                            case (true) {
                                            -> this.walk_var_decl(n);
                                        }
                                            default
                                            {
                                                switch (k == NodeKind.ASSIGNMENT | k == NodeKind.COMPOUND_ASSIGNMENT | k == NodeKind.TERNARY_ASSIGN)
                                                {
                                                    case (true) {
                                                    this.type_raw(n.a);
                                                    this.type_of(n.b);
                                                    switch (k == NodeKind.ASSIGNMENT | k == NodeKind.TERNARY_ASSIGN)
                                                    {
                                                        case (true) {
                                                        switch (n.a != (Node*)0)
                                                        {
                                                            case (true) { this.conv_check(n.a.ety, n.b, Site.STORE); }
                                                            default {};
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                    ->;
                                                }
                                                    default
                                                    {
                                                        switch (k == NodeKind.RETURN_STATEMENT)
                                                        {
                                                            case (true) {

                                                            switch (this.kind_of(this.cur_ret) == TyKind.AGG)
                                                            {
                                                                case (true) { this.type_raw(n.a); }
                                                                default { this.type_of(n.a); };
                                                            };
                                                            switch (this.cur_ret != (TypeSpec*)0 & n.a != (Node*)0)
                                                            {
                                                                case (true) {
                                                                switch (this.cur_ret.base_type != DataType.THIS & this.cur_ret.base_type != DataType.VOID)
                                                                {
                                                                    case (true) {
                                                                    this.conv_check(this.cur_ret, n.a, Site.RETURN);
                                                                }
                                                                    default {};
                                                                };
                                                            }
                                                                default {};
                                                            };
                                                            ->;
                                                        }
                                                            default
                                                            {
                                                                switch (k == NodeKind.FUNCTION_DEF | k == NodeKind.OBJECT_METHOD)
                                                                {
                                                                    case (true) {
                                                                    -> this.walk_function(n);
                                                                }
                                                                    default
                                                                    {
                                                                        switch (k == NodeKind.TYPE_FUNC_DEF)
                                                                        {
                                                                            case (true) {
                                                                            -> this.walk_type_func(n);
                                                                        }
                                                                            default
                                                                            {
                                                                                switch (k == NodeKind.FUNCTION_DEF_STATEMENT | k == NodeKind.STRUCT_DEF_STATEMENT |
                                                                                    k == NodeKind.OBJECT_DEF_STATEMENT | k == NodeKind.UNION_DEF_STATEMENT |
                                                                                    k == NodeKind.NAMESPACE_DEF_STATEMENT | k == NodeKind.ENUM_DEF_STATEMENT |
                                                                                    k == NodeKind.MACRO_DEF_STATEMENT)
                                                                                {
                                                                                    case (true) {
                                                                                    -> this.walk(n.a);
                                                                                }
                                                                                    default
                                                                                    {
                                                                                        switch (k == NodeKind.OBJECT_DEF | k == NodeKind.STRUCT_DEF)
                                                                                        {
                                                                                            case (true) {
                                                                                            -> this.walk_aggregate(n);
                                                                                        }
                                                                                            default
                                                                                            {
                                                                                                switch (k == NodeKind.NAMESPACE_DEF)
                                                                                                {
                                                                                                    case (true) {
                                                                                                    -> this.walk_namespace(n);
                                                                                                }
                                                                                                    default
                                                                                                    {
                                                                                                        switch (k == NodeKind.EXTERN_BLOCK | k == NodeKind.EXPORT_BLOCK | k == NodeKind.PROGRAM)
                                                                                                        {
                                                                                                            case (true) {
                                                                                                            -> this.walk_list(n, 0);
                                                                                                        }
                                                                                                            default
                                                                                                            {
                                                                                                                switch (k == NodeKind.USING_STATEMENT)
                                                                                                                {
                                                                                                                    case (true) {
                                                                                                                    switch (n.text != (byte*)0)
                                                                                                                    {
                                                                                                                        case (true) { st_add_using_namespace(this.st, n.text); }
                                                                                                                        default {};
                                                                                                                    };
                                                                                                                    ->;
                                                                                                                }
                                                                                                                    default
                                                                                                                    {
                                                                                                                        switch (k == NodeKind.NOT_USING_STATEMENT)
                                                                                                                        {
                                                                                                                            case (true) {
                                                                                                                            switch (n.text != (byte*)0)
                                                                                                                            {
                                                                                                                                case (true) { st_remove_using_namespace(this.st, n.text); }
                                                                                                                                default {};
                                                                                                                            };
                                                                                                                            ->;
                                                                                                                        }
                                                                                                                            default
                                                                                                                            {
                                                                                                                                switch (k == NodeKind.FOR_LOOP)
                                                                                                                                {
                                                                                                                                    case (true) {
                                                                                                                                    st_enter_scope(this.st);
                                                                                                                                    this.walk_children(n);
                                                                                                                                    -> st_exit_scope(this.st);
                                                                                                                                }
                                                                                                                                    default
                                                                                                                                    {
                                                                                                                                        switch (k == NodeKind.FOR_IN_LOOP)
                                                                                                                                        {
                                                                                                                                            case (true) {
                                                                                                                                            -> this.walk_for_in(n);
                                                                                                                                        }
                                                                                                                                            default
                                                                                                                                            {
                                                                                                                                                switch (k == NodeKind.TRY_BLOCK)
                                                                                                                                                {
                                                                                                                                                    case (true) {
                                                                                                                                                    -> this.walk_try(n);
                                                                                                                                                }
                                                                                                                                                    default
                                                                                                                                                    {
                                                                                                                                                        switch (k == NodeKind.DESTRUCTURING_ASSIGNMENT)
                                                                                                                                                        {
                                                                                                                                                            case (true) {
                                                                                                                                                            -> this.walk_destructure(n);
                                                                                                                                                        }
                                                                                                                                                            default
                                                                                                                                                            {
                                                                                                                                                                switch (k == NodeKind.DUAL_ASSIGN_DECLARATION)
                                                                                                                                                                {
                                                                                                                                                                    case (true) {
                                                                                                                                                                    this.type_of(n.a);
                                                                                                                                                                    switch (n.text != (byte*)0)
                                                                                                                                                                    {
                                                                                                                                                                        case (true) { this.def_var(n.text, n.ts, n); }
                                                                                                                                                                        default {};
                                                                                                                                                                    };
                                                                                                                                                                    switch (n.text2 != (byte*)0)
                                                                                                                                                                    {
                                                                                                                                                                        case (true) { this.def_var(n.text2, n.ts2, n); }
                                                                                                                                                                        default {};
                                                                                                                                                                    };
                                                                                                                                                                    ->;
                                                                                                                                                                }
                                                                                                                                                                    default
                                                                                                                                                                    {
                                                                                                                                                                        switch (k == NodeKind.FUNCTION_POINTER_DECLARATION)
                                                                                                                                                                        {
                                                                                                                                                                            case (true) {
                                                                                                                                                                            this.type_of(n.a);
                                                                                                                                                                            switch (n.text != (byte*)0)
                                                                                                                                                                            {
                                                                                                                                                                                case (true) { this.def_var(n.text, n.ts, n); }
                                                                                                                                                                                default {};
                                                                                                                                                                            };
                                                                                                                                                                            ->;
                                                                                                                                                                        }
                                                                                                                                                                            default
                                                                                                                                                                            {
                                                                                                                                                                                switch (k == NodeKind.MACRO_DEF) { case (true) { nm_put(this.macro_defs, n.text, (void*)n); } default {}; };
                                                                                                                                                                                switch (k == NodeKind.ENUM_DEF | k == NodeKind.UNION_DEF | k == NodeKind.TRAIT_DEF |
                                                                                                                                                                                    k == NodeKind.INTERFACE_DEF | k == NodeKind.CONTRACT_DEF | k == NodeKind.CONSTRA_DEF |
                                                                                                                                                                                    k == NodeKind.MACRO_DEF | k == NodeKind.EFFECT_DEF | k == NodeKind.ASYNC_TAG_DEF | k == NodeKind.EMIT_IDEKA |
                                                                                                                                                                                    k == NodeKind.COMPTIME_BLOCK | k == NodeKind.INLINE_ASM | k == NodeKind.IDEKAVM_BLOCK |
                                                                                                                                                                                    k == NodeKind.TYPE_DECLARATION | k == NodeKind.STRUCT_MEMBER | k == NodeKind.UNION_MEMBER)
                                                                                                                                                                                {
                                                                                                                                                                                    case (true) {
                                                                                                                                                                                    ->;
                                                                                                                                                                                }
                                                                                                                                                                                    default
                                                                                                                                                                                    {
                                                                                                                                                                                        -> this.walk_children(n);
                                                                                                                                                                                    };
                                                                                                                                                                                };
                                                                                                                                                                            };
                                                                                                                                                                        };
                                                                                                                                                                    };
                                                                                                                                                                };
                                                                                                                                                            };
                                                                                                                                                        };
                                                                                                                                                    };
                                                                                                                                                };
                                                                                                                                            };
                                                                                                                                        };
                                                                                                                                    };
                                                                                                                                };
                                                                                                                            };
                                                                                                                        };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            walk_program(Node* prog) -> void
            {
                -> this.walk_list(prog, 0);
            };


            print_unknown(byte* path, int limit) -> void
            {
                int i;
                Node* n;
                while (i < this.unk.len)
                {
                    switch (i >= limit)
                    {
                        case (true) { break; }
                        default
                        {
                            n = (Node*)this.unk.items[i];
                            print(path);
                            print(g":\0");
                            print(n.line);
                            print(g":\0");
                            print(n.col);
                            print(g": untyped \0");
                            print(node_kind_name(n.kind));
                            switch (n.text != (byte*)0)
                            {
                                case (true) {
                                print(g" \0");
                                print(n.text);
                            }
                                default {};
                            };
                            println(g"\0");
                            i++;
                        };
                    };
                };
                ->;
            };
        };
    };
};



































using IDEKA::ast;
using IDEKA::preprocessor;
using IDEKA::types;

namespace IDEKA
{
    namespace ir
    {
        enum LK
        {
            VOID,
            INT,
            FLOAT,
            DOUBLE,
            PTR,
            ARRAY,
            STRUCT,     
            ISTRUCT,    
            FUNC
        };



        struct IRType
        {
            int kind;
            int width;
            int count;
            IRType* elem;
            IRType** items;
            int nitems;
            byte* name;
            bool vararg;
            bool defined;
        };



        struct IRValue
        {
            IRType* ty;
            byte* text;
            TypeSpec* spec;
            TypeSpec* espec;    
            int flags;
            bool is_const;
        };

        struct IRBlock
        {
            byte* name;
            PtrVec* lines;
            bool terminated;
        };

        struct IRFunc
        {
            byte* name;
            IRType* ftype;
            IRValue** args;
            int nargs;
            PtrVec* blocks;
            byte* cconv, linkage;
            PtrVec* attrs;
            NameMap* names;
            int counter;
            bool is_decl;
            IRValue* self;      
        };

        struct IRGlobal
        {
            byte* name;
            IRType* ty;
            byte* init,         
                  linkage;
            bool constant;
            IRValue* self;
        };





        put_i64(Buf* b, i64 v) -> void
        {
            byte[24] tmp = noinit;
            int n, k;
            u64 u;
            switch (v < (i64)0)
            {
                case (true) {
                b.put(45);
                u = (u64)0 - (u64)v;
            }
                default { u = (u64)v; };
            };
            switch (u == (u64)0)
            {
                case (true) {
                -> b.put(48);
            }
                default
                {
                    while (u > (u64)0)
                    {
                        tmp[n] = (byte)((int)(u % (u64)10) + 48);
                        u = u / (u64)10;
                        n++;
                    };
                    k = n - 1;
                    while (k >= 0)
                    {
                        b.put((int)tmp[k]);
                        k--;
                    };
                    ->;
                };
            };
        };

        put_u64(Buf* b, u64 u) -> void
        {
            byte[24] tmp = noinit;
            int n, k;
            switch (u == (u64)0)
            {
                case (true) {
                -> b.put(48);
            }
                default
                {
                    while (u > (u64)0)
                    {
                        tmp[n] = (byte)((int)(u % (u64)10) + 48);
                        u = u / (u64)10;
                        n++;
                    };
                    k = n - 1;
                    while (k >= 0)
                    {
                        b.put((int)tmp[k]);
                        k--;
                    };
                    ->;
                };
            };
        };

        hexdig(int v) -> int
        {
            switch (v < 10)
            {
                case (true) { -> 48 + v; }
                default
                {
                    -> 65 + v - 10;
                };
            };
        };




        put_hex64(Buf* b, u64 u) -> void
        {
            int nd = 1;
            int i;
            int d;
            int pad;
            while (nd < 16)
            {
                switch ((u >> (u64)(nd * 4)) == (u64)0)
                {
                    case (true) { break; }
                    default
                    {
                        nd++;
                    };
                };
            };
            pad = 16 - (nd + 2);
            while (pad > 0)
            {
                b.put(32);
                pad--;
            };
            b.put_str(g"0x\0");
            i = nd - 1;
            while (i >= 0)
            {
                d = (int)((u >> (u64)(i * 4)) `& (u64)15);
                switch (d < 10)
                {
                    case (true) { b.put(48 + d); }
                    default { b.put(87 + d); };
                };
                i--;
            };
            ->;
        };


        put_quoted(Buf* b, byte* s) -> void
        {
            int i;
            int c;
            b.put(34);
            while (s[i]!?)
            {
                c = (int)s[i];
                switch (c < 32 | c > 126 | c == 34 | c == 92)
                {
                    case (true) {
                    b.put(92);
                    b.put(hexdig(c / 16));
                    b.put(hexdig(c % 16));
                }
                    default { b.put(c); };
                };
                i++;
            };
            -> b.put(34);
        };


        put_quoted_label(Buf* out, byte* name) -> void
        {
            int i;
            bool plain = true;
            int c;
            while (name[i]!?)
            {
                c = (int)name[i];
                switch (!((c >= 48 & c <= 57) | (c >= 65 & c <= 90) | (c >= 97 & c <= 122) | c == 95 | c == 46 | c == 36 | c == 45))
                {
                    case (true) {
                    plain = false;
                }
                    default {};
                };
                i++;
            };
            switch (plain)
            {
                case (true) { out.put_str(name); }
                default { put_quoted(out, name); };
            };
            -> out.put_str(g":\n\0");
        };





        lt_text(Buf* b, IRType* t) -> void
        {
            int i;
            int k = t.kind;
            switch (k == LK.VOID)
            {
                case (true) { -> b.put_str(g"void\0"); }
                default
                {
                    switch (k == LK.INT)
                    {
                        case (true) {
                        b.put(105);
                        -> b.put_int(t.width);
                    }
                        default
                        {
                            switch (k == LK.FLOAT)
                            {
                                case (true) { -> b.put_str(g"float\0"); }
                                default
                                {
                                    switch (k == LK.DOUBLE)
                                    {
                                        case (true) { -> b.put_str(g"double\0"); }
                                        default
                                        {
                                            switch (k == LK.PTR)
                                            {
                                                case (true) {
                                                lt_text(b, t.elem);
                                                -> b.put(42);
                                            }
                                                default
                                                {
                                                    switch (k == LK.ARRAY)
                                                    {
                                                        case (true) {
                                                        b.put(91);
                                                        b.put_str(f"{t.count} x \0");
                                                        lt_text(b, t.elem);
                                                        -> b.put(93);
                                                    }
                                                        default
                                                        {
                                                            switch (k == LK.STRUCT)
                                                            {
                                                                case (true) {
                                                                b.put_str(g"{\0");
                                                                while (i < t.nitems)
                                                                {
                                                                    switch (i > 0)
                                                                    {
                                                                        case (true) { b.put_str(g", \0"); }
                                                                        default {};
                                                                    };
                                                                    lt_text(b, t.items[i]);
                                                                    i++;
                                                                };
                                                                -> b.put_str(g"}\0");
                                                            }
                                                                default
                                                                {
                                                                    switch (k == LK.ISTRUCT)
                                                                    {
                                                                        case (true) {
                                                                        b.put(37);
                                                                        -> put_quoted(b, t.name);
                                                                    }
                                                                        default
                                                                        {

                                                                            lt_text(b, t.elem);
                                                                            b.put_str(g" (\0");
                                                                            while (i < t.nitems)
                                                                            {
                                                                                switch (i > 0)
                                                                                {
                                                                                    case (true) { b.put_str(g", \0"); }
                                                                                    default {};
                                                                                };
                                                                                lt_text(b, t.items[i]);
                                                                                i++;
                                                                            };
                                                                            switch (t.vararg)
                                                                            {
                                                                                case (true) {
                                                                                switch (t.nitems > 0)
                                                                                {
                                                                                    case (true) { b.put_str(g", \0"); }
                                                                                    default {};
                                                                                };
                                                                                b.put_str(g"...\0");
                                                                            }
                                                                                default {};
                                                                            };
                                                                            -> b.put(41);
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };

        lt_eq(IRType* a, IRType* b) -> bool
        {
            int i;
            switch (a == b)
            {
                case (true) { -> true; }
                default
                {
                    switch (a == (IRType*)0 | b == (IRType*)0)
                    {
                        case (true) { -> false; }
                        default
                        {
                            switch (a.kind != b.kind)
                            {
                                case (true) { -> false; }
                                default
                                {
                                    int k = a.kind;
                                    switch (k == LK.VOID | k == LK.FLOAT | k == LK.DOUBLE)
                                    {
                                        case (true) { -> true; }
                                        default
                                        {
                                            switch (k == LK.INT)
                                            {
                                                case (true) { -> a.width == b.width; }
                                                default
                                                {
                                                    switch (k == LK.PTR)
                                                    {
                                                        case (true) { -> lt_eq(a.elem, b.elem); }
                                                        default
                                                        {
                                                            switch (k == LK.ARRAY)
                                                            {
                                                                case (true) {
                                                                switch (a.count != b.count)
                                                                {
                                                                    case (true) { -> false; }
                                                                    default {};
                                                                };
                                                                -> lt_eq(a.elem, b.elem);
                                                            }
                                                                default
                                                                {
                                                                    switch (k == LK.ISTRUCT)
                                                                    {
                                                                        case (true) { -> cstr_eq(a.name, b.name); }
                                                                        default
                                                                        {
                                                                            switch (a.nitems != b.nitems)
                                                                            {
                                                                                case (true) { -> false; }
                                                                                default
                                                                                {
                                                                                    switch (k == LK.FUNC)
                                                                                    {
                                                                                        case (true) {
                                                                                        switch (a.vararg != b.vararg)
                                                                                        {
                                                                                            case (true) { -> false; }
                                                                                            default
                                                                                            {
                                                                                                switch (!lt_eq(a.elem, b.elem))
                                                                                                {
                                                                                                    case (true) { -> false; }
                                                                                                    default {};
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    }
                                                                                        default {};
                                                                                    };
                                                                                    while (i < a.nitems)
                                                                                    {
                                                                                        switch (!lt_eq(a.items[i], b.items[i]))
                                                                                        {
                                                                                            case (true) { -> false; }
                                                                                            default
                                                                                            {
                                                                                                i++;
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                    -> true;
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };

        lt_is_int(IRType* t) -> bool -> t.kind == LK.INT;
        lt_is_ptr(IRType* t) -> bool -> t.kind == LK.PTR;
        lt_is_fp(IRType* t) -> bool -> t.kind == LK.FLOAT | t.kind == LK.DOUBLE;
        lt_is_agg(IRType* t) -> bool -> t.kind == LK.ARRAY | t.kind == LK.STRUCT | t.kind == LK.ISTRUCT;





        object IRModule
        {
            byte* mod_name;
            byte* triple;
            byte* layout;
            PtrVec* types;      
            PtrVec* values;     
            PtrVec* strs;       
            PtrVec* blobs;      
            PtrVec* named;      
            PtrVec* globals;    
            PtrVec* funcs;      
            bool must_tail;     
            NameMap* gnames;    
            NameMap* fmap;      
            NameMap* gmap;      
            Buf tb;             
            Buf ib;             
            Buf lb;             
            IRFunc* cf;         
            IRBlock* cb;        
            IRBlock* entry_b;   
            IRValue** ia;       
            IRType* nul;        

            __init(byte* name) -> this
            {
                this.mod_name = ts_dup(name);
                this.triple = (byte*)0;
                this.layout = (byte*)0;
                this.nul = (IRType*)0;
                this.types = pv_new();
                this.values = pv_new();
                this.strs = pv_new();
                this.blobs = pv_new();
                this.named = pv_new();
                this.globals = pv_new();
                this.funcs = pv_new();
                this.gnames = nm_new();
                this.fmap = nm_new();
                this.gmap = nm_new();
                this.tb.__init();
                this.ib.__init();
                this.lb.__init();
                this.cf = (IRFunc*)0;
                this.cb = (IRBlock*)0;
                this.entry_b = (IRBlock*)0;
                this.must_tail = false;
                this.ia = (IRValue**)fmalloc((u64)8 * (u64)((sizeof(IRValue*) + 7) / 8));
                this.nul = this.new_type(LK.VOID);
                this.nul.elem = this.nul;
                -> this;
            };

            __expr() -> IRModule* -> this;

            __exit() -> void
            {
                int i, j;
                IRFunc* f;
                IRBlock* bl;
                while (i < this.types.len)
                {
                    ffree((byte*)this.types.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.values.len)
                {
                    ffree((byte*)this.values.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.strs.len)
                {
                    ffree((byte*)this.strs.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.blobs.len)
                {
                    ffree((byte*)this.blobs.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.funcs.len)
                {
                    f = (IRFunc*)this.funcs.items[i];
                    j = 0;
                    while (j < f.blocks.len)
                    {
                        bl = (IRBlock*)f.blocks.items[j];
                        pv_free(bl.lines);
                        ffree((byte*)bl);
                        j++;
                    };
                    pv_free(f.blocks);
                    pv_free(f.attrs);
                    nm_free(f.names);
                    ffree((byte*)f.args);
                    ffree((byte*)f);
                    i++;
                };
                i = 0;
                while (i < this.globals.len)
                {
                    ffree((byte*)this.globals.items[i]);
                    i++;
                };
                pv_free(this.types);
                pv_free(this.values);
                pv_free(this.strs);
                pv_free(this.blobs);
                pv_free(this.named);
                pv_free(this.globals);
                pv_free(this.funcs);
                nm_free(this.gnames);
                nm_free(this.fmap);
                nm_free(this.gmap);
                ffree(this.mod_name);
                switch (this.triple != (byte*)0)
                {
                    case (true) { ffree(this.triple); }
                    default {};
                };
                switch (this.layout != (byte*)0)
                {
                    case (true) { ffree(this.layout); }
                    default {};
                };
                this.tb.__exit();
                this.ib.__exit();
                this.lb.__exit();
                -> ffree((byte*)this.ia);
            };

            set_target(byte* triple, byte* layout) -> void
            {
                this.triple = ts_dup(triple);
                this.layout = ts_dup(layout);
                ->;
            };


            own(byte* s) -> byte*
            {
                byte* r = ts_dup(s);
                pv_push(this.strs, (void*)r);
                -> r;
            };

            alloc_items(int n) -> IRType**
            {
                IRType** p = (IRType**)fmalloc((u64)(n + 1) * (u64)((sizeof(IRType*) + 7) / 8));
                pv_push(this.blobs, (void*)p);
                -> p;
            };

            new_type(int kind) -> IRType*
            {
                IRType* t = (IRType*)fmalloc((u64)((sizeof(IRType) + 7) / 8));
                t.kind = kind;
                t.width = 0;
                t.count = 0;
                t.elem = this.nul;
                t.items = (IRType**)0;
                t.nitems = 0;
                t.name = (byte*)0;
                t.vararg = false;
                t.defined = true;
                pv_push(this.types, (void*)t);
                -> t;
            };

            t_void() -> IRType* -> this.new_type(LK.VOID);
            t_float() -> IRType* -> this.new_type(LK.FLOAT);
            t_double() -> IRType* -> this.new_type(LK.DOUBLE);

            t_int(int width) -> IRType*
            {
                IRType* t = this.new_type(LK.INT);
                t.width = width;
                -> t;
            };

            t_ptr(IRType* elem) -> IRType*
            {
                IRType* t = this.new_type(LK.PTR);
                t.elem = elem;
                -> t;
            };

            t_array(IRType* elem, int count) -> IRType*
            {
                IRType* t = this.new_type(LK.ARRAY);
                t.elem = elem;
                t.count = count;
                -> t;
            };


            t_struct(IRType** items, int n) -> IRType*
            {
                int i;
                IRType* t = this.new_type(LK.STRUCT);
                t.items = this.alloc_items(n);
                while (i < n)
                {
                    t.items[i] = items[i];
                    i++;
                };
                t.nitems = n;
                -> t;
            };

            t_func(IRType* ret, IRType** params, int n, bool vararg) -> IRType*
            {
                int i;
                IRType* t = this.new_type(LK.FUNC);
                t.elem = ret;
                t.items = this.alloc_items(n);
                while (i < n)
                {
                    t.items[i] = params[i];
                    i++;
                };
                t.nitems = n;
                t.vararg = vararg;
                -> t;
            };



            t_named(byte* name) -> IRType*
            {
                int i;
                IRType* t;
                while (i < this.named.len)
                {
                    t = (IRType*)this.named.items[i];
                    switch (cstr_eq(t.name, name))
                    {
                        case (true) { -> t; }
                        default
                        {
                            i++;
                        };
                    };
                };
                t = this.new_type(LK.ISTRUCT);
                t.name = this.own(name);
                t.defined = false;
                pv_push(this.named, (void*)t);
                -> t;
            };

            set_body(IRType* t, IRType** items, int n) -> void
            {
                int i;
                t.items = this.alloc_items(n);
                while (i < n)
                {
                    t.items[i] = items[i];
                    i++;
                };
                t.nitems = n;
                t.defined = true;
                ->;
            };

            type_str(IRType* t) -> byte*
            {
                this.tb.clear();
                lt_text(@this.tb, t);
                -> this.own(this.tb.mem);
            };





            new_value(IRType* ty, byte* text) -> IRValue*
            {
                IRValue* v = (IRValue*)fmalloc((u64)((sizeof(IRValue) + 7) / 8));
                v.ty = ty;
                v.text = this.own(text);
                v.spec = (TypeSpec*)0;
                v.espec = (TypeSpec*)0;
                v.flags = 0;
                v.is_const = false;
                pv_push(this.values, (void*)v);
                -> v;
            };

            c_int(IRType* ty, i64 val) -> IRValue*
            {
                IRValue* v;
                this.tb.clear();
                switch (ty.width)
                {
                    case (1)
                    {
                        switch (val != (i64)0)
                        {
                            case (true) { this.tb.put_str(g"true\0"); }
                            default { this.tb.put_str(g"false\0"); };
                        };
                    }
                    default { put_i64(@this.tb, val); };
                };
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };


            c_u64(IRType* ty, u64 val) -> IRValue*
            {
                IRValue* v;
                this.tb.clear();
                put_u64(@this.tb, val);
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };

            c_null(IRType* ty) -> IRValue*
            {
                IRValue* v;
                switch (ty.kind)
                {
                    case (LK.PTR) { v = this.new_value(ty, g"null\0"); }
                    case (LK.INT)
                    {
                        v = this.c_int(ty, (i64)0);

                        switch (ty.width == 1)
                        {
                            case (true) { v.text = g"0\0"; }
                            default {};
                        };
                        -> v;
                    }
                    default
                    {
                        switch (ty.kind == LK.FLOAT | ty.kind == LK.DOUBLE)
                        {
                            case (true) {
                            v = this.c_fp(ty, 0.0);
                            -> v;
                        }
                            default { v = this.new_value(ty, g"zeroinitializer\0"); };
                        };
                    };
                };
                v.is_const = true;
                -> v;
            };

            c_undef(IRType* ty) -> IRValue*
            {
                IRValue* v = this.new_value(ty, g"undef\0");
                v.is_const = true;
                -> v;
            };



            c_fp(IRType* ty, double d) -> IRValue*
            {
                IRValue* v;
                float f;
                double dd = d;
                u64 bits;
                u64* bp;
                switch (ty.kind == LK.FLOAT)
                {
                    case (true) {
                    f = (float)d;
                    dd = (double)f;
                }
                    default {};
                };
                bp = (u64*)@dd;
                bits = *bp;
                this.tb.clear();
                put_hex64(@this.tb, bits);
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };


            c_array(IRType* ty, IRValue** elems, int n) -> IRValue*
            {
                IRValue* v;
                int i;
                this.tb.clear();
                this.tb.put(91);
                while (i < n)
                {
                    switch (i > 0) { case (true) { this.tb.put_str(g", \0"); } default {}; };
                    lt_text(@this.tb, elems[i].ty);
                    this.tb.put(32);
                    this.tb.put_str(elems[i].text);
                    i++;
                };
                this.tb.put(93);
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };


            c_bytes(IRType* ty, byte* bytes_in, int n) -> IRValue*
            {
                IRValue* v;
                int i;
                int c;
                this.tb.clear();
                this.tb.put_str(g"c\"\0");
                while (i < n)
                {
                    c = (int)bytes_in[i];
                    switch (c < 32 | c > 126 | c == 34 | c == 92)
                    {
                        case (true) {
                        this.tb.put(92);
                        this.tb.put(hexdig(c / 16));
                        this.tb.put(hexdig(c % 16));
                    }
                        default { this.tb.put(c); };
                    };
                    i++;
                };
                this.tb.put(34);
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };


            op_text(Buf* b, IRValue* v) -> void
            {
                lt_text(b, v.ty);
                b.put(32);
                -> b.put_str(v.text);
            };





            unique_global(byte* name) -> byte*
            {
                int n = 1;
                byte* cand;
                switch (!nm_has(this.gnames, name))
                {
                    case (true) { -> this.own(name); }
                    default
                    {
                        while (true)
                        {
                            this.tb.clear();
                            this.tb.put_str(name);
                            this.tb.put(46);
                            this.tb.put_int(n);
                            cand = this.tb.mem;
                            switch (!nm_has(this.gnames, cand))
                            {
                                case (true) { -> this.own(cand); }
                                default
                                {
                                    n++;
                                };
                            };
                        };
                        -> this.own(name);
                    };
                };
            };


            add_global(IRType* ty, byte* name, byte* init) -> IRGlobal*
            {
                IRGlobal* g = (IRGlobal*)fmalloc((u64)((sizeof(IRGlobal) + 7) / 8));
                g.name = this.unique_global(name);
                nm_put(this.gnames, g.name, (void*)g);
                nm_put(this.gmap, g.name, (void*)g);
                g.ty = ty;
                g.init = (byte*)0;
                switch (init != (byte*)0)
                {
                    case (true) { g.init = this.own(init); }
                    default {};
                };
                g.linkage = (byte*)0;
                g.constant = false;
                this.tb.clear();
                this.tb.put(64);
                put_quoted(@this.tb, g.name);
                g.self = this.new_value(this.t_ptr(ty), this.tb.mem);
                g.self.flags = 8;
                pv_push(this.globals, (void*)g);
                -> g;
            };

            find_global(byte* name) -> IRGlobal* -> (IRGlobal*)nm_get(this.gmap, name);



            add_function(IRType* ftype, byte* name) -> IRFunc*
            {
                int i;
                IRFunc* f = (IRFunc*)fmalloc((u64)((sizeof(IRFunc) + 7) / 8));
                f.name = this.unique_global(name);
                nm_put(this.gnames, f.name, (void*)f);
                nm_put(this.fmap, f.name, (void*)f);
                f.ftype = ftype;
                f.nargs = ftype.nitems;
                f.args = (IRValue**)fmalloc((u64)(f.nargs + 1) * (u64)((sizeof(IRValue*) + 7) / 8));
                f.blocks = pv_new();
                f.attrs = pv_new();
                f.names = nm_new();
                f.counter = 0;
                f.cconv = (byte*)0;
                f.linkage = (byte*)0;
                f.is_decl = true;
                while (i < f.nargs)
                {
                    f.counter = f.counter + 1;
                    this.tb.clear();
                    this.tb.put(37);
                    this.tb.put_str(f"\".{f.counter}\0");
                    this.tb.put(34);
                    f.args[i] = this.new_value(ftype.items[i], this.tb.mem);
                    i++;
                };
                this.tb.clear();
                this.tb.put(64);
                put_quoted(@this.tb, f.name);
                f.counter = f.counter + 1;
                f.self = this.new_value(this.t_ptr(ftype), this.tb.mem);
                pv_push(this.funcs, (void*)f);
                -> f;
            };

            find_function(byte* name) -> IRFunc* -> (IRFunc*)nm_get(this.fmap, name);


            name_arg(IRFunc* f, int i, byte* name) -> void
            {
                this.tb.clear();
                this.tb.put(37);
                put_quoted(@this.tb, name);
                f.args[i].text = this.own(this.tb.mem);
                -> nm_put(f.names, name, (void*)f);
            };


            rename_arg(IRFunc* f, int i, byte* name) -> void
            {
                byte* nm = this.fresh_name(f, name);
                f.args[i].text = this.result_text(nm);
                ->;
            };


            fresh_name(IRFunc* f, byte* base) -> byte*
            {
                int n = 1;
                byte* cand;
                switch (base == (byte*)0)
                {
                    case (true) {
                    f.counter = f.counter + 1;
                    this.tb.clear();
                    this.tb.put(46);
                    this.tb.put_int(f.counter);
                    -> this.own(this.tb.mem);
                }
                    default
                    {
                        switch (base[0] == 0)
                        {
                            case (true) {
                            f.counter = f.counter + 1;
                            this.tb.clear();
                            this.tb.put(46);
                            this.tb.put_int(f.counter);
                            -> this.own(this.tb.mem);
                        }
                            default
                            {
                                switch (!nm_has(f.names, base))
                                {
                                    case (true) {
                                    nm_put(f.names, base, (void*)f);
                                    -> this.own(base);
                                }
                                    default
                                    {
                                        while (true)
                                        {
                                            this.tb.clear();
                                            this.tb.put_str(base);
                                            this.tb.put(46);
                                            this.tb.put_int(n);
                                            cand = this.tb.mem;
                                            switch (!nm_has(f.names, cand))
                                            {
                                                case (true) {
                                                nm_put(f.names, cand, (void*)f);
                                                -> this.own(cand);
                                            }
                                                default
                                                {
                                                    n++;
                                                };
                                            };
                                        };
                                        -> this.own(base);
                                    };
                                };
                            };
                        };
                    };
                };
            };

            append_block(IRFunc* f, byte* name) -> IRBlock*
            {
                IRBlock* bl = (IRBlock*)fmalloc((u64)((sizeof(IRBlock) + 7) / 8));
                bl.name = this.fresh_name(f, name);
                bl.lines = pv_new();
                bl.terminated = false;
                pv_push(f.blocks, (void*)bl);
                f.is_decl = false;
                -> bl;
            };





            position(IRFunc* f, IRBlock* b) -> void
            {
                this.cf = f;
                this.cb = b;
                ->;
            };

            set_entry(IRBlock* b) -> void
            {
                this.entry_b = b;
                ->;
            };

            is_terminated() -> bool
            {
                switch (this.cb == (IRBlock*)0)
                {
                    case (true) { -> true; }
                    default
                    {
                        -> this.cb.terminated;
                    };
                };
            };

            const_val(IRValue* v) -> i64
            {
                int i;
                bool neg = false;
                i64 r;
                switch (v.text[0] == 45)
                {
                    case (true) { neg = true; i = 1; }
                    default {};
                };
                while (v.text[i] >= 48 & v.text[i] <= 57)
                {
                    r = r * (i64)10 + (i64)((int)v.text[i] - 48);
                    i++;
                };
                switch (neg)
                {
                    case (true) { -> (i64)0 - r; }
                    default
                    {
                        -> r;
                    };
                };
            };


            result_text(byte* name) -> byte*
            {
                this.tb.clear();
                this.tb.put(37);
                put_quoted(@this.tb, name);
                -> this.own(this.tb.mem);
            };



            fin(IRType* rty, byte* hint) -> IRValue*
            {
                byte* nm;
                byte* txt;
                IRValue* v;
                switch (rty == (IRType*)0)
                {
                    case (true) {

                    switch (hint != (byte*)0)
                    {
                        case (true) {
                        switch (hint[0]!?)
                        {
                            case (true) { this.fresh_name(this.cf, hint); }
                            default { this.cf.counter = this.cf.counter + 1; };
                        };
                    }
                        default { this.cf.counter = this.cf.counter + 1; };
                    };
                    pv_push(this.cb.lines, (void*)this.own(this.ib.mem));
                    -> (IRValue*)0;
                }
                    default
                    {
                        nm = this.fresh_name(this.cf, hint);
                        txt = this.result_text(nm);
                        this.lb.clear();
                        this.lb.put_str(f"{txt} = \0");
                        this.lb.put_str(this.ib.mem);
                        nm = this.own(this.lb.mem);
                        pv_push(this.cb.lines, (void*)nm);
                        v = this.new_value(rty, txt);
                        -> v;
                    };
                };
            };

            fin_term() -> void
            {
                this.cf.counter = this.cf.counter + 1;
                pv_push(this.cb.lines, (void*)this.own(this.ib.mem));
                this.cb.terminated = true;
                ->;
            };

            binop(byte* op, IRValue* a, IRValue* b, byte* hint) -> IRValue*
            {
                this.ib.clear();
                this.ib.put_str(op);
                this.ib.put(32);
                lt_text(@this.ib, a.ty);
                this.ib.put(32);
                this.ib.put_str(f"{a.text}, {b.text}\0");
                -> this.fin(a.ty, hint);
            };

            cmp(byte* kind, byte* pred, IRValue* a, IRValue* b, byte* hint) -> IRValue*
            {
                this.ib.clear();
                this.ib.put_str(kind);
                this.ib.put(32);
                this.ib.put_str(pred);
                this.ib.put(32);
                lt_text(@this.ib, a.ty);
                this.ib.put(32);
                this.ib.put_str(f"{a.text}, {b.text}\0");
                -> this.fin(this.t_int(1), hint);
            };

            icmp(byte* pred, IRValue* a, IRValue* b, byte* hint) -> IRValue* -> this.cmp(g"icmp\0", pred, a, b, hint);

            fcmp(byte* pred, IRValue* a, IRValue* b, byte* hint) -> IRValue* -> this.cmp(g"fcmp\0", pred, a, b, hint);

            cast(byte* op, IRValue* v, IRType* to, byte* hint) -> IRValue*
            {
                switch (lt_eq(v.ty, to))
                {
                    case (true) { -> v; }
                    default
                    {
                        this.ib.clear();
                        this.ib.put_str(op);
                        this.ib.put(32);
                        this.op_text(@this.ib, v);
                        this.ib.put_str(g" to \0");
                        lt_text(@this.ib, to);
                        -> this.fin(to, hint);
                    };
                };
            };

            alloca(IRType* ty, byte* name) -> IRValue*
            {
                IRValue* av;
                int pos;
                byte* nm = this.fresh_name(this.cf, name);
                byte* txt = this.result_text(nm);
                IRBlock* eb = this.entry_b;
                this.lb.clear();
                this.lb.put_str(f"{txt} = alloca \0");
                lt_text(@this.lb, ty);
                pos = eb.lines.len;
                switch (eb.terminated)
                {
                    case (true) { pos = pos - 1; }
                    default {};
                };
                pv_insert(eb.lines, pos, (void*)this.own(this.lb.mem));
                av = this.new_value(this.t_ptr(ty), txt);
                av.flags = 4;
                -> av;
            };


            alloca_here(IRType* ty, byte* name) -> IRValue*
            {
                IRValue* av;
                this.ib.clear();
                this.ib.put_str(g"alloca \0");
                lt_text(@this.ib, ty);
                av = this.fin(this.t_ptr(ty), name);
                av.flags = 4;
                -> av;
            };


            alloca_count(IRType* ty, IRValue* count, byte* name) -> IRValue*
            {
                IRValue* av;
                this.ib.clear();
                this.ib.put_str(g"alloca \0");
                lt_text(@this.ib, ty);
                this.ib.put_str(g", \0");
                this.op_text(@this.ib, count);
                av = this.fin(this.t_ptr(ty), name);
                av.flags = 4;
                -> av;
            };

            load(IRValue* p, byte* hint) -> IRValue*
            {
                this.ib.clear();
                this.ib.put_str(g"load \0");
                lt_text(@this.ib, p.ty.elem);
                this.ib.put_str(g", \0");
                this.op_text(@this.ib, p);
                -> this.fin(p.ty.elem, hint);
            };

            store_ex(IRValue* v, IRValue* p, bool vol) -> void
            {
                this.ib.clear();
                switch (vol)
                {
                    case (true) { this.ib.put_str(g"store volatile \0"); }
                    default { this.ib.put_str(g"store \0"); };
                };
                this.op_text(@this.ib, v);
                this.ib.put_str(g", \0");
                this.op_text(@this.ib, p);
                this.fin((IRType*)0, (byte*)0);
                ->;
            };

            store(IRValue* v, IRValue* p) -> void -> this.store_ex(v, p, false);


            index_type(IRType* t, IRValue* idx) -> IRType*
            {
                switch (t.kind == LK.ARRAY)
                {
                    case (true) { -> t.elem; }
                    default
                    {
                        switch (t.kind == LK.PTR)
                        {
                            case (true) { -> t.elem; }
                            default
                            {
                                -> t.items[(int)this.const_val(idx)];
                            };
                        };
                    };
                };
            };

            struct_items(IRType* t) -> IRType** -> t.items;

            gep(IRValue* p, IRValue** idx, int n, bool inbounds, byte* hint) -> IRValue*
            {
                int i = 1;
                IRType* t = p.ty.elem;
                this.ib.clear();
                this.ib.put_str(g"getelementptr \0");
                switch (inbounds)
                {
                    case (true) { this.ib.put_str(g"inbounds \0"); }
                    default {};
                };
                lt_text(@this.ib, p.ty.elem);
                this.ib.put_str(g", \0");
                this.op_text(@this.ib, p);
                this.ib.put_str(g", \0");
                this.op_text(@this.ib, idx[0]);
                while (i < n)
                {
                    this.ib.put_str(g", \0");
                    this.op_text(@this.ib, idx[i]);
                    switch (t.kind)
                    {
                        case (LK.ISTRUCT)
                        {
                            t = this.struct_body_item(t, (int)this.const_val(idx[i]));
                        }
                        default { t = this.index_type(t, idx[i]); };
                    };
                    i++;
                };
                -> this.fin(this.t_ptr(t), hint);
            };


            struct_body_item(IRType* t, int i) -> IRType* -> t.items[i];


            gep_field(IRValue* p, int i, bool inbounds, byte* hint) -> IRValue*
            {
                this.ia[0] = this.c_int(this.t_int(32), (i64)0);
                this.ia[1] = this.c_int(this.t_int(32), (i64)i);
                -> this.gep(p, this.ia, 2, inbounds, hint);
            };


            gep_ptr(IRValue* p, IRValue* i, bool inbounds, byte* hint) -> IRValue*
            {
                this.ia[0] = i;
                -> this.gep(p, this.ia, 1, inbounds, hint);
            };

            call_ex(IRValue* callee, IRValue** args, int n, byte* hint, byte* cconv, bool tail) -> IRValue*
            {
                int i;
                IRType* fty = callee.ty.elem;
                this.ib.clear();
                switch (this.must_tail)
                {
                    case (true) {
                    this.ib.put_str(g"musttail \0");
                    this.must_tail = false;
                }
                    default {
                        switch (tail)
                        {
                            case (true) { this.ib.put_str(g"tail \0"); }
                            default {};
                        };
                    };
                };
                this.ib.put_str(g"call \0");
                switch (cconv != (byte*)0)
                {
                    case (true) {
                    this.ib.put_str(cconv);
                    this.ib.put(32);
                }
                    default {};
                };
                switch (fty.vararg)
                {
                    case (true) {
                    lt_text(@this.ib, fty.elem);
                    this.ib.put_str(g" (\0");
                    while (i < fty.nitems)
                    {
                        switch (i > 0)
                        {
                            case (true) { this.ib.put_str(g", \0"); }
                            default {};
                        };
                        lt_text(@this.ib, fty.items[i]);
                        i++;
                    };
                    switch (fty.nitems > 0)
                    {
                        case (true) { this.ib.put_str(g", \0"); }
                        default {};
                    };
                    this.ib.put_str(g"...)\0");
                }
                    default { lt_text(@this.ib, fty.elem); };
                };
                this.ib.put(32);
                this.ib.put_str(callee.text);
                this.ib.put(40);
                i = 0;
                while (i < n)
                {
                    switch (i > 0)
                    {
                        case (true) { this.ib.put_str(g", \0"); }
                        default {};
                    };
                    this.op_text(@this.ib, args[i]);
                    i++;
                };
                this.ib.put(41);
                switch (fty.elem.kind == LK.VOID)
                {
                    case (true) { -> this.fin((IRType*)0, hint); }
                    default
                    {
                        -> this.fin(fty.elem, hint);
                    };
                };
            };

            call(IRValue* callee, IRValue** args, int n, byte* hint) -> IRValue* -> this.call_ex(callee, args, n, hint, (byte*)0, false);

            phi(IRType* ty, IRValue** vals, IRBlock** blocks, int n, byte* hint) -> IRValue*
            {
                int i;
                this.ib.clear();
                this.ib.put_str(g"phi  \0");
                lt_text(@this.ib, ty);
                this.ib.put(32);
                while (i < n)
                {
                    switch (i > 0)
                    {
                        case (true) { this.ib.put_str(g", \0"); }
                        default {};
                    };
                    this.ib.put_str(f"[{vals[i].text}, %\0");
                    put_quoted(@this.ib, blocks[i].name);
                    this.ib.put(93);
                    i++;
                };
                -> this.fin(ty, hint);
            };


            va_arg(IRValue* list, IRType* ty, byte* hint) -> IRValue*
            {
                this.ib.clear();
                this.ib.put_str(g"va_arg \0");
                this.op_text(@this.ib, list);
                this.ib.put_str(g", \0");
                lt_text(@this.ib, ty);
                -> this.fin(ty, hint);
            };

            select(IRValue* c, IRValue* a, IRValue* b, byte* hint) -> IRValue*
            {
                this.ib.clear();
                this.ib.put_str(g"select  \0");
                this.op_text(@this.ib, c);
                this.ib.put_str(g", \0");
                this.op_text(@this.ib, a);
                this.ib.put_str(g", \0");
                this.op_text(@this.ib, b);
                -> this.fin(a.ty, hint);
            };

            extractvalue(IRValue* agg, int i, byte* hint) -> IRValue*
            {
                IRType* t = this.index_type(agg.ty, this.c_int(this.t_int(32), (i64)i));
                this.ib.clear();
                this.ib.put_str(g"extractvalue \0");
                this.op_text(@this.ib, agg);
                this.ib.put_str(f", {i}\0");
                -> this.fin(t, hint);
            };

            insertvalue(IRValue* agg, IRValue* v, int i, byte* hint) -> IRValue*
            {
                this.ib.clear();
                this.ib.put_str(g"insertvalue \0");
                this.op_text(@this.ib, agg);
                this.ib.put_str(g", \0");
                this.op_text(@this.ib, v);
                this.ib.put_str(f", {i}\0");
                -> this.fin(agg.ty, hint);
            };

            br(IRBlock* target) -> void
            {
                this.ib.clear();
                this.ib.put_str(g"br label %\0");
                put_quoted(@this.ib, target.name);
                -> this.fin_term();
            };

            cbr(IRValue* c, IRBlock* t, IRBlock* f) -> void
            {
                this.ib.clear();
                this.ib.put_str(g"br \0");
                this.op_text(@this.ib, c);
                this.ib.put_str(g", label %\0");
                put_quoted(@this.ib, t.name);
                this.ib.put_str(g", label %\0");
                put_quoted(@this.ib, f.name);
                -> this.fin_term();
            };

            ret(IRValue* v) -> void
            {
                this.ib.clear();
                this.ib.put_str(g"ret \0");
                this.op_text(@this.ib, v);
                -> this.fin_term();
            };

            ret_void() -> void
            {
                this.ib.clear();
                this.ib.put_str(g"ret void\0");
                -> this.fin_term();
            };

            unreachable() -> void
            {
                this.ib.clear();
                this.ib.put_str(g"unreachable\0");
                -> this.fin_term();
            };

            switch_to(IRValue* v, IRBlock* dflt, IRValue** vals, IRBlock** blocks, int n) -> void
            {
                int i;
                this.ib.clear();
                this.ib.put_str(g"switch \0");
                this.op_text(@this.ib, v);
                this.ib.put_str(g", label %\0");
                put_quoted(@this.ib, dflt.name);
                this.ib.put_str(g" [\0");
                while (i < n)
                {
                    switch (i > 0)
                    {
                        case (true) { this.ib.put(32); }
                        default {};
                    };
                    this.op_text(@this.ib, vals[i]);
                    this.ib.put_str(g", label %\0");
                    put_quoted(@this.ib, blocks[i].name);
                    i++;
                };
                this.ib.put(93);
                -> this.fin_term();
            };





            put_function(Buf* out, IRFunc* f) -> void
            {
                int i;
                int j;
                int k;
                IRBlock* bl;
                IRType* ft = f.ftype;
                switch (f.is_decl)
                {
                    case (true) { out.put_str(g"declare \0"); }
                    default { out.put_str(g"define \0"); };
                };
                switch (f.linkage != (byte*)0)
                {
                    case (true) {
                    out.put_str(f.linkage);
                    out.put(32);
                }
                    default {};
                };
                switch (f.cconv != (byte*)0)
                {
                    case (true) {
                    out.put_str(f.cconv);
                    out.put(32);
                }
                    default {};
                };
                lt_text(out, ft.elem);
                out.put(32);
                out.put(64);
                put_quoted(out, f.name);
                out.put(40);
                while (i < f.nargs)
                {
                    switch (i > 0)
                    {
                        case (true) { out.put_str(g", \0"); }
                        default {};
                    };
                    lt_text(out, ft.items[i]);
                    out.put(32);
                    out.put_str(f.args[i].text);
                    i++;
                };
                switch (ft.vararg)
                {
                    case (true) {
                    switch (f.nargs > 0)
                    {
                        case (true) { out.put_str(g", \0"); }
                        default {};
                    };
                    out.put_str(g"...\0");
                }
                    default {};
                };
                out.put(41);
                while (j < f.attrs.len)
                {
                    out.put(32);
                    out.put_str((byte*)f.attrs.items[j]);
                    j++;
                };
                switch (f.is_decl)
                {
                    case (true) {
                    -> out.put(10);
                }
                    default
                    {
                        out.put_str(g"\n{\n\0");
                        j = 0;
                        while (j < f.blocks.len)
                        {
                            bl = (IRBlock*)f.blocks.items[j];
                            put_quoted_label(out, bl.name);
                            k = 0;
                            while (k < bl.lines.len)
                            {
                                out.put_str(g"  \0");
                                out.put_str((byte*)bl.lines.items[k]);
                                out.put(10);
                                k++;
                            };
                            j++;
                        };
                        -> out.put_str(g"}\n\0");
                    };
                };
            };


            emit(Buf* out) -> void
            {
                int i;
                int j;
                IRType* t;
                IRGlobal* g;
                out.put_str(g"; ModuleID = \0");
                put_quoted(out, this.mod_name);
                out.put(10);
                switch (this.triple != (byte*)0)
                {
                    case (true) {
                    out.put_str(g"target triple = \0");
                    put_quoted(out, this.triple);
                    out.put(10);
                }
                    default {};
                };
                switch (this.layout != (byte*)0)
                {
                    case (true) {
                    out.put_str(g"target datalayout = \0");
                    put_quoted(out, this.layout);
                    out.put(10);
                }
                    default {};
                };
                out.put(10);
                while (i < this.named.len)
                {
                    t = (IRType*)this.named.items[i];
                    out.put(37);
                    put_quoted(out, t.name);
                    switch (t.defined)
                    {
                        case (true) {
                        out.put_str(g" = type {\0");
                        j = 0;
                        while (j < t.nitems)
                        {
                            switch (j > 0)
                            {
                                case (true) { out.put_str(g", \0"); }
                                default {};
                            };
                            lt_text(out, t.items[j]);
                            j++;
                        };
                        out.put_str(g"}\n\0");
                    }
                        default { out.put_str(g" = type opaque\n\0"); };
                    };
                    i++;
                };
                i = 0;
                while (i < this.funcs.len)
                {
                    out.put(10);
                    this.put_function(out, (IRFunc*)this.funcs.items[i]);
                    i++;
                };
                out.put(10);
                i = 0;
                while (i < this.globals.len)
                {
                    g = (IRGlobal*)this.globals.items[i];
                    out.put(64);
                    put_quoted(out, g.name);
                    out.put_str(g" = \0");
                    switch (g.linkage != (byte*)0)
                    {
                        case (true) {
                        out.put_str(g.linkage);
                        out.put(32);
                    }
                        default {};
                    };
                    switch (g.constant)
                    {
                        case (true) { out.put_str(g"constant \0"); }
                        default { out.put_str(g"global \0"); };
                    };
                    lt_text(out, g.ty);
                    switch (g.init != (byte*)0)
                    {
                        case (true) {
                        out.put(32);
                        out.put_str(g.init);
                    }
                        default {};
                    };
                    out.put(10);
                    i++;
                };
                ->;
            };
        };

    };
};



























































































































































namespace standard
{
    namespace watchdog
    {


        global const i64 WATCHDOG_DEFAULT_LIMIT_SEC = 300,
                         WATCHDOG_DEFAULT_INTERVAL  = 50000;



        object Watchdog
        {
            i64 start_ns,       
                limit_ns,       
                interval,       
                count;          
            bool tripped;       

            __init() -> this
            {
                this.limit_ns = WATCHDOG_DEFAULT_LIMIT_SEC * standard::time::TIME_NS_PER_SEC;
                this.interval = WATCHDOG_DEFAULT_INTERVAL;
                this.start_ns = 0;
                this.count = 0;
                this.tripped = false;
                return this;
            };

            __expr() -> Watchdog* -> this;

            __exit() -> void
            {
                return;
            };



            configure(i64 limit_sec, i64 every) -> void
            {
                if (limit_sec < 1) { limit_sec = 1; };
                if (every < 1) { every = 1; };
                this.limit_ns = limit_sec * standard::time::TIME_NS_PER_SEC;
                this.interval = every;
                return;
            };


            arm() -> void
            {
                this.start_ns = standard::time::time_now();
                this.count = 0;
                this.tripped = false;
                return;
            };


            tick() -> bool
            {
                if (this.tripped) { return true; };
                this.count++;
                if (this.count % this.interval == 0)
                {
                    if (standard::time::time_now() - this.start_ns > this.limit_ns)
                    {
                        this.tripped = true;
                    };
                };
                return this.tripped;
            };


            elapsed_ns() -> i64
            {
                return standard::time::time_now() - this.start_ns;
            };


            elapsed_sec() -> i64
            {
                return this.elapsed_ns() / standard::time::TIME_NS_PER_SEC;
            };


            limit_sec() -> i64
            {
                return this.limit_ns / standard::time::TIME_NS_PER_SEC;
            };
        };
    };
};




































































































































































































