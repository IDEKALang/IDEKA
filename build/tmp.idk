                                                    {
                                                        case (true) {
                                                        this.e_begin(PPError.SYNTAX);
                                                        this.errb.put_str(g"[PREPROCESSOR] #package directive missing semicolon at line \0");
                                                        this.errb.put_int(i + 1);
                                                        -> -1;
                                                    }
                                                        default {};
                                                    };
                                                    a = s + 8;
                                                    b = e;
                                                    while (b > a)
                                                    {
                                                        switch (text[b - 1] != 59)
                                                        {
                                                            case (true) { break; }
                                                            default {};
                                                        };
                                                        b--;
                                                    };
                                                    pp_trim(text, @a, @b);
                                                    j = a;
                                                    while (j <= b)
                                                    {
                                                        k = j;
                                                        while (k < b)
                                                        {
                                                            switch (text[k] == ',')
                                                            {
                                                                case (true) { break; }
                                                                default {};
                                                            };
                                                            k++;
                                                        };
                                                        ts = j;
                                                        te = k;
                                                        pp_trim(text, @ts, @te);
                                                        switch (te > ts)
                                                        {
                                                            case (true) {
                                                            switch (!this.process_package(text, ts, te - ts))
                                                            {
                                                                case (true) { -> -1; }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                        j = k + 1;
                                                    };
                                                    this.emit_blank(this.cur_lineno);
                                                    -> i + 1;
                                                }
                                                    default
                                                    {

                                                        switch (pp_starts(text, s, e, g"#import\0", 7))
                                                        {
                                                            case (true) {
                                                            switch (text[e - 1] != 59)
                                                            {
                                                                case (true) {
                                                                this.e_begin(PPError.SYNTAX);
                                                                this.errb.put_str(g"[PREPROCESSOR] #import directive missing semicolon at line \0");
                                                                this.errb.put_int(i + 1);
                                                                -> -1;
                                                            }
                                                                default {};
                                                            };
                                                            a = s + 7;
                                                            b = e;
                                                            while (b > a)
                                                            {
                                                                switch (text[b - 1] != 59)
                                                                {
                                                                    case (true) { break; }
                                                                    default {};
                                                                };
                                                                b--;
                                                            };
                                                            pp_trim(text, @a, @b);
                                                            j = a;
                                                            while (j < b)
                                                            {
                                                                k = (int)text[j];
                                                                switch (k)
                                                                {
                                                                    case ('<')
                                                                    {
                                                                        j++;
                                                                        q2 = pp_find(text, j, b, '>');
                                                                        switch (q2 == -1)
                                                                        {
                                                                            case (true) {
                                                                            this.e_begin(PPError.SYNTAX);
                                                                            this.errb.put_str(g"[PREPROCESSOR] Unterminated <> in #import at line \0");
                                                                            this.errb.put_int(i + 1);
                                                                            -> -1;
                                                                        }
                                                                            default {};
                                                                        };
                                                                        ts = j;
                                                                        te = q2;
                                                                        pp_trim(text, @ts, @te);
                                                                        switch (this.verbose)
                                                                        {
