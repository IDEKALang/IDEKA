                pv_free(this.al_names);
                pv_free(this.al_tys);
                pv_free(this.al_specs);
                pv_free(this.al_idx);
                pv_free(this.scopes);
                pv_free(this.inited_unions);
                ffree(this.cur_ns);
                this.mod.__exit();
                ffree((byte*)this.mod);
                this.sc.__exit();
                this.asmb.__exit();
                -> this.asmc.__exit();
            };





            fail(byte* msg, int line) -> void
            {
                this.nerrors++;
                switch (this.err_msg == (byte*)0)
                {
                    case (true) {
                    this.err_msg = this.mod.own(msg);
                    this.err_line = line;
                    this.err_col = this.pend_col;
                }
                    default {};
                };
                this.pend_col = 0;
                ->;
            };


            fail_at(Node* n, byte* msg) -> void
            {
                this.pend_col = n.col;
                this.fail(msg, n.line);
                ->;
            };


            keep(void* p) -> void
            {
                -> pv_push(this.owned, p);
            };

            ptr_of(IRType* t) -> IRType* -> this.mod.t_ptr(t);

            set_ns(byte* ns) -> void
            {
                ffree(this.cur_ns);
                this.cur_ns = ts_dup(ns);
                -> st_set_namespace(this.st, ns);
            };


            join_ns(byte* parent, byte* name) -> byte*
            {
                switch (parent[0] == 0)
                {
                    case (true) { -> ts_dup(name); }
                    default
                    {
                        -> join3(parent, g"::\0", name);
                    };
                };
            };





            add_const(byte* mangled, i64 v) -> void
            {
                i64* box = (i64*)fmalloc((u64)8);
                box[0] = v;
                this.keep((void*)box);
                -> nm_put(this.consts, mangled, (void*)box);
            };

            const_get(byte* name, i64* out) -> bool
            {
                void* p = nm_get(this.consts, name);
                switch (p == (void*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        i64* box = (i64*)p;
                        out[0] = box[0];
                        -> true;
                    };
                };
            };



            resolve_dim(byte* name, i64* out) -> bool
            {
                byte* m;
                bool ok;
                int i;
                IDKC_SYMENTRY* e;
                switch (this.const_get(name, out))
                {
                    case (true) { -> true; }
                    default
                    {
                        switch (this.cur_ns[0] != 0)
                        {
                            case (true) {
                            m = mangle_namespace_name(this.cur_ns, name);
                            ok = this.const_get(m, out);
                            ffree(m);
                            switch (ok)
                            {
                                case (true) { -> true; }
                                default {};
                            };
                        }
                            default {};
                        };
                        while (i < this.st.using_ns.len)
                        {
                            m = mangle_namespace_name((byte*)this.st.using_ns.items[i], name);
                            ok = this.const_get(m, out);
                            ffree(m);
                            switch (ok)
                            {
                                case (true) { -> true; }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                        e = st_lookup_any(this.st, name, (byte*)0);
                        switch (e != (IDKC_SYMENTRY*)0)
                        {
                            case (true) {
                            m = sym_mangled(e);
                            ok = this.const_get(m, out);
                            ffree(m);
                            switch (ok)
                            {
                                case (true) { -> true; }
                                default {};
                            };
                        }
                            default {};
                        };
                        -> false;
                    };
                };
            };



            ns_count(Node* n, int s) -> int
            {
                switch (s < 6)
                {
                    case (true) { -> node_count(n, s); }
                    default
                    {
                        switch (s == 6)
                        {
                            case (true) {
                            switch (n.a == (Node*)0)
                            {
                                case (true) { -> 0; }
                                default {};
                            };
                            -> node_count(n.a, 0);
                        }
                            default
                            {
                                switch (n.b == (Node*)0)
                                {
                                    case (true) { -> 0; }
                                    default
                                    {
                                        -> node_count(n.b, 0);
                                    };
                                };
                            };
                        };
                    };
                };
            };

            ns_child(Node* n, int s, int i) -> Node*
            {
                switch (s < 6)
                {
                    case (true) { -> node_child(n, s, i); }
                    default
                    {
                        switch (s == 6)
                        {
                            case (true) { -> node_child(n.a, 0, i); }
                            default
                            {
                                -> node_child(n.b, 0, i);
                            };
                        };
                    };
                };
            };



            const_by_name(byte* ns, byte* name, i64* out) -> bool
            {
                byte* cur = ts_dup(ns);
                byte* m;
                int n;
                bool found = false;
                while (!found)
                {
                    m = mangle_namespace_name(cur, name);
                    found = this.const_get(m, out);
                    ffree(m);
                    n = pp_cstrlen(cur);
                    switch (found | n == 0)
                    {
                        case (true) {}
                        default
                        {

                            while (n > 0 & cur[n - 1] != ':') { n--; };
                            switch (n > 0) { case (true) { n = n - 1; } default {}; };
                            while (n > 0 & cur[n - 1] == ':') { n--; };
                            cur[n] = (byte)0;
                            switch (n == 0 & !found)
                            {
                                case (true) {
                                    found = this.const_get(name, out);
                                    n = -1;
                                }
                                default {};
                            };
                        };
                    };
                    switch (n <= 0) { case (true) { ffree(cur); -> found; } default {}; };
                };
                ffree(cur);
                -> found;
            };




            ginit_eval(Node* e, byte* ns, i64* out) -> bool
            {
                i64 l, r;
                switch (e.kind)
                {
                    case (NodeKind.LITERAL)
                    {
                        switch (e.op == DataType.SINT) { case (true) { *out = e.ival; -> true; } default {}; };
                        switch (e.op == DataType.BOOL)
                        {
                            case (true) {
                                switch (e.ival != (i64)0) { case (true) { *out = (i64)1; } default { *out = (i64)0; }; };
                                -> true;
                            }
                            default {};
                        };
                        -> false;
                    }
                    case (NodeKind.IDENTIFIER) { -> this.const_by_name(ns, e.text, out); }
                    case (NodeKind.UNARY_OP)
                    {
                        switch (!this.ginit_eval(e.a, ns, @l)) { case (true) { -> false; } default {}; };
                        switch (e.op == Operator.SUB) { case (true) { *out = (i64)0 - l; -> true; } default {}; };
                        switch (e.op == Operator.NOT) { case (true) { *out = `!l; -> true; } default {}; };
                        -> false;
                    }
                    case (NodeKind.BINARY_OP)
                    {
                        switch (!this.ginit_eval(e.a, ns, @l)) { case (true) { -> false; } default {}; };
                        switch (!this.ginit_eval(e.b, ns, @r)) { case (true) { -> false; } default {}; };
                        switch (e.op)
                        {
                            case (Operator.ADD) { *out = l + r; -> true; }
                            case (Operator.SUB) { *out = l - r; -> true; }
                            case (Operator.MUL) { *out = l * r; -> true; }
                            case (Operator.DIV)
                            {
                                switch (r == (i64)0) { case (true) { -> false; } default {}; };
                                *out = l / r;
                                switch (l % r != (i64)0 & ((l < (i64)0) != (r < (i64)0))) { case (true) { *out = *out - (i64)1; } default {}; };
                                -> true;
                            }
                            case (Operator.MOD)
                            {
                                switch (r == (i64)0) { case (true) { -> false; } default {}; };
                                *out = l % r;
                                switch (*out != (i64)0 & ((*out < (i64)0) != (r < (i64)0))) { case (true) { *out = *out + r; } default {}; };
                                -> true;
                            }
                            case (Operator.AND) { *out = l `& r; -> true; }
                            case (Operator.OR) { *out = l `| r; -> true; }
                            case (Operator.XOR) { *out = l `^| r; -> true; }
                            case (Operator.BITAND) { *out = l `& r; -> true; }
                            case (Operator.BITOR) { *out = l `| r; -> true; }
                            case (Operator.BITXOR) { *out = l `^| r; -> true; }
                            case (Operator.BITSHIFT_LEFT)
                            {
                                switch (r < (i64)0 | r > (i64)63) { case (true) { -> false; } default {}; };
                                *out = l << (int)r;
                                -> true;
                            }
                            case (Operator.BITSHIFT_RIGHT)
                            {
                                switch (r < (i64)0 | r > (i64)63) { case (true) { -> false; } default {}; };
                                *out = l >> (int)r;
                                -> true;
                            }
                            default { -> false; };
                        };
                    }
                    default { -> false; };
                };
            };



            const_base_seen(byte* m) -> bool
            {
                int i = 0;
                int lm = pp_cstrlen(m);
                int j, lk, bm, bk;
                byte* k;
                bm = lm;
                while (bm > 1 & !(m[bm - 1] == '_' & m[bm - 2] == '_')) { bm--; };
                switch (bm <= 1) { case (true) { bm = 0; } default {}; };
                while (i < this.consts.count)
                {
                    k = (byte*)this.consts.keys[i];
                    lk = pp_cstrlen(k);
                    bk = lk;
                    while (bk > 1 & !(k[bk - 1] == '_' & k[bk - 2] == '_')) { bk--; };
                    switch (bk <= 1) { case (true) { bk = 0; } default {}; };
                    switch (lk - bk == lm - bm)
                    {
                        case (true) {
                            j = 0;
                            while (j < lm - bm & m[bm + j] == k[bk + j]) { j++; };
                            switch (j == lm - bm) { case (true) { -> true; } default {}; };
                        }
                        default {};
                    };
                    i++;
                };
                -> false;
            };




            collect_var_const(Node* n, byte* ns) -> void
            {
                TypeSpec* ts = n.ts;
                Node* ini = n.a;
                byte* m;
                i64 v;
                int w;
                int bt;
                bool got = false;
                switch (n.text == (byte*)0 | ts == (TypeSpec*)0) { case (true) { ->; } default {}; };
                bt = ts.base_type;
                switch (ts.custom_typename != (byte*)0 | ts_is_pointer(ts) | ts_is_array(ts)) { case (true) { ->; } default {}; };
                switch (bt == DataType.SINT | bt == DataType.UINT | bt == DataType.SLONG | bt == DataType.ULONG |
                    bt == DataType.CHAR | bt == DataType.BYTE | bt == DataType.BOOL | bt == DataType.DATA)
                {
                    case (true) {}
                    default { ->; };
                };
                w = typespec_bit_width(ts);
                switch (w <= 0 | w > 64) { case (true) { ->; } default {}; };
                m = mangle_namespace_name(ns, n.text);
                switch (this.const_base_seen(m)) { case (true) { ffree(m); ->; } default {}; };
                v = (i64)0;
                switch (ini == (Node*)0)
                {
                    case (true) { got = true; }
                    default
                    {
                        switch (ini.kind == NodeKind.NO_INIT)
                        {
                            case (true) { ffree(m); ->; }
                            default {};
                        };
                        switch (ini.kind == NodeKind.LITERAL)
                        {
                            case (true)
                            {

                                switch (ini.op == DataType.SINT) { case (true) { v = ini.ival; got = true; } default {}; };
                                switch (ini.op == DataType.BOOL)
                                {
                                    case (true) {
                                        switch (ini.ival != (i64)0) { case (true) { v = (i64)1; } default {}; };
                                        got = true;
                                    }
                                    default {};
                                };
                                switch (ini.op == DataType.UINT | ini.op == DataType.ULONG | ini.op == DataType.DATA)
                                {
                                    case (true) {
                                        v = ini.ival;
                                        switch (w < 64 & v > (((i64)1 << (w - 1)) - (i64)1)) { case (true) { v = v - ((i64)1 << w); } default {}; };
                                        got = true;
                                    }
                                    default {};
                                };

                                switch (!got & (ini.op == DataType.FLOAT | ini.op == DataType.DOUBLE)) { case (true) { ffree(m); ->; } default {}; };
                                got = true;
                            }
                            default
                            {
                                switch (!this.ginit_eval(ini, ns, @v)) { case (true) { v = (i64)0; } default {}; };
                                got = true;
                            };
                        };
                    };
                };
                this.add_const(m, v);
                ffree(m);
                ->;
            };


            collect_consts(Node* n, byte* ns) -> void
            {
                int k = n.kind;
                int s, c, e;
                byte* full;
                switch (k == NodeKind.NAMESPACE_DEF_STATEMENT | k == NodeKind.EXPORT_BLOCK |
                    k == NodeKind.EXTERN_BLOCK)
                {
                    case (true) {
                    switch (n.a != (Node*)0)
                    {
                        case (true) { this.collect_consts(n.a, ns); }
                        default {};
                    };
                    ->;
                }
                    default
                    {
                        switch (k == NodeKind.NAMESPACE_DEF)
                        {
                            case (true) {
                            full = this.join_ns(ns, n.text);
                            while (s < 8)
                            {
                                c = this.ns_count(n, s);
                                e = 0;
                                while (e < c)
                                {
                                    this.collect_consts(this.ns_child(n, s, e), full);
                                    e++;
                                };
                                s++;
                            };
                            -> ffree(full);
                        }
                            default
                            {
                                switch (k == NodeKind.VARIABLE_DECLARATION)
                                {
                                    case (true) { this.collect_var_const(n, ns); }
                                    default {};
                                };
                                ->;
                            };
                        };
                    };
                };
            };






            type_of_symbol(IDKC_SYMENTRY* e) -> IRType*
            {
                byte* m = sym_mangled(e);
                void* p;
                IRType* r = (IRType*)0;
                switch (e.kind_id == SymbolKind.STRUCT | e.kind_id == SymbolKind.OBJECT)
                {
                    case (true) {
                    p = nm_get(this.structs, m);
                    switch (p != (void*)0)
                    {
                        case (true) {
                        SInfo* si = (SInfo*)p;
                        r = si.ty;
                    }
                        default { r = this.mod.t_named(m); };
                    };
                }
                    default {
                        switch (e.kind_id == SymbolKind.UNION)
                        {
                            case (true) {
                    p = nm_get(this.unions, m);
                    switch (p != (void*)0)
                    {
                        case (true) { r = (IRType*)p; }
                        default {};
                    };
                }
                            default {
                                switch (e.kind_id == SymbolKind.ENUM)
                                {
                                    case (true) {
                    p = nm_get(this.enums, m);
                    switch (p != (void*)0)
                    {
                        case (true) { r = (IRType*)p; }
                        default { r = this.t_i32; };
                    };
                }
                                    default {};
                                };
                            };
                        };
                    };
                };
                ffree(m);
                -> r;
            };


            resolve_custom(byte* name) -> IRType*
            {
                IDKC_SYMENTRY* e = st_lookup_any(this.st, name, this.cur_ns);
                byte* m;
                void* p;
                switch (e == (IDKC_SYMENTRY*)0)
                {
                    case (true) { -> (IRType*)0; }
                    default
                    {
                        switch (e.kind_id == SymbolKind.TYPE)
                        {
                            case (true) {
                            switch (e.ts != (void*)0)
                            {
                                case (true) { -> this.lower((TypeSpec*)e.ts, false, 0); }
                                default {};
                            };
                            m = sym_mangled(e);
                            p = nm_get(this.aliases, m);
                            ffree(m);
                            switch (p != (void*)0)
                            {
                                case (true) { -> (IRType*)p; }
                                default {};
                            };
                            -> (IRType*)0;
                        }
                            default
                            {
                                switch (e.kind_id == SymbolKind.TRAIT)
                                {
                                    case (true) {
                                    this.fail(g"trait cannot be used in type contexts\0", 0);
                                    -> (IRType*)0;
                                }
                                    default
                                    {
                                        -> this.type_of_symbol(e);
                                    };
                                };
                            };
                        };
                    };
                };
            };



            dim_value(Node* d, i64* out) -> bool
            {
                switch (d.kind == NodeKind.LITERAL)
                {
                    case (true) {
                    out[0] = d.ival;
                    -> true;
                }
                    default
                    {
                        switch (d.kind == NodeKind.IDENTIFIER)
                        {
                            case (true) {
                            switch (d.text != (byte*)0)
                            {
                                case (true) { -> this.resolve_dim(d.text, out); }
                                default {};
                            };
                        }
                            default {};
                        };
                        -> false;
                    };
                };
            };


            lower(TypeSpec* t, bool incl, int line) -> IRType*
            {
                IRType* base = (IRType*)0;
                IRType* el;
                IRType** ps;
                int i, depth, bt;
                i64 dv;
                bool wrap_i8;

                bt = t.base_type;
                switch (bt == DataType.FUNC_PTR)
                {
                    case (true) {
                    ps = (IRType**)fmalloc((u64)(t.fp_nparams + 1) * (u64)((sizeof(IRType*) + 7) / 8));
                    this.keep((void*)ps);
                    while (i < t.fp_nparams)
                    {
                        ps[i] = this.lower(t.fp_params[i], false, line);
                        i++;
                    };
                    -> this.ptr_of(this.mod.t_func(this.lower(t.fp_ret, false, line), ps, t.fp_nparams, false));
                }
                    default
                    {
                        switch (t.custom_typename != (byte*)0)
                        {
                            case (true) {
                            base = this.resolve_custom(t.custom_typename);
                            switch (base == (IRType*)0)
                            {
                                case (true) {
                                this.fail(join3(g"Unknown type: \0", t.custom_typename, g"\0"), line);
                                -> this.t_i32;
                            }
                                default
                                {
                                    switch (base.kind == LK.ARRAY & !ts_is_array(t))
                                    {
                                        case (true) { base = this.ptr_of(base.elem); }
                                        default {};
                                    };
                                };
                            };
                        }
                            default {
                                switch (bt == DataType.SINT | bt == DataType.UINT)
                                {
                                    case (true) { base = this.t_i32; }
                                    default {
                                        switch (bt == DataType.FLOAT)
                                        {
                                            case (true) { base = this.t_float; }
                                            default {
                                                switch (bt == DataType.DOUBLE)
                                                {
                                                    case (true) { base = this.t_double; }
                                                    default {
                                                        switch (bt == DataType.SLONG | bt == DataType.ULONG)
                                                        {
                                                            case (true) { base = this.t_i64; }
                                                            default {
                                                                switch (bt == DataType.BOOL)
                                                                {
                                                                    case (true) { base = this.t_i1; }
                                                                    default {
                                                                        switch (bt == DataType.CHAR)
                                                                        {
                                                                            case (true) { base = this.t_i8; }
                                                                            default {
                                                                                switch (bt == DataType.BYTE)
                                                                                {
                                                                                    case (true) {
                            switch (t.bit_width > 0)
                            {
                                case (true) { base = this.mod.t_int(t.bit_width); }
                                default { base = this.mod.t_int(this.byte_width); };
                            };
                        }
                                                                                    default {
                                                                                        switch (bt == DataType.STRUCT | bt == DataType.OBJECT)
                                                                                        {
                                                                                            case (true) { base = this.t_i8; }
                                                                                            default {
                                                                                                switch (bt == DataType.ENUM)
                                                                                                {
                                                                                                    case (true) { base = this.t_i32; }
                                                                                                    default {
                                                                                                        switch (bt == DataType.VOID)
                                                                                                        {
                                                                                                            case (true) { base = this.t_void; }
                                                                                                            default {
                                                                                                                switch (bt == DataType.DATA)
                                                                                                                {
                                                                                                                    case (true) {
                            switch (t.bit_width <= 0)
                            {
                                case (true) {
                                this.fail(g"DATA type missing bit_width\0", line);
                                -> this.t_i32;
                            }
                                default
                                {
                                    base = this.mod.t_int(t.bit_width);
                                };
                            };
                        }
                                                                                                                    default {
                                                                                                                        switch (bt == DataType.DICT)
                                                                                                                        {
                                                                                                                            case (true) {
                            IRType* kt = this.t_i8;
                            IRType* vt = this.t_i8;
                            int cap = 0;
                            switch (t.dict_capacity > 0)
                            {
                                case (true) { cap = t.dict_capacity; }
                                default {};
                            };
                            switch (t.dict_key != (TypeSpec*)0)
                            {
                                case (true) { kt = this.lower(t.dict_key, false, line); }
                                default {};
                            };
                            switch (t.dict_value != (TypeSpec*)0)
                            {
                                case (true) { vt = this.lower(t.dict_value, false, line); }
                                default {};
                            };
                            ps = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                            this.keep((void*)ps);
                            ps[0] = this.mod.t_array(kt, cap);
                            ps[1] = this.mod.t_array(vt, cap);
                            ps[2] = this.t_i32;
                            base = this.mod.t_struct(ps, 3);
                        }
                                                                                                                            default {
                                                                                                                                switch (bt == DataType.THIS)
                                                                                                                                {
                                                                                                                                    case (true) {
                            switch (this.cur_obj != (byte*)0)
                            {
                                case (true) {
                                base = this.ptr_of(this.mod.t_named(this.cur_obj));
                            }
                                default { base = this.t_i8p; };
                            };
                        }
                                                                                                                                    default {
                            this.fail(g"Unsupported type\0", line);
                            -> this.t_i32;
                        };
                                                                                                                                };
                                                                                                                            };
                                                                                                                        };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };

                        el = base;
                        switch (ts_is_pointer(t))
                        {
                            case (true) {
                            depth = t.pointer_depth;
                            switch (depth <= 0)
                            {
                                case (true) { depth = 1; }
                                default {};
                            };
                            wrap_i8 = (bt == DataType.VOID | bt == DataType.STRUCT | bt == DataType.OBJECT);
                            switch (wrap_i8)
                            {
                                case (true) { el = this.t_i8; }
                                default {};
                            };
                            i = 0;
                            while (i < depth)
                            {
                                el = this.ptr_of(el);
                                i++;
                            };
                        }
                            default {};
                        };

                        switch (!incl)
                        {
                            case (true) { -> el; }
                            default
                            {
                                switch (ts_is_array(t))
                                {
                                    case (true) {
                                    switch (t.array_dims != (NodeVec*)0)
                                    {
                                        case (true) {
                                        switch (t.array_dims.len > 0)
                                        {
                                            case (true) {
                                            IRType* cur = el;
                                            Node* d;
                                            i = t.array_dims.len - 1;
                                            while (i >= 0)
                                            {
                                                d = t.array_dims.items[i];
                                                switch (d != (Node*)0)
                                                {
                                                    case (true) {
                                                    switch (this.dim_value(d, @dv))
                                                    {
                                                        case (true) { cur = this.mod.t_array(cur, (int)dv); }
                                                        default { -> this.ptr_of(el); };
                                                    };
                                                }
                                                    default { cur = this.ptr_of(cur); };
                                                };
                                                i--;
                                            };
                                            -> cur;
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    switch (t.array_size != (Node*)0)
                                    {
                                        case (true) {
                                        switch (this.dim_value(t.array_size, @dv))
                                        {
                                            case (true) { -> this.mod.t_array(el, (int)dv); }
                                            default {};
                                        };
                                        -> this.ptr_of(el);
                                    }
                                        default {};
                                    };
                                    switch (el.kind == LK.PTR)
                                    {
                                        case (true) { -> el; }
                                        default {};
                                    };
                                    -> this.ptr_of(el);
                                }
                                    default
                                    {
                                        -> el;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            lower_sig(TypeSpec* t, int line) -> IRType*
            {
                IRType* b;
                switch (t.base_type == DataType.DICT)
                {
                    case (true) {
                    b = this.lower(t, true, line);
                    switch (ts_is_pointer(t))
                    {
                        case (true) { -> b; }
                        default {};
                    };
                    -> this.ptr_of(b);
                }
                    default
                    {
                        -> this.lower(t, true, line);
                    };
                };
            };





            new_sinfo(byte* name, int n, bool is_object) -> SInfo*
            {
                SInfo* si = (SInfo*)fmalloc((u64)((sizeof(SInfo) + 7) / 8));
                si.name = this.mod.own(name);
                si.ty = this.mod.t_named(name);
                si.n = n;
                si.names = (byte**)fmalloc((u64)(n + 1) * (u64)((sizeof(byte*) + 7) / 8));
                si.specs = (TypeSpec**)fmalloc((u64)(n + 1) * (u64)((sizeof(TypeSpec*) + 7) / 8));
                si.ftys = (IRType**)fmalloc((u64)(n + 1) * (u64)((sizeof(IRType*) + 7) / 8));
                si.offs = (int*)fmalloc((u64)(n + 1) * (u64)((sizeof(int) + 7) / 8));
                si.bits = (int*)fmalloc((u64)(n + 1) * (u64)((sizeof(int) + 7) / 8));
                si.aligns = (int*)fmalloc((u64)(n + 1) * (u64)((sizeof(int) + 7) / 8));
                si.total_bits = 0;
                si.max_align = 1;
                si.is_object = is_object;
                this.keep((void*)si.names);
                this.keep((void*)si.specs);
                this.keep((void*)si.ftys);
                this.keep((void*)si.offs);
                this.keep((void*)si.bits);
                this.keep((void*)si.aligns);
                this.keep((void*)si);
                nm_put(this.structs, si.name, (void*)si);
                -> si;
            };


            tld_global(SInfo* si) -> void
            {
                IRType* ft;
                IRType* at;
                IRType* vt;
                IRType** parts;
                int i;
                byte* nm;
                IRGlobal* g;
                parts = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)parts);
                parts[0] = this.t_i32;
                parts[1] = this.t_i32;
                parts[2] = this.t_i32;
                ft = this.mod.t_struct(parts, 3);
                at = this.mod.t_array(ft, si.n);
                parts = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)parts);
                parts[0] = this.t_i32;
                parts[1] = this.t_i32;
                parts[2] = at;
                vt = this.mod.t_struct(parts, 3);

                this.sc.clear();
                this.sc.put_str(g"{i32 \0");
                this.sc.put_str(f"{si.total_bits}, i32 {si.n}, \0");
                lt_text(@this.sc, at);
                this.sc.put_str(g" [\0");
                while (i < si.n)
                {
                    switch (i > 0)
                    {
                        case (true) { this.sc.put_str(g", \0"); }
                        default {};
                    };
                    lt_text(@this.sc, ft);
                    this.sc.put_str(g" {i32 \0");
                    this.sc.put_str(f"{si.offs[i]}, i32 {si.bits[i]}, i32 {si.aligns[i]}\0");
                    this.sc.put(125);
                    i++;
                };
                this.sc.put_str(g"]}\0");
                nm = join3(si.name, g".TLD\0", g"\0");
                g = this.mod.add_global(vt, nm, this.sc.mem);
                g.linkage = this.mod.own(g"internal\0");
                g.constant = true;
                -> ffree(nm);
            };


            struct_member_count(Node* sd) -> int
            {
                int total = node_count(sd, 0);
                int i, j;
                Node* b;
                void* p;
                SInfo* bi;
                while (i < node_count(sd, 1))
                {
                    b = node_child(sd, 1, i);
                    p = nm_get(this.structs, b.text);
                    switch (p != (void*)0)
                    {
                        case (true) {
                        bi = (SInfo*)p;
                        total = total + bi.n;
                    }
                        default {};
                    };
                    i++;
                };
                while (j < node_count(sd, 2))
                {
                    b = node_child(sd, 2, j);
                    p = nm_get(this.structs, b.text);
                    switch (p != (void*)0)
                    {
                        case (true) {
                        bi = (SInfo*)p;
                        total = total + bi.n;
                    }
                        default {};
                    };
                    j++;
                };
                -> total;
            };


            is_fwd_struct(IRType* t) -> bool
            {
                IRType* e = t;
                while (e.kind == LK.ARRAY) { e = e.elem; };
                -> e.kind == LK.ISTRUCT & !e.defined & e.nitems == 0;
            };


            reg_struct(Node* sd, byte* ns) -> void
            {
                byte* name = mangle_namespace_name(ns, sd.text);
                int i, j, idx, total, nm_, k;
                Node* mem;
                Node* b;
                void* p;
                SInfo* si;
                SInfo* bi;
                IRType* ft;

                switch (sd.l4 != (NodeVec*)0)
                {
                    case (true) {
                    switch (sd.l4.len > 0)
                    {
                        case (true) {
                        -> ffree(name);
                    }
                        default {};
                    };
                }
                    default {};
                };

                nm_ = node_count(sd, 0);
                p = nm_get(this.structs, name);
                switch (p != (void*)0)
                {
                    case (true) {
                    switch (nm_ == 0 & node_count(sd, 1) == 0 & node_count(sd, 2) == 0)
                    {
                        case (true) {
                        -> ffree(name);
                    }
                        default
                        {
                            si = (SInfo*)p;
                            switch (si.ty.defined & si.ty.nitems > 0)
                            {
                                case (true) {
                                -> ffree(name);
                            }
                                default {};
                            };
                        };
                    };
                }
                    default {};
                };

                total = this.struct_member_count(sd);
                switch (total == 0)
                {
                    case (true) {
                    switch (nm_get(this.structs, name) == (void*)0)
                    {
                        case (true) { this.new_sinfo(name, 0, false); }
                        default {};
                    };
                    -> ffree(name);
                }
                    default
                    {
                        si = this.new_sinfo(name, total, false);
                        si.ty.defined = false;


                        i = 0;
                        while (i < node_count(sd, 1))
                        {
                            b = node_child(sd, 1, i);
                            p = nm_get(this.structs, b.text);
                            switch (p == (void*)0)
                            {
                                case (true) {
                                this.fail(join3(g"Struct composition: base struct '\0", b.text, g"' has not been defined\0"), sd.line);
                            }
                                default {
                                bi = (SInfo*)p;
                                k = 0;
                                while (k < bi.n)
                                {
                                    si.names[idx] = bi.names[k];
                                    si.specs[idx] = bi.specs[k];
                                    idx++;
                                    k++;
                                };
                            };
                            };
                            i++;
                        };
                        i = 0;
                        while (i < nm_)
                        {
                            mem = node_child(sd, 0, i);
                            si.names[idx] = mem.text;
                            si.specs[idx] = mem.ts;
                            idx++;
                            i++;
                        };
                        j = 0;
                        while (j < node_count(sd, 2))
                        {
                            b = node_child(sd, 2, j);
                            p = nm_get(this.structs, b.text);
                            switch (p == (void*)0)
                            {
                                case (true) {
                                this.fail(join3(g"Struct post-composition: struct '\0", b.text, g"' has not been defined\0"), sd.line);
                            }
                                default {
                                bi = (SInfo*)p;
                                k = 0;
                                while (k < bi.n)
                                {
                                    si.names[idx] = bi.names[k];
                                    si.specs[idx] = bi.specs[k];
                                    idx++;
                                    k++;
                                };
                            };
                            };
                            j++;
                        };
                        si.n = idx;



                        int off = 0;
                        int bw, al;
                        i = 0;
                        while (i < si.n)
                        {
                            ft = this.lower(si.specs[i], true, sd.line);
                            si.ftys[i] = ft;


                            switch (this.is_fwd_struct(ft))
                            {
                                case (true) {
                                this.fwd_hit = true;
                                -> ffree(name);
                            }
                                default
                                {
                                    switch (si.specs[i].bit_width > 0 & !ts_is_array(si.specs[i]))
                                    {
                                        case (true) {
                                        bw = si.specs[i].bit_width;
                                        switch (si.specs[i].alignment > 0)
                                        {
                                            case (true) { al = si.specs[i].alignment; }
                                            default { al = bw; };
                                        };
                                    }
                                        default {
                                        bw = bits_of(ft);
                                        al = bw;
                                        switch (bw > 64)
                                        {
                                            case (true) { al = 64; }
                                            default {};
                                        };
                                    };
                                    };
                                    si.offs[i] = off;
                                    si.bits[i] = bw;
                                    si.aligns[i] = al;
                                    off = off + bw;
                                    switch (al > si.max_align)
                                    {
                                        case (true) { si.max_align = al; }
                                        default {};
                                    };
                                    i++;
                                };
                            };
                        };
                        si.total_bits = off;
                        this.mod.set_body(si.ty, si.ftys, si.n);
                        this.tld_global(si);

                        i = 0;
                        while (i < node_count(sd, 3))
                        {
                            this.reg_struct(node_child(sd, 3, i), ns);
                            i++;
                        };
                        -> ffree(name);
                    };
                };
            };


            reg_object_type(Node* od, byte* ns) -> void
            {
                byte* name = mangle_namespace_name(ns, od.text);
                int n = node_count(od, 0);
                int i, off, bw;
                void* p;
                SInfo* si;
                Node* mem;

                switch (this.is_template(od))
                {
                    case (true) {
                    -> ffree(name);
                }
                    default
                    {
                        p = nm_get(this.structs, name);
                        switch (p != (void*)0)
                        {
                            case (true) {
                            si = (SInfo*)p;
                            switch (si.n > 0 | (n == 0 & ((od.flags `& 512) != 0 | si.ty.defined)))
                            {
                                case (true) {
                                -> ffree(name);
                            }
                                default {};
                            };
                        }
                            default {};
                        };

                        switch (n == 0)
                        {
                            case (true) {
                            switch (p == (void*)0)
                            {
                                case (true) {
                                si = this.new_sinfo(name, 0, true);
                                si.ty.defined = false;
                            }
                                default {};
                            };


                            switch ((od.flags `& 512) == 0)
                            {
                                case (true) {
                                si.is_object = true;
                                si.total_bits = 0;
                                this.mod.set_body(si.ty, si.ftys, 0);
                            }
                                default {};
                            };
                            -> ffree(name);
                        }
                            default
                            {
                                switch (p == (void*)0)
                                {
                                    case (true) { si = this.new_sinfo(name, n, true); }
                                    default {
                                    si = (SInfo*)p;
                                    si.n = n;
                                    si.is_object = true;
                                    si.names = (byte**)fmalloc((u64)(n + 1) * (u64)((sizeof(byte*) + 7) / 8));
                                    si.specs = (TypeSpec**)fmalloc((u64)(n + 1) * (u64)((sizeof(TypeSpec*) + 7) / 8));
                                    si.ftys = (IRType**)fmalloc((u64)(n + 1) * (u64)((sizeof(IRType*) + 7) / 8));
                                    si.offs = (int*)fmalloc((u64)(n + 1) * (u64)((sizeof(int) + 7) / 8));
                                    si.bits = (int*)fmalloc((u64)(n + 1) * (u64)((sizeof(int) + 7) / 8));
                                    si.aligns = (int*)fmalloc((u64)(n + 1) * (u64)((sizeof(int) + 7) / 8));
                                    this.keep((void*)si.names);
                                    this.keep((void*)si.specs);
                                    this.keep((void*)si.ftys);
                                    this.keep((void*)si.offs);
                                    this.keep((void*)si.bits);
                                    this.keep((void*)si.aligns);
                                };
                                };
                                si.ty.defined = false;

                                i = 0;
                                while (i < n)
                                {
                                    mem = node_child(od, 0, i);
                                    si.names[i] = mem.text;
                                    si.specs[i] = mem.ts;
                                    si.ftys[i] = this.lower(mem.ts, true, od.line);
                                    bw = obj_field_bits(si.ftys[i], @this.al_tmp);
                                    si.offs[i] = off;
                                    si.bits[i] = bw;
                                    si.aligns[i] = this.al_tmp;
                                    switch (this.al_tmp > si.max_align)
                                    {
                                        case (true) { si.max_align = this.al_tmp; }
                                        default {};
                                    };
                                    off = off + bw;
                                    i++;
                                };
                                si.total_bits = off;
                                this.mod.set_body(si.ty, si.ftys, si.n);
                                -> ffree(name);
                            };
                        };
                    };
                };
            };

            is_template(Node* od) -> bool
            {
                switch (od.d == (Node*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (od.d.l0 == (NodeVec*)0)
                        {
                            case (true) { -> false; }
                            default
                            {
                                -> od.d.l0.len > 0;
                            };
                        };
                    };
                };
            };


            reg_object_nested(Node* od, byte* ns) -> void
            {
                int i;
                while (i < node_count(od, 4))
                {
                    this.reg_struct(node_child(od, 4, i), ns);
                    i++;
                };
                i = 0;
                while (i < node_count(od, 3))
                {
                    this.reg_object_type(node_child(od, 3, i), ns);
                    i++;
                };
                ->;
            };





            reg_enum(Node* ed, byte* ns) -> void
            {
                byte* name = mangle_namespace_name(ns, ed.text);
                IRType* ty = this.t_i32;
                int i, n;
                byte* cn;
                IRGlobal* g;
                IRValue* v;
                Node* item;
                switch (ed.ts != (TypeSpec*)0)
                {
                    case (true) { ty = this.lower(ed.ts, false, ed.line); }
                    default {};
                };
                nm_put(this.enums, name, (void*)ty);
                nm_put(this.enum_defs, name, (void*)ed);
                n = node_count(ed, 0);
                i64* eb;
                while (i < n)
                {
                    item = node_child(ed, 0, i);
                    cn = join3(name, g".\0", item.text);
                    switch (ty.kind == LK.STRUCT | ty.kind == LK.ISTRUCT | ty.kind == LK.ARRAY)
                    {
                        case (true) {
                        g = this.mod.add_global(ty, cn, g"zeroinitializer\0");
                    }
                        default {
                        v = this.mod.c_int(ty, item.ival);
                        g = this.mod.add_global(ty, cn, v.text);
                        g.constant = true;
                    };
                    };
                    eb = (i64*)fmalloc((u64)8);
                    eb[0] = item.ival;
                    this.keep((void*)eb);
                    nm_put(this.enumvals, this.mod.own(cn), (void*)eb);
                    ffree(cn);
                    i++;
                };
                -> ffree(name);
            };


            union_size(IRType* t) -> int
            {
                int total, i;
                IRType* e;
                switch (t.kind == LK.INT)
                {
                    case (true) { -> (t.width + 7) / 8; }
                    default
                    {
                        switch (t.kind == LK.FLOAT)
                        {
                            case (true) { -> 4; }
                            default
                            {
                                switch (t.kind == LK.DOUBLE)
                                {
                                    case (true) { -> 8; }
                                    default
                                    {
                                        switch (t.kind == LK.PTR)
                                        {
                                            case (true) { -> 8; }
                                            default
                                            {
                                                switch (t.kind == LK.ARRAY)
                                                {
                                                    case (true) {
                                                    e = t.elem;
                                                    switch (e.kind == LK.INT)
                                                    {
                                                        case (true) { -> ((e.width + 7) / 8) * t.count; }
                                                        default {};
                                                    };
                                                    switch (e.kind == LK.FLOAT)
                                                    {
                                                        case (true) { -> 4 * t.count; }
                                                        default {};
                                                    };
                                                    switch (e.kind == LK.DOUBLE)
                                                    {
                                                        case (true) { -> 8 * t.count; }
                                                        default {};
                                                    };
                                                    -> 8 * t.count;
                                                }
                                                    default
                                                    {
                                                        switch (t.kind == LK.STRUCT)
                                                        {
                                                            case (true) {
                                                            while (i < t.nitems)
                                                            {
                                                                e = t.items[i];
                                                                switch (e.kind)
                                                                {
                                                                    case (LK.INT) { total = total + (e.width + 7) / 8; }
                                                                    case (LK.FLOAT) { total = total + 4; }
                                                                    default { total = total + 8; };
                                                                };
                                                                i++;
                                                            };
                                                            -> total;
                                                        }
                                                            default
                                                            {
                                                                -> 8;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            reg_union(Node* ud, byte* ns) -> void
            {
                byte* name = mangle_namespace_name(ns, ud.text);
                int n = node_count(ud, 0);
                int i, sz, mx;
                IRType* mt;
                IRType* mxt = (IRType*)0;
                IRType** parts;
                Node* mem;
                nm_put(this.union_defs, name, (void*)ud);
                i = 0;
                while (i < n)
                {
                    mem = node_child(ud, 0, i);
                    mt = this.lower(mem.ts, false, ud.line);
                    sz = this.union_size(mt);
                    switch (sz > mx)
                    {
                        case (true) {
                        mx = sz;
                        mxt = mt;
                    }
                        default {};
                    };
                    i++;
                };
                parts = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)parts);
                switch (ud.text2 != (byte*)0)
                {
                    case (true) {
                    parts[0] = this.t_i32;
                    parts[1] = this.mod.t_array(this.t_i8, mx);
                    nm_put(this.unions, name, (void*)this.mod.t_struct(parts, 2));
                }
                    default {
                    switch (mxt == (IRType*)0)
                    {
                        case (true) { mxt = this.t_i8; }
                        default {};
                    };
                    parts[0] = mxt;
                    nm_put(this.unions, name, (void*)this.mod.t_struct(parts, 1));
                };
                };
                -> ffree(name);
            };

            reg_alias(Node* td, byte* ns) -> void
            {
                byte* name = mangle_namespace_name(ns, td.text);
                IRType* ty = this.lower(td.ts, true, td.line);
                nm_put(this.aliases, name, (void*)ty);
                pv_push(this.al_names, (void*)this.mod.own(td.text));
                pv_push(this.al_tys, (void*)ty);
                pv_push(this.al_specs, (void*)td.ts);
                pv_push(this.al_idx, (void*)(i64)this.cur_stmt);
                -> ffree(name);
            };





            cc_name(byte* cc) -> byte*
            {
                switch (cstr_eq(cc, g"cdecl\0"))
                {
                    case (true) { -> this.mod.own(g"ccc\0"); }
                    default
                    {
                        switch (cstr_eq(cc, g"stdcall\0"))
                        {
                            case (true) { -> this.mod.own(g"x86_stdcallcc\0"); }
                            default
                            {
                                switch (cstr_eq(cc, g"fastcall\0"))
                                {
                                    case (true) { -> this.mod.own(g"fastcc\0"); }
                                    default
                                    {
                                        switch (cstr_eq(cc, g"thiscall\0"))
                                        {
                                            case (true) { -> this.mod.own(g"x86_thiscallcc\0"); }
                                            default
                                            {
                                                switch (cstr_eq(cc, g"vectorcall\0"))
                                                {
                                                    case (true) { -> this.mod.own(g"x86_vectorcallcc\0"); }
                                                    default
                                                    {
                                                        -> this.mod.own(cc);
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            param_specs(Node* fd) -> TypeSpec**
            {
                int n = node_count(fd, 0);
                int i;
                TypeSpec** ps = (TypeSpec**)fmalloc((u64)(n + 1) * (u64)((sizeof(TypeSpec*) + 7) / 8));
                this.keep((void*)ps);
                while (i < n)
                {
                    ps[i] = node_child(fd, 0, i).ts;
                    i++;
                };
                -> ps;
            };

            mangled_name(byte* base, Node* fd) -> byte*
            {
                this.sc.clear();
                mangle_function(@this.sc, base, this.param_specs(fd), node_count(fd, 0), fd.ts);
                -> ts_dup(this.sc.mem);
            };


            rename_args(IRFunc* f, Node* fd, int skip) -> void
            {
                int i;
                Node* p;
                while (i < f.nargs - skip)
                {
                    p = node_child(fd, 0, i);
                    switch (p.text != (byte*)0)
                    {
                        case (true) { this.mod.rename_arg(f, i + skip, p.text); }
                        default {
                        this.sc.clear();
                        this.sc.put_str(f"arg{i}\0");
                        this.mod.rename_arg(f, i + skip, this.sc.mem);
                    };
                    };
                    i++;
                };
                ->;
            };


            name_args(IRFunc* f, Node* fd, int skip) -> void
            {
                int i;
                Node* p;
                while (i < f.nargs - skip)
                {
                    p = node_child(fd, 0, i);
                    switch (p.text != (byte*)0)
                    {
                        case (true) { this.mod.name_arg(f, i + skip, p.text); }
                        default {
                        this.sc.clear();
                        this.sc.put_str(f"arg{i}\0");
                        this.mod.name_arg(f, i + skip, this.sc.mem);
                    };
                    };
                    i++;
                };
                ->;
            };


            func_type_of(Node* fd, int skip, IRType* first) -> IRType*
            {
                int n = node_count(fd, 0);
                IRType* ret = this.lower_sig(fd.ts, fd.line);
                IRType** ps;
                IRType** rp;
                int i;
                switch (fd.ts2 != (TypeSpec*)0)
                {
                    case (true) {
                    rp = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                    this.keep((void*)rp);
                    rp[0] = ret;
                    rp[1] = this.lower_sig(fd.ts2, fd.line);
                    rp[2] = this.t_i1;
                    ret = this.mod.t_struct(rp, 3);
                }
                    default {};
                };
                ps = (IRType**)fmalloc((u64)(n + skip + 1) * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)ps);
                switch (skip > 0)
                {
                    case (true) { ps[0] = first; }
                    default {};
                };
                while (i < n)
                {
                    ps[i + skip] = this.lower_sig(node_child(fd, 0, i).ts, fd.line);
                    i++;
                };
                -> this.mod.t_func(ret, ps, n + skip, (fd.flags `& 2048) != 0);
            };


            declare_function(Node* fd, byte* ns) -> IRFunc*
            {
                switch (fd.text == (byte*)0)
                {
                    case (true) { -> (IRFunc*)0; }
                    default
                    {
                        switch ((fd.flags `& 524288) != 0)
                        {
                            case (true) { -> (IRFunc*)0; }
                            default
                            {
                                IRType* ft = this.func_type_of(fd, 0, (IRType*)0);
                                byte* base = mangle_namespace_name(ns, fd.text);
                                byte* mn;
                                IRFunc* f;
                                IRFunc* ex;
                                bool proto = (fd.flags `& 512) != 0;
                                switch ((fd.flags `& 1024) != 0)
                                {
                                    case (true) { mn = ts_dup(base); }
                                    default { mn = this.mangled_name(base, fd); };
                                };
                                ex = this.mod.find_function(mn);
                                switch (ex != (IRFunc*)0)
                                {
                                    case (true) {
                                    switch (proto)
                                    {
                                        case (true) { f = ex; }
                                        default {
                                            switch (ex.is_decl & ex.nargs == node_count(fd, 0))
                                            {
                                                case (true) { f = ex; }
                                                default {
                                        switch (nm_has(this.defined, mn))
                                        {
                                            case (true) {
                                            this.fail(join3(g"Function '\0", fd.text, g"' redefined\0"), fd.line);
                                            ffree(base);
                                            ffree(mn);
                                            -> ex;
                                        }
                                            default
                                            {
                                                byte* dn = join3(mn, g"__\0", g"args\0");
                                                f = this.mod.find_function(dn);
                                                switch (f == (IRFunc*)0)
                                                {
                                                    case (true) { f = this.mod.add_function(ft, dn); }
                                                    default {};
                                                };
                                                ffree(dn);
                                            };
                                        };
                                    };
                                            };
                                        };
                                    };
                                }
                                    default {
                                    f = this.mod.add_function(ft, mn);
                                    this.nfuncs++;
                                };
                                };
                                switch (fd.text2 != (byte*)0)
                                {
                                    case (true) { f.cconv = this.cc_name(fd.text2); }
                                    default {};
                                };
                                switch (!proto)
                                {
                                    case (true) {
                                    nm_put(this.defined, mn, (void*)f);
                                    nm_put(this.fdefs, f.name, (void*)fd);
                                    switch ((fd.flags `& 8192) != 0)
                                    {
                                        case (true) { pv_push(f.attrs, (void*)this.mod.own(g"alwaysinline\0")); }
                                        default {};
                                    };
                                    this.name_args(f, fd, 0);
                                }
                                    default {};
                                };
                                ffree(base);
                                ffree(mn);
                                -> f;
                            };
                        };
                    };
                };
            };


            declare_extern(Node* fd, byte* ns) -> void
            {
                IRType* ft;
                byte* base;
                byte* fin;
                IRFunc* f;
                IRType* vt;
                IRGlobal* g;
                switch (fd.kind == NodeKind.VARIABLE_DECLARATION)
                {
                    case (true) {
                    vt = this.lower(fd.ts, false, fd.line);
                    switch (this.mod.find_global(fd.text) == (IRGlobal*)0)
                    {
                        case (true) {
                        g = this.mod.add_global(vt, fd.text, (byte*)0);
                        g.linkage = this.mod.own(g"external\0");
                    }
                        default {};
                    };
                    ->;
                }
                    default
                    {
                        switch (fd.text == (byte*)0)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch ((fd.flags `& 512) == 0)
                                {
                                    case (true) {
                                    -> this.fail(join3(g"Extern functions must be prototypes: \0", fd.text, g"\0"), fd.line);
                                }
                                    default
                                    {
                                        ft = this.extern_type(fd);
                                        base = ts_dup(fd.text);
                                        int cut = 0;
                                        int k = 0;
                                        while (base[k] != 0)
                                        {
                                            switch (base[k] == ':' & base[k + 1] == ':')
                                            {
                                                case (true) { cut = k + 2; }
                                                default {};
                                            };
                                            k++;
                                        };
                                        byte* b1 = dup_from(base, cut);
                                        k = 0;
                                        cut = 0;
                                        while (b1[k] != 0)
                                        {
                                            switch (b1[k] == '_' & b1[k + 1] == '_')
                                            {
                                                case (true) { cut = k + 2; }
                                                default {};
                                            };
                                            k++;
                                        };
                                        byte* b2 = dup_from(b1, cut);
                                        switch ((fd.flags `& 1024) != 0)
                                        {
                                            case (true) { fin = ts_dup(b2); }
                                            default { fin = this.mangled_name(b2, fd); };
                                        };
                                        f = this.mod.find_function(fin);
                                        switch (f == (IRFunc*)0)
                                        {
                                            case (true) {
                                            f = this.mod.add_function(ft, fin);
                                            this.nfuncs++;
                                        }
                                            default {};
                                        };
                                        f.linkage = this.mod.own(g"external\0");
                                        this.name_args(f, fd, 0);
                                        ffree(base);
                                        ffree(b1);
                                        ffree(b2);
                                        -> ffree(fin);
                                    };
                                };
                            };
                        };
                    };
                };
            };


            extern_type(Node* fd) -> IRType*
            {
                int n = node_count(fd, 0);
                int i;
                IRType** ps = (IRType**)fmalloc((u64)(n + 1) * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)ps);
                while (i < n)
                {
                    ps[i] = this.lower(node_child(fd, 0, i).ts, false, fd.line);
                    i++;
                };
                -> this.mod.t_func(this.lower(fd.ts, false, fd.line), ps, n, false);
            };


            declare_method(Node* od, Node* m, byte* obj_name) -> void
            {
                IRType* st_ty = this.mod.t_named(obj_name);
                IRType* self_ty = this.ptr_of(st_ty);
                byte* prev = this.cur_obj;
                IRType* ft;
                IRFunc* f;
                byte* mn;
                byte* full;
                int passes, pass, dd;
                switch (m.text == (byte*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch ((m.flags `& 524288) != 0)
                        {
                            case (true) { ->; }
                            default
                            {
                                this.cur_obj = this.mod.own(obj_name);
                                switch (m.ts.base_type)
                                {
                                    case (DataType.THIS)
                                    {
                                        IRType** ps = (IRType**)fmalloc((u64)(node_count(m, 0) + 2) * (u64)((sizeof(IRType*) + 7) / 8));
                                        this.keep((void*)ps);
                                        int i;
                                        ps[0] = self_ty;
                                        while (i < node_count(m, 0))
                                        {
                                            ps[i + 1] = this.lower_sig(node_child(m, 0, i).ts, m.line);
                                            i++;
                                        };
                                        ft = this.mod.t_func(self_ty, ps, node_count(m, 0) + 1, false);
                                    }
                                    default
                                    {
                                        ft = this.func_type_of(m, 1, self_ty);
                                    };
                                };
                                mn = this.mangled_name(m.text, m);
                                full = join3(obj_name, g".\0", mn);
                                f = this.mod.find_function(full);
                                switch (f == (IRFunc*)0)
                                {
                                    case (true) {
                                    f = this.mod.add_function(ft, full);
                                    this.nfuncs++;
                                }
                                    default {};
                                };



                                passes = 1;
                                dd = 0;
                                while (obj_name[dd] != (byte)0)
                                {
                                    switch (obj_name[dd] == (byte)'_' & obj_name[dd + 1] == (byte)'_')
                                    {
                                        case (true) { passes = 2; }
                                        default {};
                                    };
                                    dd++;
                                };
                                while (pass < passes)
                                {
                                    this.mod.rename_arg(f, 0, g"this\0");
                                    this.rename_args(f, m, 1);
                                    pass++;
                                };
                                switch (m.text2 != (byte*)0)
                                {
                                    case (true) { f.cconv = this.cc_name(m.text2); }
                                    default {};
                                };
                                ffree(mn);
                                ffree(full);
                                this.cur_obj = prev;
                                ->;
                            };
                        };
                    };
                };
            };


            dot_index(byte* s) -> int
            {
                int i;
                switch (s == (byte*)0) { case (true) { -> -1; } default
                    {
                        while (s[i] != 0)
                        {
                            switch (s[i] == '.') { case (true) { -> i; } default
                                {
                                    i++;
                                }; };
                        };
                        -> -1;
                    }; };
            };


            dotted_object(Node* fd, byte* ns) -> byte*
            {
                int d = this.dot_index(fd.text);
                byte* raw = (byte*)fmalloc((u64)(d + 1));
                byte* r;
                int i;
                while (i < d) { raw[i] = fd.text[i]; i++; };
                raw[d] = 0;
                r = mangle_namespace_name(ns, raw);
                ffree(raw);
                -> r;
            };



            declare_dotted(Node* fd, byte* ns) -> void
            {
                byte* full = fd.text;
                byte* oname = this.dotted_object(fd, ns);
                fd.text = full + this.dot_index(full) + 1;
                this.declare_method((Node*)0, fd, oname);
                fd.text = full;
                -> ffree(oname);
            };

            declare_object_methods(Node* od, byte* ns) -> void
            {
                byte* name = mangle_namespace_name(ns, od.text);
                int i;
                Node* m;
                switch (this.is_template(od))
                {
                    case (true) {
                    -> ffree(name);
                }
                    default
                    {
                        while (i < node_count(od, 1))
                        {
                            m = node_child(od, 1, i);
                            this.declare_method(od, m, name);
                            i++;
                        };
                        -> ffree(name);
                    };
                };
            };





            unwrap(Node* n) -> Node*
            {
                int k = n.kind;
                switch (k == NodeKind.FUNCTION_DEF_STATEMENT | k == NodeKind.STRUCT_DEF_STATEMENT |
                    k == NodeKind.OBJECT_DEF_STATEMENT | k == NodeKind.ENUM_DEF_STATEMENT |
                    k == NodeKind.UNION_DEF_STATEMENT | k == NodeKind.NAMESPACE_DEF_STATEMENT)
                {
                    case (true) {
                    -> n.a;
                }
                    default
                    {
                        -> n;
                    };
                };
            };




            slot_at(int j, bool types) -> int
            {
                switch (types)
                {
                    case (true) {
                    switch (j == 0)
                    {
                        case (true) { -> 7; }
                        default {};
                    };
                    switch (j == 1)
                    {
                        case (true) { -> 3; }
                        default {};
                    };
                    switch (j == 2)
                    {
                        case (true) { -> 1; }
                        default {};
                    };
                    -> 2;
                }
                    default
                    {
                        switch (j == 0)
                        {
                            case (true) { -> 7; }
                            default
                            {
                                switch (j == 1)
                                {
                                    case (true) { -> 5; }
                                    default
                                    {
                                        switch (j == 2)
                                        {
                                            case (true) { -> 2; }
                                            default
                                            {
                                                -> 0;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            types_pass(Node* n0, byte* ns) -> void
            {
                Node* n = this.unwrap(n0);
                int k = n.kind;
                int s, c, e;
                byte* full;
                switch (this.retry_mode & k != NodeKind.STRUCT_DEF & k != NodeKind.OBJECT_DEF & k != NodeKind.NAMESPACE_DEF)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (k)
                        {
                            case (NodeKind.STRUCT_DEF) { this.reg_struct(n, ns); }
                            case (NodeKind.OBJECT_DEF)
                            {
                                this.reg_object_type(n, ns);
                                this.reg_object_nested(n, ns);
                            }
                            case (NodeKind.ENUM_DEF) { this.reg_enum(n, ns); }
                            case (NodeKind.UNION_DEF) { this.reg_union(n, ns); }
                            case (NodeKind.TYPE_DECLARATION) { this.reg_alias(n, ns); }
                            case (NodeKind.NAMESPACE_DEF)
                            {
                                full = this.join_ns(ns, n.text);
                                this.set_ns(full);
                                int j;
                                while (j < 4)
                                {
                                    s = this.slot_at(j, true);
                                    c = this.ns_count(n, s);
                                    e = 0;
                                    while (e < c)
                                    {
                                        this.types_pass(this.ns_child(n, s, e), full);
                                        e++;
                                    };
                                    j++;
                                };
                                this.set_ns(ns);
                                ffree(full);
                            }
                            default {};
                        };
                        ->;
                    };
                };
            };




            tf_convert(Node* d) -> bool
            {
                PtrVec* tmp;
                Node* p0;
                int i;
                int n;
                switch (d.ts2 == (TypeSpec*)0 | d.text == (byte*)0 | d.text2 == (byte*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (ts_is_array(d.ts2) & d.ts2.array_size == (Node*)0)
                        {
                            case (true) {

                            nm_put(this.tf_ast, join3(join3(g"__typefunc__\0", d.text, g"__\0"), d.text2, g"\0"), (void*)d);
                            -> false;
                        }
                            default
                            {
                                tmp = pv_new();
                                p0 = node_new(NodeKind.PARAMETER, d.line, d.col);
                                p0.text = g"_\0";
                                p0.ts = d.ts2;
                                d.ts2 = (TypeSpec*)0;
                                n = node_count(d, 0);
                                while (i < n)
                                {
                                    pv_push(tmp, (void*)node_child(d, 0, i));
                                    i++;
                                };
                                switch (n > 0)
                                {
                                    case (true) { d.l0.len = 0; }
                                    default {};
                                };
                                node_push(d, 0, p0);
                                i = 0;
                                while (i < n)
                                {
                                    node_push(d, 0, (Node*)tmp.items[i]);
                                    i++;
                                };
                                pv_free(tmp);
                                d.text = this.mod.own(join3(join3(g"__typefunc__\0", d.text, g"__\0"), d.text2, g"\0"));
                                d.text2 = (byte*)0;
                                d.kind = NodeKind.FUNCTION_DEF;
                                -> true;
                            };
                        };
                    };
                };
            };

            decls_pass(Node* n0, byte* ns) -> void
            {
                Node* n = this.unwrap(n0);
                int k = n.kind;
                int s, c, e;
                byte* full;
                switch (k == NodeKind.TYPE_FUNC_DEF)
                {
                    case (true) {
                    switch (this.tf_convert(n)) { case (true) { k = n.kind; } default {}; };
                }
                    default {};
                };
                switch (k == NodeKind.EXPRESSION_STATEMENT)
                {
                    case (true) { -> this.global_assign(n); }
                    default
                    {
                        switch (k == NodeKind.FUNCTION_DEF)
                        {
                            case (true) {
                            switch (this.dot_index(n.text) > 0)
                            {
                                case (true) { this.declare_dotted(n, ns); }
                                default { this.declare_function(n, ns); };
                            };
                        }
                            default {
                                switch (k == NodeKind.VARIABLE_DECLARATION | k == NodeKind.FUNCTION_POINTER_DECLARATION)
                                {
                                    case (true) { this.declare_global(n, ns); }
                                    default {
                                        switch (k == NodeKind.OBJECT_DEF)
                                        {
                                            case (true) { this.declare_object_methods(n, ns); }
                                            default {
                                                switch (k == NodeKind.EXTERN_BLOCK)
                                                {
                                                    case (true) {
                            c = node_count(n, 0);
                            while (e < c)
                            {
                                pv_push(this.ext_fns, (void*)node_child(n, 0, e));
                                pv_push(this.ext_fns, (void*)this.unwrap(node_child(n, 0, e)));
                                this.declare_extern(node_child(n, 0, e), ns);
                                e++;
                            };
                        }
                                                    default {
                                                        switch (k == NodeKind.EXPORT_BLOCK)
                                                        {
                                                            case (true) {
                            c = node_count(n, 0);
                            while (e < c)
                            {
                                this.declare_function(node_child(n, 0, e), ns);
                                e++;
                            };
                        }
                                                            default {
                                                                switch (k == NodeKind.NAMESPACE_DEF)
                                                                {
                                                                    case (true) {
                            full = this.join_ns(ns, n.text);
                            this.set_ns(full);
                            int j;
                            while (j < 4)
                            {
                                switch (j == 1)
                                {
                                    case (true) {
                                    c = this.ns_count(n, 6);
                                    e = 0;
                                    while (e < c)
                                    {
                                        switch (this.ns_child(n, 6, e).kind == NodeKind.VARIABLE_DECLARATION)
                                        {
                                            case (true) {
                                            this.declare_global(this.ns_child(n, 6, e), full);
                                        }
                                            default {};
                                        };
                                        e++;
                                    };
                                }
                                    default {};
                                };
                                s = this.slot_at(j, false);
                                c = this.ns_count(n, s);
                                e = 0;
                                while (e < c)
                                {
                                    this.decls_pass(this.ns_child(n, s, e), full);
                                    e++;
                                };
                                j++;
                            };
                            this.set_ns(ns);
                            ffree(full);
                        }
                                                                    default {};
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        ->;
                    };
                };
            };






            unsup(Node* n, byte* what) -> void
            {
                i64* box;
                switch (this.bad)
                {
                    case (true) { ->; }
                    default
                    {
                        this.bad = true;
                        this.bad_what = what;
                        switch (n != (Node*)0)
                        {
                            case (true) { this.bad_line = n.line; }
                            default {};
                        };
                        box = (i64*)nm_get(this.ucounts, what);
                        switch (box == (i64*)0)
                        {
                            case (true) {
                            box = (i64*)fmalloc((u64)8);
                            this.keep((void*)box);
                            *box = (i64)0;
                            nm_put(this.ucounts, what, (void*)box);
                        }
                            default {};
                        };
                        *box = *box + (i64)1;
                        ->;
                    };
                };
            };

            push_scope() -> void
            {
                -> pv_push(this.scopes, (void*)nm_new());
            };

            pop_scope() -> void
            {
                nm_free((NameMap*)this.scopes.items[this.scopes.len - 1]);
                this.scopes.len = this.scopes.len - 1;
                ->;
            };

            define_var(byte* name, IRValue* ptr, TypeSpec* ts) -> LVar*
            {
                LVar* v = (LVar*)fmalloc((u64)((sizeof(LVar) + 7) / 8));
                v.ptr = ptr;
                v.ts = ts;
                v.vol = false;
                v.is_heap = false;
                this.keep((void*)v);
                nm_put((NameMap*)this.scopes.items[this.scopes.len - 1], name, (void*)v);
                -> v;
            };

            find_local(byte* name) -> LVar*
            {
                int i = this.scopes.len - 1;
                void* p;
                while (i >= 0)
                {
                    p = nm_get((NameMap*)this.scopes.items[i], name);
                    switch (p != (void*)0)
                    {
                        case (true) { -> (LVar*)p; }
                        default
                        {
                            i--;
                        };
                    };
                };
                -> (LVar*)0;
            };

            find_var(byte* name) -> LVar*
            {
                LVar* lv = this.find_local(name);
                switch (lv != (LVar*)0)
                {
                    case (true) { -> lv; }
                    default
                    {
                        -> this.find_global_var(name);
                    };
                };
            };


            using_global_var(byte* name) -> LVar*
            {
                int i;
                byte* m;
                IDKC_SYMENTRY* e;
                IRGlobal* gl;
                LVar* v;
                void* p;
                while (i < this.st.using_ns.len)
                {
                    m = mangle_namespace_name((byte*)this.st.using_ns.items[i], name);
                    gl = this.mod.find_global(m);
                    switch (gl != (IRGlobal*)0)
                    {
                        case (true) {
                        p = nm_get(this.gvars, m);
                        switch (p != (void*)0)
                        {
                            case (true) {
                            ffree(m);
                            -> (LVar*)p;
                        }
                            default {};
                        };
                        e = st_lookup_any(this.st, name, (byte*)this.st.using_ns.items[i]);
                        v = (LVar*)fmalloc((u64)((sizeof(LVar) + 7) / 8));
                        v.ptr = gl.self;
                        v.ts = (TypeSpec*)0;
                        switch (e != (IDKC_SYMENTRY*)0) { case (true) { v.ts = (TypeSpec*)e.ts; } default {}; };
                        v.vol = false;
                        v.is_heap = false;
                        this.keep((void*)v);
                        nm_put(this.gvars, m, (void*)v);
                        ffree(m);
                        -> v;
                    }
                        default
                        {
                            ffree(m);
                            i++;
                        };
                    };
                };
                -> (LVar*)0;
            };


            find_global_var(byte* name) -> LVar*
            {
                IDKC_SYMENTRY* e = st_lookup_any(this.st, name, this.cur_ns);
                byte* m;
                IRGlobal* gl;
                LVar* v;
                void* p;
                switch (e == (IDKC_SYMENTRY*)0)
                {
                    case (true) { -> (LVar*)nm_get(this.gvars, name); }
                    default
                    {
                        switch (e.kind_id != SymbolKind.VARIABLE)
                        {
                            case (true) { -> (LVar*)nm_get(this.gvars, name); }
                            default
                            {
                                m = sym_mangled(e);
                                gl = this.mod.find_global(m);
                                switch (gl == (IRGlobal*)0)
                                {
                                    case (true) {


                                    ffree(m);
                                    -> this.using_global_var(name);
                                }
                                    default
                                    {
                                        p = nm_get(this.gvars, m);
                                        switch (p != (void*)0)
                                        {
                                            case (true) {
                                            ffree(m);
                                            -> (LVar*)p;
                                        }
                                            default
                                            {
                                                v = (LVar*)fmalloc((u64)((sizeof(LVar) + 7) / 8));
                                                v.ptr = gl.self;
                                                v.ts = (TypeSpec*)e.ts;
                                                v.vol = false;
                                                v.is_heap = false;
                                                this.keep((void*)v);
                                                nm_put(this.gvars, m, (void*)v);
                                                ffree(m);
                                                -> v;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            note_unsup(byte* what) -> void
            {
                i64* box = (i64*)nm_get(this.ucounts, what);
                switch (box == (i64*)0)
                {
                    case (true) {
                    box = (i64*)fmalloc((u64)8);
                    this.keep((void*)box);
                    *box = (i64)0;
                    nm_put(this.ucounts, what, (void*)box);
                }
                    default {};
                };
                *box = *box + (i64)1;
                ->;
            };


            last_seg(byte* name) -> byte*
            {
                int i;
                int cut;
                while (name[i] != 0)
                {
                    switch (name[i] == '_' & name[i + 1] == '_')
                    {
                        case (true) { cut = i + 2; }
                        default {};
                    };
                    i++;
                };
                -> name + cut;
            };


            global_dup(byte* name) -> bool
            {
                int i;
                byte* seg = this.last_seg(name);
                IRGlobal* g;
                IRFunc* fn;
                while (i < this.mod.globals.len)
                {
                    g = (IRGlobal*)this.mod.globals.items[i];
                    switch (cstr_eq(g.name, name))
                    {
                        case (true) { -> true; }
                        default
                        {
                            switch (cstr_eq(this.last_seg(g.name), seg))
                            {
                                case (true) { -> true; }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                    };
                };
                i = 0;
                while (i < this.mod.funcs.len)
                {
                    fn = (IRFunc*)this.mod.funcs.items[i];
                    switch (cstr_eq(fn.name, name))
                    {
                        case (true) { -> true; }
                        default
                        {
                            switch (cstr_eq(this.last_seg(fn.name), seg))
                            {
                                case (true) { -> true; }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                    };
                };
                -> false;
            };







            is_dict_struct(IRType* t) -> bool
            {
                switch (t.kind != LK.STRUCT)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (t.nitems != 3)
                        {
                            case (true) { -> false; }
                            default
                            {
                                -> t.items[0].kind == LK.ARRAY & t.items[1].kind == LK.ARRAY & t.items[2].kind == LK.INT & t.items[2].width == 32;
                            };
                        };
                    };
                };
            };

            dict_struct(IRType* kl, IRType* vl, int cap) -> IRType*
            {
                IRType** ps = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)ps);
                ps[0] = this.mod.t_array(kl, cap);
                ps[1] = this.mod.t_array(vl, cap);
                ps[2] = this.t_i32;
                -> this.mod.t_struct(ps, 3);
            };


            dict_make(byte* name, TypeSpec* ts, int line) -> DictInfo*
            {
                DictInfo* di = (DictInfo*)fmalloc((u64)((sizeof(DictInfo) + 7) / 8));
                this.keep((void*)di);
                di.kts = ts.dict_key;
                di.vts = ts.dict_value;
                di.kl = this.t_i8;
                di.vl = this.t_i8;
                switch (ts.dict_key != (TypeSpec*)0)
                {
                    case (true) { di.kl = this.lower(ts.dict_key, false, line); }
                    default {};
                };
                switch (ts.dict_value != (TypeSpec*)0)
                {
                    case (true) { di.vl = this.lower(ts.dict_value, false, line); }
                    default {};
                };
                di.cap = 0;
                switch (ts.dict_capacity > 0)
                {
                    case (true) { di.cap = ts.dict_capacity; }
                    default {};
                };
                di.st = this.dict_struct(di.kl, di.vl, di.cap);
                di.kc = (byte**)0;
                di.vc = (byte**)0;
                nm_put(this.dicts, name, (void*)di);
                -> di;
            };



            gsi_ref(byte* src, int len, Buf* ob, bool with_ty) -> void
            {
                int n = len + 1;
                byte* buf = (byte*)this.zbuf(n / 8 + 1);
                byte[16] hx;
                Buf gn;
                IRType* aty;
                IRValue* cv;
                IRGlobal* gl;
                memcpy((void*)buf, (void*)src, (u64)len);
                buf[len] = (byte)0;
                md5_hex8(buf, n, @hx[0]);
                gn.__init();
                defer gn.__exit();
                gn.put_str(g".str.gsi.\0");
                gn.put_str(@hx[0]);
                aty = this.mod.t_array(this.t_i8, n);
                gl = this.mod.find_global(gn.mem);
                switch (gl == (IRGlobal*)0)
                {
                    case (true) {
                    cv = this.mod.c_bytes(aty, buf, n);
                    gl = this.mod.add_global(aty, gn.mem, cv.text);
                    gl.linkage = this.mod.own(g"internal\0");
                    gl.constant = true;
                    this.mark_arr_ptr(gl.self.ty);
                }
                    default {};
                };
                switch (with_ty)
                {
                    case (true) { ob.put_str(g"i8* \0"); }
                    default {};
                };
                ob.put_str(g"getelementptr (\0");
                lt_text(ob, aty);
                ob.put_str(g", \0");
                lt_text(ob, aty);
                ob.put_str(f"* {gl.self.text}, i32 0, i32 0)\0");
            };

            str_len_of(Node* e) -> int
            {
                int len = (int)e.ival;
                byte* src = e.text;
                switch (src == (byte*)0)
                {
                    case (true) { -> 0; }
                    default
                    {
                        switch (len <= 0)
                        {
                            case (true) {
                            len = 0;
                            while (src[len] != 0) { len++; };
                        }
                            default {};
                        };
                        -> len;
                    };
                };
            };


            dict_elem_text(Node* e, IRType* et) -> byte*
            {
                Buf b;
                byte* src;
                int dt;
                i64 v;
                i64 lim;
                b.__init();
                defer b.__exit();
                switch (e.kind == NodeKind.STRING_LITERAL)
                {
                    case (true) {
                    switch (et.kind != LK.PTR)
                    {
                        case (true) { -> (byte*)0; }
                        default {};
                    };
                    switch (et.elem.kind != LK.INT)
                    {
                        case (true) { -> (byte*)0; }
                        default {};
                    };
                    switch (et.elem.width != 8)
                    {
                        case (true) { -> (byte*)0; }
                        default {};
                    };
                    src = e.text;
                    switch (src == (byte*)0) { case (true) { src = g"\0"; } default {}; };
                    this.gsi_ref(src, this.str_len_of(e), @b, true);
                    -> this.mod.own(b.mem);
                }
                    default
                    {
                        switch (e.kind == NodeKind.LITERAL & et.kind == LK.INT)
                        {
                            case (true) {
                            dt = e.op;
                            v = e.ival;
                            switch (dt == DataType.BOOL)
                            {
                                case (true) {
                                switch (v != (i64)0) { case (true) { v = (i64)1; } default {}; };
                            }
                                default {
                                switch (dt == DataType.UINT | dt == DataType.ULONG | dt == DataType.DATA)
                                {
                                    case (true) {

                                    switch (et.width < 64)
                                    {
                                        case (true) {
                                        lim = ((i64)1 << (et.width - 1)) - (i64)1;
                                        switch (v > lim) { case (true) { v = v - ((i64)1 << et.width); } default {}; };
                                    }
                                        default {};
                                    };
                                }
                                    default {
                                    switch (dt != DataType.SINT) { case (true) { -> (byte*)0; } default {}; };
                                };
                                };
                            };
                            };
                            lt_text(@b, et);
                            b.put(32);
                            put_i64(@b, v);
                            -> this.mod.own(b.mem);
                        }
                            default
                            {
                                -> (byte*)0;
                            };
                        };
                    };
                };
            };

            dict_zero_text(IRType* et) -> byte*
            {
                Buf b;
                b.__init();
                defer b.__exit();
                switch (et.kind == LK.PTR)
                {
                    case (true) {
                    lt_text(@b, et);
                    b.put_str(g" null\0");
                    -> this.mod.own(b.mem);
                }
                    default
                    {
                        switch (et.kind == LK.INT)
                        {
                            case (true) {
                            lt_text(@b, et);
                            b.put_str(g" 0\0");
                            -> this.mod.own(b.mem);
                        }
                            default
                            {
                                -> (byte*)0;
                            };
                        };
                    };
                };
            };


            dict_text(DictInfo* di, int count) -> byte*
            {
                Buf b;
                int i;
                b.__init();
                defer b.__exit();
                b.put(123);
                lt_text(@b, di.st.items[0]);
                b.put_str(g" [\0");
                while (i < di.cap)
                {
                    switch (i > 0) { case (true) { b.put_str(g", \0"); } default {}; };
                    b.put_str(di.kc[i]);
                    i++;
                };
                b.put_str(g"], \0");
                lt_text(@b, di.st.items[1]);
                b.put_str(g" [\0");
                i = 0;
                while (i < di.cap)
                {
                    switch (i > 0) { case (true) { b.put_str(g", \0"); } default {}; };
                    b.put_str(di.vc[i]);
                    i++;
                };
                b.put_str(f"], i32 {count}\0");
                b.put(125);
                -> this.mod.own(b.mem);
            };


            dict_lit_text(Node* ini, DictInfo* di) -> byte*
            {
                int np = node_count(ini, 0) / 2;
                int i;
                byte* t;
                switch (np > di.cap)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        di.kc = (byte**)this.zbuf(di.cap + 1);
                        di.vc = (byte**)this.zbuf(di.cap + 1);
                        while (i < di.cap)
                        {
                            switch (i < np)
                            {
                                case (true) {
                                t = this.dict_elem_text(node_child(ini, 0, i * 2), di.kl);
                                switch (t == (byte*)0) { case (true) { -> (byte*)0; } default
                                    {
                                        di.kc[i] = t;
                                        t = this.dict_elem_text(node_child(ini, 0, i * 2 + 1), di.vl);
                                        switch (t == (byte*)0) { case (true) { -> (byte*)0; } default
                                            {
                                                di.vc[i] = t;
                                            }; };
                                    }; };
                            }
                                default {
                                t = this.dict_zero_text(di.kl);
                                switch (t == (byte*)0) { case (true) { -> (byte*)0; } default
                                    {
                                        di.kc[i] = t;
                                        t = this.dict_zero_text(di.vl);
                                        switch (t == (byte*)0) { case (true) { -> (byte*)0; } default
                                            {
                                                di.vc[i] = t;
                                            }; };
                                    }; };
                            };
                            };
                            i++;
                        };
                        -> this.dict_text(di, np);
                    };
                };
            };


            dict_merge_text(Node* ini, DictInfo* di) -> byte*
            {
                DictInfo* li;
                DictInfo* ri;
                int nc;
                int i;
                switch (ini.op != Operator.ADD)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        switch (ini.a.kind != NodeKind.IDENTIFIER | ini.b.kind != NodeKind.IDENTIFIER)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                li = (DictInfo*)nm_get(this.dicts, ini.a.text);
                                ri = (DictInfo*)nm_get(this.dicts, ini.b.text);
                                switch (li == (DictInfo*)0 | ri == (DictInfo*)0)
                                {
                                    case (true) { -> (byte*)0; }
                                    default
                                    {
                                        switch (li.kc == (byte**)0 | ri.kc == (byte**)0)
                                        {
                                            case (true) { -> (byte*)0; }
                                            default
                                            {
                                                nc = li.cap + ri.cap;
                                                di.cap = nc;
                                                di.st = this.dict_struct(li.kl, li.vl, nc);
                                                di.kc = (byte**)this.zbuf(nc + 1);
                                                di.vc = (byte**)this.zbuf(nc + 1);
                                                while (i < li.cap)
                                                {
                                                    di.kc[i] = li.kc[i];
                                                    di.vc[i] = li.vc[i];
                                                    i++;
                                                };
                                                i = 0;
                                                while (i < ri.cap)
                                                {
                                                    di.kc[li.cap + i] = ri.kc[i];
                                                    di.vc[li.cap + i] = ri.vc[i];
                                                    i++;
                                                };
                                                -> this.dict_text(di, nc);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            declare_global_dict(Node* n, byte* ns) -> void
            {
                TypeSpec* ts = n.ts;
                Node* ini = n.a;
                DictInfo* di = this.dict_make(n.text, ts, n.line);
                IRGlobal* gl;
                byte* m;
                byte* it;
                switch (ini == (Node*)0)
                {
                    case (true) { it = this.mod.c_null(di.st).text; }
                    default {
                    switch (ini.kind == NodeKind.DICT_LITERAL)
                    {
                        case (true) { it = this.dict_lit_text(ini, di); }
                        default {
                        switch (ini.kind == NodeKind.BINARY_OP)
                        {
                            case (true) { it = this.dict_merge_text(ini, di); }
                            default { it = (byte*)0; };
                        };
                    };
                    };
                };
                };
                switch (it == (byte*)0)
                {
                    case (true) {
                    -> this.note_unsup(g"global dict initializer\0");
                }
                    default
                    {
                        m = mangle_namespace_name(ns, n.text);
                        switch (this.global_dup(m))
                        {
                            case (true) {
                            -> ffree(m);
                        }
                            default
                            {
                                gl = this.mod.add_global(di.st, m, it);
                                gl.linkage = this.mod.own(g"internal\0");
                                gl.self.spec = ts;
                                switch (nm_get(this.gvars, m) == (void*)0)
                                {
                                    case (true) {
                                    LVar* gv = (LVar*)fmalloc((u64)((sizeof(LVar) + 7) / 8));
                                    gv.ptr = gl.self;
                                    gv.ts = ts;
                                    gv.vol = false;
                                    gv.is_heap = false;
                                    this.keep((void*)gv);
                                    nm_put(this.gvars, m, (void*)gv);
                                }
                                    default {};
                                };
                                ffree(m);
                            };
                        };
                    };
                };
            };


            const_eval(Node* e, i64* ov, int* ow) -> bool
            {
                i64 lv;
                i64 rv;
                int lw;
                int rw;
                int k = e.kind;
                int op;
                IRGlobal* gg;
                SInfo* si;
                int fi;
                switch (k == NodeKind.LITERAL)
                {
                    case (true) {
                    switch (e.op == DataType.SINT)
                    {
                        case (true) { *ov = e.ival; *ow = 32; -> true; }
                        default {};
                    };
                    switch (e.op == DataType.BOOL)
                    {
                        case (true) {
                        *ov = (i64)0;
                        switch (e.ival != (i64)0) { case (true) { *ov = (i64)1; } default {}; };
                        *ow = 1;
                        -> true;
                    }
                        default {};
                    };
                    -> false;
                }
                    default
                    {
                        switch (k == NodeKind.MEMBER_ACCESS)
                        {
                            case (true) {
                            switch (e.a.kind != NodeKind.IDENTIFIER)
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            gg = this.global_ident_find(e.a.text);
                            switch (gg == (IRGlobal*)0)
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            switch (gg.init == (byte*)0)
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            si = this.sinfo_of(gg.ty);
                            switch (si == (SInfo*)0)
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            fi = this.sidx(si, e.text);
                            switch (fi < 0)
                            {
                                case (true) { -> false; }
                                default {};
                            };

                            switch (!cstr_eq(gg.init, this.mod.c_null(gg.ty).text))
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            switch (si.ftys[fi].kind != LK.INT)
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            *ov = (i64)0;
                            *ow = si.ftys[fi].width;
                            -> true;
                        }
                            default
                            {
                                switch (k == NodeKind.UNARY_OP)
                                {
                                    case (true) {
                                    switch (!this.const_eval(e.a, @lv, @lw))
                                    {
                                        case (true) { -> false; }
                                        default {};
                                    };
                                    switch (e.op == Operator.NOT)
                                    {
                                        case (true) { *ov = `!lv; *ow = lw; -> true; }
                                        default {};
                                    };
                                    switch (e.op == Operator.SUB)
                                    {
                                        case (true) { *ov = (i64)0 - lv; *ow = lw; -> true; }
                                        default {};
                                    };
                                    -> false;
                                }
                                    default
                                    {
                                        switch (k == NodeKind.BINARY_OP)
                                        {
                                            case (true) {
                                            op = e.op;
                                            switch (!this.const_eval(e.a, @lv, @lw))
                                            {
                                                case (true) { -> false; }
                                                default {};
                                            };
                                            switch (!this.const_eval(e.b, @rv, @rw))
                                            {
                                                case (true) { -> false; }
                                                default {};
                                            };
                                            *ow = lw;
                                            switch (op == Operator.ADD) { case (true) { *ov = lv + rv; -> true; } default {}; };
                                            switch (op == Operator.SUB) { case (true) { *ov = lv - rv; -> true; } default {}; };
                                            switch (op == Operator.MUL) { case (true) { *ov = lv * rv; -> true; } default {}; };
                                            switch (op == Operator.AND | op == Operator.BITAND) { case (true) { *ov = lv `& rv; -> true; } default {}; };
                                            switch (op == Operator.OR | op == Operator.BITOR) { case (true) { *ov = lv `| rv; -> true; } default {}; };
                                            switch (op == Operator.XOR | op == Operator.BITXOR) { case (true) { *ov = lv `^| rv; -> true; } default {}; };
                                            switch (op == Operator.BITSHIFT_LEFT) { case (true) { *ov = lv << (int)rv; -> true; } default {}; };
                                            switch (op == Operator.BITSHIFT_RIGHT) { case (true) { *ov = lv >> (int)rv; -> true; } default {}; };
                                            -> false;
                                        }
                                            default
                                            {
                                                -> false;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            dict_mask(int w) -> i64
            {
                switch (w >= 64)
                {
                    case (true) { -> (i64)0 - (i64)1; }
                    default
                    {
                        -> ((i64)1 << w) - (i64)1;
                    };
                };
            };


            global_dict_index(Node* ini, IRType* lt) -> byte*
            {
                Node* dn = ini.a;
                int cnt = node_count(dn, 0);
                int i;
                i64 lv;
                i64 kv;
                int lw;
                int kw;
                i64 mm;
                Node* ve;
                Buf b;
                b.__init();
                defer b.__exit();
                switch (!this.const_eval(ini.b, @lv, @lw))
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        while (i < cnt)
                        {
                            switch (!this.const_eval(node_child(dn, 0, i), @kv, @kw))
                            {
                                case (true) { -> (byte*)0; }
                                default
                                {
                                    mm = this.dict_mask(kw);
                                    switch (lw < kw) { case (true) { mm = this.dict_mask(lw); } default {}; };
                                    switch ((kv `& mm) == (lv `& mm))
                                    {
                                        case (true) {
                                        ve = node_child(dn, 1, i);
                                        switch (ve.kind == NodeKind.STRING_LITERAL)
                                        {
                                            case (true) {
                                            switch (lt.kind != LK.PTR) { case (true) { -> (byte*)0; } default {}; };
                                            switch (ve.text == (byte*)0) { case (true) { -> (byte*)0; } default {}; };
                                            this.gsi_ref(ve.text, this.str_len_of(ve), @b, false);
                                            -> this.mod.own(b.mem);
                                        }
                                            default {};
                                        };
                                        switch (lt.kind != LK.INT) { case (true) { -> (byte*)0; } default {}; };
                                        switch (!this.const_eval(ve, @kv, @kw)) { case (true) { -> (byte*)0; } default {}; };
                                        put_i64(@b, kv);
                                        -> this.mod.own(b.mem);
                                    }
                                        default
                                        {
                                            i++;
                                        };
                                    };
                                };
                            };
                        };
                        -> (byte*)0;
                    };
                };
            };

            global_init(Node* n, IRType* lt) -> byte*
            {
                Node* ini = n.a;
                int dt;
                i64 v;
                i64 mask;
                int w;
                byte* r;
                bool neg = false;
                switch (ini == (Node*)0)
                {
                    case (true) { -> this.mod.c_null(lt).text; }
                    default
                    {
                                       switch (ini.kind == NodeKind.NO_INIT)
                                       {
                                           case (true) { -> g"undef\0"; }
                                           default
                                           {
                                                              switch (ini.kind == NodeKind.ARRAY_ACCESS)
                                                              {
                                                                  case (true) {
                                                                  switch (ini.a.kind == NodeKind.DICT_LITERAL_EXPR)
                                                                  {
                                                                      case (true) { -> this.global_dict_index(ini, lt); }
                                                                      default {};
                                                                  };
                                                              }
                                                                  default {};
                                                              };
                                                              switch (ini.kind == NodeKind.IDENTIFIER)
                                                              {
                                                                  case (true) {
                                                                  r = this.global_ident_init(ini.text);
                                                                  switch (r == (byte*)0)
                                                                  {
                                                                      case (true) { -> this.mod.c_null(lt).text; }
                                                                      default {};
                                                                  };
                                                                  -> r;
                                                              }
                                                                  default
                                                                  {
                                                                                     switch (ini.kind == NodeKind.STRING_LITERAL)
                                                                                     {
                                                                                         case (true) { -> this.global_string_init(ini, lt); }
                                                                                         default
                                                                                         {
                                                                                                            switch (ini.kind == NodeKind.ARRAY_LITERAL & lt.kind == LK.INT)
                                                                                                            {
                                                                                                                case (true) { -> this.global_pack_int(ini, lt); }
                                                                                                                default
                                                                                                                {
                                                                                                                                   switch (ini.kind == NodeKind.ARRAY_LITERAL)
                                                                                                                                   {
                                                                                                                                       case (true) { -> this.global_array_init(ini, lt); }
                                                                                                                                       default
                                                                                                                                       {
                                                                                                                                                          switch (ini.kind == NodeKind.CAST_EXPRESSION | ini.kind == NodeKind.FUNCTION_CALL | ini.kind == NodeKind.METHOD_CALL)
                                                                                                                                                          {
                                                                                                                                                              case (true) {

                                                                                                                                                              -> this.mod.c_null(lt).text;
                                                                                                                                                          }
                                                                                                                                                              default {};
                                                                                                                                                          };


                                                                                                                                                          switch (ini.kind != NodeKind.LITERAL & ini.kind != NodeKind.IDENTIFIER & ini.kind != NodeKind.BINARY_OP &
                                                                                                                                                              ini.kind != NodeKind.UNARY_OP & ini.kind != NodeKind.STRING_LITERAL & ini.kind != NodeKind.ARRAY_LITERAL &
                                                                                                                                                              ini.kind != NodeKind.ARRAY_ACCESS & ini.kind != NodeKind.STRUCT_LITERAL & ini.kind != NodeKind.DICT_LITERAL &
                                                                                                                                                              ini.kind != NodeKind.DICT_LITERAL_EXPR)
                                                                                                                                                          {
                                                                                                                                                              case (true) { -> this.mod.c_null(lt).text; }
                                                                                                                                                              default
                                                                                                                                                              {
                                                                                                                                                                                 switch (ini.kind == NodeKind.CAST_EXPRESSION & lt.kind == LK.PTR)
                                                                                                                                                                                 {
                                                                                                                                                                                     case (true) {
                                                                                                                                                                                     switch (ini.a != (Node*)0)
                                                                                                                                                                                     {
                                                                                                                                                                                         case (true) {
                                                                                                                                                                                         switch (ini.a.kind == NodeKind.ADDRESS_OF & ini.a.a != (Node*)0)
                                                                                                                                                                                         {
                                                                                                                                                                                             case (true) {
                                                                                                                                                                                             switch (ini.a.a.kind == NodeKind.LITERAL & ini.a.a.op == DataType.VOID)
                                                                                                                                                                                             {
                                                                                                                                                                                                 case (true) { -> g"null\0"; }
                                                                                                                                                                                                 default {};
                                                                                                                                                                                             };
                                                                                                                                                                                         }
                                                                                                                                                                                             default {};
                                                                                                                                                                                         };
                                                                                                                                                                                         switch (ini.a.kind == NodeKind.IDENTIFIER & ini.a.text != (byte*)0)
                                                                                                                                                                                         {
                                                                                                                                                                                             case (true) {
                                                                                                                                                                                             IDKC_SYMENTRY* se = st_lookup_any(this.st, ini.a.text, this.cur_ns);
                                                                                                                                                                                             switch (se != (IDKC_SYMENTRY*)0)
                                                                                                                                                                                             {
                                                                                                                                                                                                 case (true) {
                                                                                                                                                                                                 byte* sm = sym_mangled(se);
                                                                                                                                                                                                 IRGlobal* sg = this.mod.find_global(sm);
                                                                                                                                                                                                 ffree(sm);
                                                                                                                                                                                                 switch (sg != (IRGlobal*)0)
                                                                                                                                                                                                 {
                                                                                                                                                                                                     case (true) {
                                                                                                                                                                                                     switch (sg.init != (byte*)0)
                                                                                                                                                                                                     {
                                                                                                                                                                                                         case (true) {
                                                                                                                                                                                                         switch (cstr_eq(sg.init, g"null\0"))
                                                                                                                                                                                                         {
                                                                                                                                                                                                             case (true) { -> g"null\0"; }
                                                                                                                                                                                                             default {};
                                                                                                                                                                                                         };
                                                                                                                                                                                                     }
                                                                                                                                                                                                         default {};
                                                                                                                                                                                                     };
                                                                                                                                                                                                 }
                                                                                                                                                                                                     default {};
                                                                                                                                                                                                 };
                                                                                                                                                                                             }
                                                                                                                                                                                                 default {};
                                                                                                                                                                                             };
                                                                                                                                                                                         }
                                                                                                                                                                                             default {};
                                                                                                                                                                                         };
                                                                                                                                                                                         switch (ini.a.kind == NodeKind.LITERAL & ini.a.ival == (i64)0 & (ini.a.op == DataType.SINT | ini.a.op == DataType.UINT | ini.a.op == DataType.ULONG | ini.a.op == DataType.SLONG))
                                                                                                                                                                                         {
                                                                                                                                                                                             case (true) {
                                                                                                                                                                                             -> g"null\0";
                                                                                                                                                                                         }
                                                                                                                                                                                             default {};
                                                                                                                                                                                         };
                                                                                                                                                                                     }
                                                                                                                                                                                         default {};
                                                                                                                                                                                     };
                                                                                                                                                                                 }
                                                                                                                                                                                     default {};
                                                                                                                                                                                 };
                                                                                                                                                                                 switch (ini.kind == NodeKind.UNARY_OP)
                                                                                                                                                                                 {
                                                                                                                                                                                     case (true) {
                                                                                                                                                                                     switch (ini.op == Operator.SUB & ini.a != (Node*)0)
                                                                                                                                                                                     {
                                                                                                                                                                                         case (true) {
                                                                                                                                                                                         switch (ini.a.kind == NodeKind.LITERAL)
                                                                                                                                                                                         {
                                                                                                                                                                                             case (true) {
                                                                                                                                                                                             neg = true;
                                                                                                                                                                                             ini = ini.a;
                                                                                                                                                                                         }
                                                                                                                                                                                             default {};
                                                                                                                                                                                         };
                                                                                                                                                                                     }
                                                                                                                                                                                         default {};
                                                                                                                                                                                     };
                                                                                                                                                                                 }
                                                                                                                                                                                     default {};
                                                                                                                                                                                 };
                                                                                                                                                                                 switch (ini.kind != NodeKind.LITERAL)
                                                                                                                                                                                 {
                                                                                                                                                                                     case (true) { -> (byte*)0; }
                                                                                                                                                                                     default
                                                                                                                                                                                     {
                                                                                                                                                                                                        dt = ini.op;
                                                                                                                                                                                                        v = ini.ival;
                                                                                                                                                                                                        switch (neg)
                                                                                                                                                                                                        {
                                                                                                                                                                                                            case (true) {
                                                                                                                                                                                                            switch (dt != DataType.SINT & dt != DataType.FLOAT & dt != DataType.DOUBLE)
                                                                                                                                                                                                            {
                                                                                                                                                                                                                case (true) { -> (byte*)0; }
                                                                                                                                                                                                                default
                                                                                                                                                                                                                {
                                                                                                                                                                                                                    v = (i64)0 - v;
                                                                                                                                                                                                                };
                                                                                                                                                                                                            };
                                                                                                                                                                                                        }
                                                                                                                                                                                                            default {};
                                                                                                                                                                                                        };
                                                                                                                                                                                                        switch (dt == DataType.FLOAT | dt == DataType.DOUBLE)
                                                                                                                                                                                                        {
                                                                                                                                                                                                            case (true) {
                                                                                                                                                                                                            switch (lt.kind == LK.FLOAT | lt.kind == LK.DOUBLE)
                                                                                                                                                                                                            {
                                                                                                                                                                                                                case (true) { switch (neg)
                                                                                                                                                                                         {
                                                                                                                                                                                             case (true) { -> this.mod.c_fp(lt, (double)0.0 - ini.fval).text; }
                                                                                                                                                                                             default {};
                                                                                                                                                                                         }; -> this.mod.c_fp(lt, ini.fval).text; }
                                                                                                                                                                                                                default {};
                                                                                                                                                                                                            };
                                                                                                                                                                                                            -> (byte*)0;
                                                                                                                                                                                                        }
                                                                                                                                                                                                            default
                                                                                                                                                                                                            {
                                                                                                                                                                                                                switch (lt.kind == LK.PTR)
                                                                                                                                                                                                                {
                                                                                                                                                                                                                    case (true) {
                                                                                                                                                                                                                    switch (dt == DataType.SINT & v == (i64)0)
                                                                                                                                                                                                                    {
                                                                                                                                                                                                                        case (true) { -> g"null\0"; }
                                                                                                                                                                                                                        default {};
                                                                                                                                                                                                                    };
                                                                                                                                                                                                                    -> (byte*)0;
                                                                                                                                                                                                                }
                                                                                                                                                                                                                    default
                                                                                                                                                                                                                    {
                                                                                                                                                                                                                        switch (lt.kind != LK.INT)
                                                                                                                                                                                                                        {
                                                                                                                                                                                                                            case (true) {
                                                                                                                                                                                                                            switch (dt == DataType.SINT | dt == DataType.BOOL | dt == DataType.UINT | dt == DataType.ULONG)
                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                case (true) { -> (byte*)0; }
                                                                                                                                                                                                                                default {};
                                                                                                                                                                                                                            };
                                                                                                                                                                                                                            -> this.mod.c_null(lt).text;
                                                                                                                                                                                                                        }
                                                                                                                                                                                                                            default
                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                w = lt.width;
                                                                                                                                                                                                                                switch (dt == DataType.SINT | dt == DataType.BOOL)
                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                    case (true) { -> this.mod.c_int(this.t_i64, v).text; }
                                                                                                                                                                                                                                    default
                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                        switch (dt == DataType.UINT | dt == DataType.ULONG | dt == DataType.DATA)
                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                            case (true) {
                                                                                                                                                                                                                                            switch (w < 64)
                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                case (true) {
                                                                                                                                                                                                                                                mask = ((i64)1 << (i64)w) - (i64)1;
                                                                                                                                                                                                                                                v = v `& mask;
                                                                                                                                                                                                                                                switch (v > (((i64)1 << (i64)(w - 1)) - (i64)1))
                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                    case (true) { v = v - ((i64)1 << (i64)w); }
                                                                                                                                                                                                                                                    default {};
                                                                                                                                                                                                                                                };
                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                default {};
                                                                                                                                                                                                                                            };
                                                                                                                                                                                                                                            -> this.mod.c_int(this.t_i64, v).text;
                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                            default
                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                -> this.mod.c_null(lt).text;
                                                                                                                                                                                                                                            };
                                                                                                                                                                                                                                        };
                                                                                                                                                                                                                                    };
                                                                                                                                                                                                                                };
                                                                                                                                                                                                                            };
                                                                                                                                                                                                                        };
                                                                                                                                                                                                                    };
                                                                                                                                                                                                                };
                                                                                                                                                                                                            };
                                                                                                                                                                                                        };
                                                                                                                                                                                     };
                                                                                                                                                                                 };
                                                                                                                                                              };
                                                                                                                                                          };
                                                                                                                                       };
                                                                                                                                   };
                                                                                                                };
                                                                                                            };
                                                                                         };
                                                                                     };
                                                                  };
                                                              };
                                           };
                                       };
                    };
                };
            };


            global_ident_find(byte* name) -> IRGlobal*
            {
                IDKC_SYMENTRY* se = st_lookup_any(this.st, name, this.cur_ns);
                IRGlobal* sg;
                byte* sm;
                switch (se != (IDKC_SYMENTRY*)0)
                {
                    case (true) {
                    sm = sym_mangled(se);
                    sg = this.mod.find_global(sm);
                    ffree(sm);
                    switch (sg != (IRGlobal*)0)
                    {
                        case (true) { -> sg; }
                        default {};
                    };
                }
                    default {};
                };
                -> this.mod.find_global(name);
            };

            global_ident_init(byte* name) -> byte*
            {
                IRGlobal* sg = this.global_ident_find(name);
                switch (sg != (IRGlobal*)0)
                {
                    case (true) { -> sg.init; }
                    default
                    {
                        -> (byte*)0;
                    };
                };
            };


            global_pack_int(Node* ini, IRType* lt) -> byte*
            {
                int n = node_count(ini, 0);
                int i = n - 1;
                int off;
                int w;
                int dt;
                i64 v;
                i64 packed;
                Node* e;
                IRGlobal* g;
                Buf ab;
                byte* r;
                while (i >= 0)
                {
                    e = node_child(ini, 0, i);
                    switch (e.kind == NodeKind.LITERAL)
                    {
                        case (true) {
                        dt = e.op;
                        v = e.ival;
                        w = 0;
                        switch (dt == DataType.SINT | dt == DataType.UINT) { case (true) { w = 32; } default {}; };
                        switch (dt == DataType.SLONG | dt == DataType.ULONG) { case (true) { w = 64; } default {}; };
                        switch (dt == DataType.BOOL)
                        {
                            case (true) {
                            w = 1;
                            switch (v != (i64)0) { case (true) { v = (i64)1; } default {}; };
                        }
                            default {};
                        };
                        switch (dt == DataType.CHAR) { case (true) { w = 8; } default {}; };
                        switch (w == 0) { case (true) { -> (byte*)0; } default {}; };
                    }
                        default {
                            switch (e.kind != NodeKind.IDENTIFIER)
                            {
                                case (true) { -> (byte*)0; }
                                default
                                {
                                    g = this.global_ident_find(e.text);
                                    switch (g == (IRGlobal*)0)
                                    {
                                        case (true) { -> (byte*)0; }
                                        default
                                        {
                                            switch (g.init == (byte*)0 | g.ty.kind != LK.INT)
                                            {
                                                case (true) { -> (byte*)0; }
                                                default
                                                {
                                                    switch (!this.parse_int_text(g.init, @v))
                                                    {
                                                        case (true) { -> (byte*)0; }
                                                        default
                                                        {
                                                            w = g.ty.width;
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                    switch (v < (i64)0 | off + w > 63)
                    {
                        case (true) { -> (byte*)0; }
                        default
                        {
                            packed = packed `| (v << (i64)off);
                            off = off + w;
                            i--;
                        };
                    };
                };
                switch (off != lt.width)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        ab.__init();
                        defer ab.__exit();
                        put_i64(@ab, packed);
                        r = this.mod.own(ab.mem);
                        -> r;
                    };
                };
            };


            parse_int_text(byte* t, i64* out) -> bool
            {
                int i = 0;
                bool neg = false;
                i64 v = (i64)0;
                switch (t == (byte*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (t[0] == '-')
                        {
                            case (true) {
                            neg = true;
                            i = 1;
                        }
                            default {};
                        };
                        switch (t[i] < '0' | t[i] > '9')
                        {
                            case (true) { -> false; }
                            default
                            {
                                while (t[i] >= '0' & t[i] <= '9')
                                {
                                    v = v * (i64)10 + (i64)(t[i] - '0');
                                    i++;
                                };
                                switch (t[i] != 0)
                                {
                                    case (true) { -> false; }
                                    default
                                    {
                                        switch (neg)
                                        {
                                            case (true) { v = (i64)0 - v; }
                                            default {};
                                        };
                                        *out = v;
                                        -> true;
                                    };
                                };
                            };
                        };
                    };
                };
            };




            global_elem_value(Node* e, IRType* et, i64* out) -> bool
            {
                i64 v;
                int sw;
                int dt;
                i64 mask;
                switch (et.kind != LK.INT)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (e.kind == NodeKind.IDENTIFIER)
                        {
                            case (true) {
                            -> this.parse_int_text(this.global_ident_init(e.text), out);
                        }
                            default
                            {
                                switch (e.kind != NodeKind.LITERAL)
                                {
                                    case (true) { -> false; }
                                    default
                                    {
                                        dt = e.op;
                                        v = e.ival;
                                        switch (dt == DataType.SINT)
                                        {
                                            case (true) { sw = 32; }
                                            default {
                                                switch (dt == DataType.UINT)
                                                {
                                                    case (true) {
                                            sw = 32;
                                            switch (v > (i64)2147483647)
                                            {
                                                case (true) { v = v - ((i64)1 << (i64)32); }
                                                default {};
                                            };
                                        }
                                                    default {
                                                        switch (dt == DataType.SLONG | dt == DataType.ULONG)
                                                        {
                                                            case (true) { sw = 64; }
                                                            default {
                                                                switch (dt == DataType.BOOL)
                                                                {
                                                                    case (true) {
                                            sw = 1;
                                            switch (v != (i64)0)
                                            {
                                                case (true) { v = (i64)1; }
                                                default {};
                                            };
                                        }
                                                                    default {
                                                                        switch (dt == DataType.CHAR)
                                                                        {
                                                                            case (true) { sw = 8; }
                                                                            default { -> false; };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                        switch (sw > et.width)
                                        {
                                            case (true) {
                                            switch (et.width < 64)
                                            {
                                                case (true) {
                                                mask = ((i64)1 << (i64)et.width) - (i64)1;
                                                v = v `& mask;
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        *out = v;
                                        -> true;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            global_array_text(IRType* lt, i64* v, int n) -> byte*
            {
                Buf ab;
                int i;
                byte* r;
                ab.__init();
                defer ab.__exit();
                ab.put(91);
                while (i < lt.count)
                {
                    switch (i > 0)
                    {
                        case (true) { ab.put_str(g", \0"); }
                        default {};
                    };
                    lt_text(@ab, lt.elem);
                    ab.put(32);
                    switch (i < n)
                    {
                        case (true) { put_i64(@ab, v[i]); }
                        default { ab.put(48); };
                    };
                    i++;
                };
                ab.put(93);
                r = this.mod.own(ab.mem);
                -> r;
            };


            global_ptr_array_init(Node* ini, IRType* lt) -> byte*
            {
                int n = node_count(ini, 0);
                int i;
                Buf ab;
                byte* r;
                switch (lt.elem.elem.kind != LK.INT | n > lt.count)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        switch (lt.elem.elem.width != 8)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                while (i < n)
                                {
                                    switch (node_child(ini, 0, i).kind != NodeKind.STRING_LITERAL)
                                    {
                                        case (true) { -> (byte*)0; }
                                        default
                                        {
                                            i++;
                                        };
                                    };
                                };
                                ab.__init();
                                defer ab.__exit();
                                ab.put(91);
                                i = 0;
                                while (i < lt.count)
                                {
                                    switch (i > 0)
                                    {
                                        case (true) { ab.put_str(g", \0"); }
                                        default {};
                                    };
                                    switch (i < n)
                                    {
                                        case (true) { this.str_global_text(node_child(ini, 0, i), @ab); }
                                        default { ab.put_str(g"i8* null\0"); };
                                    };
                                    i++;
                                };
                                ab.put(93);
                                r = this.mod.own(ab.mem);
                                -> r;
                            };
                        };
                    };
                };
            };



            global_fp_array_init(Node* ini, IRType* lt) -> byte*
            {
                int n = node_count(ini, 0);
                int i;
                int want;
                Node* e;
                Buf ab;
                byte* r;
                switch (n > lt.count)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        switch (lt.elem.kind == LK.FLOAT)
                        {
                            case (true) { want = DataType.FLOAT; }
                            default { want = DataType.DOUBLE; };
                        };
                        while (i < n)
                        {
                            e = node_child(ini, 0, i);
                            switch (e.kind != NodeKind.LITERAL)
                            {
                                case (true) { -> (byte*)0; }
                                default
                                {
                                    switch (e.op != want)
                                    {
                                        case (true) { -> (byte*)0; }
                                        default
                                        {
                                            i++;
                                        };
                                    };
                                };
                            };
                        };
                        ab.__init();
                        defer ab.__exit();
                        ab.put(91);
                        i = 0;
                        while (i < lt.count)
                        {
                            switch (i > 0)
                            {
                                case (true) { ab.put_str(g", \0"); }
                                default {};
                            };
                            lt_text(@ab, lt.elem);
                            ab.put(32);
                            switch (i < n)
                            {
                                case (true) { ab.put_str(this.mod.c_fp(lt.elem, node_child(ini, 0, i).fval).text); }
                                default { ab.put_str(this.mod.c_fp(lt.elem, 0.0).text); };
                            };
                            i++;
                        };
                        ab.put(93);
                        r = this.mod.own(ab.mem);
                        -> r;
                    };
                };
            };


            global_struct_array_init(Node* ini, IRType* lt) -> byte*
            {
                int n = node_count(ini, 0);
                int i;
                int k;
                int f;
                int nf;
                int np;
                int nn;
                Node* e;
                byte* it;
                byte* fv;
                SInfo* si = this.sinfo_of(lt.elem);
                Buf ab;
                byte* r;
                Node** ex;
                switch (n > lt.count | si == (SInfo*)0)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        ab.__init();
                        defer ab.__exit();
                        ab.put(91);
                        while (i < lt.count)
                        {
                            switch (i > 0)
                            {
                                case (true) { ab.put_str(g", \0"); }
                                default {};
                            };
                            lt_text(@ab, lt.elem);
                            ab.put(32);
                            switch (i >= n)
                            {
                                case (true) { ab.put_str(this.mod.c_null(lt.elem).text); }
                                default {
                                    e = node_child(ini, 0, i);
                                    switch (e.kind == NodeKind.IDENTIFIER)
                                    {
                                        case (true) {
                                        it = this.global_ident_init(e.text);
                                        switch (it == (byte*)0)
                                        {
                                            case (true) { -> (byte*)0; }
                                            default
                                            {
                                                ab.put_str(it);
                                            };
                                        };
                                    }
                                        default {
                                            switch (e.kind != NodeKind.STRUCT_LITERAL)
                                            {
                                                case (true) { -> (byte*)0; }
                                                default
                                                {
                                                    nf = si.n;
                                                    np = node_count(e, 2);
                                                    nn = node_count(e, 0);
                                                    switch (np > nf)
                                                    {
                                                        case (true) { -> (byte*)0; }
                                                        default
                                                        {
                                                            ex = (Node**)this.zbuf(nf + 1);
                                                            k = 0;
                                                            while (k < nn)
                                                            {
                                                                f = this.sidx(si, node_child(e, 0, k).text);
                                                                switch (f < 0)
                                                                {
                                                                    case (true) { -> (byte*)0; }
                                                                    default
                                                                    {
                                                                        ex[f] = node_child(e, 1, k);
                                                                        k++;
                                                                    };
                                                                };
                                                            };
                                                            k = 0;
                                                            while (k < np)
                                                            {
                                                                ex[k] = node_child(e, 2, k);
                                                                k++;
                                                            };
                                                            ab.put(123);
                                                            k = 0;
                                                            while (k < nf)
                                                            {
                                                                switch (k > 0)
                                                                {
                                                                    case (true) { ab.put_str(g", \0"); }
                                                                    default {};
                                                                };
                                                                lt_text(@ab, si.ftys[k]);
                                                                ab.put(32);
                                                                switch (ex[k] != (Node*)0)
                                                                {
                                                                    case (true) {
                                                                    fv = this.global_member_value(ex[k], si.ftys[k]);
                                                                    switch (fv == (byte*)0)
                                                                    {
                                                                        case (true) { -> (byte*)0; }
                                                                        default
                                                                        {
                                                                            ab.put_str(fv);
                                                                        };
                                                                    };
                                                                }
                                                                    default { ab.put_str(this.mod.c_null(si.ftys[k]).text); };
                                                                };
                                                                k++;
                                                            };
                                                            ab.put(125);
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                            i++;
                        };
                        ab.put(93);
                        r = this.mod.own(ab.mem);
                        -> r;
                    };
                };
            };



            split_agg(byte* t, int open, int* st, int* en, int max) -> int
            {
                int i = open + 1;
                int depth;
                int cnt;
                int b = i;
                bool q;
                byte c;
                while (t[i] != 0)
                {
                    c = t[i];
                    switch (q)
                    {
                        case (true) {
                        switch (c == '"') { case (true) { q = false; } default {}; };
                    }
                        default {
                            switch (c == '"')
                            {
                                case (true) { q = true; }
                                default {
                                    switch (c == '{' | c == '[' | c == '(')
                                    {
                                        case (true) { depth++; }
                                        default {
                                            switch (c == '}' | c == ']' | c == ')')
                                            {
                                                case (true) {
                                                switch (depth == 0)
                                                {
                                                    case (true) {
                                                    switch (i > b & cnt < max)
                                                    {
                                                        case (true) { st[cnt] = b; en[cnt] = i; cnt++; }
                                                        default {};
                                                    };
                                                    -> cnt;
                                                }
                                                    default
                                                    {
                                                        depth--;
                                                    };
                                                };
                                            }
                                                default {
                                                    switch (c == ',' & depth == 0)
                                                    {
                                                        case (true) {
                                                        switch (cnt < max)
                                                        {
                                                            case (true) { st[cnt] = b; en[cnt] = i; cnt++; }
                                                            default {};
                                                        };
                                                        b = i + 1;
                                                        switch (t[b] == ' ') { case (true) { b++; } default {}; };
                                                    }
                                                        default {};
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                    i++;
                };
                -> cnt;
            };


            patch_struct_text(byte* body, SInfo* si, int idx, byte* fv) -> byte*
            {
                int* sts = (int*)this.zbuf(64);
                int* ens = (int*)this.zbuf(64);
                int cnt;
                int i;
                int o;
                Buf ab;
                byte* r;
                switch (si.n > 64)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        ab.__init();
                        defer ab.__exit();
                        ab.put(123);
                        switch (body[0] == '{')
                        {
                            case (true) { cnt = this.split_agg(body, 0, sts, ens, 64); }
                            default {};
                        };
                        while (i < si.n)
                        {
                            switch (i > 0)
                            {
                                case (true) { ab.put_str(g", \0"); }
                                default {};
                            };
                            switch (i == idx)
                            {
                                case (true) {
                                switch (!this.gmv_full)
                                {
                                    case (true) {
                                        lt_text(@ab, si.ftys[i]);
                                        ab.put(32);
                                    }
                                    default {};
                                };
                                ab.put_str(fv);
                            }
                                default {
                                    switch (body[0] == '{' & i < cnt)
                                    {
                                        case (true) {
                                        o = sts[i];
                                        while (o < ens[i])
                                        {
                                            ab.put(body[o]);
                                            o++;
                                        };
                                    }
                                        default {
                                            lt_text(@ab, si.ftys[i]);
                                            ab.put(32);
                                            ab.put_str(this.mod.c_null(si.ftys[i]).text);
                                        };
                                    };
                                };
                            };
                            i++;
                        };
                        ab.put(125);
                        r = this.mod.own(ab.mem);
                        -> r;
                    };
                };
            };


            global_member_value(Node* v, IRType* ft) -> byte*
            {
                Buf ab;
                i64 x;
                byte* r;
                this.gmv_full = false;
                switch (v.kind == NodeKind.STRING_LITERAL & ft.kind == LK.PTR)
                {
                    case (true) {

                    ab.__init();
                    defer ab.__exit();
                    this.str_global_ref(v, @ab, false);
                    this.gmv_full = true;
                    r = this.mod.own(ab.mem);
                    -> r;
                }
                    default
                    {
                        switch (ft.kind != LK.INT)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                switch (v.kind == NodeKind.LITERAL)
                                {
                                    case (true) {
                                    switch (v.op != DataType.SINT & v.op != DataType.UINT & v.op != DataType.SLONG & v.op != DataType.ULONG &
                                            v.op != DataType.BOOL & v.op != DataType.CHAR)
                                    {
                                        case (true) { -> (byte*)0; }
                                        default
                                        {
                                            x = v.ival;
                                        };
                                    };
                                }
                                    default {
                                        switch (v.kind != NodeKind.IDENTIFIER)
                                        {
                                            case (true) { -> (byte*)0; }
                                            default
                                            {
                                                switch (!this.parse_int_text(this.global_ident_init(v.text), @x))
                                                {
                                                    case (true) { -> (byte*)0; }
                                                    default {};
                                                };
                                            };
                                        };
                                    };
                                };
                                ab.__init();
                                defer ab.__exit();
                                put_i64(@ab, x);
                                r = this.mod.own(ab.mem);
                                -> r;
                            };
                        };
                    };
                };
            };


            global_assign(Node* es) -> void
            {
                Node* asn = es.a;
                Node* t;
                Node* v;
                Node* o;
                IRGlobal* gl;
                SInfo* si;
                int idx;
                int ai;
                int* sts = (int*)this.zbuf(512);
                int* ens = (int*)this.zbuf(512);
                int cnt;
                int i;
                int j;
                byte* fv;
                byte* body;
                byte* nb;
                IRType* et;
                Buf ab;
                Buf pb;
                switch (asn == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (asn.kind != NodeKind.ASSIGNMENT)
                        {
                            case (true) { ->; }
                            default
                            {
                                t = asn.a;
                                v = asn.b;
                                switch (t.kind == NodeKind.MEMBER_ACCESS)
                                {
                                    case (true) {
                                    o = t.a;
                                    switch (o.kind == NodeKind.IDENTIFIER)
                                    {
                                        case (true) {
                                        gl = this.global_ident_find(o.text);
                                        switch (gl == (IRGlobal*)0 | gl.init == (byte*)0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        si = this.sinfo_of(gl.ty);
                                        switch (si == (SInfo*)0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        idx = this.sidx(si, t.text);
                                        switch (idx < 0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        fv = this.global_member_value(v, si.ftys[idx]);
                                        switch (fv == (byte*)0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        nb = this.patch_struct_text(gl.init, si, idx, fv);
                                        switch (nb == (byte*)0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        gl.init = nb;
                                        ->;
                                    }
                                        default {};
                                    };
                                    switch (o.kind == NodeKind.ARRAY_ACCESS)
                                    {
                                        case (true) {
                                        switch (o.a.kind != NodeKind.IDENTIFIER | o.b.kind != NodeKind.LITERAL)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        gl = this.global_ident_find(o.a.text);
                                        switch (gl == (IRGlobal*)0 | gl.init == (byte*)0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        switch (gl.ty.kind != LK.ARRAY)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        et = gl.ty.elem;
                                        si = this.sinfo_of(et);
                                        ai = (int)o.b.ival;
                                        switch (si == (SInfo*)0 | ai < 0 | ai >= gl.ty.count | gl.ty.count > 512)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        idx = this.sidx(si, t.text);
                                        switch (idx < 0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        fv = this.global_member_value(v, si.ftys[idx]);
                                        switch (fv == (byte*)0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        switch (gl.init[0] == '[')
                                        {
                                            case (true) { cnt = this.split_agg(gl.init, 0, sts, ens, 512); }
                                            default {};
                                        };
                                        ab.__init();
                                        defer ab.__exit();
                                        ab.put(91);
                                        i = 0;
                                        while (i < gl.ty.count)
                                        {
                                            switch (i > 0)
                                            {
                                                case (true) { ab.put_str(g", \0"); }
                                                default {};
                                            };
                                            lt_text(@ab, et);
                                            ab.put(32);
                                            body = this.mod.c_null(et).text;
                                            switch (gl.init[0] == '[' & i < cnt)
                                            {
                                                case (true) {

                                                j = sts[i];
                                                while (j < ens[i] & gl.init[j] != '{' & !(gl.init[j] == 'z' & gl.init[j + 1] == 'e'))
                                                {
                                                    j++;
                                                };
                                                pb.__init();
                                                while (j < ens[i])
                                                {
                                                    pb.put(gl.init[j]);
                                                    j++;
                                                };
                                                body = this.mod.own(pb.mem);
                                                pb.__exit();
                                            }
                                                default {};
                                            };
                                            switch (i == ai)
                                            {
                                                case (true) {
                                                nb = this.patch_struct_text(body, si, idx, fv);
                                                switch (nb == (byte*)0)
                                                {
                                                    case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                                    default {};
                                                };
                                                ab.put_str(nb);
                                            }
                                                default { ab.put_str(body); };
                                            };
                                            i++;
                                        };
                                        ab.put(93);
                                        gl.init = this.mod.own(ab.mem);
                                        ->;
                                    }
                                        default {};
                                    };
                                    -> this.note_unsup(g"global member assignment\0");
                                }
                                    default
                                    {
                                        switch (t.kind == NodeKind.ARRAY_ACCESS)
                                        {
                                            case (true) {

                                            switch (t.a.kind != NodeKind.IDENTIFIER | t.b.kind != NodeKind.LITERAL)
                                            {
                                                case (true) { -> this.note_unsup(g"global element assignment\0"); }
                                                default {};
                                            };
                                            gl = this.global_ident_find(t.a.text);
                                            switch (gl == (IRGlobal*)0)
                                            {
                                                case (true) { -> this.note_unsup(g"global element assignment\0"); }
                                                default {};
                                            };
                                            switch (gl.init == (byte*)0 | gl.ty.kind != LK.ARRAY)
                                            {
                                                case (true) { -> this.note_unsup(g"global element assignment\0"); }
                                                default {};
                                            };
                                            switch (gl.init[0] != '[' | gl.ty.count > 512)
                                            {
                                                case (true) { -> this.note_unsup(g"global element assignment\0"); }
                                                default {};
                                            };
                                            et = gl.ty.elem;
                                            ai = (int)t.b.ival;
                                            cnt = this.split_agg(gl.init, 0, sts, ens, 512);
                                            switch (ai < 0 | ai >= cnt)
                                            {
                                                case (true) { -> this.note_unsup(g"global element assignment\0"); }
                                                default {};
                                            };
                                            ab.__init();
                                            defer ab.__exit();
                                            switch (v.kind == NodeKind.STRING_LITERAL & et.kind == LK.PTR)
                                            {
                                                case (true) {
                                                switch (et.elem.kind != LK.INT)
                                                {
                                                    case (true) { -> this.note_unsup(g"global element assignment\0"); }
                                                    default {};
                                                };
                                                this.str_global_text(v, @ab);
                                            }
                                                default {
                                                    fv = this.global_member_value(v, et);
                                                    switch (fv == (byte*)0)
                                                    {
                                                        case (true) { -> this.note_unsup(g"global element assignment\0"); }
                                                        default {};
                                                    };
                                                    lt_text(@ab, et);
                                                    ab.put(32);
                                                    ab.put_str(fv);
                                                };
                                            };
                                            fv = this.mod.own(ab.mem);
                                            pb.__init();
                                            defer pb.__exit();
                                            j = 0;
                                            while (j < sts[ai])
                                            {
                                                pb.put(gl.init[j]);
                                                j++;
                                            };
                                            pb.put_str(fv);
                                            j = ens[ai];
                                            while (gl.init[j] != 0)
                                            {
                                                pb.put(gl.init[j]);
                                                j++;
                                            };
                                            gl.init = this.mod.own(pb.mem);
                                            ->;
                                        }
                                            default
                                            {
                                                ->;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            str_global_text(Node* e, Buf* ob) -> bool
            {
                -> this.str_global_ref(e, ob, true);
            };

            str_global_ref(Node* e, Buf* ob, bool decay) -> bool
            {
                byte* src = this.str_bytes(e);
                int len = this.q_len;
                byte* buf;
                IRType* aty;
                IRValue* cv;
                IRGlobal* gl;
                void* hit;
                IRValue* gv;
                buf = (byte*)fmalloc((u64)(len + 2));
                this.keep((void*)buf);
                memcpy((void*)buf, (void*)src, (u64)len);
                switch (this.null_term)
                {
                    case (true) {
                    switch (len == 0)
                    {
                        case (true) { buf[0] = (byte)0; len = 1; }
                        default {
                            switch (buf[len - 1] != (byte)0)
                            {
                                case (true) { buf[len] = (byte)0; len++; }
                                default {};
                            };
                        };
                    };
                }
                    default {};
                };
                aty = this.mod.t_array(this.t_i8, len);
                cv = this.mod.c_bytes(aty, buf, len);
                hit = nm_get(this.gcache, cv.text);
                switch (hit != (void*)0)
                {
                    case (true) { gv = (IRValue*)hit; }
                    default {
                        this.sc.clear();
                        this.sc.put_str(f".str.{this.nstr}\0");
                        this.nstr++;
                        gl = this.mod.add_global(aty, this.sc.mem, cv.text);
                        gl.linkage = this.mod.own(g"internal\0");
                        gl.constant = true;
                        this.mark_arr_ptr(gl.self.ty);
                        nm_put(this.gcache, this.mod.own(cv.text), (void*)gl.self);
                        gv = gl.self;
                    };
                };
                switch (!decay)
                {
                    case (true) {
                    lt_text(ob, aty);
                    ob.put_str(f"* {gv.text}\0");
                    -> true;
                }
                    default
                    {
                        ob.put_str(g"i8* getelementptr (\0");
                        lt_text(ob, aty);
                        ob.put_str(g", \0");
                        lt_text(ob, aty);
                        ob.put_str(f"* {gv.text}, i32 0, i32 0)\0");
                        -> true;
                    };
                };
            };

            global_array_init(Node* ini, IRType* lt) -> byte*
            {
                int n = node_count(ini, 0);
                int i;
                i64* vals;
                i64 one;
                byte* r;
                switch (lt.kind != LK.ARRAY)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        switch (lt.elem.kind == LK.ISTRUCT)
                        {
                            case (true) { -> this.global_struct_array_init(ini, lt); }
                            default
                            {
                                switch (lt.elem.kind == LK.PTR)
                                {
                                    case (true) { -> this.global_ptr_array_init(ini, lt); }
                                    default
                                    {
                                        switch (lt.elem.kind == LK.FLOAT | lt.elem.kind == LK.DOUBLE)
                                        {
                                            case (true) { -> this.global_fp_array_init(ini, lt); }
                                            default
                                            {
                                                switch (lt.elem.kind != LK.INT)
                                                {
                                                    case (true) { -> (byte*)0; }
                                                    default
                                                    {
                                                        switch (n > lt.count)
                                                        {
                                                            case (true) { -> (byte*)0; }
                                                            default
                                                            {
                                                                vals = (i64*)fmalloc((u64)(8 * (n + 1)));
                                                                while (i < n)
                                                                {
                                                                    switch (!this.global_elem_value(node_child(ini, 0, i), lt.elem, @one))
                                                                    {
                                                                        case (true) { ffree((void*)vals); -> (byte*)0; }
                                                                        default
                                                                        {
                                                                            vals[i] = one;
                                                                            i++;
                                                                        };
                                                                    };
                                                                };
                                                                r = this.global_array_text(lt, vals, n);
                                                                ffree((void*)vals);
                                                                -> r;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            global_string_init(Node* ini, IRType* lt) -> byte*
            {
                int len;
                int i;
                i64* vals;
                byte* r;
                byte* src;
                Buf pb;
                switch (lt.kind == LK.PTR & lt.elem.kind == LK.INT & lt.elem.width == 8)
                {
                    case (true) {

                    pb.__init();
                    this.gsi_ref(ini.text, this.str_len_of(ini), @pb, false);
                    r = this.mod.own(pb.mem);
                    pb.__exit();
                    -> r;
                }
                    default
                    {
                        src = this.str_bytes(ini);
                        len = this.q_len;
                        switch (lt.kind != LK.ARRAY)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                switch (lt.elem.kind != LK.INT)
                                {
                                    case (true) { -> (byte*)0; }
                                    default
                                    {
                                        switch (lt.elem.width != 8)
                                        {
                                            case (true) { -> (byte*)0; }
                                            default
                                            {
                                                switch (len > lt.count)
                                                {
                                                    case (true) { len = lt.count; }
                                                    default {};
                                                };
                                                vals = (i64*)fmalloc((u64)(8 * (len + 1)));
                                                while (i < len)
                                                {
                                                    vals[i] = (i64)src[i];
                                                    i++;
