                                                r = this.global_array_text(lt, vals, len);
                                                ffree((void*)vals);
                                                -> r;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            sized_to(TypeSpec* ts, int cnt, Node* n) -> TypeSpec*
            {
