                            default
                            {
                                switch (ts.base_type == DataType.DATA & ts.bit_width > 0)
                                {
                                    case (true)
                                    {
                                        b.__init();
                                        b.put_str(g"__data_\0");
                                        b.put_int(ts.bit_width);
                                        b.put(0);
                                        nm_put(this.ltn, n.text, (void*)this.keep(b.mem));
                                        b.__exit();
                                    }
                                    default { nm_put(this.ltn, n.text, (void*)datatype_text(ts.base_type)); };
                                };
                            };
                        };
                    }
                    default {};
                };
                switch (n.a != (Node*)0)
                {
                    case (true)
                    {
                        switch (n.a.kind != NodeKind.NO_INIT)
                        {
                            case (true)
                            {
                                slot = this.alloc_local(n.text);
                                this.visit_expr(n.a);
                                this.emit1(51, (i64)slot);
                            }
                            default {};
                        };
                    }
                    default {};
                };
                -> false;
            };




            visit_range_assignment(Node* n) -> bool
            {
                int arr;
                int ctr;
                int st;
                int en;
                int fl;
                int cond;
                int jend;
                switch (n.ival != (i64)0)
                {
                    case (true)
                    {
                        this.fail(n, g"fvmcodegen: range assignment from an array value is not supported in comptime\0");
                        -> false;
                    }
                    default {};
