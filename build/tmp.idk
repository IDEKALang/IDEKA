    print_working_dir() -> void
    {
        byte* srcdir = getenv(g"IDEKA_SRCDIR\0");
        byte[1024] cwd;
        print("Working directory: \0");
        if (srcdir != (byte*)0)
        {
            println(srcdir);
            ->;
        };




        if (_getcwd(@cwd[0], 1024) != (byte*)0) { println(@cwd[0]); ->; };
        println(".\0");
        ->;
