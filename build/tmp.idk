                                                                                                        default {
                                                                                                            switch (this.is_uns(lhs) | lhs.spec == (TypeSpec*)0)
                                                                                                            {
                                                                                                                case (true) { r = this.mod.binop(g"lshr\0", lhs, rhs, (byte*)0); }
                                                                                                                default { r = this.mod.binop(g"ashr\0", lhs, rhs, (byte*)0); };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                    switch (this.is_uns(lhs))
                                                                                                    {
                                                                                                        case (true) { r.spec = this.lit_spec(DataType.UINT); }
                                                                                                        default { r.spec = this.lit_spec(DataType.SINT); };
                                                                                                    };
                                                                                                    -> r;
                                                                                                }
                                                                                                    default
                                                                                                    {
                                                                                                        switch (op == Operator.NOR | op == Operator.NAND | op == Operator.BITNAND | op == Operator.BITNOR | op == Operator.BITXNOR)
                                                                                                        {
                                                                                                            case (true) {
                                                                                                            switch (op == Operator.NOR | op == Operator.BITNOR)
                                                                                                            {
                                                                                                                case (true) { r = this.mod.binop(g"or\0", lhs, rhs, (byte*)0); }
                                                                                                                default {
                                                                                                                    switch (op == Operator.NAND | op == Operator.BITNAND)
                                                                                                                    {
                                                                                                                        case (true) { r = this.mod.binop(g"and\0", lhs, rhs, (byte*)0); }
                                                                                                                        default { r = this.mod.binop(g"xor\0", lhs, rhs, (byte*)0); };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                            r = this.mod.binop(g"xor\0", r, this.mod.c_int(r.ty, (i64)(0 - 1)), (byte*)0);
                                                                                                            switch (op != Operator.NOR & op != Operator.NAND)
                                                                                                            {
                                                                                                                case (true) {
                                                                                                                switch (this.is_uns(lhs) | this.is_uns(rhs))
                                                                                                                {
                                                                                                                    case (true) { r.spec = this.lit_spec(DataType.UINT); }
                                                                                                                    default { r.spec = this.lit_spec(DataType.SINT); };
                                                                                                                };
                                                                                                            }
                                                                                                                default {};
                                                                                                            };
                                                                                                            -> r;
                                                                                                        }
                                                                                                            default
                                                                                                            {
                                                                                                                this.unsup(n, g"binary operator\0");
                                                                                                                -> (IRValue*)0;
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };






            is_fp_var(byte* name) -> bool
            {
                LVar* lv = this.find_local(name);
                IRType* pe;
                switch (lv != (LVar*)0)
                {
                    case (true) {
                    switch (lv.ptr.ty.kind != LK.PTR)
                    {
                        case (true) { -> false; }
                        default {};
                    };
                    pe = lv.ptr.ty.elem;
                    switch (pe.kind == LK.FUNC)
                    {
                        case (true) { -> true; }
                        default {};
                    };
                    switch (pe.kind == LK.PTR)
                    {
                        case (true) { -> pe.elem.kind == LK.FUNC; }
                        default {};
                    };
                    -> false;
                }
                    default
                    {
                        lv = this.find_global_var(name);
                        switch (lv == (LVar*)0)
                        {
                            case (true) { -> false; }
                            default
                            {
                                switch (lv.ptr.ty.kind != LK.PTR)
                                {
                                    case (true) { -> false; }
                                    default
                                    {
                                        pe = lv.ptr.ty.elem;
                                        -> pe.kind == LK.FUNC | pe.kind == LK.PTR;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            x_fpcall(Node* n) -> IRValue*
            {
                Node* idn = node_new(NodeKind.IDENTIFIER, n.line, n.col);
                IRValue* pv;
                IRValue* fpv;
                IRValue* v;
                IRValue** args;
                IRType* pe;
                IRType* ft;
                Node* an;
                int argc = node_count(n, 0);
                int i;
                this.keep((void*)idn);
                idn.text = n.text;
                pv = this.visit(idn);
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        switch (pv == (IRValue*)0)
                        {
                            case (true) {
                            this.unsup(n, g"function pointer value\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                fpv = pv;
                                switch (pv.ty.kind == LK.PTR)
                                {
                                    case (true) {
                                    pe = pv.ty.elem;
                                    switch (pe.kind)
                                    {
                                        case (LK.FUNC) { fpv = pv; }
                                        default { fpv = this.mod.load(pv, g"fp_load\0"); };
                                    };
                                }
                                    default {};
                                };
                                switch (fpv.ty.kind != LK.PTR)
                                {
                                    case (true) {
                                    this.unsup(n, g"function pointer type\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        switch (fpv.ty.elem.kind != LK.FUNC)
                                        {
                                            case (true) {
                                            this.unsup(n, g"function pointer type\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                ft = fpv.ty.elem;
                                                args = (IRValue**)this.zbuf(argc + 1);
                                                i = 0;
                                                while (i < argc)
                                                {
                                                    an = node_child(n, 0, i);
                                                    v = this.visit(an);
                                                    switch (this.bad)
                                                    {
                                                        case (true) { -> (IRValue*)0; }
                                                        default
                                                        {
                                                            switch (v == (IRValue*)0)
                                                            {
                                                                case (true) {
                                                                this.unsup(n, g"void call argument\0");
                                                                -> (IRValue*)0;
                                                            }
                                                                default
                                                                {
                                                                    args[i] = v;
                                                                    i++;
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                                i = 0;
                                                while (i < argc & i < ft.nitems)
                                                {
                                                    args[i] = this.convert_arg(args[i], ft.items[i], i, n);
                                                    switch (this.bad)
                                                    {
                                                        case (true) { -> (IRValue*)0; }
                                                        default
                                                        {
                                                            i++;
                                                        };
                                                    };
                                                };
                                                -> this.mod.call_ex(fpv, args, argc, g"fp_call\0", (byte*)0, false);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            x_call(Node* n) -> IRValue*
            {
                int argc = node_count(n, 0);
                int i;
                int total;
                IRFunc* f;
                IRValue** args;
                IRValue* v;
                IRValue* r;
                IRType* ft;
                Node* an;
                Node* dn;
                IRValue** pslot;
                switch (n.text != (byte*)0)
                {
                    case (true) {
                    switch (this.is_fp_var(n.text))
                    {
                        case (true) { -> this.x_fpcall(n); }
                        default {};
                    };
                }
                    default {};
                };
                switch (n.text3 == (byte*)0)
                {
                    case (true) {
                    if (!this.bad) { this.bad_detail = n.text; };
                    this.unsup(n, g"call target not resolved\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        f = this.mod.find_function(n.text3);
                        switch (f == (IRFunc*)0 & n.text != (byte*)0)
                        {
                            case (true) {

                            f = this.mod.find_function(n.text);
                        }
                            default {};
                        };
                        switch (f == (IRFunc*)0)
                        {
                            case (true) {
                            this.unsup(n, g"call target not declared\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                ft = f.ftype;
                                total = argc;
                                switch (ft.nitems > total & !ft.vararg)
                                {
                                    case (true) { total = ft.nitems; }
                                    default {};
                                };
                                args = (IRValue**)fmalloc((u64)(total + 1) * (u64)((sizeof(IRValue*) + 7) / 8));
                                this.keep((void*)args);
                                i = 0;
                                while (i < argc)
                                {
                                    an = node_child(n, 0, i);
                                    switch (an.kind == NodeKind.IDENTIFIER)
                                    {
                                        case (true) {
                                        switch (this.local_flag(an.text, 16))
                                        {
                                            case (true) {
                                            this.unsup(n, g"local variable leaves scope\0");
                                            -> (IRValue*)0;
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    v = this.visit(an);
                                    switch (this.bad)
                                    {
                                        case (true) { -> (IRValue*)0; }
                                        default
                                        {
                                            switch (v == (IRValue*)0)
                                            {
                                                case (true) {
                                                this.unsup(n, g"void call argument\0");
                                                -> (IRValue*)0;
                                            }
                                                default
                                                {
                                                    args[i] = v;
                                                    i++;
                                                };
                                            };
                                        };
                                    };
                                };
                                pslot = (IRValue**)this.zbuf(1);
                                switch (this.ptr_overload_call(n, argc, pslot)) { case (true) { -> *pslot; } default
                                    {
                                        i = argc;
                                        while (i < total)
                                        {
                                            dn = this.default_of(f, n, i);
                                            switch (dn == (Node*)0)
                                            {
                                                case (true) {
                                                this.unsup(n, g"missing call argument\0");
                                                -> (IRValue*)0;
                                            }
                                                default
                                                {
                                                    v = this.visit(dn);
                                                    switch (this.bad)
                                                    {
                                                        case (true) { -> (IRValue*)0; }
                                                        default
                                                        {
                                                            args[i] = v;
                                                            i++;
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                        i = 0;
                                        while (i < total & i < ft.nitems)
                                        {
                                            args[i] = this.convert_arg(args[i], ft.items[i], i, n);
                                            switch (this.bad)
                                            {
                                                case (true) { -> (IRValue*)0; }
                                                default
                                                {
                                                    i++;
                                                };
                                            };
                                        };


                                        switch (argc == 0 & !this.spells_mangled(n.text) & this.ptr_ovl_zero(n.text))
                                        {
                                            case (true) { r = this.mod.call_ex(f.self, args, total, g"op_overload_result\0", f.cconv, false); }
                                            default {
                                                this.mod.must_tail = this.fn == f & this.rec_fn;
                                                r = this.mod.call_ex(f.self, args, total, (byte*)0, f.cconv, this.fn == f);
                                            };
                                        };
                                        -> r;
                                    }; };
                            };
                        };
                    };
                };
            };



            ov_key_end(byte* s) -> int
            {
                int i;
                int j;
                while (s[i] != 0)
                {
                    switch (s[i] == '_' & s[i + 1] == '_' & s[i + 2] >= '0' & s[i + 2] <= '9')
                    {
                        case (true) {
                        j = i + 2;
                        while (s[j] >= '0' & s[j] <= '9') { j++; };
                        switch (s[j] == '_' & s[j + 1] == '_') { case (true) { -> i; } default {}; };
                    }
                        default {};
                    };
                    i++;
                };
                -> -1;
            };


            ov_key_matches(byte* fname, int e, byte* name) -> bool
            {
                int nl;
                int i;
                while (name[nl] != 0) { nl++; };
                switch (e == nl)
                {
                    case (true) {
                    while (i < e)
                    {
                        switch (fname[i] != name[i]) { case (true) { -> false; } default {}; };
                        i++;
                    };
                    -> true;
                }
                    default
                    {
                        switch (e < nl + 2) { case (true) { -> false; } default
                            {
                                switch (fname[e - nl - 2] != '_' | fname[e - nl - 1] != '_') { case (true) { -> false; } default
                                    {
                                        while (i < nl)
                                        {
                                            switch (fname[e - nl + i] != name[i]) { case (true) { -> false; } default
                                                {
                                                    i++;
                                                }; };
                                        };
                                        -> true;
                                    }; };
                            }; };
                    };
                };
            };




            ptr_overload_call(Node* n, int argc, IRValue** out) -> bool
            {
                byte* name;
                int nl;
                int i;
                int j;
                int e;
                int ke = -1;
                IRFunc* g;
                IRFunc* key_f = (IRFunc*)0;
                IRValue** args;
                IRType* pt;
                LVar* lv;
                Node* an;
                bool ok;
                switch (n.text == (byte*)0 | argc == 0) { case (true) { -> false; } default
                    {
                        while (n.text[nl] != 0) { nl++; };
                        name = (byte*)fmalloc((u64)(nl + 1));
                        this.keep((void*)name);
                        while (i < nl)
                        {
                            switch (n.text[i] == ':' & n.text[i + 1] == ':')
                            {
                                case (true) {
                                name[j] = '_';
                                name[j + 1] = '_';
                                j = j + 2;
                                i = i + 2;
                            }
                                default {
                                name[j] = n.text[i];
                                j++;
                                i++;
                            };
                            };
                        };
                        name[j] = 0;
                        i = 0;
                        while (i < this.mod.funcs.len & key_f == (IRFunc*)0)
                        {
                            g = (IRFunc*)this.mod.funcs.items[i];
                            e = this.ov_key_end(g.name);
                            switch (e >= 0)
                            {
                                case (true) {
                                switch (this.ov_key_matches(g.name, e, name)) { case (true) { key_f = g; ke = e; } default {}; };
                            }
                                default {};
                            };
                            i++;
                        };
                        switch (key_f == (IRFunc*)0) { case (true) { -> false; } default
                            {
                                i = 0;
                                while (i < this.mod.funcs.len)
                                {
                                    g = (IRFunc*)this.mod.funcs.items[i];
                                    i++;
                                    e = this.ov_key_end(g.name);
                                    switch (e != ke) { case (true) { continue; } default
                                        {
                                            j = 0;
                                            ok = true;
                                            while (j < ke & ok)
                                            {
                                                switch (g.name[j] != key_f.name[j]) { case (true) { ok = false; } default {}; };
                                                j++;
                                            };
                                            switch (!ok | g.ftype.nitems != argc) { case (true) { continue; } default
                                                {
                                                    args = (IRValue**)fmalloc((u64)(argc + 1) * (u64)((sizeof(IRValue*) + 7) / 8));
                                                    this.keep((void*)args);
                                                    j = 0;
                                                    while (j < argc & ok)
                                                    {
                                                        pt = g.ftype.items[j];
                                                        switch (pt.kind != LK.PTR) { case (true) { ok = false; } default {}; };
                                                        switch (ok)
                                                        {
                                                            case (true) {
                                                            switch (pt.elem.kind == LK.ARRAY | pt.elem.kind == LK.ISTRUCT) { case (true) { ok = false; } default {}; };
                                                        }
                                                            default {};
                                                        };
                                                        an = node_child(n, 0, j);
                                                        switch (ok & an.kind != NodeKind.IDENTIFIER) { case (true) { ok = false; } default {}; };
                                                        switch (ok)
                                                        {
                                                            case (true) {
                                                            lv = this.find_local(an.text);
                                                            switch (lv == (LVar*)0) { case (true) { ok = false; } default {}; };
                                                        }
                                                            default {};
                                                        };
                                                        switch (ok)
                                                        {
                                                            case (true) {
                                                            switch (!lt_eq(lv.ptr.ty, pt)) { case (true) { ok = false; } default {}; };
                                                        }
                                                            default {};
                                                        };
                                                        switch (ok) { case (true) { args[j] = lv.ptr; } default {}; };
                                                        j++;
                                                    };
                                                    switch (ok)
                                                    {
                                                        case (true) {
                                                        *out = this.mod.call_ex(g.self, args, argc, g"op_overload_result\0", g.cconv, false);
                                                        -> true;
                                                    }
                                                        default {};
                                                    };
                                                }; };
                                        }; };
                                };
                                -> false;
                            }; };
                    }; };
            };




            is_ext_fn(Node* fd) -> bool
            {
                int i;
                while (i < this.ext_fns.len)
                {
                    switch (this.ext_fns.items[i] == (void*)fd) { case (true) { -> true; } default
                        {
                            i++;
                        }; };
                };
                -> false;
            };

            ptr_ovl_zero(byte* name) -> bool
            {
                int i, j, kl, nl, pass;
                bool dotted;
                byte* key;
                PtrVec* list;
                Overload* oc;
                while (name[nl] != 0) { nl++; };

                while (pass < 2)
                {
                i = 0;
                while (i < this.st.overloads.count)
                {
                    key = this.st.overloads.keys[i];
                    kl = 0;
                    dotted = false;
                    while (key[kl] != 0) { switch (key[kl] == '.') { case (true) { dotted = true; } default {}; }; kl++; };
                    j = 0;
                    switch ((pass == 0) != dotted)
                    {
                        case (true) { i++; continue; }
                        default
                        {
                            switch (cstr_eq(key, name) | (kl > nl + 2 & cstr_eq(key + (kl - nl), name) & key[kl - nl - 1] == '_' & key[kl - nl - 2] == '_'))
                            {
                                case (true) {
                                list = (PtrVec*)this.st.overloads.vals[i];
                                while (j < list.len)
                                {
                                    oc = (Overload*)list.items[j];
                                    switch (oc.nparams == 0 & !this.is_ext_fn(oc.func)) { case (true) { -> true; } default {}; };
                                    j++;
                                };
                                -> false;
                            }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                    };
                };
                pass++;
                };
                -> false;
            };

            spells_mangled(byte* s) -> bool
            {
                int i;
                switch (s == (byte*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        while (s[i] != 0)
                        {
                            switch (s[i] == '_' & s[i + 1] == '_' & s[i + 2] == 'r' & s[i + 3] == 'e' & s[i + 4] == 't' & s[i + 5] == '_')
                            {
                                case (true) { -> true; }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                        -> false;
                    };
                };
            };


            default_of(IRFunc* f, Node* call, int i) -> Node*
            {
                Node* fd = (Node*)nm_get(this.fdefs, f.name);
                Node* p;
                switch (fd == (Node*)0)
                {
                    case (true) { -> (Node*)0; }
                    default
                    {
                        switch (i >= node_count(fd, 0))
                        {
                            case (true) { -> (Node*)0; }
                            default
                            {
                                p = node_child(fd, 0, i);
                                -> p.a;
                            };
                        };
                    };
                };
            };


            local_flag(byte* name, int flag) -> bool
            {
                LVar* lv = this.find_var(name);
                switch (lv == (LVar*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (lv.ts == (TypeSpec*)0)
                        {
                            case (true) { -> false; }
                            default
                            {
                                -> (lv.ts.flags `& flag) != 0;
                            };
                        };
                    };
                };
            };






            assign_ident(Node* target, IRValue* val, Node* value_expr) -> IRValue*
            {
                LVar* lv = this.find_var(target.text);
                IRValue* v;
                switch (lv == (LVar*)0)
                {
                    case (true) {
                    this.unsup(target, g"assign to non-local\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (lv.ts != (TypeSpec*)0)
                        {
                            case (true) {
                            switch ((lv.ts.flags `& 2) != 0)
                            {
                                case (true) {
                                this.unsup(target, g"assign to const\0");
                                -> (IRValue*)0;
                            }
                                default
                                {
                                    switch ((lv.ts.flags `& 128) != 0)
                                    {
                                        case (true) {
                                        this.unsup(target, g"assign to const pointer\0");
                                        -> (IRValue*)0;
                                    }
                                        default {};
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        switch (nm_get(this.untied, target.text) != (void*)0)
                        {
                            case (true) {
                            this.unsup(target, g"assign to an untied variable\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (value_expr.kind == NodeKind.BINARY_OP)
                                {
                                    case (true) {
                                    switch (value_expr.op == Operator.ADD & val.ty.kind == LK.PTR & val.ty.elem.kind == LK.ARRAY)
                                    {
                                        case (true) {
                                        this.unsup(target, g"array concatenation assign\0");
                                        -> (IRValue*)0;
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (value_expr.kind == NodeKind.ARRAY_LITERAL & lv.ptr.ty.elem.kind == LK.PTR)
                                {
                                    case (true) {
                                    this.unsup(target, g"array literal to pointer assign\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        v = this.maybe_swap(val, lv.ptr);
                                        v = this.convert_assign(v, lv.ptr.ty.elem);
                                        switch (this.bad)
                                        {
                                            case (true) { -> (IRValue*)0; }
                                            default
                                            {
                                                this.mod.store(v, lv.ptr);
                                                -> v;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            zbuf(int n) -> void*
            {
                byte* r = (byte*)fmalloc((u64)(8 * n));
                int i;
                while (i < 8 * n)
                {
                    r[i] = (byte)0;
                    i++;
                };
                this.keep((void*)r);
                -> (void*)r;
            };



            next_quoted(byte* s, int p) -> int
            {
                int a;
                int b;
                while (s[p] != 0 & s[p] != '"') { p++; };
                switch (s[p] == 0)
                {
                    case (true) { -> -1; }
                    default
                    {
                        a = p + 1;
                        b = a;
                        while (s[b] != 0 & s[b] != '"') { b++; };
                        switch (s[b] == 0)
                        {
                            case (true) { -> -1; }
                            default
                            {
                                this.q_len = b - a;
                                this.q_end = b + 1;
                                -> a;
                            };
                        };
                    };
                };
            };


            sub_dup(byte* s, int a, int len) -> byte*
            {
                byte* r = (byte*)fmalloc((u64)(len + 1));
                int i;
                while (i < len)
                {
                    r[i] = s[a + i];
                    i++;
                };
                r[len] = (byte)0;
                this.keep((void*)r);
                -> r;
            };


            asm_pairs(byte* s, int a, int b, byte** cs, byte** vs) -> int
            {
                int p = a;
                int n = 0;
                int qs;
                int ql;
                int vs0;
                int ve;
                while (p < b & n < 16)
                {
                    while (p < b & s[p] != '"') { p++; };
                    switch (p >= b)
                    {
                        case (true) { break; }
                        default
                        {
                            qs = p + 1;
                            ql = qs;
                            while (ql < b & s[ql] != '"') { ql++; };
                            switch (ql >= b)
                            {
                                case (true) { break; }
                                default
                                {
                                    p = ql + 1;
                                    while (p < b & (s[p] == ' ' | s[p] == 9 | s[p] == 10 | s[p] == 13)) { p++; };
                                    switch (p >= b | s[p] != '(')
                                    {
                                        case (true) { continue; }
                                        default
                                        {
                                            vs0 = p + 1;
                                            ve = vs0;
                                            while (ve < b & s[ve] != ')') { ve++; };
                                            switch (ve >= b | ve == vs0)
                                            {
                                                case (true) { break; }
                                                default
                                                {
                                                    cs[n] = this.sub_dup(s, qs, ql - qs);
                                                    vs[n] = this.sub_dup(s, vs0, ve - vs0);
                                                    n++;
                                                    p = ve + 1;
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                -> n;
            };


            x_asm(Node* n) -> IRValue*
            {
                byte* body = n.text;
                byte* cons = n.text2;
                byte** cs = (byte**)this.zbuf(16);
                byte** vs = (byte**)this.zbuf(16);
                byte** ocs = (byte**)this.zbuf(16);
                byte** ics = (byte**)this.zbuf(16);
                byte** fcs = (byte**)this.zbuf(40);
                IRValue** oops = (IRValue**)this.zbuf(16);
                IRValue** iops = (IRValue**)this.zbuf(16);
                IRValue** fin_ops = (IRValue**)this.zbuf(40);
                byte** clob = (byte**)this.zbuf(16);
                IRType** itys = (IRType**)this.zbuf(40);
                IRType** otys = (IRType**)this.zbuf(16);
                IRValue** ro_ptr = (IRValue**)this.zbuf(16);
                int ncs;
                int no;
                int ni;
                int nclob;
                int nfin;
                int nfc;
                int nro;
                int i;
                int j;
                int p0;
                int p1;
                int len;
                int a;
                int ls;
                int le;
                int ts;
                int te;
                int qs;
                IRValue* v;
                IRValue* res;
                IRValue* callee;
                IRType* rty;
                IRType* ft;
                LVar* lv;
                byte* c;
                bool first = true;
                switch (body == (byte*)0)
                {
                    case (true) { body = g"\0"; }
                    default {};
                };

                this.asmb.clear();
                i = 0;
                while (body[i] != 0 | i == 0)
                {
                    ls = i;
                    while (body[i] != 0 & body[i] != 10) { i++; };
                    le = i;
                    ts = ls;
                    te = le;
                    while (ts < te & (body[ts] == ' ' | body[ts] == 9 | body[ts] == 13)) { ts++; };
                    while (te > ts & (body[te - 1] == ' ' | body[te - 1] == 9 | body[te - 1] == 13)) { te--; };
                    switch (te > ts)
                    {
                        case (true) {
                        switch (!(body[ts] == '/' & body[ts + 1] == '/'))
                        {
                            case (true) {
                            switch (!first)
                            {
                                case (true) { this.asmb.put(10); }
                                default {};
                            };
                            first = false;
                            j = ls;
                            while (j < le)
                            {
                                this.asmb.put((int)body[j]);
                                j++;
                            };
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    switch (body[i] == 0)
                    {
                        case (true) { break; }
                        default
                        {
                            i++;
                        };
                    };
                };

                p0 = -1;
                p1 = -1;
                len = 0;
                switch (cons != (byte*)0)
                {
                    case (true) {
                    while (cons[len] != 0)
                    {
                        switch (cons[len] == ':')
                        {
                            case (true) {
                            switch (p0 < 0)
                            {
                                case (true) { p0 = len; }
                                default {
                                    switch (p1 < 0)
                                    {
                                        case (true) { p1 = len; }
                                        default {};
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        len++;
                    };
                }
                    default {};
                };
                no = 0;
                ni = 0;
                nclob = 0;
                switch (cons != (byte*)0)
                {
                    case (true) {
                    int oe = len;
                    int ie = len;
                    switch (p0 >= 0)
                    {
                        case (true) { oe = p0; }
                        default {};
                    };
                    switch (p1 >= 0)
                    {
                        case (true) { ie = p1; }
                        default {
                            switch (p0 >= 0)
                            {
                                case (true) { ie = len; }
                                default {};
                            };
                        };
                    };
                    ncs = this.asm_pairs(cons, 0, oe, cs, vs);
                    i = 0;
                    while (i < ncs)
                    {
                        c = cs[i];
                        switch (c[0] != '=' & c[0] != '+')
                        {
                            case (true) {
                            this.sc.clear();
                            this.sc.put(61);
                            this.sc.put_str(c);
                            c = this.sub_dup(this.sc.mem, 0, this.sc.len);
                        }
                            default {};
                        };
                        lv = this.find_var(vs[i]);
                        switch (lv != (LVar*)0)
                        {
                            case (true) {
                            oops[no] = lv.ptr;
                            ocs[no] = c;
                            no++;
                        }
                            default {};
                        };
                        i++;
                    };
                    switch (p0 >= 0)
                    {
                        case (true) {
                        ncs = this.asm_pairs(cons, p0 + 1, ie, cs, vs);
                        i = 0;
                        while (i < ncs)
                        {
                            lv = this.find_var(vs[i]);
                            switch (lv != (LVar*)0)
                            {
                                case (true) {
                                v = lv.ptr;
                                switch (cstr_eq(cs[i], g"m\0") | (v.ty.kind == LK.PTR & v.ty.elem.kind == LK.ARRAY))
                                {
                                    case (true) { iops[ni] = v; }
                                    default {
                                    this.sc.clear();
                                    this.sc.put_str(f"{vs[i]}_load\0");
                                    iops[ni] = this.mod.load(v, this.sc.mem);
                                };
                                };
                                ics[ni] = cs[i];
                                ni++;
                            }
                                default {};
                            };
                            i++;
                        };
                    }
                        default {};
                    };
                    switch (p1 >= 0)
                    {
                        case (true) {
                        a = p1 + 1;
                        while (nclob < 16)
                        {
                            qs = this.next_quoted(cons, a);
                            switch (qs < 0)
                            {
                                case (true) { break; }
                                default
                                {
                                    clob[nclob] = this.sub_dup(cons, qs, this.q_len);
                                    nclob++;
                                    a = this.q_end;
                                };
                            };
                        };
                    }
                        default {};
                    };
                }
                    default {};
                };

                i = 0;
                byte* rn;
                while (i < no)
                {
                    c = ocs[i];
                    a = 0;
                    switch (c[0] == '=' | c[0] == '+')
                    {
                        case (true) { a = 1; }
                        default {};
                    };
                    switch (c[a + 1] == 0)
                    {
                        case (true) {
                        rn = (byte*)0;
                        switch (c[a] == 'a')
                        {
                            case (true) { rn = g"rax\0"; }
                            default {
                                switch (c[a] == 'b')
                                {
                                    case (true) { rn = g"rbx\0"; }
                                    default {
                                        switch (c[a] == 'c')
                                        {
                                            case (true) { rn = g"rcx\0"; }
                                            default {
                                                switch (c[a] == 'd')
                                                {
                                                    case (true) { rn = g"rdx\0"; }
                                                    default {
                                                        switch (c[a] == 'S')
                                                        {
                                                            case (true) { rn = g"rsi\0"; }
                                                            default {
                                                                switch (c[a] == 'D')
                                                                {
                                                                    case (true) { rn = g"rdi\0"; }
                                                                    default {};
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        switch (rn != (byte*)0)
                        {
                            case (true) {
                            this.sc.clear();
                            switch (a == 1)
                            {
                                case (true) { this.sc.put((int)c[0]); }
                                default {};
                            };
                            this.sc.put(123);
                            this.sc.put_str(rn);
                            this.sc.put(125);
                            ocs[i] = this.sub_dup(this.sc.mem, 0, this.sc.len);
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    i++;
                };

                nfin = 0;
                nfc = 0;
                i = 0;
                while (i < ni)
                {
                    fin_ops[nfin] = iops[i];
                    nfin++;
                    fcs[nfc] = ics[i];
                    nfc++;
                    i++;
                };
                nro = 0;
                i = 0;
                while (i < no)
                {
                    c = ocs[i];
                    switch (c[0] == '=' | c[0] == '+')
                    {
                        case (true) {
                        switch (c[1] == 'm')
                        {
                            case (true) {
                            j = nfin;
                            while (j > 0)
                            {
                                fin_ops[j] = fin_ops[j - 1];
                                j--;
                            };
                            fin_ops[0] = oops[i];
                            nfin++;
                            switch (c[0] == '=')
                            {
                                case (true) {
                                this.sc.clear();
                                this.sc.put(43);
                                this.sc.put_str(c + 1);
                                c = this.sub_dup(this.sc.mem, 0, this.sc.len);
                            }
                                default {};
                            };
                        }
                            default {
                            ro_ptr[nro] = oops[i];
                            nro++;
                        };
                        };
                    }
                        default {
                        ro_ptr[nro] = oops[i];
                        nro++;
                    };
                    };
                    j = nfc;
                    while (j > 0)
                    {
                        fcs[j] = fcs[j - 1];
                        j--;
                    };
                    fcs[0] = c;
                    nfc++;
                    i++;
                };
                this.asmc.clear();
                i = 0;
                while (i < nfc)
                {
                    switch (i > 0)
                    {
                        case (true) { this.asmc.put(44); }
                        default {};
                    };
                    this.asmc.put_str(fcs[i]);
                    i++;
                };
                i = 0;
                while (i < nclob)
                {
                    switch (nfc > 0 | i > 0)
                    {
                        case (true) { this.asmc.put(44); }
                        default {};
                    };
                    this.asmc.put_str(g"~{\0");
                    this.asmc.put_str(clob[i]);
                    this.asmc.put(125);
                    i++;
                };
                i = 0;
                while (i < nfin)
                {
                    itys[i] = fin_ops[i].ty;
                    i++;
                };
                switch (nro)
                {
                    case (0) { rty = this.t_void; }
                    case (1) { rty = ro_ptr[0].ty.elem; }
                    default
                    {
                        i = 0;
                        while (i < nro)
                        {
                            otys[i] = ro_ptr[i].ty.elem;
                            i++;
                        };
                        rty = this.mod.t_struct(otys, nro);
                    };
                };
                ft = this.mod.t_func(rty, itys, nfin, false);

                this.sc.clear();
                this.sc.put_str(g"asm \0");
                switch ((n.flags `& 64) != 0)
                {
                    case (true) { this.sc.put_str(g"sideeffect\0"); }
                    default {};
                };
                this.sc.put_str(g" \"\0");
                this.sc.put_str(this.asmb.mem);
                this.sc.put_str(g"\", \"\0");
                this.sc.put_str(this.asmc.mem);
                this.sc.put_str(g"\"\n\0");
                callee = this.mod.new_value(this.mod.t_ptr(ft), this.sc.mem);
                res = this.mod.call(callee, fin_ops, nfin, (byte*)0);
                switch (nro == 1)
                {
                    case (true) { this.mod.store(res, ro_ptr[0]); }
                    default {
                        switch (nro > 1)
                        {
                            case (true) {
                    i = 0;
                    while (i < nro)
                    {
                        v = this.mod.extractvalue(res, i, (byte*)0);
                        this.mod.store(v, ro_ptr[i]);
                        i++;
                    };
                }
                            default {};
                        };
                    };
                };
                -> res;
            };


            has_prefix(byte* s, byte* p) -> bool
            {
                int i;
                while (p[i] != 0)
                {
                    switch (s[i] != p[i]) { case (true) { -> false; } default
                        {
                            i++;
                        }; };
                };
                -> true;
            };


            tf_type_name(IRType* t) -> byte*
            {
                byte* en;
                switch (t.kind)
                {
                    case (LK.INT)
                    {
                        switch (t.width)
                        {
                            case (1) { -> g"bool\0"; }
                            case (8) { -> g"byte\0"; }
                            case (16) { -> g"int\0"; }
                            case (32) { -> g"int\0"; }
                            case (64) { -> g"long\0"; }
                            default
                            {
                                this.sc.clear();
                                this.sc.put_str(f"data{t.width}\0");
                                -> this.mod.own(this.sc.mem);
                            };
                        };
                    }
                    case (LK.FLOAT) { -> g"float\0"; }
                    case (LK.DOUBLE) { -> g"double\0"; }
                    case (LK.PTR)
                    {
                        switch (t.elem.kind == LK.INT & t.elem.width == 8)
                        {
                            case (true) { -> g"string\0"; }
                            default
                            {
                                switch (t.elem.kind == LK.ISTRUCT)
                                {
                                    case (true) { -> t.elem.name; }
                                    default {};
                                };
                            };
                        };
                    }
                    case (LK.ISTRUCT) { -> t.name; }
                    case (LK.ARRAY)
                    {
                        switch (t.elem.kind == LK.ISTRUCT)
                        {
                            case (true) { en = t.elem.name; }
                            default {
                                switch (t.elem.kind == LK.INT | t.elem.kind == LK.FLOAT | t.elem.kind == LK.DOUBLE)
                                {
                                    case (true) { en = this.tf_type_name(t.elem); }
                                    default {};
                                };
                            };
                        };
                        switch (en == (byte*)0)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                this.sc.clear();
                                this.sc.put_str(f"{en}_arr\0");
                                -> this.mod.own(this.sc.mem);
                            };
                        };
                    }
                    default {};
                };
                -> (byte*)0;
            };



            tf_specialize(Node* n, byte* tn, IRType* sp, TypeSpec* cts) -> IRFunc*
            {
                Node* orig;
                Node* fd;
                Node* p0;
                Node* pc;
                IRFunc* f;
                byte* nm;
                int i;
                this.sc.clear();
                this.sc.put_str(f"__typefunc__{tn}__{n.text}\0");
                orig = (Node*)nm_get(this.tf_ast, this.sc.mem);
                switch (orig == (Node*)0 | cts == (TypeSpec*)0)
                {
                    case (true) { -> (IRFunc*)0; }
                    default
                    {
                        switch (!ts_is_array(cts) | cts.array_size == (Node*)0 | sp.elem.kind == LK.ARRAY)
                        {
                            case (true) { -> (IRFunc*)0; }
                            default
                            {
                                this.sc.clear();
                                this.sc.put_str(f"__typefunc__{tn}_sz{sp.count}__{n.text}\0");
                                nm = this.mod.own(this.sc.mem);
                                f = this.mod.find_function(nm);
                                switch (f != (IRFunc*)0) { case (true) { -> f; } default
                                    {
                                        fd = node_new(NodeKind.FUNCTION_DEF, orig.line, orig.col);
                                        fd.text = nm;
                                        fd.ts = orig.ts;
                                        fd.a = orig.a;
                                        fd.text2 = orig.text3;
                                        fd.flags = orig.flags `| 1024;
                                        p0 = node_new(NodeKind.PARAMETER, orig.line, orig.col);
                                        p0.text = g"_\0";
                                        p0.ts = orig.ts2;
                                        node_push(fd, 0, p0);
                                        while (i < node_count(orig, 0))
                                        {
                                            pc = node_child(orig, 0, i);
                                            node_push(fd, 0, pc);
                                            i++;
                                        };
                                        f = this.declare_function(fd, g"\0");
                                        switch (f == (IRFunc*)0) { case (true) { -> f; } default
                                            {
                                                pv_push(this.tf_pend, (void*)fd);
                                                pv_push(this.tf_pend, (void*)f);
                                                pv_push(this.tf_pend, (void*)cts);
                                                -> f;
                                            }; };
                                    }; };
                            };
                        };
                    };
                };
            };


            x_typefunc(Node* n) -> IRValue*
            {
                Node* o = n.a;
                int argc = node_count(n, 0);
                int i;
                LVar* lv;
                IRValue* objp;
                IRValue* recv;
                IRValue* v;
                IRValue** args;
                IRFunc* f;
                IRType* ft;
                IRType* sp;
                byte* tn;
                byte* om;
                int nm;
                bool spec_arr;
                switch (o.kind == NodeKind.IDENTIFIER)
                {
                    case (true) {
                    lv = this.find_local(o.text);
                    switch (lv == (LVar*)0)
                    {
                        case (true) {
                        this.unsup(n, g"method target not resolved\0");
                        -> (IRValue*)0;
                    }
                        default
                        {
                            objp = lv.ptr;
                        };
                    };
                }
                    default {
                    objp = this.visit(o);
                    switch (this.bad) { case (true) { -> (IRValue*)0; } default {}; };
                };
                };
                switch (objp == (IRValue*)0 | objp.ty.kind != LK.PTR)
                {
                    case (true) {
                    this.unsup(n, g"method target not resolved\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        sp = objp.ty.elem;
                        switch (sp.kind == LK.ISTRUCT | (sp.kind == LK.PTR & sp.elem.kind == LK.ISTRUCT))
                        {
                            case (true) {
                            this.unsup(n, g"method target not resolved\0");
                            -> (IRValue*)0;
                        }
                            default
                            {

                                spec_arr = sp.kind == LK.ARRAY & o.kind == NodeKind.IDENTIFIER;
                                switch (spec_arr)
                                {
                                    case (true) {
                                    this.mod.ia[0] = this.ci32(0);
                                    this.mod.ia[1] = this.ci32(0);
                                    recv = this.mod.gep(objp, this.mod.ia, 2, false, g"typefunc_arr_decay\0");
                                }
                                    default {
                                        switch (o.kind == NodeKind.IDENTIFIER)
                                        {
                                            case (true) { recv = this.mod.load(objp, g"typefunc_recv_load\0"); }
                                            default { recv = objp; };
                                        };
                                    };
                                };
                                switch (recv.ty.kind == LK.PTR & recv.ty.elem.kind == LK.ARRAY & recv.ty.elem.elem.kind == LK.INT & recv.ty.elem.elem.width == 8)
                                {
                                    case (true) {
                                    this.mod.ia[0] = this.ci32(0);
                                    this.mod.ia[1] = this.ci32(0);
                                    recv = this.mod.gep(recv, this.mod.ia, 2, false, g"typefunc_str_decay\0");
                                }
                                    default {};
                                };
                                switch (spec_arr)
                                {
                                    case (true) { tn = this.tf_type_name(sp); }
                                    default { tn = this.tf_type_name(recv.ty); };
                                };
                                switch (tn == (byte*)0)
                                {
                                    case (true) {
                                    this.unsup(n, g"type function receiver type\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        this.sc.clear();
                                        this.sc.put_str(f"__typefunc__{tn}__{n.text}\0");
                                        switch (spec_arr)
                                        {
                                            case (true) { f = this.tf_specialize(n, tn, sp, lv.ts); }
                                            default { f = this.mod.find_function(this.sc.mem); };
                                        };
                                        switch (f == (IRFunc*)0)
                                        {
                                            case (true) {

                                            this.sc.put_str(g"__\0");
                                            nm = 0;
                                            i = 0;
                                            while (i < this.fdefs.count)
                                            {
                                                switch (this.has_prefix(this.fdefs.keys[i], this.sc.mem))
                                                {
                                                    case (true) {
                                                    switch (node_count((Node*)this.fdefs.vals[i], 0) == argc + 1)
                                                    {
                                                        case (true) {
                                                        switch (nm == 0) { case (true) { om = this.fdefs.keys[i]; } default {}; };
                                                        nm++;
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                i++;
                                            };
                                            switch (nm != 1)
                                            {
                                                case (true) {
                                                this.unsup(n, g"method target not resolved\0");
                                                -> (IRValue*)0;
                                            }
                                                default
                                                {
                                                    f = this.mod.find_function(om);
                                                };
                                            };
                                        }
                                            default {};
                                        };
                                        switch (f == (IRFunc*)0)
                                        {
                                            case (true) {
                                            this.unsup(n, g"method target not resolved\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                ft = f.ftype;
                                                args = (IRValue**)fmalloc((u64)(8 * (argc + 1)));
                                                this.keep((void*)args);
                                                args[0] = recv;
                                                i = 0;
                                                while (i < argc)
                                                {
                                                    v = this.visit(node_child(n, 0, i));
                                                    switch (this.bad) { case (true) { -> (IRValue*)0; } default
                                                        {
                                                            switch (v == (IRValue*)0)
                                                            {
                                                                case (true) {
                                                                this.unsup(n, g"void method argument\0");
                                                                -> (IRValue*)0;
                                                            }
                                                                default
                                                                {
                                                                    switch (i + 1 < ft.nitems)
                                                                    {
                                                                        case (true) { v = this.convert_arg(v, ft.items[i + 1], i, n); }
                                                                        default {};
                                                                    };
                                                                    switch (this.bad) { case (true) { -> (IRValue*)0; } default
                                                                        {
                                                                            args[i + 1] = v;
                                                                            i++;
                                                                        }; };
                                                                };
                                                            };
                                                        }; };
                                                };
                                                -> this.mod.call_ex(f.self, args, argc + 1, (byte*)0, f.cconv, false);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            x_method(Node* n) -> IRValue*
            {
                Node* o = n.a;
                int argc = node_count(n, 0);
                int i;
                LVar* lv;
                IRValue* objp;
                IRValue* thisp;
                IRValue* v;
                IRValue** args;
                IRFunc* f;
                IRType* ft;
                IRType* sp;
                byte* vname = (byte*)0;
                switch (n.text3 == (byte*)0)
                {
                    case (true) { -> this.x_typefunc(n); }
                    default
                    {
                        switch (o.kind)
                        {
                            case (NodeKind.IDENTIFIER)
                            {
                                lv = this.find_local(o.text);
                                switch (lv == (LVar*)0)
                                {
                                    case (true) {
                                    this.unsup(n, g"method call on non-local\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        objp = lv.ptr;
                                        vname = o.text;
                                    };
                                };
                            }
                            default
                            {
                                objp = this.visit(o);
                                switch (this.bad)
                                {
                                    case (true) { -> (IRValue*)0; }
                                    default {};
                                };
                            };
                        };
                        switch (objp == (IRValue*)0)
                        {
                            case (true) {
                            this.unsup(n, g"void method receiver\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (objp.ty.kind != LK.PTR)
                                {
                                    case (true) {
                                    this.unsup(n, g"type function call\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        sp = objp.ty.elem;
                                        switch (sp.kind == LK.ISTRUCT)
                                        {
                                            case (true) { thisp = objp; }
                                            default {
                                                switch (sp.kind == LK.PTR & sp.elem.kind == LK.ISTRUCT)
                                                {
                                                    case (true) {
                                            this.sc.clear();
                                            switch (vname != (byte*)0)
                                            {
                                                case (true) {
                                                this.sc.put_str(f"{vname}_load\0");
                                            }
                                                default { this.sc.put_str(g"obj_load\0"); };
                                            };
                                            thisp = this.mod.load(objp, this.sc.mem);
                                        }
                                                    default {
                                            this.unsup(n, g"type function call\0");
                                            -> (IRValue*)0;
                                        };
                                                };
                                            };
                                        };
                                        switch (!this.ifc_check_call(n, thisp.ty.elem.name, n.text))
                                        {
                                            case (true) { -> (IRValue*)0; }
                                            default {};
                                        };
                                        f = this.mod.find_function(n.text3);
                                        switch (f == (IRFunc*)0)
                                        {
                                            case (true) {
                                            this.unsup(n, g"method not declared\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                ft = f.ftype;
                                                args = (IRValue**)fmalloc((u64)(8 * (argc + 1)));
                                                this.keep((void*)args);
                                                args[0] = thisp;
                                                i = 0;
                                                while (i < argc)
                                                {
                                                    switch (!this.ifc_check_pass(node_child(n, 0, i), thisp.ty.elem.name))
                                                    {
                                                        case (true) { -> (IRValue*)0; }
                                                        default {};
                                                    };
                                                    v = this.visit(node_child(n, 0, i));
                                                    switch (this.bad)
                                                    {
                                                        case (true) { -> (IRValue*)0; }
                                                        default
                                                        {
                                                            switch (v == (IRValue*)0)
                                                            {
                                                                case (true) {
                                                                this.unsup(n, g"void method argument\0");
                                                                -> (IRValue*)0;
                                                            }
                                                                default
                                                                {
                                                                    args[i + 1] = v;
                                                                    i++;
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                                i = 0;
                                                while (i < argc & i + 1 < ft.nitems)
                                                {
                                                    v = args[i + 1];
                                                    switch (v.ty.kind == LK.PTR & ft.items[i + 1].kind == LK.PTR)
                                                    {
                                                        case (true) {
                                                        switch (v.ty.elem.kind == LK.ARRAY)
                                                        {
                                                            case (true) {
                                                            switch (lt_eq(v.ty.elem.elem, ft.items[i + 1].elem))
                                                            {
                                                                case (true) {
                                                                this.sc.clear();
                                                                this.sc.put_str(f"marg{i}_decay\0");
                                                                this.mod.ia[0] = this.ci32(0);
                                                                this.mod.ia[1] = this.ci32(0);
                                                                v = this.mod.gep(v, this.mod.ia, 2, false, this.sc.mem);
                                                            }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                    args[i + 1] = this.convert_arg(v, ft.items[i + 1], i, n);
                                                    switch (this.bad)
                                                    {
                                                        case (true) { -> (IRValue*)0; }
                                                        default
                                                        {
                                                            i++;
                                                        };
                                                    };
                                                };
                                                -> this.mod.call_ex(f.self, args, argc + 1, (byte*)0, f.cconv, false);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };


            i1_lit(byte* txt) -> IRValue*
            {
                IRValue* v = this.mod.new_value(this.t_i1, txt);
                v.is_const = true;
                -> v;
            };



            pop_term(IRBlock* b) -> void*
            {
                void* tl = (void*)0;
                switch (b.terminated)
                {
                    case (true) {
                    tl = b.lines.items[b.lines.len - 1];
                    b.lines.len = b.lines.len - 1;
                    b.terminated = false;
                }
                    default {};
                };
                -> tl;
            };


            push_term(IRBlock* b, void* tl) -> void
            {
                switch (tl == (void*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        pv_push(b.lines, tl);
                        b.terminated = true;
                        ->;
                    };
                };
            };


            tern_load(IRValue* v, IRBlock* eb, IRBlock* mb) -> IRValue*
            {
                IRValue* r;
                this.pop_term(eb);
                this.mod.position(this.fn, eb);
                r = this.mod.load(v, g"ternary_load\0");
                this.mod.br(mb);
                this.mod.position(this.fn, mb);
                -> r;
            };


            tern_decay(IRValue* v, IRBlock* eb, IRBlock* mb) -> IRValue*
            {
                IRValue* r = v;
                void* tl;
                switch (v.ty.elem.kind == LK.ARRAY)
                {
                    case (true) {
                    tl = this.pop_term(eb);
                    this.mod.position(this.fn, eb);
                    r = this.mod.cast(g"bitcast\0", v, this.ptr_of(v.ty.elem.elem), g"ternary_decay\0");
                    this.push_term(eb, tl);
                    this.mod.position(this.fn, mb);
                }
                    default {};
                };
                -> r;
            };


            fp_const_value(IRValue* v) -> double
            {
                int i;
                u64 bits;
                u64* bp;
                double d;
                int c;
                byte* t = v.text;
                while (t[i] == 32) { i++; };
                switch (t[i] == '0' & t[i + 1] == 'x')
                {
                    case (true) { i = i + 2; }
                    default {};
                };
                while (t[i] != 0)
                {
                    c = (int)t[i];
                    switch (c >= '0' & c <= '9')
                    {
                        case (true) { bits = bits * (u64)16 + (u64)(c - '0'); }
                        default {
                            switch (c >= 'a' & c <= 'f')
                            {
                                case (true) { bits = bits * (u64)16 + (u64)(c - 'a' + 10); }
                                default {
                                    switch (c >= 'A' & c <= 'F')
                                    {
                                        case (true) { bits = bits * (u64)16 + (u64)(c - 'A' + 10); }
                                        default {};
                                    };
                                };
                            };
                        };
                    };
                    i++;
                };
                bp = (u64*)@d;
                *bp = bits;
                -> d;
            };



            x_struct_lit(Node* n, IRType* ctx) -> IRValue*
            {
                IRType* st = ctx;
                SInfo* si;
                Node** exprs;
                IRValue** vals;
                IRValue* fv;
                IRValue* res;
                IRType* ft;
                Buf cb;
                int nf;
                int np;
                int nn;
                int i;
                int j;
                bool has_non = false;
                switch (st == (IRType*)0)
                {
                    case (true) {
                    switch (n.text == (byte*)0)
                    {
                        case (true) {
                        this.unsup(n, g"struct literal type context\0");
                        -> (IRValue*)0;
                    }
                        default
                        {
                            st = this.resolve_custom(n.text);
                            switch (st == (IRType*)0)
                            {
                                case (true) {
                                this.unsup(n, g"struct literal type\0");
                                -> (IRValue*)0;
                            }
                                default {};
                            };
                        };
                    };
                }
                    default {};
                };
                si = this.sinfo_of(st);
                switch (si == (SInfo*)0)
                {
                    case (true) {
                    this.unsup(n, g"struct literal type\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        nf = si.n;
                        np = node_count(n, 2);
                        nn = node_count(n, 0);
                        switch (np > nf)
                        {
                            case (true) {
                            this.unsup(n, g"too many struct initializers\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                exprs = (Node**)this.zbuf(nf + 1);
                                vals = (IRValue**)this.zbuf(nf + 1);
                                while (i < nn)
                                {
                                    j = 0;
                                    while (j < nf)
                                    {
                                        switch (cstr_eq(si.names[j], node_child(n, 0, i).text))
                                        {
                                            case (true) { break; }
                                            default
                                            {
                                                j++;
                                            };
                                        };
                                    };
                                    switch (j >= nf)
                                    {
                                        case (true) {
                                        this.unsup(n, g"struct literal field\0");
                                        -> (IRValue*)0;
                                    }
                                        default
                                        {
                                            exprs[j] = node_child(n, 1, i);
                                            i++;
                                        };
                                    };
                                };
                                i = 0;
                                while (i < np)
                                {
                                    exprs[i] = node_child(n, 2, i);
                                    i++;
                                };
                                i = 0;
                                while (i < nf)
                                {
                                    switch (exprs[i] != (Node*)0)
                                    {
                                        case (true) {
                                        fv = this.visit(exprs[i]);
                                        switch (this.bad)
                                        {
                                            case (true) { -> (IRValue*)0; }
                                            default
                                            {
                                                switch (fv == (IRValue*)0)
                                                {
                                                    case (true) {
                                                    this.unsup(n, g"void struct field value\0");
                                                    -> (IRValue*)0;
                                                }
                                                    default
                                                    {
                                                        switch (!fv.is_const)
                                                        {
                                                            case (true) { has_non = true; }
                                                            default {};
                                                        };
                                                        vals[i] = fv;
                                                    };
                                                };
                                            };
                                        };
                                    }
                                        default { vals[i] = this.mod.c_null(si.ftys[i]); };
                                    };
                                    i++;
                                };
                                switch (!has_non)
                                {
                                    case (true) {

                                    i = 0;
                                    while (i < nf)
                                    {
                                        fv = vals[i];
                                        ft = si.ftys[i];
                                        switch (!lt_eq(fv.ty, ft))
                                        {
                                            case (true) {
                                            switch (fv.ty.kind == LK.INT & ft.kind == LK.INT)
                                            {
                                                case (true) { vals[i] = this.mod.new_value(ft, fv.text); vals[i].is_const = true; }
                                                default {
                                                    switch ((fv.ty.kind == LK.FLOAT | fv.ty.kind == LK.DOUBLE) & (ft.kind == LK.FLOAT | ft.kind == LK.DOUBLE))
                                                    {
                                                        case (true) {
                                                vals[i] = this.mod.c_fp(ft, this.fp_const_value(fv));
                                            }
                                                        default {};
                                                    };
                                                };
                                            };
                                        }
                                            default {};
                                        };
                                        i++;
                                    };
                                }
                                    default {};
                                };
                                cb.__init();
                                defer cb.__exit();
                                cb.put(123);
                                i = 0;
                                while (i < nf)
                                {
                                    switch (i > 0)
                                    {
                                        case (true) { cb.put_str(g", \0"); }
                                        default {};
                                    };
                                    lt_text(@cb, vals[i].ty);
                                    cb.put(32);
                                    cb.put_str(vals[i].text);
                                    i++;
                                };
                                cb.put(125);
                                switch (!has_non)
                                {
                                    case (true) {
                                    res = this.mod.new_value(st, cb.mem);
                                    res.is_const = true;
                                    -> res;
                                }
                                    default
                                    {

                                        i = 0;
                                        cb.clear();
                                        cb.put(123);
                                        while (i < nf)
                                        {
                                            switch (i > 0)
                                            {
                                                case (true) { cb.put_str(g", \0"); }
                                                default {};
                                            };
                                            fv = this.mod.c_null(si.ftys[i]);
                                            lt_text(@cb, fv.ty);
                                            cb.put(32);
                                            cb.put_str(fv.text);
                                            i++;
                                        };
                                        cb.put(125);
                                        res = this.mod.new_value(st, cb.mem);
                                        res.is_const = true;
                                        i = 0;
                                        while (i < nf)
                                        {
                                            fv = vals[i];
                                            ft = si.ftys[i];
                                            switch (!lt_eq(fv.ty, ft))
                                            {
                                                case (true) {
                                                switch (fv.ty.kind == LK.INT & ft.kind == LK.INT)
                                                {
                                                    case (true) {
                                                    switch (fv.ty.width < ft.width)
                                                    {
                                                        case (true) { fv = this.mod.cast(g"zext\0", fv, ft, (byte*)0); }
                                                        default {
                                                            switch (fv.ty.width > ft.width)
                                                            {
                                                                case (true) { fv = this.mod.cast(g"trunc\0", fv, ft, (byte*)0); }
                                                                default {};
                                                            };
                                                        };
                                                    };
                                                }
                                                    default {
                                                        switch (fv.ty.kind == LK.FLOAT & ft.kind == LK.DOUBLE)
                                                        {
                                                            case (true) { fv = this.mod.cast(g"fpext\0", fv, ft, (byte*)0); }
                                                            default {
                                                                switch (fv.ty.kind == LK.DOUBLE & ft.kind == LK.FLOAT)
                                                                {
                                                                    case (true) { fv = this.mod.cast(g"fptrunc\0", fv, ft, (byte*)0); }
                                                                    default {
                                                                        switch (fv.ty.kind == LK.PTR & fv.ty.elem.kind == LK.ARRAY & ft.kind == LK.PTR)
                                                                        {
                                                                            case (true) {
                                                    switch (ft.elem.kind == LK.INT & ft.elem.width == 8)
                                                    {
                                                        case (true) {
                                                        this.mod.ia[0] = this.ci32(0);
                                                        this.mod.ia[1] = this.ci32(0);
                                                        fv = this.mod.gep(fv, this.mod.ia, 2, true, g"str_gep\0");
                                                    }
                                                        default {};
                                                    };
                                                }
                                                                            default {};
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            }
                                                default {};
                                            };
                                            res = this.mod.insertvalue(res, fv, i, (byte*)0);
                                            i++;
                                        };
                                        -> res;
                                    };
                                };
                            };
                        };
                    };
                };
            };


            x_ternary(Node* n) -> IRValue*
            {
                IRValue* cv;
                IRValue* tv;
                IRValue* fv;
                IRValue* phi;
                IRValue** pv;
                IRBlock** pb;
                IRBlock* tb;
                IRBlock* fb;
                IRBlock* mb;
                IRBlock* te;
                IRBlock* fe;
                void* tl;
                bool tp;
                bool fpp;
                cv = this.cond_value(n.a);
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        tb = this.mod.append_block(this.fn, g"ternary_true\0");
                        fb = this.mod.append_block(this.fn, g"ternary_false\0");
                        mb = this.mod.append_block(this.fn, g"ternary_merge\0");
                        this.mod.cbr(cv, tb, fb);

                        this.mod.position(this.fn, tb);
                        tv = this.visit(n.b);
                        switch (this.bad)
                        {
                            case (true) { -> (IRValue*)0; }
                            default
                            {
                                te = this.mod.cb;
                                switch (!te.terminated)
                                {
                                    case (true) { this.mod.br(mb); }
                                    default {};
                                };

                                this.mod.position(this.fn, fb);
                                fv = this.visit(n.c);
                                switch (this.bad)
                                {
                                    case (true) { -> (IRValue*)0; }
                                    default
                                    {
                                        fe = this.mod.cb;
                                        switch (!fe.terminated)
                                        {
                                            case (true) { this.mod.br(mb); }
                                            default {};
                                        };

                                        this.mod.position(this.fn, mb);
                                        switch (tv == (IRValue*)0 | fv == (IRValue*)0)
                                        {
                                            case (true) {
                                            this.unsup(n, g"void ternary branch\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                switch (!lt_eq(tv.ty, fv.ty))
                                                {
                                                    case (true) {
                                                    tp = tv.ty.kind == LK.PTR;
                                                    fpp = fv.ty.kind == LK.PTR;
                                                    switch (tp & lt_eq(tv.ty.elem, fv.ty))
                                                    {
                                                        case (true) { tv = this.tern_load(tv, te, mb); }
                                                        default {
                                                            switch (fpp & lt_eq(fv.ty.elem, tv.ty))
                                                            {
                                                                case (true) { fv = this.tern_load(fv, fe, mb); }
                                                                default {
                                                                    switch (tp & fpp)
                                                                    {
                                                                        case (true) {
                                                        tv = this.tern_decay(tv, te, mb);
                                                        fv = this.tern_decay(fv, fe, mb);
                                                        switch (!lt_eq(tv.ty, fv.ty))
                                                        {
                                                            case (true) {
                                                            switch (!(tv.ty.elem.kind == LK.ISTRUCT & fv.ty.elem.kind == LK.ISTRUCT & cstr_eq(tv.ty.elem.name, fv.ty.elem.name)))
                                                            {
                                                                case (true) {
                                                                tl = this.pop_term(fe);
                                                                this.mod.position(this.fn, fe);
                                                                fv = this.mod.cast(g"bitcast\0", fv, tv.ty, g"ternary_cast\0");
                                                                this.push_term(fe, tl);
                                                            }
                                                                default {};
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                        this.mod.position(this.fn, mb);
                                                    }
                                                                        default {
                                                                            switch (tp & (tv.ty.elem.kind == LK.INT | tv.ty.elem.kind == LK.FLOAT | tv.ty.elem.kind == LK.DOUBLE))
                                                                            {
                                                                                case (true) {
                                                        tv = this.tern_load(tv, te, mb);
                                                    }
                                                                                default {
                                                                                    switch (fpp & (fv.ty.elem.kind == LK.INT | fv.ty.elem.kind == LK.FLOAT | fv.ty.elem.kind == LK.DOUBLE))
                                                                                    {
                                                                                        case (true) {
                                                        fv = this.tern_load(fv, fe, mb);
                                                    }
                                                                                        default {
                                                                                            switch (tv.ty.kind == LK.INT & fv.ty.kind == LK.INT)
                                                                                            {
                                                                                                case (true) {
                                                        switch (tv.ty.width < fv.ty.width)
                                                        {
                                                            case (true) {
                                                            this.pop_term(te);
                                                            this.mod.position(this.fn, te);
                                                            tv = this.mod.cast(g"sext\0", tv, fv.ty, (byte*)0);
                                                            this.mod.br(mb);
                                                            this.mod.position(this.fn, mb);
                                                        }
                                                            default {
                                                                switch (fv.ty.width < tv.ty.width)
                                                                {
                                                                    case (true) {
                                                            this.pop_term(fe);
                                                            this.mod.position(this.fn, fe);
                                                            fv = this.mod.cast(g"sext\0", fv, tv.ty, (byte*)0);
                                                            this.mod.br(mb);
                                                            this.mod.position(this.fn, mb);
                                                        }
                                                                    default {};
                                                                };
                                                            };
                                                        };
                                                    }
                                                                                                default {
                                                        this.unsup(n, g"ternary incompatible branch types\0");
                                                        -> (IRValue*)0;
                                                    };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                }
                                                    default {};
                                                };
                                                pv = (IRValue**)this.zbuf(2);
                                                pb = (IRBlock**)this.zbuf(2);
                                                pv[0] = tv;
                                                pv[1] = fv;
                                                pb[0] = te;
                                                pb[1] = fe;
                                                phi = this.mod.phi(tv.ty, pv, pb, 2, g"ternary_result\0");
                                                -> phi;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            x_array_literal(Node* n) -> IRValue*
            {
                int c = node_count(n, 0);
                int i;
                bool allc = true;
                IRValue** ev;
                IRValue* v;
                IRValue* arr;
                IRValue* ep;
                IRType* et;
                IRType* aty;
                Node* sn;
                int sl;
                int k;
                i64 pk;
                int mw;
                switch (c == 0 | this.fn == (IRFunc*)0)
                {
                    case (true) {
                    this.unsup(n, g"array literal\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        ev = (IRValue**)fmalloc((u64)c * (u64)((sizeof(IRValue*) + 7) / 8));
                        this.keep((void*)ev);
                        while (i < c)
                        {
                            switch (node_child(n, 0, i).kind == NodeKind.STRING_LITERAL)
                            {
                                case (true) {
                                sn = node_child(n, 0, i);
                                sl = (int)sn.ival;
                                switch (sl <= 0)
                                {
                                    case (true) {
                                    sl = 0;
                                    switch (sn.text != (byte*)0)
                                    {
                                        case (true) { while (sn.text[sl] != 0) { sl++; }; }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (sl > 4) { case (true) { sl = 4; } default {}; };
                                pk = (i64)0;
                                k = 0;
                                while (k < sl)
                                {
                                    pk = pk + ((i64)(int)sn.text[k] * (i64)(1 << (k * 8)));
                                    k++;
                                };
                                v = this.mod.c_int(this.t_i32, pk);
                            }
                                default {
                                    v = this.visit(node_child(n, 0, i));
                                    switch (this.bad)
                                    {
                                        case (true) { -> (IRValue*)0; }
                                        default {};
                                    };
                                };
                            };
                            switch (v == (IRValue*)0)
                            {
                                case (true) {
                                this.unsup(n, g"void array element\0");
                                -> (IRValue*)0;
                            }
                                default
                                {
                                    ev[i] = v;
                                    switch (!v.is_const) { case (true) { allc = false; } default {}; };
                                    i++;
                                };
                            };
                        };
                        et = ev[0].ty;
                        mw = 0;
                        i = 0;
                        while (i < c)
                        {
                            switch (ev[i].ty.kind != LK.INT)
                            {
                                case (true) { mw = -1; }
                                default {};
                            };
                            switch (mw >= 0 & ev[i].ty.width > mw) { case (true) { mw = ev[i].ty.width; } default {}; };
                            i++;
                        };
                        switch (mw > 0)
                        {
                            case (true) {
                            et = this.int_ty(mw);
                            i = 0;
                            allc = true;
                            while (i < c)
                            {
                                ev[i] = this.int_resize(ev[i], et, this.is_uns(ev[i]));
                                switch (!ev[i].is_const) { case (true) { allc = false; } default {}; };
                                i++;
                            };
                        }
                            default {};
                        };
                        i = 0;
                        while (i < c)
                        {
                            switch (!lt_eq(ev[i].ty, et))
                            {
                                case (true) {
                                this.unsup(n, g"mixed array literal element types\0");
                                -> (IRValue*)0;
                            }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                        aty = this.mod.t_array(et, c);
                        switch (allc)
                        {
                            case (true) {
                            arr = this.mod.alloca_here(aty, g"array_literal_const\0");
                            this.mod.store(this.mod.c_array(aty, ev, c), arr);
                            -> arr;
                        }
                            default
                            {
                                arr = this.mod.alloca_here(aty, g"array_literal\0");
                                i = 0;
                                while (i < c)
                                {
                                    this.mod.ia[0] = this.ci32(0);
                                    this.mod.ia[1] = this.ci32(i);
                                    this.sc.clear();
                                    this.sc.put_str(f"elem_{i}\0");
                                    ep = this.mod.gep(arr, this.mod.ia, 2, true, this.sc.mem);
                                    this.mod.store(ev[i], ep);
                                    i++;
                                };
                                -> arr;
                            };
                        };
                    };
                };
            };

            x_ifexpr(Node* n) -> IRValue*
            {
                IRValue* cv;
                IRValue* tv;
                IRValue* fv;
                IRValue* phi;
                IRValue** pv;
                IRBlock** pb;
                IRBlock* tb;
                IRBlock* fb;
                IRBlock* mb;
                IRBlock* te;
                IRBlock* fe;
        bool isstr = false;
                cv = this.cond_value(n.b);
                switch (this.bad) { case (true) { -> (IRValue*)0; } default
                    {
                        tb = this.mod.append_block(this.fn, g"ifexpr_value\0");
                        fb = this.mod.append_block(this.fn, g"ifexpr_else\0");
                        mb = this.mod.append_block(this.fn, g"ifexpr_merge\0");
                        this.mod.cbr(cv, tb, fb);

                        this.mod.position(this.fn, tb);
                        tv = this.visit(n.a);
                        switch (this.bad) { case (true) { -> (IRValue*)0; } default
                            {
                                te = this.mod.cb;
                                switch (!te.terminated) { case (true) { this.mod.br(mb); } default {}; };

                                switch (tv == (IRValue*)0 & n.c == (Node*)0)
                                {
                                    case (true) {
                                    this.mod.position(this.fn, fb);
                                    switch (!this.mod.cb.terminated) { case (true) { this.mod.br(mb); } default {}; };
                                    this.mod.position(this.fn, mb);
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        switch (tv == (IRValue*)0)
                                        {
                                            case (true) {
                                            this.unsup(n, g"void if-expression value\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                this.mod.position(this.fn, fb);
                                                switch (n.c == (Node*)0)
                                                {
                                                    case (true) { fv = this.mod.c_int(tv.ty, (i64)0); }
                                                    default {
                                                        switch (n.c.kind == NodeKind.NO_INIT)
                                                        {
                                                            case (true) { fv = this.mod.c_undef(tv.ty); }
                                                            default {
                                                                fv = this.visit(n.c);
                                                                switch (this.bad) { case (true) { -> (IRValue*)0; } default {}; };
                                                            };
                                                        };
                                                    };
                                                };
                                                switch (fv == (IRValue*)0)
                                                {
                                                    case (true) {
                                                    this.unsup(n, g"void if-expression else\0");
                                                    -> (IRValue*)0;
                                                }
                                                    default
                                                    {
                                                        fe = this.mod.cb;
                                                        switch (!fe.terminated) { case (true) { this.mod.br(mb); } default {}; };

                                                        this.mod.position(this.fn, mb);
                                                        switch (!lt_eq(tv.ty, fv.ty))
                                                        {
                                                            case (true) {
                                                            switch (tv.ty.kind == LK.INT & fv.ty.kind == LK.INT)
                                                            {
                                                                case (true) {
                                                                switch (tv.ty.width < fv.ty.width)
                                                                {
                                                                    case (true) {
                                                                    this.pop_term(te);
                                                                    this.mod.position(this.fn, te);
                                                                    tv = this.mod.cast(g"sext\0", tv, fv.ty, (byte*)0);
                                                                    this.mod.br(mb);
                                                                    this.mod.position(this.fn, mb);
                                                                }
                                                                    default {
                                                                        this.pop_term(fe);
                                                                        this.mod.position(this.fn, fe);
                                                                        fv = this.mod.cast(g"sext\0", fv, tv.ty, (byte*)0);
                                                                        this.mod.br(mb);
                                                                        this.mod.position(this.fn, mb);
                                                                    };
                                                                };
                                                            }
                                                                default {
                                                                switch (tv.ty.kind == LK.PTR & fv.ty.kind == LK.PTR)
                                                                {
                                                                    case (true) {


                                                                        isstr = tv.ty.elem.kind == LK.ARRAY & fv.ty.elem.kind == LK.ARRAY;
                                                                        switch (isstr)
                                                                        {
                                                                            case (true) {
                                                                                isstr = tv.ty.elem.elem.kind == LK.INT & fv.ty.elem.elem.kind == LK.INT;
                                                                            }
                                                                            default {};
                                                                        };
                                                                        switch (isstr)
                                                                        {
                                                                            case (true) { isstr = tv.ty.elem.elem.width == 8 & fv.ty.elem.elem.width == 8; }
                                                                            default {};
                                                                        };
                                                                        switch (tv.ty.elem.kind == LK.ARRAY)
                                                                        {
                                                                            case (true) {
                                                                                this.pop_term(te);
                                                                                this.mod.position(this.fn, te);
                                                                                tv = this.mod.cast(g"bitcast\0", tv, this.mod.t_ptr(tv.ty.elem.elem), g"ifexpr_decay\0");
                                                                                this.mod.br(mb);
                                                                                this.mod.position(this.fn, mb);
                                                                            }
                                                                            default {};
                                                                        };
                                                                        switch (fv.ty.elem.kind == LK.ARRAY)
                                                                        {
                                                                            case (true) {
                                                                                this.pop_term(fe);
                                                                                this.mod.position(this.fn, fe);
                                                                                fv = this.mod.cast(g"bitcast\0", fv, this.mod.t_ptr(fv.ty.elem.elem), g"ifexpr_decay\0");
                                                                                this.mod.br(mb);
                                                                                this.mod.position(this.fn, mb);
                                                                            }
                                                                            default {};
                                                                        };
                                                                        switch (!lt_eq(tv.ty, fv.ty))
                                                                        {
                                                                            case (true) {
                                                                                this.pop_term(fe);
                                                                                this.mod.position(this.fn, fe);
                                                                                fv = this.mod.cast(g"bitcast\0", fv, tv.ty, g"ifexpr_cast\0");
                                                                                this.mod.br(mb);
                                                                                this.mod.position(this.fn, mb);
                                                                            }
                                                                            default {};
                                                                        };
                                                                    }
                                                                    default {
                                                                        this.unsup(n, g"if-expression incompatible branch types\0");
                                                                        -> (IRValue*)0;
                                                                    };
                                                                };
                                                            };
                                                            };
                                                        }
                                                            default {};
                                                        };
                                                        pv = (IRValue**)this.zbuf(2);
                                                        pb = (IRBlock**)this.zbuf(2);
                                                        pv[0] = tv;
                                                        pv[1] = fv;
                                                        pb[0] = te;
                                                        pb[1] = fe;
                                                        phi = this.mod.phi(tv.ty, pv, pb, 2, g"ifexpr_result\0");
                                                        switch (isstr)
                                                        {
                                                            case (true) { phi.flags = phi.flags `| 32; }
                                                            default {};
                                                        };
                                                        -> phi;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            }; };
                    }; };
            };






            x_rangeassign(Node* n) -> IRValue*
            {
                IRValue* arr = this.visit(n.a);
                IRValue* sv;
                IRValue* ev;
                IRValue* fv;
                IRValue* tmp;
                IRValue* kp;
                IRValue* kv;
                IRValue* cnt;
                IRValue* cmp;
                IRValue* sp;
                IRValue* dp;
                IRValue* el;
                IRValue* di;
                IRType* et;
                IRBlock* cb;
                IRBlock* bb;
                IRBlock* eb;
                bool arr2d = false;
                bool src2d = false;
                bool valform = n.ival == (i64)1;
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                switch (arr == (IRValue*)0)
                {
                    case (true) {
                        this.unsup(n, g"void range assignment target\0");
                        -> (IRValue*)0;
                    }
                    default {};
                };
                switch (this.needs_ptr_load(arr))
                {
                    case (true) { arr = this.mod.load(arr, g"ra_ptr_loaded\0"); }
                    default {};
                };
                switch (arr.ty.kind != LK.PTR)
                {
                    case (true) {
                        this.unsup(n, g"range assignment target type\0");
                        -> (IRValue*)0;
                    }
                    default {};
                };
                arr2d = arr.ty.elem.kind == LK.ARRAY;
                et = arr.ty.elem;
                switch (arr2d)
                {
                    case (true) { et = arr.ty.elem.elem; }
                    default {};
                };
                sv = this.visit(n.b);
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                ev = this.visit(n.c);
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                fv = this.visit(n.d);
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                switch (sv == (IRValue*)0 | ev == (IRValue*)0 | fv == (IRValue*)0)
                {
                    case (true) {
                        this.unsup(n, g"void range assignment operand\0");
                        -> (IRValue*)0;
                    }
                    default {};
                };
                sv = this.idx_i32(sv);
                ev = this.idx_i32(ev);

                switch (valform)
                {
                    case (true) {

                        switch (fv.ty.kind == LK.ARRAY)
                        {
                            case (true) {
                                tmp = this.mod.alloca(fv.ty, g"rav_tmp\0");
                                this.mod.store(fv, tmp);
                                fv = tmp;
                            }
                            default {};
                        };
                        switch (fv.ty.kind != LK.PTR)
                        {
                            case (true) {
                                this.unsup(n, g"range assignment value must be an array\0");
                                -> (IRValue*)0;
                            }
                            default {};
                        };
                        src2d = fv.ty.elem.kind == LK.ARRAY;
                        tmp = (IRValue*)0;
                        switch (src2d)
                        {
                            case (true) {
                                switch (!lt_eq(fv.ty.elem.elem, et))
                                {
                                    case (true) {
                                        this.unsup(n, g"range assignment element type mismatch\0");
                                        -> (IRValue*)0;
                                    }
                                    default {};
                                };
                            }
                            default {
                                switch (!lt_eq(fv.ty.elem, et))
                                {
                                    case (true) {
                                        this.unsup(n, g"range assignment element type mismatch\0");
                                        -> (IRValue*)0;
                                    }
                                    default {};
                                };
                            };
                        };
                    }
                    default {

                        switch (!lt_eq(fv.ty, et) & fv.ty.kind == LK.INT & et.kind == LK.INT)
                        {
                            case (true) {
                                switch (fv.ty.width > et.width)
                                {
                                    case (true) { fv = this.mod.cast(g"trunc\0", fv, et, g"ra_fill_trunc\0"); }
                                    default { fv = this.mod.cast(g"zext\0", fv, et, g"ra_fill_ext\0"); };
                                };
                            }
                            default {};
                        };
                    };
                };

                cb = this.mod.append_block(this.fn, g"ra.cond\0");
                bb = this.mod.append_block(this.fn, g"ra.body\0");
                eb = this.mod.append_block(this.fn, g"ra.end\0");
                kp = this.mod.alloca(this.t_i32, g"ra.k\0");
                this.mod.store(this.ci32(0), kp);
                cnt = this.mod.binop(g"sub\0", ev, sv, g"ra.span\0");
                this.mod.br(cb);

                this.mod.position(this.fn, cb);
                kv = this.mod.load(kp, g"ra.kv\0");
                cmp = this.mod.icmp(g"sle\0", kv, cnt, g"ra.cmp\0");
                this.mod.cbr(cmp, bb, eb);

                this.mod.position(this.fn, bb);
                kv = this.mod.load(kp, g"ra.kb\0");
                di = this.mod.binop(g"add\0", sv, kv, g"ra.dstidx\0");
                switch (arr2d)
                {
                    case (true) {
                        this.mod.ia[0] = this.ci32(0);
                        this.mod.ia[1] = di;
                        dp = this.mod.gep(arr, this.mod.ia, 2, true, g"ra.dst\0");
                    }
                    default { dp = this.mod.gep_ptr(arr, di, true, g"ra.dst\0"); };
                };
                switch (valform)
                {
                    case (true) {
                        switch (src2d)
                        {
                            case (true) {
                                this.mod.ia[0] = this.ci32(0);
                                this.mod.ia[1] = kv;
                                sp = this.mod.gep(fv, this.mod.ia, 2, true, g"ra.src\0");
                            }
                            default { sp = this.mod.gep_ptr(fv, kv, true, g"ra.src\0"); };
                        };
                        el = this.mod.load(sp, g"ra.val\0");
                        this.mod.store(el, dp);
                    }
                    default { this.mod.store(fv, dp); };
                };
                this.mod.store(this.mod.binop(g"add\0", kv, this.ci32(1), g"ra.next\0"), kp);
                this.mod.br(cb);

                this.mod.position(this.fn, eb);
                -> (IRValue*)0;
            };

            x_ternassign(Node* n) -> IRValue*
            {
                LVar* lv;
                IRValue* cur;
                IRValue* iz;
                IRValue* nv;
                IRBlock* tb;
                IRBlock* mb;
                switch (n.a.kind != NodeKind.IDENTIFIER)
                {
                    case (true) {
                    this.unsup(n, g"ternary assign target\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        lv = this.find_local(n.a.text);
                        switch (lv == (LVar*)0)
                        {
                            case (true) {
                            this.unsup(n, g"ternary assign target not local\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                cur = this.mod.load(lv.ptr, g"ternary_assign_cur\0");
                                iz = this.mod.icmp(g"eq\0", cur, this.mod.c_null(cur.ty), g"ternary_assign_cmp\0");
                                tb = this.mod.append_block(this.fn, g"ternary_assign_then\0");
                                mb = this.mod.append_block(this.fn, g"ternary_assign_merge\0");
                                this.mod.cbr(iz, tb, mb);
                                this.mod.position(this.fn, tb);
                                nv = this.visit(n.b);
                                switch (this.bad) { case (true) { -> (IRValue*)0; } default
                                    {
                                        switch (nv == (IRValue*)0)
                                        {
                                            case (true) {
                                            this.unsup(n, g"ternary assign void value\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                switch (!lt_eq(nv.ty, cur.ty) & nv.ty.kind == LK.INT & cur.ty.kind == LK.INT)
                                                {
                                                    case (true) {
                                                    switch (nv.ty.width > cur.ty.width)
                                                    {
                                                        case (true) { nv = this.mod.cast(g"trunc\0", nv, cur.ty, g"ternary_assign_trunc\0"); }
                                                        default { nv = this.mod.cast(g"sext\0", nv, cur.ty, g"ternary_assign_ext\0"); };
                                                    };
                                                }
                                                    default {};
                                                };
                                                this.mod.store(nv, lv.ptr);
                                                this.mod.br(mb);
                                                this.mod.position(this.fn, mb);
                                                -> (IRValue*)0;
                                            };
                                        };
                                    }; };
                            };
                        };
                    };
                };
            };

            x_coalesce(Node* n) -> IRValue*
            {
                IRValue* lv;
                IRValue* rv;
                IRValue* isn;
                IRValue* phi;
                IRValue** pv;
                IRBlock** pb;
                IRBlock* rb;
                IRBlock* mb;
                IRBlock* lb;
                IRBlock* re;
                lv = this.visit(n.a);
                switch (this.bad) { case (true) { -> (IRValue*)0; } default
                    {
                        switch (lv == (IRValue*)0)
                        {
                            case (true) {
                            this.unsup(n, g"null coalesce void operand\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (lv.ty.kind == LK.PTR)
                                {
                                    case (true) { isn = this.mod.icmp(g"eq\0", lv, this.mod.c_null(lv.ty), g"is_null\0"); }
                                    default {
                                        switch (lv.ty.kind == LK.INT)
                                        {
                                            case (true) { isn = this.mod.icmp(g"eq\0", lv, this.mod.c_int(lv.ty, (i64)0), g"is_zero\0"); }
                                            default {
                                                this.unsup(n, g"null coalesce operand type\0");
                                                -> (IRValue*)0;
                                            };
                                        };
                                    };
                                };
                                rb = this.mod.append_block(this.fn, g"coalesce_right\0");
                                mb = this.mod.append_block(this.fn, g"coalesce_merge\0");
                                lb = this.mod.cb;
                                this.mod.cbr(isn, rb, mb);
                                this.mod.position(this.fn, rb);
                                rv = this.visit(n.b);
                                switch (this.bad) { case (true) { -> (IRValue*)0; } default
                                    {
                                        re = this.mod.cb;
                                        this.mod.br(mb);
                                        this.mod.position(this.fn, mb);
                                        switch (rv == (IRValue*)0)
                                        {
                                            case (true) {
                                            this.unsup(n, g"null coalesce void operand\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                switch (!lt_eq(lv.ty, rv.ty))
                                                {
                                                    case (true) {
                                                    this.unsup(n, g"null coalesce operand types differ\0");
                                                    -> (IRValue*)0;
                                                }
                                                    default
                                                    {
                                                        pv = (IRValue**)this.zbuf(2);
                                                        pb = (IRBlock**)this.zbuf(2);
                                                        pv[0] = lv;
                                                        pv[1] = rv;
                                                        pb[0] = lb;
                                                        pb[1] = re;
                                                        phi = this.mod.phi(lv.ty, pv, pb, 2, g"coalesce_result\0");
                                                        -> phi;
                                                    };
                                                };
                                            };
                                        };
                                    }; };
                            };
                        };
                    }; };
            };


            x_fpdecl(Node* n) -> IRValue*
            {
                IRType* pt = this.lower(n.ts, false, n.line);
                IRValue* al;
                IRValue* iv;
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        al = this.mod.alloca_here(pt, n.text);
                        this.define_var(n.text, al, (TypeSpec*)0);
                        switch (n.a != (Node*)0)
                        {
                            case (true) {
                            iv = this.visit(n.a);
                            switch (this.bad)
                            {
                                case (true) { -> (IRValue*)0; }
                                default
                                {
                                    switch (iv == (IRValue*)0)
                                    {
                                        case (true) {
                                        this.unsup(n, g"void function pointer initializer\0");
                                        -> (IRValue*)0;
                                    }
                                        default
                                        {
                                            switch (iv.ty.kind == LK.PTR & iv.ty.elem.kind == LK.FUNC & iv.text[0] == '@')
                                            {
                                                case (true) {
                                                iv = this.mod.cast(g"ptrtoint\0", iv, this.t_i64, (byte*)0);
                                                iv = this.mod.cast(g"inttoptr\0", iv, pt, (byte*)0);
                                            }
                                                default {
                                                    switch (iv.ty.kind == LK.INT)
                                                    {
                                                        case (true) {
                                                        switch (iv.ty.width != 64)
                                                        {
                                                            case (true) { iv = this.mod.cast(g"zext\0", iv, this.t_i64, g"fp_addr_ext\0"); }
                                                            default {};
                                                        };
                                                        iv = this.mod.cast(g"inttoptr\0", iv, pt, g"fp_from_int\0");
                                                    }
                                                        default {
                                                            switch (iv.ty.kind == LK.PTR & !lt_eq(iv.ty, pt))
                                                            {
                                                                case (true) { iv = this.mod.cast(g"bitcast\0", iv, pt, (byte*)0); }
                                                                default {};
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                            this.mod.store(iv, al);
                                        };
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        -> al;
                    };
                };
            };


            x_in_bits(Node* n, IRValue* nd) -> IRValue*
            {
                IRValue* hy = this.visit(n.b);
                IRValue* nv = nd;
                IRValue* pos_ptr;
                IRValue* pos;
                IRValue* pos2;
                IRValue* done;
                IRValue* ph;
                IRValue* sh;
                IRValue* win;
                IRValue* hit;
                IRValue* res;
                IRValue** pv;
                IRBlock** pb;
                IRBlock* fb;
                IRBlock* nb;
                IRBlock* mb;
                IRBlock* cb;
                IRBlock* bb;
                IRType* ht;
                int hw;
                int nw;
                u64 mk;
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        switch (hy == (IRValue*)0 | hy.ty.kind != LK.INT)
                        {
                            case (true) {
                            this.unsup(n, g"in: scalar needle haystack\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                ht = hy.ty;
                                hw = ht.width;
                                nw = nd.ty.width;
                                switch (nw > hw | nw > 63)
                                {
                                    case (true) {
                                    this.unsup(n, g"in: needle wider than haystack\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        switch (nw < hw) { case (true) { nv = this.mod.cast(g"zext\0", nd, ht, (byte*)0); } default {}; };
                                        mk = ((u64)1 << (u64)nw) - (u64)1;
                                        fb = this.mod.append_block(this.fn, g"in.found\0");
                                        nb = this.mod.append_block(this.fn, g"in.notfound\0");
                                        mb = this.mod.append_block(this.fn, g"in.merge\0");
                                        pos_ptr = this.mod.alloca_here(this.t_i32, g"in.pos\0");
                                        this.mod.store(this.mod.c_int(this.t_i32, (i64)0), pos_ptr);
                                        cb = this.mod.append_block(this.fn, g"in.bit.cond\0");
                                        bb = this.mod.append_block(this.fn, g"in.bit.body\0");
                                        this.mod.br(cb);

                                        this.mod.position(this.fn, cb);
                                        pos = this.mod.load(pos_ptr, g"in.pos.v\0");
                                        done = this.mod.icmp(g"eq\0", pos, this.mod.c_int(this.t_i32, (i64)(hw - nw + 1)), g"in.bit.done\0");
                                        this.mod.cbr(done, nb, bb);

                                        this.mod.position(this.fn, bb);
                                        pos2 = this.mod.load(pos_ptr, g"in.pos2\0");
                                        ph = pos2;
                                        switch (hw < 32) { case (true) { ph = this.mod.cast(g"trunc\0", pos2, ht, g"in.pos.hw\0"); } default {}; };
                                        switch (hw > 32) { case (true) { ph = this.mod.cast(g"zext\0", pos2, ht, g"in.pos.hw\0"); } default {}; };
                                        sh = this.mod.binop(g"lshr\0", hy, ph, g"in.shifted\0");
                                        win = this.mod.binop(g"and\0", sh, this.mod.c_u64(ht, mk), g"in.window\0");
                                        hit = this.mod.icmp(g"eq\0", win, nv, g"in.hit\0");
                                        this.mod.store(this.mod.binop(g"add\0", pos2, this.mod.c_int(this.t_i32, (i64)1), (byte*)0), pos_ptr);
                                        this.mod.cbr(hit, fb, cb);

                                        this.mod.position(this.fn, fb);
                                        this.mod.br(mb);
                                        this.mod.position(this.fn, nb);
                                        this.mod.br(mb);
                                        this.mod.position(this.fn, mb);
                                        pv = (IRValue**)this.zbuf(2);
                                        pb = (IRBlock**)this.zbuf(2);
                                        pv[0] = this.i1_lit(g"1\0");
                                        pv[1] = this.i1_lit(g"0\0");
                                        pb[0] = fb;
                                        pb[1] = nb;
                                        res = this.mod.phi(this.t_i1, pv, pb, 2, g"in.result\0");
                                        -> res;
                                    };
                                };
                            };
                        };
                    };
                };
            };



            in_decay(IRValue* p, void** sl) -> IRValue*
            {
                IRValue* d;
                switch (p.ty.kind != LK.PTR)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        switch (p.ty.elem.kind == LK.ARRAY)
                        {
                            case (true) {
                            this.mod.ia[0] = this.ci32(0);
                            this.mod.ia[1] = this.ci32(0);
                            d = this.mod.gep(p, this.mod.ia, 2, false, g"decay.ptr\0");
                            sl[0] = (void*)p.ty.elem.elem;
                            sl[1] = (void*)((u64)p.ty.elem.count + (u64)1);
                            -> d;
                        }
                            default
                            {
                                switch (p.ty.elem.kind == LK.INT)
                                {
                                    case (true) {
                                    sl[0] = (void*)p.ty.elem;
                                    sl[1] = (void*)(u64)0;
                                    -> p;
                                }
                                    default
                                    {
                                        -> (IRValue*)0;
                                    };
                                };
                            };
                        };
                    };
                };
            };



            x_in_seq(Node* n, IRValue* nd, IRValue* hy0) -> IRValue*
            {
                IRType* ne_t;
                IRType* he_t;
                int ncount = -1;
                int hcount = -1;
                IRValue* np;
                IRValue* hp;
                IRValue* hy = hy0;
                IRValue* i0 = this.mod.c_int(this.t_i32, (i64)0);
                IRValue* i1v = this.mod.c_int(this.t_i32, (i64)1);
                IRValue* oidx;
                IRValue* oi;
                IRValue* oi2;
                IRValue* oi3;
                IRValue* nidx;
                IRValue* hidx;
                IRValue* ni;
                IRValue* ni2;
                IRValue* hi2;
                IRValue* t1;
                IRValue* t2;
                IRValue* hel;
                IRValue* nel;
                IRValue* oob;
                IRValue* nev;
                IRValue* mm;
                IRValue* res;
                IRValue** pv;
                IRBlock** pb;
                IRBlock* found_b;
                IRBlock* nf_b;
                IRBlock* merge_b;
                IRBlock* oc_b;
                IRBlock* ob_b;
                IRBlock* ic_b;
                IRBlock* ib_b;
                IRBlock* if_b;
                bool nul_h;
                bool nul_n;
                void** sl;
                sl = this.zbuf(2);
                np = this.in_decay(nd, sl);
                switch (np == (IRValue*)0)
                {
                    case (true) {
                    this.unsup(n, g"in: needle type\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        ne_t = (IRType*)sl[0];
                        ncount = (int)((u64)sl[1]) - 1;
                        switch (hy == (IRValue*)0)
                        {
                            case (true) {
                            hy = this.visit(n.b);
                            switch (this.bad)
                            {
                                case (true) { -> (IRValue*)0; }
                                default {};
                            };
                        }
                            default {};
                        };
                        sl = this.zbuf(2);
                        hp = this.in_decay(hy, sl);
                        switch (hp == (IRValue*)0)
                        {
                            case (true) {
                            this.unsup(n, g"in: haystack type\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                he_t = (IRType*)sl[0];
                                hcount = (int)((u64)sl[1]) - 1;
                                nul_h = hcount < 0 & he_t.width == 8;
                                switch (hcount < 0 & !nul_h)
                                {
                                    case (true) {
                                    this.unsup(n, g"in: haystack size\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        switch (ne_t.width == 8) { case (true) { ncount = -1; } default {}; };
                                        nul_n = ncount < 0 & ne_t.width == 8;
                                        switch (ncount < 0 & !nul_n)
                                        {
                                            case (true) {
                                            this.unsup(n, g"in: needle size\0");
                                            -> (IRValue*)0;
                                        }
                                            default
                                            {
                                                found_b = this.mod.append_block(this.fn, g"in.found\0");
                                                nf_b = this.mod.append_block(this.fn, g"in.notfound\0");
                                                merge_b = this.mod.append_block(this.fn, g"in.merge\0");
                                                oc_b = this.mod.append_block(this.fn, g"in.outer.cond\0");
                                                ob_b = this.mod.append_block(this.fn, g"in.outer.body\0");
                                                ic_b = this.mod.append_block(this.fn, g"in.inner.cond\0");
                                                ib_b = this.mod.append_block(this.fn, g"in.inner.body\0");
                                                if_b = this.mod.append_block(this.fn, g"in.inner.fail\0");
                                                oidx = this.mod.alloca_here(this.t_i32, g"in.outer.idx\0");
                                                this.mod.store(i0, oidx);
                                                this.mod.br(oc_b);
                                                this.mod.position(this.fn, oc_b);
                                                oi = this.mod.load(oidx, g"o.idx\0");
                                                switch (nul_h)
                                                {
                                                    case (true) {
                                                    t1 = this.mod.gep_ptr(hp, oi, false, g"hay.ep\0");
                                                    t2 = this.mod.load(t1, g"hay.ch\0");
                                                    t1 = this.mod.icmp(g"eq\0", t2, this.mod.c_int(he_t, (i64)0), g"hay.end\0");
                                                    this.mod.cbr(t1, nf_b, ob_b);
                                                }
                                                    default {
                                                    t1 = this.mod.icmp(g"eq\0", oi, this.mod.c_int(this.t_i32, (i64)hcount), g"hay.done\0");
                                                    this.mod.cbr(t1, nf_b, ob_b);
                                                };
                                                };
                                                this.mod.position(this.fn, ob_b);
                                                nidx = this.mod.alloca_here(this.t_i32, g"in.ndl.idx\0");
                                                this.mod.store(i0, nidx);
                                                hidx = this.mod.alloca_here(this.t_i32, g"in.hay.idx\0");
                                                oi2 = this.mod.load(oidx, g"o.idx2\0");
                                                this.mod.store(oi2, hidx);
                                                this.mod.br(ic_b);
                                                this.mod.position(this.fn, ic_b);
                                                ni = this.mod.load(nidx, g"n.idx\0");
                                                switch (nul_n)
                                                {
                                                    case (true) {
                                                    t1 = this.mod.gep_ptr(np, ni, false, g"ndl.ep\0");
                                                    t2 = this.mod.load(t1, g"ndl.ch\0");
                                                    t1 = this.mod.icmp(g"eq\0", t2, this.mod.c_int(ne_t, (i64)0), g"ndl.end\0");
                                                    this.mod.cbr(t1, found_b, ib_b);
                                                }
                                                    default {
                                                    t1 = this.mod.icmp(g"eq\0", ni, this.mod.c_int(this.t_i32, (i64)ncount), g"ndl.done\0");
                                                    this.mod.cbr(t1, found_b, ib_b);
                                                };
                                                };
                                                this.mod.position(this.fn, ib_b);
                                                ni2 = this.mod.load(nidx, g"n.idx2\0");
                                                hi2 = this.mod.load(hidx, g"h.idx2\0");
                                                t1 = this.mod.gep_ptr(np, ni2, false, g"ndl.ep2\0");
                                                nel = this.mod.load(t1, g"ndl.el\0");
                                                switch (nul_h)
                                                {
                                                    case (true) {
                                                    t1 = this.mod.gep_ptr(hp, hi2, false, g"hay.ep2\0");
                                                    hel = this.mod.load(t1, g"hay.el\0");
                                                    oob = this.mod.icmp(g"eq\0", hel, this.mod.c_int(he_t, (i64)0), g"hay.oob\0");
                                                }
                                                    default {
                                                    oob = this.mod.icmp(g"eq\0", hi2, this.mod.c_int(this.t_i32, (i64)hcount), g"hay.oob\0");
                                                    t1 = this.mod.gep_ptr(hp, hi2, false, g"hay.ep2\0");
                                                    hel = this.mod.load(t1, g"hay.el\0");
                                                };
                                                };
                                                switch (nel.ty.width < hel.ty.width)
                                                {
                                                    case (true) { nel = this.mod.cast(g"zext\0", nel, hel.ty, (byte*)0); }
                                                    default {
                                                    switch (nel.ty.width > hel.ty.width)
                                                    {
                                                        case (true) { nel = this.mod.cast(g"trunc\0", nel, hel.ty, (byte*)0); }
                                                        default {};
                                                    };
                                                };
                                                };
                                                nev = this.mod.icmp(g"ne\0", hel, nel, g"el.ne\0");
                                                mm = this.mod.binop(g"or\0", oob, nev, g"mismatch\0");
                                                this.mod.store(this.mod.binop(g"add\0", ni2, i1v, (byte*)0), nidx);
                                                this.mod.store(this.mod.binop(g"add\0", hi2, i1v, (byte*)0), hidx);
                                                this.mod.cbr(mm, if_b, ic_b);
                                                this.mod.position(this.fn, if_b);
                                                oi3 = this.mod.load(oidx, g"o.idx3\0");
                                                this.mod.store(this.mod.binop(g"add\0", oi3, i1v, (byte*)0), oidx);
                                                this.mod.br(oc_b);
                                                this.mod.position(this.fn, found_b);
                                                this.mod.br(merge_b);
                                                this.mod.position(this.fn, nf_b);
                                                this.mod.br(merge_b);
                                                this.mod.position(this.fn, merge_b);
                                                pv = (IRValue**)this.zbuf(2);
                                                pb = (IRBlock**)this.zbuf(2);
                                                pv[0] = this.i1_lit(g"1\0");
                                                pv[1] = this.i1_lit(g"0\0");
                                                pb[0] = found_b;
                                                pb[1] = nf_b;
                                                res = this.mod.phi(this.t_i1, pv, pb, 2, g"in.result\0");
                                                switch ((n.flags `& 2) != 0)
                                                {
                                                    case (true) {
                                                    res = this.mod.binop(g"xor\0", res, this.i1_lit(g"-1\0"), g"notin.result\0");
                                                }
                                                    default {};
                                                };
                                                -> res;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            x_in(Node* n) -> IRValue*
            {
                IRValue* nd = this.visit(n.a);
                IRValue* hy;
                IRValue* i0 = this.mod.c_int(this.t_i32, (i64)0);
                IRValue* i1v = this.mod.c_int(this.t_i32, (i64)1);
                IRValue* oidx;
                IRValue* oi;
                IRValue* hp;
                IRValue* hc;
                IRValue* ae;
                IRValue* ni;
                IRValue* oi2;
                IRValue* ni2;
                IRValue* hi2;
                IRValue* np;
                IRValue* nc;
                IRValue* ne;
                IRValue* nel;
                IRValue* hp2;
                IRValue* hel;
                IRValue* oob;
                IRValue* nev;
                IRValue* mm;
                IRValue* oi3;
                IRValue* nidx;
                IRValue* hidx;
                IRValue* res;
                IRValue** pv;
                IRBlock** pb;
                IRBlock* found_b;
                IRBlock* nf_b;
                IRBlock* merge_b;
                IRBlock* oc_b;
                IRBlock* ob_b;
                IRBlock* ic_b;
                IRBlock* ib_b;
                IRBlock* if_b;
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        switch (nd != (IRValue*)0)
                        {
                            case (true) {
                            switch (nd.ty.kind == LK.INT) { case (true) { -> this.x_in_bits(n, nd); } default {}; };
                        }
                            default {};
                        };
                        switch (!this.is_i8_ptr(nd.ty))
                        {
                            case (true) {
                            -> this.x_in_seq(n, nd, (IRValue*)0);
                        }
                            default
                            {
                                hy = this.visit(n.b);
                                switch (this.bad)
                                {
                                    case (true) { -> (IRValue*)0; }
                                    default
                                    {
                                        switch (!this.is_i8_ptr(hy.ty))
                                        {
                                            case (true) {
                                            -> this.x_in_seq(n, nd, hy);
                                        }
                                            default
                                            {
                                                found_b = this.mod.append_block(this.fn, g"in.found\0");
                                                nf_b = this.mod.append_block(this.fn, g"in.notfound\0");
                                                merge_b = this.mod.append_block(this.fn, g"in.merge\0");
                                                oc_b = this.mod.append_block(this.fn, g"in.outer.cond\0");
                                                ob_b = this.mod.append_block(this.fn, g"in.outer.body\0");
                                                ic_b = this.mod.append_block(this.fn, g"in.inner.cond\0");
                                                ib_b = this.mod.append_block(this.fn, g"in.inner.body\0");
                                                if_b = this.mod.append_block(this.fn, g"in.inner.fail\0");
                                                oidx = this.mod.alloca_here(this.t_i32, g"in.outer.idx\0");
                                                this.mod.store(i0, oidx);
                                                this.mod.br(oc_b);
                                                this.mod.position(this.fn, oc_b);
                                                oi = this.mod.load(oidx, g"o.idx\0");
                                                hp = this.mod.gep_ptr(hy, oi, false, g"hay.ep\0");
                                                hc = this.mod.load(hp, g"hay.ch\0");
                                                ae = this.mod.icmp(g"eq\0", hc, this.mod.c_int(this.t_i8, (i64)0), g"hay.end\0");
                                                this.mod.cbr(ae, nf_b, ob_b);
                                                this.mod.position(this.fn, ob_b);
                                                nidx = this.mod.alloca_here(this.t_i32, g"in.ndl.idx\0");
                                                this.mod.store(i0, nidx);
                                                hidx = this.mod.alloca_here(this.t_i32, g"in.hay.idx\0");
                                                oi2 = this.mod.load(oidx, g"o.idx2\0");
                                                this.mod.store(oi2, hidx);
                                                this.mod.br(ic_b);
                                                this.mod.position(this.fn, ic_b);
                                                ni = this.mod.load(nidx, g"n.idx\0");
                                                np = this.mod.gep_ptr(nd, ni, false, g"ndl.ep\0");
                                                nc = this.mod.load(np, g"ndl.ch\0");
                                                ne = this.mod.icmp(g"eq\0", nc, this.mod.c_int(this.t_i8, (i64)0), g"ndl.end\0");
                                                this.mod.cbr(ne, found_b, ib_b);
                                                this.mod.position(this.fn, ib_b);
                                                ni2 = this.mod.load(nidx, g"n.idx2\0");
                                                hi2 = this.mod.load(hidx, g"h.idx2\0");
                                                np = this.mod.gep_ptr(nd, ni2, false, g"ndl.ep2\0");
                                                nel = this.mod.load(np, g"ndl.el\0");
                                                hp2 = this.mod.gep_ptr(hy, hi2, false, g"hay.ep2\0");
                                                hel = this.mod.load(hp2, g"hay.el\0");
                                                oob = this.mod.icmp(g"eq\0", hel, this.mod.c_int(this.t_i8, (i64)0), g"hay.oob\0");
                                                nev = this.mod.icmp(g"ne\0", hel, nel, g"el.ne\0");
                                                mm = this.mod.binop(g"or\0", oob, nev, g"mismatch\0");
                                                this.mod.store(this.mod.binop(g"add\0", ni2, i1v, (byte*)0), nidx);
                                                this.mod.store(this.mod.binop(g"add\0", hi2, i1v, (byte*)0), hidx);
                                                this.mod.cbr(mm, if_b, ic_b);
                                                this.mod.position(this.fn, if_b);
                                                oi3 = this.mod.load(oidx, g"o.idx3\0");
                                                this.mod.store(this.mod.binop(g"add\0", oi3, i1v, (byte*)0), oidx);
                                                this.mod.br(oc_b);
                                                this.mod.position(this.fn, found_b);
                                                this.mod.br(merge_b);
                                                this.mod.position(this.fn, nf_b);
                                                this.mod.br(merge_b);
                                                this.mod.position(this.fn, merge_b);
                                                pv = (IRValue**)this.zbuf(2);
                                                pb = (IRBlock**)this.zbuf(2);
                                                pv[0] = this.i1_lit(g"1\0");
                                                pv[1] = this.i1_lit(g"0\0");
                                                pb[0] = found_b;
                                                pb[1] = nf_b;
                                                res = this.mod.phi(this.t_i1, pv, pb, 2, g"in.result\0");
                                                switch ((n.flags `& 2) != 0)
                                                {
                                                    case (true) {
                                                    res = this.mod.binop(g"xor\0", res, this.i1_lit(g"-1\0"), g"notin.result\0");
                                                }
                                                    default {};
                                                };
                                                -> res;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            x_notnull(Node* n) -> IRValue*
            {
                IRValue* v = this.visit(n.a);
                IRValue* c;
                switch (this.bad)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        switch (v == (IRValue*)0)
                        {
                            case (true) {
                            this.unsup(n, g"not-null void operand\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (v.ty.kind == LK.PTR)
                                {
                                    case (true) { c = this.mod.icmp(g"ne\0", v, this.mod.c_null(v.ty), g"not_null\0"); }
                                    default {
                                        switch (v.ty.kind == LK.INT)
                                        {
                                            case (true) { c = this.mod.icmp(g"ne\0", v, this.mod.c_int(v.ty, (i64)0), g"not_zero\0"); }
                                            default {
                                                switch (v.ty.kind == LK.FLOAT | v.ty.kind == LK.DOUBLE)
                                                {
                                                    case (true) { c = this.mod.fcmp(g"one\0", v, this.mod.c_fp(v.ty, 0.0), g"not_zero_f\0"); }
                                                    default {
                                    this.unsup(n, g"not-null operand type\0");
                                    -> (IRValue*)0;
                                };
                                                };
                                            };
                                        };
                                    };
                                };
                                -> this.mod.cast(g"zext\0", c, this.t_i8, g"not_null_result\0");
                            };
                        };
                    };
                };
            };


            compound_op(int tok) -> int
            {
                switch (tok)
                {
                    case (TokenType.PLUS_ASSIGN) { -> Operator.ADD; }
                    case (TokenType.MINUS_ASSIGN) { -> Operator.SUB; }
                    case (TokenType.MULTIPLY_ASSIGN) { -> Operator.MUL; }
                    case (TokenType.DIVIDE_ASSIGN) { -> Operator.DIV; }
                    case (TokenType.MODULO_ASSIGN) { -> Operator.MOD; }
                    case (TokenType.EXPONENT_ASSIGN) { -> Operator.POWER; }
                    case (TokenType.AND_ASSIGN) { -> Operator.AND; }
                    case (TokenType.OR_ASSIGN) { -> Operator.OR; }
                    case (TokenType.XOR_ASSIGN) { -> Operator.XOR; }
                    case (TokenType.BITAND_ASSIGN) { -> Operator.BITAND; }
                    case (TokenType.BITOR_ASSIGN) { -> Operator.BITOR; }
                    case (TokenType.BITXOR_ASSIGN) { -> Operator.BITXOR; }
                    case (TokenType.BITXNOR_ASSIGN) { -> Operator.BITXNOR; }
                    case (TokenType.BITNAND_ASSIGN) { -> Operator.BITNAND; }
                    case (TokenType.BITNOR_ASSIGN) { -> Operator.BITNOR; }
                    case (TokenType.BITSHIFT_LEFT_ASSIGN) { -> Operator.BITSHIFT_LEFT; }
                    case (TokenType.BITSHIFT_RIGHT_ASSIGN) { -> Operator.BITSHIFT_RIGHT; }
                    default
                    {
                        -> -1;
                    };
                };
            };



