                                                                                    default {};
                                                                                };
                                                                                this.check_object_methods(o);
                                                                                switch (!this.failed)
                                                                                {
                                                                                    case (true) { this.check_object_traits(o); }
                                                                                    default {};
                                                                                };
                                                                                switch (!this.failed & o.d == (Node*)0)
                                                                                {
                                                                                    case (true) { nm_put(this.pobjs, o.text, (void*)o); }
                                                                                    default {};
                                                                                };
                                                                                -> this.done(o);
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };



            inh_in_path(PtrVec* path, byte* n) -> bool
            {
                int i;
                while (i < path.len)
