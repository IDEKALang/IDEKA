                        default {};
                    };
                    switch (op == DataType.ULONG)
                    {
                        case (true) {
                        switch (e.ival < (i64)0) { case (true) { -> 2; } default {}; };
                        this.ct_v = e.ival;
                        this.ct_k = 0;
                        -> 0;
                    }
                        default {};
                    };
                    switch (op == DataType.BOOL)
                    {
                        case (true) { this.ct_v = e.ival; this.ct_k = 1; -> 0; }
                        default {};
                    };
                    switch (op == DataType.CHAR)
