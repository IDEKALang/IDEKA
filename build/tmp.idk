                        o.put(32);
                        o.put_str(vars.names[i]);
                        o.put(58);
                        o.put_i64((i64)vars.slots[i]);
                        i++;
                    };
                }
                default {};
            };
            ->;
        };

        object FvmCode
        {
            int* ops;
            i64* a;
            i64* b;
            i64* c;
            byte** s;
            int* line;
            int len, cap;
            int* ustart;
            int* ulen;
            int ucount, ucap;
            bool ok;

            __init() -> this
            {
                this.len = 0;
                this.cap = 256;
                this.ucount = 0;
                this.ucap = 32;
                this.ok = true;
                this.ops = (int*)fvm_alloc(this.cap * 4);
                this.a = (i64*)fvm_alloc(this.cap * 8);
                this.b = (i64*)fvm_alloc(this.cap * 8);
                this.c = (i64*)fvm_alloc(this.cap * 8);
                this.s = (byte**)fvm_alloc(this.cap * 8);
                this.line = (int*)fvm_alloc(this.cap * 4);
                this.ustart = (int*)fvm_alloc(this.ucap * 4);
                this.ulen = (int*)fvm_alloc(this.ucap * 4);
                switch (this.ops == (int*)0 | this.a == (i64*)0 | this.b == (i64*)0 | this.c == (i64*)0 | this.s == (byte**)0 | this.line == (int*)0 | this.ustart == (int*)0 | this.ulen == (int*)0)
                {
                    case (true) { this.ok = false; }
                    default {};
                };
                -> this;
            };

            __expr() -> FvmCode* -> this;

            __exit() -> void
            {
                switch (this.ops != (int*)0) { case (true) { ffree((byte*)this.ops); } default {}; };
                switch (this.a != (i64*)0) { case (true) { ffree((byte*)this.a); } default {}; };
                switch (this.b != (i64*)0) { case (true) { ffree((byte*)this.b); } default {}; };
                switch (this.c != (i64*)0) { case (true) { ffree((byte*)this.c); } default {}; };
                switch (this.s != (byte**)0) { case (true) { ffree((byte*)this.s); } default {}; };
                switch (this.line != (int*)0) { case (true) { ffree((byte*)this.line); } default {}; };
                switch (this.ustart != (int*)0) { case (true) { ffree((byte*)this.ustart); } default {}; };
                switch (this.ulen != (int*)0) { case (true) { ffree((byte*)this.ulen); } default {}; };
                this.ops = (int*)0;
                this.a = (i64*)0;
                this.b = (i64*)0;
                this.c = (i64*)0;
                this.s = (byte**)0;
                this.line = (int*)0;
                this.ustart = (int*)0;
                this.ulen = (int*)0;
                this.len = 0;
                this.ucount = 0;
                ->;
            };


            add(int op, i64 oa, i64 ob, i64 oc, byte* os, int ln) -> int
            {
                int nc;
                int* n1;
                i64* n2;
                i64* n3;
                i64* n4;
                byte** n5;
                int* n6;
                switch (!this.ok)
                {
                    case (true) { -> -1; }
                    default {};
                };
                switch (this.len >= this.cap)
                {
                    case (true) {
                        nc = this.cap * 2;
                        n1 = (int*)fvm_grow((byte*)this.ops, nc * 4);
                        n2 = (i64*)fvm_grow((byte*)this.a, nc * 8);
                        n3 = (i64*)fvm_grow((byte*)this.b, nc * 8);
                        n4 = (i64*)fvm_grow((byte*)this.c, nc * 8);
                        n5 = (byte**)fvm_grow((byte*)this.s, nc * 8);
                        n6 = (int*)fvm_grow((byte*)this.line, nc * 4);
                        switch (n1 == (int*)0 | n2 == (i64*)0 | n3 == (i64*)0 | n4 == (i64*)0 | n5 == (byte**)0 | n6 == (int*)0)
                        {
                            case (true) {
                                this.ok = false;
                                -> -1;
                            }
                            default {};
                        };
                        this.ops = n1;
                        this.a = n2;
                        this.b = n3;
                        this.c = n4;
                        this.s = n5;
                        this.line = n6;
                        this.cap = nc;
                    }
                    default {};
                };
                this.ops[this.len] = op;
                this.a[this.len] = oa;
                this.b[this.len] = ob;
                this.c[this.len] = oc;
                this.s[this.len] = os;
                this.line[this.len] = ln;
                this.len++;
                -> this.len - 1;
            };


            unit_begin() -> int
            {
                int nc;
                int* n1;
                int* n2;
                switch (!this.ok)
                {
                    case (true) { -> -1; }
                    default {};
                };
                switch (this.ucount >= this.ucap)
                {
                    case (true) {
                        nc = this.ucap * 2;
                        n1 = (int*)fvm_grow((byte*)this.ustart, nc * 4);
                        n2 = (int*)fvm_grow((byte*)this.ulen, nc * 4);
                        switch (n1 == (int*)0 | n2 == (int*)0)
                        {
                            case (true) {
                                this.ok = false;
                                -> -1;
                            }
                            default {};
                        };
                        this.ustart = n1;
                        this.ulen = n2;
                        this.ucap = nc;
                    }
                    default {};
                };
                this.ustart[this.ucount] = this.len;
                this.ulen[this.ucount] = 0;
                this.ucount++;
                -> this.ucount - 1;
            };


            unit_end(int u) -> void
            {
                this.ulen[u] = this.len - this.ustart[u];
                ->;
            };
        };



