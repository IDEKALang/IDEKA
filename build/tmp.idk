                                        b.__init();
                                        b.put_str(g"__typefunc__\0");
                                        b.put_str(tn);
                                        b.put_str(g"__\0");
                                        b.put_str(n.text);
                                        b.put(0);
                                        mk = this.keep(b.mem);
                                        b.__exit();
                                        switch (this.fn_known(mk))
                                        {
                                            case (true)
                                            {
                                                this.visit_expr(n.a);
                                                i = 0;
                                                while (i < argc)
                                                {
                                                    this.visit_expr(node_child(n, 0, i));
                                                    i++;
                                                };
                                                this.emit(42, (i64)(1 + argc), (i64)0, (i64)0, mk);
                                                -> true;
                                            }
                                            default {};
                                        };
                                    }
                                    default {};
