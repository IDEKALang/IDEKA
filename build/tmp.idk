                                tn = this.IDEKA_type_name(rt);
                                switch (tn == (byte*)0)
                                {
                                    case (true) { -> (TypeSpec*)0; }
                                    default
                                    {
                                        r = this.typefunc_ret(tn, n.text, n.l0);
                                        switch (r == (TypeSpec*)0)
