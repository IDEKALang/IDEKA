            };

            t_bitslice(Node* n) -> TypeSpec*
            {
                TypeSpec* vt = this.type_of(n.a);
                int lo = -1;
                int hi = -1;
                int width;
                this.type_of(n.b);
                this.type_of(n.c);
                switch (n.b != (Node*)0)
                {
                    case (true) {
                    switch (n.b.kind == NodeKind.LITERAL)
                    {
                        case (true) { lo = (int)n.b.ival; }
                        default {};
                    };
                }
                    default {};
                };
                switch (n.c != (Node*)0)
                {
                    case (true) {
                    switch (n.c.kind == NodeKind.LITERAL)
                    {
                        case (true) { hi = (int)n.c.ival; }
                        default {};
                    };
                }
                    default {};
                };
                switch (lo >= 0 & hi >= 0)
                {
                    case (true) {
                    width = hi - lo;
                    switch (width < 0)
                    {
                        case (true) { width = lo - hi; }
                        default {};
