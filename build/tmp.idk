                                                r = this.typefunc_ret(mk2, n.text, n.l0);
                                                ffree(mk2);
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        ffree(tn);
                                        -> r;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            t_member(Node* n) -> TypeSpec*
