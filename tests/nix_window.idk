// IDEKA Wayland Window Demo
// 800x600 black background, title "IDEKA Window"

#import <standard.idk>, <wayland.idk>;

using standard::strings,
      standard::system::wayland,
      standard::io::console;

def main() -> int
{
    noopstr title = "IDEKA Window\0";

    Window win;
    win.__init((byte*)@title, 800, 600);

    if (!win.running)
    {
        return 1;
    };

    while (win.running)
    {
        win.clear(0);
        win.present();
        win.running = win.process_messages();
    };

    win.__exit();

    return 0;
};
